# Test: Classes (2 node types)
# Tests "class" and "super" node types

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# Class Definitions: "class"
# ==============================================================================

# Class with methods
test "class methods", "class Math\n  add: (a, b) -> a + b\n  multiply: (a, b) -> a * b\nm = Math.new(); m.add(2, 3)", 5

# Static methods
test "static method", "class Utils\n  @square: (x) -> x * x\nUtils.square(5)", 25

# Class with constructor logic
test "constructor logic", "class Counter\n  constructor: ->\n    @count = 0\n  increment: -> @count += 1\nc = Counter.new(); c.increment(); c.count", 1

# ==============================================================================
# Super Calls: "super"
# ==============================================================================

# Super method call
test "super method call", "class Animal\n  speak: -> 'sound'\nclass Dog extends Animal\n  speak: -> super.speak() + '!'\nd = Dog.new(); d.speak()", "sound!"

# Super with spread arguments (Rip ES6 prefix syntax)

test "super with spread args", '''
  class Parent
    method: (...args) -> args.join('-')

  class Child extends Parent
    method: -> super(...arguments)

  c = Child.new()
  c.method(1, 2, 3)
''', '1-2-3'

# ==============================================================================
# More Class Features
# ==============================================================================

# Class expressions

test 'class expression', '''
  Animal = class
    speak: -> 'sound'
  Animal.new().speak()
  ''', 'sound'

# Empty class

test 'empty class', '''
  class Empty
  Empty.new().constructor.name
  ''', 'Empty'

# One-line class body — `then` is the body introducer, not loose `and`
test 'class then-body', '''
  class E extends Error then noop
  (E.new()) instanceof Error
''', true

# Method chaining

test 'method chaining', '''
  class Builder
    setValue: (v) -> @value = v; this
    getValue: -> @value
  Builder.new().setValue(42).getValue()
  ''', 42

# Bound methods

test 'bound method', '''
  class Counter
    constructor: -> @count = 0
    increment: => @count++
  c = Counter.new()
  fn = c.increment
  fn()
  c.count
  ''', 1

# instanceof

test 'instanceof check', '''
  class Animal
  a = Animal.new()
  a instanceof Animal
  ''', true

# Override method

test 'override method', '''
  class Animal
    speak: -> 'sound'
  class Dog extends Animal
    speak: -> 'bark'
  Dog.new().speak()
  ''', 'bark'

# Constructor explicit return

test 'constructor explicit return', '''
  class A
    constructor: ->
      return {custom: 'object'}
  A.new().custom
  ''', 'object'

# Async method

test 'async method', '''
  class Async
    getData: -> await Promise.resolve(42)
  do ->
    await Async.new().getData()
  ''', 42

# Four-level inheritance

test 'four-level inheritance', '''
  class A
    val: -> 'a'
  class B extends A
  class C extends B
  class D extends C
  D.new().val()
  ''', 'a'

# ==============================================================================
# Ruby-style Constructor: XXX.new()
# ==============================================================================

# Code generation
code "ruby-style new", "Counter.new()", "new Counter();"
code "ruby-style new args", "Counter.new(1, 2)", "new Counter(1, 2);"
code "ruby-style new expression", "getClass().new(x)", "new (getClass())(x);"
# A pure spine (names, members, indexes) is its own constructor and
# stands bare; an index that reads through a call (`.at(-n)`,
# `.slice()`, a regex match) is a call in the output and seals, or
# `new` would construct the method.
code "a member-spine target stands bare", "a.B.new(c)", "new a.B(c);"
code "an index-spine target stands bare", "x[k].new(y)", "new x[k](y);"
code "a this-member target stands bare", "-> @Foo.new(x)", "(function() { return new this.Foo(x); });"
code "a negative-index target seals", "x[-1].new()", "new (x.at(-1))();"
code "a negative index deeper in the spine seals", "a[-1].b.new(2)", "new (a.at(-1).b)(2);"
code "a range-index target seals", "a[1..2].new()", "new (a.slice(1, 3))();"

# `new X` is not Rip: construction has one spelling, `X.new(…)`, and a
# prefix `new` rejects at the keyword. `new` stays a property name, an
# object key, the head of `new.target`, and the word of a TS constructor
# type.
fail "prefix construction rejects at the keyword", "x = new X(1)", "1:5: construction is spelled `X.new(…)` — `new X` is not Rip"
fail "a bare prefix construction rejects", "x = new X", "1:5: construction is spelled `X.new(…)`"
fail "a prefix construction over a member rejects", "x = new a.B(c)", "1:5: construction is spelled `X.new(…)`"
fail "a prefix construction as an implicit argument rejects", "f new X", "1:3: construction is spelled `X.new(…)`"
fail "a prefix construction dammit rejects", "x = new X!", "1:5: construction is spelled `X.new(…)`"
fail "nested prefix construction rejects at the first new", "x = new new X", "1:5: construction is spelled `X.new(…)`"
fail "a prefix construction in a schema function body rejects", "U = schema\n  x! -> throw new Error('m')", "2:15: construction is spelled `X.new(…)`"
fail "new is reserved as a shorthand name", "c = {new}", "1:6: 'new' is reserved — construction is spelled `X.new(…)`"
fail "a trailing new is reserved", "x = new", "1:5: 'new' is reserved — construction is spelled `X.new(…)`"
test "new is a property name", "o = {new: 1}\no.new", 1
test "new is a bare object key", "o = new: 2\no.new", 2
test "new is a this-property", "o = {new: 3, get: -> @new}\no.get()", 3
test "a method named new is defined and read as a property", "class A\n  new: -> 4\nA.prototype.new.call(null)", 4
code "a bare .new is a property read", "x = obj.new", "let x = obj.new;"
code "a TS constructor type keeps its new", "x: new () => Foo = Foo", "let x = Foo;"

# ==============================================================================
# Meta Properties
# ==============================================================================

# ==============================================================================
# Class with additional statements (object body + nested class/extra stmts)
# @param, bound methods, and async must work even with extra statements present
# ==============================================================================

# ==============================================================================
# Class name restriction
# ==============================================================================
# `class App.Sub` and `class arr[0]` used to parse but produce broken JS
# (`class .,App,Sub`) because the codegen interpolated the array-shaped name
# into a `class ${name}` template. The grammar now restricts class names to
# Identifier or ThisProperty (the latter enabling nested static classes).

fail "class with member-access name does not parse",
  'class App.Sub'

fail "class with index name does not parse", '''
  arr = []
  class arr[0]
  '''

# ==============================================================================
# new.target — the meta-property distinguishes construction from a plain call
# ==============================================================================

test "new.target in constructor", '''
  class A
    constructor: ->
      @viaNew = new.target isnt undefined
  A.new().viaNew
''', true

code "new.target passes through", "class A\n  constructor: ->\n    @t = new.target", "class A {\n  constructor() {\n    this.t = new.target;\n  }\n};"
code "new.target opens an implicit call argument", "class A\n  constructor: ->\n    record new.target", "class A {\n  constructor() {\n    record(new.target);\n  }\n};"

# ==============================================================================
# Promoted Parameters — constructor: (@name) -> assigns this.name; inside a
# leading super(...) call @name reads the parameter (this is not yet available)
# ==============================================================================

test 'basic class', '''
  class Animal
    constructor: (@name) ->
    speak: -> @name
  a = Animal.new('Dog'); a.speak()
''', 'Dog'

test 'class inheritance', '''
  class Animal
    constructor: (@name) ->
  class Dog extends Animal
    bark: -> 'woof'
  d = Dog.new('Spot'); d.name
''', 'Spot'

code 'simple class', '''
  class Animal
    constructor: (@name) ->
''', 'class Animal { constructor(name) { this.name = name; } }'

# Only the constructor's own `this` is not yet available in super's
# arguments: a thin arrow, a def or a class there binds its own `this`,
# so its `@x` stays a member read.
test 'a promoted name inside a super argument with its own this stays a member', '''
  class A
    constructor: (@v, @w, @u) ->
  class B extends A
    constructor: (@x) ->
      super(@x, (-> @x).call({x: "other"}), (=> @x)())
  b = B.new(7)
  [b.v, b.w, b.u]
''', [7, 'other', 7]

# A soaking spine cannot be constructed THROUGH — it seals into a value
# first. Parens alone are what the spec asks for and node accepts them,
# but bun, which runs rip, refuses every parenthesized optional chain
# under `new`. So the seal has to yield a value, which is what the
# coalesce is for: it reads like a no-op and is not, so the bytes are
# pinned here rather than left to a comment.
code 'new through a soaking spine seals it', 'x = a?.b.new()', 'let x = new (a?.b ?? undefined)();'
code 'a sealed spine keeps its own arguments', 'x = a?.b.new(1)', 'let x = new (a?.b ?? undefined)(1);'
code 'a soak deeper in the spine seals the whole spine', 'x = a.b?.c.d.new()', 'let x = new (a.b?.c.d ?? undefined)();'
# An INDEX link fails exactly as a member link does, so the seal walks
# both — the spine's four link kinds are `.`, `?.`, `[]` and `optindex`.
code 'an index tail after a soak seals too', 'x = a?.b["c"].new()', 'let x = new (a?.b["c"] ?? undefined)();'
code 'an index-tailed soak keeps its arguments', 'x = a?.b["c"].new(1)', 'let x = new (a?.b["c"] ?? undefined)(1);'
code 'a soaking spine under new new seals inside', 'x = a?.b.new().new()', 'let x = new (new (a?.b ?? undefined)())();'
code 'an ordinary new new groups the inner construction', 'x = a.new().new()', 'let x = new (new a())();'
code 'a plain index spine takes no seal', 'x = a["b"].new()', 'let x = new a["b"]();'
# `X.new(...)` is rip's own construction sugar, so a soaking target
# seals there too — and `new` OVER that form constructs what the ruby
# construction returned, rather than reading a property named `new`.
code 'ruby construction seals a soaking target', 'x = a?.b.new(1)', 'let x = new (a?.b ?? undefined)(1);'
code 'new over a soaking ruby construction still constructs', 'x = a?.b.new(1).new()', 'let x = new (new (a?.b ?? undefined)(1))();'
code 'a bare .new read on a soaking spine stays a read', 'x = a?.b.new', 'let x = a?.b.new;'
code 'a spine with no soak takes no seal', 'x = a.b.new()', 'let x = new a.b();'

# A construction always spells its argument list. `new a.b` alone means
# the same in JavaScript, but anything chained after it would bind into
# the constructor spine: printed bare, `(new a.b).c` is `new a.b.c`,
# which constructs a different thing.
code 'a member read after a member construction reads the instance', 'x = (a.b.new()).c', 'let x = new a.b().c;'
code 'an index read after a member construction reads the instance', 'x = (a.b.new())[0]', 'let x = new a.b()[0];'
code 'a call after a member construction calls the instance', 'x = (a.b.new())(1)', 'let x = new a.b()(1);'
code 'a method call after a member construction calls the instance', 'x = (a.b.new()).c()', 'let x = new a.b().c();'
code 'a member read after an index construction reads the instance', 'x = (a[0].new()).c', 'let x = new a[0]().c;'
# An optional call of `.new` has no reading: JavaScript refuses
# `new X?.()`, and the spelling does not say whether the soak guards the
# constructor or the instance. A completed construction soaks its
# instance; an optional INDEX on a bare `.new` reads the property, as
# the bare `.new` read itself does.
fail 'an optional call of a member construction rejects', 'x = a.b.new?(1)', 'an optional call of `.new` has no reading'
fail 'an optional call of a named construction rejects', 'x = Foo.new?(1)', 'an optional call of `.new` has no reading'
fail 'an optional call of a parenthesized constructor rejects', 'x = (f()).new?(1)', 'an optional call of `.new` has no reading'
fail 'the rejection names the conditional-construction spelling', 'x = Foo.new?(1)', 'To construct only when the class exists, test it'
code 'an optional call after a completed construction soaks the instance', 'x = Foo.new()?(1)', 'let x = new Foo()?.(1);'
code 'an optional index on a bare .new reads the property', 'x = a.b.new?[0]', 'let x = a.b.new?.[0];'
code 'constructing only when the class exists is spelled with a test', 'x = if Foo? then Foo.new(1)', 'let x = (Foo != null) ? new Foo(1) : undefined;'
test 'a tested construction skips a missing class and builds a present one', '''
  class Here
    constructor: (n) -> @n = n
  Gone = null
  a = if Here? then Here.new(7)
  b = if Gone? then Gone.new(7)
  [a.n, b]
''', [7, undefined]
code 'an optional call after a closed construction soaks the instance', 'x = X.new(1)?(2)', 'let x = new X(1)?.(2);'
code 'an optional index after a closed construction soaks the instance', 'x = X.new(1)?[0]', 'let x = new X(1)?.[0];'
code 'an empty argument list closes the construction too', 'x = X.new()?(2)', 'let x = new X()?.(2);'
code 'a sealed constructor with its list is closed', 'x = (a or b).new(1)?(2)', 'let x = new (a || b)(1)?.(2);'
code 'an optional call after a parenthesized construction soaks the instance', 'x = (a.b.new())?(1)', 'let x = new a.b()?.(1);'
code 'an optional index after a parenthesized construction soaks the instance', 'x = (a.b.new())?[0]', 'let x = new a.b()?.[0];'
code 'an optional member after a parenthesized construction', 'x = (a.b.new())?.c', 'let x = new a.b()?.c;'
test 'a member read after a member construction reads the instance, at run time', '''
  class K
    constructor: -> @c = 'instance'
  K.c = 'static'
  ns = { K }
  (ns.K.new()).c
''', 'instance'
test 'a call after a member construction calls the instance, at run time', '''
  Make = -> return (n) -> n * 2
  ns = { Make }
  (ns.Make.new())(21)
''', 42

# `new` constructs an EXPRESSION standing in parens whole. A parenthesized
# call constructs what the call returns, never the callee; an operator,
# control, cast, function, or class expression is the constructor itself.
code 'a parenthesized call is the constructor', 'x = (f()).new()', 'let x = new (f())();'
code 'a parenthesized call keeps the outer arguments', 'x = (f(1)).new(2)', 'let x = new (f(1))(2);'
code 'an unparenthesized call constructs its callee', 'x = f.new(1)', 'let x = new f(1);'
code 'parens around a pure constructor spine are redundant', 'x = (a.b).new(1)', 'let x = new a.b(1);'
code 'parens around a spine that holds a call decide what is constructed', 'x = (a().b).new(1)', 'let x = new (a().b)(1);'
code 'parens around a deeper call-holding spine are kept', 'x = (a.b().c).new(1)', 'let x = new (a.b().c)(1);'
# A spine that holds a call seals WHOLE, wherever its parens stood in the
# source, with or without an argument list. Printed bare, each of these
# would construct the call's callee and then run the rest on the instance.
code 'a call-holding spine with no argument list seals', 'x = (a().b).new()', 'let x = new (a().b)();'
code 'a member of a parenthesized call seals with the call', 'x = (f()).b.new()', 'let x = new (f().b)();'
code 'a member of a parenthesized call keeps its arguments', 'x = (f()).b.new(1)', 'let x = new (f().b)(1);'
code 'an index of a parenthesized call seals with the call', 'x = (f())[0].new(1)', 'let x = new (f()[0])(1);'
code 'a deeper member of a call-holding spine seals whole', 'x = (a().b).c.new(1)', 'let x = new (a().b.c)(1);'
code 'a chain after a sealed construction reads the instance', 'x = ((a().b).new()).c', 'let x = new (a().b)().c;'
code 'a chain after new new reads the outer instance', 'x = (a.new().new()).c', 'let x = new (new a())().c;'
code 'a call after new new calls the outer instance', 'x = (F.new().new())(1)', 'let x = new (new F())()(1);'
code 'new over a ruby construction constructs what it returns', 'x = Outer.new(1).new()', 'let x = new (new Outer(1))();'
code 'a chain after new over a ruby construction reads the instance', 'x = (Outer.new(1).new()).c', 'let x = new (new Outer(1))().c;'
test 'a member of a parenthesized call constructs what the call holds', '''
  class Inner
    constructor: (n) -> @n = n ?? 'none'
  host = -> { Inner }
  [((host()).Inner.new()).n, ((host()).Inner.new(7)).n, ((host().Inner).new()).n]
''', ['none', 7, 'none']
test 'a chain after new new reads the outer instance, at run time', '''
  class Leaf
    constructor: -> @c = 'leaf-instance'
  Outer = -> return Leaf
  (Outer.new().new()).c
''', 'leaf-instance'
test 'a parenthesized call-holding spine constructs what it names', '''
  class Inner
    constructor: (n) -> @n = n
  host = -> { Inner }
  ((host().Inner).new(7)).n
''', 7
code 'a parenthesized logical is the constructor', 'x = (a or b).new()', 'let x = new (a || b)();'
code 'a parenthesized logical keeps its arguments', 'x = (a or b).new(1)', 'let x = new (a || b)(1);'
code 'a parenthesized nullish is the constructor', 'x = (a ?? b).new()', 'let x = new (a ?? b)();'
code 'a parenthesized conditional is the constructor', 'x = (if c then A else B).new()', 'let x = new (c ? A : B)();'
code 'a parenthesized await is the constructor', 'x = (await f()).new()', 'let x = new (await f())();'
code 'a parenthesized cast is the constructor', 'x = (k as any).new()', 'let x = new (k)();'
code 'a parenthesized maybe dammit is the constructor', 'x = (f?!).new()', 'let x = new (await f?.())();'
code 'a parenthesized existence is the constructor', 'x = (f?).new()', 'let x = new (f != null)();'
test 'a parenthesized call constructs what the call returns', '''
  pick = -> class then constructor: -> @kind = 'returned'
  pick.prototype.kind = 'callee'
  ((pick()).new()).kind
''', 'returned'
test 'a parenthesized conditional constructs the chosen class', '''
  A = class then constructor: -> @n = 1
  B = class then constructor: -> @n = 2
  [((if true then A else B).new()).n, ((if false then A else B).new()).n]
''', [1, 2]
test 'a parenthesized arrow is the constructor', '''
  x = (-> @n = 7).new()
  x.n
''', 7
test 'a parenthesized class expression is the constructor', '''
  x = (class then constructor: -> @n = 9).new()
  x.n
''', 9
# The tag call IS the constructor: `new tag"hi"` constructs what the tag
# returns, and the ordinary expression path already lowers the template.
code 'new on a tagged template constructs the tag result', 'x = tag"hi".new()', 'let x = new (tag`hi`)();'

test 'super in constructor', '''
  class Animal
    constructor: (@name) ->
  class Dog extends Animal
    constructor: (name, @breed) ->
      super(name)
  d = Dog.new('Spot', 'Terrier'); d.name
''', 'Spot'

test 'multiple @ parameters', '''
  class Person
    constructor: (@first, @last) ->
  p = Person.new('John', 'Doe')
  [p.first, p.last]
''', ['John', 'Doe']

test 'promoted parameter with default', '''
  class P
    constructor: (@x = 5) ->
  [P.new().x, P.new(9).x]
  ''', [5, 9]

test 'promoted beside plain parameters', '''
  class M
    constructor: (@a, b, @c) ->
      @sum = @a + b + @c
  M.new(1, 2, 3).sum
  ''', 6

test 'subclass super with promoted parameter', '''
  class Animal
    constructor: (@name) ->
  class Dog extends Animal
    constructor: (@name) -> super(@name)
  Dog.new('Spot').name
  ''', 'Spot'

fail 'promoted parameter rejects outside constructors', 'f = (@x) -> 1', 'promotes only in a constructor'
fail 'promoted parameter rejects in plain methods', 'class A\n  m: (@x) -> 1', 'promotes only in a constructor'
# A promoted parameter binds a field, which only a whole parameter can:
# inside a rest or a pattern JavaScript has no `this.x` binding.
fail 'a promoted rest rejects', 'class A\n  constructor: (...@rest) ->', ":2:20: emitter: a promoted parameter ('@rest') cannot sit inside a rest or a destructuring pattern — JavaScript binds no `this.rest` there; bind a plain name and assign '@rest = rest' in the body"
fail 'a promoted array element rejects', 'class A\n  constructor: ([@a, b]) ->', ":2:18: emitter: a promoted parameter ('@a') cannot sit inside a rest or a destructuring pattern"
fail 'a promoted defaulted array element rejects', 'class A\n  constructor: ([@a = 1]) ->', ":2:18: emitter: a promoted parameter ('@a') cannot sit inside a rest or a destructuring pattern"
fail 'a promoted object shorthand rejects', 'class A\n  constructor: ({@a}) ->', ":2:18: emitter: a promoted parameter ('@a') cannot sit inside a rest or a destructuring pattern"
fail 'a promoted defaulted object shorthand rejects', 'class A\n  constructor: ({@a = 1}) ->', ":2:18: emitter: a promoted parameter ('@a') cannot sit inside a rest or a destructuring pattern"
fail 'a promoted object value rejects', 'class A\n  constructor: ({a: @b}) ->', ":2:21: emitter: a promoted parameter ('@b') cannot sit inside a rest or a destructuring pattern"
fail 'a promoted element of a nested pattern rejects', 'class A\n  constructor: ([{@z}]) ->', ":2:19: emitter: a promoted parameter ('@z') cannot sit inside a rest or a destructuring pattern"
fail 'a promoted element of a gap tail pattern rejects', 'class A\n  constructor: (a, ..., [@z]) ->', ":2:26: emitter: a promoted parameter ('@z') cannot sit inside a rest or a destructuring pattern"
fail 'a promoted pattern element rejects outside a constructor', 'f = ([@a, b]) -> b', ":1:7: emitter: a promoted parameter ('@a') cannot sit inside a rest or a destructuring pattern"
fail 'a promoted rest rejects outside a constructor', 'f = (...@rest) -> 1', ":1:9: emitter: a promoted parameter ('@rest') cannot sit inside a rest or a destructuring pattern"
# Any member or index target in a parameter pattern rejects: a parameter
# list declares names.
fail 'a member element of a parameter pattern rejects', 'f = ([a.b]) -> 1', ":1:7: emitter: a parameter pattern binds names only — a member or index target cannot sit inside it, since JavaScript declares no property in a parameter list; bind a plain name and assign the member in the body"
fail 'a member value of a parameter pattern rejects', 'f = ({k: a.b}) -> 1', ":1:10: emitter: a parameter pattern binds names only"
fail 'a field member element of a method parameter pattern rejects', 'class A\n  m: ([@a.b]) -> 1', ":2:8: emitter: a parameter pattern binds names only"
fail 'a field index element of a constructor parameter pattern rejects', 'class A\n  constructor: ([@a[0]]) ->\n    1', ":2:18: emitter: a parameter pattern binds names only"
# A class field named `it` is a member, never a bare `it`; a field's
# value is an expression and reads one.
test 'a typed class field named it is no bare it', "f = (x) ->\n  class A\n    it: number\n  A.name\nf 3", 'A'
test 'a class field named it is no bare it', "f = (x) ->\n  class A\n    it = 5\n    m: -> @it\n  A.new().m()\nf 3", 5
fail 'a class field value reads a bare it', "f = (x) ->\n  class A\n    k = it\n  1", ":3:9: emitter: bare `it` has no binding here"
# The class scan rejects a bound method with no constructor, or a second
# constructor, before any member's own check runs.
fail 'a bound method with no constructor rejects before its body is checked', "class A\n  m: => it", ":2:3: emitter: bound ('=>') class methods require an explicit constructor"
fail 'a second constructor rejects before its body is checked', "class A\n  constructor: -> 1\n  constructor: -> it", ':3:3: emitter: a class has one constructor'
test 'a parameter default reads a field', '''
  class A
    k = 3
    m: (b = @k) -> b
  A.new().m()
  ''', 3

test 'super with @param', '''
  class Animal
    constructor: (@name) ->
  class Dog extends Animal
    constructor: (@name) -> super @name, "woof"
  d = Dog.new "Rex"
  d.name
''', 'Rex'

test '@param with default', '''
  class Counter
    constructor: (@count = 0) ->
  c = Counter.new 10
  c.count
''', 10

test '@param default no args', '''
  class Counter
    constructor: (@count = 0) ->
  c = Counter.new()
  c.count
''', 0

test 'ruby-style new chained', '''
  class Builder
    constructor: (@val) ->
    get: -> @val
  Builder.new(42).get()
''', 42

# ==============================================================================
# Static inner classes — class @Name inside a class body is
# static Name = class [extends P] { … }; the top-level form rejects
# ==============================================================================

test '@param works with extra statements', '''
  class Animal
    constructor: (@name) ->
    speak: -> @name
    class @Baby
      cry: -> "waa"
  a = Animal.new('Dog')
  [a.name, a.speak(), Animal.Baby?]
''', ['Dog', 'Dog', true]

test 'subclass @param works with extra statements', '''
  class Base
    constructor: (@id) ->
  class Sub extends Base
    constructor: (id, @label) ->
      super(id)
    class @Helper
      help: -> true
  s = Sub.new(1, 'x')
  [s.id, s.label]
''', [1, 'x']

test 'bound method works with extra statements', '''
  class Handler
    constructor: ->
      @count = 0
    onClick: => @count += 1
    class @Util
      noop: ->
  h = Handler.new()
  fn = h.onClick
  fn()
  h.count
''', 1

test 'async method works with extra statements', '''
  class Svc
    fetch: -> await Promise.resolve(42)
    class @Inner
      noop: ->
  do ->
    s = Svc.new()
    await s.fetch()
''', 42

test 'static inner class extends', '''
  class Animal
    constructor: (@name) ->
  class Ext
    class @Kid extends Animal
      who: -> @name
  Ext.Kid.new('kid').who()
  ''', 'kid'

fail 'class @Name rejects at the top level', 'class @Top\n  x: -> 1', 'STATIC member class'

# `new new X()` constructs from a construction: the inner `new X()` is
# the constructor, so it groups — bare, the outer `new` would read the
# inner as a call of a function named `new`.
code 'new of a construction groups the inner construction', 'X.new().new()', 'new (new X())();'

# ==============================================================================
# `def` methods and get/set accessors in class bodies
# ==============================================================================

test 'def declares a class method, def @ a static one', '''
    class A
      def double(x)
        x * 2
      def @make()
        A.new()
      def @typed(): number
        7
    [A.make().double(4), A.typed()]
  ''', [8, 7]

test 'a void def method returns undefined', '''
    class A
      def run!()
        @ran = true
      def @reset!(): void
        @count = 0
      def @bump!()
        @count++
    a = A.new()
    A.reset()
    A.bump()
    [a.run(), a.ran, A.count]
  ''', [null, true, 1]

test 'def constructor promotes parameters', '''
    class P
      def constructor(@name)
        @ok = true
    p = P.new('x')
    [p.name, p.ok]
  ''', ['x', true]

test 'get and set accessors', '''
    class T
      constructor: -> @_v = 1
      get v: -> @_v * 10
      set v: (n) -> @_v = n
      get @kind: -> 'T'
    t = T.new()
    t.v = 3
    [t.v, T.kind]
  ''', [30, 'T']

code 'a setter body emits void', 'class T\n  set v: (n) -> @_v = n', '''
    class T {
      set v(n) {
        this._v = n;
      }
    }
  '''

fail 'a getter takes no parameters', 'class A\n  get x: (a) -> a', 'getter takes no parameters'
fail 'a setter takes one parameter', 'class A\n  set x: -> 1', 'setter takes exactly one parameter'
fail 'accessors are never bound', 'class A\n  get x: => 1', "accessor takes '->'"
fail 'a static def outside a class rejects', 'def @m()\n  1', 'static class method'

test 'parenless def forms in a class body', '''
    class A
      def b
        'hello'
      def @c
        'static'
      def d!
        @x = 1
      def e: string
        'typed'
    a = A.new()
    [a.b(), A.c(), a.d(), a.x, a.e()]
  ''', ['hello', 'static', null, 1, 'typed']

test 'generic defs in a class body, instance and static', '''
    class Box
      def id<T>(x: T): T
        x
      def @wrap<T>(x: T): T[]
        [x]
      def @pair<T>(x: T)
        [x, x]
    [Box.new().id(3), Box.wrap(4), Box.pair(5)]
  ''', [3, [4], [5, 5]]

code 'a class def sees module bindings as a method does', 'x = 1\nclass A\n  def m()\n    x = 2', '''
    let x = 1;
    class A {
      m() {
        return (x = 2);
      }
    }
  '''

fail 'a setter cannot return a value', 'class A\n  set v: (n) ->\n    return 1', 'a setter discards its return value'
fail 'a void def nested in a setter keeps its own reason', 'class A\n  set v: (n) ->\n    def g!()\n      return 1', "the trailing '!'"
fail 'a constructor cannot be a getter', 'class A\n  get constructor: -> 1', 'cannot be a get accessor'
fail 'a constructor cannot be a setter', 'class A\n  set constructor: (v) -> 1', 'cannot be a set accessor'
fail 'a field and an accessor cannot share a name', 'class A\n  x = 1\n  get x: -> 2', 'share a name'
fail 'a typed field and a setter cannot share a name', 'class A\n  x: number\n  set x: (v) -> 1', 'share a name'
fail 'a static field and a static accessor cannot share a name', 'class A\n  @x = 1\n  get @x: -> 2', 'share a name'
code 'a static field and an instance accessor may share a name', 'class A\n  @x = 1\n  get x: -> 2', 'class A {\n  static x = 1;\n  get x() {\n    return 2;\n  }\n}'
code 'a static member named constructor is an ordinary static method', 'class A\n  def @constructor()\n    1', 'class A {\n  static constructor() {\n    return 1;\n  }\n}'
code 'a parameterless static def with a return type', 'class A\n  def @g: number\n    1', 'class A {\n  static g() {\n    return 1;\n  }\n}'
code 'a parameterless static void def with a return type', 'class A\n  def @h!: void\n    log 1', 'class A {\n  static h() {\n    log(1);\n    return;\n  }\n}'
code 'a parameterless generic def takes a return type', 'class A\n  def @g<T>: T\n    1', 'class A {\n  static g() {\n    return 1;\n  }\n}'
code 'generic void defs in a class body, instance and static', 'class A\n  def m!<T>(x: T): void\n    log x\n  def @n!<T>(x: T)\n    log x', 'class A {\n  m(x) {\n    log(x);\n    return;\n  }\n  static n(x) {\n    log(x);\n    return;\n  }\n}'

# JavaScript takes a LeftHandSideExpression after `extends` — a name, a
# spine, a call. Any other heritage groups, and a heritage that awaits
# makes the ENCLOSING function async: a class body owns its awaits, its
# heritage evaluates outside it.
code 'a name heritage stays bare', 'x = class extends Base', '''
  let x = class extends Base {
  };
  '''
code 'a call heritage stays bare', 'x = class extends mix(A, B)', '''
  let x = class extends mix(A, B) {
  };
  '''
code 'a logical heritage groups', 'x = class extends (a or b)', '''
  let x = class extends (a || b) {
  };
  '''
code 'a conditional heritage groups', 'x = class extends (if c then A else B)', '''
  let x = class extends (c ? A : B) {
  };
  '''
code 'a construction heritage stays bare', 'x = class extends Base.new()', '''
  let x = class extends new Base() {
  };
  '''
code 'a yielding heritage groups and makes its function a generator', 'g = -> class extends (yield 1)', '''
  let g = function*() {
    return class extends (yield 1) {
    };
  };
  '''
code 'an awaited heritage groups and makes its function async', 'g = -> class extends (f!)', '''
  let g = async function() {
    return class extends (await f()) {
    };
  };
  '''
test 'a conditional heritage extends the chosen class', '''
  class A
    who: -> 'a'
  class B
    who: -> 'b'
  K = class extends (if false then A else B)
  (K.new()).who()
''', 'b'
fail 'a parameter default cannot await in a class heritage', 'g = (a = class extends (f!)) -> a', 'a parameter cannot await or yield'

# A class has one constructor; JavaScript refuses a second at load.
fail "a second constructor rejects", "class A\n  constructor: -> @a = 1\n  constructor: -> @a = 2", "a class has one constructor"
test "a static member named constructor is not the constructor", "class A\n  constructor: -> @a = 1\n  @constructor: -> 'static'\n[(A.new()).a, A.constructor()]", [1, "static"]
fail "a constructor that awaits rejects", "class A\n  constructor: -> @x = f!()", "a constructor cannot await or yield"
fail "a constructor that yields rejects", "class A\n  constructor: ->\n    yield 1", "a constructor cannot await or yield"
test "a constructor may build an async function that awaits", "class A\n  constructor: -> @load = -> f!()\ntypeof (A.new()).load", "function"
fail "private at the top level is reserved", "x = 1\nprivate y = 2", "'private' marks a class member"
