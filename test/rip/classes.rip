# Test: Classes (2 node types)
# Tests "class" and "super" node types

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# Class Definitions: "class"
# ==============================================================================

# Class with methods
test "class methods", "class Math\n  add: (a, b) -> a + b\n  multiply: (a, b) -> a * b\nm = new Math(); m.add(2, 3)", 5

# Static methods
test "static method", "class Utils\n  @square: (x) -> x * x\nUtils.square(5)", 25

# Class with constructor logic
test "constructor logic", "class Counter\n  constructor: ->\n    @count = 0\n  increment: -> @count += 1\nc = new Counter(); c.increment(); c.count", 1

# ==============================================================================
# Super Calls: "super"
# ==============================================================================

# Super method call
test "super method call", "class Animal\n  speak: -> 'sound'\nclass Dog extends Animal\n  speak: -> super.speak() + '!'\nd = new Dog(); d.speak()", "sound!"

# Super with spread arguments (Rip ES6 prefix syntax)

test "super with spread args", '''
  class Parent
    method: (...args) -> args.join('-')

  class Child extends Parent
    method: -> super(...arguments)

  c = new Child()
  c.method(1, 2, 3)
''', '1-2-3'

# ==============================================================================
# More Class Features
# ==============================================================================

# Class expressions

test 'class expression', '''
  Animal = class
    speak: -> 'sound'
  new Animal().speak()
  ''', 'sound'

# Empty class

test 'empty class', '''
  class Empty
  new Empty().constructor.name
  ''', 'Empty'

# One-line class body — `then` is the body introducer, not loose `and`
test 'class then-body', '''
  class E extends Error then noop
  (new E()) instanceof Error
''', true

# Method chaining

test 'method chaining', '''
  class Builder
    setValue: (v) -> @value = v; this
    getValue: -> @value
  new Builder().setValue(42).getValue()
  ''', 42

# Bound methods

test 'bound method', '''
  class Counter
    constructor: -> @count = 0
    increment: => @count++
  c = new Counter()
  fn = c.increment
  fn()
  c.count
  ''', 1

# instanceof

test 'instanceof check', '''
  class Animal
  a = new Animal()
  a instanceof Animal
  ''', true

# Override method

test 'override method', '''
  class Animal
    speak: -> 'sound'
  class Dog extends Animal
    speak: -> 'bark'
  new Dog().speak()
  ''', 'bark'

# Constructor explicit return

test 'constructor explicit return', '''
  class A
    constructor: ->
      return {custom: 'object'}
  new A().custom
  ''', 'object'

# Async method

test 'async method', '''
  class Async
    getData: -> await Promise.resolve(42)
  do ->
    await new Async().getData()
  ''', 42

# Four-level inheritance

test 'four-level inheritance', '''
  class A
    val: -> 'a'
  class B extends A
  class C extends B
  class D extends C
  new D().val()
  ''', 'a'

# ==============================================================================
# Ruby-style Constructor: XXX.new()
# ==============================================================================

# Code generation
code "ruby-style new", "Counter.new()", "new Counter();"
code "ruby-style new args", "Counter.new(1, 2)", "new Counter(1, 2);"
code "ruby-style new expression", "getClass().new(x)", "new (getClass())(x);"

# ==============================================================================
# Meta Properties
# ==============================================================================

# ==============================================================================
# Class with additional statements (object body + nested class/extra stmts)
# @param, bound methods, and async must work even with extra statements present
# ==============================================================================

# ==============================================================================
# Class name restriction
# ==============================================================================
# `class App.Sub` and `class arr[0]` used to parse but produce broken JS
# (`class .,App,Sub`) because the codegen interpolated the array-shaped name
# into a `class ${name}` template. The grammar now restricts class names to
# Identifier or ThisProperty (the latter enabling nested static classes).

fail "class with member-access name does not parse",
  'class App.Sub'

fail "class with index name does not parse", '''
  arr = []
  class arr[0]
  '''

# ==============================================================================
# new.target — the meta-property distinguishes construction from a plain call
# ==============================================================================

test "new.target in constructor", '''
  class A
    constructor: ->
      @viaNew = new.target isnt undefined
  new A().viaNew
''', true

code "new.target passes through", "class A\n  constructor: ->\n    @t = new.target", "class A {\n  constructor() {\n    this.t = new.target;\n  }\n};"

# ==============================================================================
# Promoted Parameters — constructor: (@name) -> assigns this.name; inside a
# leading super(...) call @name reads the parameter (this is not yet available)
# ==============================================================================

test 'basic class', '''
  class Animal
    constructor: (@name) ->
    speak: -> @name
  a = new Animal('Dog'); a.speak()
''', 'Dog'

test 'class inheritance', '''
  class Animal
    constructor: (@name) ->
  class Dog extends Animal
    bark: -> 'woof'
  d = new Dog('Spot'); d.name
''', 'Spot'

code 'simple class', '''
  class Animal
    constructor: (@name) ->
''', 'class Animal { constructor(name) { this.name = name; } }'

# A soaking spine cannot be constructed THROUGH — it seals into a value
# first. Parens alone are what the spec asks for and node accepts them,
# but bun, which runs rip, refuses every parenthesized optional chain
# under `new`. So the seal has to yield a value, which is what the
# coalesce is for: it reads like a no-op and is not, so the bytes are
# pinned here rather than left to a comment.
code 'new through a soaking spine seals it', 'x = new a?.b', 'let x = new (a?.b ?? undefined)();'
code 'a sealed spine keeps its own arguments', 'x = new a?.b(1)', 'let x = new (a?.b ?? undefined)(1);'
code 'a soak deeper in the spine seals the whole spine', 'x = new a.b?.c.d', 'let x = new (a.b?.c.d ?? undefined)();'
# An INDEX link fails exactly as a member link does, so the seal walks
# both — the spine's four link kinds are `.`, `?.`, `[]` and `optindex`.
code 'an index tail after a soak seals too', 'x = new a?.b["c"]', 'let x = new (a?.b["c"] ?? undefined)();'
code 'an index-tailed soak keeps its arguments', 'x = new a?.b["c"](1)', 'let x = new (a?.b["c"] ?? undefined)(1);'
code 'a soaking spine under new new seals inside', 'x = new new a?.b', 'let x = new (new (a?.b ?? undefined)())();'
code 'an ordinary new new groups the inner construction', 'x = new new a', 'let x = new (new a())();'
code 'a plain index spine takes no seal', 'x = new a["b"]', 'let x = new a["b"]();'
# `X.new(...)` is rip's own construction sugar, so a soaking target
# seals there too — and `new` OVER that form constructs what the ruby
# construction returned, rather than reading a property named `new`.
code 'ruby construction seals a soaking target', 'x = a?.b.new(1)', 'let x = new (a?.b ?? undefined)(1);'
code 'new over a soaking ruby construction still constructs', 'x = new a?.b.new(1)', 'let x = new (new (a?.b ?? undefined)(1))();'
code 'a bare .new read on a soaking spine stays a read', 'x = a?.b.new', 'let x = a?.b.new;'
code 'a spine with no soak takes no seal', 'x = new a.b', 'let x = new a.b();'

# A construction always spells its argument list. `new a.b` alone means
# the same in JavaScript, but anything chained after it would bind into
# the constructor spine: printed bare, `(new a.b).c` is `new a.b.c`,
# which constructs a different thing.
code 'a member read after a member construction reads the instance', 'x = (new a.b).c', 'let x = new a.b().c;'
code 'an index read after a member construction reads the instance', 'x = (new a.b)[0]', 'let x = new a.b()[0];'
code 'a call after a member construction calls the instance', 'x = (new a.b)(1)', 'let x = new a.b()(1);'
code 'a method call after a member construction calls the instance', 'x = (new a.b).c()', 'let x = new a.b().c();'
code 'a member read after an index construction reads the instance', 'x = (new a[0]).c', 'let x = new a[0]().c;'
# An optional call or index DIRECTLY on a construction that spells no
# argument list has no reading: JavaScript refuses `new X?.()`, and the
# spelling does not say whether the soak guards the constructor or the
# instance. An argument list closes the construction, and so do parens.
fail 'an optional call directly on a bare construction rejects', 'x = new a.b?(1)', 'directly on a construction with no argument list has no reading'
fail 'an optional call directly on a bare named construction rejects', 'x = new Foo?(1)', 'directly on a construction with no argument list has no reading'
fail 'an optional index directly on a bare construction rejects', 'x = new a.b?[0]', 'directly on a construction with no argument list has no reading'
fail 'a parenthesized call operand spells no argument list of its own', 'x = new (f())?(1)', 'directly on a construction with no argument list has no reading'
fail 'the rejection names the conditional-construction spelling', 'x = new Foo?(1)', 'To construct only when the class exists, test it'
code 'constructing only when the class exists is spelled with a test', 'x = if Foo? then new Foo(1)', 'let x = (Foo != null) ? new Foo(1) : undefined;'
test 'a tested construction skips a missing class and builds a present one', '''
  class Here
    constructor: (n) -> @n = n
  Gone = null
  a = if Here? then new Here(7)
  b = if Gone? then new Gone(7)
  [a.n, b]
''', [7, undefined]
code 'an optional call after a closed construction soaks the instance', 'x = new X(1)?(2)', 'let x = new X(1)?.(2);'
code 'an optional index after a closed construction soaks the instance', 'x = new X(1)?[0]', 'let x = new X(1)?.[0];'
code 'an empty argument list closes the construction too', 'x = new X()?(2)', 'let x = new X()?.(2);'
code 'a sealed constructor with its list is closed', 'x = new (a or b)(1)?(2)', 'let x = new (a || b)(1)?.(2);'
code 'an optional call after a parenthesized construction soaks the instance', 'x = (new a.b)?(1)', 'let x = new a.b()?.(1);'
code 'an optional index after a parenthesized construction soaks the instance', 'x = (new a.b)?[0]', 'let x = new a.b()?.[0];'
code 'an optional member after a parenthesized construction', 'x = (new a.b)?.c', 'let x = new a.b()?.c;'
test 'a member read after a member construction reads the instance, at run time', '''
  class K
    constructor: -> @c = 'instance'
  K.c = 'static'
  ns = { K }
  (new ns.K).c
''', 'instance'
test 'a call after a member construction calls the instance, at run time', '''
  Make = -> return (n) -> n * 2
  ns = { Make }
  (new ns.Make)(21)
''', 42

# `new` constructs an EXPRESSION standing in parens whole. A parenthesized
# call constructs what the call returns, never the callee; an operator,
# control, cast, function, or class expression is the constructor itself.
code 'a parenthesized call is the constructor', 'x = new (f())', 'let x = new (f())();'
code 'a parenthesized call keeps the outer arguments', 'x = new (f(1))(2)', 'let x = new (f(1))(2);'
code 'an unparenthesized call constructs its callee', 'x = new f(1)', 'let x = new f(1);'
code 'parens around a pure constructor spine are redundant', 'x = new (a.b)(1)', 'let x = new a.b(1);'
code 'parens around a spine that holds a call decide what is constructed', 'x = new (a().b)(1)', 'let x = new (a().b)(1);'
code 'parens around a deeper call-holding spine are kept', 'x = new (a.b().c)(1)', 'let x = new (a.b().c)(1);'
# A spine that holds a call seals WHOLE, wherever its parens stood in the
# source, with or without an argument list. Printed bare, each of these
# would construct the call's callee and then run the rest on the instance.
code 'a call-holding spine with no argument list seals', 'x = new (a().b)', 'let x = new (a().b)();'
code 'a member of a parenthesized call seals with the call', 'x = new (f()).b', 'let x = new (f().b)();'
code 'a member of a parenthesized call keeps its arguments', 'x = new (f()).b(1)', 'let x = new (f().b)(1);'
code 'an index of a parenthesized call seals with the call', 'x = new (f())[0](1)', 'let x = new (f()[0])(1);'
code 'a deeper member of a call-holding spine seals whole', 'x = new (a().b).c(1)', 'let x = new (a().b.c)(1);'
code 'a chain after a sealed construction reads the instance', 'x = (new (a().b)).c', 'let x = new (a().b)().c;'
code 'a chain after new new reads the outer instance', 'x = (new new a).c', 'let x = new (new a())().c;'
code 'a call after new new calls the outer instance', 'x = (new new F)(1)', 'let x = new (new F())()(1);'
code 'new over a ruby construction constructs what it returns', 'x = new Outer.new(1)', 'let x = new (new Outer(1))();'
code 'a chain after new over a ruby construction reads the instance', 'x = (new Outer.new(1)).c', 'let x = new (new Outer(1))().c;'
test 'a member of a parenthesized call constructs what the call holds', '''
  class Inner
    constructor: (n) -> @n = n ?? 'none'
  host = -> { Inner }
  [(new (host()).Inner).n, (new (host()).Inner(7)).n, (new (host().Inner)).n]
''', ['none', 7, 'none']
test 'a chain after new new reads the outer instance, at run time', '''
  class Leaf
    constructor: -> @c = 'leaf-instance'
  Outer = -> return Leaf
  (new new Outer).c
''', 'leaf-instance'
test 'a parenthesized call-holding spine constructs what it names', '''
  class Inner
    constructor: (n) -> @n = n
  host = -> { Inner }
  (new (host().Inner)(7)).n
''', 7
code 'a parenthesized logical is the constructor', 'x = new (a or b)', 'let x = new (a || b)();'
code 'a parenthesized logical keeps its arguments', 'x = new (a or b)(1)', 'let x = new (a || b)(1);'
code 'a parenthesized nullish is the constructor', 'x = new (a ?? b)', 'let x = new (a ?? b)();'
code 'a parenthesized conditional is the constructor', 'x = new (if c then A else B)', 'let x = new (c ? A : B)();'
code 'a parenthesized await is the constructor', 'x = new (await f())', 'let x = new (await f())();'
code 'a parenthesized cast is the constructor', 'x = new (k as any)', 'let x = new (k)();'
code 'a parenthesized maybe dammit is the constructor', 'x = new (f?!)', 'let x = new (await f?.())();'
code 'a parenthesized existence is the constructor', 'x = new (f?)', 'let x = new (f != null)();'
test 'a parenthesized call constructs what the call returns', '''
  pick = -> class then constructor: -> @kind = 'returned'
  pick.prototype.kind = 'callee'
  (new (pick())).kind
''', 'returned'
test 'a parenthesized conditional constructs the chosen class', '''
  A = class then constructor: -> @n = 1
  B = class then constructor: -> @n = 2
  [(new (if true then A else B)).n, (new (if false then A else B)).n]
''', [1, 2]
test 'a parenthesized arrow is the constructor', '''
  x = new (-> @n = 7)
  x.n
''', 7
test 'a parenthesized class expression is the constructor', '''
  x = new (class then constructor: -> @n = 9)
  x.n
''', 9
# The tag call IS the constructor: `new tag"hi"` constructs what the tag
# returns, and the ordinary expression path already lowers the template.
code 'new on a tagged template constructs the tag result', 'x = new tag"hi"', 'let x = new (tag`hi`)();'

test 'super in constructor', '''
  class Animal
    constructor: (@name) ->
  class Dog extends Animal
    constructor: (name, @breed) ->
      super(name)
  d = new Dog('Spot', 'Terrier'); d.name
''', 'Spot'

test 'multiple @ parameters', '''
  class Person
    constructor: (@first, @last) ->
  p = new Person('John', 'Doe')
  [p.first, p.last]
''', ['John', 'Doe']

test 'promoted parameter with default', '''
  class P
    constructor: (@x = 5) ->
  [new P().x, new P(9).x]
  ''', [5, 9]

test 'promoted beside plain parameters', '''
  class M
    constructor: (@a, b, @c) ->
      @sum = @a + b + @c
  new M(1, 2, 3).sum
  ''', 6

test 'subclass super with promoted parameter', '''
  class Animal
    constructor: (@name) ->
  class Dog extends Animal
    constructor: (@name) -> super(@name)
  new Dog('Spot').name
  ''', 'Spot'

fail 'promoted parameter rejects outside constructors', 'f = (@x) -> 1', 'promotes only in a constructor'
fail 'promoted parameter rejects in plain methods', 'class A\n  m: (@x) -> 1', 'promotes only in a constructor'

test 'super with @param', '''
  class Animal
    constructor: (@name) ->
  class Dog extends Animal
    constructor: (@name) -> super @name, "woof"
  d = Dog.new "Rex"
  d.name
''', 'Rex'

test '@param with default', '''
  class Counter
    constructor: (@count = 0) ->
  c = Counter.new 10
  c.count
''', 10

test '@param default no args', '''
  class Counter
    constructor: (@count = 0) ->
  c = Counter.new()
  c.count
''', 0

test 'ruby-style new chained', '''
  class Builder
    constructor: (@val) ->
    get: -> @val
  Builder.new(42).get()
''', 42

# ==============================================================================
# Static inner classes — class @Name inside a class body is
# static Name = class [extends P] { … }; the top-level form rejects
# ==============================================================================

test '@param works with extra statements', '''
  class Animal
    constructor: (@name) ->
    speak: -> @name
    class @Baby
      cry: -> "waa"
  a = new Animal('Dog')
  [a.name, a.speak(), Animal.Baby?]
''', ['Dog', 'Dog', true]

test 'subclass @param works with extra statements', '''
  class Base
    constructor: (@id) ->
  class Sub extends Base
    constructor: (id, @label) ->
      super(id)
    class @Helper
      help: -> true
  s = new Sub(1, 'x')
  [s.id, s.label]
''', [1, 'x']

test 'bound method works with extra statements', '''
  class Handler
    constructor: ->
      @count = 0
    onClick: => @count += 1
    class @Util
      noop: ->
  h = new Handler()
  fn = h.onClick
  fn()
  h.count
''', 1

test 'async method works with extra statements', '''
  class Svc
    fetch: -> await Promise.resolve(42)
    class @Inner
      noop: ->
  do ->
    s = new Svc()
    await s.fetch()
''', 42

test 'static inner class extends', '''
  class Animal
    constructor: (@name) ->
  class Ext
    class @Kid extends Animal
      who: -> @name
  new Ext.Kid('kid').who()
  ''', 'kid'

fail 'class @Name rejects at the top level', 'class @Top\n  x: -> 1', 'STATIC member class'

# `new new X()` constructs from a construction: the inner `new X()` is
# the constructor, so it groups — bare, the outer `new` would read the
# inner as a call of a function named `new`.
code 'new of a construction groups the inner construction', 'new new X()', 'new (new X())();'

# ==============================================================================
# `def` methods and get/set accessors in class bodies
# ==============================================================================

test 'def declares a class method, def @ a static one', '''
    class A
      def double(x)
        x * 2
      def @make()
        new A()
      def @typed(): number
        7
    [A.make().double(4), A.typed()]
  ''', [8, 7]

test 'a void def method returns undefined', '''
    class A
      def run!()
        @ran = true
      def @reset!(): void
        @count = 0
      def @bump!()
        @count++
    a = new A()
    A.reset()
    A.bump()
    [a.run(), a.ran, A.count]
  ''', [null, true, 1]

test 'def constructor promotes parameters', '''
    class P
      def constructor(@name)
        @ok = true
    p = new P('x')
    [p.name, p.ok]
  ''', ['x', true]

test 'get and set accessors', '''
    class T
      constructor: -> @_v = 1
      get v: -> @_v * 10
      set v: (n) -> @_v = n
      get @kind: -> 'T'
    t = new T()
    t.v = 3
    [t.v, T.kind]
  ''', [30, 'T']

code 'a setter body emits void', 'class T\n  set v: (n) -> @_v = n', '''
    class T {
      set v(n) {
        this._v = n;
      }
    }
  '''

fail 'a getter takes no parameters', 'class A\n  get x: (a) -> a', 'getter takes no parameters'
fail 'a setter takes one parameter', 'class A\n  set x: -> 1', 'setter takes exactly one parameter'
fail 'accessors are never bound', 'class A\n  get x: => 1', "accessor takes '->'"
fail 'a static def outside a class rejects', 'def @m()\n  1', 'static class method'

test 'parenless def forms in a class body', '''
    class A
      def b
        'hello'
      def @c
        'static'
      def d!
        @x = 1
      def e: string
        'typed'
    a = new A()
    [a.b(), A.c(), a.d(), a.x, a.e()]
  ''', ['hello', 'static', null, 1, 'typed']

test 'generic defs in a class body, instance and static', '''
    class Box
      def id<T>(x: T): T
        x
      def @wrap<T>(x: T): T[]
        [x]
      def @pair<T>(x: T)
        [x, x]
    [new Box().id(3), Box.wrap(4), Box.pair(5)]
  ''', [3, [4], [5, 5]]

code 'a class def sees module bindings as a method does', 'x = 1\nclass A\n  def m()\n    x = 2', '''
    let x = 1;
    class A {
      m() {
        return (x = 2);
      }
    }
  '''

fail 'a setter cannot return a value', 'class A\n  set v: (n) ->\n    return 1', 'a setter discards its return value'
fail 'a void def nested in a setter keeps its own reason', 'class A\n  set v: (n) ->\n    def g!()\n      return 1', "the trailing '!'"
fail 'a constructor cannot be a getter', 'class A\n  get constructor: -> 1', 'cannot be a get accessor'
fail 'a constructor cannot be a setter', 'class A\n  set constructor: (v) -> 1', 'cannot be a set accessor'
fail 'a field and an accessor cannot share a name', 'class A\n  x = 1\n  get x: -> 2', 'share a name'
fail 'a typed field and a setter cannot share a name', 'class A\n  x: number\n  set x: (v) -> 1', 'share a name'
fail 'a static field and a static accessor cannot share a name', 'class A\n  @x = 1\n  get @x: -> 2', 'share a name'
code 'a static field and an instance accessor may share a name', 'class A\n  @x = 1\n  get x: -> 2', 'class A {\n  static x = 1;\n  get x() {\n    return 2;\n  }\n}'
code 'a static member named constructor is an ordinary static method', 'class A\n  def @constructor()\n    1', 'class A {\n  static constructor() {\n    return 1;\n  }\n}'
code 'a parameterless static def with a return type', 'class A\n  def @g: number\n    1', 'class A {\n  static g() {\n    return 1;\n  }\n}'
code 'a parameterless static void def with a return type', 'class A\n  def @h!: void\n    log 1', 'class A {\n  static h() {\n    log(1);\n    return;\n  }\n}'
code 'a parameterless generic def takes a return type', 'class A\n  def @g<T>: T\n    1', 'class A {\n  static g() {\n    return 1;\n  }\n}'

# JavaScript takes a LeftHandSideExpression after `extends` — a name, a
# spine, a call. Any other heritage groups, and a heritage that awaits
# makes the ENCLOSING function async: a class body owns its awaits, its
# heritage evaluates outside it.
code 'a name heritage stays bare', 'x = class extends Base', '''
  let x = class extends Base {
  };
  '''
code 'a call heritage stays bare', 'x = class extends mix(A, B)', '''
  let x = class extends mix(A, B) {
  };
  '''
code 'a logical heritage groups', 'x = class extends (a or b)', '''
  let x = class extends (a || b) {
  };
  '''
code 'a conditional heritage groups', 'x = class extends (if c then A else B)', '''
  let x = class extends (c ? A : B) {
  };
  '''
code 'a construction heritage stays bare', 'x = class extends new Base', '''
  let x = class extends new Base() {
  };
  '''
code 'a yielding heritage groups and makes its function a generator', 'g = -> class extends (yield 1)', '''
  let g = function*() {
    return class extends (yield 1) {
    };
  };
  '''
code 'an awaited heritage groups and makes its function async', 'g = -> class extends (f!)', '''
  let g = async function() {
    return class extends (await f()) {
    };
  };
  '''
test 'a conditional heritage extends the chosen class', '''
  class A
    who: -> 'a'
  class B
    who: -> 'b'
  K = class extends (if false then A else B)
  (new K).who()
''', 'b'
fail 'a parameter default cannot await in a class heritage', 'g = (a = class extends (f!)) -> a', 'a parameter cannot await or yield'

