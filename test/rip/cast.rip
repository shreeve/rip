# Test: `expr as Type` cast operator
#
# A TypeScript-style postfix type assertion. The cast is ERASED at runtime
# (the value is emitted unchanged) and only re-materializes as a real TS
# `(expr as Type)` in the shadow-TS check path (`inlineTypes`). The type RHS
# is stripped to a string by the type rewriter, so the grammar never parses a
# type — `as` reuses the same machinery as `::` annotations.

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# Runtime erasure — the cast leaves no trace in the emitted JS
# ==============================================================================

code "cast on identifier erased", "y = x as Foo", "let y = x;"
code "parenthesized cast erased", "y = (x as Foo)", "let y = x;"
code "cast inside call erased", "foo(x as Bar)", "foo(x)"
code "cast inside array erased", "z = [a as T]", "let z = [a];"
code "cast on member access erased", "r = obj.prop as T", "let r = obj.prop;"
code "cast on call result erased", "c = foo(1) as T", "let c = foo(1);"
code "cast on index erased", "i = arr[0] as T", "let i = arr[0];"

# ==============================================================================
# Precedence — cast binds tighter than binary operators (postfix)
# ==============================================================================

# `x as Bar + n` is `(x as Bar) + n` — the type collection stops at `+`.
code "cast stops before plus", "y = x as Bar + n", "let y = x + n;"

# ==============================================================================
# Type operators inside the cast type are consumed, not stops
# ==============================================================================

code "cast with generic type", "m = x as Map<string, number>", "let m = x;"
code "cast with union type", "u = x as A | B", "let u = x;"
code "cast with intersection type", "k = x as A & B", "let k = x;"
code "cast with object type", "o = x as { a: number }", "let o = x;"
code "cast with array type", "a = x as number[]", "let a = x;"

# ==============================================================================
# Chaining — `x as A as B`
# ==============================================================================

code "chained casts erased", "y = x as A as B", "let y = x;"

# ==============================================================================
# `expr satisfies Type` — the same token shape, the same erasure; the TS
# face checks the value against the type instead of replacing its type
# ==============================================================================

code "satisfies on identifier erased", "y = x satisfies Foo", "let y = x;"
code "satisfies on object literal erased", "y = { a: 1 } satisfies Record<string, number>", "let y = {a: 1};"
code "satisfies inside call erased", "foo(x satisfies Bar)", "foo(x)"
code "satisfies on member access erased", "r = obj.prop satisfies T", "let r = obj.prop;"
code "parenthesized satisfies as a member head", "n = (x satisfies T).name", "let n = x.name;"
code "satisfies stops before plus", "y = x satisfies Bar + n", "let y = x + n;"
code "satisfies with union type", "u = x satisfies A | B", "let u = x;"
code "satisfies chained with a cast, either order", "y = x satisfies A as B\nz = x as A satisfies B", "let y = x;\nlet z = x;"
code "a postfix guard ends the satisfies run", "y = x satisfies T if c", "let y;\n\nif (c) y = x;"
code "satisfies is a name outside the postfix position", "satisfies = 2\no = { satisfies: 1 }\np = o.satisfies", "let satisfies = 2;\nlet o = {satisfies: 1};\nlet p = o.satisfies;"

# ==============================================================================
# Shadow-TS check path — the cast becomes a real TS assertion (it narrows)
# ==============================================================================
#
# Route A: the cast is a grammar node that reduces AFTER the full postfix
# expression is built, so EVERY carrier narrows — identifier, member access,
# AND call / index / parenthesized results.

# ==============================================================================
# Full narrowing — call / index / paren-prefixed results now narrow too
# (the route-A grammar node closes the mapping-carrier gap).
# ==============================================================================

# ==============================================================================
# `as` is NOT a cast in for / import / export / property contexts
# ==============================================================================

code "for-as iteration unaffected", '''
  for x as items
    p x
  ''', '''
  for (let x of items) {
    p(x);
  }
  '''

code "for-as! async iteration unaffected", '''
  for x as! items
    p x
  ''', '''
  for await (let x of items) {
    p(x);
  }
  '''

code "import-as alias unaffected", "import { foo as bar } from 'mod'", "import { foo as bar } from 'mod'"
code "import-namespace-as unaffected", "import * as NS from 'mod'", "import * as NS from 'mod'"
code "export-as re-export unaffected", "export { x as y } from 'mod'", "export { x as y } from 'mod'"
code "dot-as is a property, not a cast", "y = obj.as", "let y = obj.as;"

# ==============================================================================
# Signed numeric literal types
# ==============================================================================

test "a negative literal cast erases", '''
  y = 5
  x = y as -1
  x
''', 5

code "the negative literal reaches the face type", "x = y as -1.5", "let x = y;"

fail "a plus-signed literal is not a type", "x = y as +1",
  "a numeric literal type spells its sign with '-'"

fail "a cast that claims no type rejects", "x = y as -z",
  "'as' takes a type"

fail "a satisfies that claims no type rejects", "x = y satisfies -z",
  "'satisfies' takes a type"

# ==============================================================================
# The cast's type run and a following clause keyword
# ==============================================================================

# A cast inside a `try` expression that also carries a handler: the type run
# ends at the clause keyword, so `catch` opens a handler instead of being
# swallowed into the type string. Pinned rather than described in the corpus,
# because the property is invisible in the source and a type-rewriter change
# would take the handler with it silently.
code "a clause keyword ends the cast's type run", '''
  cast = try JSON.parse('broken') as { live: boolean } catch e then { live: false }
''', '''
  let cast;

  cast = (() => { try {
    return JSON.parse("broken");
  } catch (e) {
    return {live: false};
  } })();
'''

# ==============================================================================
# A trailing generic close ends the cast's line
# ==============================================================================

# The `>` closing `as D<T>` is a generic close, not a comparison waiting on a
# right operand: the next line starts its own statement in the OUTER block —
# continuation here would nest it into the wrong block silently.
code "block-final generic cast keeps the dedent", """
  def f(x)
    if x
      return g(x) as D<T>
    h(x)
  """, '''
  function f(x) {
    if (x) {
      return g(x);
    }
    return h(x);
  }
  '''

code "block-final generic cast before a sibling if", """
  def f(x)
    if x
      return g(x) as D<T, A>
    if x
      h(x)
  """, '''
  function f(x) {
    if (x) {
      return g(x);
    }
    return (x ? h(x) : undefined);
  }
  '''
