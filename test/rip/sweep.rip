# Test: Grammar sweep
# Pins every production the topical batteries never reach, so the language
# suite covers the whole grammar (test/toolchain/grammar-coverage.test.js
# is the gate). Each row names the construct; the expected output is the
# engine's current emission, which a grammar or generator refactor must
# reproduce byte for byte.

import { test, code, fail, type } from '../support/testing.js'


# ==============================================================================
# Modules
# ==============================================================================

code "side-effect import", 'import \'polyfill\'', 'import \'polyfill\';'
code "empty named import", 'import {} from \'m\'', 'import {} from \'m\';'
code "import type default", '''
  import type D from 'm'
  x = 1
  ''', '''
  let x = 1;
  '''

code "import type namespace", '''
  import type * as N from 'm'
  x = 1
  ''', '''
  let x = 1;
  '''

code "import type empty", '''
  import type {} from 'm'
  x = 1
  ''', '''
  let x = 1;
  '''

code "import type named", '''
  import type { A, B } from 'm'
  x = 1
  ''', '''
  let x = 1;
  '''

code "import list wrapped after a comma", '''
  import { a,
  b } from 'm'
  ''', '''
  import { a, b } from 'm';
  '''

code "import list fully indented", '''
  import {
    a
    b
  } from 'm'
  ''', '''
  import { a, b } from 'm';
  '''

code "import list continued on an indented line", '''
  import { a,
    b
  } from 'm'
  ''', '''
  import { a, b } from 'm';
  '''

code "import default as alias", 'import { default as d } from \'m\'', 'import { default as d } from \'m\';'
code "empty export", 'export {}', 'export {};'
code "export enum", '''
  export enum Color
    red
    green
  ''', '''
  export const Color = {red: 0, green: 1, 0: "red", 1: "green"};
  '''

code "export computed", '''
  a := 1
  export b ~= a * 2
  ''', '''
  const a = __state(1);
  export const b = __computed(() => (a.value * 2));
  '''

code "export readonly", 'export MAX =! 100', 'export const MAX = 100;'
code "export bound effect", '''
  a := 1
  export h ~> console.log a
  ''', '''
  const a = __state(1);
  export const h = __effect(() => { console.log(a.value); });
  '''

code "export default indented object", '''
  export default
    a: 1
    b: 2
  ''', '''
  export default {a: 1, b: 2};
  '''

code "empty export from", 'export {} from \'m\'', 'export {} from \'m\';'
code "export assign wrapped", '''
  export x =
  1
  ''', '''
  export const x = 1;
  '''

code "export assign indented", '''
  export x =
    1
  ''', '''
  export const x = 1;
  '''

code "export typed assign", 'export x: number = 1', 'export const x = 1;'
code "export typed assign wrapped", '''
  export x: number =
  1
  ''', '''
  export const x = 1;
  '''

code "export typed assign indented", '''
  export x: number =
    1
  ''', '''
  export const x = 1;
  '''

code "export generic component", '''
  export Chip<TLabel extends string> = component
    @label?: TLabel
    render
      span 'chip'
  ''', '''
  export const Chip = class extends __Component {
    static __props = ['label'];
    _init(props) {
      this.label = __state(props.__bind_label__ ?? props.label);
    }
    _create() {
      this._el0 = document.createElement('span');
      this._el0.setAttribute('data-part', 'Chip');
      this._t0 = document.createTextNode("chip");
      this._el0.appendChild(this._t0);
      return this._el0;
    }
  };
  '''

code "export void assign wrapped", '''
  export save! =
  -> 1
  ''', '''
  export const save = function() {
    1;
    return;
  };
  '''

code "export void assign indented", '''
  export save! =
    -> 1
  ''', '''
  export const save = function() {
    1;
    return;
  };
  '''

code "export typed state wrapped", '''
  export c: number :=
  1
  ''', '''
  export const c = __state(1);
  '''

code "export typed state indented", '''
  export c: number :=
    1
  ''', '''
  export const c = __state(1);
  '''

code "export typed computed", '''
  a := 1
  export d: number ~= a * 2
  ''', '''
  const a = __state(1);
  export const d = __computed(() => (a.value * 2));
  '''

code "export typed computed wrapped", '''
  a := 1
  export d: number ~=
  a * 2
  ''', '''
  const a = __state(1);
  export const d = __computed(() => (a.value * 2));
  '''

code "export typed computed block", '''
  a := 1
  export d: number ~=
    b = a * 2
    b + 1
  ''', '''
  const a = __state(1);
  export const d = __computed(() => {
    let b = a.value * 2;
    return (b + 1);
  });
  '''

code "export typed readonly", 'export r: number =! 1', 'export const r = 1;'
code "export typed readonly wrapped", '''
  export r: number =!
  1
  ''', '''
  export const r = 1;
  '''

code "export typed readonly indented", '''
  export r: number =!
    1
  ''', '''
  export const r = 1;
  '''

code "export typed effect", '''
  a := 1
  export h: Handle ~> console.log a
  ''', '''
  const a = __state(1);
  export const h = __effect(() => { console.log(a.value); });
  '''

code "export typed effect wrapped", '''
  a := 1
  export h: Handle ~>
  console.log a
  ''', '''
  const a = __state(1);
  export const h = __effect(() => { console.log(a.value); });
  '''

code "export typed effect block", '''
  a := 1
  export h: Handle ~>
    b = a
    console.log b
  ''', '''
  const a = __state(1);
  export const h = __effect(() => {
    let b = a.value;
    return console.log(b);
  });
  '''

code "export list continued on an indented line", '''
  a = 1
  b = 2
  export { a,
    b
  }
  ''', '''
  let a = 1;
  let b = 2;
  export { a, b };
  '''

code "export as default", '''
  a = 1
  export { a as default }
  ''', '''
  let a = 1;
  export { a as default };
  '''

code "re-export default", 'export { default } from \'m\'', 'export { default } from \'m\';'
code "re-export default as name", 'export { default as a } from \'m\'', 'export { default as a } from \'m\';'

