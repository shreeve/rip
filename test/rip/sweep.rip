code "comprehension with guard then step", '''
  (x for x in a when x by 2)
  ''', '''
  (() => {
    const result = [];
    for (let _ref = a, _i = 0; _i < _ref.length; _i += 2) {
      let x = _ref[_i];
      if (x) {
        result.push(x);
      }
    }
    return result;
  })();
  '''

