# Functions
# ==============================================================================

code "generic def", '''
  def wrap<T>(v: T)
    [v]
  ''', '''
  function wrap(v) {
    return [v];
  }
  '''

code "void def with a return type", '''
  def log!(m: string): void
    console.log m
  ''', '''
  function log(m) {
    console.log(m);
    return;
  }
  '''

code "params wrapped after a comma", '''
  f = (a,
  b) -> a + b
  ''', '''
  let f = function(a, b) {
    return (a + b);
  };
  '''

code "params continued on an indented line", '''
  f = (a,
    b
  ) -> a + b
  ''', '''
  let f = function(a, b) {
    return (a + b);
  };
  '''

code "optional typed param", '''
  f = (a?: number) -> a
  ''', '''
  let f = function(a) {
    return a;
  };
  '''

code "optional bare param", '''
  f = (a?) -> a
  ''', '''
  let f = function(a) {
    return a;
  };
  '''

code "bodiless def overload", '''
  def f(a: number): string
  def f(a)
    String a
  ''', '''
  function f(a) {
    return String(a);
  }
  '''

code "bare class", '''
  A = class
  ''', '''
  let A = class {
  };
  '''

code "anonymous class extends", '''
  A = class extends B
  ''', '''
  let A = class extends B {
  };
  '''

code "anonymous class extends with a body", '''
  A = class extends B
    m: -> 1
  ''', '''
  let A = class extends B {
    m() {
      return 1;
    }
  };
  '''

code "component body with a trailing blank line", '''
  C = component
    @n := 1;
  ''', '''
  let C = class extends __Component {
    static __props = ['n'];
    _init(props) {
      this.n = __state(props.__bind_n__ ?? props.n ?? 1);
    }
  };
  '''

code "call arguments wrapped after a comma", '''
  f(1,
  2)
  ''', '''
  f(1, 2);
  '''

code "return an indented object", '''
  f = ->
    return
      a: 1
  ''', '''
  let f = function() {
    return {a: 1};
  };
  '''

code "do on a plain expression", '''
  f = -> 1
  do f
  ''', '''
