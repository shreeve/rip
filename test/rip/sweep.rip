code "index with an indented key", '''
  a = [1]
  k = 0
  a[
    k
  ]
  ''', '''
  let a = [1];
  let k = 0;
  a[k];
  '''

code "slice with an indented range", '''
  a = [1, 2, 3]
  a[
    1..2
  ]
  ''', '''
  let a = [1, 2, 3];
  a.slice(1, 3);
  '''

code "optional index with an indented key", '''
  a = null
  k = 0
  a?.[
    k
  ]
  ''', '''
  let a = null;
  let k = 0;
  a?.[k];
  '''

code "optional pick with an indented list", '''
  o = null
  o?.{
    a
  }
  ''', '''
  let o = null;
  (o == null ? undefined : {a: o.a});
  '''

code "pick list continued on an indented line", '''
  o = {a: 1, b: 2}
  o.{a,
    b
  }
  ''', '''
  let o = {a: 1, b: 2};
  ({a: o.a, b: o.b});
  '''

code "new on a this-property", '''
  class A
    make: -> new @Inner
  ''', '''
  class A {
    make() {
      return new this.Inner;
    }
  }
  '''

code "new on this", '''
  class A
    clone: -> new @
  ''', '''
  class A {
    clone() {
      return new this();
    }
  }
  '''

code "new on a super member", '''
  class A extends B
    make: -> new super.Inner
  ''', '''
  class A extends B {
    make() {
      return new super.Inner;
    }
  }
  '''

code "leading-dot chain on an arrow", '''
  s = -> 1
    .toString()
  ''', '''
  let s = (function() {
    return 1;
  }).toString();
  '''

code "super index", '''
  class A extends B
    m: -> super[k]
  ''', '''
  class A extends B {
    m() {
      return super[k];
    }
  }
  '''

code "super index with an indented key", '''
  class A extends B
    m: -> super[
      k
    ]
  ''', '''
  class A extends B {
    m() {
      return super[k];
    }
  }
  '''

code "class body this-index key", '''
  class A
    grab: -> *{ @['seed']: 1 }
  ''', '''
  class A {
    grab() {
      return new Map([[this["seed"], 1]]);
    }
  }
  '''


# ==============================================================================
# Data
# ==============================================================================

code "all-elision array", '[,,]', '[, ,];'
code "elision list continued on an indented line", '''
  [1,,
    2,,
  ]
  ''', '''
  [1, , 2, ,];
  '''

code "elision before a newline", '''
  [1,,
  2]
  ''', '''
  [1, , 2];
  '''

code "pattern default indented", '''
  o = {}
  {a =
    1} = o
  a
  ''', '''
  let a;

  let o = {};
  ({a = 1} = o);
  a;
  '''

code "void pair", '''
  o = {f!: -> 1}
  ''', '''
  let o = {f() {
    1;
    return;
  }};
  '''

code "void pair indented", '''
  o = {f!:
    -> 1}
  ''', '''
  let o = {f() {
    1;
    return;
  }};
  '''

code "spread a call", '{...f()}', '({...f()});'
code "spread an object literal", '{...{a: 1}}', '({...{a: 1}});'
code "spread a parenthetical", '{...(o)}', '({...o});'
code "spread super member", '''
  class A extends B
    m: -> {...super.o}
  ''', '''
  class A extends B {
    m() {
      return {...super.o};
    }
  }
  '''

code "spread this", '''
  class A
    m: -> {...@}
  ''', '''
  class A {
    m() {
      return {...this};
    }
  }
  '''

code "spread super call", '''
  class A extends B
    m: -> {...super()}
  ''', '''
  class A extends B {
    m() {
      return {...super.m()};
    }
  }
  '''

code "spread dynamic import", '{...import(\'m\')}', '({...import("m")});'
code "spread a chained call", '{...f()()}', '({...f()()});'
code "spread a call member", '{...f().p}', '({...f().p});'
code "spread an optional call member", '{...f()?.p}', '({...f()?.p});'
code "spread a call index", '{...f()[k]}', '({...f()[k]});'
code "spread a call index with an indented key", '''
  {...f()[
    k
  ]}
  ''', '''
  ({...f()[k]});
  '''

code "spread an awaited call", '{...f!}', '({...await f()});'
code "spread a pick of a call", '{...f().{a}}', '({...((_) => ({a: _.a}))(f())});'
code "spread an optional pick of a call", '{...f()?.{a}}', '({...((_) => _ == null ? undefined : ({a: _.a}))(f())});'
code "spread an indented pick of a call", '''
  {...f().{
    a
  }}
  ''', '''
  ({...((_) => ({a: _.a}))(f())});
  '''

code "spread an indented optional pick of a call", '''
  {...f()?.{
    a
  }}
  ''', '''
  ({...((_) => _ == null ? undefined : ({a: _.a}))(f())});
  '''


