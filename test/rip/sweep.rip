code "gate with an empty call", '''
  C = component
    user <~ @stash.user()
  ''', '''
  let C = class extends __Component {
    static __gates = ['user'];
    _init(props) {
      this.user = __gateBind(this, 0);
    }
  };
  '''

code "typed gate with an empty call", '''
  C = component
    user: User <~ @stash.user()
  ''', '''
  let C = class extends __Component {
    static __gates = ['user'];
    _init(props) {
      this.user = __gateBind(this, 0);
    }
  };
  '''

code "typed keyed gate", '''
  C = component
    order: Order <~ @stash.order(@params.id)
  ''', '''
  let C = class extends __Component {
    static __gates = [{ path: 'order', key: (params, query) => params.id }];
    _init(props) {
      this.order = __gateBind(this, 0);
    }
  };
  '''


