  };
  '''

code "unary plus", '+x', '+x;'
code "shift operators", 'a << 1', 'a << 1;'

# ==============================================================================
# Control
# ==============================================================================

code "while with a guard", '''
  i = 0
  while i < 3 when i isnt 1
    i += 1
  ''', '''
  let i = 0;
  while (i < 3) {
    if (i !== 1) {
      i += 1;
    }
  }
  '''

code "until with a guard", '''
  i = 0
  until i is 3 when i isnt 1
    i += 1
  ''', '''
  let i = 0;
  while (!(i === 3)) {
    if (i !== 1) {
      i += 1;
    }
  }
  '''

code "postfix while on a statement", '''
  f = -> return 1 while c
  ''', '''
  let f = function() {
    while (c) {
      return 1;
    }
  };
  '''

code "postfix until on a statement", '''
  f = -> return 1 until c
  ''', '''
  let f = function() {
    while (!c) {
      return 1;
    }
  };
  '''

code "postfix while with a guard", '''
  x() while c when g
  ''', '''
  while (c) {
    if (g) {
      x();
    }
  }
  '''

code "postfix while with a guard on a statement", '''
  f = -> return 1 while c when g
  ''', '''
  let f = function() {
    while (c) {
      if (g) {
        return 1;
      }
    }
  };
  '''

code "postfix until with a guard", '''
  x() until c when g
  ''', '''
  while (!c) {
    if (g) {
      x();
    }
  }
  '''

code "postfix until with a guard on a statement", '''
  f = -> return 1 until c when g
  ''', '''
  let f = function() {
    while (!c) {
      if (g) {
        return 1;
      }
    }
  };
  '''

code "else if without a final else", '''
  if a
    1
  else if b
    2
  ''', '''
  if (a) {
    1;
  } else if (b) {
    2;
  }
  '''

code "postfix if with an indented else", '''
  x = 1 if c else
    2
  ''', '''
  let x;

  x = (c ? 1 : 2);
  '''

code "inline try on a statement", '''
  f = -> try return 1
  ''', '''
  let f = function() {
    return (() => { try {
      return 1;
    } catch {} })();
  };
  '''

code "inline try statement with catch and finally", '''
  f = ->
    try return 1
    catch
      return 2
    finally
      cleanup()
  ''', '''
  let f = function() {
    return (() => { try {
      return 1;
    } catch {
      return 2;
    } finally {
      cleanup();
    } })();
  };
  '''

code "catch with an array pattern", '''
  try
    f()
  catch [a, b]
    a
  ''', '''
  let a, b;

  try {
    f();
  } catch (_err) {
    ([a, b] = _err);
    a;
  }
  '''

code "throw an indented object", '''
  throw
    code: 1
  ''', '''
  throw {code: 1};
  '''

code "for-in with guard then step", '''
  for x in a when x by 2
    x
  ''', '''
  for (let _ref = a, _i = 0; _i < _ref.length; _i += 2) {
  let x = _ref[_i];
  if (x) {
      x;
    }
  }
  '''

code "for-in with step then guard", '''
  for x in a by 2 when x
    x
  ''', '''
  for (let _ref = a, _i = 0; _i < _ref.length; _i += 2) {
