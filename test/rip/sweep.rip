code "for await with a guard", '''
  f = ->
    for await x as it when x
      x
  ''', '''
  let f = async function(it) {
    const _result = [];
    for await (let x of it) {
      if (x) {
        _result.push(x);
      }
    }
    return _result;
  };
  '''

