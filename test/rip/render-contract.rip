# ==============================================================================
# Template contract — the forms real code writes
# ==============================================================================
#
# Each row is modeled on lines in medlabs/app, packages/ui, tui, sites or
# email, and pins its emission byte for byte. The template cleanup
# (docs/TEMPLATES-PLAN.md) keeps every one of these unchanged unless a
# phase names the change.

import { code } from '../support/testing.js'

code 'class: a plain string', '''
  A = component
    render
      h1 class: 'text-xl font-bold', 'Orders'
  ''', '''
  let A = class extends __Component {
    _init(__given) {
    }
    _create() {
      this._el0 = document.createElement('h1');
      this._el0.setAttribute('data-part', 'A');
      this._el0.className = "text-xl font-bold";
      this._t0 = document.createTextNode("Orders");
      this._el0.appendChild(this._t0);
      return this._el0;
    }
  };
  '''

