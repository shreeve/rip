# Test: The __DATA__ marker — everything after a line that is exactly
# __DATA__ is the program's DATA constant: raw text, never parsed,
# bound below any leading imports.

import { test, code, fail, type } from '../support/testing.js'

test 'data marker length', '''
  DATA.length
  __DATA__
  test
''', 5

test 'data marker empty', '''
  DATA
  __DATA__
''', ''

test 'data marker multiline', '''
  lines = DATA.split("\\n").filter (l) -> l
  lines.length
  __DATA__
  line1
  line2
  line3
''', 3

test 'data marker first line', '''
  DATA.split("\\n")[0]
  __DATA__
  first
  second
''', 'first'

test 'data marker last line', '''
  lines = DATA.trim().split("\\n")
  lines[lines.length - 1]
  __DATA__
  first
  second
  last
''', 'last'

test 'data marker config', '''
  config = {}
  for line in DATA.split("\\n") when line.trim()
    [key, val] = line.split("=")
    config[key] = val
  config.port
  __DATA__
  host=localhost
  port=8080
  debug=true
''', '8080'

test 'data marker csv', '''
  rows = DATA.trim().split("\\n").map (line) ->
    line.split(",")
  rows[0][0]
  __DATA__
  Alice,alice@example.com
  Bob,bob@example.com
''', 'Alice'

test 'data marker special chars', '''
  DATA.includes("@")
  __DATA__
  test@example.com
''', true

test 'data marker quotes', '''
  DATA.includes("'")
  __DATA__
  It's working!
''', true

test 'data marker whitespace', '''
  DATA[0]
  __DATA__
    indented
''', ' '

test 'data marker users', '''
  users = DATA.trim().split("\\n").map (line) ->
    [name, email] = line.split(",")
    {name, email}
  users[1].name
  __DATA__
  Alice,alice@example.com
  Bob,bob@example.com
  Charlie,charlie@example.com
''', 'Bob'

test 'data marker json', '''
  obj = JSON.parse(DATA)
  obj.name
  __DATA__
  {"name": "Alice", "age": 30}
''', 'Alice'

test 'data marker env parsing', '''
  env = {}
  for line in DATA.split("\\n") when line and not line.startsWith("#")
    parts = line.split("=")
    if parts.length is 2
      [key, val] = parts
      env[key.trim()] = val.trim()
  env.PORT
  __DATA__
  # Config
  HOST=localhost
  PORT=3000
''', '3000'

test 'data marker payload keeps its newline', '''
  x = DATA
  x.length
  __DATA__
  hello world
''', 12

test 'data marker simple', '''
  x = DATA
  x
  __DATA__
  hello world
  ''', 'hello world\n'

test 'data marker template', '''
  name = 'Alice'
  "Hello, \#{name}!"
  __DATA__
  unused payload
  ''', 'Hello, Alice!'

test 'data marker only', '''
  DATA
  __DATA__
  just data
  ''', 'just data\n'

code 'data marker compiler', '''
  x = 42
  console.log DATA
  __DATA__
  test data
  ''', '''
  let DATA = __data();
  let x = 42;
  console.log(DATA);
  function __data() {
    return "test data\\n";
  }
  '''

code 'data marker hoisting', '''
  console.log DATA
  __DATA__
  hoisted!
  ''', '''
  let DATA = __data();
  console.log(DATA);
  function __data() {
    return "hoisted!\\n";
  }
  '''

# The section's text closes the output, after every statement; DATA
# opens it below the leading imports.
code 'data marker text closes the output', '''
  import { a } from './a.js'
  b = a DATA
  __DATA__
  x
  ''', '''
  import { a } from './a.js';
  let DATA = __data();
  let b = a(DATA);
  function __data() {
    return "x\\n";
  }
  '''

# The section's function name is minted: a user `__data` keeps its own.
code 'data marker function name dodges the program', '''
  __data = 1
  DATA + __data
  __DATA__
  z
  ''', '''
  let DATA = __data_();
  let __data;
  __data = 1;
  DATA + __data;
  function __data_() {
    return "z\\n";
  }
  '''

# The marker declares DATA; a plain assignment writes it, at module
# scope or from a function, and never declares it a second time.
test 'data marker DATA is writable', '''
  DATA = DATA.toUpperCase()
  shout = -> DATA += "!"
  shout()
  DATA
  __DATA__
  hello
  ''', 'HELLO\n!'

test 'data marker a nested scope shadows DATA', '''
  f = ->
    DATA := 2
    DATA
  [f(), DATA]
  __DATA__
  q
  ''', [2, 'q\n']

fail 'data marker then def DATA', '''
  def DATA
    1
  __DATA__
  q
  ''', "'DATA' was already declared as the __DATA__ section on line 3"

fail 'data marker then state DATA', '''
  DATA := 1
  __DATA__
  q
  ''', "'DATA' was already declared as the __DATA__ section on line 2"

fail 'data marker then import DATA', '''
  import DATA from './probe.js'
  __DATA__
  q
  ''', "'DATA' was already declared as the __DATA__ section on line 2"

fail 'data marker then export DATA', '''
  export DATA = 1
  __DATA__
  q
  ''', "'DATA' was already declared as the __DATA__ section on line 2"
