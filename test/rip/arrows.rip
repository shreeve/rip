# Test: Arrow Function Parameter Syntax
# Tests that single parameters don't have unnecessary parens

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# Single Parameter (NO parens)
# ==============================================================================

code "arrow single param", "f = (x) => x * 2", "let f = x => (x * 2);"

code "arrow single param block", '''
  f = (x) =>
    x * 2
  ''', "let f = x => (x * 2);"

test "arrow single param execution", "f = (x) => x * 2\nf(5)", 10

# ==============================================================================
# Multiple Parameters (KEEP parens)
# ==============================================================================

code "arrow no params", "f = => 42", "let f = () => 42;"
code "arrow two params", "f = (x, y) => x + y", "let f = (x, y) => (x + y);"

# ==============================================================================
# Special Cases (KEEP parens)
# ==============================================================================

code "arrow destructuring", "f = ({x, y}) => x + y", "let f = ({x, y}) => (x + y);"
code "arrow default param", "f = (x = 5) => x", "let f = (x = 5) => x;"
code "arrow rest param", "f = (...args) => args", "let f = (...args) => args;"

# Destructured parameter + default value (e.g. bag-of-options API pattern).
# Currently emits a malformed parameter list like `(object,,a,a,,b,b = {})`
# in every function form; these tests pin the correct shape so the fix can
# land cleanly. See https://… (compiler issue).
code "arrow destructuring with default", "f = ({a, b} = {}) => a + b", "let f = ({a, b} = {}) => (a + b);"

code "thin arrow destructuring with default", "f = ({a, b} = {}) -> a + b", '''
  let f = function({a, b} = {}) {
    return (a + b);
  };
  '''

code "second-position destructuring with default", "f = (x, {a, b} = {}) -> x + a + b", '''
  let f = function(x, {a, b} = {}) {
    return ((x + a) + b);
  };
  '''

test "destructuring with default — runtime",
  "f = ({a, b} = {}) -> a + b\nf({a: 1, b: 2})", 3

test "destructuring with default — omitted",
  "f = ({a, b} = {a: 10, b: 20}) -> a + b\nf()", 30

# ==============================================================================
# Implicit Objects in Single-Line Arrow Bodies
# ==============================================================================

# Throw with implicit object — comma should not end the arrow body

code "arrow throw implicit object", "f = -> throw status: 400, error: \"oops\"", '''
  let f = function() {
    throw {status: 400, error: "oops"};
  };
  '''

test "arrow throw implicit object runtime", """
  f = ->
    try
      g = -> throw status: 400, error: "oops"
      g()
    catch e
      e
  result = f()
  [result.status, result.error]
  """, [400, "oops"]

# Return with implicit object

code "arrow return implicit object", "f = -> return status: 200, data: \"ok\"", '''
  let f = function() {
    return {status: 200, data: "ok"};
  };
  '''

test "arrow return implicit object runtime", """
  f = -> return status: 200, data: "ok"
  result = f()
  [result.status, result.data]
  """, [200, "ok"]

# Implicit object as arrow body (implicit return)

code "arrow implicit object body", "f = -> status: 200, data: \"ok\"", '''
  let f = function() {
    return {status: 200, data: "ok"};
  };
  '''

test "arrow implicit object body runtime", """
  f = -> status: 200, data: "ok"
  result = f()
  [result.status, result.data]
  """, [200, "ok"]

# Arrow with params and throw implicit object

code "arrow params throw implicit object", "error = (note = \"oops!\", code = 400) -> throw status: code, error: note", '''
  let error = function(note = "oops!", code = 400) {
    throw {status: code, error: note};
  };
  '''

# Fat arrow with implicit object
code "fat arrow implicit object", "f = => status: 200, data: \"ok\"", "let f = () => ({status: 200, data: \"ok\"});"

# Comma that SHOULD end arrow body (not an implicit object)

code "arrow comma ends body not object", """
  fn 1, -> 42, 99
  """, """
  fn(1, function() {
    return 42;
  }, 99);
"""

# A comma after a bracketed argument belongs to the call inside the body,
# whether the brackets close on the line or after an indented element.
test "arrow body call keeps the comma after an indented array", """
  seen = []
  f = (...args) -> seen.push args.length
  h = (...fns) -> fns.length
  n = h -> f [
    1
  ], 2
  [n, seen]
  """, [1, []]

test "arrow body call keeps the comma after an indented array, called", """
  f = (...args) -> args.length
  h = (fn) -> fn()
  h -> f [
    1
  ], 2
  """, 2

test "a call in an arrow body's control head owns no comma after the block", """
  f = (v) -> v
  h = (...a) -> a.length
  h -> if f 1
    1
  , 3
  """, 2

test "a pair value's control head call owns no comma after the block", """
  f = (v) -> v
  y = 7
  h = (...a) -> a.length
  h -> k: if f 1
    1
  , y
  """, 2

test "arrow body call keeps the comma after an indented object", """
  f = (...args) -> args.length
  h = (fn) -> fn()
  h -> f {
    a: 1
  }, 2
  """, 2

# ==============================================================================
# Which comma ends a single-line arrow body
# ==============================================================================
#
# A depth-0 comma inside a one-line body stays in the body only when an
# implicit call or a property list opened within the body owns it;
# otherwise the body ends and the comma separates the next argument.

test 'an interpolated key after the comma keeps the object in the body', '''
  h = (f) -> f()
  k = 'b'
  h -> a: 1, "#{k}": 2
''', {a: 1, b: 2}

test 'a pair value with call parens keeps the object in the body', '''
  h = (f, o) -> [f(), o?]
  g = (v) -> v * 10
  h -> a: g(1), b: 2
''', [{a: 10, b: 2}, false]

test 'a pair inside call parens does not claim the comma', '''
  h = (f, o) -> [f(), o]
  g = (v) -> v
  h -> g(a: 1), b: 2
''', [{a: 1}, {b: 2}]

test 'a multi-line bracket value keeps the object in the body', '''
  h = (f, o) -> [f(), o?]
  h -> a: [
    1
    2
  ], b: 2
''', [{a: [1, 2], b: 2}, false]

test 'a pair before a semicolon does not claim a later comma', '''
  h = (f, o) -> [f(), o]
  b = 5
  h -> a: 1; b, c: 2
''', [5, {c: 2}]

test 'a call inside brackets does not claim the comma after them', '''
  h = (f, o) -> [f(), o]
  g = (v) -> v + 1
  h -> [g 1], 3
''', [[2], 3]

# ==============================================================================
# Where a single-line arrow body ends
# ==============================================================================

test 'an inline if inside a one-line body claims its own else', '''
  h = (f) -> f()
  c = false
  d = false
  y = if c then h -> 1 if d else 2 else 3
  y
''', 3

test 'a line-starting optional chain applies to the one-line function', 'g = -> 1\n?.length\ntypeof g', 'number'

test 'a program may begin with a one-line arrow', '-> 5\n.call()', 5

# A ternary's parenthesized branch followed by ':' is never an arrow's
# param list: a later arrow without parentheses keeps its own (empty) params.
test "a ternary paren branch then an arrow on the next line", "c = true\na = 1\nb = 2\nx = c ? (a) : b\n[1].map -> x", [1]
test "a ternary paren branch in an if head then an arrow in its body", "c = true\na = 1\nb = 2\nr = if c ? (a) : b\n  [1].map -> 5\nr", [5]
test "a ternary paren branch then an assignment of an arrow call", "c = false\na = 1\nr = c ? (a) : y = [1].map -> 7\n[r, y]", [[7], [7]]
test "a ternary paren branch then a nested ternary with an arrow", "c = false\na = 1\nd = true\ne = 2\nr = c ? (a) : d ? e : [1].map -> 7\nr", 2
test "a ternary paren branch then do", "c = false\na = 1\nr = c ? (a) : do -> 7\nr", 7
test "a ternary paren branch then comparisons and a shift before an arrow", "c = false\na = 1\nb = 1\nd = 2\ne = 3\nf = 4\ng = (h) -> h()\nr = c ? (a) : b < d < e < f << g -> 1\nr", true
