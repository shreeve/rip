# __lis — the longest-increasing-subsequence core of keyed reconcile
# (a component in the file delivers the render runtime).

test 'lis: empty array', '''
  X = component
    render
      div
  __lis([])
  ''', []

test 'lis: single element', '''
  X = component
    render
      div
  __lis([0])
  ''', [0]

test 'lis: already sorted', '''
  X = component
    render
      div
  __lis([0, 1, 2, 3])
  ''', [0,1,2,3]

test 'lis: reversed', '''
  X = component
    render
      div
  __lis([3, 2, 1, 0]).length
  ''', 1

test 'lis: with new items (-1)', '''
  X = component
    render
      div
  __lis([0, -1, 1, -1, 2])
  ''', [0,2,4]

test 'lis: swap first and last', '''
  X = component
    render
      div
  result = __lis([3, 1, 2, 0])
  result.length
  ''', 2

test 'lis: interleaved', '''
  X = component
    render
      div
  __lis([1, 0, 3, 2])
  ''', [1,3]

# ==============================================================================
# Component runtime internals — frames, init failure, context chain
# ==============================================================================

test 'component owns its own effect disposers (the owner frame)', '''
  A = component
    x := 0
    log =! []
    ~> @log.push(x + 0)
  a = A.new()
  a._frame.size > 0
  ''', true

test 'init failure with handled onError sets _initFailed flag', '''
  caught = null
  Bad = component
    onError = (err) -> caught = err.message
    x := raise "boom"
  bad = Bad.new()
  caught is "boom" and bad._initFailed is true
  ''', true

test 'init failure without onError throws from constructor', '''
  Bad = component
    x := raise "boom"
  caught = null
  try
    bad = Bad.new()
  catch e
    caught = e.message
  caught
  ''', 'boom'

test 'context walk terminates on a cycled parent chain', '''
  A = component
    val =! "x"
  Absent = component
    val =! "y"
  a = A.new()
  a._parent = a
  __pushComponent(a)
  result = hasContext(Absent, "missing")
  __popComponent(null)
  result
  ''', false

test '__pushComponent preserves _parent across re-pushes', '''
  A = component
    val =! "outer"
  B = component
    val =! "inner"
  outer = A.new()
  inner = B.new()
  __pushComponent(outer)
  __pushComponent(inner)
  __popComponent(outer)
  __popComponent(null)
  __pushComponent(inner)
  __popComponent(null)
  inner._parent is outer
  ''', true

test 'context propagates from outer to inner across re-push', '''
  Outer = component
    init = -> setContext("greeting", "hi")
  Inner = component
    val := getContext(Outer, "greeting")
  o = Outer.new()
  __pushComponent(o)
  o.init()
  i = Inner.new()
  __popComponent(null)
  __pushComponent(i)
  again = getContext(Outer, "greeting")
  __popComponent(null)
  [i.val.value, again]
  ''', ['hi', 'hi']

# A context miss is LOUD — getContext with no such provider above rejects
# and names the probe; hasContext is the legal-absence spelling. A read
# that names no provider at all is refused, pointing at the spelling.

test 'getContext with no such provider above rejects; hasContext probes', '''
  A = component
    render
      div
  Absent = component
    render
      div
  a = A.new()
  __pushComponent(a)
  probe = hasContext(Absent, "missing")
  msg = try
    getContext(Absent, "missing")
    "no-throw"
  catch e
    e.message
  __popComponent(null)
  [probe, msg]
  ''', [false, 'getContext: no Absent above this component — render one around it, or probe with hasContext(Absent, "missing") where absence is legal']

test 'a context read that names no provider is refused, pointing at the spelling', '''
  A = component
    render
      div
  a = A.new()
  __pushComponent(a)
  msgs = []
  for read in [(-> getContext("theme")), (-> hasContext("theme"))]
    try
      read()
      msgs.push "no-throw"
    catch e
      msgs.push e.message
  __popComponent(null)
  msgs
  ''', ['getContext: a context read names its provider — getContext(Provider, "theme")', 'hasContext: a context read names its provider — hasContext(Provider, "theme")']

test 'mount failure dispatch restores the parent component and owner frames', '''
  source := 0
  log = []
  rescue = null
  Rescue = component
    render null
  Broken = component
    beforeMount = -> raise "setup boom"
    render null
  Boundary = component
    onError = (err) ->
      rescue = Rescue.new()
      __effect -> log.push source + 0
  parent = Boundary.new()
  prev = __pushComponent(parent)
  owner = __pushOwner(parent._frame)
  broken = Broken.new()
  broken._mountCreate()
  broken._mountSetup()
  __popOwner(owner)
  __popComponent(prev)
  source = 1
  before = [broken._state, broken._frame.disposed, rescue._parent is parent, log.slice()]
  parent.unmount()
  source = 2
  [before, log]
  ''', [['failed', true, true, [0, 1]], [0, 1]]

test 'unmount before mount disposes init effects without mounted-only hooks', '''
  source := 0
  log = []
  A = component
    ~> log.push source + 0
    beforeUnmount = -> log.push "before"
    unmounted = -> log.push "after"
  a = A.new()
  a.unmount()
  source = 1
  [a._state, a._frame.disposed, log]
  ''', ['unmounted', true, [0]]

# Bare-identifier shorthand sets a boolean attribute. The arm is TOTAL
# — the readings above it having declined, the word is the attribute it
# names, in or out of the standard vocabulary. Whether the vocabulary
# holds it is the typed surface's question; emission asks no name
# question here, because it asks none anywhere on the untyped road.
# The word on its own line under the element is the same arm: a tag
# word there is a child element, any other unbound word an attribute
# of the enclosing element — never an element built out of it.

code 'bare-ident shorthand — known name is a boolean attribute', '''
  export A = component
    render
      div hidden
  ''', '''
  export const A = class extends __Component {
    _init(__given) {
    }
    _create() {
      this._el0 = document.createElement('div');
      this._el0.setAttribute('data-part', 'A');
      this._el0.setAttribute('hidden', '');
      return this._el0;
    }
  };
  '''

code 'bare-ident shorthand — an unknown name is still the attribute it names', '''
  export A = component
    render
      div outline
  ''', '''
  export const A = class extends __Component {
    _init(__given) {
    }
    _create() {
      this._el0 = document.createElement('div');
      this._el0.setAttribute('data-part', 'A');
      this._el0.setAttribute('outline', '');
      return this._el0;
    }
  };
  '''

code 'bare-ident shorthand — a word on its own line is an attribute of the enclosing element, a tag word a child', '''
  export A = component
    render
      button
        readOnly
        hr
        'Save'
  ''', '''
  export const A = class extends __Component {
    _init(__given) {
    }
    _create() {
      this._el0 = document.createElement('button');
      this._el0.setAttribute('data-part', 'A');
      this._el0.setAttribute('readOnly', '');
      this._el1 = document.createElement('hr');
      this._el0.appendChild(this._el1);
      this._t0 = document.createTextNode("Save");
      this._el0.appendChild(this._t0);
      return this._el0;
    }
  };
  '''

# Transition presets ride the branch-root claim — a '~name' directive
# is legal only on the FIRST top-level element of an if/else branch
# (where enter/leave actually run); each preset's name reaches _t.

code 'transition with ~slide preset', '''
  export A = component
    show := true
    render
      if show
        div ~slide
          span "hi"
  ''', '''
  export const A = class extends __Component {
    _init(__given) {
      this.show = __state(true);
    }
    _create() {
      this._anchor0 = document.createComment('if');
      return this._anchor0;
    }
    _setup() {
      {
        const anchor = this._anchor0;
        let currentBlock = null;
        let showing = null;
        __effect(() => {
          const show_ = !!(this.show.value);
          const want = show_ ? 'then' : null;
          if (want === showing) return;
          if (currentBlock) {
            const leaving = currentBlock;
            if (leaving._t) { leaving.f(); __transition(leaving._first, leaving._t, 'leave', () => leaving.d(true)); }
            else { leaving.d(true); }
            currentBlock = null;
          }
          showing = want;
          if (want === 'then') {
            currentBlock = this.create_block_0(this);
            currentBlock.c();
            if (anchor.parentNode) currentBlock.m(anchor.parentNode, anchor.nextSibling);
            currentBlock.p(this);
            if (currentBlock._t) __transition(currentBlock._first, currentBlock._t, 'enter', undefined);
          }
        });
        __ownerFrame().add(() => { if (currentBlock) { currentBlock.d(true); currentBlock = null; } });
      }
    }
    create_block_0(ctx) {
      let _el1, _el2, _t0;
      return {
        c() {
          _el1 = document.createElement('div');
          this._t = "slide";
          _el2 = document.createElement('span');
          _t0 = document.createTextNode("hi");
          _el2.appendChild(_t0);
          _el1.appendChild(_el2);
          this._first = _el1;
        },
        m(target, anchor) {
          if (target) target.insertBefore(_el1, anchor);
        },
        p(ctx) {
        },
        f() { },
        d(detaching) {
          if (detaching) __detach(_el1);
        }
      };
    }
  };
  '''

