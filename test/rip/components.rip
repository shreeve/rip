fail 'asChild is reserved on an extends component', '''
  Btn = component extends button
    @asChild?: boolean
    render
      button
        slot
''', "emitter: a component that extends a host cannot declare a prop named 'asChild'"

test 'asChild rides rest and is read as the mode; a component with no host has no flag', '''
  A = component extends button
    render
      button
        slot
  B = component
    render
      div
  [A.new({ asChild: true })._asChild, A.new({})._asChild, A.new({ asChild: true }).rest.value.asChild, B.new({})._asChild]
''', [true, false, true, undefined]

# ==============================================================================
# Member initializer hoist — parenthetical multi-statement
# ==============================================================================
# A parenthetical multi-statement member value emits as a comma
# expression in _init. Inner assignment targets must hoist to `_init`'s
# let line (`let a; this.x = (a = 1, a)`). Filtering those blocks out of
# hoist collection (the old multi-stmt blanket) left bare assigns and
# threw in strict mode. Multi-stmt `~=` bodies still hoist inside their
# own computed funcBlock — not here.

code '=! member paren multi-stmt hoists inner assigns in _init', '''
  C = component
    x =! (
      a = 1
      a
    )
    render
      div
  ''', '''
  let C = class extends __Component {
    _init(__given) {
      let a;
      this.x = (a = 1, a);
    }
    _create() {
      this._el0 = document.createElement('div');
      this._el0.setAttribute('data-part', 'C');
      return this._el0;
    }
  };
  '''

code '= member paren multi-stmt hoists inner assigns in _init', '''
  C = component
    x = (
      a = 1
      a
    )
    render
      div
  ''', '''
  let C = class extends __Component {
    _init(__given) {
      let a;
      this.x = (a = 1, a);
    }
    _create() {
      this._el0 = document.createElement('div');
      this._el0.setAttribute('data-part', 'C');
      return this._el0;
    }
  };
  '''

test '=! member paren multi-stmt initializes without ReferenceError', '''
  C = component
    x =! (
      a = 1
      a
    )
    render
      div
  c = C.new()
  c._init({})
  c.x
  ''', 1

code ':= member paren multi-stmt hoists inner assigns in _init', '''
  C = component
    x := (
      a = 1
      a
    )
    render
      div
  ''', '''
  let C = class extends __Component {
    _init(__given) {
      let a;
      this.x = __state((a = 1, a));
    }
    _create() {
      this._el0 = document.createElement('div');
      this._el0.setAttribute('data-part', 'C');
      return this._el0;
    }
  };
  '''

code '~= member paren multi-stmt hoists inside computed only', '''
  C = component
    x ~= (
      a = 1
      a
    )
    render
      div
  ''', '''
  let C = class extends __Component {
    _init(__given) {
      this.x = __computed(() => {
        let a = 1;
        return a;
      });
    }
    _create() {
      this._el0 = document.createElement('div');
      this._el0.setAttribute('data-part', 'C');
      return this._el0;
    }
  };
  '''

# ==============================================================================
# Member write guards
# ==============================================================================
# A readonly ('=!') member never changes after _init — every write
# spelling rejects at the site. A plain ('=') member that render READS
# while anything WRITES is the silent-freeze pair: render never re-runs
# for a non-reactive field, so the write rejects and names the fix.

fail 'reassigning a =! member is a compile error', '''
  export A = component
    c =! 5
    bump = -> @c = 6
    render
      div "hi"
  ''', "cannot assign to readonly member 'c'"

fail 'compound-assigning a =! member is a compile error', '''
  export A = component
    n =! 0
    inc = -> n += 1
    render
      div "hi"
  ''', "cannot assign to readonly member 'n'"

fail 'updating a =! member is a compile error', '''
  export A = component
    n =! 0
    pp = -> n++
    render
      div "hi"
  ''', "cannot assign to readonly member 'n'"

fail 'plain `=` member read in render + reassigned is a silent-freeze error', '''
  export A = component
    open = false
    toggle = -> open = not open
    render
      button "#{open}"
  ''', "silently freezes the render"

test 'a method param named like a =! member shadows it (standard scoping)', '''
  A = component
    c =! 5
    use = (c) -> c = c + 1
    render
      div "hi"
  a = A.new()
  a._init({})
  [a.use(10), a.c]
  ''', [11, 5]

fail 'ref to a readonly (=!) is rejected', '''
  export A = component
    el =! null
    render
      div ref: el
  ''', "not a writable state cell"

fail 'ref to a plain (=) member is rejected', '''
  export A = component
    el = null
    render
      div ref: el
  ''', "not a writable state cell"

# ==============================================================================
# Child components — emission pins
# ==============================================================================
# A child component must be a module binding, an import, or a component
# member; the rows define their children in-file. Bare words in a child's
# arg list are boolean-prop shorthand — an HTML tag name included: the
# props type judges whether the component takes it, and names it in the
# error when it does not. The one rejection left is a tag word that ALSO
# names a module value, where the value wins silently and no type sees it.

fail 'a bare tag word that also names a module value is ambiguous', '''
  link = "TEXT"
  Btn = component
    render
      button
  export A = component
    render
      Btn
        link
  ''', "ambiguous"

