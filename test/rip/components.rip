      flag = not flag
      count = count + 1
    render null
  ''', '''
  export const A = class extends __Component {
    _init(__given) {
      this.flag = false;
      this.count = __state(0);
    }
    toggle() {
      this.flag = !this.flag;
      return (this.count.value = this.count.value + 1);
    }
    _create() {
      return null;
    }
  };
  '''

fail 'component effect cannot yield', '''
  A = component
    ~> yield 1
  ''', 'cannot yield'

fail 'component effect cannot take a generator callback', '''
  A = component
    ~> -> yield 1
  ''', 'cannot yield'

test 'single-expression component effect plans optional assignment captures', '''
  target = {x: 0}
  gets = 0
  values = 0
  get = -> (gets += 1; target)
  value = -> (values += 1; 7)
  A = component
    ~> get()?.x = value()
  A.new()
  [target.x, gets, values]
  ''', [7, 1, 1]

test 'single-expression component effect plans floor-divide captures', '''
  target = {x: 9}
  gets = 0
  values = 0
  get = -> (gets += 1; target)
  value = -> (values += 1; 2)
  A = component
    ~> get().x //= value()
  A.new()
  [target.x, gets, values]
  ''', [4, 1, 1]

test 'single-expression component effect plans computed modulo key captures', '''
  target = [9]
  keys = 0
  values = 0
  key = -> (keys += 1; 0)
  value = -> (values += 1; 4)
  A = component
    ~> target[key()] %%= value()
  A.new()
  [target[0], keys, values]
  ''', [1, 1, 1]

test 'block component effect has matching reference evaluation counts', '''
  target = {x: 9}
  gets = 0
  values = 0
  get = -> (gets += 1; target)
  value = -> (values += 1; 2)
  A = component
    ~>
      marker = true
      get().x //= value()
  A.new()
  [target.x, gets, values]
  ''', [4, 1, 1]

# `_init` runs synchronously during construction, so no member initializer
# awaits or yields, whatever kind of member it declares. A function VALUE
# a member holds — a method, a hook, a callback in a list — owns its own.
fail 'a component state initializer cannot await', '''
  A = component
    n := fn!
    render
      div n
  ''', 'a component state initializer cannot await or yield'

fail 'a component readonly initializer cannot await', '''
  A = component
    n =! fn!
    render
      div n
  ''', 'a component readonly initializer cannot await or yield'

fail 'a public component readonly initializer cannot await', '''
  A = component
    @n =! fn?!
    render
      div n
  ''', 'a component readonly initializer cannot await or yield'

fail 'a plain component member initializer cannot await', '''
  A = component
    n = fn!
    render
      div n
  ''', 'a component member initializer cannot await or yield'

fail 'a component prop default cannot await', '''
  A = component
    @n: any = fn!
    render
      div n
  ''', 'a component member initializer cannot await or yield'

fail 'a component computed body cannot await', '''
  A = component
    n ~= fn!
    render
      div n
  ''', "a computed ('~=') body cannot await"

test 'component members that hold functions own their awaits', '''
  A = component
    go =! -> fn!
    cbs = [-> fn!]
    load = -> fn!
    mounted = -> fn!
    render
      div "x"
  typeof A
  ''', 'function'

code 'a component member holding an awaiting effect keeps it', '''
  export A = component
    e = ~> fn!
    render
      div "x"
  ''', '''
  export const A = class extends __Component {
    _init(__given) {
      this.e = __effect(async () => { await fn(); });
    }
    _create() {
      this._el0 = document.createElement('div');
      this._el0.setAttribute('data-part', 'A');
      this._t0 = document.createTextNode("x");
      this._el0.appendChild(this._t0);
      return this._el0;
    }
  };
  '''

test 'readonly, state and list members may hold awaiting effects', '''
  A = component
    e =! ~> fn!
    s := ~> fn!
    es = [~> fn!]
    render
      div "x"
  typeof A
  ''', 'function'

fail 'a member cannot await in a class heritage', '''
  A = component
    K = class extends (fn!)
    render
      div "x"
  ''', 'a component member initializer cannot await or yield'

fail 'a user call spelled effect does not hide its await', '''
  A = component
    n = effect(a, fn!)
    render
      div "x"
  ''', 'a component member initializer cannot await or yield'

# A render body evaluates synchronously: text, attributes, props, and event
# listeners all emit into non-async generated scopes, so a bare await/yield
# in any render expression rejects positioned. A FUNCTION handler value owns
# its own control context and passes through untouched.
fail 'render event handler expression cannot await', '''
  save = -> Promise.resolve(1)
  A = component
    render
      button {@click: save!()}
  ''', 'render body evaluates synchronously'

fail 'render attribute expression cannot await', '''
  f = -> Promise.resolve('x')
  A = component
    render
      div {title: await f()}
  ''', 'render body evaluates synchronously'

fail 'render text interpolation cannot await', '''
  f = -> Promise.resolve('x')
  A = component
    render
      div "#{await f()}"
  ''', 'render body evaluates synchronously'

fail 'render expression cannot yield', '''
  A = component
    render
      div "#{yield 1}"
  ''', 'render body evaluates synchronously'

fail 'keyed render expression cannot await', '''
  A = component
    items := [{id: 1}]
    render
      for item in items
        div key: await Promise.resolve(item.id)
  ''', 'render body evaluates synchronously'

fail 'keyed render expression cannot yield', '''
  A = component
    items := [{id: 1}]
    render
      for item in items
        div key: yield item.id
  ''', 'render body evaluates synchronously'

# The rule holds at every depth. An element's children arrive as a
# parameterless arrow in argument position, which is render structure and
# not a function value, so the check descends through it and through the
# blocks of `if`, `switch`, and `for`.
fail 'nested element attribute cannot await', '''
  A = component
    render
      div
        span title: fn!
  ''', 'render body evaluates synchronously'

fail 'nested text interpolation cannot await', '''
  A = component
    render
      div
        span "#{await f()}"
  ''', 'render body evaluates synchronously'

fail 'nested handler expression cannot await', '''
  A = component
    render
      div
        button @click: save!()
  ''', 'render body evaluates synchronously'

fail 'nested render expression cannot yield', '''
  A = component
    render
      div
        span "#{yield 1}"
  ''', 'render body evaluates synchronously'

fail 'a text child cannot await', '''
  A = component
    render
      div
        = load!
  ''', 'render body evaluates synchronously'

fail 'a text child cannot maybe dammit', '''
  A = component
    render
      div
        = load?!
  ''', 'render body evaluates synchronously'

fail 'an element inside a nested conditional cannot await', '''
  A = component
    render
      div
        if ok
          p title: fn!
  ''', 'render body evaluates synchronously'

fail 'an element inside an else-if branch cannot await', '''
  A = component
    render
      if a
        p "x"
      else if b
        div
          p title: fn!
  ''', 'render body evaluates synchronously'

fail 'an element inside a switch arm cannot await', '''
  A = component
    render
      switch k
        when 1
          div
            p title: fn!
  ''', 'render body evaluates synchronously'

fail 'an element inside a loop body cannot await', '''
  A = component
    xs := [1]
    render
      for x in xs
        li
          b title: fn!
  ''', 'render body evaluates synchronously'

fail 'a child component body cannot await', '''
  Card = component
    render
      div
        slot
  A = component
    render
      Card
        b title: fn!
  ''', 'render body evaluates synchronously'

# An element renders every argument but its attribute objects as a child,
# so an element nested INLINE on the line, and an arrow standing as a
# child with or without parameters, are child positions too.
fail 'an inline nested element with a children block cannot await', '''
  A = component
    render
      ul
        li a href: "/"
          b title: fn!
  ''', 'render body evaluates synchronously'

fail 'an inline nested arrow cannot await', '''
  A = component
    render
      ul
        li a -> b title: fn!
  ''', 'render body evaluates synchronously'

fail 'a bare arrow standing as a child cannot await', '''
  A = component
    render
      div
        -> p title: fn!
  ''', 'render body evaluates synchronously'

fail 'a fat arrow standing as a child cannot await', '''
  A = component
    render
      div
        => p title: fn!
  ''', 'render body evaluates synchronously'

# A component's children arrive as a bare block, as an element's do. A
# spelled parameter has no reading, and its default would never emit.
fail 'a component rejects a parameterized children arrow', '''
  Card = component
    render
      div
        slot
  A = component
    render
      Card (x) ->
        b "x"
  ''', 'a parameterized function is not a render child'

fail 'a component rejects a children arrow whose parameter default awaits', '''
  Card = component
    render
      div
        slot
  A = component
    render
      Card (x = fn!) -> b "x"
  ''', 'a parameterized function is not a render child'

# Shapes where the render dispatcher and a syntactic reading part ways:
# a postfix condition wraps its element in a bare list, a render local
# shadows a tag only inside its own factory, and a dynamic-class head is
# an element whatever shadows its tag. The check follows emission, so
# each rejects.
fail 'an element under a postfix condition cannot await in its children', '''
  A = component
    ok := true
    render
      ul
        li(-> b title: fn!) unless ok
  ''', 'render body evaluates synchronously'

fail 'a tag a parent local shadows is still an element inside a conditional', '''
  A = component
    ok := true
    render
      code = (g) -> g
      code "hi"
      if ok
        code ->
          p title: fn!
  ''', 'render body evaluates synchronously'

fail 'a tag a parent local shadows is still an element inside a loop', '''
  A = component
    xs := [1]
    render
      code = (g) -> g
      code "hi"
      for x in xs
        code ->
          p title: fn!
  ''', 'render body evaluates synchronously'

fail 'a dynamic-class head is an element whatever shadows its tag', '''
  A = component
    ok := true
    render
      code = (g) -> g
      code "x"
      code.("on", ok)
        p title: fn!
  ''', 'render body evaluates synchronously'

# An awaited for-as carries its await in a flag, not a node, so it is
# guarded where `for await` emits.
fail 'an awaited for-as cannot run in a render attribute', '''
  A = component
    xs := [1]
    render
      div title: (x for x as! xs)
  ''', 'render body evaluates synchronously'

fail 'an awaited for-as cannot run in a nested text child', '''
  A = component
    xs := [1]
    render
      div
        = (x for x as! xs).length
  ''', 'render body evaluates synchronously'

fail 'a render local cannot hold an awaited for-as', '''
  A = component
    xs := [1]
    render
      t = (x for x as! xs)
      div t
  ''', 'render body evaluates synchronously'

test 'an awaited for-as inside a handler function owns its await', '''
  A = component
    xs := [1]
    render
      button @click: -> (y for y as! xs)
  typeof A
  ''', 'function'

