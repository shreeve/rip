  inst = A.new()
  inst._init({})
  typeof inst._create
  ''', 'function'

test 'render-local binding is visible to subsequent statements at runtime', '''
  A = component
    items := [{a: 2, b: 3}, {a: 5, b: 7}]
    render
      for item in items
        sum = item.a + item.b
        span "#{sum}"
  inst = A.new()
  inst._init({})
  typeof inst._create
  ''', 'function'

test 'nested loops with auto outer + explicit inner `i` execute correctly', '''
  A = component
    items := [{opts: [10, 20]}, {opts: [30]}]
    render
      for item in items
        for v, i in item.opts
          span "#{v}@#{i}"
  inst = A.new()
  inst._init({})
  typeof inst._create
  ''', 'function'

