      } else {
        this._inst0 = null;
        this._el1 = document.createComment('rip:child-error: Ns.Root');
      }
      } catch (__childErr) {
        __reportChildFailure('Ns.Root', __childErr);
        this._inst0 = null;
        this._el1 = document.createComment('rip:child-error: Ns.Root');
