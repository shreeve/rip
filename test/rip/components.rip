# A component named through a member path (`Ns.Root`): a tag, an `extends`
# host, and an accept provider.
code 'a component tag through a member path constructs through the member', '''
  Root = component
    offer @open := false
    render
      slot
  Ns = { Root }
  Page = component
    flag := false
    render
      Ns.Root open <=> flag
        "hi"
  ''', '''
  let Root = class extends __Component {
    static __props = ['open'];
    _init(__given) {
      this.open = __state(__given.__bind_open__ ?? __given.open ?? false);
      setContext('open', this.open);
    }
    _create() {
      this._slot0 = this.children instanceof Node ? this.children : (this.children != null ? document.createTextNode(String(this.children)) : document.createComment(''));
      return this._slot0;
    }
  };
  let Ns = {Root};
  let Page = class extends __Component {
    _init(__given) {
      this.flag = __state(false);
    }
    _create() {
      { const __prev = __pushComponent(this); try {
      try {
      this._inst0 = new Ns.Root({ __bind_open__: this.flag });
      if (this._inst0 && this._inst0._initFailed) {
        this._inst0 = null;
        this._el1 = document.createComment('rip:child-init-failed: Ns.Root');
      } else {
      { const __kid = this._inst0._beginProjection(this); try {
      this._t0 = document.createTextNode("hi");
      } finally { this._inst0._endProjection(__kid); } }
      this._inst0._setChildren(this._t0);
      if (this._inst0._mountCreate()) {
        this._el1 = this._inst0._root;
        (this._children || (this._children = [])).push(this._inst0);
      } else {
        this._inst0 = null;
        this._el1 = document.createComment('rip:child-error: Ns.Root');
      }
      }
      } catch (__childErr) {
        __reportChildFailure('Ns.Root', __childErr);
        this._inst0 = null;
        this._el1 = document.createComment('rip:child-error: Ns.Root');
      }
      } finally { __popComponent(__prev); } }
      return this._el1;
    }
    _setup() {
      if (this._inst0 && this._inst0._state === 'mounting') {
        this._el1 = this._inst0._mountSetup(document.createComment('rip:child-error: Ns.Root'));
      }
    }
  };
'''

code '`extends` and `accept … from` name a component through a member path rooted at an import', '''
