      slot
  Ns = { Root }
  Wrap = component extends Ns.Root
    render
      Ns.Root
''', "emitter: 'component extends Ns.Root' roots at 'Ns', a binding of this module"

fail 'a provider named through a path roots at an import, never a binding of the module', '''
  Root = component
    offer @open := false
    render
      slot
  Ns = { Root }
  Part = component
    accept open from Ns.Root
''', "emitter: accept reads from 'Ns.Root', which roots at 'Ns', a binding of this module"

test 'a deeper member path constructs through every segment', '''
  Root = component
    render
      slot
  UI = { Menu: { Root } }
  Page = component
    render
      UI.Menu.Root
  Page.toString().includes('new UI.Menu.Root({})')
''', true

fail 'a member tag whose root is bound nowhere rejects, naming the path', '''
  Page = component
    render
      Nope.Root
''', "emitter: component 'Nope.Root' is not defined in this module"

fail 'accept reads through a member path only when its leaf names a component', '''
  Ns = { helper: 1 }
  Part = component
    accept open from Ns.helper
''', "emitter: accept reads from a component bound in this module — 'Ns.helper' is not one"

fail 'accept names its provider by a plain member path, never a call', '''
  Part = component
    accept open from pick()
'''
