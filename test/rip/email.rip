# Public email authoring surface.

import { test } from '../support/testing.js'

test 'Email renders html tag with lang and dir', '''
  { toEmail, Email } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
  result = toEmail(E).html
  result.includes('lang="en"') and result.includes('dir="ltr"') and result.includes('<html')
''', true

test 'Head renders meta tags', '''
  { toEmail, Email, Head } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Head
  result = toEmail(E).html
  result.includes('charset=UTF-8') and result.includes('x-apple-disable-message-reformatting')
''', true

test 'Body renders table wrapper', '''
  { toEmail, Email, Body } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Body
          p "content"
  result = toEmail(E).html
  result.includes('role="presentation"') and result.includes('<p>content</p>')
''', true

test 'Preview renders hidden div with padding', '''
  { toEmail, Preview } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Preview text: "Hello preview"
  result = toEmail(E).html
  result.includes('display:none') and result.includes('Hello preview')
''', true

test 'Container renders centered table', '''
  { toEmail, Container } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Container
        p "inside"
  result = toEmail(E).html
  result.includes('max-width:37.5em') and result.includes('role="presentation"') and result.includes('<p>inside</p>')
''', true

test 'Section moves padding onto its cell and keeps the rest on the table', '''
  { toEmail, Email, Body, Section } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Body
          Section style: "background:#eee;padding:20px 8px;border-radius:4px;padding-top:1px"
            p "x"
  result = toEmail(E).html
  result.includes('<table style="background:#eee;border-radius:4px" data-part="Section"') and result.includes('<td style="padding:20px 8px;padding-top:1px">')
''', true

test 'Container moves padding onto its cell under the max-width', '''
  { toEmail, Email, Body, Container } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Body
          Container style: "padding:32px;max-width:400px"
            p "x"
  result = toEmail(E).html
  result.includes('<table style="max-width:400px" data-part="Container"') and result.includes('<td style="padding:32px">')
''', true

test 'Section and Container without padding leave the cell bare', '''
  { toEmail, Email, Body, Section, Container } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Body
          Container
            Section style: "background:#eee"
              p "x"
  result = toEmail(E).html
  not result.includes('<td style=')
''', true

test 'toEmail answers the inbox preview line, raw, beside html and text', '''
  { toEmail, Email, Body, Preview, Text } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Body
          Preview text: "Hi & co <3"
          Text "body"
  out = toEmail(E)
  out.preview is "Hi & co <3" and out.html.includes('Hi &amp; co &lt;3') and not out.text.includes('Hi')
''', true

test 'toEmail answers a null preview when the message renders no Preview', '''
  { toEmail, Email, Body, Text } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Body
          Text "body"
  toEmail(E).preview is null
''', true

test 'Body carries its background on the body element and zeroes the box the cell owns', '''
  { toEmail, Email, Body } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Body style: "background:#fafafa;font-family:Inter;padding:40px 20px;margin-top:4px"
          p "x"
  result = toEmail(E).html
  result.includes('<body style="background:#fafafa;margin:0;padding:0" data-part="Body">') and result.includes('<td style="background:#fafafa;font-family:Inter;padding:40px 20px;margin-top:4px">')
''', true

test 'Body without a style still zeroes the body element margin', '''
  { toEmail, Email, Body } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Body
          p "x"
  toEmail(E).html.includes('<body style="margin:0" data-part="Body">')
''', true

test 'Heading renders h1 by default', '''
  { toEmail, Heading } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Heading
        "Title"
  toEmail(E).html.includes('<h1')
''', true

test 'Heading renders h1 with style', '''
  { toEmail, Heading } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Heading style: "color:red"
        "Subtitle"
  toEmail(E).html.includes('color:red')
''', true

test 'Heading renders h2 with as prop', '''
  { toEmail, Heading } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Heading as: "h2"
        "Subtitle"
  toEmail(E).html.includes('<h2')
''', true

test 'Text renders p with defaults', '''
  { toEmail, Text } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Text
        "paragraph"
  result = toEmail(E).html
  result.includes('<p') and result.includes('font-size:14px') and result.includes('paragraph')
''', true

test 'Link renders anchor with defaults', '''
  { toEmail, Link } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Link href: "https://example.com"
        "click"
  result = toEmail(E).html
  result.includes('href="https://example.com"') and result.includes('target="_blank"') and result.includes('click')
''', true

test 'Link fails closed on an unknown scheme', '''
  { toEmail, Link } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Link href: "javascript:alert(1)"
        "click"
  toEmail(E).html.includes('href="#"')
''', true

test 'the text twin keeps a link address beside its text', '''
  { toEmail, Email, Body, Text, Link } = import!("#{process.cwd()}/packages/email/email.rip")
  E = component
    render
      Email
        Body
          Text
            "Visit "
            Link href: "https://example.com", "Example"
  toEmail(E).text
''', 'Visit Example (https://example.com)'
