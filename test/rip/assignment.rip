# Test: Assignment (1 node type)
# Tests the "=" assignment operator

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# Simple Assignment
# ==============================================================================

test "assign integer", "x = 42; x", 42
test "assign string", 'x = "hello"; x', "hello"
test "assign boolean", "x = true; x", true
test "assign null", "x = null; x", null
test "assign expression", "x = 5 + 3; x", 8

# Code generation tests
code "simple assignment", "x = 42", "let x = 42;"
code "assignment with expression", "y = a + b", "let y = a + b;"

# ==============================================================================
# Multiple Assignments
# ==============================================================================

test "multiple assignments", "x = 1; y = 2; x + y", 3
test "chained values", "a = b = 5; a", 5

# ==============================================================================
# Assignment to Properties
# ==============================================================================

test "assign to property", "obj = {}; obj.x = 42; obj.x", 42
test "assign to index", "arr = []; arr[0] = 10; arr[0]", 10

# ==============================================================================
# Compound Assignment
# ==============================================================================

test "addition assignment", "a = 5; a += 3; a", 8
test "subtraction assignment", "a = 10; a -= 3; a", 7
test "multiplication assignment", "a = 5; a *= 3; a", 15
test "division assignment", "a = 15; a /= 3; a", 5
test "modulo assignment", "a = 17; a %= 5; a", 2
test "exponentiation assignment", "a = 2; a **= 3; a", 8
test "floor division assignment", "a = 17; a //= 5; a", 3
test "mathematical modulo assignment", "a = -7; a %%= 3; a", 2

# ==============================================================================
# Logical Assignment
# ==============================================================================

test "or assignment false", "a = false; a or= 5; a", 5
test "or assignment true", "a = 10; a or= 5; a", 10
test "and assignment true", "a = 10; a and= 5; a", 5
test "and assignment false", "a = 0; a and= 5; a", 0
# ==============================================================================
# Bitwise Compound Assignment
# ==============================================================================

test "bitwise and assignment", "a = 12; a &= 10; a", 8
test "bitwise or assignment", "a = 12; a |= 3; a", 15
test "bitwise xor assignment", "a = 12; a ^= 5; a", 9
test "left shift assignment", "a = 5; a <<= 2; a", 20
test "right shift assignment", "a = 20; a >>= 2; a", 5
test "unsigned right shift assignment", "a = -1; a >>>= 1; a", 2147483647

# ==============================================================================
# Destructuring Assignment
# ==============================================================================

test "array destructuring", "[a, b, c] = [1, 2, 3]; a + b + c", 6
test "object destructuring", "{x, y} = {x: 10, y: 20}; x + y", 30
test "nested destructuring", "[a, {b, c}] = [1, {b: 2, c: 3}]; a + b + c", 6
test "destructuring with defaults", "{a = 5, b = 10} = {a: 1}; a + b", 11
test "array destructuring skip", "[a, , c] = [1, 2, 3]; a + c", 4
test "destructuring swap", "a = 1; b = 2; [a, b] = [b, a]; a", 2

# ==============================================================================
# Rest in Destructuring
# ==============================================================================

test "array rest destructuring", "[first, ...rest] = [1, 2, 3, 4]; rest.length", 3
test "object rest destructuring", "{a, ...rest} = {a: 1, b: 2, c: 3}; rest.b + rest.c", 5

# ==============================================================================
# Complex Patterns
# ==============================================================================

test "destructuring rename", "{x: a, y: b} = {x: 1, y: 2}; a + b", 3
test "deep object destructuring", "obj = {a: {b: {c: 5}}}; {a: {b: {c: value}}} = obj; value", 5
test "mixed destructuring", "data = {items: [1, 2, 3], count: 3}; {items: [first], count} = data; first + count", 4

# String key destructuring

test "string key destructuring", '''
  {'foo-bar': value} = {'foo-bar': 42}
  value
  ''', 42

# Computed property destructuring

test "computed property destructuring", '''
  key = 'prop'
  {[key]: value} = {prop: 100}
  value
  ''', 100

# ==============================================================================
# Conditional Assignment with typeof
# ==============================================================================

test 'assignment with explicit if instead of postfix unless', '''
  token = null
  value = 42
  if typeof value isnt "number"
    token = value or "default"
  else
    token = value
  token
  ''', 42

# ==============================================================================
# Optional Chain Assignment
# ==============================================================================

# An optional receiver that is not repeat-safe — a member chain (getters are
# observable) or an unresolved name (globalThis may expose an accessor) —
# captures once inside the guard's own parens, so the null check and the
# write see the SAME object. A bound plain name keeps the plain guard.
code 'optional chain assign: x?.prop = val', 'gc?.scrollTop = 0', 'if ((_ref = gc) != null) _ref.scrollTop = 0'
code 'optional chain assign: bound receiver keeps the plain guard', 'gc = null\ngc?.scrollTop = 0', 'let gc = null;\nif (gc != null) gc.scrollTop = 0;'
code 'optional chain assign: deep', 'a?.b.c = 0', 'if ((_ref = a) != null) _ref.b.c = 0'
code 'optional chain assign: inner', 'a.b?.c = 0', 'if ((_ref = a.b) != null) _ref.c = 0'
code 'optional chain assign: bracket', 'x?[0] = 1', 'if ((_ref = x) != null) _ref[0] = 1'
code 'optional chain assign: compound', 'x?.prop += 5', 'if ((_ref = x) != null) _ref.prop += 5'

test 'optional chain assign: sets when present', '''
  obj = { x: 10 }
  obj?.x = 42
  obj.x
  ''', 42

test 'optional chain assign: skips when null', '''
  obj = null
  obj?.x = 42
  obj
  ''', null

test 'optional chain assign: skips when undefined', '''
  obj = undefined
  obj?.x = 42
  obj
  ''', undefined

test 'optional chain assign: deep sets when present', '''
  obj = { inner: { x: 0 } }
  obj?.inner.x = 99
  obj.inner.x
  ''', 99

test 'optional chain assign: deep skips when null', '''
  obj = null
  obj?.inner.x = 99
  obj
  ''', null

test 'optional chain assign: compound operator', '''
  obj = { count: 10 }
  obj?.count += 5
  obj.count
  ''', 15

test 'optional chain assign: compound skips when null', '''
  obj = null
  obj?.count += 5
  obj
  ''', null

test 'optional chain assign: bracket access', '''
  arr = [10, 20, 30]
  arr?[1] = 99
  arr[1]
  ''', 99

test 'optional chain assign: bracket skips when null', '''
  arr = null
  arr?[0] = 99
  arr
  ''', null

test 'optional chain assign: inner chain', '''
  obj = { a: { b: 0 } }
  obj.a?.b = 42
  obj.a.b
  ''', 42

test 'optional chain assign: inner chain skips', '''
  obj = { a: null }
  obj.a?.b = 42
  obj.a
  ''', null

code 'optional chain assign: style pattern', 'el?.style.display = "none"', 'if ((_ref = el) != null) _ref.style.display = "none"'
code 'optional chain assign: value pattern', '@_input?.value = ""', 'if ((_ref = this._input) != null) _ref.value = ""'
code 'optional chain assign: subtract', 'x?.y -= 1', 'if ((_ref = x) != null) _ref.y -= 1'

# ==============================================================================
# Destructuring binding-pattern validation
# ==============================================================================
# The grammar accepts the full Array / Object expression on the LHS of `=`,
# so shapes like `[a + b] = src` and `{x: y for x in arr} = src` parse.
# A call element rejects in the pattern walk at every pattern position,
# whatever its callee spells: `cast`, `satisfies`, `array`, `object` and
# `rest` name ordinary functions there, never the pattern shapes their
# nodes share a head with.

fail 'destructure: arithmetic expression as target', '[a + b] = src'

fail 'destructure: comprehension as target',
  '{x: y for x in [1]} = src'

fail 'destructure: function call as target', '[fn()] = src', 'a call cannot be a destructuring target'
fail 'destructure: call as keyed object target', '{k: f(a)} = src', 'a call cannot be a destructuring target'
fail 'destructure: call as rest target', '[...f(a)] = src', 'a call cannot be a destructuring target'
fail 'destructure: call as object rest target', '{...f(a)} = src', 'a call cannot be a destructuring target'
fail 'destructure: call in nested pattern', '[[f(a)]] = src', 'a call cannot be a destructuring target'
fail 'destructure: implicit call as target', '[f a] = src', 'a call cannot be a destructuring target'
fail 'destructure: method call as target', '[a.f(b)] = src', 'a call cannot be a destructuring target'
fail 'destructure: optional call as target', '[f? a] = src', 'a call cannot be a destructuring target'
fail 'destructure: dammit call as target', '[f!] = src', 'a call cannot be a destructuring target'
fail 'destructure: tagged template as target', '[f"x"] = src', 'a call cannot be a destructuring target'
fail 'destructure: call as parameter pattern', 'g = ([f(a)]) -> 1', 'a call cannot be a destructuring target'
fail 'destructure: call as keyed parameter pattern', 'g = ({k: f(a)}) -> 1', 'a call cannot be a destructuring target'
fail 'destructure: call as def parameter pattern', "def g([f(a)])\n  1", 'a call cannot be a destructuring target'
fail 'destructure: call as loop variable', 'for [f(a)] in xs then 1', 'a call cannot be a destructuring target'
fail 'destructure: call as own-loop value', 'for own k, [f(a)] of o then 1', 'a call cannot be a destructuring target'
fail 'destructure: call as comprehension variable', 'y = (1 for [f(a)] in xs)', 'a call cannot be a destructuring target'
fail 'destructure: call as catch pattern', 'try 1 catch [f(a)] then 2', 'a call cannot be a destructuring target'
fail 'destructure: call as keyed catch pattern', 'try 1 catch {k: f(a)} then 2', 'a call cannot be a destructuring target'
fail 'destructure: call as readonly pattern', '[f(a)] =! src', 'a call cannot be a destructuring target'

# A call whose callee spells a pattern head is still a call.
fail 'destructure: call of cast as target', '[cast(a, b)] = src', 'a call cannot be a destructuring target'
fail 'destructure: call of satisfies as target', '[satisfies(a, b)] = src', 'a call cannot be a destructuring target'
fail 'destructure: call of cast as parameter', 'g = ([cast(a, b)]) -> 1', 'a call cannot be a destructuring target'
fail 'destructure: call of array as target', '[array(a, b)] = src', 'a call cannot be a destructuring target'
fail 'destructure: call of object as target', '[object(a)] = src', 'a call cannot be a destructuring target'
fail 'destructure: call of rest as target', '[rest(a)] = src', 'a call cannot be a destructuring target'
fail 'destructure: call of rest as parameter', 'g = ([rest(a)]) -> 1', 'a call cannot be a destructuring target'

# A member of a call's result is a write target, and so is a real cast.
test 'destructure: member of a call result as target', '''
  o = {}
  f = -> o
  [f().b] = [7]
  o.b
''', 7
test 'destructure: postfix cast element', '[a as number] = [5]; a', 5

# ==============================================================================
# Existence Assignment — ?= (assign when nullish; the ??= compound's short spelling)
# ==============================================================================

test "nullish assignment null", "a = null\na ?= 5\na", 5
test "nullish assignment value", "a = 10\na ?= 5\na", 10
test "nullish assignment keeps falsy non-nullish", "c = 0\nc ?= 9\nc", 0

code "nullish assignment compiles to ??=", "a = 1\na ?= 5", "let a = 1;\n\na ??= 5;"

# ==============================================================================
# Middle-rest destructuring — [a, ...mid, b] binds the source once,
# heads by index, the rest by slice, the tail from the end
# ==============================================================================

test 'array rest in middle', '[first, ...middle, last] = [1, 2, 3, 4, 5]; [first, middle, last]', [1, [2, 3, 4], 5]
test 'array rest in middle two after', '[a, ...mid, b, c] = [1, 2, 3, 4, 5]; [a, mid, b, c]', [1, [2, 3], 4, 5]
test 'array rest in middle empty', '[a, ...b, c] = [1, 2]; [a, b, c]', [1, [], 2]

test 'middle rest evaluates its source once', '''
  n = 0
  g = -> (n += 1; [7, 8, 9])
  [x, ...y, z] = g()
  [x, y, z, n]
  ''', [7, [8], 9, 1]

fail 'middle rest takes plain names', '[a, ...[m], b] = xs', 'plain names'

test 'middle rest reads a getter source once', '''
  n = 0
  o = {}
  Object.defineProperty o, 'xs', get: ->
    n += 1
    [1, 2, 3, 4]
  [a, ...mid, b] = o.xs
  [a, mid, b, n]
  ''', [1, [2, 3], 4, 1]

# ==============================================================================
# Slice assignment: `a[i..j] = v` replaces the range in place (splice).
# An open end runs to the end; a missing start begins at 0. A statement
# lowering — value position rejects.
# ==============================================================================

test 'slice assignment replaces a range in place', 'a = [0,1,2,3,4]\na[1..2] = [9, 8, 7]\na', [0,9,8,7,3,4]
test 'exclusive slice assignment', 'a = [0,1,2,3,4]\na[1...3] = [9]\na', [0,9,3,4]
test 'open-ended slice assignment', 'a = [0,1,2,3]\na[2..] = [9]\na', [0,1,9]
test 'slice assignment from the start', 'a = [0,1,2,3]\na[..1] = []\na', [2,3]
test 'slice assignment with a computed value', 'a = [0,1,2]\nv = [7,7]\na[0..0] = v\na', [7,7,1,2]
test 'slice assignment with expression ends', 'a = [0,1,2,3,4]\ni = 1\na[i..i+1] = [9]\na', [0,9,3,4]
code 'slice assignment lowers to splice', 'a[1..2] = [9]', 'a.splice(1, 2, 9);'
code 'an open-ended slice assignment splices to the end', 'a[2..] = v', 'a.splice(2, Infinity, ...[].concat(v));'
code 'slice assignment with expression ends spells the count', 'a[i...j] = v', 'a.splice(i, j - i, ...[].concat(v));'
fail 'a slice assignment has no value form', 'y = (a[1..2] = [9])', 'slice assignment'

test 'a scalar value splices in as one element', '''
    a = [0, 1, 2, 3]
    a[1..2] = 9
    a
  ''', [0, 9, 3]
test 'a reactive bound unwraps in a slice assignment', '''
    i := 1
    a = [0, 1, 2, 3]
    a[i..2] = [7]
    a
  ''', [0, 7, 3]
code 'an array with holes spreads through concat', 'a[0...1] = [1,,2]', 'a.splice(0, 1, ...[].concat([1, , 2]));'
fail 'a negative slice bound rejects', 'a[1..-1] = v', 'cannot count from the end'
fail 'a negative slice start rejects', 'a[-1..] = v', 'cannot count from the end'
fail 'a compound slice assignment rejects', 'a[1..2] += v', 'plain assignment only'
fail 'a synthesized compound slice assignment rejects', 'a[1..2] //= v', 'plain assignment only'
fail 'a compound slice assignment has no value form either', 'x = (a[1..2] += v)', 'plain assignment only'
fail 'a chained slice assignment has no value form', 'x = a[1..2] = v', 'no value form'
code 'a tail-position slice assignment stays a statement', 'g = ->\n  a[1..2] = v', 'let g = function() {\n  a.splice(1, 2, ...[].concat(v));\n};'

# ==============================================================================
# Void readonly definition: the bang and the readonly glyph compose
# ==============================================================================

test "void readonly function returns undefined", '''
  log = []
  wipe! =! (xs) ->
    for x in xs
      log.push x
  [wipe([1, 2]), log]
  ''', [undefined, [1, 2]]

test "void readonly single-line body", "tick! =! -> 1 + 1\ntick()", undefined

test "void readonly fat arrow", "tick! =! => 1 + 1\ntick()", undefined

code "void readonly compiles to a const void function", '''
  wipe! =! (xs) ->
    for x in xs
      x.reset()
  ''', '''
  const wipe = (function(xs) {
    for (let x of xs) {
      x.reset();
    }
    return;
  });
  '''

code "exported void readonly", '''
  export flush! =! -> drain()
  ''', '''
  export const flush = (function() {
    drain();
    return;
  });
  '''
