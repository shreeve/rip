# Test: Same-scope redeclaration
# One binding per name per scope: a second DECLARING form for a name
# rejects positioned, naming the prior site and its binding kind
# (state/computed/readonly/plain/def/class/import/parameter/effect).
# Writes stay legal: plain reassignment, state write-through, and
# nested-scope shadowing are the negative space and pin here too.

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# The rejection: two declaring forms for one name in one scope
# ==============================================================================

# The TDZ cell: the assignment created the binding; the state
# declaration re-declares it — positioned at the DECLARATION, naming
# the assignment's line (the emitted write would land in the const's
# temporal dead zone pointing at the innocent first line).
fail "plain then state", "x = 1\nx := 1", "redeclare.rip>:2:1: emitter: 'x' was already declared as plain on line 1"

fail "plain then def", "x = 1\ndef x\n  2", "'x' was already declared as plain on line 1"
fail "plain then export assign", "x = 1\nexport x = 2", "'x' was already declared as plain on line 1"
fail "state twice", "x := 1\nx := 2", "'x' was already declared as state on line 1"
fail "state then computed", "x := 1\nx ~= 2", "'x' was already declared as state on line 1"
fail "state then def", "x := 1\ndef x\n  1", "'x' was already declared as state on line 1"
fail "computed then state", "x ~= 1 + 2\nx := 3", "'x' was already declared as computed on line 1"
fail "readonly then state", "x =! 1\nx := 2", "'x' was already declared as readonly on line 1"
fail "effect handle twice", "h ~> 1\nh ~> 2", "'h' was already declared as effect on line 1"
fail "class then state", "class X\n  m: -> 1\nX := 2", "'X' was already declared as class on line 1"
fail "class twice", "class E\n  a: -> 0\nclass E\n  b: -> 1", "'E' was already declared as class on line 1"
# A pick key is a property name, never a declaring form — two picks
# of the same keyword key bind nothing.
test "two picks of the same class key", "o = {class: 1}\nq = {class: 2}\na = o.{class}\nb = q.{class}\n[a.class, b.class]", [1, 2]
fail "import then def", "import x from './probe.js'\ndef x\n  1", "'x' was already declared as import on line 1"
fail "state then export assign", "x := 1\nexport x = 2", "'x' was already declared as state on line 1"

# def x twice: Bun runs the module-scope pair silently (last wins),
# Node rejects it — never intent, so BOTH nesting levels reject.
fail "def twice at module scope", "def x\n  1\ndef x\n  2", "'x' was already declared as def on line 1"
fail "def twice in a function body", "def outer\n  def x\n    1\n  def x\n    2\n  x()", "'x' was already declared as def on line 2"

# export def and a later bare def bind ONE name.
fail "export def then def", "export def f\n  1\ndef f\n  2", "'f' was already declared as def on line 1"

# A parameter is a declaration; a declaring form for its name in the
# body rejects (the silent argument-discard cell) — and the message
# names the parameter's line, the uniform shape every kind carries.
fail "param then def in body", "def f(x)\n  def x\n    1\n  x", "'x' was already declared as parameter on line 1"
fail "param then state in body", "def f(x)\n  x := 1\n  x", "'x' was already declared as parameter on line 1"
fail "pattern param then state in body", "def f({a, b})\n  a := 1\n  a", "'a' was already declared as parameter on line 1"
fail "arrow param then state in body", "f = (x) ->\n  x := 1\n  x", "'x' was already declared as parameter on line 1"
fail "param on a later line names ITS line", "def f(x,\n      {a, b})\n  a := 1\n  a", "'a' was already declared as parameter on line 2"

# The plain-then-declare order rejects inside function scopes too.
fail "plain then state in def body", "def f\n  x = 1\n  x := 2\n  x", "'x' was already declared as plain on line 2"

# ==============================================================================
# Duplicate names within one pattern
# ==============================================================================

fail "duplicate params", "def f(x, x)\n  x", "'x' is bound twice in one parameter list"
fail "duplicate in object pattern", "{x, x} = o", "'x' is bound twice in one destructuring pattern"
fail "duplicate in array pattern", "[x, x] = p", "'x' is bound twice in one destructuring pattern"
fail "duplicate in loop head", "for x, x in [[1, 2]]\n  x", "'x' is bound twice in one loop head"
fail "duplicate in comprehension clause", "ys = (a for [a, a] in xs)", "'a' is bound twice in one comprehension clause"
fail "duplicate in catch pattern", "try\n  a()\ncatch [e, e]\n  e", "'e' is bound twice in one catch pattern"

# ==============================================================================
# The negative space: writes and shadows stay legal
# ==============================================================================

# Plain reassignment — the first assignment declares, later ones write.
test "plain reassignment", "x = 1\nx = 2\nx", 2

# State write-through: a plain (or compound, or pattern-element) write
# AFTER the declaration updates the container.
test "state write-through", "x := 1\nx = 5\nx", 5
test "state compound write-through", "x := 1\nx += 4\nx", 5
test "state pattern write-through", "x := 1\n[x] = [7]\nx", 7
test "write-through inside a def body", "def f\n  y := 1\n  y = 3\n  y\nf()", 3

# Destructured catch elements write through to a state binding —
# a write, never a redeclaration.
test "catch pattern write-through", "x := 1\ntry\n  throw {x: 5}\ncatch {x}\n  0\nx", 5

# Nested-scope shadowing: a declaration in an inner function scope
# legally shadows the outer binding.
test "def body shadows module plain", "x = 1\ndef f\n  x := 5\n  x\nf() + x", 6
test "parameter shadows module state", "x := 1\nf = (x) -> x + 1\nf(10) + x", 12

# One binding per name: an assignment to a def/class name reassigns
# the keyword-declared binding — the hoist line mints no second `let`.
test "def then plain reassignment", "def f\n  1\nf = 2\nf", 2
test "class then plain reassignment", "class C\n  m: -> 1\nC = 5\nC", 5

# A plain write to a parameter is a write.
test "param plain assignment", "def f(x)\n  x = x + 1\n  x\nf(1)", 2

# Loop variables declare in the for-head — their own scope: sibling
# loops reuse a name, and a loop variable shadows an outer binding
# without touching it.
test "two loops reuse the variable", "t = 0\nfor i in [1, 2]\n  t += i\nfor i in [3]\n  t += i\nt", 6
test "loop variable shadows state", "i := 9\nout = []\nfor i in [1, 2]\n  out.push(i)\nout.push(i)\nout", [1, 2, 9]

# A simple catch binding is the JS catch parameter — per-handler
# scope, so sibling handlers reuse a name.
test "two catches reuse the binding", "r = []\ntry\n  throw 1\ncatch e\n  r.push(e)\ntry\n  throw 2\ncatch e\n  r.push(e)\nr", [1, 2]

# A def or class in a handler's own block declares where the catch
# binding lives, so naming the binding redeclares it; a deeper block
# shadows it freely.
fail "def redeclares a catch binding", "try\n  g()\ncatch e\n  def e\n    1", ":4:3: emitter: 'e' was already declared as catch binding on line 3 — assign with 'e = …' to update it, or choose a different name"
fail "class redeclares a catch binding", "try\n  g()\ncatch e\n  class e", ":4:3: emitter: 'e' was already declared as catch binding on line 3"
fail "def redeclares a typed catch binding", "try\n  g()\ncatch e: Error\n  def e\n    1", ":4:3: emitter: 'e' was already declared as catch binding on line 3"
fail "def redeclares a catch pattern name", "try\n  g()\ncatch {e}\n  def e\n    1", ":4:3: emitter: 'e' was already declared as catch binding on line 3"
fail "class redeclares a catch array pattern name", "try\n  g()\ncatch [e]\n  class e", ":4:3: emitter: 'e' was already declared as catch binding on line 3"
fail "def redeclares a catch binding inside a function", "f = ->\n  try\n    g()\n  catch e\n    def e\n      1\n    null", ":5:5: emitter: 'e' was already declared as catch binding on line 4"
fail "def redeclares an inner catch binding", "try\n  g()\ncatch e\n  try\n    h()\n  catch e\n    def e\n      1", ":7:5: emitter: 'e' was already declared as catch binding on line 6"
test "a def in a deeper block shadows a catch binding", "r = null\ntry\n  throw 5\ncatch e\n  if true\n    def e\n      7\n    r = e()\nr", 7
test "a def in a finally block is outside the catch binding", "try\n  g = 1\ncatch e\n  null\nfinally\n  def e\n    3\n  r = e()\nr", 3
test "a handler assigns its catch binding", "try\n  throw 1\ncatch e\n  e = e + 1\n  e", 2
# A handler's write to its simple catch name assigns the catch
# parameter, so the enclosing scope declares nothing for it: a read
# after the handler reaches the global, never a stray `let`.
test "a handler's write to its catch name declares nothing", "globalThis.qe1 = 7\ntry\n  throw 1\ncatch qe1\n  qe1 = 2\nr = qe1\ndelete globalThis.qe1\nr", 7
test "a handler's write to its catch name declares nothing in a function", "globalThis.qe2 = 7\nf = ->\n  try\n    throw 1\n  catch qe2\n    if true\n      qe2 = 2\n  qe2\nr = f()\ndelete globalThis.qe2\nr", 7
test "a handler's pattern write declares the names its catch does not bind", "globalThis.qe3 = 7\ntry\n  throw 1\ncatch qe3\n  [qe3, y] = [1, 2]\nr = [qe3, y]\ndelete globalThis.qe3\nr", [7, 2]
test "a handler's write to its catch name leaves an outer name alone", "e = 5\ntry\n  throw 1\ncatch e\n  e = 2\ne", 5
test "a handler's write to its catch name declares nothing for a later def", "try\n  throw 1\ncatch e\n  e = 2\ndef e\n  3\ne()", 3
test "a handler's write to its catch name declares nothing for a later state", "try\n  throw 1\ncatch e\n  e = 2\ne := 4\ne", 4

# A def or class in a block binds its name across the whole block (a
# switch's cases share one block; its subject evaluates outside it), so a
# write to the name earlier in that block would write the def: the def
# rejects, naming the write. A write after the def writes the def, as in
# a function body, and a second def of the name in the block redeclares.
fail "a def in a block rejects an earlier assignment to an outer name", "x = 0\nif true\n  x = 1\n  def x\n    2\nx", ":4:3: emitter: 'x' is written on line 3 before this def in the same block — a def binds its name across its whole block, so that write would assign the def; rename one of them, or move the def out of the block"
fail "a def in a block rejects an earlier assignment to a new name", "if true\n  x = 1\n  def x\n    2", ":3:3: emitter: 'x' is written on line 2 before this def"
fail "a class in a block rejects an earlier assignment", "x = 0\nif true\n  x = 1\n  class x", ":4:3: emitter: 'x' is written on line 3 before this class in the same block"
fail "a def in a block rejects an assignment in a block nested before it", "x = 0\nif true\n  if true\n    x = 1\n  def x\n    2", ":5:3: emitter: 'x' is written on line 4 before this def"
fail "a def in a case rejects an assignment in an earlier case", "x = 0\nswitch 1\n  when 1\n    x = 1\n  when 2\n    def x\n      2", ":6:5: emitter: 'x' is written on line 4 before this def"
fail "a def in a switch's else rejects an assignment in a case", "x = 0\nswitch 1\n  when 1\n    x = 1\n  else\n    def x\n      2", ":6:5: emitter: 'x' is written on line 4 before this def"
fail "a def in a loop body rejects an earlier assignment there", "f = ->\n  x = 0\n  for i in [1]\n    x = i\n    def x\n      2\n  x", ":5:5: emitter: 'x' is written on line 4 before this def"
fail "a def in a block rejects an earlier pattern element", "x = 0\nif true\n  [x, y] = [1, 2]\n  def x\n    2", ":4:3: emitter: 'x' is written on line 3 before this def"
fail "a def in a block rejects an earlier update", "x = 0\nif true\n  x++\n  def x\n    2", ":4:3: emitter: 'x' is written on line 3 before this def"
fail "a def in a block rejects an earlier prefix update", "x = 0\nif true\n  --x\n  def x\n    2", ":4:3: emitter: 'x' is written on line 3 before this def"
fail "a second def of a name in a block redeclares it", "if true\n  def x\n    1\n  def x\n    2", ":4:3: emitter: 'x' was already declared as def on line 2"
fail "a class after a def of its name in a block redeclares it", "if true\n  def x\n    1\n  class x", ":4:3: emitter: 'x' was already declared as def on line 2"
test "a switch's subject assigns outside its cases' block", "x = 0\nswitch (x = 1)\n  when 1\n    def x\n      2\nx", 1
test "a subjectless switch's cases are blocks of their own", "x = 0\nswitch\n  when x > 5\n    x = 1\n  when x < 5\n    def x\n      2\ntypeof x", "number"
test "a regex switch's arms are blocks of their own", "v = 'b'\nr = null\nswitch v\n  when /a/\n    def x\n      1\n    r = x()\n  when /b/\n    def x\n      2\n    r = x()\nr", 2
test "an update after a def in a block writes the def", "r = 0\nif true\n  def x\n    2\n  x++\n  r = typeof x\nr", "number"
test "an assignment after a def in a block writes the def", "r = 0\nif true\n  def x\n    2\n  x = 5\n  r = x\nr", 5
test "an inner block's def answers that block's assignment", "r = 0\nif true\n  if true\n    def x\n      1\n    x = 3\n    r = x\n  def x\n    2\nr", 3
test "an else block's assignment is outside the if block's def", "x = 0\nif false\n  def x\n    2\nelse\n  x = 7\nx", 7

# Comprehension clause variables bind per-construct.
test "comprehension clause shadows plain", "x = 1\nys = (x * 2 for x in [2, 3])\nys.concat([x])", [4, 6, 1]

# The emitter-minted last-match `_` is not a user declaration: match
# writes in any number of scopes (each body re-declares its own `_`
# per invocation) never trip the rule, and a user `_` binding takes
# match writes as ordinary writes.
test "match writes are not declarations", "def grab(s)\n  s =~ /b/\n  _[0]\nx = 'abc'\nx =~ /c/\ngrab('abc') + _[0]", "bc"
test "match write into a user underscore", "_ = 'seed'\ns = 'ab'\ns =~ /a/\n_[0]", "a"

# A `=!` binding never changes: every later write rejects, from the
# same scope or a nested function, plain or compound.
fail 'a write to a readonly binding rejects', "x =! 5\nx = 6", "cannot assign to readonly 'x'"
fail 'a compound write to a readonly binding rejects', "x =! 5\nx += 1", "cannot assign to readonly 'x'"
fail 'a write to an outer readonly from a function rejects', "x =! 5\nf = -> x = 6", "cannot assign to readonly 'x'"
