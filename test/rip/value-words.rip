# Test: value words never name a binding
# `yes`/`no` (the BOOL aliases) and the literal keywords
# (`true`, `false`, `null`, `undefined`, `this`) always READ as their
# value token, before scope exists — a binding so named would be
# unreachable, every read silently the literal. Annotated binding
# sites reject positioned at the name. Property keys, class fields,
# and promoted params stay legal: their reads are property accesses,
# which never consult the word tables.

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# The rejection: annotated binding sites
# ==============================================================================

# Statement-level annotated declarations, every assign head.
fail "annotated declaration", "no: boolean = false\nno", "'no' cannot name a binding — every read of 'no' lowers to `false`, so the binding would be unreachable"
fail "annotated state declaration", "yes: boolean := true\nyes", "'yes' cannot name a binding — every read of 'yes' lowers to `true`, so the binding would be unreachable"
fail "annotated readonly declaration", "yes: number =! 1\nyes", "'yes' cannot name a binding — every read of 'yes' lowers to `true`, so the binding would be unreachable"
fail "annotated declaration in a def body", "def f\n  no: number = 2\n  no\nf()", "'no' cannot name a binding — every read of 'no' lowers to `false`, so the binding would be unreachable"
fail "annotated export declaration", "export no: number = 2", "'no' cannot name a binding"

# The literal keywords reject on the same law.
fail "undefined as declaration name", "undefined: number = 2\nundefined", "'undefined' cannot name a binding — every read of 'undefined' lowers to `undefined`, so the binding would be unreachable"
fail "true as declaration name", "true: boolean = false\ntrue", "'true' cannot name a binding — every read of 'true' lowers to `true`, so the binding would be unreachable"
fail "null as declaration name", "null: number = 2\nnull", "'null' cannot name a binding — every read of 'null' lowers to `null`, so the binding would be unreachable"
fail "this as declaration name", "this: number = 2", "'this' cannot name a binding — every read of 'this' lowers to `this`, so the binding would be unreachable"

# Annotated parameters — def, arrow, and the parameterless def's name
# (its return annotation is what smuggles the word past the scanner).
fail "annotated def parameter", "def toggle(no: boolean)\n  no\ntoggle(true)", "'no' cannot name a binding — every read of 'no' lowers to `false`, so the binding would be unreachable"
fail "annotated arrow parameter", "g = (yes: number) -> yes\ng(1)", "'yes' cannot name a binding — every read of 'yes' lowers to `true`, so the binding would be unreachable"
fail "this as parameter name", "f = (this: Window) -> 1", "'this' cannot name a binding — every read of 'this' lowers to `this`, so the binding would be unreachable"
fail "parameterless def named for an alias", "def no: number\n  42\nno", "'no' cannot name a binding — every read of 'no' lowers to `false`, so the binding would be unreachable"

# Component members read BARE in render and methods, so a value-word
# member is unreachable — both the initialized and the bare typed form
# reject.
fail "component member named no", "A = component\n  no: boolean := false\n  render\n    div\n      = no", "'no' cannot name a binding — every read of 'no' lowers to `false`, so the binding would be unreachable"
fail "component bare typed member named yes", "A = component\n  yes: boolean\n  render\n    div", "'yes' cannot name a binding — every read of 'yes' lowers to `true`, so the binding would be unreachable"

# ==============================================================================
# The negative space: property positions stay legal
# ==============================================================================

# Object keys — nothing later reads a binding.
test "value words as object keys", "a = { yes: 3, no: 4 }\na.yes + a.no", 7

# A class field so named stays reachable: reads are `@`/`this.`
# property accesses.
test "class field named no", "class A\n  no: boolean = false\n  m: -> @no\nnew A().m()", false

# A bare typed class field (no initializer) claims and erases.
test "bare typed class field named no", "class A\n  no: boolean\ntypeof A", "function"

# A promoted parameter's name stays PROPERTY (`@no` is the binding).
test "promoted parameter named no", "class A\n  constructor: (@no: boolean) ->\nnew A(true).no", true

# A component @-prop so named stays legal for the same reason.
test 'component @-prop named no', '''
    A = component
      @no?: boolean := false
      render
        div
          = @no
    inst = A.new()
    inst._init({})
    typeof inst._create
''', 'function'

# A `this`-typed parameter inside a TYPE ALIAS is type text, not a
# binding site.
test "this-param in a type alias", "type H = (this: Window, x: number) => any\n1", 1

# The aliases keep their VALUE reading everywhere an expression is.
test "alias reads still lower", "x = no\ny = yes\n[x, y]", [false, true]

# `on` and `off` are ordinary names, free for an event API.
test "on and off are ordinary names", "on = (event, fn) -> event + fn\noff = 2\n[on('a', 'b'), off]", ["ab", 2]
test "on and off as annotated state and destructured names", "on: boolean := yes\n[ off ] = [ no ]\n[on, off]", [true, false]

# ==============================================================================
# The rejection: destructuring patterns
# ==============================================================================

# A pattern element carries no colon, so the alias table rewrites it in
# the scanner and the annotated-site guard never sees a name to reject.
# `[ false ]` is a legal array literal, and assignment reinterprets it as
# a pattern afterwards — so the pattern walk is the last place that can
# still tell an identifier from a literal. Rejected there, positioned on
# the enclosing pattern: the leaf is a bare string with no span of its
# own, and the word in the source (`no`) is not the word in the tree
# (`false`), so the caret is what points at what the author wrote.
fail "array-destructured value word", "[ no ] = [ 7 ]\nno", "`false` cannot be a destructuring target"
fail "array-destructured value word among names", "[ a, no ] = [ 1, 2 ]\na", "`false` cannot be a destructuring target"
fail "rest-destructured value word", "[ ...no ] = [ 1, 2 ]\nno", "`false` cannot be a destructuring target"
fail "nested destructured value word", "[[ yes ]] = [[ 7 ]]\nyes", "`true` cannot be a destructuring target"
fail "object pattern renamed to a value word", "o = { a: 7 }\n{ a: yes } = o\nyes", "`true` cannot be a destructuring target"
fail "destructured def parameter", "def f([ no ])\n  no\nf([7])", "`false` cannot be a destructuring target"
fail "destructured loop head", "for [ no ] in [[1]]\n  no", "`false` cannot be a destructuring target"

# The literal keywords ride the same law. `undefined` is the one that
# failed SILENTLY before this rejection: `let undefined` is valid
# JavaScript, so the module built and shadowed the global.
fail "destructured literal keyword", "[ true ] = [ 7 ]\n1", "`true` cannot be a destructuring target"
fail "destructured undefined", "[ undefined ] = [ 7 ]\n1", "`undefined` cannot be a destructuring target"

# The negative space: an ordinary name destructures as it always did,
# including one that merely CONTAINS a value word.
test "ordinary name destructures", "[ nope ] = [ 7 ]\nnope", 7
test "name containing a value word destructures", "{ offset } = { offset: 3 }\noffset", 3
