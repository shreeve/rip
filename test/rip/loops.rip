# Test: Loops (5 node types)
# Tests "for-in", "for-of", "while", "until", "loop" node types

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# For-In Loops (Array Iteration): "for-in"
# ==============================================================================

# Basic for-in
test "for-in array", "sum = 0; for x in [1, 2, 3]\n  sum += x\nsum", 6
test "for-in with index", "result = ''; for item, i in ['a', 'b', 'c']\n  result += i\nresult", "012"
test "for-in range", "sum = 0; for i in [1..5]\n  sum += i\nsum", 15

# For-in with destructuring and defaults
test "for-in destructuring with defaults", "arr = [[1, 2, 3], [4, 5], [6]]\nresult = []\nfor [a, b = 99, c = 88] in arr\n  result.push(a + b + c)\nresult", [6, 97, 193]

# Loop variable must be reassignable inside the body (CoffeeScript idiom)

test "for-in reassign loop var", '''
  out = []
  for x in ["  a ", " b  "]
    x = x.trim()
    out.push x
  out
  ''', ["a", "b"]

test "for-in indexed reassign loop var", '''
  out = []
  for x, i in ["  a ", " b  "]
    x = x.trim()
    out.push "#{i}:#{x}"
  out
  ''', ["0:a", "1:b"]

# A var-less ranged for rejects loudly — the repeat idiom takes a binding.
fail "range loop without var rejects", "for [1...5]\n  x = 1", "binds no variable"

# Closure capture: loop variable must be fresh per iteration so that
# closures created inside the body see *this* iteration's value, not
# the last value the loop variable held. Regression for the bug where
# `for (x of arr)` without `let` caused all closures to share one binding.

test "for-in closure captures per iteration", '''
  handlers = []
  for x in [1, 2, 3]
    handlers.push -> x
  handlers.map (h) -> h()
  ''', [1, 2, 3]

test "for-in indexed closure captures per iteration", '''
  handlers = []
  for x, i in ["a", "b", "c"]
    handlers.push -> "#{i}:#{x}"
  handlers.map (h) -> h()
  ''', ["0:a", "1:b", "2:c"]

test "for-in destructured closure captures per iteration", '''
  handlers = []
  for [a, b] in [[1, 2], [3, 4], [5, 6]]
    handlers.push -> a + b
  handlers.map (h) -> h()
  ''', [3, 7, 11]

test "for-in reverse closure captures per iteration", '''
  handlers = []
  for x in [1, 2, 3] by -1
    handlers.push -> x
  handlers.map (h) -> h()
  ''', [3, 2, 1]

# Code generation
code "for-in loop", "for x in arr\n  x", "for (let x of arr) { x; }"
# ==============================================================================
# For-Of Loops (Object Iteration): "for-of"
# ==============================================================================

# Basic for-of
test "for-of object", "obj = {a: 1, b: 2}; sum = 0; for key, val of obj\n  sum += val\nsum", 3
test "for-of keys only", "obj = {a: 1, b: 2}; keys = []; for key of obj\n  keys.push(key)\nkeys.length", 2

# For-of must allow reassigning the value variable inside the body

test "for-of reassign value var", '''
  obj = {a: "  1 "}
  out = null
  for k, v of obj
    v = v.trim()
    out = v
  out
  ''', "1"

# Closure capture: same per-iteration semantics for object iteration

test "for-of closure captures per iteration", '''
  handlers = []
  for k, v of {a: 1, b: 2, c: 3}
    handlers.push -> "#{k}=#{v}"
  handlers.map((h) -> h()).sort()
  ''', ["a=1", "b=2", "c=3"]

# Code generation
code "for-of loop", "for k, v of obj\n  v", "const _ref = obj;\nfor (let k in _ref) {\nlet v = _ref[k];\nv;\n}"
code "for own", "for own k of obj\n  k", "const _ref = obj;\nfor (let k in _ref) {\nif (!Object.hasOwn(_ref, k)) continue;\nk;\n}"
code "for own with value", "for own k, v of obj\n  v", "const _ref = obj;\nfor (let k in _ref) {\nif (!Object.hasOwn(_ref, k)) continue;\nlet v = _ref[k];\nv;\n}"

# ==============================================================================
# While Loops: "while"
# ==============================================================================

# Basic while
test "while loop", "i = 0; sum = 0; while i < 5\n  sum += i\n  i += 1\nsum", 10

# While with guard
test "while when", "i = 0\nsum = 0\nwhile i < 10\n  if i % 2 == 0\n    sum += i\n  i += 1\nsum", 20

# Postfix while
test "postfix while", "i = 0; i += 1 while i < 5; i", 5

# Code generation
code "while loop", "while cond\n  body", "while (cond) { body; }"

# ==============================================================================
# Until Loops: "until"
# ==============================================================================

# Basic until
test "until loop", "i = 0; until i >= 5\n  i += 1\ni", 5

# Until with guard
test "until when", "i = 0\nsum = 0\nuntil i >= 10\n  if i % 2 == 0\n    sum += i\n  i += 1\nsum", 20

# Postfix until
test "postfix until", "i = 0; i += 1 until i >= 5; i", 5

# Code generation
code "until loop", "until cond\n  body", "while (!cond) {\n  body;\n}"

# ==============================================================================
# Infinite Loops: "loop"
# ==============================================================================

# Loop with break
test "loop with break", "i = 0; loop\n  i += 1\n  break if i >= 5\ni", 5

# Loop with continue
test "loop with continue", "i = 0; sum = 0; loop\n  i += 1\n  continue if i % 2 != 0\n  sum += i\n  break if i >= 10\nsum", 30

# Code generation
code "infinite loop", "loop\n  body", "while (true) { body; }"

# ==============================================================================
# Loop Control: break and continue
# ==============================================================================

# Break statement

test "break in for-in", '''
  sum = 0
  for i in [1..10]
    break if i > 5
    sum += i
  sum
  ''', 15

# Continue statement

test "continue in for-in", '''
  sum = 0
  for i in [1..10]
    continue if i % 2 == 0
    sum += i
  sum
  ''', 25

test "or continue skips falsy", '''
  out = []
  for line in ['a', '  ', 'b', '']
    code = line.trim() or continue
    out.push code
  out
  ''', ['a', 'b']

test "and continue fires on truthy", '''
  out = []
  for x in [0, 1, 2]
    x is 1 and continue
    out.push x
  out
  ''', [0, 2]

test "?? continue fires on nullish only", '''
  out = []
  for x in [0, null, '', undefined]
    y = x ?? continue
    out.push y
  out
  ''', [0, '']

test "or break stops the loop", '''
  n = 0
  for i in [1..10]
    i < 5 or break
    n += i
  n
  ''', 10

code "or continue assignment lowers to an if-guard", '''
for x in [1]
  y = x or continue
''', '''
let y;

for (let x of [1]) {
  if (!(y = x)) continue;
}
'''

fail "a continue guard rejects in value position", "f = ->\n  g(x or continue)", "a continue guard is a statement"
fail "a continue guard rejects outside a loop", "x or continue", "'continue' outside a loop"

test "else continue skips falsy", '''
  out = []
  for line in ['a', '  ', 'b', '']
    code = line.trim() else continue
    out.push code
  out
''', ['a', 'b']

test "then continue fires on truthy", '''
  out = []
  for x in [0, 1, 2]
    x is 1 then continue
    out.push x
  out
''', [0, 2]

code "else continue assignment lowers to an if-guard", '''
for x in [1]
  y = x else continue
''', '''
let y;

for (let x of [1]) {
  if (!(y = x)) continue;
}
'''

# ==============================================================================
# For-As Loops (ES6 for-of on iterables): "for-as"
# ==============================================================================

# Basic for-as
test "for-as array", "sum = 0; for x as [1, 2, 3]\n  sum += x\nsum", 6
test "for-as set", "sum = 0; s = new Set([10, 20, 30]); for x as s\n  sum += x\nsum", 60

# For-as with destructuring (used in packages for Map.entries())

test "for-as destructure", '''
  m = new Map()
  m.set("a", 1)
  m.set("b", 2)
  result = []
  for [k, v] as m.entries()
    result.push("#{k}=#{v}")
  result
  ''', ["a=1", "b=2"]

test "for-as destructure array", '''
  pairs = [[1, 2], [3, 4], [5, 6]]
  sum = 0
  for [a, b] as pairs
    sum += a + b
  sum
  ''', 21

# Closure capture for for-as. Includes a Map-like case that exercises
# the bundle-registration pattern server middleware uses.

test "for-as closure captures per iteration", '''
  handlers = []
  for x as [10, 20, 30]
    handlers.push -> x
  handlers.map (h) -> h()
  ''', [10, 20, 30]

test "for-as destructured closure captures per iteration", '''
  bundles = new Map()
  bundles.set 'ui',  ['a']
  bundles.set 'app', ['b']
  handlers = {}
  for [name, dirs] as bundles
    handlers[name] = -> { name, dirs }
  [handlers.ui(), handlers.app()]
  ''', [{name: 'ui', dirs: ['a']}, {name: 'app', dirs: ['b']}]

# Code generation
code "for-as loop", "for x as iter\n  x", "for (let x of iter) { x; }"
code "for-as destructure gen", "for [k, v] as m.entries()\n  k", "for (let [k, v] of m.entries()) { k; }"

# ==============================================================================
# For as Object Property Value (no parens required)
# ==============================================================================

test "for-in as object property value", '''
  items = ["a", "b"]
  data =
    codes: for x in items
      tag: x
    other: 99
  [data.codes.length, data.codes[0].tag, data.other]
  ''', [2, "a", 99]

test "for-in property value with body logic", '''
  list = [1, 2, 3, 4]
  data =
    evens: for x in list when x % 2 is 0
      x * 10
  data.evens
  ''', [20, 40]

# ==============================================================================
# Nested Loops
# ==============================================================================

test "nested for-in", '''
  sum = 0
  for i in [1, 2, 3]
    for j in [10, 20]
      sum += i * j
  sum
  ''', 180

test 'break in for loop', '''
  result = []
  for x in [1, 2, 3, 4, 5]
    if x is 3
      break
    result.push(x)
  result
  ''', [1, 2]

test 'continue in for loop', '''
  result = []
  for x in [1, 2, 3, 4, 5]
    if x is 3
      continue
    result.push(x)
  result
  ''', [1, 2, 4, 5]

test 'break with condition', '''
  i = 0
  for x in [1, 2, 3, 4, 5]
    break if x > 3
    i = x
  i
  ''', 3

test 'comprehension with break in if', '''
  result = for x in [1, 2, 3, 4, 5]
    if x is 3
      break
    x
  result
  ''', [1, 2]

test 'comprehension with continue in if', '''
  result = for x in [1, 2, 3, 4, 5]
    if x is 3
      continue
    x
  result
  ''', [1, 2, 4, 5]

code 'break in for loop', '''
  for x in arr
    if x > 5
      break
  ''', '''
  for (let x of arr) {
    if (x > 5) {
      break;
    }
  }
'''

# ==============================================================================
# Range Loop Optimization
# ==============================================================================

test 'range loop optimization - simple numeric', '''
  result = []
  for k in [1...5]
    result.push k
  result
  ''', [1, 2, 3, 4]

test 'range loop optimization - property access', '''
  obj = {arr: [10, 20, 30, 40]}
  result = []
  for k in [0...obj.arr.length]
    result.push obj.arr[k]
  result
  ''', [10, 20, 30, 40]

test 'inclusive range loop', '''
  result = []
  for k in [1..3]
    result.push k
  result
  ''', [1, 2, 3]

code 'range loop generates traditional for', '''
  for k in [1...10]
    console.log k
  ''', '''
  for (let k = 1; k < 10; k++) {
    console.log(k);
  }
'''

# ==============================================================================
# Reverse Iteration (by -1)
# ==============================================================================

test 'reverse iteration with by -1', '''
  result = []
  for x in [1, 2, 3, 4, 5] by -1
    result.push x
  result
  ''', [5, 4, 3, 2, 1]

test 'reverse iteration with break', '''
  result = []
  for x in [10, 20, 30, 40, 50] by -1
    break if x < 25
    result.push x
  result
  ''', [50, 40, 30]

test 'reverse iteration in function', '''
  fn = (arr) ->
    last = null
    for x in arr by -1
      if x > 0
        last = x
        break
    last
  fn([1, 2, -5, 3, -1])
  ''', 3

code 'reverse iteration generates countdown', '''
  for x in arr by -1
    console.log x
  ''', '''
  for (let _ref = arr, _i = _ref.length - 1; _i >= 0; _i--) {
    let x = _ref[_i];
    console.log(x);
  }
'''

# ==============================================================================
# loop n — repeat N times
# ==============================================================================

# ==============================================================================
# Loops as expressions — collect each iteration's value (CoffeeScript-style)
# ==============================================================================

test "postfix while as value collects results", '''
  i = 0
  x = (i += 1 while i < 4)
  x
  ''', [1, 2, 3, 4]

test "block while as value collects results", '''
  i = 0
  x = while i < 3
    i += 1
    i * 10
  x
  ''', [10, 20, 30]

test "postfix until as value collects results", '''
  i = 0
  x = (i += 1 until i >= 3)
  x
  ''', [1, 2, 3]

test "while as value with await", '''
  f = -> Promise.resolve 7
  i = 0
  x = while i < 2
    i += 1
    await f()
  x
  ''', [7, 7]

test "statement-level postfix while is a plain loop", '''
  i = 0
  i += 1 while i < 5
  i
  ''', 5

# ==============================================================================
# Loop sources evaluate exactly once
# ==============================================================================

test "an indexed for evaluates its source once", '''
  calls = 0
  make = ->
    calls += 1
    [10, 20]
  out = for x, i in make()
    [x, i]
  [calls, out]
''', [1, [[10, 0], [20, 1]]]

test "a stepped for evaluates source and step once", '''
  calls = 0
  make = ->
    calls += 1
    [1, 2, 3, 4]
  out = for x in make() by 2
    x
  [calls, out]
''', [1, [1, 3]]

test "an object for evaluates its source once", '''
  calls = 0
  make = ->
    calls += 1
    {a: 1, b: 2}
  out = for k, v of make()
    [k, v]
  [calls, out]
''', [1, [["a", 1], ["b", 2]]]

test "an own for evaluates its source once", '''
  calls = 0
  make = ->
    calls += 1
    {a: 1}
  out = for own k, v of make()
    k
  [calls, out]
''', [1, ["a"]]

test "an impure range bound evaluates once", '''
  calls = 0
  top = ->
    calls += 1
    3
  out = for v in [1..top()]
    v
  [calls, out]
''', [1, [1, 2, 3]]

code "a bound plain-name indexed source keeps its bytes", "xs = []\nfor x, i in xs\n  x", '''
  let xs = [];
  for (let i = 0; i < xs.length; i++) {
    let x = xs[i];
    x;
  }
'''

# ==============================================================================
# Counted Loop — loop n (runs n times; `it` is the counter binding)
# ==============================================================================

test 'loop n times', '''
  count = 0
  loop 3
    count++
  count
  ''', 3

test 'loop n inline', '''
  arr = []
  loop 5
    arr.push arr.length
  arr
  ''', [0, 1, 2, 3, 4]

test 'loop n with it as counter', '''
  arr = []
  loop 5
    arr.push it
  arr
  ''', [0, 1, 2, 3, 4]

code 'loop n compiles to for', '''
  loop 3
    console.log 'hi'
  ''', '''
  for (let it = 0; it < 3; it++) {
    console.log('hi');
  };
  '''

test 'loop n as value collects results', '''
  x = loop 3
    "hi"
  x
  ''', ['hi', 'hi', 'hi']

test 'loop n count evaluates once', '''
  n = 0
  g = -> (n += 1; 3)
  loop g()
    0
  n
  ''', 1

test 'plain loop stays infinite until break', '''
  i = 0
  loop
    i++
    break if i is 4
  i
  ''', 4

# ==============================================================================
# Loop sources that the lowering rereads evaluate exactly once: getter-backed
# range endpoints, loop-n counts, and indexed for-in sources bind a ref.
# ==============================================================================

test 'range endpoint getter reads once', '''
  n = 0
  o = {}
  Object.defineProperty o, 'limit', get: ->
    n += 1
    3
  out = []
  for i in [0...o.limit]
    out.push i
  [out, n]
  ''', [[0, 1, 2], 1]

test 'loop-n count getter reads once', '''
  n = 0
  o = {}
  Object.defineProperty o, 'count', get: ->
    n += 1
    2
  hits = 0
  loop o.count
    hits += 1
  [hits, n]
  ''', [2, 1]

test 'indexed for-in source getter reads once', '''
  n = 0
  o = {}
  Object.defineProperty o, 'xs', get: ->
    n += 1
    [10, 20]
  total = 0
  for x, i in o.xs
    total += x + i
  [total, n]
  ''', [31, 1]

# ==============================================================================
# A guarded loop emits braced: a loop that hoists a temp (`const _ref`
# ahead of `for (… in _ref)`) would otherwise leave the loop itself
# outside the guard.
# ==============================================================================

code 'a guarded own-loop braces its hoisted temp', 'f k for own k of g() if c', '''
  if (c) {
    const _ref = g();
    for (let k in _ref) {
      if (!Object.hasOwn(_ref, k)) continue;
      f(k);
    };
  }
  '''
code 'a guarded plain loop braces too', 'f x for x in xs if c', '''
  if (c) {
    for (let x of xs) {
      f(x);
    };
  }
  '''

fail 'a var-less ranged loop with a step rejects the same way', 'for [1..5] by 2\n  x = 1', 'binds no variable'

# ==============================================================================
# Range loop direction: literal bounds decide statically, variable bounds
# ascend, `by` decides when present; one counting header in every form
# ==============================================================================

test "range literal descending", "out = []\nfor i in [3..1]\n  out.push i\nout", [3, 2, 1]
test "range literal descending exclusive", "out = []\nfor i in [3...1]\n  out.push i\nout", [3, 2]
test "range equal bounds inclusive", "out = []\nfor i in [2..2]\n  out.push i\nout", [2]
test "range equal bounds exclusive", "out = []\nfor i in [2...2]\n  out.push i\nout", []
test "range negative literal bounds ascending", "out = []\nfor i in [-2..2]\n  out.push i\nout", [-2, -1, 0, 1, 2]
test "range negative literal bounds descending", "out = []\nfor i in [2..-2]\n  out.push i\nout", [2, 1, 0, -1, -2]
test "range variable start above end is empty", "hi = 3\nlo = 1\nout = []\nfor i in [hi..lo]\n  out.push i\nout", []
test "range variable descends with by -1", "hi = 3\nlo = 1\nout = []\nfor i in [hi..lo] by -1\n  out.push i\nout", [3, 2, 1]
test "range [1..n] with n = 0 is empty", "n = 0\nout = []\nfor i in [1..n]\n  out.push i\nout", []
test "range [0...count - 1] with count = 0 is empty", "count = 0\nout = []\nfor i in [0...count - 1]\n  out.push i\nout", []
test "range fractional bound compares directly", "len = 5\nout = []\nfor i in [0...len / 2]\n  out.push i\nout", [0, 1, 2]
test "range literal step sign wins over literal bounds", "out = []\nfor i in [6..0] by 2\n  out.push i\nfor i in [0..6] by -2\n  out.push i\nout", []
test "range two-variable form binds the index", "out = []\nfor v, i in [1..3]\n  out.push [v, i]\nout", [[1, 0], [2, 1], [3, 2]]
test "range two-variable form with a step", "out = []\nfor v, i in [1..6] by 2\n  out.push [v, i]\nout", [[1, 0], [3, 1], [5, 2]]
test "range two-variable form with a variable bound", "n = 3\nout = []\nfor v, i in [1..n]\n  out.push [v, i]\nout", [[1, 0], [2, 1], [3, 2]]

test "range bounds evaluate once each, in order", '''
  calls = []
  lo = -> calls.push 'lo'; 1
  hi = -> calls.push 'hi'; 3
  out = []
  for i in [lo()..hi()]
    out.push i
  [out, calls]
  ''', [[1, 2, 3], ['lo', 'hi']]

test "range loop variable is captured per iteration", '''
  fs = []
  for i in [1..3]
    fs.push -> i
  (f() for f in fs)
  ''', [1, 2, 3]

test "range tail loop returns the collected values", '''
  f = ->
    for i in [3..1]
      i * 2
  f()
  ''', [6, 4, 2]

test "range loop inside a generator yields each value", '''
  g = ->
    for i in [1..3]
      yield i
  [...g()]
  ''', [1, 2, 3]

test "range value keeps runtime direction while the loop ascends", '''
  hi = 3
  lo = 1
  value = [hi..lo]
  looped = []
  for i in [hi..lo]
    looped.push i
  [value, looped]
  ''', [[3, 2, 1], []]

code 'range literal descending compiles to a counting loop', '''
  for k in [3..1]
    console.log k
  ''', '''
  for (let k = 3; k >= 1; k--) {
    console.log(k);
  }
  '''

code 'range negative literal bound needs no temp', '''
  for k in [2..-2]
    console.log k
  ''', '''
  for (let k = 2; k >= -2; k--) {
    console.log(k);
  }
  '''

code 'range two-variable form declares the index in the header', '''
  for v, i in [1..3]
    console.log v, i
  ''', '''
  for (let v = 1, i = 0; v <= 3; v++, i++) {
    console.log(v, i);
  }
  '''

code 'range tail loop collects from a counting loop', '''
  f = ->
    for k in [1..3]
      k
  ''', '''
  let f = function() {
    const _result = [];
    for (let k = 1; k <= 3; k++) {
      _result.push(k);
    }
    return _result;
  };
  '''

# ==============================================================================
# `own` is a keyword only directly after `for`
# ==============================================================================

test "own as a variable", "own = 3\nown + 1", 4
test "own as a parameter and property", "f = (own) -> own.own\nf({ own: 7 })", 7
test "own as a function name", "own = (x) -> x * 2\nown 21", 42
test "for own still filters inherited keys", '''
  base = { inherited: 1 }
  obj = Object.create base
  obj.mine = 2
  keys = (k for own k of obj)
  all = (k for k of obj)
  [keys, all.sort()]
  ''', [['mine'], ['inherited', 'mine']]
test "for own with a value and an own variable in scope", '''
  own = 'shadow'
  out = []
  for own k, v of { a: 1 }
    out.push [k, v, own]
  out
  ''', [['a', 1, 'shadow']]

# ==============================================================================
# A closure assigns the loop variable of the loop it sits in
# ==============================================================================
#
# A loop variable is a declaration of the block the loop heads. A
# function nested in the body that assigns it writes THAT binding — the
# iteration's own `let` — and declares no local over it, inside a
# function and at the top level alike.

test "closure assigns a for-in variable, inside a function", '''
  run = ->
    out = []
    for seed in [3, 17]
      step = ->
        seed = (seed * 5 + 1) % 100
        seed
      out.push step(), step()
    out
  run()
  ''', [16, 81, 86, 31]

test "closure assigns a for-in variable, at the top level", '''
  out = []
  for seed in [3, 17]
    step = ->
      seed = (seed * 5 + 1) % 100
      seed
    out.push step(), step(), seed
  out
  ''', [16, 81, 81, 86, 31, 31]

test "closure assigns both variables of an indexed for-in", '''
  run = ->
    out = []
    for x, i in [3, 17]
      bump = ->
        x = x + 100
        i = i + 10
        [x, i]
      undo = -> i = i - 10
      out.push bump(), x, i
      undo()
    out
  run()
  ''', [[103, 10], 103, 10, [117, 11], 117, 11]

test "closure assigns the key and the value of a for-of", '''
  run = ->
    out = []
    for k, v of {a: 1, b: 2}
      bump = ->
        k = k + '!'
        v = v + 100
        null
      bump()
      out.push k, v
    out
  run()
  ''', ['a!', 101, 'b!', 102]

test "closure assigns a for-own key", '''
  run = ->
    out = []
    for own k of {a: 1, b: 2}
      bump = -> k = k + '!'
      out.push bump(), k
    out
  run()
  ''', ['a!', 'a!', 'b!', 'b!']

test "closure assigns a for-as variable", '''
  run = ->
    out = []
    for x as new Set([3, 17])
      bump = -> x = x + 100
      out.push bump(), x
    out
  run()
  ''', [103, 103, 117, 117]

test "closure assigns a range counter, and the header advances from the write", '''
  run = ->
    out = []
    for i in [0...6]
      skip = -> i = i + 2
      out.push i
      skip()
    out
  run()
  ''', [0, 3]

test "closure assigns a range counter with variable bounds", '''
  run = (lo, hi) ->
    out = []
    for i in [lo..hi]
      bump = -> i = i + 100
      undo = -> i = i - 100
      out.push bump(), i
      undo()
    out
  run 1, 2
  ''', [101, 101, 102, 102]

test "closure assigns a guarded for-in variable", '''
  run = ->
    out = []
    for x in [3, 4, 17] when x % 2
      bump = -> x = x + 100
      out.push bump(), x
    out
  run()
  ''', [103, 103, 117, 117]

test "closure assigns a stepped for-in variable", '''
  run = ->
    out = []
    for x in [3, 4, 17] by 2
      bump = -> x = x + 100
      out.push bump(), x
    out
  run()
  ''', [103, 103, 117, 117]

test "closure assigns a descending stepped for-in variable", '''
  run = ->
    out = []
    for x in [17, 3] by -1
      bump = -> x = x + 100
      out.push bump(), x
    out
  run()
  ''', [103, 103, 117, 117]

test "closure assigns a destructured object loop variable", '''
  run = ->
    out = []
    for {a, b} in [{a: 3, b: 1}, {a: 17, b: 2}]
      bump = -> a = a + b
      out.push bump(), a
    out
  run()
  ''', [4, 4, 19, 19]

test "closure assigns a destructured array loop variable", '''
  run = ->
    out = []
    for [a, b] in [[1, 3], [2, 17]]
      bump = -> b = b + a
      out.push bump(), b
    out
  run()
  ''', [4, 4, 19, 19]

test "closure assigns a destructured for-of value variable", '''
  run = ->
    out = []
    for k, {a} of {p: {a: 3}, q: {a: 17}}
      bump = -> a = a + 100
      out.push bump(), a
    out
  run()
  ''', [103, 103, 117, 117]

# A zero-parameter function that mentions `it` takes it as its implicit
# parameter, so the closure that reaches the counter names a parameter.
test "closure with a parameter assigns the loop-n counter", '''
  out = []
  loop 3
    skip = (n) -> it = it + n
    out.push it
    skip 1
  out
  ''', [0, 2]

test "closure assigns the outer variable of nested loops", '''
  run = ->
    out = []
    for x in [3, 17]
      for y in [1, 2]
        bump = -> x = x + y
        bump()
      out.push x
    out
  run()
  ''', [6, 20]

test "closure two functions down assigns the loop variable", '''
  run = ->
    out = []
    for x in [3, 17]
      outer = ->
        inner = -> x = x + 100
        inner()
      out.push outer(), x
    out
  run()
  ''', [103, 103, 117, 117]

test "closure compound-assigns the loop variable", '''
  run = ->
    out = []
    for x in [3, 17]
      bump = -> x += 100
      out.push bump(), x
    out
  run()
  ''', [103, 103, 117, 117]

test "closure assigns the loop variable inside a class method", '''
  class Walk
    go: ->
      out = []
      for x in [3, 17]
        bump = => x = x + 100
        out.push bump(), x
      out
  Walk.new().go()
  ''', [103, 103, 117, 117]

test "closure assigns the loop variable inside a def", '''
  def run()
    out = []
    for x in [3, 17]
      bump = -> x = x + 100
      out.push bump(), x
    out
  run()
  ''', [103, 103, 117, 117]

test "closure assigns the loop variable inside a fat arrow", '''
  run = =>
    out = []
    for x in [3, 17]
      bump = => x = x + 100
      out.push bump(), x
    out
  run()
  ''', [103, 103, 117, 117]

test "closure assigns the loop variable inside a try", '''
  run = ->
    out = []
    try
      for x in [3, 17]
        bump = -> x = x + 100
        out.push bump(), x
    catch e
      out.push String(e)
    out
  run()
  ''', [103, 103, 117, 117]

test "closure assigns the loop variable inside an async function", '''
  run = ->
    out = []
    for x in [3, 17]
      bump = -> x = x + 100
      out.push bump(), x
    await Promise.resolve out
  run!
  ''', [103, 103, 117, 117]

# Each iteration owns its binding: a closure that assigns the variable
# keeps writing its own iteration's value after the loop has moved on.

test "each iteration's closure writes its own binding", '''
  run = ->
    fns = []
    for x in [3, 17]
      fns.push -> x = x + 100
    [fns[0](), fns[0](), fns[1]()]
  run()
  ''', [103, 203, 117]

test "each range iteration's closure writes its own binding", '''
  fns = []
  for i in [1..2]
    fns.push -> i = i + 100
  [fns[0](), fns[0](), fns[1]()]
  ''', [101, 201, 102]

# The loop's value forms bind the same way.

test "closure in a loop used as a value assigns the variable", '''
  fns = for x in [3, 17]
    ->
      x = x + 100
      x
  fns.map (f) -> f()
  ''', [103, 117]

test "closure in a function's tail loop assigns the variable", '''
  make = ->
    for k, v of {a: 3, b: 17}
      ->
        v = v + 100
        v
  make().map (f) -> f()
  ''', [103, 117]

# The binding ends with the loop, and a parameter still shadows it.

test "closure reads the loop variable", '''
  run = ->
    out = []
    for x in [3, 17]
      peek = -> x + 1
      out.push peek()
    out
  run()
  ''', [4, 18]

test "closure assigning another name keeps its own local", '''
  run = ->
    out = []
    for x in [3, 17]
      f = ->
        y = x + 1
        y
      out.push f()
    out
  run()
  ''', [4, 18]

test "closure after the loop assigns a local of its own", '''
  run = ->
    out = []
    for x in [3, 17]
      out.push x
    after = ->
      x = 99
      x
    out.push after()
    out
  run()
  ''', [3, 17, 99]

test "closure parameter shadows the loop variable", '''
  run = ->
    out = []
    for x in [3, 17]
      f = (x) -> x = x + 1
      out.push f(0), x
    out
  run()
  ''', [1, 3, 1, 17]
