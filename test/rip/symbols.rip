# Test: Symbol literals — `:name` is Symbol.for("name"): interned,
# identity-comparable. A SPACED colon tight to a word is a symbol; a
# tight key colon ({a:b}), a spaced pair ({a : b}), and a pending
# ternary's else-colon all keep their structural readings. One trailing
# `!`/`?` joins the name (`:save!`, `:valid?`) — claimed only at a clear
# boundary, so `:a!=b`, `:a??b`, and `:a?.b` keep their operator readings.

import { test, code, fail, type } from '../support/testing.js'

code 'symbol literal', ':redo', 'Symbol.for("redo")'
code 'symbol literal skip', ':skip', 'Symbol.for("skip")'
code 'symbol literal with underscore', ':foo_bar', 'Symbol.for("foo_bar")'
code 'symbol literal with digits', ':item2', 'Symbol.for("item2")'
code 'symbol literal dollar', ':$special', 'Symbol.for("$special")'
code 'symbol literal dotted namespace', ':rip.server.session', 'Symbol.for("rip.server.session")'
code 'symbol literal dotted', ':foo.bar', 'Symbol.for("foo.bar")'
code 'symbol literal hyphenated', ':foo-bar', 'Symbol.for("foo-bar")'
code 'symbol literal compound namespace', ':one.two.three-four.five', 'Symbol.for("one.two.three-four.five")'

test 'symbol typeof', 'typeof :redo', 'symbol'
test 'symbol identity', ':redo is :redo', true
test 'symbol inequality', ':redo isnt :skip', true
test 'symbol description', '(:hello).description', 'hello'
test 'symbol assignment', 'x = :done; typeof x', 'symbol'
test 'symbol readonly', 'x =! :frozen; x is :frozen', true
test 'symbol in array', 'arr = [:a, :b, :c]; arr.length', 3
test 'symbol array identity', 'arr = [:x]; arr[0] is :x', true
test 'symbol as object value', 'obj = {status: :active}; obj.status is :active', true
test 'symbol in object literal', 'obj = {a: :one, b: :two}; obj.a is :one and obj.b is :two', true

test 'symbol as argument', '''
  fn = (x) -> x is :yes
  fn(:yes)
''', true

test 'symbol multiple args', '''
  fn = (a, b) -> a is :x and b is :y
  fn(:x, :y)
''', true

test 'symbol equality', ':abc is :abc', true

test 'symbol with switch', '''
  x = :red
  switch x
    when :red then "stop"
    when :green then "go"
    else "unknown"
''', 'stop'

test 'ternary with spaces', 'true ? :yes : :no'
test 'object with symbol value', '{key: :val}.key is :val', true

test 'symbols are interned across expressions', '''
  a = :hello
  b = :hello
  a is b
''', true

test 'symbol matches Symbol.for', ':test is Symbol.for("test")', true

code 'symbol bang suffix', ':save!', 'Symbol.for("save!")'
code 'symbol question suffix', ':valid?', 'Symbol.for("valid?")'
code 'symbol dotted with suffix', ':a.b!', 'Symbol.for("a.b!")'
code 'symbol hyphenated with suffix', ':foo-bar?', 'Symbol.for("foo-bar?")'

test 'suffixed symbol description', '(:string!).description', 'string!'
test 'suffixed symbol identity', 'x = :done!; x is Symbol.for("done!")', true
test 'suffixed symbols as arguments', '''
  f = (a, b) -> a.description + "," + b.description
  f :save!, :load?
''', 'save!,load?'
test 'suffixed symbols in an array', '[:a!, :b?].map((s) -> s.description).join(",")', 'a!,b?'
test 'suffixed symbol as object value', '{status: :active!}.status is :active!', true
test 'suffixed symbols in ternary branches', '(true ? :yes! : :no?).description', 'yes!'
test 'suffixed symbol in switch when', '''
  x = :red!
  switch x
    when :red! then "stop"
    else "go"
''', 'stop'

# The suffix claims only at a clear boundary — an operator-starting
# character after `!`/`?` keeps its established reading.
test 'spaced != after symbol stays comparison', ':a != :b', true
test 'tight != after symbol stays comparison', ':a!=:b', true
test 'tight ?? after symbol stays coalesce', '(:a??:b).description', 'a'
test 'tight ?. after symbol stays optional chain', ':a?.description', 'a'
test 'tight key colon stays a pair', 'b = 7\no = {a:b}\no.a', 7
test 'spaced pair colon stays a pair', 'o = {a : 5}\no.a', 5
test 'ternary else-colon never mints', 'c = 1\nd = 2\ne = 3\nc ? d :e', 2
