# Test: Symbol literals — `:name` is Symbol.for("name"): interned,
# identity-comparable. A SPACED colon tight to a word is a symbol; a
# tight key colon ({a:b}), a spaced pair ({a : b}), and a pending
# ternary's else-colon all keep their structural readings. One trailing
# `!`/`?` joins the name (`:save!`, `:valid?`) — claimed only at a clear
# boundary, so `:a!=b`, `:a??b`, and `:a?.b` keep their operator readings.

import { test, code, fail, type } from '../support/testing.js'

code 'symbol literal', ':redo', 'Symbol.for("redo")'
code 'symbol literal skip', ':skip', 'Symbol.for("skip")'
code 'symbol literal with underscore', ':foo_bar', 'Symbol.for("foo_bar")'
code 'symbol literal with digits', ':item2', 'Symbol.for("item2")'
code 'symbol literal dollar', ':$special', 'Symbol.for("$special")'
code 'symbol literal dotted namespace', ':rip.server.session', 'Symbol.for("rip.server.session")'
code 'symbol literal dotted', ':foo.bar', 'Symbol.for("foo.bar")'
code 'symbol literal hyphenated', ':foo-bar', 'Symbol.for("foo-bar")'
code 'symbol literal compound namespace', ':one.two.three-four.five', 'Symbol.for("one.two.three-four.five")'

test 'symbol typeof', 'typeof :redo', 'symbol'
test 'symbol identity', ':redo is :redo', true
test 'symbol inequality', ':redo isnt :skip', true
test 'symbol description', '(:hello).description', 'hello'
test 'symbol assignment', 'x = :done; typeof x', 'symbol'
test 'symbol readonly', 'x =! :frozen; x is :frozen', true
test 'symbol in array', 'arr = [:a, :b, :c]; arr.length', 3
test 'symbol array identity', 'arr = [:x]; arr[0] is :x', true
test 'symbol as object value', 'obj = {status: :active}; obj.status is :active', true
test 'symbol in object literal', 'obj = {a: :one, b: :two}; obj.a is :one and obj.b is :two', true

test 'symbol as argument', '''
  fn = (x) -> x is :yes
  fn(:yes)
''', true

test 'symbol multiple args', '''
  fn = (a, b) -> a is :x and b is :y
  fn(:x, :y)
''', true

test 'symbol equality', ':abc is :abc', true

test 'symbol with switch', '''
  x = :red
  switch x
    when :red then "stop"
    when :green then "go"
    else "unknown"
''', 'stop'

test 'ternary with spaces', 'true ? :yes : :no'
test 'object with symbol value', '{key: :val}.key is :val', true

test 'symbols are interned across expressions', '''
  a = :hello
  b = :hello
  a is b
''', true

test 'symbol matches Symbol.for', ':test is Symbol.for("test")', true

code 'symbol bang suffix', ':save!', 'Symbol.for("save!")'
code 'symbol question suffix', ':valid?', 'Symbol.for("valid?")'
code 'symbol dotted with suffix', ':a.b!', 'Symbol.for("a.b!")'
code 'symbol hyphenated with suffix', ':foo-bar?', 'Symbol.for("foo-bar?")'

test 'suffixed symbol description', '(:string!).description', 'string!'
test 'suffixed symbol identity', 'x = :done!; x is Symbol.for("done!")', true
test 'suffixed symbols as arguments', '''
  f = (a, b) -> a.description + "," + b.description
  f :save!, :load?
''', 'save!,load?'
test 'suffixed symbols in an array', '[:a!, :b?].map((s) -> s.description).join(",")', 'a!,b?'
test 'suffixed symbol as object value', '{status: :active!}.status is :active!', true
test 'suffixed symbols in ternary branches', '(true ? :yes! : :no?).description', 'yes!'
test 'suffixed symbol in switch when', '''
  x = :red!
  switch x
    when :red! then "stop"
    else "go"
''', 'stop'

# The suffix claims only at a clear boundary — an operator-starting
# character after `!`/`?` keeps its established reading.
test 'spaced != after symbol stays comparison', ':a != :b', true
test 'tight != after symbol stays comparison', ':a!=:b', true
test 'tight ?? after symbol stays coalesce', '(:a??:b).description', 'a'
test 'tight ?. after symbol stays optional chain', ':a?.description', 'a'
test 'tight key colon stays a pair', 'b = 7\no = {a:b}\no.a', 7
test 'spaced pair colon stays a pair', 'o = {a : 5}\no.a', 5
test 'ternary else-colon never mints', 'c = 1\nd = 2\ne = 3\nc ? d :e', 2

# ==============================================================================
# A symbol literal as a KEY is a computed key — in a class body
# (`:sym: -> …` is a `[Symbol.for("sym")]` method) and in an object
# literal alike. A bound (`=>`) method needs a name to bind by.
# ==============================================================================

code 'a symbol key in a class body is a computed method', 'class A\n  :sym: -> 1', '''
  class A {
    [Symbol.for("sym")]() {
      return 1;
    }
  }
  '''
test 'a symbol-keyed method is callable', 'class A\n  :greet: -> "hi"\nA.new()[Symbol.for("greet")]()', 'hi'
code 'a symbol key in an object literal', 'o = { :sym: 1 }', 'let o = {[Symbol.for("sym")]: 1};'
test 'a symbol-keyed property reads back', 'o = { :k: 5 }\no[:k]', 5
fail 'a bound symbol-keyed method rejects', 'class A\n  constructor: ->\n  :sym: => 1', 'symbol-keyed method cannot be bound'
fail 'a symbol name stops at a hyphen before a digit', 'x = :a-1', 'Cannot convert a symbol'

# ==============================================================================
# A spaced symbol after ANY callable head is a call argument, as it is
# after a name (`f :z`): a member, an `@` member, an index, a call
# result, a dammit or an existence check. A tight colon keys, a spaced
# colon with a spaced value pairs, a pending ternary keeps its
# else-colon, and a spaced colon after a parameter list's close is its
# return type.
# ==============================================================================

code 'a member before a spaced symbol calls', 'x.y :z', 'x.y(Symbol.for("z"));'
code 'a member call assigns', 'o = x.y :z', 'let o = x.y(Symbol.for("z"));'
code 'a member call in a function body', 'g = -> x.y :z', '''
  let g = function() {
    return x.y(Symbol.for("z"));
  };
  '''
code 'a member call takes more arguments', 'g = -> x.y :z, 1', '''
  let g = function() {
    return x.y(Symbol.for("z"), 1);
  };
  '''
code 'an @ member call in a function body', 'g = -> @y :z', '''
  let g = function() {
    return this.y(Symbol.for("z"));
  };
  '''
code 'an index call in a function body', 'g = -> x[0] :z', '''
  let g = function() {
    return x[0](Symbol.for("z"));
  };
  '''
code 'an @ member before a spaced symbol calls', '@y :z', 'this.y(Symbol.for("z"));'
code 'an index before a spaced symbol calls', 'x[0] :z', 'x[0](Symbol.for("z"));'
code 'a call result before a spaced symbol calls', 'f() :z', 'f()(Symbol.for("z"));'
code 'a dammit member before a spaced symbol calls', 'x.y! :z', 'await x.y(Symbol.for("z"));'
code 'an existence member before a spaced symbol calls optionally', 'x.y? :z', 'x.y?.(Symbol.for("z"));'
code 'an optional-chain member before a spaced symbol calls', 'x?.y :z', 'x?.y(Symbol.for("z"));'
code 'a member call under postfix if', 'x.y :z if c', 'if (c) x.y(Symbol.for("z"));'
code 'a member call as an argument', 'f x.y :z', 'f(x.y(Symbol.for("z")));'
code 'a member call with two symbols', 'x.y :z, :w', 'x.y(Symbol.for("z"), Symbol.for("w"));'
code 'a member call inside a ternary branch group', 'c ? (x.y :z) : w', '(c ? x.y(Symbol.for("z")) : w);'
test 'a member call passes the symbol', 'x = {y: (s) -> s.description}\nx.y :hello', 'hello'
test 'an index call passes the symbol', 'x = [(s) -> s.description]\nx[0] :hi', 'hi'
test 'an @ member call passes the symbol', 'class A\n  y: (s) -> s.description\n  run: -> @y :ok\nA.new().run()', 'ok'

code 'a bare key still pairs', 'x: z', '({x: z});'
code 'a quoted dotted key still pairs', '"x.y": z', '({"x.y": z});'
code 'a dotted key still pairs', 'x.y: z', '({"x.y": z});'
code 'a tight dotted key still pairs', 'x.y:z', '({"x.y": z});'
code 'a spaced dotted pair still pairs', 'x.y : z', '({"x.y": z});'
code 'a class-body @ key is an annotated static field', 'class A\n  @y: z', '''
  class A {
    static y;
  }
  '''
code 'a ternary keeps the else-colon after a member', 'c ? x.y :z', '(c ? x.y : z);'
code 'a ternary keeps the else-colon after an @ member', 'c ? @y :z', '(c ? this.y : z);'
code 'a ternary keeps the else-colon after an index', 'c ? x[0] :z', '(c ? x[0] : z);'
code 'a ternary keeps the else-colon after a call', 'c ? f() :z', '(c ? f() : z);'
code 'a spaced return type after an arrow\'s params stays a type', 'f = (a) :number -> a', '''
  let f = function(a) {
    return a;
  };
  '''
code 'a spaced return type after empty params stays a type', 'f = () :void -> 1', '''
  let f = function() {
    return 1;
  };
  '''
code 'a spaced return type after a def\'s params stays a type', 'def f(a) :string\n  a', '''
  function f(a) {
    return a;
  }
  '''
code 'a spaced return type after a void def\'s params stays a type', 'def f!(a) :string\n  a', '''
  function f(a) {
    a;
    return;
  }
  '''
code 'a spaced return type after a static def\'s params stays a type', 'class A\n  def @f(a) :string\n    a', '''
  class A {
    static f(a) {
      return a;
    }
  }
  '''
code 'a spaced return type after a bound arrow\'s params stays a type', 'f = (a) :number => a', 'let f = a => a;'
code 'a spaced return type after def params holding a call stays a type', 'def f(a = g(1)) :string\n  a', '''
  function f(a = g(1)) {
    return a;
  }
  '''
fail 'a spaced annotation on a class-body @ field rejects as on a plain field', 'class A\n  @y :string', 'unsupported class member'
fail 'a spaced annotation on an @ param rejects as on a plain param', 'class A\n  constructor: (@a :string) ->', "Unexpected implicit '('"
