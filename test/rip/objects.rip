# Test: Implicit objects — the trailing-comma continuation.
#
# A trailing comma before an indented line CONTINUES the property list.
# CoffeeScript reads those indented pairs as a SECOND argument
# (`f({x: 1, y: 2}, {z: 3})`), so for the single-options-object call this
# form is almost always written as, the continuation line is discarded at
# run time — no error anywhere, just missing fields. Rip continues the
# object instead: nobody writes a trailing comma meaning "and now a
# separate object", and braces say that unambiguously when they do.
#
# The rule is narrow on purpose — it fires only when a property list is
# already open AT the comma. The forms that merely look similar are
# pinned here next to it, because keeping them apart is the whole job.

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# The continuation
# ==============================================================================

code 'trailing comma continues the object', '''
  f x: 1, y: 2,
    z: 3
''', 'f({x: 1, y: 2, z: 3});'

code 'the continuation line may carry several pairs', '''
  f x: 1, y: 2,
    z: 3, w: 4
''', 'f({x: 1, y: 2, z: 3, w: 4});'

code 'and may run for several lines', '''
  f x: 1,
    y: 2
    z: 3
''', 'f({x: 1, y: 2, z: 3});'

code 'inside explicit call parens too', '''
  f(x: 1,
    y: 2)
''', 'f({x: 1, y: 2});'

# ==============================================================================
# Continuations chain
# ==============================================================================
#
# A continuation line may itself end in a trailing comma, so the INDENT
# it pushes has to be transparent to the property list underneath. These
# used to compile to a fresh object per indent level — three objects for
# the second row, two of them silently dropped at the call.

code 'a continuation ending in a comma continues again', '''
  f a: 1,
    b: 2,
    c: 3
''', 'f({a: 1, b: 2, c: 3});'

code 'even when each continuation indents further', '''
  f a: 1,
    b: 2,
      c: 3
''', 'f({a: 1, b: 2, c: 3});'

# ==============================================================================
# What the rule must NOT swallow
# ==============================================================================

code 'no property list open at the comma — a fresh argument', '''
  f 9,
    a: 1
    b: 2
''', 'f(9, {a: 1, b: 2});'

code 'a plain multi-line argument list is untouched', '''
  f 1,
    2
''', 'f(1, 2);'

code 'a non-objectish continuation is still a separate argument', '''
  f a: 1,
    9
''', 'f({a: 1}, 9);'

code "an indent after ':' is still the pair's value", '''
  f a:
    b: 1
''', 'f({a: {b: 1}});'

code "a call in the pair's value still owns the comma", '''
  f a: 1, b: g 2,
    c: 3
''', 'f({a: 1, b: g(2, {c: 3})});'

# ==============================================================================
# Runtime — the fields actually arrive
# ==============================================================================
#
# The defect was never visible in the compiled shape alone; it was a
# one-parameter function quietly ignoring a second argument. These run.

test 'every key reaches a single-options-object call', '''
  f = (o) -> o
  f a: 1, b: 2,
    c: 3
    d: 4
''', { a: 1, b: 2, c: 3, d: 4 }

test 'the second parameter really is left unbound', '''
  f = (o, rest) -> [o, rest?]
  f a: 1,
    b: 2
''', [{ a: 1, b: 2 }, false]

# `a = 1` inside an object LITERAL is a destructuring default; only a
# pattern can carry one (`{a = 1} = o`), so the literal rejects instead
# of emitting `({a = 1})`.
fail 'a default inside an object literal rejects', '{a = 1}', 'destructuring default'
fail 'a default inside a value-position object literal rejects', 'o = {a = 1}', 'destructuring default'

# ==============================================================================
# A spread after a comma stays IN an implicit object (`f a, x: 1,
# ...opts, y: 2` is one options object, as the braced form reads) —
# on the same line, after a newline, and under a continuation indent.
# ==============================================================================

code 'a spread continues an implicit object argument', 'f a, x: 1, ...opts, y: 2', 'f(a, {x: 1, ...opts, y: 2});'
code 'a spread continues an implicit object at the end', 'f x: 1, ...opts', 'f({x: 1, ...opts});'
code 'a spread continues a multi-line implicit object', 'f a,\n  x: 1\n  ...opts\n  y: 2', 'f(a, {x: 1, ...opts, y: 2});'
code 'a spread continues a trailing-comma continuation', 'f x: 1,\n  ...opts', 'f({x: 1, ...opts});'
code 'a plain element after the spread ends the object', 'f x: 1, ...opts, 3', 'f({x: 1, ...opts}, 3);'
test 'an implicit object with a spread merges at run time', 'opts = {b: 2}\nf = (o) -> o\nf a: 1, ...opts, c: 3', {a: 1, b: 2, c: 3}
code 'a spread in an array nested in a call is an element', 'f([a: 1, ...rest])', 'f([{a: 1}, ...rest]);'
code 'plain parens keep the spread in the object', 'z = (a: 1, ...b)', 'let z = {a: 1, ...b};'
code 'an implicit call inside a bracket list keeps its spread', '[1, g a, x: 1, ...opts]', '[1, g(a, {x: 1, ...opts})];'

code 'a spread inside an array is the next element, not an object continuation', '[x: 1, ...opts, y: 2]', '[{x: 1}, ...opts, {y: 2}];'
code 'a spread inside call parens is the next argument', 'f(a: 1, ...rest)', 'f({a: 1}, ...rest);'
code 'a spread after an implicit-call object continues it', 'f a, x: 1, ...opts, y: 2', 'f(a, {x: 1, ...opts, y: 2});'

# ==============================================================================
# Where an implicit object ends — the boundary pins
# ==============================================================================
#
# A same-line object closes at a postfix guard, so the guard governs the
# whole statement; a line break (a TERMINATOR or a dedent) un-samelines
# it, so a later guard binds the pair's value instead. Brackets keep the
# object same-line however many lines they span.

test 'a closer before a guard leaves the guard on the statement', '''
  c = false
  x = 0
  x = a: (1) if c
  x
''', 0

test 'a bracket block keeps the object same-line for its guard', '''
  c = false
  x = 0
  x = a: [
    1
  ] if c
  x
''', 0

test 'a multi-line bracket block keeps the object same-line for its guard', '''
  c = false
  x = 0
  x = a: [
    1
    2
  ] if c
  x
''', 0

test 'after a dedent a guard binds the next pair, not the statement', '''
  c = false
  x = a: ->
    1
  , b: 2 if c
  [x.a(), Object.keys(x), x.b?]
''', [1, ['a', 'b'], false]

test 'a guard inside a multi-line object binds its own pair', '''
  c = false
  x =
    a: [1] if c
    b: 2
  [Object.keys(x), x.a?, x.b]
''', [['a', 'b'], false, 2]

test 'a key that opens a call is not line-starting, so its guard is the statement', '''
  calls = 0
  f = (o) -> calls += 1
  c = false
  g = ->
    f a: 1 if c
    x: 1
  [g(), calls]
''', [{x: 1}, 0]

test 'a block inside a ternary branch keeps its own colon depth', '''
  c = true
  g = (f, o) -> f() + o.a
  x = c ? g(->
    1
  , a: 1) : 3
  x
''', 2

test 'a line-starting optional chain closes the object it follows', '''
  b = 7
  x = a: b
  ?.a
  x
''', 7

test 'a bodiless class value ends with its line', '''
  x = a: class
  y = 2
  [typeof x.a, y]
''', ['function', 2]

test 'a comma then a newline continues the property list', '''
  f = (...xs) -> xs
  f a: 1,
  b: 2
''', [{a: 1, b: 2}]

test 'a non-objectish element after a dedented comma ends the object', '''
  f = (...xs) -> xs.length
  f a: ->
    1
  , 3
''', 2

test 'a trailing comma before a dedent closes the object after the comma', '''
  x =
    a: 1,
  y = 2
  [x, y]
''', [{a: 1}, 2]

test 'a trailing comma inside an indented array closes the object', '''
  x = [
    a: 1,
  ]
  x
''', [{a: 1}]

# ==============================================================================
# What reads as the next pair — the objectish look-ahead
# ==============================================================================
#
# A line break or comma keeps a property list open only when what follows
# reads as a pair: `key:`, `@key:`, a void-method key, a `private` member,
# or a balanced bracket group followed by `:` (an interpolated or computed
# key).

test 'an interpolated key on the next line continues the object', '''
  k = 'b'
  x =
    a: 1
    "#{k}": 2
  x
''', {a: 1, b: 2}

test 'a computed key on the next line continues the object', '''
  k = 'b'
  x =
    a: 1
    [k]: 2
  x
''', {a: 1, b: 2}

test 'a static void-method key after a comma continues the class body', '''
  class A
    x: (-> 1), @b!: (-> 2)
  [(new A).x(), A.b()]
''', [1, undefined]

fail 'a guard before a private member line binds the pair value', 'class A\n  x: (-> 1) if c\n  private y: -> 2', 'a class field takes'

test 'a guard on a bare object before a final semicolon guards the statement', 'c = true\na: 1 if c;', {a: 1}

test 'a trailing comma at the end of the program closes the argument object', 'f = (...a) -> a\nf a: 1,', [{a: 1}]
