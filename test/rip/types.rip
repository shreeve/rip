test 'an implicit call whose argument assigns is not a type alias', '''
  r = []
  push = (v) -> r.push v
  push x = 5
  r
''', [5]

test 'a function named type called mid-expression is not an alias', '''
  type = (v) -> v * 2
  wrap = (v) -> v + 1
  wrap type x = 5
''', 11

test 'as before an operator that starts no type stays a name', '''
  as = 3
  f = (v) -> v + 1
  f as * 2
''', 7

test 'a cast before a closing paren on the next line', '''
  x = 1
  r = (x as number
  )
  r
''', 1

test 'a cast before an interpolation close on the next line', '''
  x = 1
  "#{x as number
  }"
''', "1"

fail 'a second generic group after a def name stays a comparison', "def f<T><U>(x)\n  x", "Unexpected '<' —"
fail 'a generic group after a non-name in a def head stays a comparison', "def f x<T>(y)\n  y", "Unexpected '<' —"
fail 'a generic list on a property target is no component target', "obj = {}\nobj.Sel<T> = component\n  render\n    div", ":2:12: Unexpected '='"

test 'an unspaced comparison chain into a component is no generic list', '''
