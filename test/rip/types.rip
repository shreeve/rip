# ==============================================================================
# Block Unions — Various Forms
# ==============================================================================

code "block union three members", '''
  type Light =
    | "red"
    | "yellow"
    | "green"
  ''', ""

code "block union many members", '''
  type HttpMethod =
    | "GET"
    | "POST"
    | "PUT"
    | "PATCH"
    | "DELETE"
  ''', ""

# ==============================================================================
# Edge Cases
# ==============================================================================

# Type annotation with no assignment (in a function body)

test "typed param used in expression", '''
  def negate(x: number): number
    -x
  negate(5)
  ''', -5

# Enum with single member

test "enum single member", '''
  enum Single
    only = 1
  Single.only
  ''', 1

# Type alias then immediate use

test "type alias immediate code", '''
  type ID = number
  id = 123
  id
  ''', 123

# Sequential enums

test "multiple enums", '''
  enum A
    x = 1
  enum B
    y = 2
  A.x + B.y
  ''', 3

# Typed function calling another typed function

test "typed functions calling each other", '''
  def double(n: number): number
    n * 2
  def quadruple(n: number): number
    double(double(n))
  quadruple(5)
  ''', 20

# Function with many typed params

test "function many typed params", '''
  def sum5(a: number, b: number, c: number, d: number, e: number): number
    a + b + c + d + e
  sum5(1, 2, 3, 4, 5)
  ''', 15

# ==============================================================================
# .d.ts Emission Tests — verify type declarations are emitted correctly
# ==============================================================================

# Variables

type "typed variable dts", "count: number = 0", '''
  declare let count: number;
  export {};
  '''

type "typed constant dts", "MAX: number =! 100", '''
  declare const MAX: number;
  export {};
  '''

# Reactive state

type "reactive state dts", "count: number := 0", '''
  declare const count: { value: number; read(): number; touch(): void };
  export {};
  '''

# Computed

type "computed dts", '''
    count: number := 0
    doubled: number ~= count * 2
  ''', '''
  declare const count: { value: number; read(): number; touch(): void };
  declare const doubled: { readonly value: number; read(): number };
  export {};
  '''

# Effect

type "effect dts", "logger: Function ~> console.log 42", '''
  declare const logger: Function;
  export {};
  '''

# Functions

type "typed function dts", '''
    def greet(name: string): string
      "Hello, #{name}!"
  ''', '''
  declare function greet(name: string): string;
  export {};
  '''

# Interface

type "interface dts", '''
    interface Readable
      read: => string
  ''', '''
  interface Readable {
    read: => string;
  }
  export {};
  '''

# The polymorphic `this` type rides the declaration verbatim

type "this-typed interface dts", '''
    interface Fluent
      chain(): this
      isFoo(): this is Fluent
  ''', '''
  interface Fluent {
    chain(): this;
    isFoo(): this is Fluent;
  }
  export {};
  '''

# Export reactive

type "export reactive dts", "export count: number := 0", '''
  export declare const count: { value: number; read(): number; touch(): void };
'''

# Arrow function

type "arrow function dts", "greet = (name: string) -> \"Hello\"", '''
  declare function greet(name: string): any;
  export {};
  '''

# Fat-arrow return type — `(params): R => body`. The `=>` is the arrow
# operator, not a TS function-type arrow; the type collector stops at it
# (symmetric with `->`). Type erased from JS, surfaces in the .d.ts.
code "fat arrow return type erased", "g = (x: number): string => \"v\"", "let g = x => \"v\";"

type "fat arrow return type dts", "g = (x: number): string => \"v\"", '''
  declare function g(x: number): string;
  export {};
  '''

# A function-TYPE return must be parenthesized as a whole. Unparenthesized,
# the collector would stop at the inner `=>` and silently re-associate the
# body — so it's a hard error pointing at the fix.
fail "fat arrow bare function-type return", 'g = (x: number): (n: number) => number => x'
fail "fat arrow empty-params function-type return", 'g = (x: number): () => void => x'
# A cast's type name followed by a pair colon is still the cast's: the
# stray colon rejects, never reading `as`/`satisfies` as a call.
fail "a cast type followed by a pair colon rejects", 'y = x as T: 1', "1:7: Unexpected 'T'"
fail "a satisfies type followed by a pair colon rejects", 'x = a satisfies b: c', "Unexpected 'b'"

type "export interface with : annotations", """
  export interface Config
    host: string
    port: number
  """, """
  export interface Config {
    host: string;
    port: number;
  }
  """

# Rip 3.17 — single-colon contexts B (function-type-valued decl) and D (bare
# typed forward declaration). A (typed destructuring) deliberately keeps `::`.
code "single-colon function-type-valued decl", "get: (p: string) => void = f", "let get = f;"
code "single-colon generic function-type-valued decl", "watchers: Set<(e: string) => void> = x", "let watchers = x;"

code "single-colon bare typed decl (assigned later)", '''
  r: R
  r = fn()
  ''', "let r = fn();"

# `name: value` with no later assignment stays an object expression (not a decl).
code "bare name: value stays an object", "mode: cfg", "({mode: cfg});"

# Rip 3.17 — single-line braced structural type literal with an inline
# function-type field. The function-type's `(e: Event)` params are PARAM-tagged
# because `=>` follows; inside a `{ … }` on a `type X =` RHS they must NOT be
# reclassified — a synthetic `::` landing inside the literal threw a spurious
# "structural type literal" error. Arming `inType` across the type-decl RHS
# leaves them as TS `:` separators. Completes commit 899becf5's type-context
# guard (the indented `type T =` ⏎ field form was already immune).
code "braced inline fn-type field erased", "type X = { f: (e: Event) => void }", ""
code "braced optional fn-type field in intersection erased", "type X = HTMLElement & { f?: (e: Event) => void }", ""

type "braced inline fn-type field dts", "type X = { f: (e: Event) => void }", '''
  type X = { f: (e: Event) => void };
  export {};
  '''

# Non-regression: a value-position `=` is not a type-decl `=`, so object
# literals (incl. ones with arrow values) are untouched — `inType` stays off.
code "value object literal not armed", "x = { a: 1 }", "let x = {a: 1};"

code "arrow-valued object literal not armed", "obj = { f: (e) -> e }", '''
  let obj = {f(e) {
    return e;
  }};
  '''

# A block body inside explicit brackets is a statement block like any
# other: each row compiles to the bytes of its unbracketed twin.
code "typed local in a braced object's method", '''
  o = {
    fetch: ->
      sent: number = 1
      sent
  }
  ''', '''
  let o = {fetch() {
    let sent = 1;
    return sent;
  }};
  '''

code "typed local in a braced call argument's method", '''
  server = make({
    fetch: ->
      sent: number = 1
      sent
  })
  ''', '''
  let server = make({fetch() {
    let sent = 1;
    return sent;
  }});
  '''

code "typed local in a parenthesized callback", '''
  xs.forEach((x) ->
    y: number = x
    log y
  )
  ''', '''
  xs.forEach(function(x) {
    let y = x;
    return log(y);
  });
  '''

code "typed local in an arrow inside an array", '''
  fs = [
    ->
      y: number = 1
      y
  ]
  ''', '''
  let fs = [(function() {
    let y = 1;
    return y;
  })];
  '''

code "typed local in a parameter default's body", '''
  f = (cb = ->
    y: number = 1
    y
  ) -> cb()
  ''', '''
  let f = function(cb = function() {
    let y = 1;
    return y;
  }) {
    return cb();
  };
  '''

code "typed forward in a braced object's method", '''
  o = {
    f: ->
      r: number
      r = 2
      r
  }
  ''', '''
  let o = {f() {
    let r = 2;
    return r;
  }};
  '''

code "typed catch binding in a braced object's method", '''
  o = {
    f: ->
      try
        g()
      catch e: any
        e
  }
  ''', '''
  let o = {f() {
    try {
      return g();
    } catch (e) {
      return e;
    }
  }};
  '''

code "type alias in a braced object's method", '''
  o = {
    f: ->
      type T = number
      y: T = 1
      y
  }
  ''', '''
  let o = {f() {
    let y = 1;
    return y;
  }};
  '''

code "typed field in a class inside a braced object", '''
  o = {
    K: class
      x: number = 1
  }
  ''', '''
  let o = {K: class {
    x = 1;
  }};
  '''

code "typed reactive local in a braced object's method", '''
  o = {
    f: ->
      c: number := 0
      c
  }
  ''', '''
  let o = {f() {
    const c = __state(0);
    return c.value;
  }};
  '''

code "typed local in a parenthesized if body", '''
  x = (if c
    r: number = 1
    r
  )
  ''', '''
  let r;

  let x = (() => { if (c) {
    r = 1;
    return r;
  } })();
  '''

code "pairs in a braced object's method stay pairs", '''
  o = {
    f: ->
      g({a: 1})
      {b: 2}
  }
  ''', '''
  let o = {f() {
    g({a: 1});
    return {b: 2};
  }};
  '''

fail "a partial-evidence sibling run in a braced call argument's method rejects", '''
  h({
    f: ->
      a: 1
      b: number
      b = 2
      b
  })
  ''', "'a' is never assigned in this block"

# ==============================================================================
# Declaration pins — the type verb compares emitted .d.ts (module marker shed)
# ==============================================================================

type 'generic function dts', '''
  def add<T>(a: T, b: T): T
    a + b
''', 'declare function add<T>(a: T, b: T): T;'

type 'generic constraint dts', '''
  def identity<T extends object>(v: T): T
    v
''', 'declare function identity<T extends object>(v: T): T;'

type 'generic void function dts', '''
  export def run!<C>(x: C): Promise<void>
    null
''', 'export declare function run<C>(x: C): Promise<void>;'

type 'generic void methods dts', '''
  class A
    def m!<T>(x: T)
      log x
    def @n!<T>(x: T): void
      log x
''', '''
  declare class A {
    m<T>(x: T): void;
    static n<T>(x: T): void;
  }
'''

fail "'void' in value position stays reserved", 'x = void 0', "'void' is reserved and not supported yet"

type 'typed promoted parameter declares its class field', '''
  class Api
    constructor: (@url: string) ->
  ''', '''
  declare class Api {
    url: string;
    constructor(url: string);
  }
  '''

type 'type alias dts', '''
  type User =
    id: number
    name: string
    email?: string
''', '''
  type User = {
    id: number;
    name: string;
    email?: string;
  };
'''

type 'interface with : annotations', '''
  interface User
    id: number
    name: string
    email: string
    isAdmin?: boolean
''', '''
  interface User {
    id: number;
    name: string;
    email: string;
    isAdmin?: boolean;
  }
'''

type 'class with methods dts', '''
  class UserService
    url: string = ""
    constructor: (@url: string) ->
    fetch: (id: number) ->
      console.log id
''', '''
  declare class UserService {
    url: string;
    constructor(url: string);
    fetch(id: number): any;
  }
'''

# ==============================================================================
# Void slot — `?:` reaches inside the reactive container where absence
# can live: no default, or a default that is `undefined`. A real default
# fills the slot, so inside it stays `T`.
# ==============================================================================
type 'void slot: optionality reaches inside the container only where absence can live', '''
  export Panel = component
    label?: string := undefined
    variant?: string := 'primary'
    @title?: string
    render null
  ''', '''
  /// <reference lib="dom" />
  export interface Panel {
    label: { value: string | undefined; read(): string | undefined; touch(): void };
    variant: { value: string; read(): string; touch(): void };
    title: { value: string | undefined; read(): string | undefined; touch?(): void };
    stash?: any;
    router?: any;
    params?: any;
    query?: any;
    children?: globalThis.Node | string | number | boolean | null;
    __offers?: {};
    __host?: {};
    mount(target?: globalThis.Node | string): Panel;
    unmount(options?: { removeDOM?: boolean }): void;
  }
  export declare let Panel: {
    new (props?: { title?: string | { value: string | undefined; read(): string | undefined; touch?(): void }; __bind_title__?: { value: string | undefined; read(): string | undefined; touch?(): void }; children?: globalThis.Node | string | number | boolean | null }): Panel;
    mount(target?: globalThis.Node | string): Panel;
  };
  '''

type 'callback prop: a bare function type in the head groups wherever the face unions it', '''
  export Picker = component
    @onPick?: (label: string) => void
    @onDone: () => void
    fire = ->
      onPick? "x"
      onDone()
    render null
  ''', '''
  /// <reference lib="dom" />
  export interface Picker {
    onPick: { value: ((label: string) => void) | undefined; read(): ((label: string) => void) | undefined; touch?(): void };
    onDone: { value: () => void; read(): () => void; touch?(): void };
    fire(): any;
    stash?: any;
    router?: any;
    params?: any;
    query?: any;
    children?: globalThis.Node | string | number | boolean | null;
    __offers?: {};
    __host?: {};
    mount(target?: globalThis.Node | string): Picker;
    unmount(options?: { removeDOM?: boolean }): void;
  }
  export declare let Picker: {
    new (props: { onPick?: ((label: string) => void) | { value: ((label: string) => void) | undefined; read(): ((label: string) => void) | undefined; touch?(): void }; __bind_onPick__?: { value: ((label: string) => void) | undefined; read(): ((label: string) => void) | undefined; touch?(): void }; onDone?: (() => void) | { value: () => void; read(): () => void; touch?(): void }; __bind_onDone__?: { value: () => void; read(): () => void; touch?(): void }; children?: globalThis.Node | string | number | boolean | null } & ({ onDone: (() => void) | { value: () => void; read(): () => void; touch?(): void } } | { __bind_onDone__: { value: () => void; read(): () => void; touch?(): void } })): Picker;
  };
  '''

# ==============================================================================
# Enum auto-numbering — bare members take the next number (0-based,
# continuing after an explicit numeric; a bare member after a STRING
# value rejects)
# ==============================================================================
type 'enum dts', '''
  enum Direction
    North
    South
    East = 10
    West
  ''', '''
  declare enum Direction {
    North = 0,
    South = 1,
    East = 10,
    West = 11
  }
  '''

test 'enum bare members take any identifier', '''
  enum Measure
    größe
    size
  [Measure.größe, Measure.size, Measure[0]]
  ''', [0, 1, 'größe']

test 'enum auto-numbering runtime', '''
  enum Direction
    North
    South
    East = 10
    West
  [Direction.North, Direction.West, Direction[1]]
  ''', [0, 11, 'South']

fail 'bare enum member after a string value rejects', 'enum Mix\n  ok = "fine"\n  broken', 'no number to continue'

test 'generic function runtime', '''
    def identity<T>(value: T): T
      value
    identity(42)
  ''', 42

test 'generic function with string', '''
    def identity<T>(value: T): T
      value
    identity("hello")
  ''', "hello"

test 'generic function with array', '''
    def first<T>(items: T[]): T
      items[0]
    first([10, 20, 30])
  ''', 10

code 'structural type optional prop erased', '''
    type Config =
      host: string
      port: number
      ssl?: boolean
  ''', '''
  
  '''

code 'exported generic close on type alias body line', '''
    export type ApiErrors =
      field?: Record<string, string>
  
    doStuff()
  ''', '''
  doStuff();
  '''

code 'optional property erased', '''
    type Config =
      host: string
      port: number
      ssl?: boolean
      timeout?: number
  ''', '''
  
  '''

# ==============================================================================
# Mutation-audit pins — the rewriteTypes pass
# ==============================================================================

test 'an implicit call whose argument assigns is not a type alias', '''
  r = []
  push = (v) -> r.push v
  push x = 5
  r
''', [5]

test 'a function named type called mid-expression is not an alias', '''
  type = (v) -> v * 2
  wrap = (v) -> v + 1
  wrap type x = 5
''', 11

test 'as before an operator that starts no type stays a name', '''
  as = 3
  f = (v) -> v + 1
  f as * 2
''', 7

test 'a cast before a closing paren on the next line', '''
  x = 1
  r = (x as number
  )
  r
''', 1

test 'a cast before an interpolation close on the next line', '''
  x = 1
  "#{x as number
  }"
''', "1"

fail 'a second generic group after a def name stays a comparison', "def f<T><U>(x)\n  x", "Unexpected '<' —"
fail 'a generic group after a non-name in a def head stays a comparison', "def f x<T>(y)\n  y", "Unexpected '<' —"
fail 'a generic list on a property target is no component target', "obj = {}\nobj.Sel<T> = component\n  render\n    div", ":2:12: Unexpected '='"

test 'an unspaced comparison chain into a component is no generic list', '''
  a = 1
  b = 2
  r = a<b>(component
    render
      div)
  r
''', false

test 'a parenthesized generic constraint keeps the def parameter list', '''
  def f<T extends (() => number)>(x: T)
    x()
  f(-> 7)
''', 7

fail 'an optional marker after a destructuring parameter rejects', 'f = ({a}?, b) -> b', ":1:9: Unexpected '?'"

test 'a bare optional parameter on its own line', '''
  f = (
    a?
    b
  ) -> b
  f(1, 2)
''', 2

fail 'a doubled colon after a parameterless def name rejects', "def f: : number\n  1", "type annotations use a single ':'"
fail 'a doubled colon after a catch binding rejects', "try\n  g()\ncatch e: : any\n  e", "type annotations use a single ':'"
fail 'a doubled colon after a typed prototype member rejects', 'String::foo: : number = 1', "type annotations use a single ':'"
fail 'an annotated catch binding named for a value word rejects', "try\n  x()\ncatch yes: any\n  1", "'yes' cannot name a binding"
fail 'an annotated array-pattern loop variable rejects', "for [a, b]: number in xs\n  a", 'a loop variable does not take a type annotation'

test 'a string-keyed parameter is a destructuring rename', '''
  f = ("a": n) -> n
  f({a: 7})
''', 7

fail 'an optional marker after a destructuring pattern takes no annotation', 'f = ({a}?: string) -> a', ":1:9: Unexpected"

test 'a numeric key with an assigned value stays an object', '''
  r = (->
    1: n = 5
  )()
  r[1]
''', 5

fail 'an annotated soak prototype write rejects after a statement', "f\nX?::m: number = 1", 'the soak form cannot carry the annotation'
fail 'a soak prototype write inside an implicit call is no annotation', 'f X?::m: number = 1', "Unexpected implicit '{'"

test 'a prototype chain inside an implicit call is an object key', '''
  f = (o) -> o
  r = f String::m: n = 1
  r["String.prototype.m"]
''', 1

test 'a static class method with a typed parameter returning a name', '''
  class A
    @make: (x: number) => x
  A.make(3)
''', 3

fail 'a class field with a call value rejects', "class A\n  x: f()", "a class field takes '=' for its value"
fail 'a component prop function type with a generic default is no type', "Foo = component\n  @x: () => Bar<T = number>\n  render\n    div", ":2:28: Unexpected 'dedent'"

fail 'class generics after a parent call reject', "mixin = (b) -> b\nclass B\nclass A extends mixin(B)<T>\n  x = 1", 'class generics are not supported'
fail 'class generics after a parent call with arguments reject', "mix = (b, c) -> b\nclass B\nclass A extends mix(B, B)<T>\n  x = 1", 'class generics are not supported'

test 'a bracketed comparison after a bracketed class expression', '''
  x = [class A][0]
  y = [1 < 2][0]
  y
''', true

test 'a class expression compares with !=', '''
  r = class A != null
  r
''', true

fail 'a class then-body does not make the next block a class body', "class A then make: ->\n  x: number\n  y: 1\n  x = 1\n  0", "these adjacent 'name:' lines are ambiguous"

test 'a bodiless class does not make a later block a class body', '''
  class A
  f = ->
    y: 1
  f().y
''', 1

test 'a typed declaration after a bracketed function block', '''
  f = (g) -> g()
  f(->
    1
  )
  x: number = 5
  x
''', 5

test 'a key line two lines up does not block a bare typed forward', '''
  a: 1
  b = 2
  c: number
  c = 3
  c
''', 3

test 'a key line before a block does not block its first bare typed forward', '''
  a: 1
  if true
    c: number
    c = 3
    r = c
  r
''', 3

test 'a key line opening a block does not block bare typed forwards inside it', '''
  r = null
  k: do ->
    z = 1
    c: number
    c = 3
    r = c + z
  r
''', 4

test 'a nested block inside a default body keeps its key lines', '''
  f = (a = ->
    if true
      1
    b: 2
  ) -> a().b
  f()
''', 2

test 'a parameter after an empty arrow default takes its annotation', '''
  f = (a = ->,
    b: number) -> b
  f(undefined, 5)
''', 5

test 'a parameter after a class default takes its annotation', '''
  f = (a = class,
    b: number) -> b
  f(undefined, 5)
''', 5

test 'a colon after a parameter default is an object key', '''
  f = (a = b: 1) -> a.b
  f()
''', 1

test 'a newline after a semicolon ends an inline default body', '''
  f = (a = -> 1 ;
      b: 2
  ) -> b
  f(undefined, 7)
''', 7
