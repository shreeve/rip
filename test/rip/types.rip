# Test: Rip Types
# Tests the optional type system — type annotations, type aliases,
# structural types, interfaces, enums, generics, and .d.ts emission.
#
# Type annotations are erased from .js output. The `types: true` option
# enables .d.ts emission via emitTypes().

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# Type Annotations on Variables — Erased from JS
# ==============================================================================

code "typed variable", "count: number = 0", "let count = 0;"
code "typed string variable", "name: string = \"Rip\"", "let name = \"Rip\";"
code "typed array variable", "ids: number[] = []", "let ids = [];"
code "typed generic variable", "items: Map<string, number> = x", "let items = x;"

# ==============================================================================
# Type Annotations on Constants — Erased from JS
# ==============================================================================

code "typed constant", "MAX: number =! 100", "const MAX = 100"
code "typed string constant", 'URL: string =! "https://example.com"', 'const URL = "https://example.com"'

# ==============================================================================
# Type Annotations on Functions — Erased from JS
# ==============================================================================

code "typed function params", '''
  def add(a: number, b: number)
    a + b
  ''', '''
  function add(a, b) {
    return (a + b);
  }
  '''

code "typed function return", '''
  def greet(name: string): string
    "Hello, #{name}!"
  ''', '''
  function greet(name) {
    return `Hello, ${name}!`;
  }
  '''

code "parameterless typed function", '''
  def answer(): number
    42
  ''', '''
  function answer() {
    return 42;
  }
  '''

code "typed function three params", '''
  def clamp(val: number, min: number, max: number): number
    Math.max(min, Math.min(max, val))
  ''', '''
  function clamp(val, min, max) {
    return Math.max(min, Math.min(max, val));
  }
  '''

# ==============================================================================
# Type-Only Declarations — Erased from JS
# ==============================================================================

# Simple aliases
code "type alias erased", "type ID = number", ""
code "union type alias erased", 'type UserID = number | string', ""

# Structural types

code "structural type erased", '''
  type User =
    id: number
    name: string
  ''', ""

code "generic close in interface body line", '''
  interface ApiErrors
    field: Record<string, string>

  y = 2
  ''', "let y = 2;"

# Block unions

code "block union erased", '''
  type Status =
    | "pending"
    | "active"
    | "done"
  ''', ""

# Interfaces

code "interface erased", '''
  interface Animal
    name: string
    age: number
  ''', ""

code "interface extends erased", '''
  interface Dog extends Animal
    breed: string
  ''', ""

# The polymorphic `this` type — RULED (2026-08-03): `this` is type
# vocabulary. The fluent return and the `this is Foo` predicate subject
# erase like any member.

code "this-typed members erased", '''
  interface Fluent
    chain(): this
    isFoo(): this is Fluent
  ''', ""

# Multiple type declarations in sequence

code "multiple types erased", '''
  type ID = number
  type Name = string
  type Status = "active" | "inactive"
  ''', ""

# Multiple interfaces in sequence

code "multiple interfaces erased", '''
  interface Readable
    read: () => string
  interface Writable
    write: (data: string) => boolean
  ''', ""

# ==============================================================================
# `enum` is reserved — JavaScript reserves it, and a set of values is a
# `type` union, runtime values a plain object
# ==============================================================================

fail "enum declaration rejects at the keyword", "enum Color\n  red = 0\n  green = 1", "types.rip>:1:1: 'enum' is reserved — a set of values is a `type` union (`type Color = 'red' | 'green'`), and runtime values are a plain object"
fail "export enum rejects at the keyword", "export enum X\n  a = 1", "types.rip>:1:8: 'enum' is reserved"
fail "enum as a variable name rejects", "enum = 3", "types.rip>:1:1: 'enum' is reserved"
fail "enum as a read rejects", "x = enum", "types.rip>:1:5: 'enum' is reserved"
fail "enum as a parameter rejects", "f = (enum) -> 1", "types.rip>:1:6: 'enum' is reserved"
test "enum as a property name stays legal", "o = {enum: 1}\no.enum", 1

# ==============================================================================
# Runtime Behavior — Types Don't Affect Execution
# ==============================================================================

test "typed variable runtime", "count: number = 42; count", 42
test "typed constant runtime", 'msg: string =! "hello"; msg', "hello"
test "typed boolean runtime", "flag: boolean = true; flag", true
test "typed null runtime", "val: string = null; val", null

test "typed function runtime", '''
  def double(x: number): number
    x * 2
  double(21)
  ''', 42

test "typed params runtime", '''
  def add(a: number, b: number): number
    a + b
  add(3, 4)
  ''', 7

test "typed function multiple calls", '''
  def square(n: number): number
    n * n
  square(3) + square(4)
  ''', 25

test "typed function with string return", '''
  def shout(msg: string): string
    msg.toUpperCase()
  shout("hello")
  ''', "HELLO"

test "typed function with array return", '''
  def wrap(x: number): number[]
    [x]
  wrap(42)
  ''', [42]

test "typed parameterless runtime", '''
  def pi(): number
    3.14159
  pi()
  ''', 3.14159

# ==============================================================================
# Mixed: Types + Code Coexisting
# ==============================================================================

test "type alias with code", '''
  type ID = number
  x = 42
  x
  ''', 42

test "interface with code", '''
  interface Config
    host: string
    port: number
  x = 99
  x
  ''', 99

test "multiple types then code", '''
  type ID = number
  type Name = string
  interface User
    id: number
    name: string
  x = "works"
  x
  ''', "works"

test "type alias between functions", '''
  def first(): number
    1
  type ID = number
  def second(): number
    2
  first() + second()
  ''', 3

# ==============================================================================
# Complex Type Annotations
# ==============================================================================

# Generic types survive in annotations without affecting JS
code "nested generic annotation", "cache: Map<string, Set<number>> = x", "let cache = x;"

# Multiple typed variables in sequence

test "multiple typed variables", '''
  a: number = 10
  b: number = 20
  c: number = 30
  a + b + c
  ''', 60

# Typed variables used together

test "typed variables in expression", '''
  width: number = 5
  height: number = 10
  width * height
  ''', 50

# Typed constant used in function

test "typed constant in function", '''
  PI: number =! 3.14159
  def circleArea(r: number): number
    PI * r * r
  circleArea(1)
  ''', 3.14159

# ==============================================================================
# Generic Functions — Types Erased from JS
# ==============================================================================

# ==============================================================================
# Structural Types with Optional Properties
# ==============================================================================

# ==============================================================================
# Block Unions — Various Forms
# ==============================================================================

code "block union three members", '''
  type Light =
    | "red"
    | "yellow"
    | "green"
  ''', ""

code "block union many members", '''
  type HttpMethod =
    | "GET"
    | "POST"
    | "PUT"
    | "PATCH"
    | "DELETE"
  ''', ""

# ==============================================================================
# Edge Cases
# ==============================================================================

# Type annotation with no assignment (in a function body)

test "typed param used in expression", '''
  def negate(x: number): number
    -x
  negate(5)
  ''', -5

# Type alias then immediate use

test "type alias immediate code", '''
  type ID = number
  id = 123
  id
  ''', 123

# Typed function calling another typed function

test "typed functions calling each other", '''
  def double(n: number): number
    n * 2
  def quadruple(n: number): number
    double(double(n))
  quadruple(5)
  ''', 20

# Function with many typed params

test "function many typed params", '''
  def sum5(a: number, b: number, c: number, d: number, e: number): number
    a + b + c + d + e
  sum5(1, 2, 3, 4, 5)
  ''', 15

# ==============================================================================
# .d.ts Emission Tests — verify type declarations are emitted correctly
# ==============================================================================

# Variables

type "typed variable dts", "count: number = 0", '''
  declare let count: number;
  export {};
  '''

type "typed constant dts", "MAX: number =! 100", '''
  declare const MAX: number;
  export {};
  '''

# Reactive state

type "reactive state dts", "count: number := 0", '''
  declare const count: { value: number; read(): number; touch(): void };
  export {};
  '''

# Computed

type "computed dts", '''
    count: number := 0
    doubled: number ~= count * 2
  ''', '''
  declare const count: { value: number; read(): number; touch(): void };
  declare const doubled: { readonly value: number; read(): number };
  export {};
  '''

# Effect

type "effect dts", "logger: Function ~> console.log 42", '''
  declare const logger: Function;
  export {};
  '''

# Functions

type "typed function dts", '''
    def greet(name: string): string
      "Hello, #{name}!"
  ''', '''
  declare function greet(name: string): string;
  export {};
  '''

# Interface

type "interface dts", '''
    interface Readable
      read: => string
  ''', '''
  interface Readable {
    read: => string;
  }
  export {};
  '''

# The polymorphic `this` type rides the declaration verbatim

type "this-typed interface dts", '''
    interface Fluent
      chain(): this
      isFoo(): this is Fluent
  ''', '''
  interface Fluent {
    chain(): this;
    isFoo(): this is Fluent;
  }
  export {};
  '''

# Export reactive

type "export reactive dts", "export count: number := 0", '''
  export declare const count: { value: number; read(): number; touch(): void };
'''

# Arrow function

type "arrow function dts", "greet = (name: string) -> \"Hello\"", '''
  declare function greet(name: string): any;
  export {};
  '''

# Fat-arrow return type — `(params): R => body`. The `=>` is the arrow
# operator, not a TS function-type arrow; the type collector stops at it
# (symmetric with `->`). Type erased from JS, surfaces in the .d.ts.
code "fat arrow return type erased", "g = (x: number): string => \"v\"", "let g = x => \"v\";"

type "fat arrow return type dts", "g = (x: number): string => \"v\"", '''
  declare function g(x: number): string;
  export {};
  '''

# A function-TYPE return must be parenthesized as a whole. Unparenthesized,
# the collector would stop at the inner `=>` and silently re-associate the
# body — so it's a hard error pointing at the fix.
fail "fat arrow bare function-type return", 'g = (x: number): (n: number) => number => x'
fail "fat arrow empty-params function-type return", 'g = (x: number): () => void => x'
# A cast's type name followed by a pair colon is still the cast's: the
# stray colon rejects, never reading `as`/`satisfies` as a call.
fail "a cast type followed by a pair colon rejects", 'y = x as T: 1', "1:7: Unexpected 'T'"
fail "a satisfies type followed by a pair colon rejects", 'x = a satisfies b: c', "Unexpected 'b'"

type "export interface with : annotations", """
  export interface Config
    host: string
    port: number
  """, """
  export interface Config {
    host: string;
    port: number;
  }
  """

# Rip 3.17 — single-colon contexts B (function-type-valued decl) and D (bare
# typed forward declaration). A (typed destructuring) deliberately keeps `::`.
code "single-colon function-type-valued decl", "get: (p: string) => void = f", "let get = f;"
code "single-colon generic function-type-valued decl", "watchers: Set<(e: string) => void> = x", "let watchers = x;"

code "single-colon bare typed decl (assigned later)", '''
  r: R
  r = fn()
  ''', "let r = fn();"

# `name: value` with no later assignment stays an object expression (not a decl).
code "bare name: value stays an object", "mode: cfg", "({mode: cfg});"

# A name a later destructuring pattern binds is assigned later too, so the
# forward claims. A pattern cannot carry an element's annotation, so the
# pattern stays a plain assignment and the hoist line carries the type.
code "a typed forward above an array pattern types the hoisted name", "a: number\n[a, b] = pair", "let a, b;\n\n[a, b] = pair;"
code "a typed forward above an array pattern types the hoisted name (TS face)", "a: number\n[a, b] = pair", "let a!: number, b;\n\n[a, b] = pair;\nexport {};", { face: 'ts' }
code "a typed forward above an object pattern types the hoisted name", "x = 0\nb: string\n{k: b, c} = o", "let b, c;\n\nlet x = 0;\n({k: b, c} = o);"
code "a typed forward above an object pattern types the hoisted name (TS face)", "x = 0\nb: string\n{k: b, c} = o", "let b!: string, c;\n\nlet x = 0;\n({k: b, c} = o);\nexport {};", { face: 'ts' }
code "a typed forward above a pattern in a function body types the hoisted name", "f = ->\n  a: number\n  [a, b] = pair\n  a", "let f = function() {\n  let a, b;\n  [a, b] = pair;\n  return a;\n};"
code "a typed forward above a pattern in a function body types the hoisted name (TS face)", "f = ->\n  a: number\n  [a, b] = pair\n  a", "let f = function() {\n  let a!: number, b;\n  [a, b] = pair;\n  return a;\n};\nexport {};", { face: 'ts' }
test "a typed forward above a pattern evaluates the pattern", "f = ->\n  a: number\n  [a, b] = [1, 2]\n  a + b\nf()", 3
test "a typed forward above a hoisted pattern is the hoisted name's type", "g = -> a\na: number\n[a, b] = [1, 2]\n[g(), b]", [1, 2]
code "a typed forward above a multi-line object pattern types the hoisted name (TS face)", "b: string\n{\n  k: b\n  c\n} = o", "let b!: string, c;\n\n({k: b, c} = o);\nexport {};", { face: 'ts' }
code "a typed forward above a computed-key pattern's value types the hoisted name (TS face)", "v: number\n{[k]: v} = o", "let v!: number;\n\n({[k]: v} = o);\nexport {};", { face: 'ts' }
code "a typed forward above a multi-line pattern after a default types the hoisted name (TS face)", "c: number\n{\n  a = 1\n  c\n} = o", "let a, c!: number;\n\n({a = 1, c} = o);\nexport {};", { face: 'ts' }
# An annotation below the pattern is the same annotation in its later
# spelling: the pattern keeps the hoist and the hoist line carries it.
code "an annotated write below a pattern types the hoisted name (TS face)", "{ id, rows } = parse(text)\nrows: Row[] = rows.map(fix)", "let id, rows: Row[];\n\n({id, rows} = parse(text));\nrows = rows.map(fix);\nexport {};", { face: 'ts' }
code "a typed forward below a pattern types the hoisted name (TS face)", "{ id, rows } = parse(text)\nrows: Row[]\nrows = rows.map(fix)", "let id, rows!: Row[];\n\n({id, rows} = parse(text));\nrows = rows.map(fix);\nexport {};", { face: 'ts' }
# A pattern's keys, computed keys and member or index targets bind no name:
# a forward naming one has no later assignment and stays an object.
code "a computed pattern key is no typed forward's assignment", "k: string\n{[k]: v} = o", "({k: string});\nlet {[k]: v} = o;"
code "a pattern's member target is no typed forward's assignment", "a: number\n[a.b, c] = p", "({a: number});\n[a.b, c] = p;"
code "a pattern's index target is no typed forward's assignment", "a: number\n[a[0], c] = p", "({a: number});\n[a[0], c] = p;"
code "a pattern's key is no typed forward's assignment", "k: number\n{k: v} = p", "({k: number});\nlet {k: v} = p;"

# One binding has one type. A second annotation of a name in the same
# scope spells the first one's type, or the program rejects naming both
# annotations and both lines. Identical annotations agree,
# and another function's local of the same name is another binding.
fail "a typed forward and a differently annotated write reject", "a: number\na = 1\na: string = 2", ":3:1: emitter: 'a' is annotated ': string' on line 3 but ': number' on line 1 — one binding has one type; make the annotations agree or drop one"
fail "two different typed forwards reject", "a: number\na: string\na = 1", ":2:1: emitter: 'a' is annotated ': string' on line 2 but ': number' on line 1"
fail "two differently annotated writes in a function reject", "f = ->\n  a: number = 1\n  a: string = 2\n  a", ":3:3: emitter: 'a' is annotated ': string' on line 3 but ': number' on line 2"
fail "a differently annotated write in a nested block rejects", "f = ->\n  a: number\n  if x\n    a: string = 2\n  a = 1", ":4:5: emitter: 'a' is annotated ': string' on line 4 but ': number' on line 2"
fail "a typed forward above a pattern and a differently annotated write reject", "a: number\n[a, b] = p\na: string = 2", ":3:1: emitter: 'a' is annotated ': string' on line 3 but ': number' on line 1"
fail "an annotated state and a differently annotated write reject", "a: number := 1\na: string = 2", ":2:1: emitter: 'a' is annotated ': string' on line 2 but ': number' on line 1"
fail "a parameter and a differently annotated write reject", "f = (a: number) ->\n  a: string = 2", ":2:3: emitter: 'a' is annotated ': string' on line 2 but ': number' on line 1"
code "identical annotations of one binding compile", "a: number\na = 1\na: number = 2", "let a: number = 1;\na = 2;\nexport {};", { face: 'ts' }
code "a parameter and an identically annotated write compile", "f = (a: number) ->\n  a: number = 2", "let f = function(a: number) {\n  return (a = 2);\n};\nexport {};", { face: 'ts' }
code "two functions' locals of one name take their own types", "f = ->\n  a: number = 1\ng = ->\n  a: string = 'x'", "let f = function() {\n  let a: number;\n  return (a = 1);\n};\nlet g = function() {\n  let a: string;\n  return (a = 'x');\n};\nexport {};", { face: 'ts' }

# Rip 3.17 — single-line braced structural type literal with an inline
# function-type field. The function-type's `(e: Event)` params are PARAM-tagged
# because `=>` follows; inside a `{ … }` on a `type X =` RHS they must NOT be
# reclassified — a synthetic `::` landing inside the literal threw a spurious
# "structural type literal" error. Arming `inType` across the type-decl RHS
# leaves them as TS `:` separators. Completes commit 899becf5's type-context
# guard (the indented `type T =` ⏎ field form was already immune).
code "braced inline fn-type field erased", "type X = { f: (e: Event) => void }", ""
code "braced optional fn-type field in intersection erased", "type X = HTMLElement & { f?: (e: Event) => void }", ""

type "braced inline fn-type field dts", "type X = { f: (e: Event) => void }", '''
  type X = { f: (e: Event) => void };
  export {};
  '''

# Non-regression: a value-position `=` is not a type-decl `=`, so object
# literals (incl. ones with arrow values) are untouched — `inType` stays off.
code "value object literal not armed", "x = { a: 1 }", "let x = {a: 1};"

code "arrow-valued object literal not armed", "obj = { f: (e) -> e }", '''
  let obj = {f(e) {
    return e;
  }};
  '''

# A block body inside explicit brackets is a statement block like any
# other: each row compiles to the bytes of its unbracketed twin.
code "typed local in a braced object's method", '''
  o = {
    fetch: ->
      sent: number = 1
      sent
  }
  ''', '''
  let o = {fetch() {
    let sent = 1;
    return sent;
  }};
  '''

code "typed local in a braced call argument's method", '''
  server = make({
    fetch: ->
      sent: number = 1
      sent
  })
  ''', '''
  let server = make({fetch() {
    let sent = 1;
    return sent;
  }});
  '''

code "typed local in a parenthesized callback", '''
  xs.forEach((x) ->
    y: number = x
    log y
  )
  ''', '''
  xs.forEach(function(x) {
    let y = x;
    return log(y);
  });
  '''

code "typed local in an arrow inside an array", '''
  fs = [
    ->
      y: number = 1
      y
  ]
  ''', '''
  let fs = [(function() {
    let y = 1;
    return y;
  })];
  '''

code "typed local in a parameter default's body", '''
  f = (cb = ->
    y: number = 1
    y
  ) -> cb()
  ''', '''
  let f = function(cb = function() {
    let y = 1;
    return y;
  }) {
    return cb();
  };
  '''

code "typed forward in a braced object's method", '''
  o = {
    f: ->
      r: number
      r = 2
      r
  }
  ''', '''
  let o = {f() {
    let r = 2;
    return r;
  }};
  '''

code "typed catch binding in a braced object's method", '''
  o = {
    f: ->
      try
        g()
      catch e: any
        e
  }
  ''', '''
  let o = {f() {
    try {
      return g();
    } catch (e) {
      return e;
    }
  }};
  '''

code "type alias in a braced object's method", '''
  o = {
    f: ->
      type T = number
      y: T = 1
      y
  }
  ''', '''
  let o = {f() {
    let y = 1;
    return y;
  }};
  '''

code "typed field in a class inside a braced object", '''
  o = {
    K: class
      x: number = 1
  }
  ''', '''
  let o = {K: class {
    x = 1;
  }};
  '''

code "typed reactive local in a braced object's method", '''
  o = {
    f: ->
      c: number := 0
      c
  }
  ''', '''
  let o = {f() {
    const c = __state(0);
    return c.value;
  }};
  '''

code "typed local in a parenthesized if body", '''
  x = (if c
    r: number = 1
    r
  )
  ''', '''
  let r;

  let x = (() => { if (c) {
    r = 1;
    return r;
  } })();
  '''

code "pairs in a braced object's method stay pairs", '''
  o = {
    f: ->
      g({a: 1})
      {b: 2}
  }
  ''', '''
  let o = {f() {
    g({a: 1});
    return {b: 2};
  }};
  '''

fail "a partial-evidence sibling run in a braced call argument's method rejects", '''
  h({
    f: ->
      a: 1
      b: number
      b = 2
      b
  })
  ''', "'a' is never assigned in this block"

# ==============================================================================
# Declaration pins — the type verb compares emitted .d.ts (module marker shed)
# ==============================================================================

type 'generic function dts', '''
  def add<T>(a: T, b: T): T
    a + b
''', 'declare function add<T>(a: T, b: T): T;'

type 'generic constraint dts', '''
  def identity<T extends object>(v: T): T
    v
''', 'declare function identity<T extends object>(v: T): T;'

type 'generic void function dts', '''
  export def run!<C>(x: C): Promise<void>
    null
''', 'export declare function run<C>(x: C): Promise<void>;'

type 'generic void methods dts', '''
  class A
    def m!<T>(x: T)
      log x
    def @n!<T>(x: T): void
      log x
''', '''
  declare class A {
    m<T>(x: T): void;
    static n<T>(x: T): void;
  }
'''

fail "'void' in value position stays reserved", 'x = void 0', "'void' is reserved and not supported yet"

type 'typed promoted parameter declares its class field', '''
  class Api
    constructor: (@url: string) ->
  ''', '''
  declare class Api {
    url: string;
    constructor(url: string);
  }
  '''

type 'type alias dts', '''
  type User =
    id: number
    name: string
    email?: string
''', '''
  type User = {
    id: number;
    name: string;
    email?: string;
  };
'''

type 'interface with : annotations', '''
  interface User
    id: number
    name: string
    email: string
    isAdmin?: boolean
''', '''
  interface User {
    id: number;
    name: string;
    email: string;
    isAdmin?: boolean;
  }
'''

type 'class with methods dts', '''
  class UserService
    url: string = ""
    constructor: (@url: string) ->
    fetch: (id: number) ->
      console.log id
''', '''
  declare class UserService {
    url: string;
    constructor(url: string);
    fetch(id: number): any;
  }
'''

# ==============================================================================
# Void slot — `?:` reaches inside the reactive container where absence
# can live: no default, or a default that is `undefined`. A real default
# fills the slot, so inside it stays `T`.
# ==============================================================================
type 'void slot: optionality reaches inside the container only where absence can live', '''
  export Panel = component
    label?: string := undefined
    variant?: string := 'primary'
    @title?: string
    render null
  ''', '''
  /// <reference lib="dom" />
  export interface Panel {
    label: { value: string | undefined; read(): string | undefined; touch(): void };
    variant: { value: string; read(): string; touch(): void };
    title: { value: string | undefined; read(): string | undefined; touch?(): void };
    stash?: any;
    router?: any;
    params?: any;
    query?: any;
    children?: globalThis.Node | string | number | boolean | null;
    __offers?: {};
    __host?: {};
    mount(target?: globalThis.Node | string): Panel;
    unmount(options?: { removeDOM?: boolean }): void;
  }
  export declare let Panel: {
    new (props?: { title?: string | { value: string | undefined; read(): string | undefined; touch?(): void }; __bind_title__?: { value: string | undefined; read(): string | undefined; touch?(): void }; children?: globalThis.Node | string | number | boolean | null }): Panel;
    mount(target?: globalThis.Node | string): Panel;
  };
  '''

type 'callback prop: a bare function type in the head groups wherever the face unions it', '''
  export Picker = component
    @onPick?: (label: string) => void
    @onDone: () => void
    fire = ->
      onPick? "x"
      onDone()
    render null
  ''', '''
  /// <reference lib="dom" />
  export interface Picker {
    onPick: { value: ((label: string) => void) | undefined; read(): ((label: string) => void) | undefined; touch?(): void };
    onDone: { value: () => void; read(): () => void; touch?(): void };
    fire(): any;
    stash?: any;
    router?: any;
    params?: any;
    query?: any;
    children?: globalThis.Node | string | number | boolean | null;
    __offers?: {};
    __host?: {};
    mount(target?: globalThis.Node | string): Picker;
    unmount(options?: { removeDOM?: boolean }): void;
  }
  export declare let Picker: {
    new (props: { onPick?: ((label: string) => void) | { value: ((label: string) => void) | undefined; read(): ((label: string) => void) | undefined; touch?(): void }; __bind_onPick__?: { value: ((label: string) => void) | undefined; read(): ((label: string) => void) | undefined; touch?(): void }; onDone?: (() => void) | { value: () => void; read(): () => void; touch?(): void }; __bind_onDone__?: { value: () => void; read(): () => void; touch?(): void }; children?: globalThis.Node | string | number | boolean | null } & ({ onDone: (() => void) | { value: () => void; read(): () => void; touch?(): void } } | { __bind_onDone__: { value: () => void; read(): () => void; touch?(): void } })): Picker;
  };
  '''

