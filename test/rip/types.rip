test 'a readonly declaration separates bare typed forwards', '''
  a: number
  b: number =! 2
  a = 1
  a + b
''', 3

test 'an effect declaration separates bare typed forwards', '''
  a: number
  b: Function ~> 1
  a = 1
  a
''', 1

test 'a clause after a parenthesized value keeps the run an object', '''
  number = 1
  c = yes
  a: number
  x: (number) if c
  a = 1
  x = 2
  a + x
''', 3

test 'a key line at the end of input stays an object', '''
  number = 1
  y = 1
  x = 0
  a: number
  x: number
''', {a: 1, x: 1}

type 'an assignment inside call arguments is no evidence for a bare forward', "number = 1\nr: number\nf = (x) -> x\nf(\n  r = 5\n)\nr", '''
'''

# The arrow's param list is found by walking back over its return type,
# counting every bracket kind the type can hold.
test "an arrow return type may be an import type", "f = (a): import(\"./m\").T -> a\nf(3)", 3
test "an arrow return type may close two generics with one token", "f = (a): Map<K, Array<V>> -> a\nf(1)", 1
test "an arrow return type may close three generics with one token", "f = (a): A<B<C<D>>> -> a\nf(2)", 2
test "a parenthesized arrow return type before a parenthesized body", "f = (a): (number) -> (a)\nf(4)", 4
fail "an arrow return type with an unparenthesized function type in a union", 'f = (a): T | (x) => U -> a'

# An interface head at a statement boundary opens a type body, where a
# template-literal member type is legal.
test "a generic interface body holds a template-literal type", '''
  interface P<T>
    a: `x${number}`
  1
''', 1
test "an interface after a statement holds a template-literal type", '''
  x = 2
  interface P
    a: `x${number}`
  x
''', 2
test "an interface that extends holds a template-literal type", '''
  interface P extends Q
    a: `x${number}`
  3
''', 3
test "an interface that extends, after a statement, holds a template-literal type", '''
  x = 4
  interface P extends Q
    a: `x${number}`
  x
''', 4
test "a class that extends keeps symbols in its body", '''
  class B
  class A extends B
    m: -> :ok
  A.new().m().description
''', 'ok'
test "a block at an interface body's depth after the interface is code", '''
  interface P
    a: number
  f = ->
    :ok
  f().description
''', 'ok'

test 'a type body closed by its bracket leaves later blocks as values', '''
  run = (fn) -> fn()
  run(->
    type T =
      a: number)
  trim = ->
    if true
      String::trim.call ' a '
  trim()
''', 'a'

test 'an alias line before an else leaves the else body a value', '''
  f = (s) -> s.description
  x = if false
    type T = 'a'
  else
    f :foo
  x
''', 'foo'

# ==============================================================================
# The types entry — one row per type production
# ==============================================================================
# Each annotation's payload parses from the grammar's TypeAnnotation entry
# (grammar.rip); these rows reduce every type production the rest of the
# suite leaves unreached (test/toolchain/grammar-coverage.test.js). Types
# erase, so each compiles to its untyped twin; the trees are pinned by the
# front-end manifest and test/lang/types.test.js.

code "types entry: an asserts predicate with a type", "def f(x: unknown): asserts x is Foo\n  x", "function f(x) {\n  return x;\n}"
code "types entry: an asserts predicate alone", "def f(x: unknown): asserts x\n  x", "function f(x) {\n  return x;\n}"
code "types entry: a predicate return in a method type", "x: {isFoo(): this is Foo} = v", "let x = v;"
code "types entry: a this parameter in a function type", "x: (this: Ctx) => void = f", "let x = f;"
code "types entry: a generic function type", "x: <T>(a: T) => T = f", "let x = f;"
code "types entry: a generic constructor type", "x: new <T>(a: T) => Box = B", "let x = B;"
code "types entry: an abstract constructor type", "x: (abstract new(... args: never[]) => unknown) = B", "let x = B;"
code "types entry: an abstract generic constructor type", "x: (abstract new<T>() => B) = B", "let x = B;"
code "types entry: a trailing comma after a function type's parameters", "x: (a: A,) => B = f", "let x = f;"
code "types entry: two parameters in a function type", "x: (a: A, b: B) => C = f", "let x = f;"
code "types entry: untyped parameters in a cast's function type", "y = x as (a, b) => C", "let y = x;"
code "types entry: an untyped optional parameter in a cast's function type", "y = x as (a?) => C", "let y = x;"
code "types entry: an optional parameter in a function type", "x: (a?: A) => B = f", "let x = f;"
code "types entry: an untyped rest parameter in a cast's function type", "y = x as (...rest) => B", "let y = x;"
code "types entry: a typed rest parameter in a function type", "x: (...rest: A[]) => B = f", "let x = f;"
code "types entry: constrained and defaulted type variables", "x: <T, U extends V = W, X = Y, Z extends Q>(a: T) => U = f", "let x = f;"
code "types entry: a leading bar before one type", "x: | A = v", "let x = v;"
code "types entry: a leading bar before a union", "x: | A | B = v", "let x = v;"
code "types entry: a three-member union", "x: A | B | C = v", "let x = v;"
code "types entry: a three-member intersection", "x: A & B & C = v", "let x = v;"
code "types entry: a keyof type", "x: keyof T = v", "let x = v;"
code "types entry: a readonly array type", "x: readonly string[] = v", "let x = v;"
code "types entry: a unique symbol type", "x: unique symbol = v", "let x = v;"
code "types entry: an infer type in a conditional", "x: T extends (infer U)[] ? U : never = v", "let x = v;"
code "types entry: an indexed access type", 'x: T["k"] = v', "let x = v;"
code "types entry: a this return type", "def f(): this\n  @", "function f() {\n  return this;\n}"
code "types entry: a typeof type", "x: typeof y = v", "let x = v;"
code "types entry: an empty object type", "x: {} = v", "let x = v;"
code "types entry: a trailing comma in an object type", "x: {a: A,} = v", "let x = v;"
code "types entry: comma-separated members", "x: {a: A, b: B} = v", "let x = v;"
code "types entry: a readonly member", "x: {readonly a: A} = v", "let x = v;"
code "types entry: a readonly optional member", "x: {readonly a?: A} = v", "let x = v;"
code "types entry: a method member with no parameters", "x: {m()} = v", "let x = v;"
code "types entry: a method member with a return type", "x: {m(a: A): B} = v", "let x = v;"
code "types entry: a generic method member with a return type", "x: {m<T>(a: T): T} = v", "let x = v;"
code "types entry: a generic method member", "x: {m<T>(a: T)} = v", "let x = v;"
code "types entry: an index signature", "x: {[k: string]: V} = v", "let x = v;"
code "types entry: a readonly index signature", "x: {readonly [k: string]: V} = v", "let x = v;"
code "types entry: a mapped type", "x: {[K in keyof T]: V} = v", "let x = v;"
code "types entry: a readonly mapped type", "x: {readonly [K in keyof T]: V} = v", "let x = v;"
code "types entry: an optional mapped type", "x: {[K in keyof T]?: V} = v", "let x = v;"
code "types entry: a readonly optional mapped type", "x: {readonly [K in keyof T]?: V} = v", "let x = v;"
code "types entry: a string member key", 'x: {"a-b": A} = v', "let x = v;"
code "types entry: a numeric member key", "x: {0: A} = v", "let x = v;"
code "types entry: an empty tuple", "x: [] = v", "let x = v;"
code "types entry: a trailing comma in a tuple", "x: [A, B,] = v", "let x = v;"
code "types entry: an optional tuple element", "x: [A, B?] = v", "let x = v;"
code "types entry: a rest tuple element", "x: [A, ...B[]] = v", "let x = v;"
code "types entry: a named tuple element", "x: [a: A] = v", "let x = v;"
code "types entry: a named optional tuple element", "x: [a?: A] = v", "let x = v;"
code "types entry: a named rest tuple element", "x: [...rest: A[]] = v", "let x = v;"
code "types entry: an optional method member", "x: {a?(): void} = v", "let x = v;"
code "types entry: an optional method member with no return type", "x: {a?(n: N)} = v", "let x = v;"
code "types entry: a call signature", "x: {(): void} = v", "let x = v;"
code "types entry: a generic call signature", "x: {<T>(a: T): T} = v", "let x = v;"
code "types entry: a construct signature", "x: {new (): Foo} = v", "let x = v;"
code "types entry: a generic construct signature", "x: {new <T>(a: T): Foo} = v", "let x = v;"
code "types entry: a trailing comma in type arguments", "x: Foo<A, B,> = v", "let x = v;"
code "types entry: a trailing comma in type variables", "x: <T,>(a: T) => T = f", "let x = f;"

# A def parameter's declaration renders the annotation token's normalized
# text, so a member row the scanner left unseparated must be separated
# there: after a modifier (`readonly a`), before a modifier that opens a
# line a `>` kept from breaking, and once only after a trailing comma.
type "a readonly member keeps its name in a def parameter's declaration", '''
  export def f(o: {readonly a: number, b: string}): void
    o
''', '''
  export declare function f(o: { readonly a: number, b: string }): void;
'''

type "a readonly member opening a line after a generic member is separated", '''
  export def f(o: {
    a: Foo<X>
    readonly b: B
  }): void
    o
''', '''
  export declare function f(o: { a: Foo<X>; readonly b: B }): void;
'''

type "a trailing comma before a line break separates an object type's members once", '''
  export def f(o: {
    a: A,
    b: B
  }): void
    o
''', '''
  export declare function f(o: { a: A, b: B }): void;
'''

type "a trailing comma before a line break separates a tuple's elements once", '''
  export def g(t: [
    A,
    B
  ]): void
    t
''', '''
  export declare function g(t: [A, B]): void;
'''

# ==============================================================================
# A `.` in a type continues a name; after a literal, a bracket or a generic
# it reads a member of a value, which no type spells, and `?.` never
# belongs to a type. Each rejects at the member, in every annotation.
# ==============================================================================

fail 'a member read off a string literal in an annotation rejects', "x: 'a'.length = 3", ":1:7: a member read off a value ('.length') in a type — a type names a member only through a name (`A.B`, `typeof x.y`)"
fail 'a member read off a tuple in a parameter type rejects', 'f = (a: [1].length) -> a', ":1:12: a member read off a value ('.length') in a type"
fail 'a member read off a literal in a type alias rejects', "type T = 'a'.length", ":1:13: a member read off a value ('.length') in a type"
fail 'a member read off a literal in a class field type rejects', "class A\n  y: 'a'.length", ":2:9: a member read off a value ('.length') in a type"
fail 'a member read off a literal inside a union rejects', "class A\n  y: 'a' | 'b'.length", ":2:15: a member read off a value ('.length') in a type"
fail 'a member read off a parenthesized literal rejects', "x: ('a').length = 1", ":1:9: a member read off a value ('.length') in a type"
fail 'a member read off a boolean literal rejects', 'x: true.valueOf = 1', ":1:8: a member read off a value ('.valueOf') in a type"
fail 'a member read off a literal in a def parameter type rejects', 'def g(a: [1].length)\n  a', ":1:13: a member read off a value ('.length') in a type"
fail 'a member read off a literal in an as cast rejects', "x = y as 'a'.length", ":1:13: a member read off a value ('.length') in a type"
fail 'an optional chain in a type rejects', 'x: A?.B = 1', ":1:5: a member read off a value ('?.B') in a type"
type 'a qualified name stays a type', 'x: Foo.Bar<T> = 1', '''
  declare let x: Foo.Bar<T>;
'''
type 'typeof a member chain stays a type', 'x: typeof a.b = 1', '''
  declare let x: typeof a.b;
'''
type 'typeof this with a member stays a type', 'type T = typeof this.x', '''
  type T = typeof this.x;
'''
type 'an import type stays a type', 'x: import("m").T = 1', '''
  declare let x: import("m").T;
'''
fail 'a member of this outside typeof in a type rejects', 'x: this.y = 1', ":1:8: a member read off a value ('.y') in a type"
fail 'a member read off a literal in a type alias generic rejects', "type G<T extends 'a'.length> = T", ":1:21: a member read off a value ('.length') in a type"
fail 'a member read off a literal in an interface generic default rejects', "interface I<T = 'a'.length>\n  a: T", ":1:20: a member read off a value ('.length') in a type"
fail 'a member read off a literal in a def generic rejects', "def f<T extends 'a'.length>(a: T)\n  a", ":1:20: a member read off a value ('.length') in a type"
type 'typeof a member chain of this stays a type', 'x: typeof this.a.b = 1', '''
  declare let x: typeof this.a.b;
'''
type 'an import type with attributes stays a type', 'x: import("m", { with: { "resolution-mode": "import" } }).T = 1', '''
  declare let x: import("m", { with: { "resolution-mode": "import" } }).T;
'''
type 'a spaced import type stays a type', 'x: import ("m").T = 1', '''
  declare let x: import ("m").T;
'''
type 'a qualified name in a generic constraint stays a type', 'type G<T extends A.B> = T', '''
  type G<T extends A.B> = T;
'''

# ==============================================================================
# Annotation runs pass the type vocabulary — a code shape is no type on
# either face, in every annotation site
# ==============================================================================

fail "an operator in a variable annotation rejects", "x: a + b = 1", "types.rip>:1:6: code expression ('+') in a type body — types erase and cannot execute"
fail "a this-member in a variable annotation rejects", "x: @y = 1", "types.rip>:1:4: code expression ('@') in a type body"
fail "an operator in a parameter annotation rejects", "f = (a: a + b) -> a", "types.rip>:1:11: code expression ('+') in a type body"
fail "a this-member in a def parameter annotation rejects", "def f(a: @b)\n  a", "types.rip>:1:10: code expression ('@') in a type body"
fail "an operator in an arrow return annotation rejects", "f = (a): a + b -> a", "types.rip>:1:12: code expression ('+') in a type body"
fail "an operator in a def return annotation rejects", "def f(a): a * b\n  a", "types.rip>:1:13: code expression ('*') in a type body"
fail "an operator in a parameterless def return annotation rejects", "def f: a - b\n  1", "types.rip>:1:10: code expression ('-') in a type body"
fail "a call in a generic def return annotation rejects", "def g<T>: T | a()\n  1", "types.rip>:1:16: code expression ('(') in a type body"
fail "an operator inside a cast type's brackets rejects", "x = y as T[a + 1]", "types.rip>:1:14: code expression ('+') in a type body"
fail "a call in a satisfies type rejects", "x = y satisfies {a: b()}", "types.rip>:1:22: code expression ('(') in a type body"
fail "an operator in a class field annotation rejects", "class A\n  y: a + b = 1", "types.rip>:2:8: code expression ('+') in a type body"
fail "an operator in a component prop annotation rejects", "C = component\n  @y: a + b := 1\n  render\n    div", "types.rip>:2:9: code expression ('+') in a type body"
fail "a this-member in a catch binding annotation rejects", "try f() catch e: @x then 1", "types.rip>:1:18: code expression ('@') in a type body"
fail "an operator in a typed prototype member rejects", "X::m: a + b = 1", "types.rip>:1:9: code expression ('+') in a type body"
fail "a call in a function type's parameter annotation rejects", "x: {m: (a: b()) => c} = 1", "types.rip>:1:13: code expression ('(') in a type body"
fail "a type predicate outside return position rejects", "x: y is Foo = 1", "types.rip>:1:6: code expression ('is') in a type body"
fail "an import type with a parenthesized argument rejects", 'x: import(("m")).T = 1', "types.rip>:1:11: an import type takes one string literal and an optional attributes object"
fail "an import type with a name argument rejects", "x: import(m).T = 1", "types.rip>:1:11: an import type takes one string literal"
fail "an import type with a computed argument rejects", 'x: import("m" + n).T = 1', "types.rip>:1:11: an import type takes one string literal"

code "a bare import type erases", 'x: import("m") = 1', "let x = 1;"
code "a typeof import type erases", 'x: typeof import("m") = 1', "let x = 1;"
code "an import type alias erases", 'type T = import("m").T', ""
code "an optional interface method erases", "interface I\n  a?(): void\nz = 1", "let z = 1;"
fail "an asserts predicate outside return position rejects", "x: asserts v is Foo = 1", "types.rip>:1:14: code expression ('is') in a type body"
fail "an asserts predicate in a type argument rejects", "x: Foo<asserts v is T> = 1", "types.rip>:1:18: code expression ('is') in a type body"
fail "an interpolated string in an annotation rejects", 'x: "a#{b}" = 1', "types.rip>:1:4: an interpolated string in a type body — a string literal type is a plain string"
fail "a keyword-named member call in a value position rejects", "x: {a: then()} = 1", "types.rip>:1:8: code expression ('then') in a type body"
fail "a keyword-named interface method needs a return type", "interface I\n  then(x: number)\nz = 1", "types.rip>:2:3: an interface method shorthand needs a return type — `then(…): T`"

fail "a keyword name with generics and no parameter list rejects", "interface I\n  if<T>\nz = 1", "types.rip>:2:3: code expression ('if') in a type body"
fail "a setter with no parameter rejects", "x: {set a()} = 1", "types.rip>:1:9: a setter takes one parameter — `set a(v: T)`"
fail "a keyword-named setter with no parameter rejects", "interface I\n  set then()\nz = 1", "types.rip>:2:7: a setter takes one parameter — `set then(v: T)`"
code "an import type opening a block alias row erases", 'type T =\n  import("m").A | B\nz = 1', "let z = 1;"
code "an import type with attributes opening a block alias row erases", 'type T =\n  import("m", {with: {a: "b"}}).T\nz = 1', "let z = 1;"
code "an import type on an interface member's own line erases", 'interface I\n  b:\n    import("m").T\nz = 1', "let z = 1;"
code "an accessor pair in an annotation's object type erases", "x: {get a(): string, set a(v: string)} = v", "let x = v;"
code "a computed-key method in an annotation erases", "x: {[Symbol.iterator](): Iterator<number>} = v", "let x = v;"
code "string- and number-keyed methods in an annotation erase", 'x: {"m"(): void, "n"?(): void, 1(): void} = v', "let x = v;"
code "keyword-named methods in an annotation erase", "x: {then<R>(f: (v: T) => R): Promise<R>, catch(): void, import(): void, is(): void} = v", "let x = v;"
code "a keyword-named method in a def parameter type erases", "def f(p: {then(): void})\n  p", "function f(p) {\n  return p;\n}"
type "member names of every key shape reach an interface declaration", "interface I\n  \"m\"(x: number): void\n  1(): void\n  [Symbol.iterator](): I\n  then<R>(f: R): R\n  get a(): string\n  set a(v: string)\n  import(): void\nz = 1", '''
  interface I {
    "m"(x: number): void;
    1(): void;
    [Symbol.iterator](): I;
    then<R>(f: R): R;
    get a(): string;
    set a(v: string);
    import(): void;
  }
  '''
code "a def return predicate erases", "def f(v): v is Foo\n  true", "function f(v) {\n  return true;\n}"
code "an arrow return predicate erases", "f = (v): v is Foo -> true", "let f = function(v) {\n  return true;\n};"
code "a this predicate on an arrow return erases", "f = (): this is Foo -> true", "let f = function() {\n  return true;\n};"
code "an asserts predicate on an arrow return erases", "f = (v): asserts v is Foo -> 1", "let f = function(v) {\n  return 1;\n};"

type "a return predicate reaches the declaration", "export def isFoo(v: unknown): v is Foo\n  true", '''
  export declare function isFoo(v: unknown): v is Foo;
  '''
