''', 7

fail 'an optional marker after a destructuring parameter rejects', 'f = ({a}?, b) -> b', ":1:9: Unexpected '?'"

test 'a bare optional parameter on its own line', '''
  f = (
    a?
    b
  ) -> b
  f(1, 2)
''', 2

fail 'a doubled colon after a parameterless def name rejects', "def f: : number\n  1", "type annotations use a single ':'"
fail 'a doubled colon after a catch binding rejects', "try\n  g()\ncatch e: : any\n  e", "type annotations use a single ':'"
fail 'a doubled colon after a typed prototype member rejects', 'String::foo: : number = 1', "type annotations use a single ':'"
fail 'an annotated catch binding named for a value word rejects', "try\n  x()\ncatch yes: any\n  1", "'yes' cannot name a binding"
fail 'an annotated array-pattern loop variable rejects', "for [a, b]: number in xs\n  a", 'a loop variable does not take a type annotation'

test 'a string-keyed parameter is a destructuring rename', '''
  f = ("a": n) -> n
  f({a: 7})
''', 7

fail 'an optional marker after a destructuring pattern takes no annotation', 'f = ({a}?: string) -> a', ":1:9: Unexpected"

test 'a numeric key with an assigned value stays an object', '''
  r = (->
    1: n = 5
  )()
  r[1]
''', 5

fail 'an annotated soak prototype write rejects after a statement', "f\nX?::m: number = 1", 'the soak form cannot carry the annotation'
fail 'a soak prototype write inside an implicit call is no annotation', 'f X?::m: number = 1', "Unexpected implicit '{'"

test 'a prototype chain inside an implicit call is an object key', '''
  f = (o) -> o
  r = f String::m: n = 1
  r["String.prototype.m"]
''', 1

test 'a static class method with a typed parameter returning a name', '''
  class A
    @make: (x: number) => x
  A.make(3)
''', 3

fail 'a class field with a call value rejects', "class A\n  x: f()", "a class field takes '=' for its value"
fail 'a component prop function type with a generic default is no type', "Foo = component\n  @x: () => Bar<T = number>\n  render\n    div", ":2:28: Unexpected 'dedent'"

fail 'class generics after a parent call reject', "mixin = (b) -> b\nclass B\nclass A extends mixin(B)<T>\n  x = 1", 'class generics are not supported'
fail 'class generics after a parent call with arguments reject', "mix = (b, c) -> b\nclass B\nclass A extends mix(B, B)<T>\n  x = 1", 'class generics are not supported'

test 'a bracketed comparison after a bracketed class expression', '''
  x = [class A][0]
