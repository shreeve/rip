''', true

test 'a class expression compares with !=', '''
  r = class A != null
  r
''', true

fail 'a class then-body does not make the next block a class body', "class A then make: ->\n  x: number\n  y: 1\n  x = 1\n  0", "these adjacent 'name:' lines are ambiguous"

test 'a bodiless class does not make a later block a class body', '''
