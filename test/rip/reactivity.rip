# Test: Reactivity (4 node types)
# Tests the reactive operators: := (state), ~= (computed), ~> (effect),
# and =! (readonly). These compile to __state(), __computed(), __effect(),
# and const respectively.

import { test, code, fail, type } from '../support/testing.js'

# ==============================================================================
# State (:=) — Code Generation
# ==============================================================================

skip = { skipPreamble: true }

code "state creation", "count := 0", "const count = __state(0)", skip
code "state with string", 'name := "Rip"', 'const name = __state("Rip")', skip

code "state update", '''
  count := 0
  count += 1
  ''', '''
  const count = __state(0);
  count.value += 1
  ''', skip

code "state read", '''
  count := 0
  x = count
  ''', '''
  let x;

  const count = __state(0);
  x = count.value
  ''', skip

# ==============================================================================
# Computed (~=) — Code Generation
# ==============================================================================

code "computed creation", "doubled ~= count * 2", "const doubled = __computed(() => (count * 2))", skip

code "computed with expression", '''
  message ~= "Count is #{count}"
  ''', '''
  const message = __computed(() => `Count is ${count}`)
  ''', skip

# ==============================================================================
# Effect (~>) — Code Generation
# ==============================================================================

code "fire-and-forget effect", '''
  ~> console.log count
  ''', '''
  __effect(() => { return console.log(count); })
  ''', skip

code "assigned effect", '''
  logger ~> console.log count
  ''', '''
  const logger = __effect(() => { return console.log(count); })
  ''', skip

# ==============================================================================
# Readonly (=!) — Code Generation
# ==============================================================================

code "readonly constant", "MAX =! 100", "const MAX = 100"
code "readonly string", 'URL =! "https://example.com"', 'const URL = "https://example.com"'

# ==============================================================================
# State (:=) — Runtime Behavior
# ==============================================================================

test "state initial value", '''
  count := 0
  count + 0
  ''', 0

test "state update and read", '''
  count := 10
  count += 5
  count + 0
  ''', 15

test "state with string", '''
  name := "hello"
  name += " world"
  "" + name
  ''', "hello world"

test "state boolean coercion", '''
  flag := true
  flag is true
  ''', true

# ==============================================================================
# Computed (~=) — Runtime Behavior
# ==============================================================================

test "computed initial value", '''
  count := 5
  doubled ~= count * 2
  doubled + 0
  ''', 10

test "computed updates when state changes", '''
  count := 3
  doubled ~= count * 2
  count += 1
  doubled + 0
  ''', 8

test "computed with multiple dependencies", '''
  a := 2
  b := 3
  sum ~= a + b
  sum + 0
  ''', 5

test "computed chain", '''
  base := 10
  doubled ~= base * 2
  quadrupled ~= doubled * 2
  quadrupled + 0
  ''', 40

test "computed chain updates", '''
  base := 10
  doubled ~= base * 2
  quadrupled ~= doubled * 2
  base += 5
  quadrupled + 0
  ''', 60

test "computed dependency mutation rejects loudly", '''
  source := 1
  derived ~=
    seen = source + 0
    source = 2 if seen is 1
    seen
  try
    derived + 0
  catch e
    e.message
  ''', "reactive runtime: computed dependency changed during evaluation — computed functions must derive without writing or touching a dependency"

# ==============================================================================
# Readonly (=!) — Runtime Behavior
# ==============================================================================

test "readonly value", "MAX =! 42; MAX", 42
test "readonly string", 'MSG =! "hi"; MSG', "hi"
test "readonly in expression", "PI =! 3; PI * 2", 6

# ==============================================================================
# Mixed Reactive Patterns
# ==============================================================================

test "state + computed together", '''
  width := 5
  height := 10
  area ~= width * height
  area + 0
  ''', 50

test "state + computed + update", '''
  price := 100
  tax ~= price * 0.1
  price += 50
  tax + 0
  ''', 15

test "multiple states", '''
  a := 1
  b := 2
  c := 3
  a + b + c + 0
  ''', 6

# ==============================================================================
# Components with reactive state
# ==============================================================================

# ==============================================================================
# Effect Cleanup (~>) — Runtime Behavior
# ==============================================================================

test "effect without cleanup still works", '''
  result := 0
  count := 1
  ~> result = count * 10
  count += 1
  result + 0
  ''', 20

test "effect cleanup runs before re-execution", '''
  log = []
  count := 0
  __effect ->
    v = count + 0
    log.push "run:#{v}"
    -> log.push "cleanup:#{v}"
  count += 1
  log.join ","
  ''', "run:0,cleanup:0,run:1"

# An effect whose tail is a statement registers no cleanup: the handler
# an `if` assigns is not called when the effect re-runs.
test "an effect ending in an if that assigns a handler registers no cleanup", '''
  open := true
  win = {}
  calls = 0
  ~>
    if open
      win.onkeydown = (e) -> calls += e.key.length
  open = false
  calls
  ''', 0

test "an effect ending in a call returns its handle as the cleanup", '''
  log = []
  n := 0
  subscribe = (v) -> -> log.push "off:#{v}"
  ~> subscribe(n + 0)
  n += 1
  log.join ","
  ''', "off:0"

# Every tail but a statement may produce the cleanup.
test "an effect returns an optional, logical, conditional, or try tail as the cleanup", '''
  log = []
  n := 0
  live := true
  sub = (tag, v) -> -> log.push "#{tag}:#{v}"
  box = { sub }
  ~> sub?("opt", n)
  ~> box.sub?("member", n)
  ~> live and sub("and", n)
  ~> if live then sub("ternary", n) else null
  ~> try sub("try", n) catch then null
  n += 1
  log.sort().join ","
  ''', "and:0,member:0,opt:0,ternary:0,try:0"

# A branch arm decides its own return: a cleanup arm returns, a writing
# arm runs its write.
test "an effect if with a cleanup arm and a writing arm returns only the cleanup", '''
  log = []
  active := true
  status = null
  ~>
    if active
      -> log.push "stopped"
    else
      status = -> log.push "never"
  active = false
  active = true
  [log.join(","), typeof status]
  ''', ["stopped", "function"]

test "an effect whose arm is a sequence ending in a write registers no cleanup", '''
  open := true
  calls = 0
  win = {}
  ~> (calls += 0; win.handler = -> calls += 1) if open
  open = false
  calls
  ''', 0

test "an effect ending in a guarded write registers no cleanup", '''
  open := true
  calls = 0
  win = {}
  ~> open and win.a = -> calls += 1
  ~> not open or win.b = -> calls += 1
  ~> open && (calls += 0; win.c = -> calls += 1)
  open = false
  calls
  ''', 0

# A loop tail is a statement, a counted loop as much as any other: its
# body runs, and nothing it collects returns as the cleanup.
code "an effect ending in a counted loop returns no cleanup", '''
  n := 3
  ~>
    console.log n
    loop 2
      console.log 1
  ''', '''
  const n = __state(3);
  __effect(() => {
    console.log(n.value);
    for (let it = 0; it < 2; it++) {
      console.log(1);
    }
  });
  '''

test "an effect ending in a counted loop runs the loop on every run", '''
  log = []
  n := 0
  ~>
    log.push "run:#{n}"
    loop 2
      -> log.push "never"
  n += 1
  log.join ","
  ''', "run:0,run:1"

test "an effect switch arm that writes does not fall into the next arm's cleanup", '''
  log = []
  mode := 'a'
  ~>
    switch mode
      when 'a' then status = 1
      when 'b' then -> log.push "b-off"
  mode = 'c'
  log.join ","
  ''', ""

test "effect cleanup on multiple re-runs", '''
  log = []
  count := 0
  __effect ->
    v = count + 0
    -> log.push "c:#{v}"
  count += 1
  count += 1
  log.join ","
  ''', "c:0,c:1"

# Zombie-effect guard. An effect can be queued in __pendingEffects when a
# signal it subscribes to changes, then disposed before the flush reaches
# it (e.g. its parent block was destroyed by an earlier effect in the same
# flush). Without the disposed guard in run(), the queued effect would
# execute, re-bind __currentEffect to itself, and any signal .value read
# would re-subscribe it via subscribers.add(__currentEffect) — leaking one
# subscriber per flush cycle that hits this race. Symptom in apps: each
# navigation creates one more component instance than the previous
# (N visits => N synchronous mounts on visit N).

test "disposed effect in pending queue does not run", '''
  log = []
  s := 0
  d2 = null
  e1 = __effect ->
    v = s + 0                # read s, subscribe E1
    log.push "e1:#{v}"
    d2() if d2 and v > 0     # E1 disposes E2 mid-flush after the change
  d2 = __effect ->
    v = s + 0                # read s, subscribe E2
    log.push "e2:#{v}"
  s += 1                     # writes 1; both E1 & E2 queued; E1 runs and
                             # disposes E2; flush should NOT re-run E2.
  log.join ","
  ''', "e1:0,e2:0,e1:1"

test "disposed effect cannot re-subscribe via signal read", '''
  log = []
  s := 0
  d2 = null
  e1 = __effect ->
    v = s + 0
    log.push "e1:#{v}"
    d2() if d2 and v > 0
  d2 = __effect ->
    v = s + 0
    log.push "e2:#{v}"
  # First write: E1 disposes E2 mid-flush. Without the guard, E2 would
  # run zombie AND re-subscribe via the signal read inside its body.
  s += 1
  # Second write: if E2 re-subscribed during the zombie run, this would
  # fire it again. With the guard, E2 is gone for good.
  s += 1
  log.join ","
  ''', "e1:0,e2:0,e1:1,e1:2"

# ==============================================================================
# Component Composition — Signal Passthrough (foundation of reactive props)
# ==============================================================================

test "signal passthrough identity", '''
  count := 42
  wrapped := count
  wrapped is count
  ''', true

test "signal passthrough preserves value", '''
  count := 42
  wrapped := count
  wrapped + 0
  ''', 42

# ==============================================================================
# Postfix ternary in component computed members
# ==============================================================================

test 'component with state', '''
  A = component
    x := 5
  a = A.new()
  a.x.value
''', 5

test 'component state mutation', '''
  A = component
    x := 10
  a = A.new()
  a.x.value = 20
  a.x.value
''', 20

test 'component signal read', '''
  A = component
    x := 5
  a = A.new()
  a.x.read()
''', 5

test 'component readonly prop via constructor', '''
  A = component
    @label =! "default"
  a = A.new({ label: "custom" })
  a.label
''', 'custom'

test 'readonly prop receives value not signal', '''
  A = component
    @label =! "hello"
  a = A.new label: "world"
  a.label
''', 'world'

test 'computed with postfix ternary false branch', '''
  A = component
    flag := false
    result ~= "yes" if flag else "no"
  a = A.new()
  a.result.value
''', 'no'

test 'computed with postfix ternary true branch', '''
  A = component
    flag := true
    result ~= "yes" if flag else "no"
  a = A.new()
  a.result.value
''', 'yes'

test 'computed with postfix ternary reacts to state change', '''
  A = component
    flag := false
    result ~= "yes" if flag else "no"
  a = A.new()
  before = a.result.value
  a.flag.value = true
  after = a.result.value
  before + "," + after
''', 'no,yes'

test 'computed with postfix ternary using nullable object', '''
  A = component
    user := null
    dest ~= "/bookings" if user else "/auth"
  a = A.new()
  before = a.dest.value
  a.user.value = { name: "Steve" }
  after = a.dest.value
  before + "," + after
''', '/auth,/bookings'

code 'computed postfix ternary compiles to JS ternary', '''
  export Foo = component
    user := null
    href ~= "/b" if user else "/a"
    render
      div "hello"
  ''', '''
  export const Foo = class extends __Component {
    _init(__given) {
      this.user = __state(null);
      this.href = __computed(() => (this.user.value ? "/b" : "/a"));
    }
    _create() {
      this._el0 = document.createElement('div');
      this._el0.setAttribute('data-part', 'Foo');
      this._t0 = document.createTextNode("hello");
      this._el0.appendChild(this._t0);
      return this._el0;
    }
  };
  '''

code 'render block with identifier property value compiles to reactive setAttribute', '''
  export Bar = component
    user := null
    href ~= "/b" if user else "/a"
    render
      a href: href
        "click"
  ''', '''
  export const Bar = class extends __Component {
    _init(__given) {
      this.user = __state(null);
      this.href = __computed(() => (this.user.value ? "/b" : "/a"));
    }
    _create() {
      this._el0 = document.createElement('a');
      this._el0.setAttribute('data-part', 'Bar');
      this._t0 = document.createTextNode("click");
      this._el0.appendChild(this._t0);
      return this._el0;
    }
    _setup() {
      __effect(() => { { const __v = this.href.value; __v == null ? this._el0.removeAttribute('href') : this._el0.setAttribute('href', __v); } });
    }
  };
  '''

# ==============================================================================
# An effect or computed body binds no implicit `it`: a bare `it` there reads a
# declared binding or rejects positioned.
# ==============================================================================

fail "a bare it in an effect rejects", "~> console.log it", ":1:16: emitter: bare `it` has no binding here"
fail "a bare it in an effect block rejects", "~>\n  x = 1\n  console.log it", ":3:15: emitter: bare `it` has no binding here"
fail "a bare it in an expression effect rejects", "x = ~> it", ":1:8: emitter: bare `it` has no binding here"
fail "a bare it in a bound effect rejects", "stop ~> console.log it", ":1:21: emitter: bare `it` has no binding here"
fail "a bare it in a computed rejects", "y ~= it", ":1:6: emitter: bare `it` has no binding here"
fail "a bare it in a computed expression rejects", "y ~= it + 1", ":1:6: emitter: bare `it` has no binding here"
fail "a bare it in a computed block rejects", "y ~=\n  z = 1\n  z + it", ":3:7: emitter: bare `it` has no binding here"
fail "an effect inside a parameterless function binds no implicit it", "f = -> ~> it", ":1:11: emitter: bare `it` has no binding here"
test "a module it answers an effect", "it = 5\nseen = 0\n~> seen = it\nseen", 5
test "a module state it answers a computed", "it := 2\ny ~= it * 3\ny", 6
test "an effect's own it answers", "seen = 0\n~>\n  it = 4\n  seen = it\nseen", 4
test "a parameterless function inside an effect keeps its implicit it", "seen = null\n~> seen = [1, 2].map -> it * 2\nseen", [2, 4]
test "a module it answers an effect inside a parameterless function", "it = 5\nseen = 0\nf = -> ~> seen = it\nf()\nseen", 5
test "a module it answers a computed inside a parameterless function", "it = 2\nf = ->\n  y ~= it * 3\n  y\nf()", 6
test "a parameter named it answers an effect inside its function", "seen = 0\nf = (it) -> ~> seen = it\nf 7\nseen", 7
test "a state initializer reads its function's implicit it", "f = ->\n  x := it\n  x\nf 3", 3
test "a symbol it in a computed is a symbol", "y ~= Symbol.keyFor(:it)\ny", "it"
test "a symbol it in an effect is a symbol", "seen = null\n~> seen = Symbol.keyFor(:it)\nseen", "it"

# ==============================================================================
# Effect bodies cannot yield in ANY position — statement, expression, or tail —
# because the runtime calls the effect function as a normal callable. A named
# generator the effect calls stays legal.
# ==============================================================================

fail 'effect in expression position cannot yield', '''
  f = ->
    x = ~> yield 1
    x
  ''', 'cannot yield'

fail 'effect in tail position cannot yield', '''
  f = ->
    ~> yield 1
  ''', 'cannot yield'

fail 'statement effect cannot take a generator callback', '''
  ~> -> yield 1
  ''', 'cannot yield'

fail 'expression effect cannot take a generator callback', '''
  x = ~> -> yield 1
  ''', 'cannot yield'

fail 'tail effect cannot take a generator callback', '''
  f = ->
    ~> -> yield 1
  ''', 'cannot yield'

fail 'exported effect cannot take a generator callback', '''
  export stop ~> -> yield 1
  ''', 'cannot yield'

test 'effect may call a named generator', '''
  out := 0
  g = ->
    yield 7
  ~> out = [...g()][0]
  out + 0
  ''', 7

test 'ordinary effect callback may contain a nested generator', '''
  out := 0
  ~> ->
    g = -> yield 9
    out = g().next().value
  out + 0
  ''', 9

# An effect's body is the effect's own function: it is the one that
# awaits, and the function the effect is declared in stays synchronous.
code 'an awaiting effect leaves its function synchronous', '''
  def watch(load)
    seen := 0
    stop ~> seen = load!
    ~> load!
    stop
  ''', '''
  function watch(load) {
    const seen = __state(0);
    const stop = __effect(async () => { (seen.value = await load()); });
    __effect(async () => { return await load(); });
    return stop;
  }
  '''

code 'an awaiting effect leaves its method synchronous', '''
  class K
    run: (load) ->
      stop ~> @x = load!
      stop
  ''', '''
  class K {
    run(load) {
      const stop = __effect(async () => { (this.x = await load()); });
      return stop;
    }
  }
  '''

code 'an awaiting block effect leaves its bound arrow synchronous', '''
  go = (load) =>
    ~>
      v = await load()
      v
    1
  ''', '''
  let go = load => {
    __effect(async () => {
      let v = await load();
      return v;
    });
    return 1;
  };
  '''

code 'a call spelled `effect` awaits in the function that makes it', '''
  def call(effect, a, b)
    effect a, b!
  ''', '''
  async function call(effect, a, b) {
    return effect(a, await b());
  }
  '''

test 'a function declaring an awaiting effect returns its value, never a promise', '''
  load = -> Promise.resolve 5
  def watch()
    stop ~> load!
    stop
  typeof watch().then
  ''', 'undefined'

test "an effect ending in a nested effect disposes it before re-running", '''
  log = []
  outer := 0
  inner := 0
  ~>
    o = outer + 0
    ~> log.push "#{o}:#{inner}"
  outer = 1
  inner = 5
  log.join ","
  ''', "0:0,1:0,1:5"

# A function nested in a parameter default is a scope like any other:
# its bindings steer the runtime alias, so the generated `__state`
# reference never lands on the user's local of that name.
test "a reactive declaration in a function in a parameter default keeps its runtime", '''
  h = (g = (->
    __state = 1
    z := 2
    z)) -> g()
  h()
  ''', 2
test "a reactive declaration in a function in a def parameter default keeps its runtime", '''
  def h(g = (->
    __state = 1
    z := 3
    z))
    g()
  h()
  ''', 3
test "a reactive declaration under a catch binding named __state keeps its runtime", '''
  r = null
  try
    throw 1
  catch __state
    r = (->
      z := 2
      z)()
  r
  ''', 2
test "a reactive declaration under a constructor @param named __state keeps its runtime", '''
  class A
    constructor: (@__state) ->
      @v = (->
        z := 3
        z)()
  A.new(1).v
  ''', 3
