{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "include": [
    "corpus/grammar",
    "corpus/claims"
  ],
  "exclude": [
    "corpus/errors"
  ]
}
