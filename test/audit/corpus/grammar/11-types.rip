# 11-types.rip — the erased-type surface, and the type VOCABULARY the census counts.

# ── type aliases: simple, union, function ──
# `satisfies` is deliberately absent: rip has no source spelling for it, and the emitter uses it internally for computed lowerings only.
# Generic def signatures live with 08-functions; the position-constrained spellings below follow the boundaries note (ROADMAP.md).

type Port = number
type Flag = boolean | 'auto'
type Format = (value: number) => string

port: Port = 8080
flag: Flag = 'auto'
fmt: Format = (value) -> '$' + String(value)

console.log('port:', port, 'flag:', flag, 'fmt:', fmt(3))

# ── object aliases: the inline literal and the indented block ──

type Host = { name: string, port?: number }

type Bounds =
  low: number
  high: number

host: Host = { name: 'edge' }
bounds: Bounds = { low: 1, high: 9 }

console.log('host:', host.name, host.port ?? port, 'bounds:', bounds.low, bounds.high)

# ── typeof: a value's inferred shape, named ──

defaults = { theme: 'dark', depth: 2 }
type Defaults = typeof defaults

tuned: Defaults = { theme: 'light', depth: 3 }

console.log('tuned:', tuned.theme, tuned.depth)

# ── generic aliases: parameters and a constraint ──

type Boxed<T> = { item: T }
type Mapper<T, R> = (input: T) => R
type Keyed<T extends { id: number }> = T & { key: string }

boxed: Boxed<string> = { item: 'pearl' }
stringify: Mapper<number, string> = (input) -> String(input)
keyed: Keyed<{ id: number }> = { id: 4, key: 'k4' }

console.log('boxed:', boxed.item, stringify(8), keyed.key)

# ── interfaces: extension, optional and method members, generic ──

interface Signal
  name: string
  level: number

interface Alarm extends Signal
  acknowledged: boolean

interface Sink
  accept(entry: string): string
  flush?: () => void

interface Registry<T>
  entries: T[]
  find(key: string): T | undefined

alarm: Alarm = { name: 'smoke', level: 2, acknowledged: false }
sink: Sink = { accept: (entry) -> 'sunk ' + entry }
registry: Registry<Alarm> = { entries: [alarm], find: (key) -> registry.entries.find((s) -> s.name == key) }

console.log('alarm:', alarm.level, sink.accept('log'), sink.flush?(), registry.find('smoke')?.acknowledged)

# ── enums: one const object, forward and reverse entries; bare members auto-number, explicit numerics thread the counter, and a string member needs a value ──

enum Direction
  north
  south

enum Status
  draft = 'D'
  final = 'F'

export enum Priority
  low = 1
  standby
  urgent = 9

pick: Status = Status.final

console.log('direction:', Direction, Direction.north, Direction[1])
console.log('status:', Status.draft, 'priority:', Priority.standby, Priority.urgent)
console.log('pick:', pick)

# ── the bare typed forward declaration: `name: T` alone, erased, the binding hoisted with a definite-assignment face ──
# Spelled inside a def body: the module-level spelling's hoisted binding answers no hover, so it cannot sit at a probed column-0 position.

def choosePort(): Port
  chosen: Port
  if (Direction.north < Direction.south) then chosen = 443 else chosen = 80
  chosen

console.log('chosen:', choosePort())

# ── bodiless def signatures: the overload face of one implementation ──

def describe(id: number): string
def describe(id: string): string
def describe(id: number | string): string
  "entry #{id}"

console.log(describe(7), describe('seven'))

# ── exported type declarations: the same erased statement, exported ──

export type Outcome = 'ok' | 'failed'

export interface Manifest
  version: number

outcome: Outcome = 'ok'
manifest: Manifest = { version: 4 }

console.log('outcome:', outcome, manifest.version)

# ── casts: `as` narrows for the checker and erases at runtime ──

payload: unknown = 'stored'
text = payload as string
count = (JSON.parse('[3,4]') as number[]).length
veiled = payload as unknown as { deep: boolean }

console.log('cast:', text.length, count, typeof veiled)

# ── keyword types: the primitive vocabulary an annotation can name ──

type Loose = any
type Bag = object
type Marked = symbol
type Huge = bigint
type Yes = true
type No = false

loose: Loose = 'anything'
bag: Bag = { crate: true }
marked: Marked = Symbol('mark')
huge: Huge = 9007199254740993n
affirmed: Yes = true
denied: No = false

console.log('keywords:', loose, typeof bag, typeof marked, huge, affirmed, denied)

# ── never: the return of a def that only throws ──

def refuse(reason: string): never
  throw new Error(reason)

console.log('never:', typeof refuse)

# ── operators and access: keyof, readonly, indexed access, index signature ──

type HostKey = keyof Host
type Frozen = readonly string[]
type Locked = { readonly id: number }
type HostName = Host['name']
type Counts = { [label: string]: number }

hostKey: HostKey = 'name'
frozen: Frozen = ['a', 'b']
locked: Locked = { id: 7 }
hostName: HostName = 'edge'
counts: Counts = { hits: 3 }

console.log('operators:', hostKey, frozen[0], locked.id, hostName, counts.hits)

# ── mapped types: `in` between `[` and `]`, the one position TS grammar puts it ──

type Copy<T> = { [K in keyof T]: T[K] }

type Optional<T> =
  { [K in keyof T]?: T[K] }

copied: Copy<Host> = { name: 'edge', port: 80 }
optional: Optional<Host> = {}

console.log('mapped:', copied.name, Object.keys(optional).length)

# ── tuples: named members, an optional tail, a rest element ──

type Entry = [first: string, second: number]
type Trailing = [string, number?]
type Trail = [string, ...number[]]

entry: Entry = ['a', 1]
trailing: Trailing = ['b']
trail: Trail = ['c', 2, 3]

console.log('tuples:', entry[0], entry[1], trailing[0], trail.length)

# ── conditional types: the branch, and `infer` inside it ──

type IsText<T> = T extends string ? 'yes' : 'no'
type Elem<T> = T extends Array<infer U> ? U : never

isText: IsText<string> = 'yes'
elem: Elem<number[]> = 5

console.log('conditional:', isText, elem)

# ── a self-referential alias: the type names itself ──

type Branch = { label: string, kids: Branch[] }

branch: Branch = { label: 'root', kids: [{ label: 'leaf', kids: [] }] }

console.log('recursive:', branch.label, branch.kids.length, branch.kids[0].label)

# ── a call signature: the callable object type, and its named sibling ──

type Formatter = { (value: number): string }
type Greeter = { greet(name: string): string, times: number }

formatter: Formatter = (value) -> '#' + String(value)
greeter: Greeter = { greet: ((name) -> 'hi ' + name), times: 2 }

console.log('callable:', formatter(5), greeter.greet('ada'), greeter.times)

# ── narrowing annotations: the type predicate and the assertion ──
# The predicate in a TYPE BODY as well as in a def's return: `is` is TypeScript's operator there, and rip's `is`→`==` rewrite belongs to the value sub-language alone.

type Guard = { check: (value: unknown) => value is string }

guard: Guard = { check: ((value) -> typeof value == 'string') }

def looksText(value: unknown): value is string
  typeof value == 'string'

def mustText(value: unknown): asserts value is string
  if typeof value != 'string'
    throw new Error('not text')

console.log('predicate:', looksText('a'), looksText(1), typeof mustText, guard.check('a'))

# ── `this` as a return type: the method that returns its receiver ──

class Tally
  count: number = 0
  bump: (): this ->
    @count = @count + 1
    @

console.log('this:', new Tally().bump().bump().count)

# ── an abstract construct signature: parenthesized, since a bare `new` at annotation start parses as an expression ──

type Shaped = { id: number }

maker: (abstract new () => Shaped) = class
  id: number = 3

console.log('abstract:', typeof maker)

# ── an import type ──

parcel: import('./10-modules-lib.rip').Parcel = { size: 2 }

console.log('import type:', parcel.size)
