# 07-exceptions.rip — exception handling: every try shape, catch binding, and throw position.

# ── try/catch: the classic block pair, an identifier binding ──

parseConfig = (raw: string) ->
  try
    JSON.parse(raw)
  catch error
    console.log('parse failed:', error instanceof SyntaxError)
    null

console.log('config:', parseConfig('{"port":8080}'), parseConfig('not json'))

# ── pattern catch bindings: the object kind in a statement try, the array kind in a value try — separate emissions, each with its own branch ──

summarize = (raw: string) ->
  parsed = false
  try
    JSON.parse(raw)
    parsed = true
  catch {message}
    console.log('reason held:', message.length > 0)
  parsed

firstFault = ->
  try
    throw ['too short', 'no digits']
  catch [first]
    first

console.log('summarize:', summarize('nope'), 'firstFault:', firstFault())

# ── a handler-less try: the block alone, errors swallowed ──

warmup: string | null = null
try
  warmup = JSON.parse('"ready"')

console.log('warmup:', warmup)

# ── a bare catch: no binding, recovery only ──

tolerant = ->
  try
    JSON.parse('broken')
  catch
    'fallback'

console.log('tolerant:', tolerant())

# ── try/finally: cleanup without a handler ──

closed = false
readAll = ->
  try
    'contents'
  finally
    closed = true

console.log('readAll:', readAll(), 'closed:', closed)

# ── the full shape: catch and finally together ──

settle = (risky: () => string) ->
  outcome = 'pending'
  try
    outcome = risky()
  catch failure
    outcome = 'recovered'
  finally
    console.log('settled as', outcome)
  outcome

console.log(settle(-> 'delivered'), settle(-> throw new Error('nope')))

# ── try as an expression: inline, inline with a catch, and the two together ──

live = try JSON.parse('{"live":true}') as { live: boolean }
backed: { live: boolean } = try JSON.parse('broken') catch e then { live: false }
cast = try JSON.parse('broken') as { live: boolean } catch e then { live: false }

console.log('live:', live, 'backed:', backed, 'cast:', cast)

# ── try with a STATEMENT body: `return` is a statement, not an expression, so each of these four is its own production ──

earlyExit = (n: number): number ->
  try return n
  0

exitGuarded = (n: number): number ->
  try return n catch then return 0
  0

exitClosing = (n: number): number ->
  try return n
  finally
    console.log('closing')

exitBoth = (n: number): number ->
  try return n
  catch
    return 0
  finally
    console.log('both')

console.log('statement try:', earlyExit(1), exitGuarded(2), exitClosing(3), exitBoth(4))

# ── throw: the indented-object payload, and the expression position ──

reject = (code: number) ->
  throw
    code: code
    retriable: code >= 500

demand = (value: string | null) -> value ?? throw new Error('missing value')

held = try reject(503) catch caught then caught

console.log('held:', held, 'demand:', demand('present'))
