# 22-vocabulary.errors.rip — intentional negatives, each asserted by the Diagnostics Audit (bun run audit --diagnostics).
# @ts-nocheck

type Twig = { label: string, shoots: Twig[] }
type Tallies = { [slot: string]: number, entries: number }
type Crate = { inner: { depth: number } }
type Firm = { note: string | undefined }

type Manifest =
  cargo: string[]
  stow(item: string): number

coordinate: [string, number] = ['origin', 12]
hold: Manifest = { cargo: [], stow: (item) -> item.length }

def measure(sample: string): number
def measure(sample: number): string
def measure(sample: string | number): number | string
  if typeof sample is 'string' then sample.length else String(sample)

def echoOf<T extends string>(sample: T)
  sample

wrongAxis: number = coordinate[0]
wrongTwig: Twig = { label: 'trunk', shoots: [{ label: 7, shoots: [] }] }
wrongTallies: Tallies = { alpha: 1 }
wrongCrate: Crate = { inner: { depth: 'far' } }
wrongOverload: string = measure('alpha')
wrongEcho = echoOf(7)
wrongFirm: Firm = {}
wrongDrift: string | undefined = 42
wrongStow = hold.stow(42)
