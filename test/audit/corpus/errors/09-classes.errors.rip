# 09-classes.errors.rip — intentional negatives, each asserted by the Diagnostics Lane (bun run audit --diagnostics).
# @ts-nocheck

notAClass = 42
class Gauge
  level: number = 0
  constructor: (level: number) ->
    @level = level

wrongTarget = new notAClass
wrongArity = new Gauge()
wrongMember = new Gauge(1).depth
wrongKind: string = new Gauge(2)
wrongQuery: typeof Gauge = new Gauge(3)
wrongMaker: (new () => Gauge) = 'nope'
class WrongBase extends notAClass
