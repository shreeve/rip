# 09-classes.errors.rip — intentional negatives, each asserted by the Diagnostics Audit (bun run audit --diagnostics).
# @ts-nocheck

notAClass = 42
class Gauge
  level: number = 0
  constructor: (level: number) ->
    @level = level

wrongTarget = notAClass.new()
wrongArity = Gauge.new()
wrongMember = Gauge.new(1).depth
wrongKind: string = Gauge.new(2)
wrongQuery: typeof Gauge = Gauge.new(3)
wrongMaker: (new () => Gauge) = 'nope'
class WrongBase extends notAClass

class WrongSignal extends Gauge
  read: -> super.missing
