# 07-exceptions.errors.rip — intentional negatives, each asserted by the Diagnostics Audit (bun run audit --diagnostics).
# @ts-nocheck

reasonCode = 500

wrongMaybe: string = try 'value'
wrongUnion: number = try 'text' catch e then 0
wrongBuilt = -> throw new Error(reasonCode)
wrongAccess = ->
  try
    'ok'
  catch error
    error.message
