# 08-functions.errors.rip — intentional negatives, each asserted by the Diagnostics Audit (bun run audit --diagnostics).
# @ts-nocheck

def scale(amount: number): number
  amount * 2

def join(...parts: string[]): string
  parts.join('-')

def notify!(message: string)
  console.log(message)

def pick<T>(value: T): T
  value

label = 'seven'
extra = 2

wrongArgument = scale(label)
wrongReturn: string = scale(3)
wrongMissing = scale()
wrongExtra = scale(extra, extra)
wrongRest = join(extra)
wrongVoid: number = notify(label)
wrongPick: number = pick(label)
wrongTuple: [number, string] = [extra, extra]
wrongSignature: (n: number) => string = scale
