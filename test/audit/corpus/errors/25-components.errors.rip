# 25-components.errors.rip — intentional negatives asserted by the Diagnostics Audit; the ref and `<=>` rows are pinned (error-pins.json).
# The method-argument row is DOUBLE-quoted on purpose: a single-quoted literal is rewritten in the face, so its diagnostic falls back to the call's open paren (FINDINGS.md).
# @ts-nocheck

Knob = component
  tally: (step: number) -> (step + 1)

  render null

knob = new Knob({})
wrongStep = knob.tally("nope")

Swatch = component extends input
  @caption?: string

  render
    input

Tint = component
  @tone?: 'info' | 'warn' := 'info'

  render
    span 'tint'

Palettes<TShade extends string> = component
  @shades?: TShade[] := []

  render
    div 'palettes'

Liner = component
  @inner?: HTMLInputElement | null := null

  render
    input ref: inner

Shell = component
  strictEl: HTMLInputElement := null
  wrongTag: HTMLInputElement | null := null
  wrongSleeve: HTMLDivElement | null := null

  render
    div
      Swatch placeholder: 42
      Tint tone: 'nope'
      Palettes shades: [1, 2]
      input ref: strictEl
      section ref: wrongTag
      Liner inner <=> wrongSleeve




Books = component
  entries: string[] := ['open', 2]
  status := 'idle'

  post: ->
    status = 4

  render null


Gauge = component
  labels: string[] := ['idle']
  cap =! 3

  width ~= labels.length

  render null

gauge = new Gauge({})
wrongWidth: string = gauge.width.value
gauge.cap = 4
