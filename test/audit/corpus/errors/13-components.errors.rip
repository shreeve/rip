# 13-components.errors.rip — intentional negatives asserted by the Diagnostics Audit; the bind and ref rows are pinned (error-pins.json) because no honest TSX line spells the `<=>` channel and React's ref rejection fires for a different reason.
# @ts-nocheck

Chip = component
  @label?: string
  @count?: number := 0

  render
    div 'chip'

Gated = component
  stats <~ @app.data.stats

  render
    div 'gated'

Wrong = component
  wrongCell: HTMLInputElement | null := null
  amount := 0

  render
    div
      Chip label: 123
      Chip count: 'five'
      div ref: wrongCell
      Chip
        label <=> amount
      if wrongTypo
        span 'unreachable'
      if wrongText
        span 'fallback'

# the twin's Wrong body closes above; the gated-contract negatives follow

wrongMount = Gated.mount()
wrongConstruct = new Gated({})
