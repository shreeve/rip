# 13-components.errors.rip — intentional negatives asserted by the Diagnostics Audit; the bind and ref rows are pinned (error-pins.json) because no honest TSX line spells the `<=>` channel and React's ref rejection fires for a different reason.
# @ts-nocheck

Chip = component
  @label?: string
  @count?: number := 0

  render
    div 'chip'

Gated = component
  stats <~ @stash.stats

  render
    div 'gated'

Wrong = component
  wrongCell: HTMLInputElement | null := null
  amount := 0

  render
    div
      Chip label: 123
      Chip count: 'five'
      div ref: wrongCell
      Chip
        label <=> amount
      if wrongTypo
        span 'unreachable'
      if wrongText
        span 'fallback'

# the twin's Wrong body closes above; the gated-contract negatives follow

wrongMount = Gated.mount()
wrongConstruct = new Gated({})

Member = component
  wrongPlain: string = 42
  wrongState: number := 'oops'
  wrongComputed: string ~= 7 * 3
  wrongConst: number =! 'nope'
  ok := 0

  bump: ->
    ok = 'later'
    @wrongPlain = 12

  render
    div ok

Heads = component
  render
    div
      unless missingUnless
        span 'u'
      switch missingSwitch
        when 1 then span 's'
      for item in missingList
        span item
      = missingExpr

Truthy = component
  @label: string
  render
    button
      disabled: @label



Names = component
  render
    div
      input value: wrongValue
      img alt: "#{wrongInterp}"
