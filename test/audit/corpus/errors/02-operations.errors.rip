# 02-operations.errors.rip — intentional negatives, each asserted by the Diagnostics Audit (bun run audit --diagnostics).
# @ts-nocheck

text = 'abc'
count = 42
point = { x: 1 }
pair = (left: number, right: number) -> left + right

wrongLeft = text * 2
wrongRight = 2 * text
wrongUpdate = text++
wrongCompare = text is count
wrongInstance = text instanceof count
wrongCall = count()
wrongOptionalCall = count?.(1)
wrongArity = pair(1)
wrongArgument = pair(1, text)
wrongExist = missingName?
wrongDelete = delete point.x
wrongScale: ((n: number) => number) | null = 7
# the paren-less spelling of wrongArgument's excess-arity cousin: the twin anchors TS2554 on the excess argument, and the injected paren cover publishes it on the FIRST — the position violation is expected, carried by the contract (diagnostics.positions), and this row exists to keep it measured
wrongArityBare = pair 1, count, count
wrongArityParen = pair(1, count, count)
