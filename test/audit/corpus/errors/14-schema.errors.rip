# 14-schema.errors.rip — intentional negatives asserted by the Diagnostics Audit; the wrong-typed default is pinned (error-pins.json) because zod states the same wrongness with a different code.
# @ts-nocheck

Person = schema
  name!  string
  tag!   'a' | 'b'
  rank   number, ['high']

Cart = schema :shape
  items! number[]
  total: ~> @items.length

Color = schema :enum
  :red
  :green

Stamp = schema :mixin
  at string

Order = schema :shape
  @mixin Stamp
  qty!   integer, 1..99
  code!  string, -> it.code
  @ensure 'sized', (o) -> o.qty > 0

# the schema declarations close above; the negatives follow

wrongAssign: Person = { name: 42, tag: 'a' }
wrongLiteral: Person = { name: 'ok', tag: 'c' }
wrongRead = Person.parse({ name: 'x', tag: 'a' }).nope
wrongEnum: Color = 'mauve'
wrongConstruct = Person.new()
wrongGetter: string = Cart.parse({ items: [3] }).total
