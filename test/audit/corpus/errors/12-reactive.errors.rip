# 12-reactive.errors.rip — intentional negatives, each asserted by the Diagnostics Audit (bun run audit --diagnostics).
# @ts-nocheck

count := 0
limit =! 100

wrongState: number := 'oops'
wrongComputed: string ~= count * 2
wrongReadonly: number =! 'nope'
wrongEffect: number ~> console.log(count)
# (a write to the readonly `limit` now rejects at the emitter, before any type check — test/rip/redeclare.rip pins it)
