# 20-inference.errors.rip — intentional negatives, each asserted by the Diagnostics Audit (bun run audit --diagnostics).
# @ts-nocheck

counts = [1, 2, 3]
verdict = 'many'
tally = 12

if (counts.length > 2)
  banner = 'wide'

def scale(factor: number)
  (factor * 100)

def describe()
  banner

def introduceAll({ name, years: age }: { name: string, years: number })
  "#{name} is #{age}"

tally = 'oops'

wrongProduct: string = (counts.length * 2)
wrongElements: string[] = counts.map((n) -> (n * 2))
wrongCallback = counts.map((n) -> n.toUpperCase())
wrongReturn: string = scale(2)
wrongBranch: number = verdict
wrongHoisted: number = describe()
wrongDestructured = introduceAll({ name: 'Ada', years: 'old' })
