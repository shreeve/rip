# 21-checking.rip — what the checker concludes about assignability, and about a union once its discriminant is tested.

# ── The excess-property check fires on a FRESH object literal only: the same extra key is legal once it arrives through a binding ──

type Placard = { heading: string }

exactPlacard: Placard = { heading: 'welcome' }
widenedSource = { heading: 'notice', footnote: 'small print' }
inheritedPlacard: Placard = widenedSource

console.log('placards:', exactPlacard.heading, inheritedPlacard.heading)

# ── The weak-type rule: an all-optional type accepts the empty literal, and any subset of its own members ──

type Knobs = { mode?: string, depth?: number }

noKnobs: Knobs = {}
someKnobs: Knobs = { mode: 'quiet' }
allKnobs: Knobs = { mode: 'loud', depth: 3 }

console.log('knobs:', noKnobs.mode, someKnobs.mode, allKnobs.depth)

# ── switch on a union discriminant narrows the arm: each `when` sees only its own variant ──

type Ring = { form: 'ring', radius: number }
type Tile = { form: 'tile', side: number }
type Bar = { form: 'bar', length: number }
type Facet = Ring | Tile | Bar

def spanOf(facet: Facet)
  switch facet.form
    when 'ring' then (facet.radius * 2)
    when 'tile' then (facet.side * 4)
    else (facet.length)

console.log('spans:', spanOf({ form: 'ring', radius: 4 }), spanOf({ form: 'tile', side: 3 }), spanOf({ form: 'bar', length: 7 }))

# ── The same union narrowed by an else-if chain inside a loop body: the narrowing survives both ──

facets: Facet[] = [{ form: 'ring', radius: 1 }, { form: 'tile', side: 2 }, { form: 'bar', length: 5 }]
notes = for facet in facets
  if facet.form is 'ring'
    "ring #{facet.radius}"
  else if facet.form is 'tile'
    "tile #{facet.side}"
  else
    "bar #{facet.length}"

console.log('notes:', notes)
