# 25-components.rip — the component consumer face. One more row is parked (CLAIMS.md).

# ── Method faces: a typed parameter keeps its type in both member layouts, a defaulted parameter becomes optional, and the body's return reaches the caller ──

Dial = component
  reading := 0

  tally: (step: number, label = 'unit') -> "#{label}:#{step}"

  spanning: (step: number) ->
    doubled = (step * 2)
    (doubled + 1)

  render null

probe = new Dial({})
tallied: string = probe.tally(2)
spanned: number = probe.spanning(3)
dialled: string = probe.tally(4, 'step')

console.log('methods:', tallied, spanned, dialled)

# ── `component extends <tag>`: the use site accepts the element's own intrinsics, typed from the tag ──

Prompt = component extends input
  @caption?: string

  render
    input

# ── A literal-union prop keeps its union at the use site rather than widening to string ──

Ribbon = component
  @tone?: 'info' | 'warn' := 'info'

  render
    span 'ribbon'

# ── A generic component's constraint governs the use site ──

Palette<TShade extends string> = component
  @shades?: TShade[] := []

  render
    div 'palette'

Stage = component
  render
    div
      Prompt placeholder: 'type here'
      Ribbon tone: 'warn'
      Palette shades: ['dawn', 'dusk']

# ── Ref-cell nullability: an element-typed cell takes its own tag, an Element-or-null cell takes any ──

Anchors = component
  promptEl: HTMLInputElement | null := null
  anyEl: Element | null := null

  render
    div
      input ref: promptEl
      section ref: anyEl

# ── A forwarded element ref: the child's own `ref:` lands in the parent's cell through the `<=>` channel ──

Sleeve = component
  @inner?: HTMLInputElement | null := null

  render
    input ref: inner

Cuff = component
  sleeveEl: HTMLInputElement | null := null

  render
    div
      Sleeve inner <=> sleeveEl

console.log('use sites:', typeof Prompt, typeof Ribbon, typeof Palette, typeof Stage)
console.log('refs:', typeof Anchors, typeof Sleeve, typeof Cuff)

# ── A method's write to a member checks against the member's declared type, and array-typed state keeps its element type through the cell ──

Ledger = component
  entries: string[] := ['open']
  status := 'idle'

  post: (note: string) ->
    status = note
    entries = [note]

  render null

ledger = new Ledger({})
ledgerHead: string = ledger.entries.value[0]
ledgerStatus: string = ledger.status.value

console.log('state:', ledgerHead, ledgerStatus)

# ── Member-kind faces through an instance: `:=` exposes `.value`, `=!` is readonly, `=` stays plain, and `~=` types from what its body READS rather than from its shape ──

Meter = component
  labels: string[] := ['idle']
  cap =! 3
  note = 'flat'

  width ~= labels.length

  span ~=
    base = labels.length
    base + cap

  render null

meter = new Meter({})
meterWidth: number = meter.width.value
meterSpan: number = meter.span.value
meterLabel: string = meter.labels.value[0]
meterCap: number = meter.cap
meterNote: string = meter.note

console.log('members:', meterWidth, meterSpan, meterLabel, meterCap, meterNote)
