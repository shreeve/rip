# The :model persistence DSL through every corpus layer. The
# byte layer pins the emission without runtime bodies, so the
# corpus body stays runtime-free — the eval and delivery tiers live in
# the runtime test files against the runtime modules.

Organization = schema :model
  name! string

User = schema :model
  name!   string
  email!  email @unique
  handle? string, 2..24
  bio?    text
  @timestamps
  @belongsTo Organization
  @hasMany Order
  beforeSave: -> @name = @name.trim()
  afterCreate: -> console.log @id
  greet: (prefix) -> prefix + " " + @name
  slug: ~> @name.toLowerCase()

Order = schema :model
  total!  ~integer
  status! "open" | ["paid"] | "void"   # bracketed member = the default
  @belongsTo User
  @belongsTo Coupon?
  @softDelete
  @idStart 10001
  @tableWas "legacy_orders"
  @unique [:total, :status]
  @index total

Coupon = schema :model
  code! string, /^[A-Z0-9]+$/
  @scope :active, -> @where(active: true)
  @scope :since, (d) -> @where("created_at > ?", d)
  @defaultScope -> @order("id")

Pinned = schema :model, on: analytics
  name! string

Person = schema :model
  firstName! string, {was: "given_name"}
  ssn?       ~:ssn
  @mixin Stamps
  @ensure "named", (p) -> p.firstName.length > 0

# The mapping directives, all four namespaces of them: bare names are
# Rip's (a property, a model), quoted strings are the database's (a
# table, a column).
Patient = schema :model
  @table "MDM_PATIENT"
  @primary patientId, {column: "PATIENT_ID"}
  mrn!       string, {column: "MRN_NBR"}, @unique
  firstName! string
  @hasMany Study, {through: Enrollment}
  @hasOne Insurer, {as: payer, through: Enrollment}

# Declaring the pk as a field marked inline @primary is what makes it
# a caller-supplied NATURAL key: no sequence, and the INSERT writes it
# like any other column. (Standalone `@primary iso` says the same.)
Country = schema :model
  iso!  string @primary, 2..2
  name! string

# The compact pk spellings: the type slot elides to `string`, and the
# comma before a transform is optional after an inline attribute.
Ticket = schema :model
  id!  @primary -> it.id or 'T' + it.num
  num! integer

Post = schema :model
  title! string
  @belongsTo User, {as: author, foreignKey: "author_id"}
  @belongsTo User, {as: reviewer, foreignKey: "reviewer_id"}
  @hasMany Tag, {as: labels, foreignKey: "post_id"}

Inline = schema :model; label!; @timestamps; @belongsTo Person
