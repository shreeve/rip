# Layout — the ancestor a route-level remount must keep. `#brand` is the
# layout's own render-edit target; `#hits` reads the stash.
export Layout = component
  counter ~= @stash.counter

  render
    nav
      strong#brand 'fixture'
      a#nav-form href: '/form', 'form'
      a#nav-idle href: '/idle', 'idle'
      span#hits "#{counter.hits}"
    main
      div id: 'content'
