# Browser-safe public shapes. Server persistence models live in
# api/models.rip (:model is server-only and cannot enter the bundle).

export User = schema :shape
  id!        integer
  firstName! string, 1..
  lastName!  string, 1..
  email!     email
  phone?     string

export Product = schema :shape
  id!    integer
  name!  string, 1..
  price! integer, 0..
  image! string

export OrderItem = schema :shape
  productId! integer
  name!      string, 1..
  price!     integer, 0..
  image!     string
  quantity!  integer, 1..

export Order = schema :shape
  id!        integer
  total!     integer, 0..
  items!     OrderItem[]
  createdAt! datetime
