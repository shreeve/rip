# ==============================================================================
# Rip Grammar
#
# Rule shapes keep the parser's s-expressions stable — the test corpus
# pins them byte-for-byte.
#
# Each rule is:  o pattern, action, annotation?, options?
#   - action is the s-expression construction template ('["=", {}, 1, 3]':
#     the head, the attribute record, then the children)
#   - annotation (string) names the semantic kind and one part per template
#     element ('assign: operator, target, value'; '_' marks structural
#     constants) — validated by Solar against the template, and the
#     template against its kind's forms in the Kind Registry below. A nested
#     template array is '_' (opaque scaffold), '_(part, …)' (transparent:
#     its parts are roles of this node), or 'role(kind: part, …)' (a
#     node of its own, registered with its span; this node's `role`
#     points at it)
#   - options (object) carries operator precedence (prec: '...')
#
# Pattern sugar (expanded by Solar, one rule per variant): 'X?' makes a
# symbol optional, '(A B)?' a run of symbols, '(A | B)' picks one
# alternative. Bindings let one action serve every variant — '@name'
# is the labeled symbol's value (["none", {}] where its group is absent),
# '...@name' a spread that drops out when absent, and `key: @name?` in
# an attribute record the flag, present only when the symbol is.
#
# Three conventions the rows below lean on, stated once:
#   - ERASURE: a labeled symbol the template drops (TYPE[annotation],
#     OPT_MARKER[optionalMarker], TYPE_PARAMS[typeParams],
#     VOID_MARKER[voidMarker], REACTIVE_ASSIGN[operator], …) records
#     its span as a side-band role of the node while the s-expression
#     stays byte-identical to the unlabeled form. The type story lives
#     in RoleStore and the TS face; the JS never sees it. A dropped
#     TYPE's role names its value (the types entry's tree) by
#     childNodeId, and the parse result's entryValues holds it. A row that
#     says a token "erases as <role>" means exactly this.
#   - HEADS: every call is ["call", attrs, callee, …args], so a call
#     never spells another head: `state a, 0` builds a call of `state`,
#     never the ["state", …] node `a := 0` builds. A plumbing list (a
#     parameter, specifier or condition list) can begin with any name,
#     so the node's semantic kind identifies it. The void family
#     (`void-assign`, `void-readonly`, `void-def`, `void-pair`) takes a
#     word-form head, so its `=`/`:` token carries the operator label
#     instead.
#   - "THE EMITTER REJECTS": the shape parses on purpose so the emitter
#     can position a precise diagnostic; src/emitter.js owns the rule.
# ==============================================================================

o = (pattern, action, ...extras) ->
  pattern = pattern.trim().replace /\s{2,}/g, ' '
  [pattern, action ?? 1, ...extras]

# A comma/newline list nonterminal — the standard row set every
# specifier/argument/pair/param list shares: one item, comma append,
# newline append, and the indented-block splice. `name` is the list's
# own nonterminal (the rules are left-recursive), `element` its item.
# Options: `empty` admits the zero-item form (its value is that row's
# annotation reason), `indented` adds the fully-indented pass-through
# form, and `reason` is the span-plumbing opt-out naming the role
# owner for every accumulating row.
list = (name, element, {empty, indented, reason}) ->
  plumbing = "~ #{reason}"
  rows = []
  rows.push o('', '[]', "~ #{empty}") if empty
  rows.push o(element, '[1]', plumbing)
  rows.push o("#{name} , #{element}", '[...1, 3]', plumbing)
  rows.push o("#{name} OptComma TERMINATOR #{element}", '[...1, 4]', plumbing)
  rows.push o("INDENT #{name} OptComma OUTDENT", 2) if indented
  rows.push o("#{name} OptComma INDENT #{name} OptComma OUTDENT", '[...1, ...4]', plumbing)
  rows

# The value forms every `=`-family declaration shares: inline, wrapped
# onto the next line, or an indented single expression. Flat (not a
# nonterminal) so the automaton keeps its exact states.
RHS = '(Expression[value] | TERMINATOR Expression[value] | INDENT Expression[value] OUTDENT)'

grammar =

  # ============================================================================
  # Program Structure
  # ============================================================================

  Root: [
    o ''    , '["program", {}]'      , 'program: _, _'
    o 'Body', '["program", {}, ...1]', 'program: _, _, ...body'
  ]

  Body: [
    o 'Line'                , '[1]'      , '~ statement-list plumbing; program.body owns the span'
    o 'Body TERMINATOR Line', '[...1, 3]', '~ statement-list plumbing; program.body owns the span'
    o 'Body TERMINATOR'
  ]

  Line: [
    o 'Expression'
    o 'Statement'
  ]

  Statement: [
    o 'Return'
    o 'STATEMENT'
    o 'Import'
    o 'Export'
    o 'TypeDecl'
  ]

  # ============================================================================
  # Erased type statements — whole statements that compile to
  # NOTHING. TYPE_DECL is a `type`/`interface` declaration the lexer
  # collapsed into one token (raw text as its value — opaque to the
  # grammar; declaration emission structures it, src/ts/dts.js);
  # `Assignable TYPE` is a bare typed forward
  # declaration (`r: T` alone on its line — erased completely).
  # Both construct real nodes so their spans reach
  # the side tables; the emitter filters them from every statement
  # list and emits zero bytes.
  # ============================================================================

  TypeDecl: [
    o 'TYPE_DECL'                    , '["type-decl", {}, 1]'    , 'typedecl: _, _, declaration'
    # PRIVATE is the class-member modifier on a bodiless typed field
    # (`private x: T`), erased as the visibility side-band role.
    o '(PRIVATE[visibility])? Assignable[target] TYPE[annotation]'                            , '["typed-var", {}, @target, @annotation]', 'typedvar: _, _, target, annotation'
    # Optional-marked bodiless typed prop: `@label?: string` —
    # the marker drops as the side-band optionalMarker role beside the
    # annotation; the wrapper is the unmarked form's.
    o '(PRIVATE[visibility])? Assignable[target] OPT_MARKER[optionalMarker] TYPE[annotation]', '["typed-var", {}, @target, @annotation]', 'typedvar: _, _, target, annotation'
    # Bodiless typed-def OVERLOAD signature (`def f(a: T): R` with no
    # body): erases to nothing at emission and exists FOR the d.ts
    # consumer. The return TYPE is required — a bodiless def
    # WITHOUT one stays the loud missing-body parse error, so a
    # forgotten body can never erase silently.
    o 'DEF Identifier OptParams TYPE', '["def-sig", {}, 2, 3, 4]', 'defsig: _, _, name, params, returnType'
    o 'DEF Identifier TYPE_PARAMS[typeParams] OptParams TYPE', '["def-sig", {}, 2, 4, 5]', 'defsig: _, _, name, params, returnType'
  ]

  # ============================================================================
  # Modules
  # ============================================================================

  Import: [
    # A SIDE-EFFECT import carries no clause and none is minted for it:
    # its spec is absent, distinct from `import {} from …` (an empty spec
    # list), whose
    # empty named list reads to TypeScript as a clause waiting to be filled.
    o 'IMPORT STRING'                                                                           , '["import", {}, ["none", {}], ["none", {}], ["none", {}], 2]'                , 'import: _, _, _, _, _, source'
    o 'IMPORT ImportDefaultSpecifier FROM STRING'                                               , '["import", {}, 2, ["none", {}], ["none", {}], 4]'             , 'import: _, _, spec, _, _, source'
    o 'IMPORT ImportNamespaceSpecifier FROM STRING'                                             , '["import", {}, 2, ["none", {}], ["none", {}], 4]'             , 'import: _, _, spec, _, _, source'
    o 'IMPORT { } FROM STRING'                                                                  , '["import", {}, [], ["none", {}], ["none", {}], 5]'          , 'import: _, _, spec, _, _, source'
    o 'IMPORT { ImportSpecifierList OptComma } FROM STRING'                                     , '["import", {}, 3, ["none", {}], ["none", {}], 7]'             , 'import: _, _, spec, _, _, source'
    o 'IMPORT ImportDefaultSpecifier , ImportNamespaceSpecifier FROM STRING'                    , '["import", {}, 2, 4, ["none", {}], 6]'          , 'import: _, _, spec, extra, _, source'
    o 'IMPORT ImportDefaultSpecifier , { ImportSpecifierList OptComma } FROM STRING'            , '["import", {}, 2, 5, ["none", {}], 9]'          , 'import: _, _, spec, extra, _, source'
    # Import attributes (`import data from './d.json' with { type: 'json' }`):
    # the clause rides BEFORE the source so the source stays last (every
    # consumer reads the specifier there); the emitter prints it after.
    o 'IMPORT STRING WITH Object'                                                               , '["import", {}, ["none", {}], ["none", {}], [3, {}, 4], 2]'        , 'import: _, _, _, _, attributes(withattrs: keyword, _, value), source'
    o 'IMPORT ImportDefaultSpecifier FROM STRING WITH Object'                                   , '["import", {}, 2, ["none", {}], [5, {}, 6], 4]'     , 'import: _, _, spec, _, attributes(withattrs: keyword, _, value), source'
    o 'IMPORT ImportNamespaceSpecifier FROM STRING WITH Object'                                 , '["import", {}, 2, ["none", {}], [5, {}, 6], 4]'     , 'import: _, _, spec, _, attributes(withattrs: keyword, _, value), source'
    o 'IMPORT { ImportSpecifierList OptComma } FROM STRING WITH Object'                         , '["import", {}, 3, ["none", {}], [8, {}, 9], 7]'     , 'import: _, _, spec, _, attributes(withattrs: keyword, _, value), source'
    o 'IMPORT ImportDefaultSpecifier , ImportNamespaceSpecifier FROM STRING WITH Object'        , '["import", {}, 2, 4, [7, {}, 8], 6]'  , 'import: _, _, spec, extra, attributes(withattrs: keyword, _, value), source'
    o 'IMPORT ImportDefaultSpecifier , { ImportSpecifierList OptComma } FROM STRING WITH Object', '["import", {}, 2, 5, [10, {}, 11], 9]', 'import: _, _, spec, extra, attributes(withattrs: keyword, _, value), source'
    # A TYPE-ONLY import (`import type … from …`): the keyword rides the
    # side-band typeOnly role and the node keeps the plain import's
    # shape, so everything that consumes an import statement consumes
    # this one. The author is declaring the module carries no side
    # effect they need — the statement erases from the JS whole, and
    # the TS face keeps it as `import type …`. The combined
    # default-plus-clause rows have no type-only mirror on purpose:
    # TypeScript rejects `import type D, { A } from …` (TS1363), and a
    # side-effect `import type 'mod'` names a contradiction.
    o 'IMPORT IMPORT_TYPE[typeOnly] ImportDefaultSpecifier FROM STRING'                         , '["import", {}, 3, ["none", {}], ["none", {}], 5]'             , 'import: _, _, spec, _, _, source'
    o 'IMPORT IMPORT_TYPE[typeOnly] ImportNamespaceSpecifier FROM STRING'                       , '["import", {}, 3, ["none", {}], ["none", {}], 5]'             , 'import: _, _, spec, _, _, source'
    o 'IMPORT IMPORT_TYPE[typeOnly] { } FROM STRING'                                            , '["import", {}, [], ["none", {}], ["none", {}], 6]'          , 'import: _, _, spec, _, _, source'
    o 'IMPORT IMPORT_TYPE[typeOnly] { ImportSpecifierList OptComma } FROM STRING'               , '["import", {}, 4, ["none", {}], ["none", {}], 8]'             , 'import: _, _, spec, _, _, source'
  ]

  ImportSpecifierList: list 'ImportSpecifierList', 'ImportSpecifier', indented: true, reason: 'specifier plumbing; import.spec owns the span'

  ImportSpecifier: [
    o 'Identifier'
    o 'Identifier AS Identifier', '["as", {}, 1, 3]', 'as: _, _, name, alias'
    o 'DEFAULT'
    o 'DEFAULT AS Identifier'   , '["as", {}, 1, 3]', 'as: _, _, name, alias'
  ]

  ImportDefaultSpecifier: [
    o 'Identifier'
  ]

  ImportNamespaceSpecifier: [
    o 'IMPORT_ALL AS Identifier', '["as", {}, "*", 3]', 'as: _, _, name, alias'
  ]

  Export: [
    o 'EXPORT { }'                                         , '["export", {}, []]'               , 'export: _, _, spec'
    o 'EXPORT { ExportSpecifierList OptComma }'            , '["export", {}, 3]'                  , 'export: _, _, spec'
    o 'EXPORT Class'                                       , '["export", {}, 2]'                  , 'export: _, _, spec'
    o 'EXPORT Def'                                         , '["export", {}, 2]'                  , 'export: _, _, spec'
    o 'EXPORT ExportAssign'                                , '["export", {}, 2]'                  , 'export: _, _, spec'
    # Exported reactive declarations: the ReactiveAssign /
    # ComputedAssign node itself carries the roles (operator label,
    # typed annotation label), so the nested template loses nothing.
    o 'EXPORT ReactiveAssign'                              , '["export", {}, 2]'                  , 'export: _, _, spec'
    o 'EXPORT ComputedAssign'                              , '["export", {}, 2]'                  , 'export: _, _, spec'
    # Exported readonly: `export x =! 5` → `export const x = 5;`
    o 'EXPORT Readonly'                                    , '["export", {}, 2]'                  , 'export: _, _, spec'
    # Exported effects: only the BOUND form has a meaning
    # (`export const h = __effect(…)`); the emitter rejects a bare
    # `export ~>` — nothing binds.
    o 'EXPORT Effect'                                      , '["export", {}, 2]'                  , 'export: _, _, spec'
    # prec REACTIVE_ASSIGN (below POST_IF/POST_UNLESS): a postfix guard
    # after the default value shifts INTO the Expression — the value is
    # conditional, the export is not (an export has no guardable
    # statement form).
    o 'EXPORT DEFAULT Expression'                          , '["export-default", {}, 3]'          , 'export: _, _, spec', prec: 'REACTIVE_ASSIGN'
    o 'EXPORT DEFAULT INDENT Object OUTDENT'               , '["export-default", {}, 4]'          , 'export: _, _, spec'
    o 'EXPORT EXPORT_ALL FROM STRING'                      , '["export-all", {}, 4, ["none", {}]]'              , 'export: _, _, source, _'
    # `export * as ns from` / `export * as default from` (DEFAULT is
    # contextual after AS on an export line).
    o 'EXPORT EXPORT_ALL AS (Identifier[alias] | DEFAULT[alias]) FROM STRING[source]', '["export-all", {}, @source, @alias]', 'export: _, _, source, alias'
    o 'EXPORT { } FROM STRING'                             , '["export-from", {}, [], 5]'       , 'export: _, _, spec, source'
    o 'EXPORT { ExportSpecifierList OptComma } FROM STRING', '["export-from", {}, 3, 7]'          , 'export: _, _, spec, source'
    # A TYPE-ONLY re-export (`export type { … } from …`), the mirror of
    # `import type`: the keyword rides the side-band typeOnly role and
    # the node keeps the plain re-export's shape. The statement erases
    # from the JS whole — the module is never loaded for it — and the
    # TS face and the declarations keep it as `export type …`. One
    # spelling: no per-specifier `type`, and no source-less form, since
    # a local type exports at its own declaration.
    o 'EXPORT EXPORT_TYPE[typeOnly] { ExportSpecifierList OptComma } FROM STRING', '["export-from", {}, 4, 8]', 'export: _, _, spec, source'
  ]

  # An exported binding (`export x = v`; typed `export x: T = v`).
  # Flat rules rather than a nested ["export", {}, ["=", …]] template so
  # the assign node EXISTS to carry roles — the typed forms hang the
  # pattern label on it (a nested template cannot carry side-band
  # roles), and the untyped forms gain ordinary assign side-table rows.
  # prec REACTIVE_ASSIGN on the `=` rows: a postfix guard shifts INTO
  # the value (`export x = v if c` exports a conditional value), as
  # the reactive tier already reads it — `if (c) export …` is not JS.
  ExportAssign: [
    o "Identifier[target] (TYPE[annotation])? = #{RHS}"                                                                                , '["=", {}, @target, @value]'          , 'assign: operator, _, target, value', prec: 'REACTIVE_ASSIGN'
    # Exported generic component: the Assign row's TYPE_PARAMS twin
    # (inline only, as there).
    o 'Identifier[target] TYPE_PARAMS[typeParams] = Expression[value]'                                                                 , '["=", {}, @target, @value]'          , 'assign: operator, _, target, value', prec: 'REACTIVE_ASSIGN'
    # Exported void definition (`export save! = ->`): the Assign row's
    # void twin, flat for the same role-carrying reason.
    o "Identifier[target] VOID_MARKER[voidMarker] =[operator] #{RHS}"                                                                  , '["=", {void: true}, @target, @value]', 'assign: _, _, target, value'       , prec: 'REACTIVE_ASSIGN'
    # Exported void readonly definition (`export save! =! ->`): the
    # readonly row's void twin, flat for the same reason.
    o "Identifier[target] VOID_MARKER[voidMarker] READONLY_ASSIGN[operator] #{RHS}"                                                    , '["readonly", {void: true}, @target, @value]', 'readonly: _, _, target, value'   , prec: 'REACTIVE_ASSIGN'
    # Exported TYPED reactive declarations (`export count: number := 0`):
    # after `EXPORT Identifier` the parser shifts a TYPE into these flat
    # rows (the typed ExportAssign path), so the reactive twins must
    # exist here too — the untyped forms ride `EXPORT ReactiveAssign` /
    # `EXPORT ComputedAssign` (adding them here as well would be a
    # reduce-reduce ambiguity).
    o "Identifier[target] TYPE[annotation] REACTIVE_ASSIGN[operator] #{RHS}"                                                           , '["state", {}, @target, @value]'      , 'state: _, _, target, value'
    o 'Identifier[target] TYPE[annotation] COMPUTED_ASSIGN[operator] (Expression[value] | TERMINATOR Expression[value] | Block[value])', '["computed", {}, @target, @value]'   , 'computed: _, _, target, value'
    o "Identifier[target] TYPE[annotation] READONLY_ASSIGN[operator] #{RHS}"                                                           , '["readonly", {}, @target, @value]'   , 'readonly: _, _, target, value'
    o 'Identifier[target] TYPE[annotation] EFFECT[operator] (Expression[value] | TERMINATOR Expression[value] | Block[value])'         , '["effect", {}, @target, @value]'     , 'effect: _, _, target, value'
  ]

  ExportSpecifierList: list 'ExportSpecifierList', 'ExportSpecifier', indented: true, reason: 'specifier plumbing; export.spec owns the span'

  ExportSpecifier: [
    o 'Identifier'
    o 'Identifier AS Identifier', '["as", {}, 1, 3]', 'as: _, _, name, alias'
    o 'Identifier AS DEFAULT'   , '["as", {}, 1, 3]', 'as: _, _, name, alias'
    o 'DEFAULT'
    o 'DEFAULT AS Identifier'   , '["as", {}, 1, 3]', 'as: _, _, name, alias'
  ]

  # ============================================================================
  # Expressions
  # ============================================================================

  Expression: [
    o 'Value'
    o 'Code'
    o 'Operation'
    o 'Assign'
    o 'ReactiveAssign'
    o 'ComputedAssign'
    o 'Gate'
    o 'Readonly'
    o 'Effect'
    o 'If'
    o 'Try'
    o 'For'
    o 'Switch'
    o 'While'
    o 'Throw'
    o 'Def'
    o 'Class'
    o 'Schema'
    o 'Component'
    o 'Render'
  ]

  Value: [
    o 'Assignable'
    o 'Literal'
    o 'Parenthetical'
    o 'Range'
    o 'Invocation'
    o 'DoIife'
    o 'This'
    o 'Super'
    o 'SuffixedCall'
  ]

  # The calls a suffix on a value spells.
  SuffixedCall: [
    # The dammit operator: `f!` is the awaited call, a call node with
    # the `await` attribute. DAMMIT is labeled so the `!` keeps its span:
    # the lowering's `await` is synthetic, and a diagnostic on that
    # keyword (TS80007) must land on the one character that means await.
    o 'Value DAMMIT[operator]'   , '["call", {await: true}, 1]', 'dammit: _, _, callee'
    # Tagged templates: a string against a value (`tag"x"`) or
    # bridged by `$` (`sh $"cmd"`) calls the tag with the template.
    o 'Value TEMPLATE_TAG String', '["tagged-template", {}, 1, 3]', 'tagged: _, _, tag, str'
  ]

  # A plain gate's source: every Value form but the plain call `f(args)`,
  # so `target <~ path(args)` has only the keyed reading (Gate).
  GateSource: [
    o 'Assignable'
    o 'Literal'
    o 'Parenthetical'
    o 'Range'
    o 'MarkedInvocation'
    o 'DoIife'
    o 'This'
    o 'Super'
    o 'SuffixedCall'
  ]

  # Atom is a grammatical POSITION, not just an alternation:
  # ObjAssignable references it for valid object keys,
  # deliberately excluding true/null/undefined — those live on Literal.
  Literal: [
    o 'Atom'
    o 'Regex'
    o 'UNDEFINED'
    o 'NULL'
    o 'BOOL'
  ]

  Atom: [
    o 'NUMBER'
    o 'String'
    # Symbol literals: `:name` is Symbol.for("name") — interned,
    # identity-comparable across modules.
    o 'SYMBOL', '["symbol", {}, 1]', 'symbol: _, _, name'
  ]

  String: [
    o 'STRING'
    o 'STRING_START Interpolations STRING_END', '["str", {}, ...2]', 'str: _, _, ...parts'
  ]

  Interpolations: [
    o 'InterpolationChunk'               , '[1]'      , '~ chunk plumbing; str.parts owns the span'
    o 'Interpolations InterpolationChunk', '[...1, 2]', '~ chunk plumbing; str.parts owns the span'
  ]

  InterpolationChunk: [
    o 'INTERPOLATION_START Body INTERPOLATION_END', 2
    o 'INTERPOLATION_START INDENT Body OUTDENT INTERPOLATION_END', 3
    o 'INTERPOLATION_START INTERPOLATION_END'     , '["none", {}]', '~ an empty interpolation is an absent part; str.parts owns the span'
    o 'String'
  ]

  Regex: [
    o 'REGEX'
    # Interpolated heregex: stripped chunks + expressions, lowered by
    # the emitter to a RegExp(...) call. HEREGEX_END's value is the
    # flags text ('' when none).
    o 'HEREGEX_START Interpolations HEREGEX_END', '["here-regex", {}, 3, ...2]', 'heregex: _, _, flags, ...parts'
  ]

  Identifier: [
    o 'IDENTIFIER'
  ]

  Property: [
    o 'PROPERTY'
  ]

  # ============================================================================
  # Assignment
  # ============================================================================

  Assign: [
    # Plain, optional-marked (`@name? = v`), and typed (`x: T = v`)
    # declarations in one row: TYPE (the collapsed `: T` run) erases as
    # annotation and OPT_MARKER as optionalMarker; the typed optional
    # pair carries both, and the TS face renders `name?: string` from them.
    # PRIVATE is the class-member modifier (`private x: T = v`), erased
    # as the visibility side-band role; the lexer mints it only at the
    # head of a class body's member line.
    o "(PRIVATE[visibility])? Assignable[target] (OPT_MARKER[optionalMarker])? (TYPE[annotation])? = #{RHS}", '["=", {}, @target, @value]', 'assign: operator, _, target, value'
    # String-NAMED members: `"data-src" = v` — legal only as a class
    # field (the TS spelling for names identifiers cannot carry); the
    # emitter rejects the shape everywhere else.
    o '(PRIVATE[visibility])? STRING[target] (TYPE[annotation])? = Expression[value]', '["=", {}, @target, @value]'          , 'assign: operator, _, target, value'
    # Generic component declaration (`Select<T extends Shape> = component
    # extends select`): the lexer mints TYPE_PARAMS only when `= component`
    # follows on the same line, so the row cannot claim ordinary
    # assignments and has no wrapped forms. TYPE_PARAMS erases as
    # typeParams; the TS face re-emits it on the lowered class.
    o 'Assignable[target] TYPE_PARAMS[typeParams] = Expression[value]'               , '["=", {}, @target, @value]'          , 'assign: operator, _, target, value'
    o 'SimpleAssignable[target] COMPOUND_ASSIGN[operator] (Expression[value] | INDENT Expression[value] OUTDENT | TERMINATOR Expression[value])', '[@operator, {}, @target, @value]'    , 'assign: operator, _, target, value'

    # Void definition (`save! = ->`): the bang on the target name marks
    # the assigned function void (no implicit return). Word-form head
    # (`=!` is the readonly glyph); VOID_MARKER erases as voidMarker.
    # Plain-name targets only — the lexer mints VOID_MARKER solely before
    # `=` — and the emitter requires a function value.
    o "Identifier[target] VOID_MARKER[voidMarker] =[operator] #{RHS}"                , '["=", {void: true}, @target, @value]', 'assign: _, _, target, value'
    # Void readonly definition (`save! =! ->`): the void marker and the
    # readonly glyph compose — a function that never changes and never
    # returns a value.
    o "Identifier[target] VOID_MARKER[voidMarker] READONLY_ASSIGN[operator] #{RHS}"  , '["readonly", {void: true}, @target, @value]', 'readonly: _, _, target, value'
  ]

  Assignable: [
    o 'SimpleAssignable'
    o 'Array'
    o 'Object'
  ]

  # ============================================================================
  # Reactive declarations: ["state", {}, target, value] and
  # ["computed", {}, target, value]. The operator token erases as
  # operator; typed twins (`count: number := 0`)
  # erase TYPE as annotation. The rows sit BELOW POST_IF/POST_UNLESS in
  # precedence, so a postfix guard shifts INTO the value (`count := 0 if c`
  # declares count with a conditional initializer; a const declaration
  # has no guardable statement form).
  # ============================================================================

  # The reactive-declaration value forms: inline, wrapped onto the
  # next line, or an indented single expression. Pass-throughs — the
  # value is the Expression; the family rule that uses the form owns
  # the node. The wrapped form carries the declaration tier's
  # precedence (REACTIVE_ASSIGN, COMPUTED_ASSIGN, READONLY_ASSIGN and
  # EFFECT share it), so an operator after the value shifts — the
  # expression reads greedily, exactly as the inline form does.
  Rhs: [
    o 'Expression'
    o 'TERMINATOR Expression'    , 2, prec: 'REACTIVE_ASSIGN'
    o 'INDENT Expression OUTDENT', 2
  ]

  # As Rhs, with a full Block as the indented form (bodies that
  # compute, not single values).
  BlockRhs: [
    o 'Expression'
    o 'TERMINATOR Expression', 2, prec: 'REACTIVE_ASSIGN'
    o 'Block'
  ]

  # Optional-marked declarations (`@name? := default`, an optional prop
  # with a default): OPT_MARKER is a distinct lexer-minted kind — a tight
  # `?` on a name whose line continues with `:=` — so the postfix
  # existence check's grammar is untouched. It erases as optionalMarker;
  # the lowering is the unmarked one (optionality changes nothing at
  # runtime).
  ReactiveAssign: [
    o 'Assignable[target] OPT_MARKER[optionalMarker]? TYPE[annotation]? REACTIVE_ASSIGN[operator] Rhs[value]'     , '["state", {}, @target, @value]', 'state: _, _, target, value'
  ]

  ComputedAssign: [
    o 'Assignable[target] OPT_MARKER[optionalMarker]? TYPE[annotation]? COMPUTED_ASSIGN[operator] BlockRhs[value]', '["computed", {}, @target, @value]', 'computed: _, _, target, value'
  ]

  # Render-ready gates bind a private reactive component member to a
  # literal @stash path. The emitter validates component placement,
  # target visibility, path shape, and keyed-source form. A called path
  # keeps its argument list as a spread `key` role so bad arity still
  # reaches the emitter as a precise diagnostic and every key span
  # carries its own mapped position. The plain form's source is a
  # GateSource, never a plain call, so a trailing argument list has one
  # reading: the keyed form's.
  Gate: [
    o 'Assignable[target] TYPE[annotation]? GATE[operator] GateSource[rhs]'                                     , '["gate", {}, @target, @rhs]'         , 'gate: _, _, target, rhs'
    o 'Assignable[target] TYPE[annotation]? GATE[operator] Value[rhs] CALL_START CALL_END'                      , '["gate", {}, @target, @rhs]'         , 'gate: _, _, target, rhs'
    o 'Assignable[target] TYPE[annotation]? GATE[operator] Value[rhs] CALL_START ArgList[key] OptComma CALL_END', '["gate", {}, @target, @rhs, ...@key]', 'gate: _, _, target, rhs, ...key'
  ]

  # Readonly declarations (locked head; lowers to a plain `const`, no
  # runtime call — `__readonly` stays surface-unreachable). Form set and
  # precedence follow the state rows exactly: the INDENT body takes ONE
  # expression, and a postfix guard shifts INTO the value (`x =! 5 if c`
  # declares unconditionally with a conditional initializer).

  Readonly: [
    o 'Assignable[target] OPT_MARKER[optionalMarker]? TYPE[annotation]? READONLY_ASSIGN[operator] Rhs[value]', '["readonly", {}, @target, @value]', 'readonly: _, _, target, value'
  ]

  # ============================================================================
  # Reactive effects (["effect", {}, target, body], the target absent
  # in the bare form). The
  # BOUND form (`h ~> body`) binds the dispose handle as a plain const;
  # the BARE form runs for its subscriptions. EFFECT erases as operator
  # and the bound typed twin (`h: T ~> body`) erases TYPE as annotation.
  # Precedence sits with REACTIVE_ASSIGN, below POST_IF/POST_UNLESS: a
  # postfix guard shifts INTO the body (`~> f() if c` runs the effect
  # unconditionally with a conditional body).
  # ============================================================================

  Effect: [
    o 'Assignable[target] TYPE[annotation]? EFFECT[operator] BlockRhs[value]', '["effect", {}, @target, @value]', 'effect: _, _, target, value'
    o 'EFFECT[operator] BlockRhs[value]'                                     , '["effect", {}, ["none", {}], @value]'   , 'effect: _, _, target, value'
  ]

  SimpleAssignable: [
    o 'Identifier'
    o 'ThisProperty'
    o 'Subjectable . Property'                                             , '[".", {}, 1, 3]'                , 'member: operator, _, object, property'
    o 'Subjectable ?. Property'                                            , '["?.", {}, 1, 3]'               , 'member: operator, _, object, property'
    o 'Subjectable[object] INDEX_START (Expression[key] | INDENT Expression[key] OUTDENT) INDEX_END', '["[]", {}, @object, @key]'      , 'index: operator, _, object, key'
    # Regex capture index: `text[/re/, n]` — the match's nth capture
    # (the emitter requires a regex-literal key; any other two-part
    # index rejects loudly there).
    o 'Subjectable INDEX_START Expression , Expression INDEX_END'          , '["regex-index", {}, 1, 3, 5]'   , 'regexindex: _, _, object, key, capture'
    o 'Subjectable[object] INDEX_START (Slice[key] | INDENT Slice[key] OUTDENT) INDEX_END', '["[]", {}, @object, @key]'      , 'index: operator, _, object, key'
    # Optional index (`a?.[k]`); Expression keys only — slices have no
    # optional form.
    o 'Subjectable[object] ES6_OPTIONAL_INDEX INDEX_START (Expression[key] | INDENT Expression[key] OUTDENT) INDEX_END', '["optindex", {}, @object, @key]', 'optindex: _, _, object, key'
    # Pick (`obj.{a, b: c, d = e}` → `{a: obj.a, c: obj.b, d: obj.d ?? e}`):
    # one kind covers both heads, `.{}`/`?.{}` discriminating optionality
    # exactly as member's '.'/'?.' does.
    o 'Subjectable PICK_START    PickList OptComma PICK_END'               , '[".{}", {}, 1, ...3]'          , 'pick: _, _, source, ...items'
    o 'Subjectable OPTPICK_START PickList OptComma PICK_END'               , '["?.{}", {}, 1, ...3]'          , 'pick: _, _, source, ...items'
    o 'Subjectable PICK_START    INDENT PickList OptComma OUTDENT PICK_END', '[".{}", {}, 1, ...4]'          , 'pick: _, _, source, ...items'
    o 'Subjectable OPTPICK_START INDENT PickList OptComma OUTDENT PICK_END', '["?.{}", {}, 1, ...4]'          , 'pick: _, _, source, ...items'
    # import.meta: a member node whose object is the token's own value
    # ('import'), so chains read through it (`import.meta.url`).
    o 'IMPORT_META . Property'                                             , '[".", {}, 1, 3]'                , 'member: operator, _, object, property'
    o 'NEW_TARGET . Property'                                              , '[".", {}, 1, 3]'                , 'member: operator, _, object, property'
  ]

  # Subjectable — anything that can carry a postfix accessor chain. Code
  # joins Value so an arrow function is a chain subject too: a leading-dot
  # chain line binds a whole single-liner as its receiver
  # (`x = -> f 1` + `.toString()` reads `(-> f(1)).toString()`).
  Subjectable: [
    o 'Value'
    o 'Code'
  ]

  # ============================================================================
  # Functions (arrows). `->` binds its own `this`; `=>` is lexical.
  # 'ArrowKind Block' embeds a nested [] (un-annotatable); the
  # parameterized forms carry the roles. Block bodies only: single-line
  # bodies need the rewriter's implicit INDENT — any other parse
  # would silently diverge from the pinned sexpr shape.
  # ============================================================================

  Code: [
    o 'PARAM_START ParamList PARAM_END ArrowKind Block', '[4, {}, 2, 5]' , 'func: kind, _, params, body'
    # Arrow return type (`(a): T -> body`): TYPE erases as returnType.
    o 'PARAM_START ParamList PARAM_END TYPE[returnType] ArrowKind Block', '[5, {}, 2, 6]' , 'func: kind, _, params, body'
    o 'ArrowKind Block'                                , '[1, {}, [], 2]', 'func: kind, _, _, body'
  ]

  ArrowKind: [
    o '->'
    o '=>'
  ]

  # do-IIFE: `do ->` (and `do (x) ->`) invokes the function immediately;
  # identifier params capture the enclosing variables of the same name
  # as call arguments, default params pass their default value. The
  # function may stand in parentheses (`do (-> 1)`); the emitter rejects
  # anything else there. The lexer retags DO to DO_IIFE and rejects a
  # `do` heading anything but a function or a parenthesis.
  DoIife: [
    o 'DO_IIFE Code', '["do-iife", {}, 2]', 'doiife: _, _, func'
    o 'DO_IIFE Parenthetical', '["do-iife", {}, 2]', 'doiife: _, _, func'
  ]

  # ============================================================================
  # This
  # ============================================================================

  This: [
    o 'THIS'
    # `@` alone is the `this` leaf, spelled `@`.
    o '@'   , '["this", {}, "@"]', 'this: _, _, _'
  ]

  # No object role: the `@` spelling has no object to name, and a
  # literal-sourced role records a SPAN-LESS row over the emitted
  # `this`, which reads as synthetic and shadows the member's own
  # cover. Without it the emitted `this.name` maps through that cover
  # to `@name` — so a diagnostic anchored at the lowering's `this`
  # (every wrong-typed `@name = v` write) reaches the source instead
  # of dropping in transit.
  ThisProperty: [
    o '@ Property', '[".", {}, "this", 2]', 'member: operator, _, _, property'
    # Static string-named member: `@"data-src" = v` in a class body;
    # anywhere else the read is this["data-src"].
    o '@ STRING'  , '[".", {}, "this", 2]', 'member: operator, _, _, property'
  ]

  # ============================================================================
  # Arrays (with sparse-array elisions: [1,, 2])
  # ============================================================================

  Array: [
    o '[ ]'         , '["array", {}]'            , 'array: _, _'
    o '[ Elisions ]', '["array", {}, ...2]'      , 'array: _, _, ...elisions'
    o '[ ArgElisionList OptElisions ]', '["array", {}, ...2, ...3]', 'array: _, _, ...items, ...elisions'
  ]

  ArgElisionList: [
    o 'ArgElision'
    o 'ArgElisionList , ArgElision'                  , '[...1, ...3]', '~ element plumbing; array.items owns the span'
    o 'ArgElisionList OptComma TERMINATOR ArgElision', '[...1, ...4]', '~ element plumbing; array.items owns the span'
    o 'INDENT ArgElisionList OptElisions OUTDENT'    , '[...2, ...3]', '~ element plumbing; array.items owns the span'
    o 'ArgElisionList OptElisions INDENT ArgElisionList OptElisions OUTDENT', '[...1, ...2, ...4, ...5]', '~ element plumbing; array.items owns the span'
  ]

  ArgElision: [
    o 'Arg'         , '[1]'      , '~ element plumbing; array.items owns the span'
    o 'Elisions Arg', '[...1, 2]', '~ element plumbing; array.items owns the span'
  ]

  OptElisions: [
    o 'OptComma'  , '[]'    , '~ elision plumbing; array.items owns the span'
    o ', Elisions', '[...2]', '~ elision plumbing; array.items owns the span'
  ]

  Elisions: [
    o 'Elision'         , '[1]'      , '~ elision plumbing; array.items owns the span'
    o 'Elisions Elision', '[...1, 2]', '~ elision plumbing; array.items owns the span'
  ]

  Elision: [
    o ',', '["none", {}]', '~ an elision is an absent element; array.items owns the span'
    o 'Elision TERMINATOR'
  ]

  # ============================================================================
  # Object Literals — explicit braces: pairs, shorthand, defaults,
  # rest/spread (the ObjSpreadExpr family), dynamic keys, and object
  # comprehensions. Spread payloads in DESTRUCTURING patterns reject
  # at the emitter (rest targets are plain names).
  # ============================================================================

  Object: [
    o '{ AssignList OptComma }'          , '["object", {}, ...2]', 'object: _, _, ...pairs'
    # Map literals: `*{ k: v, … }` — same pair grammar, Map semantics
    # (any-typed keys preserved; identifier keys read as strings).
    o 'MAP_START { AssignList OptComma }', '["map", {}, ...3]'   , 'map: _, _, ...pairs'
  ]

  AssignList: list 'AssignList', 'AssignObj', empty: 'empty pair list; object.pairs owns the span', reason: 'pair-list plumbing; object.pairs owns the span'

  AssignObj: [
    o 'ObjAssignable'                                                                    , '[":", {shorthand: true}, 1, 1]'               , 'pair: _, _, key, value'
    o 'ObjRestValue'
    # PRIVATE is the class-member modifier on a method pair (`private
    # m: ->`), erased as the visibility side-band role; the lexer mints
    # it only at the head of a class body's member line.
    o '(PRIVATE[visibility])? ObjAssignable[key] : (Expression[value] | INDENT Expression[value] OUTDENT)', '[":", {}, @key, @value]', 'pair: operator, _, key, value'
    # Regex keys exist for MAP literals (`*{ /^N/: 1 }` — any-typed
    # keys); a plain object rejects them at emission (no JS reading).
    o 'Regex : Expression'                                                               , '[":", {}, 1, 3]'                , 'pair: operator, _, key, value'
    o 'SimpleObjAssignable[key] = (Expression[value] | INDENT Expression[value] OUTDENT)', '["=", {}, @key, @value]'        , 'pair: operator, _, key, value'
    # Void-method pair (`fn!: ->` in class bodies and object literals):
    # the bang on the KEY marks the method void. Name-shaped keys only
    # (identifier/property/@-static — the positions a trailing bang can
    # lex after); the emitter requires a function value. Word-form head.
    o '(PRIVATE[visibility])? SimpleObjAssignable[key] VOID_MARKER[voidMarker] :[operator] (Expression[value] | INDENT Expression[value] OUTDENT)', '[":", {void: true}, @key, @value]', 'pair: _, _, key, value'
  ]

  # Object rest/spread: the full ObjSpreadExpr family — chained
  # accessors (member/`?.`/index), the call forms
  # (f()/super()/import()/chained), the dammit operator, the pick
  # forms (`{...obj.{a, b}}`), and the base cases (object,
  # parenthetical, super-member, this). Spread heads are
  # object-LITERAL values only — in a destructuring pattern the rest
  # target must be a plain name (the emitter owns that rejection).
  ObjRestValue: [
    o '... SimpleObjAssignable', '["...", {}, 2]', 'splat: _, _, value'
    o '... ObjSpreadExpr'      , '["...", {}, 2]', 'splat: _, _, value'
  ]

  ObjSpreadExpr: [
    o 'SimpleObjAssignable'
    o 'Object'
    o 'Parenthetical'
    o 'Super'
    o 'This'
    o 'SUPER Arguments'                                                      , '["call", {}, "super", ...2]', 'super: _, _, _, ...args'
    o 'DYNAMIC_IMPORT Arguments'                                             , '["call", {}, 1, ...2]'      , 'dynimport: _, _, callee, ...args'
    o 'SimpleObjAssignable Arguments'                                        , '["call", {}, 1, ...2]'      , 'call: _, _, callee, ...args'
    o 'ObjSpreadExpr Arguments'                                              , '["call", {}, 1, ...2]'      , 'call: _, _, callee, ...args'
    o 'ObjSpreadExpr . Property'                                             , '[".", {}, 1, 3]'          , 'member: operator, _, object, property'
    o 'ObjSpreadExpr ?. Property'                                            , '["?.", {}, 1, 3]'         , 'member: operator, _, object, property'
    o 'ObjSpreadExpr[object] INDEX_START (Expression[key] | INDENT Expression[key] OUTDENT) INDEX_END', '["[]", {}, @object, @key]', 'index: operator, _, object, key'
    # The dammit operator on a spread head (`{...f!}` awaits the call
    # and spreads the result); chains read through it (`{...f!.data}`).
    # Maybe dammit is its twin (`{...f?!}` spreads nothing when `f` is
    # nullish). Dammit's arguments ride the spread head's own call rule,
    # where the emitter folds them into the awaited call; maybe dammit
    # owns its arguments in the node, so it takes them here, or
    # `{...f?!(x)}` would call the awaited result.
    o 'ObjSpreadExpr DAMMIT[operator]'                                       , '["call", {await: true}, 1]'             , 'dammit: _, _, callee'
    o 'ObjSpreadExpr MAYBE_DAMMIT[operator] Arguments'                       , '["call", {opt: true, await: true}, 1, ...3]', 'maybe-dammit: _, _, callee, ...args'
    o 'ObjSpreadExpr MAYBE_DAMMIT[operator]'                                 , '["call", {opt: true, await: true}, 1]'     , 'maybe-dammit: _, _, callee'
    # Pick on a spread head: `{...obj.{a, b}}` spreads the picked
    # literal (the four spread-head pick rules).
    o 'ObjSpreadExpr PICK_START    PickList OptComma PICK_END'               , '[".{}", {}, 1, ...3]'    , 'pick: _, _, source, ...items'
    o 'ObjSpreadExpr OPTPICK_START PickList OptComma PICK_END'               , '["?.{}", {}, 1, ...3]'    , 'pick: _, _, source, ...items'
    o 'ObjSpreadExpr PICK_START    INDENT PickList OptComma OUTDENT PICK_END', '[".{}", {}, 1, ...4]'    , 'pick: _, _, source, ...items'
    o 'ObjSpreadExpr OPTPICK_START INDENT PickList OptComma OUTDENT PICK_END', '["?.{}", {}, 1, ...4]'    , 'pick: _, _, source, ...items'
  ]

  # ============================================================================
  # Pick Expressions — obj.{a, b: newB, c = 'default', d: newD = 'x'}
  #
  # Each item is a [srcKey, dstKey, defaultOrNull] tuple; the emitter
  # lowers it to `dstKey: (source.srcKey ?? default)` — defaults fire
  # on NULLISH, deliberately broader than JS destructuring's
  # undefined-only (database NULLs are the motivating reality).
  # PickKey is Identifier/Property only: no strings, numbers, or
  # computed keys.
  # ============================================================================

  PickList: list 'PickList', 'PickItem', reason: 'item plumbing; pick.items owns the span'

  PickItem: [
    o 'PickKey'             , '["pickitem", {}, 1, 1, ["none", {}]]', 'pickitem: _, _, key, target, _'
    o 'PickKey : PickKey'   , '["pickitem", {}, 1, 3, ["none", {}]]', 'pickitem: _, _, key, target, _'
    o 'PickKey = Expression', '["pickitem", {}, 1, 1, 3]'   , 'pickitem: _, _, key, target, default'
    o 'PickKey : PickKey = Expression', '["pickitem", {}, 1, 3, 5]'   , 'pickitem: _, _, key, target, default'
  ]

  PickKey: [
    o 'Identifier'
    o 'Property'
  ]

  SimpleObjAssignable: [
    o 'Identifier'
    o 'Property'
    o 'ThisProperty'
  ]

  ObjAssignable: [
    o 'SimpleObjAssignable'
    o 'Atom'
    # Computed keys: `{[k]: v}` and the this-index form `{@[k]: v}`
    # (the emitter owns where each is legal).
    o '[ Expression ]'  , '["dynamicKey", {}, 2]', 'dynamicKey: _, _, key'
    o '@ [ Expression ]', '["[]", {}, "this", 3]', 'index: operator, _, object, key'
  ]

  # ============================================================================
  # Ranges and Slices
  # ============================================================================

  RangeDots: [
    o '..' , '".."'
    o '...', '"..."'
  ]

  Range: [
    o '[ Expression RangeDots Expression ]', '[3, {}, 2, 4]', 'range: operator, _, from, to'
  ]

  Slice: [
    o 'Expression RangeDots Expression', '[2, {}, 1, 3]'      , 'range: operator, _, from, to'
    o 'Expression RangeDots', '[2, {}, 1, ["none", {}]]'   , 'range: operator, _, from, to'
    o 'RangeDots Expression', '[1, {}, ["none", {}], 2]'   , 'range: operator, _, from, to'
    o 'RangeDots'           , '[1, {}, ["none", {}], ["none", {}]]', 'range: operator, _, from, to'
  ]

  # ============================================================================
  # Functions
  # ============================================================================

  # Every row takes the class-member modifier (`private def m(a)`):
  # the lexer mints PRIVATE only at the head of a class body's member
  # line, so the shape reaches the emitter as a class member alone. It
  # erases as the visibility side-band role; the TS face re-emits it.
  Def: [
    o '(PRIVATE[visibility])? DEF Identifier[name] OptParams[params] Block[body]'                                          , '["def", {}, @name, @params, @body]'     , 'def: _, _, name, params, body'
    # Return type (`def f(a): T`, parameterless `def f: T`): TYPE erases
    # as returnType.
    o '(PRIVATE[visibility])? DEF Identifier[name] OptParams[params] TYPE[returnType] Block[body]'                         , '["def", {}, @name, @params, @body]'     , 'def: _, _, name, params, body'
    # Generic def (`def wrap<T extends string>(v: T): Promise<[T]>`):
    # TYPE_PARAMS erases as typeParams; the TS face re-emits it after the name.
    o '(PRIVATE[visibility])? DEF Identifier[name] TYPE_PARAMS[typeParams] OptParams[params] Block[body]'                  , '["def", {}, @name, @params, @body]'     , 'def: _, _, name, params, body'
    o '(PRIVATE[visibility])? DEF Identifier[name] TYPE_PARAMS[typeParams] OptParams[params] TYPE[returnType] Block[body]' , '["def", {}, @name, @params, @body]'     , 'def: _, _, name, params, body'
    # Void def (`def save!(x)`): the bang on the def name marks the
    # function void (no implicit return). Word-form head; VOID_MARKER
    # erases as voidMarker.
    o '(PRIVATE[visibility])? DEF Identifier[name] VOID_MARKER[voidMarker] OptParams[params] Block[body]'                  , '["def", {void: true}, @name, @params, @body]', 'def: _, _, name, params, body'
    o '(PRIVATE[visibility])? DEF Identifier[name] VOID_MARKER[voidMarker] OptParams[params] TYPE[returnType] Block[body]' , '["def", {void: true}, @name, @params, @body]', 'def: _, _, name, params, body'
    # Generic void def (`def run!<T>(x: T)`): the bang precedes the list.
    o '(PRIVATE[visibility])? DEF Identifier[name] VOID_MARKER[voidMarker] TYPE_PARAMS[typeParams] OptParams[params] Block[body]'                  , '["def", {void: true}, @name, @params, @body]', 'def: _, _, name, params, body'
    o '(PRIVATE[visibility])? DEF Identifier[name] VOID_MARKER[voidMarker] TYPE_PARAMS[typeParams] OptParams[params] TYPE[returnType] Block[body]' , '["def", {void: true}, @name, @params, @body]', 'def: _, _, name, params, body'
    # Static def (`def @m(a)`, `def @m!(a)`): the ThisProperty name marks
    # a static class method; anywhere but a class body the shape
    # rejects at emission.
    o '(PRIVATE[visibility])? DEF ThisProperty[name] OptParams[params] (TYPE[returnType])? Block[body]'                                   , '["def", {}, @name, @params, @body]'     , 'def: _, _, name, params, body'
    o '(PRIVATE[visibility])? DEF ThisProperty[name] TYPE_PARAMS[typeParams] OptParams[params] (TYPE[returnType])? Block[body]'           , '["def", {}, @name, @params, @body]'     , 'def: _, _, name, params, body'
    o '(PRIVATE[visibility])? DEF ThisProperty[name] VOID_MARKER[voidMarker] OptParams[params] (TYPE[returnType])? Block[body]'           , '["def", {void: true}, @name, @params, @body]', 'def: _, _, name, params, body'
    o '(PRIVATE[visibility])? DEF ThisProperty[name] VOID_MARKER[voidMarker] TYPE_PARAMS[typeParams] OptParams[params] (TYPE[returnType])? Block[body]', '["def", {void: true}, @name, @params, @body]', 'def: _, _, name, params, body'
  ]

  OptParams: [
    o ''                             , '[]', '~ empty parameter list; def.params owns the span'
    o 'CALL_START ParamList CALL_END', 2
  ]

  ParamList: list 'ParamList', 'Param', empty: 'empty parameter list; arrow params role owns the span', reason: 'param-list plumbing; the params roles own the spans'

  Param: [
    o 'TypedParamVar'
    o 'TypedParamVar = Expression', '["default", {}, 1, 3]', 'default: _, _, name, value'
    o '... TypedParamVar'         , '["rest", {}, 2]'      , 'rest: _, _, name'
    o '...'                       , '["expansion", {}]'    , 'expansion: _, _'
  ]

  # A parameter with an optional type annotation. Unlike the owner-node
  # forms (Assign/Def/Code side-band roles), a bare param is a
  # pass-through STRING in the s-expression — there is no node to hang
  # a side-band role on — so the typed form constructs a wrapper node
  # the emitter erases: ["typed-var", {}, target, "T"] (an invented head).
  # The corpus tests canonicalize the wrapper away.
  TypedParamVar: [
    o 'ParamVar'
    o 'ParamVar TYPE'                           , '["typed-var", {}, 1, 2]' , 'typedvar: _, _, target, annotation'
    # Optional parameter (`title?: string`): the lexer retypes the param's
    # `?` to OPT_MARKER when a type annotation follows; it erases as
    # optionalMarker and the TS face emits `?` after the name (the JS
    # twin is the bare name — an omitted argument is undefined either way).
    o 'ParamVar OPT_MARKER[optionalMarker] TYPE', '["typed-var", {}, 1, 3]' , 'typedvar: _, _, target, annotation'
    # Bare optional (`title?` — no annotation): same wrapper, empty
    # annotation text; the face emits just the `?` (TS infers the
    # rest under gradual typing).
    o 'ParamVar OPT_MARKER[optionalMarker]'     , '["typed-var", {}, 1, ["none", {}]]', 'typedvar: _, _, target, annotation'
  ]

  ParamVar: [
    o 'Identifier'
    o 'Array'
    o 'Object'
    # Promoted parameter: `constructor: (@name) ->` assigns the
    # argument to `this.name`. The emitter accepts the shape in
    # constructors only and rejects it loudly elsewhere.
    o 'ThisProperty'
  ]

  # Spread in calls and arrays — ES6 prefix only (the postfix
  # `rest...` spelling rejects).
  Splat: [
    o '... Expression', '["...", {}, 2]', 'splat: _, _, value'
  ]

  # ============================================================================
  # Classes (eight rule shapes; ClassName is Identifier only —
  # ThisProperty class names are deferred with a loud parse
  # rejection)
  # ============================================================================

  ClassName: [
    o 'Identifier'
  ]

  Class: [
    o 'CLASS'                                      , '["class", {}, ["none", {}], ["none", {}], ["none", {}]]'   , 'class: _, _, name, parent, _'
    o 'CLASS Block'                                , '["class", {}, ["none", {}], ["none", {}], 2]', 'class: _, _, name, parent, body'
    o 'CLASS EXTENDS Expression'                   , '["class", {}, ["none", {}], 3, ["none", {}]]'      , 'class: _, _, name, parent, _'
    o 'CLASS EXTENDS Expression Block'             , '["class", {}, ["none", {}], 3, 4]'   , 'class: _, _, name, parent, body'
    o 'CLASS ClassName'                            , '["class", {}, 2, ["none", {}], ["none", {}]]'      , 'class: _, _, name, parent, _'
    o 'CLASS ClassName Block'                      , '["class", {}, 2, ["none", {}], 3]'   , 'class: _, _, name, parent, body'
    o 'CLASS ClassName EXTENDS Expression'         , '["class", {}, 2, 4, ["none", {}]]'         , 'class: _, _, name, parent, _'
    o 'CLASS ClassName EXTENDS Expression Block'   , '["class", {}, 2, 4, 5]'      , 'class: _, _, name, parent, body'
    # Static inner class: `class @Baby` inside a class body becomes a
    # static member class (`static Baby = class { … }`); anywhere
    # else the shape rejects at emission.
    o 'CLASS ThisProperty Block'                   , '["class", {}, 2, ["none", {}], 3]'   , 'class: _, _, name, parent, body'
    o 'CLASS ThisProperty EXTENDS Expression Block', '["class", {}, 2, 4, 5]'      , 'class: _, _, name, parent, body'
  ]

  # ============================================================================
  # Schema — `schema [:kind] INDENT … OUTDENT`. The scanner's schema mode
  # leaves SCHEMA + SCHEMA_BODY on the tape; SCHEMA_BODY's raw value is the
  # descriptor src/schema.js fills from the tree (serializing as its kind
  # string) and its payload is the body in the schema alphabet, which the
  # schema entry parses (`SchemaBody` below).
  # ============================================================================

  Schema: [
    o 'SCHEMA SCHEMA_BODY', '["schema", {}, 2]', 'schema: _, _, body'
  ]

  # ============================================================================
  # Components — `Name = component` declarations. The sexpr
  # shape is ["component", {}, parent, ["block", {}, …statements]] —
  # via ComponentBlock (a flat, annotatable list shape). The body's
  # member categorization, the parse-time defect layer,
  # and the render DSL live in the emitter; OFFER/ACCEPT are
  # context-sensitive tokens the lexer mints only inside component
  # bodies.
  # ============================================================================

  Component: [
    o 'COMPONENT ComponentBlock'                   , '["component", {}, ["none", {}], 2]', 'component: _, _, parent, body'
    o 'COMPONENT EXTENDS Expression ComponentBlock', '["component", {}, 3, 4]'   , 'component: _, _, parent, body'
  ]

  ComponentBlock: [
    o 'INDENT ComponentBody OUTDENT', '["block", {}, ...2]', 'block: _, _, ...statements'
  ]

  ComponentBody: [
    o 'ComponentLine'                         , '[1]'      , '~ statement-list plumbing; component.body owns the span'
    o 'ComponentBody TERMINATOR ComponentLine', '[...1, 3]', '~ statement-list plumbing; component.body owns the span'
    o 'ComponentBody TERMINATOR'
  ]

  ComponentLine: [
    o 'Expression'
    o 'Statement'
    o 'OFFER Expression' , '["offer", {}, 2]' , 'offer: _, _, value'
    o 'ACCEPT IDENTIFIER'                  , '["accept", {}, 2, ["none", {}]]'   , 'accept: _, _, name, _'
    o 'ACCEPT IDENTIFIER FROM ProviderPath', '["accept", {}, 2, 4]', 'accept: _, _, name, provider'
  ]

  # The provider an accept names: a component binding, or a member path
  # into one (`accept open from Dialog.Root` reads a module namespace's
  # part). Only plain property access — a call or an index has no
  # provider reading, and rejects here rather than in the emitter.
  ProviderPath: [
    o 'IDENTIFIER'
    o 'ProviderPath . Property', '[".", {}, 1, 3]', 'member: operator, _, object, property'
  ]

  # Render block: the template DSL for fine-grained reactive DOM.
  # Legal only inside a component body (the emitter owns that
  # rejection, positioned).
  Render: [
    o 'RENDER Block'     , '["render", {}, 2]', 'render: _, _, body'
    o 'RENDER Expression', '["render", {}, 2]', 'render: _, _, body'
  ]

  Super: [
    o 'SUPER . Property'                                                              , '[".", {}, "super", 3]'    , 'member: operator, _, object, property'
    o 'SUPER INDEX_START (Expression[key] | INDENT Expression[key] OUTDENT) INDEX_END', '["[]", {}, "super", @key]', 'index: operator, _, object, key'
  ]

  # ============================================================================
  # Function Calls
  # ============================================================================

  # Every call is ["call", attrs, callee, ...args]. The attribute record
  # carries `opt` (an optional call) and `await` (an awaited one); the
  # semantic kind names the call's family.
  Invocation: [
    o 'Value Arguments'                          , '["call", {}, 1, ...2]'      , 'call: _, _, callee, ...args'
    o 'MarkedInvocation'
  ]

  # Every invocation but the plain call: each is marked by a keyword or an
  # operator (super, `?.(`, `?`, `?!`, import).
  MarkedInvocation: [
    o 'SUPER Arguments'                          , '["call", {}, "super", ...2]', 'super: _, _, _, ...args'
    # Optional call (`f?.(args)`). The juxta form `f? x` is the same
    # node: the lexer opens an implicit call after postfix `?`, and
    # CALL_START outranks `?` so `Value ? Arguments` shifts instead of
    # reducing bare existence (`f?` alone still lowers to `f != null`).
    o 'Value ES6_OPTIONAL_CALL Arguments'        , '["call", {opt: true}, 1, ...3]', 'optcall: _, _, callee, ...args'
    o 'Value ? Arguments'                        , '["call", {opt: true}, 1, ...3]', 'optcall: _, _, callee, ...args'
    # Maybe dammit awaits the optional call itself: `f?!` is
    # `await f?.()`, and `f?!(args)` / `f?! args` pass arguments — dammit's
    # shapes with an optional callee, as a real mapped node. CALL_START
    # outranks MAYBE_DAMMIT, so a following argument list shifts instead
    # of reducing the bare form.
    o 'Value MAYBE_DAMMIT[operator] Arguments'   , '["call", {opt: true, await: true}, 1, ...3]', 'maybe-dammit: _, _, callee, ...args'
    o 'Value MAYBE_DAMMIT[operator]'             , '["call", {opt: true, await: true}, 1]'     , 'maybe-dammit: _, _, callee'
    # Dynamic import: `import(url)` is a call whose callee is the
    # token's own value; `import!(url)` is the awaited call.
    o 'DYNAMIC_IMPORT Arguments'                 , '["call", {}, 1, ...2]'             , 'dynimport: _, _, callee, ...args'
    o 'DYNAMIC_IMPORT DAMMIT[operator] Arguments', '["call", {await: true}, 1, ...3]', 'dynimport: _, _, callee, ...args'
  ]

  Arguments: [
    o 'CALL_START CALL_END'                 , '[]', '~ empty argument list; call.args owns the span'
    o 'CALL_START ArgList OptComma CALL_END', 2
  ]

  ArgList: list 'ArgList', 'Arg', indented: true, reason: 'argument-list plumbing; call.args owns the span'

  Arg: [
    o 'Expression'
    o 'Splat'
  ]

  OptComma: [
    o ''
    o ','
  ]

  # ============================================================================
  # Blocks and Parentheses
  # ============================================================================

  Block: [
    o 'INDENT OUTDENT'     , '["block", {}]'      , 'block: _, _'
    o 'INDENT Body OUTDENT', '["block", {}, ...2]', 'block: _, _, ...statements'
  ]

  Parenthetical: [
    o '( Body )'               , '$2.length === 1 ? (Array.isArray($2[0]) && ($2[0].parenthesized = true), $2[0]) : ["block", {}, ...$2]'
    o '( INDENT Body OUTDENT )', '$3.length === 1 ? (Array.isArray($3[0]) && ($3[0].parenthesized = true), $3[0]) : ["block", {}, ...$3]'
  ]

  # ============================================================================
  # Return
  # ============================================================================

  Return: [
    o 'RETURN Expression', '["return", {}, 2]', 'return: _, _, value'
    o 'RETURN INDENT Object OUTDENT', '["return", {}, 3]', 'return: _, _, value'
    o 'RETURN'           , '["return", {}, ["none", {}]]'   , 'return: _, _, _'
  ]

  # ============================================================================
  # Loops
  #
  # UNTIL lowers to a negated while at parse time; the negation is a
  # nested unary node of its own (`condition(unary: …)`), so the
  # condition's span reaches RoleStore through it. Postfix forms wrap
  # the body statement in a plain list — a transparent scaffold
  # (`_(body)`): the statement is the body role.
  # ============================================================================

  While: [
    o 'WHILE Expression Block'                     , '["while", {}, 2, ["none", {}], 3]'            , 'while: _, _, condition, _, body'
    o 'UNTIL Expression Block'                     , '["while", {}, ["!", {}, 2], ["none", {}], 3]'     , 'while: _, _, condition(unary: operator, _, operand), _, body'
    # WHEN-guarded forms: the guard fills the guard slot —
    # ["while", {}, condition, guard, body], absent in the plain form.
    # Statement emission nests the body in
    # `if (guard)`; value emission skips iterations with `continue`.
    o 'WHILE Expression WHEN Expression Block'     , '["while", {}, 2, 4, 5]'         , 'while: _, _, condition, guard, body'
    o 'UNTIL Expression WHEN Expression Block'     , '["while", {}, ["!", {}, 2], 4, 5]'  , 'while: _, _, condition(unary: operator, _, operand), guard, body'
    # Postfix forms: the body is a plain [statement] array (the
    # postfix-if convention). prec POST_IF, below the loose operators:
    # a loose `then`/`else` after the condition shifts into it, as `or`
    # does (`y = a while b else c` loops while `b || c`).
    o 'Expression WHILE Expression'                , '["while", {}, 3, ["none", {}], [1]]'          , 'while: _, _, condition, _, _(body)', prec: 'POST_IF'
    o 'Statement WHILE Expression'                 , '["while", {}, 3, ["none", {}], [1]]'          , 'while: _, _, condition, _, _(body)', prec: 'POST_IF'
    o 'Expression UNTIL Expression'                , '["while", {}, ["!", {}, 3], ["none", {}], [1]]'   , 'while: _, _, condition(unary: operator, _, operand), _, _(body)', prec: 'POST_IF'
    o 'Statement UNTIL Expression'                 , '["while", {}, ["!", {}, 3], ["none", {}], [1]]'   , 'while: _, _, condition(unary: operator, _, operand), _, _(body)', prec: 'POST_IF'
    o 'Expression WHILE Expression WHEN Expression', '["while", {}, 3, 5, [1]]'       , 'while: _, _, condition, guard, _(body)', prec: 'POST_IF'
    o 'Statement WHILE Expression WHEN Expression' , '["while", {}, 3, 5, [1]]'       , 'while: _, _, condition, guard, _(body)', prec: 'POST_IF'
    o 'Expression UNTIL Expression WHEN Expression', '["while", {}, ["!", {}, 3], 5, [1]]', 'while: _, _, condition(unary: operator, _, operand), guard, _(body)', prec: 'POST_IF'
    o 'Statement UNTIL Expression WHEN Expression' , '["while", {}, ["!", {}, 3], 5, [1]]', 'while: _, _, condition(unary: operator, _, operand), guard, _(body)', prec: 'POST_IF'
    o 'Loop'
  ]

  # ============================================================================
  # Control Flow
  # ============================================================================

  IfBlock: [
    o 'IF Expression Block'           , '["if", {}, 2, 3, ["none", {}]]'   , 'if: _, _, condition, then, _'
    o 'IF Expression Block IfElseTail', '["if", {}, 2, 3, 4]', 'if: _, _, condition, then, else'
  ]

  IfElseTail: [
    o 'ELSE IF Expression Block', '["if", {}, 3, 4, ["none", {}]]'   , 'if: _, _, condition, then, _'
    o 'ELSE IF Expression Block IfElseTail', '["if", {}, 3, 4, 5]', 'if: _, _, condition, then, else'
    o 'ELSE Block'              , 2
  ]

  UnlessBlock: [
    # prec IF (the ELSE precedence class, right-assoc): a dangling ELSE
    # shifts — it binds the nearest conditional (the dangling-else
    # convention).
    o 'UNLESS Expression Block'           , '["if", {}, ["!", {}, 2], 3, ["none", {}]]'   , 'if: _, _, condition(unary: operator, _, operand), then, _', prec: 'IF'
    o 'UNLESS Expression Block ELSE Block', '["if", {}, ["!", {}, 2], 3, 5]', 'if: _, _, condition(unary: operator, _, operand), then, else'
  ]

  If: [
    o 'IfBlock'
    o 'UnlessBlock'
    o 'Statement POST_IF Expression'     , '["if", {}, 3, [1], ["none", {}]]'       , 'if: _, _, condition, _(then), _'
    o 'Expression POST_IF Expression'    , '["if", {}, 3, [1], ["none", {}]]'       , 'if: _, _, condition, _(then), _'
    o 'Statement POST_UNLESS Expression' , '["if", {}, ["!", {}, 3], [1], ["none", {}]]', 'if: _, _, condition(unary: operator, _, operand), _(then), _'
    o 'Expression POST_UNLESS Expression', '["if", {}, ["!", {}, 3], [1], ["none", {}]]', 'if: _, _, condition(unary: operator, _, operand), _(then), _'
    # Postfix conditional WITH else — the Python-style ternary spelling
    # (`b if c else d`). Its own kind: the left-nested chain this parses
    # (`x if a else y if b else z`) re-associates at emission, and the
    # operator `c ? x : y`, which shares the node shape, never does.
    o 'Expression[then] POST_IF Expression[condition] ELSE (INDENT Expression[else] OUTDENT | Expression[else])', '["?:", {}, @condition, @then, @else]', 'ifelse: operator, _, condition, then, else'
    # A statement's postfix if-else: `return x if c else y` returns the
    # ternary, the reading the same words have after any expression. The
    # Return reduces before POST_IF (the guard form needs it to), so the
    # value is lifted out here; a statement with no value has no else
    # reading.
    o 'Statement POST_IF Expression ELSE Expression', '$1[0] === "return" && !($1[2].length === 2 && $1[2][0] === "none") ? ["return", {}, ["?:", {}, $3, $1[2], $5]] : (() => { throw Object.assign(new Error("a postfix if-else on a statement takes its value from the statement, and this one has no value — write the if as a block"), { start: locs[locs.length - 5].start, end: locs[locs.length - 1].end }); })()', '~ the returned ternary carries the statement and condition spans'
    # POST_UNLESS has no ELSE form: `x unless c else y` would otherwise
    # fold the else into the condition. It rejects, positioned. (An
    # action with no `$n` reference reads as a template, whose bare
    # digits are positions — the `$1` keeps these executable.)
    o 'Statement POST_UNLESS Expression ELSE Expression' , '(() => { throw Object.assign(new Error("postfix \'unless\' has no else form — write `if c then … else …`, or put the else case first with postfix if"), { start: locs[locs.length - 5].start, end: locs[locs.length - 1].end }); })($1)', '~ rejects; builds no node'
    o 'Expression POST_UNLESS Expression ELSE Expression', '(() => { throw Object.assign(new Error("postfix \'unless\' has no else form — write `if c then … else …`, or put the else case first with postfix if"), { start: locs[locs.length - 5].start, end: locs[locs.length - 1].end }); })($1)', '~ rejects; builds no node'
  ]

  # ============================================================================
  # Try / Catch / Throw
  # ============================================================================
  # The family's dangling-catch/finally shifts are deliberate greedy
  # attachment — every entry is declared, with its rationale, in the
  # expectedConflicts manifest at the end of this file.
  # ============================================================================

  Try: [
    o 'TRY Block'                     , '["try", {}, 2, ["none", {}], ["none", {}]]'      , 'try: _, _, body, _, _'
    # Inline try: `x = try f()` — the expression is the body; errors
    # swallow (the no-handler form), the value is the expression or
    # undefined on throw.
    o 'TRY Expression'                , '["try", {}, 2, ["none", {}], ["none", {}]]'      , 'try: _, _, body, _, _'
    o 'TRY Expression Catch'          , '["try", {}, 2, 3, ["none", {}]]'   , 'try: _, _, body, handler, _'
    # Statement body: `try return x catch then return y` — Return (and
    # break/continue/debugger) is Statement, not Expression; without
    # these rows the CATCH after `try return …` is Unexpected.
    o 'TRY Statement'                 , '["try", {}, 2, ["none", {}], ["none", {}]]'      , 'try: _, _, body, _, _'
    o 'TRY Statement Catch'           , '["try", {}, 2, 3, ["none", {}]]'   , 'try: _, _, body, handler, _'
    o 'TRY Block Catch'               , '["try", {}, 2, 3, ["none", {}]]'   , 'try: _, _, body, handler, _'
    o 'TRY Block Finalizer'           , '["try", {}, 2, ["none", {}], 3]'   , 'try: _, _, body, _, finalizer'
    o 'TRY Block Catch Finalizer'     , '["try", {}, 2, 3, 4]', 'try: _, _, body, handler, finalizer'
    o 'TRY Expression Finalizer'      , '["try", {}, 2, ["none", {}], 3]'   , 'try: _, _, body, _, finalizer'
    o 'TRY Expression Catch Finalizer', '["try", {}, 2, 3, 4]', 'try: _, _, body, handler, finalizer'
    o 'TRY Statement Finalizer'       , '["try", {}, 2, ["none", {}], 3]'   , 'try: _, _, body, _, finalizer'
    o 'TRY Statement Catch Finalizer' , '["try", {}, 2, 3, 4]', 'try: _, _, body, handler, finalizer'
  ]

  # JavaScript requires a block finalizer. Rip's inline spelling wraps its
  # expression here so every downstream consumer sees the one canonical tree.
  Finalizer: [
    o 'FINALLY Block'     , 2
    o 'FINALLY Expression', '["block", {}, 2]', 'block: _, _, statements'
  ]

  # Catch bindings: an identifier, an object/array pattern (the emitter
  # lowers patterns to a plain `catch (error)` plus a pattern
  # assignment), or the bare form.
  Catch: [
    o 'CATCH CatchVar Block'  , '["catch", {}, 2, 3]'   , 'catch: _, _, binding, body'
    o 'CATCH Object Block'    , '["catch", {}, 2, 3]'   , 'catch: _, _, binding, body'
    o 'CATCH Array Block'     , '["catch", {}, 2, 3]'   , 'catch: _, _, binding, body'
    o 'CATCH Block'           , '["catch", {}, ["none", {}], 2]', 'catch: _, _, binding, body'
  ]

  # A named catch binding, optionally annotated (`catch error: any`) —
  # the same erased wrapper a typed parameter takes.
  CatchVar: [
    o 'Identifier'
    o 'Identifier TYPE', '["typed-var", {}, 1, 2]', 'typedvar: _, _, target, annotation'
  ]

  Throw: [
    o 'THROW Expression'           , '["throw", {}, 2]', 'throw: _, _, value'
    o 'THROW INDENT Object OUTDENT', '["throw", {}, 3]', 'throw: _, _, value'
  ]

  # ============================================================================
  # Switch / When
  # ============================================================================

  Switch: [
    o 'SWITCH Expression INDENT Cases OUTDENT'           , '["switch", {}, 2, 4, ["none", {}]]'   , 'switch: _, _, subject, cases, default'
    o 'SWITCH Expression INDENT Cases ELSE Block OUTDENT', '["switch", {}, 2, 4, 6]'      , 'switch: _, _, subject, cases, default'
    o 'SWITCH INDENT Cases OUTDENT'                      , '["switch", {}, ["none", {}], 3, ["none", {}]]', 'switch: _, _, subject, cases, default'
    o 'SWITCH INDENT Cases ELSE Block OUTDENT'           , '["switch", {}, ["none", {}], 3, 5]'   , 'switch: _, _, subject, cases, default'
  ]

  Cases: [
    o 'When'      , '[1]'      , '~ case-list plumbing; switch.cases owns the span'
    o 'Cases When', '[...1, 2]', '~ case-list plumbing; switch.cases owns the span'
  ]

  When: [
    o 'LEADING_WHEN SimpleArgs Block'           , '["when", {}, 2, 3]', 'when: _, _, conditions, body'
    o 'LEADING_WHEN SimpleArgs Block TERMINATOR', '["when", {}, 2, 3]', 'when: _, _, conditions, body'
  ]

  SimpleArgs: [
    o 'Expression'             , '[1]'      , '~ when-condition list plumbing; when.conditions owns the span'
    o 'SimpleArgs , Expression', '[...1, 3]', '~ when-condition list plumbing; when.conditions owns the span'
  ]

  # ============================================================================
  # For loops: ["loop", {over, own?, await?}, vars, source, step, guard,
  # body], `over` "in", "of" or "as" (absent slots ["none", {}]); a
  # comprehension's clause is the same node with its body absent. `as`
  # iterates the iterator protocol (`for x as iterable` — an ES
  # for-of); its await forms (`for await x as it`, `for x as! it`) are
  # the async-iteration spellings.
  # ============================================================================

  For: [
    # A guard and a step take either order after the iterable.
    o 'FOR ForVariables[vars] FORIN Expression[iterable] (WHEN Expression[guard])? (BY Expression[step])? Block[body]', '["loop", {over: "in"}, @vars, @iterable, @step, @guard, @body]'        , 'forin: _, _, vars, iterable, step, guard, body'
    o 'FOR ForVariables[vars] FORIN Expression[iterable] BY Expression[step] WHEN Expression[guard] Block[body]', '["loop", {over: "in"}, @vars, @iterable, @step, @guard, @body]'        , 'forin: _, _, vars, iterable, step, guard, body'
    o 'FOR (OWN[own])? ForVariables[vars] FOROF Expression[object] (WHEN Expression[guard])? Block[body]', '["loop", {over: "of", own: @own?}, @vars, @object, ["none", {}], @guard, @body]'          , 'forof: _, _, vars, object, _, guard, body'
    o 'FOR (AWAIT[await])? ForVariables[vars] FORAS Expression[iterable] (WHEN Expression[guard])? Block[body]', '["loop", {over: "as", await: @await?}, @vars, @iterable, ["none", {}], @guard, @body]'      , 'foras: _, _, vars, iterable, _, guard, body'
    o 'FOR ForVariables[vars] FORASAWAIT Expression[iterable] (WHEN Expression[guard])? Block[body]', '["loop", {over: "as", await: true}, @vars, @iterable, ["none", {}], @guard, @body]'         , 'foras: _, _, vars, iterable, _, guard, body'

    # A var-less ranged loop (either form) parses only so the emitter
    # can reject it precisely: the repeat idiom takes a binding.
    o 'FOR Range[iterable] (BY Expression[step])? Block[body]'                    , '["loop", {over: "in"}, [], @iterable, @step, ["none", {}], @body]'             , 'forin: _, _, _, iterable, step, guard, body'

    o 'Expression FOR ForVariables FORIN Expression'                              , '["comprehension", {}, 1, ["loop", {over: "in"}, 3, 5, ["none", {}], ["none", {}], ["none", {}]]]'        , 'comprehension: _, _, value, loop(forin: _, _, vars, iterable, step, _, _)'
    o 'Expression FOR ForVariables FORIN Expression WHEN Expression'              , '["comprehension", {}, 1, ["loop", {over: "in"}, 3, 5, ["none", {}], 7, ["none", {}]]]'       , 'comprehension: _, _, value, loop(forin: _, _, vars, iterable, step, guard, _)'
    o 'Expression FOR ForVariables FORIN Expression BY Expression'                , '["comprehension", {}, 1, ["loop", {over: "in"}, 3, 5, 7, ["none", {}], ["none", {}]]]'           , 'comprehension: _, _, value, loop(forin: _, _, vars, iterable, step, _, _)'
    o 'Expression FOR ForVariables FORIN Expression WHEN Expression BY Expression', '["comprehension", {}, 1, ["loop", {over: "in"}, 3, 5, 9, 7, ["none", {}]]]'          , 'comprehension: _, _, value, loop(forin: _, _, vars, iterable, step, guard, _)'
    o 'Expression FOR ForVariables FORIN Expression BY Expression WHEN Expression', '["comprehension", {}, 1, ["loop", {over: "in"}, 3, 5, 7, 9, ["none", {}]]]'          , 'comprehension: _, _, value, loop(forin: _, _, vars, iterable, step, guard, _)'
    o 'Expression FOR ForVariables FOROF Expression'                              , '["comprehension", {}, 1, ["loop", {over: "of"}, 3, 5, ["none", {}], ["none", {}], ["none", {}]]]'       , 'comprehension: _, _, value, loop(forof: _, _, vars, object, _, _, _)'
    o 'Expression FOR ForVariables FOROF Expression WHEN Expression'              , '["comprehension", {}, 1, ["loop", {over: "of"}, 3, 5, ["none", {}], 7, ["none", {}]]]'      , 'comprehension: _, _, value, loop(forof: _, _, vars, object, _, guard, _)'
    o 'Expression FOR OWN ForVariables FOROF Expression'                          , '["comprehension", {}, 1, ["loop", {over: "of", own: true}, 4, 6, ["none", {}], ["none", {}], ["none", {}]]]'        , 'comprehension: _, _, value, loop(forof: _, _, vars, object, _, _, _)'
    o 'Expression FOR OWN ForVariables FOROF Expression WHEN Expression'          , '["comprehension", {}, 1, ["loop", {over: "of", own: true}, 4, 6, ["none", {}], 8, ["none", {}]]]'       , 'comprehension: _, _, value, loop(forof: _, _, vars, object, _, guard, _)'
    o 'Expression FOR ForVariables FORAS Expression'                              , '["comprehension", {}, 1, ["loop", {over: "as"}, 3, 5, ["none", {}], ["none", {}], ["none", {}]]]' , 'comprehension: _, _, value, loop(foras: _, _, vars, iterable, _, _, _)'
    o 'Expression FOR ForVariables FORAS Expression WHEN Expression'              , '["comprehension", {}, 1, ["loop", {over: "as"}, 3, 5, ["none", {}], 7, ["none", {}]]]', 'comprehension: _, _, value, loop(foras: _, _, vars, iterable, _, guard, _)'
    o 'Expression FOR AWAIT ForVariables FORAS Expression'                        , '["comprehension", {}, 1, ["loop", {over: "as", await: true}, 4, 6, ["none", {}], ["none", {}], ["none", {}]]]'  , 'comprehension: _, _, value, loop(foras: _, _, vars, iterable, _, _, _)'
    o 'Expression FOR AWAIT ForVariables FORAS Expression WHEN Expression'        , '["comprehension", {}, 1, ["loop", {over: "as", await: true}, 4, 6, ["none", {}], 8, ["none", {}]]]' , 'comprehension: _, _, value, loop(foras: _, _, vars, iterable, _, guard, _)'
    o 'Expression FOR ForVariables FORASAWAIT Expression'                         , '["comprehension", {}, 1, ["loop", {over: "as", await: true}, 3, 5, ["none", {}], ["none", {}], ["none", {}]]]'  , 'comprehension: _, _, value, loop(foras: _, _, vars, iterable, _, _, _)'
    o 'Expression FOR ForVariables FORASAWAIT Expression WHEN Expression'         , '["comprehension", {}, 1, ["loop", {over: "as", await: true}, 3, 5, ["none", {}], 7, ["none", {}]]]' , 'comprehension: _, _, value, loop(foras: _, _, vars, iterable, _, guard, _)'
  ]

  ForValue: [
    o 'ParamVar'
  ]

  ForVariables: [
    o 'ForValue'           , '[1]'   , '~ loop-variable plumbing; for-node vars role owns the span'
    o 'ForValue , ForValue', '[1, 3]', '~ loop-variable plumbing; for-node vars role owns the span'
  ]

  # ============================================================================
  # Loop
  # ============================================================================

  Loop: [
    o 'LOOP Block'           , '["loop", {over: "forever"}, ["none", {}], ["none", {}], ["none", {}], ["none", {}], 2]'     , 'loop: _, _, _, _, _, _, body'
    # Counted loop: `loop n` runs the block n times with `it` as the
    # counter binding; as a value it collects each iteration's result.
    o 'LOOP Expression Block', '["loop", {over: "times"}, ["none", {}], 2, ["none", {}], ["none", {}], 3]', 'loop: _, _, _, count, _, _, body'
  ]

  # ============================================================================
  # Operations
  # ============================================================================

  Operation: [
    o '-- SimpleAssignable'                       , '["--", {}, 2]' , 'update: operator, _, target'
    o '++ SimpleAssignable'                       , '["++", {}, 2]' , 'update: operator, _, target'
    o 'SimpleAssignable --'                       , '["--", {postfix: true}, 1]'  , 'update: operator, _, target'
    o 'SimpleAssignable ++'                       , '["++", {postfix: true}, 1]'  , 'update: operator, _, target'

    # Postfix existence check: `expr?` lowers to `expr != null` (loose —
    # one comparison covers null and undefined).
    o 'Value ?'                                   , '["?", {}, 1]'         , 'existence: operator, _, value'

    # Postfix `expr as Type` cast. The lexer's rewriteTypes pass has
    # collapsed the `as Type` run into a single CAST token; its run
    # parses from the types entry (TypeAnnotation, below), so the
    # token's value is the type. The node erases at emission (the value
    # alone emits). Left-associative
    # (`x as A as B` nests left) and looser than arithmetic/member/call
    # but tighter than relational/comparison.
    o 'Expression CAST'                           , '["cast", {}, 1, 2]'   , 'cast: _, _, value, annotation'

    # Postfix `expr satisfies Type`: the same token shape and binding as
    # the cast, erased the same way. The TS face keeps the value's own
    # type and checks it against the annotation, where a cast replaces it.
    o 'Expression SATISFIES'                      , '["satisfies", {}, 1, 2]', 'satisfies: _, _, value, annotation'

    o 'Expression TERNARY Expression : Expression', '["?:", {}, 1, 3, 5]'  , 'ternary: operator, _, condition, then, else'

    o 'UNARY Expression'                          , '[1, {}, 2]'           , 'unary: operator, _, operand'
    o 'UNARY_MATH Expression'                     , '[1, {}, 2]'           , 'unary: operator, _, operand'
    # AWAIT is labeled so the keyword owns its span: TS80007 reports on
    # the generated `await`, and the author-spelled keyword is where it
    # honestly lands (the row is verbatim-exact here, a cover onto the
    # `!` for the dammit sugar).
    o 'AWAIT[operator] Expression'                , '["await", {}, 2]'     , 'await: _, _, value'
    o 'AWAIT[operator] INDENT Object OUTDENT'     , '["await", {}, 3]'     , 'await: _, _, value'
    o 'YIELD'                                     , '["yield", {}, ["none", {}]]'        , 'yield: _, _, _'
    o 'YIELD Expression'                          , '["yield", {}, 2]'     , 'yield: _, _, value'
    o 'YIELD INDENT Object OUTDENT'               , '["yield", {}, 3]'     , 'yield: _, _, value'
    o 'YIELD FROM Expression'                     , '["yield-from", {}, 3]', 'yieldfrom: _, _, value'
    o '- Expression'                              , '["-", {}, 2]'         , 'unary: operator, _, operand', prec: 'UNARY_MATH'
    o '+ Expression'                              , '["+", {}, 2]'         , 'unary: operator, _, operand', prec: 'UNARY_MATH'

    o 'Expression ** Expression'                  , '["**", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression + Expression'                   , '["+", {}, 1, 3]'      , 'binary: operator, _, left, right'
    o 'Expression - Expression'                   , '["-", {}, 1, 3]'      , 'binary: operator, _, left, right'
    o 'Expression MATH Expression'                , '[2, {}, 1, 3]'        , 'binary: operator, _, left, right'
    o 'Expression SHIFT Expression'               , '[2, {}, 1, 3]'        , 'binary: operator, _, left, right'
    o 'Expression & Expression'                   , '["&", {}, 1, 3]'      , 'binary: operator, _, left, right'
    o 'Expression ^ Expression'                   , '["^", {}, 1, 3]'      , 'binary: operator, _, left, right'
    o 'Expression | Expression'                   , '["|", {}, 1, 3]'      , 'binary: operator, _, left, right'
    o 'Expression COMPARE Expression'             , '[2, {}, 1, 3]'        , 'binary: operator, _, left, right'
    o 'Expression MATCH Expression'               , '["=~", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression RELATION Expression'            , '[2, {}, 1, 3]'        , 'relation: operator, _, left, right'
    o 'Expression && Expression'                  , '["&&", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression || Expression'                  , '["||", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression ?? Expression'                  , '["??", {}, 1, 3]'     , 'binary: operator, _, left, right'

    o 'Expression && Return'                      , '["&&", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression || Return'                      , '["||", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression ?? Return'                      , '["??", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression && STATEMENT'                   , '["&&", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression || STATEMENT'                   , '["||", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression ?? STATEMENT'                   , '["??", {}, 1, 3]'     , 'binary: operator, _, left, right'
    # Loose `and` / `or`, Ruby's low-precedence pair: `x = get() then
    # print "ok"` / `x = get() else error "nope"` bind below assignment.
    # The lexer hands these two their own tokens: every THEN implicitBlocks
    # leaves in place, and the LOOSE_ELSE tagLooseElse retags from an ELSE
    # that ends no block and closes no postfix conditional, so the if-tail
    # and the ternary keep ELSE and its precedence. One level, non-
    # associative: an expression takes one of the pair (the lexer rejects
    # a second by name). Return / STATEMENT mirror the tight `&&` / `||`
    # guards (`x = 17 then return 22`, `x else continue`).
    o 'Expression THEN Expression'                , '["&&", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression LOOSE_ELSE Expression'          , '["||", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression THEN Return'                    , '["&&", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression LOOSE_ELSE Return'              , '["||", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression THEN STATEMENT'                 , '["&&", {}, 1, 3]'     , 'binary: operator, _, left, right'
    o 'Expression LOOSE_ELSE STATEMENT'           , '["||", {}, 1, 3]'     , 'binary: operator, _, left, right'
  ]

  # ============================================================================
  # Types — the types entry point (`entries` below)
  # ============================================================================
  # A type annotation's payload. src/types.js claims each annotation's
  # token run and collapses it into the one TYPE, CAST or SATISFIES token
  # the rows above shift; the run itself rides beside that token, and the
  # driver parses it from TypeAnnotation, so the token's value is
  # ["type", {}, raw, body]. The run's tokens arrive renamed where a type
  # reads them differently (typeTape in src/types.js): `<` and `>` are
  # angle brackets (a `>>` is two), INDEX_START/INDEX_END are plain
  # brackets, every name is an IDENTIFIER, a `?` before a `:` fuses with
  # it into OPTIONAL_COLON, and the contextual type words are terminals
  # of their own where they act as operators.
  #
  # A run this grammar rejects keeps its raw text and the body
  # ["none", {}]: annotation text the grammar cannot read is the
  # checker's to diagnose. The opaque runs the corpus holds are pinned
  # by test/toolchain/types-entry.test.js. Solar requires an entry's
  # states to be conflict-free.

  # One TYPE terminal serves every annotation position, so the entry
  # reads a predicate wherever an annotation sits; only a return type may
  # hold one, and the checker says so anywhere else.

  TypeAnnotation: [
    o 'Type'
    o 'TypePredicate'
  ]

  # `x is T`, `asserts x is T`, `asserts x` — a claim about a parameter
  # or `this`.
  TypePredicate: [
    o 'TypeSubject IS Type'        , '["type-predicate", {}, 1, 3]'                          , 'type-predicate: _, _, subject, type'
    o 'ASSERTS TypeSubject IS Type', '["type-predicate", {asserts: true}, 2, 4]'             , 'type-predicate: _, _, subject, type'
    o 'ASSERTS TypeSubject'        , '["type-predicate", {asserts: true}, 2, ["none", {}]]', 'type-predicate: _, _, subject, type'
  ]

  TypeSubject: [
    o 'IDENTIFIER'
    o 'THIS'
  ]

  # A function type is no union member (TypeScript asks for parentheses
  # there), and its return type runs as far as a type can.
  Type: [
    o 'TypeUnion'
    o 'TypeFunction'
    o 'TypeUnion EXTENDS TypeUnion ? Type : Type', '["type-conditional", {}, 1, 3, 5, 7]', 'type-conditional: _, _, check, extends, then, else'
  ]

  TypeFunction: [
    o '(TypeGenerics[generics])? PARAM_START TypeParamList[params] PARAM_END => TypeReturn[returns]'                     , '["type-function", {}, @generics, @params, @returns]'                    , 'type-function: _, _, generics, params, returns'
    o '(ABSTRACT[abstract])? NEW (TypeGenerics[generics])? PARAM_START TypeParamList[params] PARAM_END => TypeReturn[returns]', '["type-constructor", {abstract: @abstract?}, @generics, @params, @returns]', 'type-constructor: _, _, generics, params, returns'
  ]

  TypeReturn: [
    o 'Type'
    o 'TypePredicate'
  ]

  TypeParamList: [
    o ''            , '[]', '~ parameter-list plumbing; the function type owns the span'
    o 'TypeParams'
    o 'TypeParams ,'
  ]

  TypeParams: [
    o 'TypeParam'             , '[1]'      , '~ parameter-list plumbing; the function type owns the span'
    o 'TypeParams , TypeParam', '[...1, 3]', '~ parameter-list plumbing; the function type owns the span'
  ]

  TypeParam: [
    o 'TypeSubject'                    , '["type-param", {}, 1, ["none", {}]]'              , 'type-param: _, _, name, type'
    o 'TypeSubject : Type'             , '["type-param", {}, 1, 3]'                         , 'type-param: _, _, name, type'
    o 'TypeSubject ?'                  , '["type-param", {optional: true}, 1, ["none", {}]]', 'type-param: _, _, name, type'
    o 'TypeSubject OPTIONAL_COLON Type', '["type-param", {optional: true}, 1, 3]'           , 'type-param: _, _, name, type'
    o '... IDENTIFIER'                 , '["type-param", {rest: true}, 2, ["none", {}]]'    , 'type-param: _, _, name, type'
    o '... IDENTIFIER : Type'          , '["type-param", {rest: true}, 2, 4]'               , 'type-param: _, _, name, type'
  ]

  # `<T, U extends V = W>` — a generic function's own type variables.
  TypeGenerics: [
    o '< TypeVars >'  , 2
    o '< TypeVars , >', 2
  ]

  TypeVars: [
    o 'TypeVar'           , '[1]'      , '~ type-variable plumbing; the function type owns the span'
    o 'TypeVars , TypeVar', '[...1, 3]', '~ type-variable plumbing; the function type owns the span'
  ]

  TypeVar: [
    o 'IDENTIFIER[name] (EXTENDS Type[constraint])? (= Type[default])?', '["type-var", {}, @name, @constraint, @default]', 'type-var: _, _, name, constraint, default'
  ]

  # A leading `|` is TypeScript's too (`| A | B`).
  TypeUnion: [
    o 'TypeIntersection'
    o '| TypeIntersection', 2
    o 'TypeUnionList'     , '["type-union", {}, ...1]', 'type-union: _, _, ...members'
    o '| TypeUnionList'   , '["type-union", {}, ...2]', 'type-union: _, _, ...members'
  ]

  TypeUnionList: [
    o 'TypeIntersection | TypeIntersection', '[1, 3]'   , '~ member-list plumbing; the union owns the span'
    o 'TypeUnionList | TypeIntersection'   , '[...1, 3]', '~ member-list plumbing; the union owns the span'
  ]

  TypeIntersection: [
    o 'TypeOperand'
    o 'TypeIntersectionList', '["type-intersection", {}, ...1]', 'type-intersection: _, _, ...members'
  ]

  TypeIntersectionList: [
    o 'TypeOperand & TypeOperand'         , '[1, 3]'   , '~ member-list plumbing; the intersection owns the span'
    o 'TypeIntersectionList & TypeOperand', '[...1, 3]', '~ member-list plumbing; the intersection owns the span'
  ]

  # The prefix type operators bind looser than the postfix brackets:
  # `keyof T[]` is `keyof (T[])`.
  TypeOperand: [
    o 'TypePostfix'
    o 'KEYOF TypeOperand'   , '["type-keyof", {}, 2]'   , 'type-keyof: _, _, operand'
    o 'READONLY TypeOperand', '["type-readonly", {}, 2]', 'type-readonly: _, _, operand'
    o 'UNIQUE TypeOperand'  , '["type-unique", {}, 2]'  , 'type-unique: _, _, operand'
    o 'INFER IDENTIFIER'    , '["type-infer", {}, 2]'   , 'type-infer: _, _, name'
  ]

  TypePostfix: [
    o 'TypePrimary'
    o 'TypePostfix [ ]'     , '["type-array", {}, 1]'   , 'type-array: _, _, element'
    o 'TypePostfix [ Type ]', '["type-index", {}, 1, 3]', 'type-index: _, _, object, index'
  ]

  # Parentheses group and build no node; literal types are the leaves.
  TypePrimary: [
    o 'TypeReference'
    o 'STRING'
    o 'NUMBER'
    o '- NUMBER'            , '["type-negative", {}, 2]', 'type-negative: _, _, value'
    o 'NULL'
    o 'UNDEFINED'
    o 'BOOL'
    o 'THIS'
    o '( Type )'            , 2
    o 'TypeObject'
    o 'TypeTuple'
    o 'TYPEOF TypeReference', '["type-query", {}, 2]'   , 'type-query: _, _, target'
  ]

  TypeReference: [
    o 'TypeName'
    o 'TypeName < TypeArgs >'  , '["type-apply", {}, 1, ...3]', 'type-apply: _, _, base, ...args'
    o 'TypeName < TypeArgs , >', '["type-apply", {}, 1, ...3]', 'type-apply: _, _, base, ...args'
  ]

  TypeArgs: [
    o 'Type'           , '[1]'      , '~ argument-list plumbing; the application owns the span'
    o 'TypeArgs , Type', '[...1, 3]', '~ argument-list plumbing; the application owns the span'
  ]

  TypeName: [
    o 'IDENTIFIER'
    o 'TypeName . IDENTIFIER'                     , '["type-member", {}, 1, 3]', 'type-member: _, _, object, property'
    o 'DYNAMIC_IMPORT CALL_START STRING CALL_END', '["type-import", {}, 3]'   , 'type-import: _, _, source'
  ]

  # Members separate by a comma or a line break, and a separator may
  # trail the last one.
  TypeObject: [
    o '{ }'                          , '["type-object", {}]'      , 'type-object: _, _'
    o '{ TypeMembers }'              , '["type-object", {}, ...2]', 'type-object: _, _, ...members'
    o '{ TypeMembers TypeSeparator }', '["type-object", {}, ...2]', 'type-object: _, _, ...members'
  ]

  TypeSeparator: [
    o ','
    o 'TERMINATOR'
  ]

  TypeMembers: [
    o 'TypeMember'                         , '[1]'      , '~ member-list plumbing; the object type owns the span'
    o 'TypeMembers TypeSeparator TypeMember', '[...1, 3]', '~ member-list plumbing; the object type owns the span'
  ]

  TypeMember: [
    o '(READONLY[readonly])? TypeKey[key] : Type[type]'             , '["type-prop", {readonly: @readonly?}, @key, @type]'                , 'type-prop: _, _, key, type'
    o '(READONLY[readonly])? TypeKey[key] OPTIONAL_COLON Type[type]', '["type-prop", {readonly: @readonly?, optional: true}, @key, @type]', 'type-prop: _, _, key, type'
    o 'TypeKey[key] (TypeGenerics[generics])? TypeMethodParams[params] (: TypeReturn[returns])?', '["type-method", {}, @key, @generics, @params, @returns]', 'type-method: _, _, key, generics, params, returns'
    o 'TypeKey[key] ? TypeMethodParams[params] (: TypeReturn[returns])?'                         , '["type-method", {optional: true}, @key, ["none", {}], @params, @returns]', 'type-method: _, _, key, generics, params, returns'
    o '(TypeGenerics[generics])? ( TypeParamList[params] ) : TypeReturn[returns]'                , '["type-call-signature", {}, @generics, @params, @returns]', 'type-call-signature: _, _, generics, params, returns'
    o 'NEW (TypeGenerics[generics])? ( TypeParamList[params] ) : TypeReturn[returns]'            , '["type-construct-signature", {}, @generics, @params, @returns]', 'type-construct-signature: _, _, generics, params, returns'
    o '(READONLY[readonly])? [ IDENTIFIER[name] : Type[key] ] : Type[type]'                   , '["type-index-signature", {readonly: @readonly?}, @name, @key, @type]'          , 'type-index-signature: _, _, name, key, type'
    o '(READONLY[readonly])? [ IDENTIFIER[name] IN Type[constraint] ] : Type[type]'             , '["type-mapped", {readonly: @readonly?}, @name, @constraint, @type]'            , 'type-mapped: _, _, name, constraint, type'
    o '(READONLY[readonly])? [ IDENTIFIER[name] IN Type[constraint] ] OPTIONAL_COLON Type[type]', '["type-mapped", {readonly: @readonly?, optional: true}, @name, @constraint, @type]', 'type-mapped: _, _, name, constraint, type'
  ]

  # A method's parameter list: the scanner reads `m(` as a call's paren,
  # and the paren after a generic list (`m<T>(`) as a plain one.
  TypeMethodParams: [
    o 'CALL_START TypeParamList CALL_END', 2
    o '( TypeParamList )'                , 2
  ]

  TypeKey: [
    o 'IDENTIFIER'
    o 'STRING'
    o 'NUMBER'
  ]

  TypeTuple: [
    o '[ ]'               , '["type-tuple", {}]'      , 'type-tuple: _, _'
    o '[ TypeElements ]'  , '["type-tuple", {}, ...2]', 'type-tuple: _, _, ...elements'
    o '[ TypeElements , ]', '["type-tuple", {}, ...2]', 'type-tuple: _, _, ...elements'
  ]

  TypeElements: [
    o 'TypeElement'               , '[1]'      , '~ element-list plumbing; the tuple owns the span'
    o 'TypeElements , TypeElement', '[...1, 3]', '~ element-list plumbing; the tuple owns the span'
  ]

  TypeElement: [
    o 'Type'
    o 'Type ?'                        , '["type-element", {optional: true}, ["none", {}], 1]', 'type-element: _, _, name, type'
    o '... Type'                      , '["type-element", {rest: true}, ["none", {}], 2]'    , 'type-element: _, _, name, type'
    o 'IDENTIFIER : Type'             , '["type-element", {}, 1, 3]'                         , 'type-element: _, _, name, type'
    o 'IDENTIFIER OPTIONAL_COLON Type', '["type-element", {optional: true}, 1, 3]'           , 'type-element: _, _, name, type'
    o '... IDENTIFIER : Type'         , '["type-element", {rest: true}, 2, 4]'               , 'type-element: _, _, name, type'
  ]

  # ============================================================================
  # Schema DSL — the schema entry point (`entries` below)
  # ============================================================================
  # A schema body's payload is the scanner's schema alphabet (src/lexer.js,
  # the `schema` mode frame): every word is S_WORD, a `:word` is S_SYMBOL,
  # tight `!`/`?` are the modifiers S_BANG/S_OPT, `[]` is S_ARRAY, each
  # code-bearing directive family has its own terminal (S_ENSURE, S_SCOPE,
  # S_DEFAULT_SCOPE) and every other `@word` is S_DIRECTIVE, whose argument
  # shapes the vocabulary owns (src/runtime/vocab.js). A parameter list is
  # one S_PARAMS token; embedded Rip is one SCHEMA_CODE token whose own
  # payload the driver parses from the program's start symbol (`Root` in
  # `entries`). These rows own the DSL's shape; src/schema.js reads the tree
  # into the descriptor and owns what the vocabulary and the kinds decide.
  # Neither entry is opaque: a rejection is the parse's own error, at the
  # offending token.

  SchemaBody: [
    o 'INDENT SchemaLines[lines] OUTDENT'                                 , '["schema-dsl", {}, ["none", {}], ["none", {}], ...@lines]'            , 'schema-dsl: _, _, kind, adapter, ...lines'
    # A tolerant scan drops a malformed member line; one that dropped
    # every line leaves an empty body.
    o 'INDENT OUTDENT'                                                    , '["schema-dsl", {}, ["none", {}], ["none", {}]]'                        , 'schema-dsl: _, _, kind, adapter'
    o 'S_KIND[kind] INDENT OUTDENT'                                       , '["schema-dsl", {}, @kind, ["none", {}]]'                               , 'schema-dsl: _, _, kind, adapter'
    o 'TERMINATOR SchemaLines[lines]'                                     , '["schema-dsl", {inline: true}, ["none", {}], ["none", {}], ...@lines]', 'schema-dsl: _, _, kind, adapter, ...lines'
    o 'S_KIND[kind] (SchemaAdapter[adapter])? INDENT SchemaLines[lines] OUTDENT', '["schema-dsl", {}, @kind, @adapter, ...@lines]'                      , 'schema-dsl: _, _, kind, adapter, ...lines'
    o 'S_KIND[kind] (SchemaAdapter[adapter])? TERMINATOR SchemaLines[lines]'    , '["schema-dsl", {inline: true}, @kind, @adapter, ...@lines]'          , 'schema-dsl: _, _, kind, adapter, ...lines'
  ]

  # `, on: expr` — the per-schema adapter, a value expression; it follows
  # a kind.
  SchemaAdapter: [
    o ', S_ON SCHEMA_CODE', '["schema-adapter", {}, 2, 3]', 'schema-adapter: _, _, keyword, body'
  ]

  SchemaLines: [
    o 'SchemaLine'                       , '[1]'      , '~ line-list plumbing; schema-dsl.lines owns the span'
    o 'SchemaLines TERMINATOR SchemaLine', '[...1, 3]', '~ line-list plumbing; schema-dsl.lines owns the span'
  ]

  SchemaLine: [
    o 'SchemaField'
    o 'SchemaCallable'
    o 'SchemaEnsure'
    o 'SchemaScope'
    o 'SchemaDirective'
    o 'SchemaMember'
  ]

  # name[!|?]* [type] [trailers] — the first trailer's comma is optional.
  SchemaField: [
    o 'S_WORD[name] (SchemaModifiers[modifiers])? (SchemaType[type])? (SchemaTrailers[parts])?', '["schema-field", {}, @name, @modifiers, @type, @parts]', 'schema-field: _, _, name, modifiers, type, parts'
  ]

  SchemaModifiers: [
    o 'SchemaModifier'                , '[1]'      , '~ modifier-list plumbing; schema-field.modifiers owns the span'
    o 'SchemaModifiers SchemaModifier', '[...1, 2]', '~ modifier-list plumbing; schema-field.modifiers owns the span'
  ]

  SchemaModifier: [
    o 'S_BANG'
    o 'S_OPT'
  ]

  SchemaType: [
    o 'SchemaTypeCore'             , '["schema-type", {}, 1]'                , 'schema-type: _, _, core'
    o 'SchemaTypeCore SchemaArrays', '["schema-type", {}, 1, ...2]'          , 'schema-type: _, _, core, ...arrays'
    o 'SchemaArrays'               , '["schema-type", {}, ["none", {}], ...1]', 'schema-type: _, _, core, ...arrays'
  ]

  SchemaArrays: [
    o 'S_ARRAY'             , '[1]'      , '~ array-suffix plumbing; schema-type.arrays owns the span'
    o 'SchemaArrays S_ARRAY', '[...1, 2]', '~ array-suffix plumbing; schema-type.arrays owns the span'
  ]

  # A type word, a `~` coercion (a coercible type or a named coercer), or
  # a string-literal union whose bracketed member is the default.
  SchemaTypeCore: [
    o 'S_WORD'
    o 'S_TILDE S_WORD'  , '["schema-coerce", {}, 2]', 'schema-coerce: _, _, target'
    o 'S_TILDE S_SYMBOL', '["schema-coerce", {}, 2]', 'schema-coerce: _, _, target'
    o 'SchemaUnion'
  ]

  SchemaUnion: [
    o 'STRING'                               , '["schema-union", {}, 1]'      , 'schema-union: _, _, first'
    o 'STRING | SchemaUnionMembers'          , '["schema-union", {}, 1, ...3]', 'schema-union: _, _, first, ...rest'
    o 'SchemaBracket | SchemaUnionMembers'   , '["schema-union", {}, 1, ...3]', 'schema-union: _, _, first, ...rest'
  ]

  SchemaUnionMembers: [
    o 'SchemaUnionMember'                     , '[1]'      , '~ member-list plumbing; schema-union.members owns the span'
    o 'SchemaUnionMembers | SchemaUnionMember', '[...1, 3]', '~ member-list plumbing; schema-union.members owns the span'
  ]

  SchemaUnionMember: [
    o 'STRING'
    o 'SchemaBracket'
  ]

  # The trailer list keeps its commas as "," markers: a transform's own
  # comma is a rule src/schema.js judges against what precedes it.
  # A comma ending the line closes the field: the next line at the same
  # depth is the next member. Trailers continue only on a deeper line,
  # whose first trailer needs no comma either.
  SchemaTrailers: [
    o 'SchemaParts'
    o 'SchemaParts ,'                   , '[...1]'     , '~ trailer-list plumbing; schema-field.parts owns the span'
    o ','                               , '[]'         , '~ trailer-list plumbing; schema-field.parts owns the span'
    o ', SchemaParts'                   , '[",", ...2]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o ', SchemaParts ,'                 , '[",", ...2]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o ', SchemaBlock'                   , '[",", ...2]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaBlock'                     , '[",", ...1]', '~ trailer-list plumbing; schema-field.parts owns the span'
  ]

  SchemaParts: [
    o 'SchemaPart'                         , '[1]'           , '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaParts , SchemaPart'           , '[...1, ",", 3]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaParts , SchemaBlock'       , '[...1, ",", ...3]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaParts SchemaBlock'         , '[...1, ",", ...2]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaParts SchemaTransform'        , '[...1, 2]'     , '~ trailer-list plumbing; schema-field.parts owns the span'
  ]

  # Inside a deeper block of trailers, each line continues the field,
  # with or without a line-ending comma.
  SchemaBlockParts: [
    o 'SchemaPart'                              , '[1]'           , '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaBlockParts , SchemaPart'           , '[...1, ",", 3]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaBlockParts , TERMINATOR SchemaPart', '[...1, ",", 4]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaBlockParts TERMINATOR SchemaPart'  , '[...1, ",", 3]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaBlockParts , SchemaBlock'          , '[...1, ",", ...3]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'SchemaBlockParts SchemaTransform'        , '[...1, 2]'     , '~ trailer-list plumbing; schema-field.parts owns the span'
  ]

  SchemaBlock: [
    o 'INDENT SchemaBlockParts OUTDENT'  , '[...2]', '~ trailer-list plumbing; schema-field.parts owns the span'
    o 'INDENT SchemaBlockParts , OUTDENT', '[...2]', '~ trailer-list plumbing; schema-field.parts owns the span'
  ]

  SchemaPart: [
    o 'SchemaBracket'
    o 'SchemaAttrs'
    o 'SchemaRange'
    o 'REGEX'
    o 'SchemaTransform'
    o 'S_DIRECTIVE'   , '["schema-attr", {}, 1]', 'schema-attr: _, _, name'
  ]

  SchemaTransform: [
    o '-> SCHEMA_CODE', '["schema-transform", {}, 2]', 'schema-transform: _, _, body'
  ]

  SchemaRange: [
    o 'SchemaNum .. SchemaNum', '["schema-range", {}, 1, 3]'                    , 'schema-range: _, _, min, max'
    o 'SchemaNum ..'          , '["schema-range", {}, 1, ["none", {}]]'          , 'schema-range: _, _, min, max'
    o '.. SchemaNum'          , '["schema-range", {}, ["none", {}], 2]'          , 'schema-range: _, _, min, max'
    o '..'                    , '["schema-range", {}, ["none", {}], ["none", {}]]', 'schema-range: _, _, min, max'
  ]

  SchemaNum: [
    o 'NUMBER'
    o '- NUMBER', '["schema-neg", {}, 2]', 'schema-neg: _, _, value'
  ]

  # `[…]` — a default, a bracketed union member, or a column list; how
  # many values it may hold is the reader's rule, so its message can say.
  SchemaBracket: [
    o '[ SchemaValues ]'               , '["schema-bracket", {}, ...2]', 'schema-bracket: _, _, ...values'
    o '[ SchemaValues , ]'             , '["schema-bracket", {}, ...2]', 'schema-bracket: _, _, ...values'
    o '[ INDENT SchemaValues OUTDENT ]', '["schema-bracket", {}, ...3]', 'schema-bracket: _, _, ...values'
    o '[ INDENT SchemaValues , OUTDENT ]', '["schema-bracket", {}, ...3]', 'schema-bracket: _, _, ...values'
  ]

  SchemaValues: [
    o 'SchemaValue'               , '[1]'      , '~ value-list plumbing; schema-bracket.values owns the span'
    o 'SchemaValues , SchemaValue', '[...1, 3]', '~ value-list plumbing; schema-bracket.values owns the span'
    o 'SchemaValues , TERMINATOR SchemaValue', '[...1, 4]', '~ value-list plumbing; schema-bracket.values owns the span'
    o 'SchemaValues , INDENT SchemaValues OUTDENT', '[...1, ...4]', '~ value-list plumbing; schema-bracket.values owns the span'
  ]

  SchemaValue: [
    o 'SchemaNum'
    o 'STRING'
    o 'S_WORD'
    o 'S_SYMBOL'
    o 'REGEX'
  ]

  # `{key: value}` options, the colon optional; which keys exist and which
  # namespace a value lives in is the vocabulary's.
  SchemaAttrs: [
    o '{ }'                              , '["schema-attrs", {}]'      , 'schema-attrs: _, _'
    o '{ SchemaOptions }'                , '["schema-attrs", {}, ...2]', 'schema-attrs: _, _, ...options'
    o '{ SchemaOptions , }'              , '["schema-attrs", {}, ...2]', 'schema-attrs: _, _, ...options'
    o '{ INDENT SchemaOptions OUTDENT }' , '["schema-attrs", {}, ...3]', 'schema-attrs: _, _, ...options'
  ]

  SchemaOptions: [
    o 'SchemaOption'                           , '[1]'      , '~ option-list plumbing; schema-attrs.options owns the span'
    o 'SchemaOptions , SchemaOption'           , '[...1, 3]', '~ option-list plumbing; schema-attrs.options owns the span'
    o 'SchemaOptions , TERMINATOR SchemaOption', '[...1, 4]', '~ option-list plumbing; schema-attrs.options owns the span'
    o 'SchemaOptions TERMINATOR SchemaOption'  , '[...1, 3]', '~ option-list plumbing; schema-attrs.options owns the span'
    o 'SchemaOptions , INDENT SchemaOptions OUTDENT', '[...1, ...4]', '~ option-list plumbing; schema-attrs.options owns the span'
  ]

  SchemaOption: [
    o 'S_WORD : SchemaValue', '["schema-option", {}, 1, 3]', 'schema-option: _, _, key, value'
    o 'S_WORD SchemaValue'  , '["schema-option", {}, 1, 2]', 'schema-option: _, _, key, value'
  ]

  # `name: -> body` (method or hook), `name: ~> body` (computed),
  # `name: !> body` (eager derived), each optionally `name: (params) …`.
  SchemaCallable: [
    o 'S_WORD : (SchemaParams[params])? SchemaArrow[arrow] SCHEMA_CODE[body]', '["schema-callable", {}, 1, @params, @arrow, @body]', 'schema-callable: _, _, name, params, arrow, body'
  ]

  SchemaArrow: [
    o '->'
    o 'EFFECT'
    o '!>'
  ]

  SchemaParams: [
    o 'S_PARAMS', '["schema-params", {}, 1]', 'schema-params: _, _, raw'
  ]

  SchemaFn: [
    o '(SchemaParams[params])? -> SCHEMA_CODE[body]', '["schema-fn", {}, @params, @body]', 'schema-fn: _, _, params, body'
  ]

  # `@ensure[!] "message"[, :field], (x) -> body` or `@ensure[!] […]` —
  # the items stay a list so the reader can say which one is missing.
  SchemaEnsure: [
    o 'S_ENSURE (S_BANG[async])?'                            , '["schema-ensure", {async: @async?}]'           , 'schema-ensure: _, _'
    o 'S_ENSURE (S_BANG[async])? SchemaEnsureItems[items]'   , '["schema-ensure", {async: @async?}, ...@items]', 'schema-ensure: _, _, ...items'
    o 'S_ENSURE (S_BANG[async])? SchemaEnsureItems[items] ,' , '["schema-ensure", {async: @async?}, ...@items]', 'schema-ensure: _, _, ...items'
  ]

  SchemaEnsureItems: [
    o 'SchemaEnsureItem'                    , '[1]'      , '~ item-list plumbing; schema-ensure.items owns the span'
    o 'SchemaEnsureItems , SchemaEnsureItem', '[...1, 3]', '~ item-list plumbing; schema-ensure.items owns the span'
  ]

  SchemaEnsureItem: [
    o 'STRING'
    o 'SchemaNum'
    o 'S_WORD'
    o 'S_SYMBOL'
    o 'SchemaFn'
    o '[ SchemaEnsureElements ]'                , '["schema-ensure-list", {}, ...2]', 'schema-ensure-list: _, _, ...elements'
    o '[ INDENT SchemaEnsureElements OUTDENT ]' , '["schema-ensure-list", {}, ...3]', 'schema-ensure-list: _, _, ...elements'
    o '[ SchemaEnsureElements , ]'              , '["schema-ensure-list", {}, ...2]', 'schema-ensure-list: _, _, ...elements'
    o '[ INDENT SchemaEnsureElements , OUTDENT ]', '["schema-ensure-list", {}, ...3]', 'schema-ensure-list: _, _, ...elements'
  ]

  # Array elements separate on a comma or a line break, as array literals do.
  SchemaEnsureElements: [
    o 'SchemaEnsureElement'                                  , '[1]'      , '~ element-list plumbing; schema-ensure-list.elements owns the span'
    o 'SchemaEnsureElements , SchemaEnsureElement'           , '[...1, 3]', '~ element-list plumbing; schema-ensure-list.elements owns the span'
    o 'SchemaEnsureElements TERMINATOR SchemaEnsureElement'  , '[...1, 3]', '~ element-list plumbing; schema-ensure-list.elements owns the span'
    o 'SchemaEnsureElements , TERMINATOR SchemaEnsureElement', '[...1, 4]', '~ element-list plumbing; schema-ensure-list.elements owns the span'
    o 'SchemaEnsureElements , INDENT SchemaEnsureElements OUTDENT', '[...1, ...4]', '~ element-list plumbing; schema-ensure-list.elements owns the span'
  ]

  SchemaEnsureElement: [
    o 'STRING'
    o 'SchemaNum'
    o 'S_WORD'
    o 'S_SYMBOL'
    o 'SchemaFn'
  ]

  # `@scope :name[,] fn` and `@defaultScope fn`.
  SchemaScope: [
    o 'S_SCOPE S_SYMBOL (,)? SchemaFn[fn]', '["schema-scope", {}, 2, @fn]'                          , 'schema-scope: _, _, name, fn'
    o 'S_DEFAULT_SCOPE SchemaFn'          , '["schema-scope", {default: true}, ["none", {}], 2]', 'schema-scope: _, _, name, fn'
  ]

  SchemaDirective: [
    o 'S_DIRECTIVE'              , '["schema-directive", {}, 1]'      , 'schema-directive: _, _, name'
    o 'S_DIRECTIVE SchemaDirArgs', '["schema-directive", {}, 1, ...2]', 'schema-directive: _, _, name, ...args'
  ]

  SchemaDirArgs: [
    o 'SchemaDirArg'              , '[1]'      , '~ argument-list plumbing; schema-directive.args owns the span'
    o 'SchemaDirArgs SchemaDirArg', '[...1, 2]', '~ argument-list plumbing; schema-directive.args owns the span'
  ]

  SchemaDirArg: [
    o 'S_WORD'
    o 'S_SYMBOL'
    o 'SchemaNum'
    o 'STRING'
    o 'SchemaBracket'
    o 'SchemaAttrs'
    o ','    , '["schema-mark", {}, 1]', 'schema-mark: _, _, raw'
    o '.'    , '["schema-mark", {}, 1]', 'schema-mark: _, _, raw'
    o 'S_OPT', '["schema-mark", {}, 1]', 'schema-mark: _, _, raw'
  ]

  # `:name [value]` — an :enum member.
  SchemaMember: [
    o 'S_SYMBOL'                  , '["schema-member", {}, 1, ["none", {}]]', 'schema-member: _, _, name, value'
    o 'S_SYMBOL SchemaMemberValue', '["schema-member", {}, 1, 2]'           , 'schema-member: _, _, name, value'
  ]

  SchemaMemberValue: [
    o 'SchemaNum'
    o 'STRING'
    o 'S_WORD'
  ]

# ==============================================================================
# Operator Precedence (high to low)
# ==============================================================================

operators = """
  right       DO_IIFE
  left        . ?. DAMMIT INDEX_START TEMPLATE_TAG
  left        CALL_START CALL_END
  nonassoc    ++ -- ? MAYBE_DAMMIT
  right       UNARY
  right       AWAIT
  right       **
  right       UNARY_MATH
  left        MATH
  left        + -
  left        SHIFT
  left        CAST SATISFIES
  left        RELATION
  left        COMPARE MATCH
  left        &
  left        ^
  left        |
  left        &&
  left        || ??
  right       TERNARY
  nonassoc    INDENT OUTDENT
  right       YIELD
  right       = : COMPOUND_ASSIGN RETURN THROW EXTENDS
  right       FORIN FOROF FORAS FORASAWAIT BY WHEN
  right       IF ELSE FOR WHILE UNTIL LOOP SUPER CLASS COMPONENT RENDER OFFER ACCEPT
  nonassoc    THEN LOOSE_ELSE
  left        POST_IF POST_UNLESS
  right       REACTIVE_ASSIGN COMPUTED_ASSIGN READONLY_ASSIGN EFFECT
""".trim().split('\n').reverse().map (line) -> line.trim().split /\s+/

# ==============================================================================
# Token Displays
# ==============================================================================
# User-facing displays for lexer-minted token kinds in parse
# diagnostics: users type the glyph, never the internal kind name.
# Solar validates each key names a grammar terminal.

displays =
  OPT_MARKER: '?'
  VOID_MARKER: '!'
  PRIVATE: 'private'
  IMPORT_TYPE: 'type'
  EXPORT_TYPE: 'type'
  # Layout and lexer-classified kinds, in the words a reader knows.
  TERMINATOR: 'newline'
  INDENT: 'indent'
  OUTDENT: 'dedent'
  STATEMENT: 'break/continue/debugger'
  TYPE_DECL: 'type/interface'
  TYPE: 'a type annotation'
  TYPE_PARAMS: '<…>'
  SCHEMA_BODY: 'a schema body'
  SCHEMA_CODE: "a schema body's code"
  # The schema alphabet (the scanner's `schema` mode).
  S_WORD: 'a name'
  S_SYMBOL: 'a :symbol'
  S_KIND: 'a schema kind'
  S_BANG: '!'
  S_OPT: '?'
  S_TILDE: '~'
  S_ARRAY: '[]'
  S_ENSURE: '@ensure'
  S_SCOPE: '@scope'
  S_DEFAULT_SCOPE: '@defaultScope'
  S_DIRECTIVE: 'a directive'
  S_ON: 'on'
  S_PARAMS: 'a parameter list'
  IDENTIFIER: 'a name'
  PROPERTY: 'a property name'
  NUMBER: 'a number'
  STRING: 'a string'
  STRING_START: 'a string'
  STRING_END: 'the closing quote'
  SYMBOL: 'a :symbol'
  REGEX: 'a regex'
  BOOL: 'true/false'
  UNDEFINED: 'undefined'
  NULL: 'null'
  THIS: 'this'
  SUPER: 'super'
  NEW_TARGET: 'new.target'
  IMPORT_META: 'import.meta'
  # Keywords whose token kind is not their spelling.
  DEF: 'def'
  IMPORT: 'import'
  EXPORT: 'export'
  FROM: 'from'
  AS: 'as'
  WITH: 'with'
  DEFAULT: 'default'
  IMPORT_ALL: '*'
  EXPORT_ALL: '*'
  DYNAMIC_IMPORT: 'import('
  CLASS: 'class'
  EXTENDS: 'extends'
  SCHEMA: 'schema'
  COMPONENT: 'component'
  OFFER: 'offer'
  ACCEPT: 'accept'
  RENDER: 'render'
  RETURN: 'return'
  IF: 'if'
  POST_IF: 'if'
  UNLESS: 'unless'
  POST_UNLESS: 'unless'
  ELSE: 'else'
  THEN: 'then'
  LOOSE_ELSE: 'else'
  WHILE: 'while'
  UNTIL: 'until'
  LOOP: 'loop'
  FOR: 'for'
  FORIN: 'in'
  FOROF: 'of'
  FORAS: 'as'
  FORASAWAIT: 'as!'
  OWN: 'own'
  BY: 'by'
  WHEN: 'when'
  LEADING_WHEN: 'when'
  SWITCH: 'switch'
  TRY: 'try'
  CATCH: 'catch'
  FINALLY: 'finally'
  THROW: 'throw'
  AWAIT: 'await'
  YIELD: 'yield'
  DO_IIFE: 'do'
  CAST: 'as'
  SATISFIES: 'satisfies'
  # Glyphs the lexer classifies.
  CALL_START: '('
  CALL_END: ')'
  PARAM_START: '('
  PARAM_END: ')'
  INDEX_START: '['
  INDEX_END: ']'
  PICK_START: '.{'
  PICK_END: '}'
  OPTPICK_START: '?.{'
  ES6_OPTIONAL_INDEX: '?.['
  ES6_OPTIONAL_CALL: '?.('
  MAP_START: '*{'
  INTERPOLATION_START: '#{'
  INTERPOLATION_END: '}'
  HEREGEX_START: '///'
  HEREGEX_END: '///'
  TEMPLATE_TAG: '$'
  DAMMIT: '!'
  MAYBE_DAMMIT: '?!'
  TERNARY: '?'
  GATE: '<~'
  MATCH: '=~'
  REACTIVE_ASSIGN: ':='
  COMPUTED_ASSIGN: '~='
  READONLY_ASSIGN: '=!'
  EFFECT: '~>'
  COMPOUND_ASSIGN: 'a compound assignment'
  MATH: 'a math operator'
  SHIFT: 'a shift operator'
  COMPARE: 'a comparison'
  RELATION: 'in/of/instanceof'
  UNARY: 'not/typeof/delete'
  UNARY_MATH: '!/~'
  # The types entry's own terminals (typeTape in src/types.js).
  OPTIONAL_COLON: '?:'
  KEYOF: 'keyof'
  TYPEOF: 'typeof'
  INFER: 'infer'
  READONLY: 'readonly'
  UNIQUE: 'unique'
  ASSERTS: 'asserts'
  IS: 'is'
  IN: 'in'
  NEW: 'new'
  ABSTRACT: 'abstract'

# ==============================================================================
# Kind Registry
# ==============================================================================
# Every kind an annotation may name, with the tree shapes that kind
# takes. This is the parser's tree contract: Solar checks every
# annotated template against it and fails generation on drift in
# either direction (a template no form admits, a declared kind, form or
# side role no rule uses), and src/sexpr.js validates real parse trees
# against the same registry.
#
# Each kind lists its `forms`, one string per distinct node shape, and
# its `side` roles: labeled tokens whose spans reach RoleStore while
# the tree drops them. A `part` kind is a clause of another node (a
# catch, a pair, a parameter default): only a slot that names it admits
# it. Every node is its head, its attribute record (the node's
# modifiers: `void`, a loop's `over`, `own` and `await`, a call's `opt`
# and `await`; `{}` when it has none), then its children; an absent
# child is the marker ["none", {}]. A form is its slots in tree order:
#
#   "lit"|"lit2"      an unnamed constant slot (the head of most kinds)
#   role:type         a named slot; the annotation names its element
#   ...role:type      a trailing run of zero or more elements
#
# A type is alternatives joined by `|`, with a trailing `?` admitting
# null:
#
#   leaf              a raw token string
#   expr              a node of any kind that is not a part, or an array
#                     built by an executable action (the Parenthetical
#                     and postfix if-else rules); never a raw string
#   bool              true or false
#   null              null alone
#   descriptor        a plain object (a schema's descriptor)
#   any               every value
#   <kind>            a node of that kind
#   [type]            an unkinded array whose elements each match type
#   "lit"             exactly that string
#   none              the absent marker ["none", {}]
#   {flag key:"w"}    an attribute record holding exactly those keys: a
#                     flag is true, a keyed word is one of the listed
#                     words (`over:"in"|"of"`); {} is the empty record
#
# A kind takes several forms where its heads differ (export), its
# attribute records do (a void assignment, a loop's source), a loop is a
# comprehension's clause (no body), or a statement keeps its postfix
# scaffold. Executable actions carry no annotation and sit outside the
# registry.

kinds =
  'accept':        forms: ['"accept" attrs:{} name:name provider:name|member|none']
  'array':         forms: ['"array" attrs:{} ...items:expr|splat|none ...elisions:none']
  'as':            forms: ['"as" attrs:{} name:name|"*"|"default" alias:name|"default"'], part: true
  'assign':
    forms: [
      'operator:"="|"+="|"-="|"*="|"/="|"%="|"**="|"//="|"%%="|"<<="|">>="|">>>="|"&="|"^="|"|="|"&&="|"||="|"??=" attrs:{} target:expr value:expr'
      '"=" attrs:{void} target:name value:expr'
    ]
    side:  ['annotation', 'operator', 'optionalMarker', 'typeParams', 'visibility', 'voidMarker']
  'await':         forms: ['"await" attrs:{} value:expr'], side: ['operator']
  'binary':        forms: ['operator:leaf attrs:{} left:expr right:expr']
  'block':         forms: ['"block" attrs:{} ...statements:expr'], part: true
  'call':          forms: ['"call" attrs:{} callee:expr ...args:expr|splat']
  'cast':          forms: ['"cast" attrs:{} value:expr annotation:type']
  'catch':         forms: ['"catch" attrs:{} binding:expr|none body:block'], part: true
  'class':         forms: ['"class" attrs:{} name:name|member|none parent:expr|none body:block|none']
  'component':     forms: ['"component" attrs:{} parent:expr|none body:block']
  'comprehension': forms: ['"comprehension" attrs:{} value:expr loop:forin|forof|foras']
  'computed':      forms: ['"computed" attrs:{} target:expr value:expr|block'], side: ['annotation', 'operator', 'optionalMarker']
  'dammit':        forms: ['"call" attrs:{await} callee:expr'], side: ['operator']
  'def':
    forms: ['"def" attrs:{}|{void} name:name|member params:[expr|default|rest|expansion] body:block']
    side:  ['returnType', 'typeParams', 'visibility', 'voidMarker']
  'default':       forms: ['"default" attrs:{} name:expr value:expr'], part: true
  'defsig':        forms: ['"def-sig" attrs:{} name:name params:[expr|default|rest|expansion] returnType:type'], side: ['typeParams']
  'doiife':        forms: ['"do-iife" attrs:{} func:expr']
  'dynamicKey':    forms: ['"dynamicKey" attrs:{} key:expr'], part: true
  'dynimport':     forms: ['"call" attrs:{}|{await} callee:"import" ...args:expr|splat'], side: ['operator']
  'effect':        forms: ['"effect" attrs:{} target:expr|none value:expr|block'], side: ['annotation', 'operator']
  'existence':     forms: ['operator:"?" attrs:{} value:expr']
  'expansion':     forms: ['"expansion" attrs:{}'], part: true
  'export':
    forms: [
      '"export" attrs:{} spec:expr|[name|as]'
      '"export-default" attrs:{} spec:expr'
      '"export-all" attrs:{} source:string alias:name|"default"|none'
      '"export-from" attrs:{} spec:[name|as|"default"] source:string'
    ]
    side: ['typeOnly']
  'foras':
    forms: [
      '"loop" attrs:{over:"as"}|{over:"as" await} vars:[expr] iterable:expr step:none guard:expr|none body:block'
      '"loop" attrs:{over:"as"}|{over:"as" await} vars:[expr] iterable:expr step:none guard:expr|none body:none'
    ]
  'forin':
    forms: [
      '"loop" attrs:{over:"in"} vars:[expr] iterable:expr step:expr|none guard:expr|none body:block'
      '"loop" attrs:{over:"in"} vars:[expr] iterable:expr step:expr|none guard:expr|none body:none'
    ]
  'forof':
    forms: [
      '"loop" attrs:{over:"of"}|{over:"of" own} vars:[expr] object:expr step:none guard:expr|none body:block'
      '"loop" attrs:{over:"of"}|{over:"of" own} vars:[expr] object:expr step:none guard:expr|none body:none'
    ]
  'func':          forms: ['kind:"->"|"=>" attrs:{} params:[expr|default|rest|expansion] body:block'], side: ['returnType']
  'gate':          forms: ['"gate" attrs:{} target:expr rhs:expr ...key:expr|splat'], side: ['annotation', 'operator']
  'heregex':       forms: ['"here-regex" attrs:{} flags:leaf ...parts:string|[expr]|none']
  'if':
    forms: [
      '"if" attrs:{} condition:expr then:block else:block|if|none'
      '"if" attrs:{} condition:expr then:[expr] else:none'
    ]
  'ifelse':        forms: ['operator:"?:" attrs:{} condition:expr then:expr else:expr']
  'import':
    forms: ['"import" attrs:{} spec:name|as|[name|as|"default"]|none extra:as|[name|as]|none attributes:withattrs|none source:string']
    side: ['typeOnly']
  'index':         forms: ['operator:"[]" attrs:{} object:expr|"this"|"super" key:expr']
  'loop':
    forms: [
      '"loop" attrs:{over:"forever"} vars:none count:none step:none guard:none body:block'
      '"loop" attrs:{over:"times"} vars:none count:expr step:none guard:none body:block'
    ]
  'map':           forms: ['"map" attrs:{} ...pairs:pair|splat']
  'maybe-dammit':  forms: ['"call" attrs:{opt await} callee:expr ...args:expr|splat'], side: ['operator']
  'member':        forms: ['operator:"."|"?." attrs:{} object:expr|"this"|"super"|"import"|"new" property:name|string']
  'object':        forms: ['"object" attrs:{} ...pairs:pair|splat']
  'offer':         forms: ['"offer" attrs:{} value:expr']
  'optcall':       forms: ['"call" attrs:{opt} callee:expr ...args:expr|splat']
  'optindex':      forms: ['"optindex" attrs:{} object:expr key:expr']
  'pair':
    forms: [
      'operator:":"|"=" attrs:{} key:expr|dynamicKey value:expr'
      '":" attrs:{void}|{shorthand} key:name|member value:expr'
    ]
    side:  ['operator', 'visibility', 'voidMarker']
    part:  true
  'pick':          forms: ['".{}"|"?.{}" attrs:{} source:expr ...items:pickitem']
  'pickitem':      forms: ['"pickitem" attrs:{} key:name target:name default:expr|none'], part: true
  'program':       forms: ['"program" attrs:{} ...body:expr'], part: true
  'range':         forms: ['operator:".."|"..." attrs:{} from:expr|none to:expr|none']
  'readonly':
    forms: ['"readonly" attrs:{} target:expr value:expr', '"readonly" attrs:{void} target:name value:expr']
    side:  ['annotation', 'operator', 'optionalMarker', 'voidMarker']
  'regexindex':    forms: ['"regex-index" attrs:{} object:expr key:expr capture:expr']
  'relation':      forms: ['operator:leaf attrs:{} left:expr right:expr']
  'render':        forms: ['"render" attrs:{} body:expr|block']
  'rest':          forms: ['"rest" attrs:{} name:expr'], part: true
  'return':        forms: ['"return" attrs:{} value:expr|none']
  'satisfies':     forms: ['"satisfies" attrs:{} value:expr annotation:type']
  'schema':        forms: ['"schema" attrs:{} body:schema-body']
  'splat':         forms: ['"..." attrs:{} value:expr'], part: true
  'state':         forms: ['"state" attrs:{} target:expr value:expr'], side: ['annotation', 'operator', 'optionalMarker']
  'str':           forms: ['"str" attrs:{} ...parts:string|[expr]|none']
  'super':         forms: ['"call" attrs:{} "super" ...args:expr|splat']
  'switch':        forms: ['"switch" attrs:{} subject:expr|none cases:[when] default:block|none']
  'symbol':        forms: ['"symbol" attrs:{} name:leaf']
  'tagged':        forms: ['"tagged-template" attrs:{} tag:expr str:str|string']
  'ternary':       forms: ['operator:"?:" attrs:{} condition:expr then:expr else:expr']
  'throw':         forms: ['"throw" attrs:{} value:expr']
  'try':           forms: ['"try" attrs:{} body:expr|block handler:catch|none finalizer:block|none']
  'typedecl':      forms: ['"type-decl" attrs:{} declaration:leaf']
  'typedvar':      forms: ['"typed-var" attrs:{} target:expr annotation:type|none'], side: ['optionalMarker', 'visibility']
  'unary':         forms: ['operator:leaf attrs:{} operand:expr']
  'update':        forms: ['operator:"++"|"--" attrs:{}|{postfix} target:expr']
  'when':          forms: ['"when" attrs:{} conditions:[expr] body:block'], part: true
  'withattrs':     forms: ['keyword:"with" attrs:{} value:object'], part: true
  'while':
    forms: [
      '"while" attrs:{} condition:expr guard:expr|none body:block'
      '"while" attrs:{} condition:expr guard:expr|none body:[expr]'
    ]
  'yield':         forms: ['"yield" attrs:{} value:expr|none']
  'yieldfrom':     forms: ['"yield-from" attrs:{} value:expr']
  # The leaves (the `leaves` table below): the driver builds each.
  'name':          forms: ['"name" attrs:{} raw:leaf']
  'num':           forms: ['"num" attrs:{} raw:leaf']
  'string':        forms: ['"string" attrs:{} raw:leaf']
  'regex':         forms: ['"regex" attrs:{} raw:leaf']
  'lit':           forms: ['"lit" attrs:{} raw:"true"|"false"|"null"|"undefined"']
  'this':          forms: ['"this" attrs:{} raw:"this"|"@"']
  'statement':     forms: ['"statement" attrs:{} raw:"break"|"continue"|"debugger"']
  # The types entry (`entries` below): the driver builds each annotation
  # token's value from its raw text and the payload's tree, `none` when
  # the payload is no type the grammar reads. The rest are the payload's
  # nodes; a name, string, number, literal or `this` type is its leaf.
  'type':                 forms: ['"type" attrs:{} raw:leaf body:expr|type-predicate|none']
  # The schema entry (`entries` below): a schema body token's value is its
  # descriptor and the tree of its DSL, whose embedded code sites are each
  # a `code` the program's own start symbol parsed. A projection folded
  # from a schema has no DSL of its own (`none`).
  'schema-body':          forms: ['"schema-body" attrs:{} raw:descriptor body:schema-dsl|none'], part: true
  'code':                 forms: ['"code" attrs:{} raw:leaf body:program'], part: true
  'sym':                  forms: ['"sym" attrs:{} raw:leaf']
  'schema-array':         forms: ['"schema-array" attrs:{} raw:leaf']
  'schema-dsl':           forms: ['"schema-dsl" attrs:{}|{inline} kind:sym|none adapter:schema-adapter|none ...lines:schema-field|schema-callable|schema-ensure|schema-scope|schema-directive|schema-member'], part: true
  'schema-adapter':       forms: ['"schema-adapter" attrs:{} keyword:name body:code'], part: true
  'schema-field':         forms: ['"schema-field" attrs:{} name:name modifiers:[leaf]|none type:schema-type|none parts:[schema-bracket|schema-attrs|schema-range|regex|schema-transform|schema-attr|","]|none'], part: true
  'schema-type':          forms: ['"schema-type" attrs:{} core:name|schema-coerce|schema-union|none ...arrays:schema-array'], part: true
  'schema-coerce':        forms: ['"schema-coerce" attrs:{} target:name|sym'], part: true
  'schema-union':         forms: ['"schema-union" attrs:{} first:string|schema-bracket ...rest:string|schema-bracket'], part: true
  'schema-bracket':       forms: ['"schema-bracket" attrs:{} ...values:num|schema-neg|string|name|sym|regex'], part: true
  'schema-neg':           forms: ['"schema-neg" attrs:{} value:num'], part: true
  'schema-range':         forms: ['"schema-range" attrs:{} min:num|schema-neg|none max:num|schema-neg|none'], part: true
  'schema-attrs':         forms: ['"schema-attrs" attrs:{} ...options:schema-option'], part: true
  'schema-option':        forms: ['"schema-option" attrs:{} key:name value:num|schema-neg|string|name|sym|regex'], part: true
  'schema-transform':     forms: ['"schema-transform" attrs:{} body:code'], part: true
  'schema-attr':          forms: ['"schema-attr" attrs:{} name:name'], part: true
  'schema-callable':      forms: ['"schema-callable" attrs:{} name:name params:schema-params|none arrow:"->"|"~>"|"!>" body:code'], part: true
  'schema-params':        forms: ['"schema-params" attrs:{} raw:leaf'], part: true
  'schema-fn':            forms: ['"schema-fn" attrs:{} params:schema-params|none body:code'], part: true
  'schema-ensure':        forms: ['"schema-ensure" attrs:{}|{async} ...items:string|num|schema-neg|name|sym|schema-fn|schema-ensure-list'], part: true
  'schema-ensure-list':   forms: ['"schema-ensure-list" attrs:{} ...elements:string|num|schema-neg|name|sym|schema-fn'], part: true
  'schema-scope':         forms: ['"schema-scope" attrs:{}|{default} name:sym|none fn:schema-fn'], part: true
  'schema-directive':     forms: ['"schema-directive" attrs:{} name:name ...args:name|sym|num|schema-neg|string|schema-bracket|schema-attrs|schema-mark'], part: true
  'schema-mark':          forms: ['"schema-mark" attrs:{} raw:","|"."|"?"'], part: true
  'schema-member':        forms: ['"schema-member" attrs:{} name:sym value:num|schema-neg|string|name|none'], part: true
  'type-apply':           forms: ['"type-apply" attrs:{} base:expr ...args:expr']
  'type-array':           forms: ['"type-array" attrs:{} element:expr']
  'type-conditional':     forms: ['"type-conditional" attrs:{} check:expr extends:expr then:expr else:expr']
  'type-constructor':     forms: ['"type-constructor" attrs:{}|{abstract} generics:[type-var]|none params:[type-param] returns:expr|type-predicate']
  'type-element':         forms: ['"type-element" attrs:{}|{optional}|{rest} name:name|none type:expr'], part: true
  'type-function':        forms: ['"type-function" attrs:{} generics:[type-var]|none params:[type-param] returns:expr|type-predicate']
  'type-import':          forms: ['"type-import" attrs:{} source:string']
  'type-index':           forms: ['"type-index" attrs:{} object:expr index:expr']
  'type-index-signature': forms: ['"type-index-signature" attrs:{}|{readonly} name:name key:expr type:expr'], part: true
  'type-infer':           forms: ['"type-infer" attrs:{} name:name']
  'type-intersection':    forms: ['"type-intersection" attrs:{} ...members:expr']
  'type-keyof':           forms: ['"type-keyof" attrs:{} operand:expr']
  'type-mapped':          forms: ['"type-mapped" attrs:{}|{readonly}|{optional}|{optional readonly} name:name constraint:expr type:expr'], part: true
  'type-member':          forms: ['"type-member" attrs:{} object:expr property:name']
  'type-method':          forms: ['"type-method" attrs:{}|{optional} key:name|string|num generics:[type-var]|none params:[type-param] returns:expr|type-predicate|none'], part: true
  'type-call-signature':  forms: ['"type-call-signature" attrs:{} generics:[type-var]|none params:[type-param] returns:expr|type-predicate'], part: true
  'type-construct-signature': forms: ['"type-construct-signature" attrs:{} generics:[type-var]|none params:[type-param] returns:expr|type-predicate'], part: true
  'type-negative':        forms: ['"type-negative" attrs:{} value:num']
  'type-object':          forms: ['"type-object" attrs:{} ...members:type-prop|type-method|type-call-signature|type-construct-signature|type-index-signature|type-mapped']
  'type-param':           forms: ['"type-param" attrs:{}|{optional}|{rest} name:name|this type:expr|none'], part: true
  'type-predicate':       forms: ['"type-predicate" attrs:{}|{asserts} subject:name|this type:expr|none'], part: true
  'type-prop':            forms: ['"type-prop" attrs:{}|{readonly}|{optional}|{optional readonly} key:name|string|num type:expr'], part: true
  'type-query':           forms: ['"type-query" attrs:{} target:expr']
  'type-readonly':        forms: ['"type-readonly" attrs:{} operand:expr']
  'type-tuple':           forms: ['"type-tuple" attrs:{} ...elements:expr|type-element']
  'type-union':           forms: ['"type-union" attrs:{} ...members:expr']
  'type-unique':          forms: ['"type-unique" attrs:{} operand:expr']
  'type-var':             forms: ['"type-var" attrs:{} name:name constraint:expr|none default:expr|none'], part: true

# ==============================================================================
# Expected Conflicts
# ==============================================================================
# The grammar's declared ambiguities: every reduce-reduce and ambiguous
# shift-reduce default the parse table may contain, with its resolution
# count. An ambiguous entry names the rule whose reduction a default
# shift beat; a reduce-reduce entry names the reduction the table KEPT
# `over` the one it dropped, so a reorder that flips the winner is a
# drift, not a silent change of meaning. Solar fails generation on any
# drift — a new conflicted pair, a vanished one, or a changed count — so
# a grammar edit that introduces a genuine ambiguity cannot resolve
# silently.
#
# Each entry is a decision, not an accident:
#
# • Try/Finalizer family — the dangling-catch/finally decision: after
#   `try E`, a following CATCH/FINALLY (or an expression continuation)
#   could attach to this try or end it. Shift attaches greedily to the
#   nearest try, matching every brace language; canonical LR(1) would
#   keep these conflicts too.
# • The guard operations over Statement → Return / STATEMENT — after
#   the guard idiom (`E && return V`, `E || continue`, `||`, `??`,
#   `then` / loose `else`), the four postfix modifiers (POST_IF POST_UNLESS
#   WHILE UNTIL) sit in the lookaheads of both the completed Operation
#   and the bare Return/STATEMENT-as-Statement (an LALR merge: no
#   canonical state has both). The Operation must win, and the pinned
#   behavior is modifier-binds-widest (`c && return 3 if flag`
#   compiles to `if (flag) if (c) return 3`; `x or continue if y` and
#   `x then return 1 if y` likewise).
# • ExportSpecifier over SimpleObjAssignable — an LALR-merged state
#   serves both `export { name }` and object-literal shorthand; on the
#   four shared boundary tokens (`,` `}` TERMINATOR INDENT) rule order
#   picks ExportSpecifier, and only export context reaches those cells.
# • ObjRestValue over ObjSpreadExpr — after `{ ...x`, a boundary token
#   ends the rest value (ObjRestValue → ... SimpleObjAssignable) or the
#   inner name keeps growing into a spread expression; rule order
#   closes the plain rest reading.
# • TypeDecl — after `def f(...) T`, INDENT opens the declaration's
#   annotated body rather than reducing the bare signature; shift
#   keeps the body with the declaration.

expectedConflicts = [
  ['reduce-reduce', 'Operation → Expression && Return over Statement → Return'                                                                    ,  4]
  ['reduce-reduce', 'Operation → Expression || Return over Statement → Return'                                                                    ,  4]
  ['reduce-reduce', 'Operation → Expression ?? Return over Statement → Return'                                                                    ,  4]
  ['reduce-reduce', 'Operation → Expression THEN Return over Statement → Return'                                                                ,  4]
  ['reduce-reduce', 'Operation → Expression LOOSE_ELSE Return over Statement → Return'                                                                   ,  4]
  ['reduce-reduce', 'Operation → Expression && STATEMENT over Statement → STATEMENT'                                                              ,  4]
  ['reduce-reduce', 'Operation → Expression || STATEMENT over Statement → STATEMENT'                                                              ,  4]
  ['reduce-reduce', 'Operation → Expression ?? STATEMENT over Statement → STATEMENT'                                                              ,  4]
  ['reduce-reduce', 'Operation → Expression THEN STATEMENT over Statement → STATEMENT'                                                            ,  4]
  ['reduce-reduce', 'Operation → Expression LOOSE_ELSE STATEMENT over Statement → STATEMENT'                                                             ,  4]
  ['reduce-reduce', 'ExportSpecifier → Identifier over SimpleObjAssignable → Identifier'                                                          ,  4]
  ['reduce-reduce', 'ObjRestValue → ... SimpleObjAssignable over ObjSpreadExpr → SimpleObjAssignable'                                             ,  5]
  ['ambiguous',     'Try → TRY Block'                         ,  2]
  ['ambiguous',     'Try → TRY Expression'                    , 26]
  ['ambiguous',     'Try → TRY Statement'                     ,  6]
  ['ambiguous',     'Try → TRY Block Catch'                   ,  1]
  ['ambiguous',     'Try → TRY Expression Catch'              ,  1]
  ['ambiguous',     'Try → TRY Statement Catch'               ,  1]
  ['ambiguous',     'Finalizer → FINALLY Expression'          , 24]
  ['ambiguous',     'TypeDecl → DEF Identifier OptParams TYPE',  1]
  ['ambiguous',     'TypeDecl → DEF Identifier TYPE_PARAMS OptParams TYPE', 1]
]

# ==============================================================================
# Export
# ==============================================================================

# ==============================================================================
# Leaves
# ==============================================================================
# The terminals whose values are the tree's leaves. The parser builds
# each as a node of its own, [kind, {}, raw] with `raw` the token's
# value, and records its NodeStore row with the token's span. `@` alone
# is a `this` leaf spelled `@`. Keyword words stay strings: the
# receiver the grammar writes for `@x`, `@"s"` and a key's `@[k]`,
# `super`, the `import` of a dynamic import and of `import.meta`, the
# `new` of `new.target`, and the specifier words `*` and `default`; so
# do operators, a type declaration's text, symbol names and regex
# flags. An annotation token's value is no leaf: it is the types entry's
# ["type", {}, raw, body] (`entries` below).

leaves =
  IDENTIFIER: 'name'
  PROPERTY: 'name'
  NUMBER: 'num'
  STRING: 'string'
  REGEX: 'regex'
  BOOL: 'lit'
  NULL: 'lit'
  UNDEFINED: 'lit'
  THIS: 'this'
  STATEMENT: 'statement'
  S_WORD: 'name'
  S_DIRECTIVE: 'name'
  S_ON: 'name'
  S_SYMBOL: 'sym'
  S_KIND: 'sym'
  S_ARRAY: 'schema-array'

# ==============================================================================
# Entries
# ==============================================================================
# The grammar's further start symbols, each a sub-language of the one
# table: a terminal an entry names carries a payload the driver parses
# from that start symbol, and the token's value is [kind, {}, raw, body].

entries =
  TypeAnnotation:
    kind: 'type'
    terminals: ['TYPE', 'CAST', 'SATISFIES']
    opaque: true
  SchemaBody:
    kind: 'schema-body'
    terminals: ['SCHEMA_BODY']
  Root:
    kind: 'code'
    terminals: ['SCHEMA_CODE']

export default {grammar, operators, displays, kinds, leaves, entries, expectedConflicts, start: 'Root'}
