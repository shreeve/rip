node_modules/
# Track dist/@rip ship artifacts; ignore other dist/ scratch. The rule
# above is anchored to the repo root (it contains a slash), so nested
# build output needs its own — packages/print/vscode/dist holds the
# bundled extension, rebuilt by its package script.
dist/*
!dist/@rip/
packages/print/vscode/dist/

.DS_Store
*.log
*.vsix

.env
.env.*
!.env.example

# Stray scratch/export files
tmp-*
/packages/tray/macos/.build
/packages/tray/dist
/test/browser/test-results

# Janus binary: downloaded from github.com/shreeve/janus releases, never committed
/packages/sites/bin/janus
notes.txt
