*.rip linguist-language=CoffeeScript

# The browser bundle is generated by `bun run browser`. A merge keeps this
# side's copy (the `ours` driver: `git config merge.ours.driver true`, once
# per clone) and the bundle is regenerated after; GitHub folds it as
# generated in diffs.
dist/@rip/rip.js       merge=ours linguist-generated=true
dist/@rip/rip.min.js   merge=ours linguist-generated=true
dist/@rip/rip.min.js.br merge=ours linguist-generated=true
dist/@rip/watch.js     merge=ours linguist-generated=true
