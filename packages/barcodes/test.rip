test "svg, optimized and plain", ->
  raw = encodeQR 'Hello world', 'raw'
  svg = encodeQR 'Hello world', 'svg'
  ok svg.startsWith('<svg viewBox="0 0 25 25" xmlns="http://www.w3.org/2000/svg"><path d="M2 2h1v1H2Zm1 0h1v1H3Z')
  ok svg.includes('h-1Z')   # cells at x >= 10 return by `h-1`, the shorter command
  eq svgCells(svg, 25), raw
  plain = encodeQR 'Hello world', 'svg', optimize: false
  ok plain.startsWith('<svg viewBox="0 0 25 25" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="1" height="1" />')
  eq svgCells(plain, 25), raw

test "gif and data-url", ->
  raw = encodeQR 'Hello world', 'raw'
  gif = encodeQR 'Hello world', 'gif', scale: 2
  {width, height, pixels} = gifPixels gif
  eq [width, height], [50, 50]
  expected = []
  for y in [0...50]
    expected.push(if raw[y // 2][x // 2] then 1 else 0) for x in [0...50]
  eq pixels, expected
  eq encodeQR('Hello world', 'data-url'), 'data:image/gif;base64,' + Buffer.from(encodeQR('Hello world', 'gif')).toString('base64')

