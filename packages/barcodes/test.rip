test "every version at medium, auto mask", ->
  for hash, i in VERSION_HASHES
    ver = i + 1
    eq Bun.hash(rows(encodeQR('RIP'.repeat(ver), 'raw', version: ver, ecc: 'medium', border: 1))).toString(), hash, "v#{ver}"

