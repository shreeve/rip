# ==============================================================================
# rip/barcodes tests — encoder pins generated once from the reference
# implementation, decoder round trips over synthetic rasters, Code 128 against
# the published vector, package surface
# ==============================================================================

import { test, eq, ok, throws } from 'rip/testing'
import encodeQR from 'rip/barcodes'
import * as enc from 'rip/barcodes'
import { decodeQR, QRScanner, decodeQRBatch, _tests } from 'rip/barcodes/qr'
import * as qr from 'rip/barcodes/qr'
import * as dom from 'rip/barcodes/dom'
import { encodeCode128, readCode128, decodeCode128, _tests as c128 } from 'rip/barcodes/code128'
import * as code128 from 'rip/barcodes/code128'
import { encodePDF417, readPDF417, decodePDF417, _tests as p417 } from 'rip/barcodes/pdf417'
import * as pdf417 from 'rip/barcodes/pdf417'
import { readFileSync } from 'fs'

{ BYTES, alignmentPatterns, formatBits, versionBits, maskBits, popcnt, encodeData, detectType } = _tests

WIKIPEDIA =! [104, 55, 73, 75, 73, 80, 69, 68, 73, 65, 88, 106]

bits =! (row) -> row.map((b) -> if b then '1' else '0').join('')
rows =! (raw) -> raw.map(bits).join('\n')
flat =! (W, H, value) -> { width: W, height: H, data: Uint8Array.new(W * H * 4).fill(value) }
art  =! (picture) -> picture.split('\n').map (row) -> [...row].map (ch) -> ch is '#'
ansi =! (picture) -> picture.replaceAll('#', '\x1b[40m  \x1b[0m').replaceAll('.', '\x1b[1;47m  \x1b[0m') + '\n'

# Modules painted by an SVG, as a raw matrix: the optimized path draws each
# module as a move, `h1v1`, a return to its left edge, and `Z`; plain output
# draws one rect per module. Everything outside the envelope must be a module.
svgCells =! (svg, W) ->
  cells = ((false for x in [0...W]) for y in [0...W])
  cell = /([Mm])(-?\d+) (-?\d+)h1v1(?:H(\d+)|h-1)Z|<rect x="(\d+)" y="(\d+)" width="1" height="1" \/>/g
  x = 0
  y = 0
  for m in svg.matchAll cell
    if m[5] isnt undefined
      x = +m[5]
      y = +m[6]
    else
      if m[1] is 'M'
        x = +m[2]
        y = +m[3]
      else
        x += +m[2]
        y += +m[3]
      eq +m[4], x if m[4] isnt undefined   # `H<x>` returns to the cell's own left edge
    cells[y][x] = true
  rest = svg.replace cell, ''
  open = "<svg viewBox=\"0 0 #{W} #{W}\" xmlns=\"http://www.w3.org/2000/svg\">"
  ok rest is open + '<path d=""/></svg>' or rest is open + '</svg>', rest
  cells

# Pixels of a GIF from the package's own writer: GIF87a, a 128-entry palette
# with entry 0 white and the rest black, then an uncompressed LZW stream whose
# every sub-block opens with a clear code and carries literal palette indices.
gifPixels =! (gif) ->
  eq String.fromCharCode(...gif.subarray(0, 6)), 'GIF87a'
  width  = gif[6] | gif[7] << 8
  height = gif[8] | gif[9] << 8
  eq Array.from(gif.subarray(10, 16)), [0xf6, 0, 0, 255, 255, 255]
  eq Array.from(gif.subarray(16, 397)).every((b) -> b is 0), true
  eq Array.from(gif.subarray(397, 408)), [0x2c, 0, 0, 0, 0, gif[6], gif[7], gif[8], gif[9], 0, 7]
  pixels = []
  pos    = 408
  until gif[pos] is 1 and gif[pos + 1] is 0x81
    n = gif[pos]
    eq gif[pos + 1], 0x80
    pixels.push ...gif.subarray(pos + 2, pos + 1 + n)
    pos += n + 1
  eq Array.from(gif.subarray(pos, gif.length)), [1, 0x81, 0, 0x3b]
  { width, height, pixels }

# ==[ Package surface ]==

p "\nPackage"

test "exports", ->
  eq Object.keys(enc).sort(), ['QRScanner', 'decodeCode128', 'decodePDF417', 'decodeQR', 'decodeQRBatch', 'default', 'encodeCode128', 'encodePDF417', 'encodeQR', 'readCode128', 'readPDF417']
  eq enc.default,       encodeQR
  eq enc.decodeQR,      decodeQR
  eq enc.encodeCode128, encodeCode128
  eq enc.decodeCode128, decodeCode128
  eq Object.keys(qr).sort(), ['QRScanner', '_tests', 'decodeQR', 'decodeQRBatch', 'encodeQR']
  eq Object.keys(code128).sort(), ['_tests', 'decodeCode128', 'encodeCode128', 'readCode128']
  eq Object.keys(pdf417).sort(),  ['_tests', 'decodePDF417', 'encodePDF417', 'readPDF417']
  eq Object.keys(dom).sort(), ['BarcodeDetector', 'QRCamera', 'QRCanvas', 'frameLoop', 'getSize', 'gifToPng', 'rearCamera', 'selfieCamera', 'svgToPng']

test "no runtime deps, declares browser safety and earns it", ->
  pkg = JSON.parse readFileSync("#{import.meta.dir}/package.json", 'utf8')
  eq pkg.dependencies, undefined
  eq pkg.rip,          { browser: true }
  for file in pkg.files when file.endsWith('.rip')
    source = readFileSync "#{import.meta.dir}/#{file}", 'utf8'
    eq /\bBun\.|node:|process\.|globalThis/.test(source), false, file

