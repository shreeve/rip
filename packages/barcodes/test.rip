test "encodeData vectors", ->
  for [text, version, ecc, type, bytes] in ENCODE_DATA
    utf8 = if type is 'byte' then TextEncoder.new().encode(text) else undefined
    eq Array.from(encodeData(version, ecc, text, type, utf8)), bytes, text

test "detectType", ->
  eq detectType('12345678'),    'numeric'
  eq detectType('HELLO WORLD'), 'alphanumeric'
  eq detectType('hello'),       'byte'
  eq detectType('🔻'),          'byte'

