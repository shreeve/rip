# ==============================================================================
# rip/barcodes — scorecard against ZXing's blackbox corpus
#
# Runs the three readers over the QR, PDF417, Code 128 and false-positive
# image sets in a ZXing checkout at misc/zxing and prints, per set and
# rotation, how many images read against how many ZXing's own tests expect.
# Reads the PNGs itself, so nothing beyond the runtime is needed.
#
#   rip corpus.rip [sets] [rotations] [-v]
#   rip corpus.rip pdf417,code128 0,180 -v
#
# Sets are name prefixes; rotations are degrees. -v lists every miss.
# ==============================================================================

import { readFileSync, readdirSync, existsSync } from 'fs'
import { inflateSync } from 'zlib'
import { decodeQR } from './qr.rip'
import { readCode128 } from './code128.rip'
import { readPDF417 } from './pdf417.rip'

ROOT =! "#{import.meta.dir}/../../misc/zxing/core/src/test/resources/blackbox/"

# ==[ PNG ]==

# A non-interlaced PNG as RGBA: grayscale, RGB, palette, and either with
# alpha, at one to eight bits per sample, which covers the corpus.
readPng =! (file) ->
  bytes = readFileSync file
  fail "#{file} is not a PNG" unless bytes.readUInt32BE(0) is 0x89504e47
  at    = 8
  idat  = []
  plte  = null
  head  = null
  while at < bytes.length
    size = bytes.readUInt32BE at
    kind = bytes.toString 'latin1', at + 4, at + 8
    body = bytes.subarray at + 8, at + 8 + size
    switch kind
      when 'IHDR' then head = { width: body.readUInt32BE(0), height: body.readUInt32BE(4), depth: body[8], color: body[9], interlace: body[12] }
      when 'PLTE' then plte = body
      when 'IDAT' then idat.push body
    break if kind is 'IEND'
    at += 12 + size
  {width, height, depth, color, interlace} = head
  fail "#{file}: interlaced PNG" if interlace
  channels = { 0: 1, 2: 3, 3: 1, 4: 2, 6: 4 }[color]
  bpp      = Math.max 1, (channels * depth) >> 3
  stride   = (width * channels * depth + 7) >> 3
  raw      = inflateSync Buffer.concat(idat)
  rows     = Uint8Array.new stride * height
  # Undo the per-row filter against the row above.
  for y in [0...height]
    filter = raw[y * (stride + 1)]
    src    = y * (stride + 1) + 1
    dst    = y * stride
    for x in [0...stride]
      v = raw[src + x]
      a = if x >= bpp then rows[dst + x - bpp] else 0
      b = if y then rows[dst - stride + x] else 0
      c = if y and x >= bpp then rows[dst - stride + x - bpp] else 0
      rows[dst + x] = switch filter
        when 1 then v + a
        when 2 then v + b
        when 3 then v + ((a + b) >> 1)
        when 4
          pa = Math.abs b - c
          pb = Math.abs a - c
          pc = Math.abs a + b - 2 * c
          v + (if pa <= pb and pa <= pc then a else if pb <= pc then b else c)
        else v
  data  = Uint8Array.new width * height * 4
  scale = 255 / ((1 << depth) - 1)
  for y in [0...height]
    row = y * stride
    for x in [0...width]
      out = 4 * (y * width + x)
      if depth is 8
        i = row + x * channels
        switch color
          when 0 then data[out] = data[out + 1] = data[out + 2] = rows[i]
          when 2 then data[out] = rows[i]; data[out + 1] = rows[i + 1]; data[out + 2] = rows[i + 2]
          when 3 then data[out] = plte[3 * rows[i]]; data[out + 1] = plte[3 * rows[i] + 1]; data[out + 2] = plte[3 * rows[i] + 2]
          when 4 then data[out] = data[out + 1] = data[out + 2] = rows[i]
          when 6 then data[out] = rows[i]; data[out + 1] = rows[i + 1]; data[out + 2] = rows[i + 2]
      else
        bit   = x * depth
        v     = (rows[row + (bit >> 3)] >> (8 - depth - (bit & 7))) & ((1 << depth) - 1)
        if color is 3
          data[out] = plte[3 * v]; data[out + 1] = plte[3 * v + 1]; data[out + 2] = plte[3 * v + 2]
        else
          data[out] = data[out + 1] = data[out + 2] = Math.round v * scale
      data[out + 3] = 255
  { width, height, data }

fail =! (msg) -> throw Error.new msg

# ZXing's pass counts at 0, 90, 180 and 270 degrees, from its blackbox test
# cases; null where ZXing does not test that rotation.
EXPECT =!
  'qrcode-1':  [17, 14, 17, 14]
  'qrcode-2':  [32, 30, 31, 31]
  'qrcode-3':  [38, 39, 36, 39]
  'qrcode-4':  [36, 35, 35, 35]
  'qrcode-5':  [19, 19, 19, 19]
  'qrcode-6':  [15, 14, 13, 14]
  'pdf417-1':  [14, 14, 14, 14]
  'pdf417-2':  [25, null, 25, null]
  'pdf417-3':  [19, null, 19, null]
  'code128-1': [7, null, 7, null]
  'code128-2': [36, null, 36, null]
  'code128-3': [2, null, 2, null]
  'falsepositives': [2, 2, 2, 2]     # false reads allowed, not reads expected

args      = process.argv.slice 2
verbose   = args.includes '-v'
args      = args.filter (a) -> a isnt '-v'
sets      = if args[0] then args[0].split(',') else ['qrcode', 'pdf417', 'code128', 'falsepositives']
rotations = if args[1] then args[1].split(',').map(Number) else [0, 90, 180, 270]

rotate =! (img, deg) ->
  return img unless deg
  {width: W, height: H, data} = img
  out = Uint8Array.new data.length
  nw  = if deg is 180 then W else H
  nh  = if deg is 180 then H else W
  for y in [0...H]
    for x in [0...W]
      [nx, ny] = switch deg
        when 90  then [H - 1 - y, x]
        when 180 then [W - 1 - x, H - 1 - y]
        else          [y, W - 1 - x]
      src = 4 * (y * W + x)
      dst = 4 * (ny * nw + nx)
      out[dst]     = data[src]
      out[dst + 1] = data[src + 1]
      out[dst + 2] = data[src + 2]
      out[dst + 3] = 255
  { width: nw, height: nh, data: out }

# Every reader on a false-positive image; any of them reading is a false read.
readAny =! (img) ->
  hit = readCode128(img) or readPDF417(img)
  return hit if hit
  try { text: decodeQR(img, effort: Infinity, timeLimit: Infinity) } catch then null

readers =!
  qrcode:  (img) -> try { text: decodeQR(img, effort: Infinity, timeLimit: Infinity) } catch then null
  pdf417:  readPDF417
  code128: readCode128
  falsepositives: readAny

expected =! (dir, base) ->
  bin = "#{dir}#{base}.bin"
  txt = "#{dir}#{base}.txt"
  return { bytes: readFileSync(bin) } if existsSync bin
  return { text: readFileSync(txt, 'utf8') } if existsSync txt
  null

matches =! (hit, want) ->
  return false unless hit
  return true unless want
  if want.bytes then Buffer.from(hit.bytes or []).equals(want.bytes) else hit.text is want.text

pad =! (s, n) -> String(s).padStart n

names = readdirSync(ROOT).filter((d) -> EXPECT[d] and sets.some((s) -> d.startsWith s)).sort()
grand = { ours: 0, zxing: 0, false: 0, ms: 0, images: 0 }
p "set              images   " + rotations.map((r) -> pad("#{r}°", 9)).join('') + "   mean ms   max ms"
for name in names
  dir    = "#{ROOT}#{name}/"
  kind   = name.split('-')[0]
  read   = readers[kind]
  files  = readdirSync(dir).filter((f) -> f.endsWith '.png').sort()
  cells  = []
  ms     = 0
  worst  = 0
  for deg in rotations
    hits = 0
    for f in files
      base = f.slice 0, -4
      img  = rotate readPng(dir + f), deg
      want = expected dir, base
      t0   = performance.now()
      hit  = read img
      dt   = performance.now() - t0
      ms   += dt
      worst = dt if dt > worst
      good = if kind is 'falsepositives' then hit? else matches(hit, want)
      hits++ if good
      if verbose and (good isnt (kind isnt 'falsepositives'))
        what = if kind is 'falsepositives' then "FALSE #{JSON.stringify hit.text?.slice(0, 30)}" else if hit then "BAD #{JSON.stringify hit.text?.slice(0, 30)}" else 'MISS'
        p "  #{name}/#{base} #{deg}° #{what} #{dt.toFixed 1}ms"
    want = EXPECT[name][[0, 90, 180, 270].indexOf deg]
    if kind is 'falsepositives'
      grand.false += hits
      cells.push pad("#{hits}/≤#{want}", 9)
    else
      cells.push pad("#{hits}/#{if want? then want else '-'}", 9)
      if want?
        grand.ours  += hits
        grand.zxing += want
  runs = files.length * rotations.length
  grand.ms     += ms
  grand.images += runs
  p "#{name.padEnd 16} #{pad files.length, 6}   #{cells.join ''}   #{pad (ms / runs).toFixed(1), 7}   #{pad worst.toFixed(0), 6}"
p ""
p "reads #{grand.ours} of ZXing's #{grand.zxing} where ZXing tests the rotation; #{grand.false} false reads; #{(grand.ms / grand.images).toFixed 1} ms mean over #{grand.images} decodes"
