{
  "name": "@rip/barcodes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generate and read QR, PDF417 and Code 128 barcodes, in the browser or on the server, with no dependencies.",
  "rip": {
    "browser": true
  },
  "exports": {
    ".": "./barcodes.rip",
    "./qr": "./qr.rip",
    "./code128": "./code128.rip",
    "./dom": "./dom.rip",
    "./pdf417": "./pdf417.rip"
  },
  "scripts": {
    "test": "rip test.rip",
    "corpus": "rip test/corpus.rip",
    "bench": "rip test/bench.rip",
    "compare": "rip test/compare.rip"
  },
  "files": [
    "barcodes.rip",
    "eci.rip",
    "gif.rip",
    "image.rip",
    "qr.rip",
    "code128.rip",
    "pdf417.rip",
    "dom.rip",
    "README.md"
  ],
  "devDependencies": {
    "@zxing/library": "^0.23.0",
    "zxing-wasm": "^3.1.4"
  }
}
