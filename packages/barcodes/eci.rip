# ==============================================================================
# rip/barcodes — Extended Channel Interpretation
#
# The AIM ECI designators for character sets, as text decoders shared by the
# readers; an ECI stays active until another replaces it.
# ==============================================================================

ECI_ENCODINGS =!
  1:  'iso-8859-1',    2: 'ibm437',        3: 'iso-8859-1',    4: 'iso-8859-2',  5: 'iso-8859-3'
  6:  'iso-8859-4',    7: 'iso-8859-5',    8: 'iso-8859-6',    9: 'iso-8859-7', 10: 'iso-8859-8'
  11: 'iso-8859-9',   12: 'iso-8859-10',  13: 'iso-8859-11',  15: 'iso-8859-13',  16: 'iso-8859-14'
  17: 'iso-8859-15',  18: 'iso-8859-16',  20: 'shift-jis',    21: 'windows-1250'
  22: 'windows-1251', 23: 'windows-1252', 24: 'windows-1256', 25: 'utf-16be'
  26: 'utf-8',        28: 'big5',         29: 'gbk',          30: 'euc-kr'

export ECI_DECODERS =! {}
for id, name of ECI_ENCODINGS
  ECI_DECODERS[id] = try TextDecoder.new(name) catch then undefined

# The decoder for a byte segment that names no ECI: UTF-8 when the bytes
# are valid UTF-8, Shift JIS when they read as kana or kanji words, else
# ISO-8859-1. The tests mirror ZXing's, since the symbols in the wild that
# omit the ECI were made for readers that guess this way.
export guessDecoder =! (bytes) ->
  utf8    = true
  sjis    = true
  latin   = true
  left8   = 0
  multi   = 0
  leftS   = 0
  kana    = 0
  kanaRun = 0
  kanaMax = 0
  wideRun = 0
  wideMax = 0
  high    = 0
  n = bytes.length
  for i in [0...n]
    break unless utf8 or sjis or latin
    v = bytes[i]
    if utf8
      if left8 > 0
        if (v & 0xc0) is 0x80 then left8-- else utf8 = false
      else if v & 0x80
        if (v & 0xe0) is 0xc0 then left8 = 1
        else if (v & 0xf0) is 0xe0 then left8 = 2
        else if (v & 0xf8) is 0xf0 then left8 = 3
        else utf8 = false
        multi++ if utf8
    if latin
      if v > 0x7f and v < 0xa0 then latin = false
      else if v > 0x9f and (v < 0xc0 or v is 0xd7 or v is 0xf7) then high++
    if sjis
      if leftS > 0
        if v < 0x40 or v is 0x7f or v > 0xfc then sjis = false else leftS--
      else if v is 0x80 or v is 0xa0 or v > 0xef
        sjis = false
      else if v > 0xa0 and v < 0xe0
        kana++
        wideRun = 0
        kanaMax = kanaRun if ++kanaRun > kanaMax
      else if v > 0x7f
        leftS++
        kanaRun = 0
        wideMax = wideRun if ++wideRun > wideMax
      else
        kanaRun = 0
        wideRun = 0
  utf8 = false if left8 > 0
  sjis = false if leftS > 0
  return ECI_DECODERS[26] if utf8 and multi > 0
  return ECI_DECODERS[20] if sjis and (kanaMax >= 3 or wideMax >= 3)
  if latin and sjis
    return if (kanaMax is 2 and kana is 2) or high * 10 >= n then ECI_DECODERS[20] else ECI_DECODERS[3]
  return ECI_DECODERS[3]  if latin
  return ECI_DECODERS[20] if sjis
  ECI_DECODERS[26]
