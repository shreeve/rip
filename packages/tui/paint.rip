# Paint: the laid-out tree becomes a grid of cells, and two grids become
# the fewest bytes that turn one screen into the other.
#
# A grid is three typed arrays — the character, an interned style id,
# and a width flag — so a frame allocates nothing. Styling is structural:
# a style is a small record interned to an id, and its escape sequence is
# built once. Text arrives as a flow's units and rows (text.rip), so a
# line is drawn from offsets and no string is cut per frame.
#
# A frame paints and compares only its damage: the cells some change may
# have recolored, a span of columns on each row.

import { kids } from './layout.rip'
import { CLUSTER, glyph, crowded, evict, sanitize, Flow, refresh, MODES, A0, A1, B0, B1, DOTS, ROW } from './text.rip'

# ── Styles ────────────────────────────────────────────────────────────────────

# `default` is the terminal's own color, SGR 39 and 49: a color like any
# other, so it stands against an ancestor's color and against the
# background a run of text lands on.
NAMED =! {
  __proto__: null      # `constructor` is no color
  black: 0, red: 1, green: 2, yellow: 3, blue: 4, magenta: 5, cyan: 6, white: 7, default: 9
  gray: 60, grey: 60, blackBright: 60, redBright: 61, greenBright: 62, yellowBright: 63
  blueBright: 64, magentaBright: 65, cyanBright: 66, whiteBright: 67
}

COLORS =! "a name (red, greenBright, gray, default), '#rrggbb', 'rgb(r, g, b)' or 'ansi256(n)'"

# The SGR parameters for a color, on the foreground (30) or background
# (40); null for a value that is no color.
tint =! (color, base) ->
  return null unless typeof color is 'string'
  return String base + NAMED[color] if NAMED[color] isnt undefined
  if /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test color
    hex = color.slice 1
    hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2] if hex.length is 3
    n = parseInt hex, 16
    return "#{base + 8};2;#{n >> 16};#{(n >> 8) & 255};#{n & 255}"
  if m = /^rgb\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)$/.exec color
    return null if m[1] > 255 or m[2] > 255 or m[3] > 255
    return "#{base + 8};2;#{Number m[1]};#{Number m[2]};#{Number m[3]}"
  if m = /^ansi256\(\s*(\d+)\s*\)$/.exec color
    return (if m[1] > 255 then null else "#{base + 8};5;#{Number m[1]}")
  null

LIMIT =! 65536   # style ids a cell's sixteen bits can hold
SWEEP =! 32768   # styles held before those no cell uses are let go

# A style's switches, each one bit of its flags, and the SGR parameter of
# each.
SWITCHES =! ['bold', 'dimColor', 'italic', 'underline', 'inverse', 'strikethrough']
CODES =! [1, 2, 3, 4, 7, 9]
DIM =! 2

ids =! Map.new()   # foreground → background → flags and link → id
records =! [{ fg: null, bg: null, flags: 0, link: null, sgr: '', key: 0 }]
blends =! Map.new()

# The ids of one foreground on one background. A color is a string the
# app wrote once, so a style is found with no key built from its parts.
shelf =! (fg, bg) ->
  tones = ids.get(fg) ?? (ids.set(fg, Map.new()); ids.get fg)
  tones.get(bg) ?? (tones.set(bg, Map.new()); tones.get bg)

shelf(null, null).set 0, 0

# The styles held, for the tests to count.
export tally =! -> records.length

# The id of a style, minted on first sight; it stands until a sweep. A
# link is part of the style, so two grids differ where a link does.
export intern =! (fg, bg, flags, link = null) ->
  held = shelf fg, bg
  key = if link then "#{flags}|#{link}" else flags
  id = held.get key
  return id if id?
  parts = []
  for code, n in CODES
    parts.push code if flags & (1 << n)
  for [color, base] in [[fg, 30], [bg, 40]] when color?
    sgr = tint color, base
    throw Error.new "rip/tui: #{JSON.stringify color} is not a color — write #{COLORS}" unless sgr
    parts.push sgr
  throw Error.new "rip/tui: more than #{LIMIT} distinct styles are in use — a cell holds a style id in sixteen bits" if records.length >= LIMIT
  records.push { fg, bg, flags, link, sgr: parts.join(';'), key }
  held.set key, records.length - 1
  records.length - 1

# The style a node's own props describe, over the style it inherits.
# `color`, `bold`, `dimColor` and the other text attributes pass down the
# tree, from a box to the text inside it. A background does not: a box's
# `backgroundColor` is the rectangle `fill` paints and nothing more, and
# text with none of its own takes the background of each cell it lands
# on (`over`) — so words that spill out of a blue box are blue only
# where the box is, and a tip drawn over a red row sits on red whatever
# box it was written in. Inside one text a background is the text's
# own: `words` says so, and a nested run keeps it, as it keeps a link.
styleOf =! (node, inherited, words) ->
  s = node.styles
  base = records[inherited]
  flags = base.flags
  for name, n in SWITCHES
    flags |= (1 << n) if s[name]
  back = if words then s.backgroundColor ?? base.bg else base.bg
  # Most nodes say nothing about color or weight, and keep the id as it is.
  return inherited if flags is base.flags and not s.color? and back is base.bg and not s.link?
  intern s.color ?? base.fg, back, flags, s.link ?? base.link

# The escape sequence that leaves style `from` for style `to`. A style
# that is a link and nothing more has none of its own.
shift =! (from, to) ->
  next = records[to].sgr
  return (if records[from].sgr then "\x1b[0m" else '') unless next
  if records[from].sgr then "\x1b[0;#{next}m" else "\x1b[#{next}m"

# The escape sequence that makes what follows a hyperlink to `url`
# (OSC 8), or with null ends the one that is open.
hop =! (url) -> "\x1b]8;;#{url ?? ''}\x1b\\"

# Text drawn with no background of its own keeps the one beneath it.
over =! (id, beneath) ->
  top = records[id]
  under = records[beneath]
  return id if top.bg? or not under.bg?
  key = (id << 16) | beneath
  blends.get(key) ?? (blends.set(key, intern(top.fg, under.bg, top.flags, top.link)); blends.get(key))

# ── Borders ───────────────────────────────────────────────────────────────────

# Each style's eight glyphs, clockwise from the top left corner — the
# styles and the glyphs of `cli-boxes`, as Ink draws them.
TL =! 0
T  =! 1
TR =! 2
R  =! 3
BR =! 4
B  =! 5
BL =! 6
L  =! 7

export PARTS =! ['topLeft', 'top', 'topRight', 'right', 'bottomRight', 'bottom', 'bottomLeft', 'left']

BORDERS =! {
  __proto__: null
  single: '┌─┐│┘─└│', double: '╔═╗║╝═╚║', round: '╭─╮│╯─╰│', bold: '┏━┓┃┛━┗┃'
  singleDouble: '╓─╖║╜─╙║', doubleSingle: '╒═╕│╛═╘│', classic: '+-+|+-+|', arrow: '↘↓↙←↖↑↗→'
}

frames =! Map.new()
probe =! Flow.new()

# The eight cells of a border style: one of the names, or an object that
# gives each part a glyph of its own, one cell wide. A node keeps a copy
# of the object as it stood when the style was set (document.rip), so
# every cell of a border is drawn from the same eight glyphs, and one
# changed in place afterwards is not seen until it is set again. The
# cells are remembered by the glyphs, never by the object. A glyph obeys
# the rule text does: one that `sanitize` would alter, a control
# character above all, never reaches the terminal.
glyphsOf =! (style, key = 'borderStyle') ->
  custom = style and typeof style is 'object'
  unless custom or (typeof style is 'string' and BORDERS[style])
    throw Error.new "rip/tui: #{key}: #{JSON.stringify style} is not one of #{Object.keys(BORDERS).join ', '}, or an object of #{PARTS.join ', '}"
  name = if custom then "#{style.topLeft}\n#{style.top}\n#{style.topRight}\n#{style.right}\n#{style.bottomRight}\n#{style.bottom}\n#{style.bottomLeft}\n#{style.left}" else style
  cells = frames.get name
  return cells if cells
  cells = Uint32Array.new 8
  for part, n in PARTS
    text = if custom then style[part] else String.fromCodePoint BORDERS[style].codePointAt(n)
    probe.set (if typeof text is 'string' then text else ''), null
    unless typeof text is 'string' and sanitize(text) is text and probe.count is 1 and probe.span(0) is 1
      throw Error.new "rip/tui: #{key}: #{part}: #{JSON.stringify text} is not a border glyph — write one printing character, one cell wide"
    cells[n] = probe.code 0
  frames.set name, cells
  cells

# ── Values ────────────────────────────────────────────────────────────────────

SWITCH =! 1
COLOR  =! 2
CLIP   =! 3
OFFSET =! 4
BORDER =! 5
WRAP   =! 6
LINK   =! 7

CHECKS =! Map.new()
CHECKS.set name, SWITCH for name in SWITCHES
for side in ['', 'Top', 'Bottom', 'Left', 'Right']
  CHECKS.set "border#{side}Color", COLOR
  CHECKS.set "border#{side}BackgroundColor", COLOR
  CHECKS.set "border#{side}DimColor", SWITCH
CHECKS.set 'color', COLOR
CHECKS.set 'backgroundColor', COLOR
CHECKS.set key, CLIP for key in ['overflow', 'overflowX', 'overflowY']
CHECKS.set key, OFFSET for key in ['contentOffsetX', 'contentOffsetY']
CHECKS.set 'borderStyle', BORDER
CHECKS.set 'wrap', WRAP
CHECKS.set 'link', LINK

# Refuse a value the painter cannot use, where it is written and by the
# key it was written to — layout's `admit`, for the styles that recolor
# cells. A key the painter does not read is none of its business.
export allow! =! (key, value) ->
  check = CHECKS.get key
  return if check is undefined or value is undefined
  switch check
    when SWITCH
      throw Error.new "rip/tui: #{key}: #{JSON.stringify value} is not true or false" unless value is true or value is false
    when COLOR
      throw Error.new "rip/tui: #{key}: #{JSON.stringify value} is not a color — write #{COLORS}" unless tint value, 30
    when CLIP
      throw Error.new "rip/tui: #{key}: #{JSON.stringify value} is not one of visible, hidden" unless value is 'visible' or value is 'hidden'
    when OFFSET
      throw Error.new "rip/tui: #{key}: #{if typeof value is 'number' then value else JSON.stringify value} is not a number of cells — write a finite number" unless Number.isFinite value
    when BORDER then glyphsOf value, key
    when WRAP
      throw Error.new "rip/tui: #{key}: #{JSON.stringify value} is not one of #{Object.keys(MODES).join ', '}" if MODES[value] is undefined
    # A link goes to the terminal inside an escape sequence, so it is
    # refused, never repaired, unless every character is printable ASCII —
    # what OSC 8 asks of a URI, and what cannot end the sequence early.
    when LINK
      throw Error.new "rip/tui: #{key}: #{JSON.stringify value} is not a link — write a URL in printable ASCII, the rest percent-encoded (encodeURI)" unless typeof value is 'string' and /^[\x20-\x7e]+$/.test value

# ── Grid ──────────────────────────────────────────────────────────────────────

SPACE =! 32
DOT   =! 0x2026
FAR   =! 1073741823

epoch = 0   # sweeps so far; a grid's ids are of the tables its epoch names

export class Grid
  # `top` is the tree row shown on the grid's first row: a frame taller
  # than the screen shows its bottom. Every write is held to the clip —
  # columns [left, right), grid rows [over, under) — which starts as the
  # whole grid, and on each row to the columns [lo, hi) a frame owes,
  # which are the whole row unless a paint is handed its damage. `drawn`
  # is how many rows of it the terminal holds.
  constructor: (@cols, @rows, @top = 0) ->
    @drawn = @rows
    size = @cols * @rows
    @ch = Uint32Array.new size
    @style = Uint16Array.new size
    @wide = Uint8Array.new size
    @lo = Int32Array.new @rows
    @hi = Int32Array.new(@rows).fill @cols
    @cut = false
    @late = false
    @clear()

  clear!: ->
    @ch.fill SPACE
    @style.fill 0
    @wide.fill 1
    @epoch = epoch
    @clip 0, -FAR, @cols, FAR

  # Blank the cells a frame owes, and no others.
  wipe!: ->
    @epoch = epoch
    @clip 0, -FAR, @cols, FAR
    for row in [0...@rows] when @lo[row] < @hi[row]
      from = row * @cols + @lo[row]
      to = row * @cols + @hi[row]
      @ch.fill SPACE, from, to
      @style.fill 0, from, to
      @wide.fill 1, from, to

  # This grid at another height: the rows that stay, over blank ones.
  tall: (rows) ->
    grid = Grid.new @cols, rows, @top
    kept = @cols * Math.min rows, @rows
    grid.ch.set @ch.subarray 0, kept
    grid.style.set @style.subarray 0, kept
    grid.wide.set @wide.subarray 0, kept
    grid.epoch = @epoch
    grid.drawn = @drawn
    grid

  # Hold the writes that follow to a rectangle of tree coordinates.
  clip!: (left, top, right, bottom) ->
    @left = if left > 0 then left else 0
    @right = if right < @cols then right else @cols
    @over = if top - @top > 0 then top - @top else 0
    @under = if bottom - @top < @rows then bottom - @top else @rows

  # A glyph of `span` cells at index `at` in column `x`: its lead cell
  # holds it and says how wide it is, and each cell after is a
  # continuation, width zero. A glyph that lands on part of a wider one
  # blanks the rest of it, so a row never holds an orphaned lead or
  # continuation cell.
  set!: (at, x, cell, span, id) ->
    @blank at if @wide[at] isnt 1
    beneath = @style[at]
    @ch[at] = cell
    @style[at] = if beneath is 0 then id else over id, beneath
    return if span is 1
    for next in [at + 1...at + span]
      @blank next if @wide[next] > 1
      @ch[next] = SPACE
      @style[next] = @style[at]
    @wide[at] = span
    @wide.fill 0, at + 1, at + span

  # Turn the whole glyph that covers cell `at` into plain spaces, each
  # keeping its style.
  blank!: (at) ->
    at -= 1 while @wide[at] is 0
    span = @wide[at]
    @ch.fill SPACE, at, at + span
    @wide.fill 1, at, at + span

  # One cell wide glyph at (x, y).
  put!: (x, y, cell, id) ->
    y -= @top
    @set y * @cols + x, x, cell, 1, id if y >= @over and y < @under and x >= @left and x < @right and x >= @lo[y] and x < @hi[y]

  # `count` cells of one glyph, rightward from (x, y).
  run!: (x, y, cell, count, id) ->
    y -= @top
    return if y < @over or y >= @under
    stop = Math.min x + count, @right, @hi[y]
    x = Math.max x, @left, @lo[y]
    while x < stop
      @set y * @cols + x, x, cell, 1, id
      x += 1

  # Characters [from, to) of printable ASCII rightward from (x, y):
  # every one is a cell. Answers the column after the last.
  ascii: (x, y, text, from, to, id) ->
    end = x + to - from
    y -= @top
    return end if y < @over or y >= @under or x >= @right or end <= @left
    if x < @left
      from += @left - x
      x = @left
    to -= end - @right if end > @right
    if x < @lo[y]
      from += @lo[y] - x
      x = @lo[y]
    to = from + @hi[y] - x if x + to - from > @hi[y]
    at = y * @cols + x
    while from < to
      @set at, x, text.charCodeAt(from), 1, id
      from += 1
      at += 1
      x += 1
    end

  # Units [from, to) of a flow rightward from (x, y). A wide cluster cut
  # by a clip edge leaves a space in its style on each cell of it that
  # shows; a cluster of no width has no cell. One the clip leaves whole
  # and the owed columns would cut is owed whole, and the run it is in
  # with it — so the layers of a stack are taken in together, not a
  # glyph a paint: the row's span widens, and `cut` asks for the paint
  # again. A paint that is `late` owes the whole row, which nothing
  # cuts. Answers the column after the last.
  units: (x, y, flow, from, to, id) ->
    y -= @top
    start = x
    torn = false
    spans = flow.spans
    cells = flow.cells
    shown = y >= @over and y < @under
    row = y * @cols
    while from < to
      span = spans[from]
      if shown and span
        if x >= @left and x + span <= @right
          if x >= @lo[y] and x + span <= @hi[y]
            @set row + x, x, cells[from], span, id
          else if x + span > @lo[y] and x < @hi[y]
            torn = true
        else if x + span > @left and x < @right
          for col in [Math.max(x, @left, @lo[y])...Math.min(x + span, @right, @hi[y])]
            @set row + col, col, SPACE, 1, id
      x += span
      from += 1
    if torn
      @cut = true
      @lo[y] = if @late then 0 else Math.min @lo[y], Math.max(start, @left)
      @hi[y] = if @late then @cols else Math.max @hi[y], Math.min(x, @right)
    x

  # One line of any text at (x, y). Answers the column after the last.
  write: (x, y, text, id) ->
    probe.set text, null
    if probe.ascii then @ascii(x, y, text, 0, text.length, id) else @units(x, y, probe, 0, probe.count, id)

  # A rectangle of spaces in one style: a background covers what lies
  # under it. A wide glyph the rectangle's side cuts is blanked.
  fill!: (x, y, w, h, id) ->
    y -= @top
    w = if x + w < @right then x + w else @right
    x = @left if x < @left
    for row in [(if y > @over then y else @over)...(if y + h < @under then y + h else @under)]
      left = if @lo[row] > x then @lo[row] else x
      right = if @hi[row] < w then @hi[row] else w
      continue if left >= right
      at = row * @cols
      @blank at + left if @wide[at + left] is 0
      @blank at + right if right < @hi[row] and @wide[at + right] is 0
      @ch.fill SPACE, at + left, at + right
      @style.fill id, at + left, at + right
      @wide.fill 1, at + left, at + right

  # The grid as text: one string per row, trailing blanks trimmed.
  # With `ansi`, each run of a style carries its escape sequence, and a
  # link is closed on the row it opens on.
  toString: (ansi = false) ->
    lines = []
    for row in [0...@rows]
      line = ''
      held = 0
      url = null
      for col in [0...@cols]
        at = row * @cols + col
        continue if @wide[at] is 0
        if ansi and @style[at] isnt held
          line += shift held, @style[at]
          held = @style[at]
          if records[held].link isnt url
            url = records[held].link
            line += hop url
        line += glyph @ch[at]
      line += hop null if url
      line += "\x1b[0m" if ansi and records[held].sgr
      lines.push (if ansi then line else line.trimEnd())
    lines.join '\n'

# ── Damage ────────────────────────────────────────────────────────────────────

# The cells a frame owes: on each row of the grid the terminal shows, one
# span of columns [lo, hi) — the union of every box some change may have
# recolored, as it was painted and as it will be. A document owns one. A
# node says what it inked (`old`) before anything about it changes, and
# what it inks once the frame is laid out is asked of it then (`survey`).
# `whole` owes every cell: a first frame, a frame of another width or
# another top row, a frame after a sweep. A frame of another height
# keeps what the rows that stay owe, and owes each row that comes.
#
# A paint is held to the spans and the diff reads nothing else, so the
# spare grid is a scratch: only its owed cells are blanked, painted and
# compared, and the diff copies the cells that differ into the grid the
# terminal shows, which stays whole. No second grid is kept in step, and
# nothing is copied but what changed. A whole frame swaps the two.
#
# What is painted inside the spans must equal what a whole paint puts
# there, and a wide glyph is the one thing that reaches across an edge:
# written over by half, it blanks its other half. So no span may cut a
# glyph that some node's words put down: `Grid.units` widens the span to
# take its run in and asks for the paint again. That covers the frame on the
# terminal too — a glyph there was put down by a node that changed, whose
# bounds are owed whole, or by one that puts it down again.
export class Damage
  constructor: ->
    @whole = true
    @cols = @rows = @top = 0
    @passes = 0   # the paints the last frame took, for the tests to count
    @lo = @hi = null

  # Take the shape of `grid`, owing all of it or none.
  shape!: (grid, whole) ->
    unless @lo?.length is grid.rows
      @lo = Int32Array.new grid.rows
      @hi = Int32Array.new grid.rows
    @cols = grid.cols
    @rows = grid.rows
    @top = grid.top
    @whole = whole
    @lo.fill (if whole then 0 else @cols)
    @hi.fill (if whole then @cols else 0)

  # Take another height: a row that stays owes what it did, and a row
  # that comes is owed whole.
  fit!: (rows) ->
    return if rows is @rows
    lo = Int32Array.new rows
    hi = Int32Array.new(rows).fill @cols
    lo.set @lo.subarray 0, Math.min(rows, @rows)
    hi.set @hi.subarray 0, Math.min(rows, @rows)
    @lo = lo
    @hi = hi
    @rows = rows

  # Owe a box of tree coordinates.
  box!: (left, top, right, bottom) ->
    return if @whole
    left = 0 if left < 0
    right = @cols if right > @cols
    return if left >= right
    row = if top > @top then top - @top else 0
    end = if bottom - @top < @rows then bottom - @top else @rows
    while row < end
      @lo[row] = left if left < @lo[row]
      @hi[row] = right if right > @hi[row]
      row += 1

  # Whether a box of tree coordinates holds a cell that is owed.
  hits: (left, top, right, bottom) ->
    row = if top > @top then top - @top else 0
    end = if bottom - @top < @rows then bottom - @top else @rows
    while row < end
      return true if @lo[row] < right and @hi[row] > left
      row += 1
    false

  # Owe what `node` inked in the frame on the terminal: a box (`deep`
  # false) its own rectangle, where a border or a background made it ink
  # any; anything else the bounds the last survey left on it, shifted by
  # the content offsets above it. A node under a hidden one inked
  # nothing: the node that hid it owed its bounds. Nor did a node out of
  # the tree, whose removal owed them.
  old!: (node, deep) ->
    return if @whole
    dx = dy = 0
    up = node
    loop
      if s = up.styles
        return if s.hidden or s.display is 'none'
        if up isnt node and s.display isnt 'contents'
          dx -= Math.trunc s.contentOffsetX if s.contentOffsetX
          dy -= Math.trunc s.contentOffsetY if s.contentOffsetY
      break unless up.parentNode
      up = up.parentNode
    return unless up is node.ownerDocument.body
    rect = node.rect
    if deep
      @box node.bl + dx, node.bt + dy, node.br + dx, node.bb + dy
    else if node.styles.borderStyle? or node.styles.backgroundColor?
      @box rect.x + dx, rect.y + dy, rect.x + rect.w + dx, rect.y + rect.h + dy

  # The cells owed.
  count: ->
    cells = 0
    for row in [0...@rows] when @lo[row] < @hi[row]
      cells += @hi[row] - @lo[row]
    cells

# A node's bounds (`bl`, `bt`, `br`, `bb`) are the cells it and everything
# under it can ink, in tree coordinates before any offset above it: a
# box's rectangle, and its children's bounds as its own content offset
# shifts them — held to its box on an axis it clips; a leaf's words,
# which need not fill its box and may spill out of it. A change marks the node and every ancestor (`stain`,
# document.rip), and only marked nodes are surveyed: a clean subtree
# answers from the bounds it holds. What changed owes its cells as they
# will be painted: a box that moved, or took another border or
# background, (2) its rectangle where it inks one; anything else (3)
# its bounds.
survey! =! (node, dx, dy, damage) ->
  stain = node.stain
  rect = node.rect
  l = rect.x
  t = rect.y
  r = l + rect.w
  b = t + rect.h
  if node.nodeType is 3 or node.tagName is 'span'
    # A leaf inks its words and no more of its box: each row from the
    # box's left, as far as the widest reaches.
    stain = 3
    r = l
    b = t
    flow = node.flow ?? refresh node
    if flow.count
      snug = flow.fits rect.w
      flow.wrap rect.w, flow.mode unless snug
      r = l + (if snug then flow.wide else flow.reach)
      b = t + (if snug then 1 else flow.rows)
  else
    s = node.styles
    damage.box l + dx, t + dy, r + dx, b + dy if stain is 2 and (s.borderStyle? or s.backgroundColor?)
    ox = if s.contentOffsetX then Math.trunc s.contentOffsetX else 0
    oy = if s.contentOffsetY then Math.trunc s.contentOffsetY else 0
    clipX = (s.overflowX ?? s.overflow) is 'hidden'
    clipY = (s.overflowY ?? s.overflow) is 'hidden'
    for kid, n in kids(node)
      survey kid, dx - ox, dy - oy, damage if kid.stain
      unless clipX
        l = kid.bl - ox if kid.bl - ox < l
        r = kid.br - ox if kid.br - ox > r
      unless clipY
        t = kid.bt - oy if kid.bt - oy < t
        b = kid.bb - oy if kid.bb - oy > b
  node.bl = l
  node.bt = t
  node.br = r
  node.bb = b
  damage.box l + dx, t + dy, r + dx, b + dy if stain is 3
  # Last, so a survey that fails leaves every node above it to be
  # surveyed again.
  node.stain = 0

# ── Tree → grid ───────────────────────────────────────────────────────────────

# A border, edge by edge (Ink's `renderBorder`): a corner belongs to the
# top or bottom edge and shows only when its side edge does; a side runs
# between the top and bottom edges that show. Each edge takes its own
# color, background and dimming, else the border's. A frame wholly
# outside the clip, or too small to hold its edges, draws nothing.
frame! =! (grid, s, x, y, w, h) ->
  cells = glyphsOf s.borderStyle
  top = if s.borderTop is false then 0 else 1
  bottom = if s.borderBottom is false then 0 else 1
  left = if s.borderLeft is false then 0 else 1
  right = if s.borderRight is false then 0 else 1
  return if w < left + right or h < top + bottom
  return if y + h - grid.top <= grid.over or y - grid.top >= grid.under or x + w <= grid.left or x >= grid.right
  plain = intern s.borderColor ?? null, s.borderBackgroundColor ?? null, (if s.borderDimColor then DIM else 0)
  if top
    id = if s.borderTopColor? or s.borderTopBackgroundColor? or s.borderTopDimColor? then intern(s.borderTopColor ?? s.borderColor ?? null, s.borderTopBackgroundColor ?? s.borderBackgroundColor ?? null, (if s.borderTopDimColor ?? s.borderDimColor then DIM else 0)) else plain
    grid.put x, y, cells[TL], id if left
    grid.run x + left, y, cells[T], w - left - right, id
    grid.put x + w - 1, y, cells[TR], id if right
  if bottom
    id = if s.borderBottomColor? or s.borderBottomBackgroundColor? or s.borderBottomDimColor? then intern(s.borderBottomColor ?? s.borderColor ?? null, s.borderBottomBackgroundColor ?? s.borderBackgroundColor ?? null, (if s.borderBottomDimColor ?? s.borderDimColor then DIM else 0)) else plain
    grid.put x, y + h - 1, cells[BL], id if left
    grid.run x + left, y + h - 1, cells[B], w - left - right, id
    grid.put x + w - 1, y + h - 1, cells[BR], id if right
  if left
    id = if s.borderLeftColor? or s.borderLeftBackgroundColor? or s.borderLeftDimColor? then intern(s.borderLeftColor ?? s.borderColor ?? null, s.borderLeftBackgroundColor ?? s.borderBackgroundColor ?? null, (if s.borderLeftDimColor ?? s.borderDimColor then DIM else 0)) else plain
    for row in [y + top...y + h - bottom]
      grid.put x, row, cells[L], id
  if right
    id = if s.borderRightColor? or s.borderRightBackgroundColor? or s.borderRightDimColor? then intern(s.borderRightColor ?? s.borderColor ?? null, s.borderRightBackgroundColor ?? s.borderBackgroundColor ?? null, (if s.borderRightDimColor ?? s.borderDimColor then DIM else 0)) else plain
    for row in [y + top...y + h - bottom]
      grid.put x + w - 1, row, cells[R], id

# The style of each text node under a leaf, in tree order — the order a
# flow numbers its runs in. Nested spans restyle their own words.
shades =! []

shade! =! (node, id) ->
  kid = node.firstChild
  while kid
    if kid.nodeType is 3
      shades.push id
    else if kid.nodeType is 1
      shade kid, styleOf(kid, id, true)
    kid = kid.nextSibling

# Units [from, to) of a leaf's flow at (x, y), each run in its style.
# Answers the column after the last.
stretch =! (grid, flow, x, y, from, to) ->
  return x if from >= to
  ends = flow.ends
  run = 0
  if ends
    run += 1 while ends[run] <= from
  while from < to
    stop = if ends and ends[run] < to then ends[run] else to
    x = if flow.ascii then grid.ascii(x, y, flow.text, from, stop, shades[run]) else grid.units(x, y, flow, from, stop, shades[run])
    from = stop
    run += 1
  x

# The style of the run that holds `unit`.
shadeAt =! (flow, unit) ->
  run = 0
  if flow.ends
    run += 1 while flow.ends[run] <= unit
  shades[run]

# A text leaf: its flow's rows at the width layout gave it. A line that
# fits is drawn as it is, and no table is asked for. A cut line's '…'
# takes the style of the words it stands beside — the last kept before
# it, the first kept after it — and the leaf's own in the middle.
words! =! (grid, node, inherited, x, y) ->
  flow = node.flow ?? refresh node
  return if flow.count is 0
  flow.renew()
  shades.length = 0
  own = inherited
  if node.nodeType is 3
    shades.push inherited
  else
    own = styleOf node, inherited, true
    shade node, own
  wide = node.rect.w
  if flow.fits wide
    stretch grid, flow, x, y, 0, flow.count
    return
  flow.wrap wide, flow.mode
  table = flow.table
  for n in [0...flow.rows]
    at = n * ROW
    col = stretch grid, flow, x, y + n, table[at + A0], table[at + A1]
    continue unless table[at + DOTS]
    id = own
    if table[at + B1] is table[at + B0]
      id = shadeAt flow, table[at + A1] - 1 if table[at + A1] > table[at + A0]
    else if table[at + A1] is table[at + A0]
      id = shadeAt flow, table[at + B0]
    grid.put col, y + n, DOT, id
    stretch grid, flow, col + 1, y + n, table[at + B0], table[at + B1]

# One node and everything under it. (dx, dy) is how far content offsets
# above have shifted it from where layout put it, and the four integers
# are the clip: the padding boxes of the `overflow: 'hidden'` ancestors,
# intersected. A box's own background and border answer to the clip it
# was handed, and only its children to the one it makes.
draw! =! (grid, node, inherited, dx, dy, left, top, right, bottom) ->
  rect = node.rect
  x = rect.x + dx
  y = rect.y + dy
  if node.nodeType is 3 or node.tagName is 'span'
    grid.clip left, top, right, bottom
    words grid, node, inherited, x, y
    return
  s = node.styles
  id = styleOf node, inherited
  edged = s.borderStyle?
  if edged or s.backgroundColor?
    grid.clip left, top, right, bottom
    if s.backgroundColor?
      # The background fills inside the border (Ink's `renderBackground`).
      l = if edged and s.borderLeft isnt false then 1 else 0
      t = if edged and s.borderTop isnt false then 1 else 0
      r = if edged and s.borderRight isnt false then 1 else 0
      b = if edged and s.borderBottom isnt false then 1 else 0
      grid.fill x + l, y + t, rect.w - l - r, rect.h - t - b, intern(null, s.backgroundColor, 0)
    frame grid, s, x, y, rect.w, rect.h if edged
  if s.overflow? or s.overflowX? or s.overflowY?
    if (s.overflowX ?? s.overflow) is 'hidden'
      left = Math.max left, x + (if edged and s.borderLeft isnt false then 1 else 0)
      right = Math.min right, x + rect.w - (if edged and s.borderRight isnt false then 1 else 0)
    if (s.overflowY ?? s.overflow) is 'hidden'
      top = Math.max top, y + (if edged and s.borderTop isnt false then 1 else 0)
      bottom = Math.min bottom, y + rect.h - (if edged and s.borderBottom isnt false then 1 else 0)
    return if left >= right or top >= bottom
  dx -= Math.trunc s.contentOffsetX if s.contentOffsetX
  dy -= Math.trunc s.contentOffsetY if s.contentOffsetY
  for kid, n in kids(node)
    # A child whose bounds lie outside the clip or hold no owed cell is
    # passed over with everything under it.
    if patch
      continue if kid.br + dx <= left or kid.bl + dx >= right or kid.bb + dy <= top or kid.bt + dy >= bottom
      continue unless patch.whole or patch.hits kid.bl + dx, kid.bt + dy, kid.br + dx, kid.bb + dy
    own = id
    # A `display: contents` node draws no box, but what it says about
    # color and weight still reaches the children it lends its parent.
    own = lent kid.parentNode, node, id if kid.parentNode isnt node
    draw grid, kid, own, dx, dy, left, top, right, bottom

# The style `id` as the `contents` nodes between `node` and `owner`
# restyle it, outermost first.
lent =! (node, owner, id) ->
  return id if node is owner or not node
  styleOf node, lent(node.parentNode, owner, id)

patch = null   # the damage the paint under way is held to
PASSES =! 4    # the most paints one frame may take

# Paint the tree onto a grid. With no `damage` that is every node, onto
# a grid the caller cleared. With it, `grid` is a scratch for the frame
# that follows `front`, the grid on the terminal: what changed is
# surveyed, the owed cells are blanked, and the walk passes over every
# subtree that holds none of them. Everything is owed when `front` is
# not a frame of this shape and these tables.
export paint! =! (grid, node, damage = null, front = null) ->
  patch = damage
  early = full 1.5
  unless damage
    sweep grid if early
    draw grid, node, 0, 0, 0, 0, -FAR, grid.cols, FAR
    grid.clip 0, -FAR, grid.cols, FAR
    return
  same = front and front.cols is grid.cols and front.rows is grid.rows and front.top is grid.top and front.epoch is epoch
  damage.shape grid, true if damage.whole or early or not same
  damage.fit grid.rows
  survey node, 0, 0, damage if node.stain
  # Past half the grid a whole frame is the cheaper one: no subtree is
  # tested against the spans, and the grids swap where cells are copied.
  damage.shape grid, true if damage.count() * 2 > grid.cols * grid.rows
  grid.lo = damage.lo
  grid.hi = damage.hi
  if damage.whole
    grid.clear()
    sweep grid if early
  # A span that would cut a wide glyph takes its run in, twice, and then
  # the whole row: the fourth paint finds nothing to cut.
  damage.passes = 0
  loop
    grid.cut = false
    grid.late = damage.passes > 1
    grid.wipe() unless damage.whole
    draw grid, node, 0, 0, 0, 0, grid.top, grid.cols, grid.top + grid.rows
    damage.passes += 1
    break unless grid.cut
    throw Error.new "rip/tui: a paint did not settle in #{PASSES} passes — a wide glyph is cut by a row that is owed whole" if damage.passes >= PASSES
  grid.clip 0, -FAR, grid.cols, FAR

# ── Sweep ─────────────────────────────────────────────────────────────────────

# The style table and the cluster table grow with every new color and
# every new cluster, and a cell has sixteen bits for a style. Between
# frames — never inside one, where ids are in hand — a table that has
# grown past its mark is swept: every style and cluster that no cell of
# `grid` holds is let go, and the cells that stay are renumbered. The
# sweep follows a `diff`, whose grid is the one the terminal shows, so
# the next diff stands; frames that are never diffed are swept as a
# `paint` starts, once a table is half as far past its mark again. Any
# other grid is left with ids of tables that are gone, which its epoch
# says: `diff` draws from nothing over one, and `clear` makes it whole.
# A flow renews its own cells (text.rip).
full =! (slack) -> records.length > SWEEP * slack or crowded slack

sweep! =! (grid) ->
  grid.epoch = epoch += 1
  moved = Uint16Array.new records.length
  kept = [records[0]]
  style = grid.style
  for id, at in style when id
    unless moved[id]
      moved[id] = kept.length
      kept.push records[id]
    style[at] = moved[id]
  records.length = 0
  ids.clear()
  blends.clear()
  for record, n in kept
    records.push record
    shelf(record.fg, record.bg).set record.key, n
  evict grid.ch
  frames.clear()

# ── Grid → bytes ──────────────────────────────────────────────────────────────

# Whether cell `i` of `back` already shows on a screen drawn from
# `front`. A row the screen has never drawn is blank.
shows =! (front, back, drawn, row, i) ->
  if row < drawn
    back.ch[i] is front.ch[i] and back.style[i] is front.style[i] and back.wide[i] is front.wide[i]
  else
    back.ch[i] is SPACE and back.style[i] is 0

# The bytes that turn the screen showing `front` into `back`, with the
# cursor starting and ending at the frame's top-left. Every move is
# relative, so the frame can sit anywhere in the scrollback; a line feed
# is the move down, since it alone makes a row that does not exist yet.
# `front` is null before the first frame, and a frame of another width
# or of another epoch is drawn from nothing. Only the columns `back` was
# painted in are read, and under a `damage` that is not whole every cell
# that differs is copied into `front`, which is then the frame on the
# terminal and the grid a sweep renumbers.
#
# A line feed at the bottom of the screen scrolls, and a terminal with
# background color erase fills the row it makes with the background then
# in force — a stripe no later frame repaints, since a row never drawn
# counts as blank. So no background is held across a line feed.
#
# A terminal may not agree how wide a cluster of several code points is
# (a joined emoji, a flag, a base with its marks), and would put all that
# follows on its row a cell off. The cell after one is therefore reached
# by an absolute column move, as is the cell after a code point this
# engine's Unicode leaves unassigned — both are cluster cells (text.rip).
# Any other code point, wide or not, is left to the width every terminal
# gives it.
#
# A hyperlink is open only while the cells it covers are written: it is
# closed before every cursor move and at the end of every run, so no
# move and no write ever happens inside one.
export diff =! (front, back, damage = null) ->
  reuse = front? and front.cols is back.cols and front.epoch is back.epoch
  keep = reuse and damage? and not damage.whole
  out = if reuse then '' else "\x1b[J"
  drawn = if reuse then front.drawn else 0
  at = 0
  held = 0
  url = null      # the link of the style held, and the link open on the terminal
  linked = null
  for row in [0...back.rows]
    col = back.lo[row]
    end = back.hi[row]
    while col < end
      if shows front, back, drawn, row, row * back.cols + col
        col += 1
        continue
      if row > at
        down = row - at
        if down > 4 and row < drawn
          out += "\x1b[#{down}B"
        else
          if held and records[held].bg?
            out += "\x1b[0m"
            held = 0
            url = null
          out += '\n'.repeat down
      else if row < at
        out += "\x1b[#{at - row}A"
      at = row
      out += "\x1b[#{col + 1}G"
      loose = false
      while col < end
        i = row * back.cols + col
        # A continuation cell goes with its glyph; it never ends a run.
        break if back.wide[i] isnt 0 and shows front, back, drawn, row, i
        if back.wide[i] isnt 0
          cell = back.ch[i]
          if loose
            out += hop linked = null if linked
            out += "\x1b[#{col + 1}G"
          if back.style[i] isnt held
            out += shift held, back.style[i]
            held = back.style[i]
            url = records[held].link
          out += hop linked = url if url isnt linked
          out += if cell < CLUSTER then String.fromCodePoint(cell) else glyph cell
          loose = cell >= CLUSTER
        if keep
          front.ch[i] = back.ch[i]
          front.style[i] = back.style[i]
          front.wide[i] = back.wide[i]
        col += 1
      out += hop linked = null if linked
  out += "\x1b[0m" if records[held].sgr
  if drawn > back.rows
    out += '\n'.repeat(back.rows - at) if back.rows > at
    out += "\x1b[#{at - back.rows}A" if at > back.rows
    at = back.rows
    out += "\r\x1b[J"
  out += "\x1b[#{at}A" if at > 0
  out += '\r' if out
  shown = if keep then front else back
  shown.drawn = back.rows
  sweep shown if full 1
  out
