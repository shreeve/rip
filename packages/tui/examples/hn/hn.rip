# A Hacker News reader on the terminal, a port of hntui (see NOTICE):
# the six feeds, saved stories and history, threads with their links
# followed in-app, two themes with a wipe between them, the mouse.
# `?` lists the keys; q quits.
#
#   rip examples/hn/hn.rip              # against the live API
#   HN_DEMO=1 rip examples/hn/hn.rip    # offline, on the deterministic fake
#
# HN_CONFIG_DIR is where saved.json and history.json go, else
# ~/.config/rip-hn.

import { run } from 'rip/tui'
import { Api, live, timed, retrying } from './api.rip'
import { Fake } from './fake.rip'
import { Store, configDir } from './store.rip'
import { openUrl } from './open.rip'
import { App } from './app.rip'

export { App }

main =! ->
  demo =! process.env.HN_DEMO is '1'
  api =! if demo then Api.new({ getJson: retrying timed(Fake.demo().transport().getJson) }) else Api.new(live())
  run App, altScreen: true, mouse: 'all', props: { api, store: Store.new(configDir()), open: openUrl, now: Date.now, demo }

main() if import.meta.main
