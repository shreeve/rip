# The three overlays, each the whole screen laid over the view: the
# links of a comment, the keyboard help, and the context menu of a
# story. A press on the scrim closes the overlay; a press inside the
# panel stops there. The app renders them as the last children of its
# root, in hntui's order — links, help, menu — so the later is on top.

import { screen, Box, Text } from 'rip/tui'
import { DARK, SCRIM } from './theme.rip'

export DOUBLE =! 400   # milliseconds within which a second press is a double

# The links of a comment: a numbered row per link with its url under
# it, the cursor's row lit. A press on the cursor's row, or a second
# press on one within DOUBLE ms, opens it; any other press selects.
export LinksPopup = component
  @t := DARK
  @links := []
  @cursor := 0
  @now := null
  @onSelect := null
  @onActivate := null
  @onClose := null
  last = 0

  pressed: (n) ->
    at = @now()
    if n is @cursor or at - last < DOUBLE then @onActivate? n else @onSelect? n
    last = at

  render
    Box position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', alignItems: 'center', justifyContent: 'center', backgroundColor: SCRIM, @mousedown: (-> @onClose?())
      Box flexDirection: 'column', width: '70%', backgroundColor: @t.body, borderStyle: 'round', borderColor: @t.accent, borderBackgroundColor: @t.body, borderTitle: " Links (#{@links.length}) ", paddingY: 1, paddingX: 2, @mousedown: ((event) -> event.stopPropagation())
        for link, n in @links
          Box key: "#{n}-#{link.url}", flexDirection: 'column', marginTop: (if n is 0 then 0 else 1), paddingX: 1, backgroundColor: (if n is @cursor then @t.rowHighlight else undefined), @mousedown: (-> @pressed n)
            Text
              Text color: (if n is @cursor then @t.accent else @t.textDim), "#{if n is @cursor then '▶ ' else '  '}"
              Text color: @t.text, bold: n is @cursor, "#{n + 1}. #{link.text}"
            Text color: @t.link, "    #{link.url}"
        Box marginTop: 1
          Text color: @t.statusHint, "j/k move · ⏎ open · o browser · esc close"

NAVIGATION =! [
  ['j k  ↑ ↓', 'move down / up']
  ['g g / G', 'jump to top / bottom']
  ['Ctrl+d / Ctrl+u', 'half-page down / up']
]

LIST_GROUPS =! [
  { title: 'Navigation', keys: [...NAVIGATION, ['h / l', 'previous / next category'], ['Tab / ⇧Tab', 'cycle categories'], ['1 – 6', 'jump to category']] }
  { title: 'Actions', keys: [['c / ⏎', 'open comments'], ['o', 'open post link in browser'], ['y', 'open HN page in browser'], ['s', 'save / unsave'], ['r', 'refresh feed'], ['x', 'clear history (History view)']] }
]

DETAIL_GROUPS =! [
  { title: 'Navigation', keys: NAVIGATION }
  { title: 'Actions', keys: [['space', 'collapse / expand'], ['⏎', 'comment links (HN posts open in-app)'], ['o', 'open post link in browser'], ['y', 'open HN page in browser'], ['s', 'save / unsave'], ['h / esc', 'go back']] }
]

GENERAL =! { title: 'General', keys: [['S', 'saved posts'], ['H', 'view history'], ['t', 'toggle theme'], ['?', 'toggle this help'], ['q', 'quit']] }

# The keys of the view, in groups, each key padded to the longest.
export HelpOverlay = component
  @t := DARK
  @view := 'list'
  @onClose := null
  groups ~= [...(if @view is 'list' then LIST_GROUPS else DETAIL_GROUPS), GENERAL]
  width ~= Math.max ...groups.map((group) -> Math.max ...group.keys.map((pair) -> pair[0].length))
  render
    Box position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', alignItems: 'center', justifyContent: 'center', backgroundColor: SCRIM, @mousedown: (-> @onClose?())
      Box flexDirection: 'column', width: '60%', backgroundColor: @t.body, borderStyle: 'round', borderColor: @t.accent, borderBackgroundColor: @t.body, borderTitle: ' Keyboard shortcuts ', paddingY: 1, paddingX: 2, @mousedown: ((event) -> event.stopPropagation())
        for group, g in groups
          Box key: group.title, flexDirection: 'column', marginTop: (if g is 0 then 0 else 1)
            Text color: @t.accent, bold: true, "#{group.title}"
            for pair, k in group.keys
              Text key: k
                Text color: @t.text, "  #{pair[0].padEnd width}"
                Text color: @t.textMuted, "   #{pair[1]}"
        Box marginTop: 1
          Text color: @t.statusHint, "esc / ? close"

# The context menu of a story, at the press, kept on the screen and off
# its last row. An item is taken by a press; the pointer over one
# selects it.
export ContextMenu = component
  @t := DARK
  @x := 0
  @y := 0
  @items := []
  @cursor := 0
  @onSelect := null
  @onActivate := null
  @onClose := null
  wide ~= Math.min 40, 4 + Math.max(0, ...@items.map((item) -> item.label.length))
  tall ~= @items.length + 2
  left ~= Math.min Math.max(0, @x), screen.cols - wide
  top ~= Math.min Math.max(0, @y), screen.rows - tall - 1
  render
    Box position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', @mousedown: (-> @onClose?())
      Box position: 'absolute', top: top, left: left, width: wide, flexDirection: 'column', backgroundColor: @t.menuBg, borderStyle: 'single', borderColor: @t.textMuted, borderBackgroundColor: @t.menuBg, @mousedown: ((event) -> event.stopPropagation())
        for item, n in @items
          Box key: n, paddingX: 1, backgroundColor: (if n is @cursor and not item.disabled then @t.textMuted else undefined), @mousedown: (-> @onActivate? n unless item.disabled), @mouseenter: (-> @onSelect? n unless item.disabled)
            Text color: (if item.disabled then @t.textDim else if n is @cursor then @t.menuHoverFg else @t.text), "#{item.label}"
