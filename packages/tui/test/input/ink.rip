  ['splits batched backspace characters into individual events', BS + BS + BS, [ink('backspace', '', BS), ink('backspace', '', BS), ink('backspace', '', BS)]]
  ['splits mixed 0x7F and 0x08 backspace characters', DEL + BS + DEL, [ink('backspace', '', DEL), ink('backspace', '', BS), ink('backspace', '', DEL)]]
  ['splits mixed printable text and 0x7F backspace characters', "abc#{DEL}#{DEL}#{DEL}", [...typed('abc'), ink('backspace', '', DEL), ink('backspace', '', DEL), ink('backspace', '', DEL)]]
  ['single 0x7F backspace character is preserved as individual event', DEL, [ink('backspace')]]
  ['single backspace character is preserved as individual event', BS, [ink('backspace')]]
  ['splits trailing 0x7F backspace from text', "abc#{DEL}", [...typed('abc'), ink('backspace', '', DEL)]]
  ['splits 0x7F backspace characters before escape sequences', "#{DEL}#{DEL}#{CSI}A", [ink('backspace', '', DEL), ink('backspace', '', DEL), up()]]
  ['splits 0x7F backspace characters after escape sequences', "#{CSI}A#{DEL}#{DEL}", [up(), ink('backspace', '', DEL), ink('backspace', '', DEL)]]
  ['splits 0x7F backspace characters between escape sequences', "#{CSI}A#{DEL}#{CSI}B", [up(), ink('backspace', '', DEL), down()]]
  ['splits backspace characters around escape sequences', "#{BS}#{CSI}A#{BS}", [ink('backspace', '', BS), up(), ink('backspace', '', BS)]]
  ['splits interleaved text and 0x7F backspace characters', "ab#{DEL}cd", [...typed('ab'), ink('backspace', '', DEL), ...typed('cd')]]
