  ['emits multiple paste events in one chunk', "#{START}first#{END}mid#{START}second#{END}", [paste('first'), ...typed('mid'), paste('second')]]
  ['holds incomplete bracketed paste as pending', timed(({ feed, clock }) ->
    eq feed("#{START}hello"), []
    eq clock.waiting, 0
    eq feed(" world#{END}"), [paste('hello world')]
  ), [paste('hello world')]]
  ['assembles bracketed paste from chunk-by-chunk delivery', [START, 'hello', END], [paste('hello')]]
  ['emits empty paste for adjacent paste markers', START + END, [paste('')]]
  ['handles pasteStart split before the tilde (\\u001B[200 without ~)', ["#{CSI}200", "~hello#{END}"], [paste('hello')]]
  ['handles pasteStart split before the tilde (\\u001B[200 without ~)', timed(({ feed, clock }) ->
    eq feed("#{CSI}200"), []
    eq clock.waiting, 1
    clock.tick 50
    feed "~hello#{END}"
  ), typed('~hello'), [paste('hello')], 'one rule for every partial sequence: a paste marker cut before its `~` and left past the timeout is discarded like any other, where Ink arms no timer for this one prefix and waits without end']
  ['hasPendingEscape returns true for length-3 pasteStart prefix (\\u001B[2)', timed(({ feed, clock }) ->
    eq feed("#{CSI}2"), []
    eq clock.waiting, 1
  ), []]
