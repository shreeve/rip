  ['emits paste event for multiline bracketed paste', "#{START}line1\nline2#{END}", [paste('line1\nline2')]]
  ['paste content with escape sequences is delivered verbatim', "#{START}hello#{CSI}Aworld#{END}", [paste("hello#{CSI}Aworld")]]
