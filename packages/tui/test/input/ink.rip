  ), [up('c', "#{CSI}1;5A")]]
  ['holds incomplete legacy ESC[[... sequence until final byte arrives', ["#{CSI}[", '5', '~'], typed('5~'), [ink('pageup', '', "#{CSI}[5~")], CYGWIN]
  ['holds incomplete SS3 sequence until final byte arrives', [SS3, 'A'], [up('', "#{SS3}A")]]
  ['holds incomplete double-escape CSI sequence until final byte arrives', ["#{ESC}#{CSI}", 'A'], [ESCAPE, up()], [up('m', "#{ESC}#{CSI}A")], DOUBLE]
  ['keeps pending plain escape and can flush it', timed(({ feed, clock, late }) ->
