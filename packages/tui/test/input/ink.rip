]

# ── parse-keypress.ts ─────────────────────────────────────────────────────────

console.log "\nInk: parse-keypress"

# Ink's loop over eight modifier bits, four event-type spellings, and
# three encodings of a key.
agreement =! ->
  title = 'kitty modifiers and event types agree across key encodings'
  rows = []
  for flag, bit in ['s', 'm', 'c', 'S', 'h', 'M', 'l', 'n']
    for [suffix, kind] in [['', ''], [':1', ''], [':2', 'r'], [':3', null]]
      for [head, tail, name] in [['97', 'u', 'a'], ['1', 'A', 'up'], ['3', '~', 'delete']]
        given = "#{CSI}#{head};#{2 ** bit + 1}#{suffix}#{tail}"
        rows.push (if kind? then [title, given, [ink(name, flag + kind)]] else [title, given, [], [ink(name, flag)], RELEASE])
  rows

table 'parse-keypress', [
  ['parsing a single-byte Meta key does not mutate the input', timed(({ feed }) ->
    given = Uint8Array.new [0xe1]
    feed given
    eq Array.from(given), [0xe1]
  ), [], [ink('a', 'm', "#{ESC}a")], 'eight-bit Meta (a byte over 127 standing for ESC and the byte less 128) is a dropped terminal form: input is UTF-8, where 0xE1 opens a three-byte character and is held for the rest of it']
  ['byte parsing preserves ASCII and multibyte UTF-8 input', bytes('a'), typed('a')]
  ['byte parsing preserves ASCII and multibyte UTF-8 input', bytes('hello'), typed('hello')]
  ['byte parsing preserves ASCII and multibyte UTF-8 input', bytes('é'), typed('é')]
  ['byte parsing preserves ASCII and multibyte UTF-8 input', bytes('😀'), typed('😀')]
  ['kitty functional keys preserve modifiers without an explicit event type', "#{CSI}1;249A", [ink('up', 'ShMln')]]
  ['kitty functional keys preserve modifiers without an explicit event type', "#{CSI}3;249~", [ink('delete', 'ShMln')]]
  ['kitty functional keys preserve modifiers without an explicit event type', "#{CSI}13;249~", [ink('f3', 'ShMln')]]
  ['kitty functional keys preserve modifiers without an explicit event type', "#{CSI}1;249P", [ink('f1', 'ShMln')]]
  ['kitty functional keys preserve modifiers without an explicit event type', "#{CSI}1;9A", [ink('up', 'S')]]
  ...agreement()
  ['kitty keypad Begin supports both functional encodings', "#{CSI}1E", [ink('clear')]]
  ['kitty keypad Begin supports both functional encodings', "#{CSI}57427~", [ink('clear')]]
  ['kitty keypad Begin supports both functional encodings', "#{CSI}1;1:2E", [ink('clear', 'r')]]
  ['kitty keypad Begin supports both functional encodings', "#{CSI}57427;1:2~", [ink('clear', 'r')]]
  ['kitty text-only events have no key identity', "#{CSI}0;;229:128169u", [key('å'), key('💩')]]
  ...(['kitty unknown functional and control codes do not invent printable characters', "#{CSI}#{code}u", []] for code in [0, 1, 3, 31, 128, 159, 57344, 63743])
  ['kitty unknown functional and control codes do not invent printable characters', "#{CSI}63744u", [key(String.fromCodePoint 63744)]]
  ['legacy Ctrl+Space preserves the space key and modifiers', '\x00', [ink('space', 'c')]]
  ['legacy Ctrl+Space preserves the space key and modifiers', "#{ESC}\x00", [ink('space', 'cm')]]
  ...(['kitty keypad navigation keys use standard key names', "#{CSI}#{57417 + n};5:2u", [ink(name, 'cr')]] for name, n in ['left', 'right', 'up', 'down', 'pageup', 'pagedown', 'home', 'end', 'insert', 'delete'])
  ...(['legacy Ctrl+punctuation shortcuts preserve the key and modifiers', String.fromCharCode(0x1c + n), [ink(name, 'c')]] for name, n in ['\\', ']', '^', '_'])
  ...(['legacy Ctrl+punctuation shortcuts preserve the key and modifiers', ESC + String.fromCharCode(0x1c + n), [ink(name, 'cm')]] for name, n in ['\\', ']', '^', '_'])
  ['kitty alternate key codes preserve the primary key event', "#{CSI}97:65;6:2;65u", [ink('a', 'csr')]]
  ['kitty alternate key codes preserve the primary key event', "#{CSI}97:65:113;6:2;65u", [ink('a', 'csr')]]
  ['kitty alternate key codes preserve the primary key event', "#{CSI}97::113;6:2;65u", [ink('a', 'csr')]]
  ['kitty alternate key codes preserve the primary key event', "#{CSI}1092::97;5u", [ink('ф', 'c')]]
  ['kitty keypad associated text is printable input', "#{CSI}57399;129;48u", [ink('0', 'n')]]
  ['kitty keypad associated text is printable input', "#{CSI}57413;1;43u", [ink('+')]]
  ['kitty keypad Enter produces a return key and carriage return text', "#{CSI}57414u", [ink('return')]]
  ['kitty keypad Enter produces a return key and carriage return text', "#{CSI}57414;2:2u", [ink('return', 'sr')]]
  ['application keypad Enter maps to Return with carriage return sequence', "#{SS3}M", [ink('return')]]
  ['application keypad Enter maps to Return with carriage return sequence', "#{ESC}#{SS3}M", [ESCAPE, ink('return', '', "#{SS3}M")], [ink('return', 'm')], DOUBLE]
  ['Meta+Tab preserves the tab key and Meta modifier', "#{ESC}\t", [ink('tab', 'm')]]
  ...(['Ctrl+Meta letters preserve both modifiers and the letter name', ESC + control, [ink(name, 'cm')]] for [control, name] in [['\x02', 'b'], ['\x06', 'f'], ['\x18', 'x']])
  ['kitty associated text accepts an omitted modifier value', "#{CSI}0;;229u", [key('å')]]
  ...(['Meta modifier is recognized for punctuation and Unicode characters', ESC + glyph, [ink(glyph, 'm')]] for glyph in ['.', ',', '/', '-', 'é', '😀'])
  ['Ctrl+F1 resolves to name "f1"', "#{CSI}1;5P", [ink('f1', 'c')]]
  ['Ctrl+F2 resolves to name "f2"', "#{CSI}1;5Q", [ink('f2', 'c')]]
  ['Ctrl+F3 resolves to name "f3"', "#{CSI}1;5R", [ink('f3', 'c')]]
  ['Ctrl+F4 resolves to name "f4"', "#{CSI}1;5S", [ink('f4', 'c')]]
  ['unmapped ctrl sequence returns empty name', "#{CSI}1;5I", []]
  ['another unmapped ctrl sequence returns empty name', "#{CSI}1;5X", []]
  ['Shift+F1 resolves to name "f1" with shift', "#{CSI}1;2P", [ink('f1', 's')]]
]

