    feed 'x'
  ), typed('x'), [...typed('[['), ...typed('x')], CYGWIN]
  ['parses meta+SS3 sequence with double escape', "#{ESC}#{SS3}A", [ESCAPE, up('', "#{SS3}A")], [up('m', "#{ESC}#{SS3}A")], DOUBLE]
  ['holds incomplete double-escape SS3 sequence until final byte arrives', ["#{ESC}#{SS3}", 'A'], [ESCAPE, up('', "#{SS3}A")], [up('m', "#{ESC}#{SS3}A")], DOUBLE]
  ['emits double escape as single event for non-control character', "#{ESC}#{ESC}x", [ESCAPE, ink('x', 'm', "#{ESC}x")], [ink('escape', 'm', "#{ESC}#{ESC}"), ...typed('x')], DOUBLE]
  ['empty chunk produces no events', [''], []]
  ['empty chunk does not disturb pending state', [CSI, '', 'A'], [up()]]
  ['plain text followed by incomplete escape holds escape as pending', timed(({ feed, clock }) ->
