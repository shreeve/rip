  ['kitty protocol - tilde keys with modifiers', "#{CSI}3;2:1~", [ink('delete', 's')]]
  ['kitty protocol - invalid codepoint above U+10FFFF returns safe empty keypress', "#{CSI}1114112u", []]
  ['kitty protocol - surrogate codepoint returns safe empty keypress', "#{CSI}55296u", []]
  ['kitty protocol - invalid text codepoint replaced with fallback', kitty(97, 1, 1, [1114112]), [key('a')], [key('?')], 'a code point no string can hold is skipped, and the key falls back to the character of its own code; Ink types a question mark the user never pressed']
  ['kitty protocol - malformed modifier 0 does not set all flags', "#{CSI}97;0u", [ink('a')]]
  ['non-kitty sequences fall back to legacy parsing', "#{CSI}A", [ink('up')]]
  ['non-kitty sequences - ctrl+c', '\x03', [ink('c', 'c')]]
  ['kitty protocol - isPrintable is true for regular characters', kitty(97), [key('a')]]
  ['kitty protocol - isPrintable is true for digits', kitty(49), [key('1')]]
  ['kitty protocol - isPrintable is true for symbols', kitty(64), [key('@')]]
  ['kitty protocol - isPrintable is true for emoji', kitty(128512), [key('😀')]]
  ['kitty protocol - isPrintable is false for escape', kitty(27), [key('Escape')]]
  ['kitty protocol - isPrintable is true for return', kitty(13), [key('Enter')]]
  ['kitty protocol - isPrintable is false for tab', kitty(9), [key('Tab')]]
  ['kitty protocol - isPrintable is true for space', kitty(32), [key(' ')]]
  ['kitty protocol - isPrintable is false for backspace', kitty(127), [key('Backspace')]]
  ['kitty protocol - Ctrl letters preserve their input character', kitty(97, 5), [key('a', 'c')]]
  ['kitty protocol - isPrintable is false for special keys (arrows)', "#{CSI}1;1:1A", [key('ArrowUp')]]
  ['kitty protocol - capslock (57358) is non-printable', "#{CSI}57358u", [ink('capslock')]]
  ['kitty protocol - printscreen (57361) is non-printable', "#{CSI}57361u", [ink('printscreen')]]
  ['kitty protocol - f13 (57376) is non-printable', "#{CSI}57376u", [ink('f13')]]
  ['kitty protocol - media key (57428 mediaplay) is non-printable', "#{CSI}57428u", [ink('mediaplay')]]
  ['kitty protocol - modifier-only key (57441 leftshift) is non-printable', "#{CSI}57441;2u", [ink('leftshift', 's')]]
  ['kitty protocol - modifier-only key (57442 leftcontrol) is non-printable', "#{CSI}57442;5u", [ink('leftcontrol', 'c')]]
  ['kitty protocol - kp keys (57399 kp0) are non-printable', "#{CSI}57399u", [key('0')], [key('kp0')], 'a keypad digit types its digit, as DOM\'s `key` for Numpad0 is "0"; Ink gives it no text unless the terminal reports associated text, so the keypad types nothing when every key is reported as an escape code']
  ['kitty protocol - scrolllock (57359) is non-printable', "#{CSI}57359u", [ink('scrolllock')]]
  ['kitty protocol - numlock (57360) is non-printable', "#{CSI}57360u", [ink('numlock')]]
  ['kitty protocol - pause (57362) is non-printable', "#{CSI}57362u", [ink('pause')]]
  ['kitty protocol - volume keys are non-printable', "#{CSI}57438u", [ink('lowervolume')]]
  ['kitty protocol - volume keys are non-printable', "#{CSI}57439u", [ink('raisevolume')]]
  ['kitty protocol - volume keys are non-printable', "#{CSI}57440u", [ink('mutevolume')]]
  ['kitty protocol - auto detection handles synchronous query response', "#{CSI}?1u", [reply('keyboard', { flags: 1 })]]
  ['kitty protocol - auto detection handles Uint8Array query response', bytes("#{CSI}?1u"), [reply('keyboard', { flags: 1 })]]
  ['kitty protocol - auto detection preserves split UTF-8 input bytes', [Uint8Array.new([0xf0, 0x9f]), Uint8Array.new([0x92, 0xa9])], typed('💩')]
  ['kitty protocol - auto detection handles split responses with surrounding input', ["before#{CSI}?", '0uafter'], [...typed('before'), reply('keyboard', { flags: 0 }), ...typed('after')]]
  ['kitty protocol - auto detection timeout preserves query prefix without digits', timed(({ feed, clock }) ->
    feed "#{CSI}?"
    clock.tick 250
  ), [], typed('[?'), DISCARD]
  ['kitty protocol - auto detection does not treat query response without digits as a response', "#{CSI}?u", []]
  ['kitty protocol - auto detection does not treat invalid query-like sequence as a response', "#{CSI}?1x", []]
  ['kitty protocol - space key has text field set to space character', kitty(32), [key(' ')]]
  ['kitty protocol - return key has text field set to carriage return', kitty(13), [key('Enter')]]
]

# ── hooks-use-input.tsx ───────────────────────────────────────────────────────

console.log "\nInk: hooks-use-input"

pressed =! timed ({ feed, clock }) ->
  feed ESC
  clock.tick 50

table 'hooks-use-input', [
  ['useInput - handle legacy Ctrl+Space', '\x00', [ink('space', 'c')]]
  ['useInput - handle Ctrl+punctuation shortcut', '\x1f', [ink('_', 'c')]]
  ['useInput - handle lowercase character', 'q', [ink('q')]]
  ['useInput - handle uppercase character', 'Q', [ink('q', 's')]]
  ['useInput - \\r should not count as an uppercase character', '\r', [ink('return')]]
  ['useInput - pasted carriage return', '\rtest', [ink('return', '', '\r'), ...typed('test')], typed('\rtest'), PASTED]
  ['useInput - pasted tab', '\ttest', [ink('tab', '', '\t'), ...typed('test')], typed('\ttest'), PASTED]
  ['useInput - handle escape', pressed, [ESCAPE]]
  ['useInput - escape does not set meta', pressed, [ESCAPE]]
  ['useInput - handle ctrl', '\x06', [ink('f', 'c')]]
  ['useInput - handle meta', "#{ESC}m", [ink('m', 'm')]]
  ['useInput - handle ctrl + meta + letter', "#{ESC}\x02", [ink('b', 'cm')]]
  ['useInput - handle meta + backspace (0x7F)', ESC + DEL, [ink('backspace', 'm')]]
  ['useInput - flushes ESC[ prefix as literal input', timed(({ feed, clock }) ->
    feed CSI
    clock.tick 50
  ), [], [key('[', '', CSI)], DISCARD]
  ['useInput - handle meta + O with pending flush', timed(({ feed, clock }) ->
    feed SS3
    clock.tick 50
  ), [], [ink('o', 'sm', SS3)], DISCARD]
  ['useInput - handle tab', '\t', [ink('tab')]]
  ['useInput - handle meta + tab', "#{ESC}\t", [ink('tab', 'm')]]
  ['useInput - handle shift + tab', "#{CSI}Z", [ink('tab', 's')]]
  ['useInput - handle backspace', BS, [ink('backspace')]]
  ['useInput - handle delete', "#{CSI}3~", [ink('delete')]]
  ['useInput - handle remove (delete)', "#{CSI}3~", [ink('delete')]]
  ['useInput - handle option + return (macOS)', "#{ESC}\r", [ink('return', 'm')]]
  ['useInput - handle Ctrl+F1 without crashing', "#{CSI}1;5P", [ink('f1', 'c')]]
  ['useInput - handle unmapped ctrl escape sequence without crashing', "#{CSI}1;5Iq", typed('q')]
  ['useInput - drops unmapped control sequence: focus in', "#{CSI}Iq", [FOCUS, ...typed('q')]]
  ['useInput - drops unmapped control sequence: focus out', "#{CSI}Oq", [BLUR, ...typed('q')]]
  ['useInput - drops unmapped control sequence: cursor position report', "#{CSI}24;80Rq", [reply('cursor', { x: 79, y: 23 }), ...typed('q')]]
  ['useInput - drops unmapped control sequence: SGR mouse report', "#{CSI}<0;10;20Mq", [mouse('down', 0, 9, 19), ...typed('q')]]
  ['useInput - drops unmapped control sequence: primary device attributes', "#{CSI}?62;1;4cq", [reply('attributes', { params: [62, 1, 4] }), ...typed('q')]]
  ['useInput - drops unmapped control sequence: stray bracketed paste end', "#{END}q", typed('q')]
  ['useInput - drops unmapped control sequence: unmapped legacy CSI', "#{CSI}[Zq", typed('Zq'), typed('q'), CYGWIN]
  ['useInput - drops unmapped control sequence: unmapped modified SS3', "#{SS3}1;5Zq", [key('Tab', 'cs', "#{SS3}1;5Z"), ...typed('q')], typed('q'), 'one table of finals serves CSI and SS3, so SS3 Z is the Shift-Tab that CSI Z is; Ink keeps a table per introducer and has no SS3 Z, a sequence no terminal sends']
]

