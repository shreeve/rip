  ['treats invalid CSI continuation as escaped code point plus plain text', "#{CSI}\n", [key('j', 'c', '\n')], [key('[', '', CSI), ink('enter', '', '\n')], ABORTED]
  ['parses mixed text and many key events in one read', "start#{CSI}A mid #{SS3}H end#{CSI}[5~", [...typed('start'), up(), ...typed(' mid '), ink('home', '', "#{SS3}H"), ...typed(' end'), ...typed('5~')], [...typed('start'), up(), ...typed(' mid '), ink('home', '', "#{SS3}H"), ...typed(' end'), ink('pageup', '', "#{CSI}[5~")], CYGWIN]
