  ['does not consume a following escape as SS3 final byte', "#{SS3}#{CSI}A", [up()], [ink('o', 'sm', SS3), up()], ABORTED]
  ['parses meta+CSI sequence with double escape', "#{ESC}#{CSI}A", [ESCAPE, up()], [up('m', "#{ESC}#{CSI}A")], DOUBLE]
  ['parses escaped printable code points', "#{ESC}x#{ESC}1", [ink('x', 'm', "#{ESC}x"), ink('1', 'm', "#{ESC}1")]]
  ['parses escaped supplementary code points', "#{ESC}😀", [ink('😀', 'm')]]
  ['preserves legacy ESC[[... sequences in a mixed chunk', "#{CSI}[A#{CSI}[5~", typed('A5~'), [ink('f1', '', "#{CSI}[A"), ink('pageup', '', "#{CSI}[5~")], CYGWIN]
  ['preserves legacy ESC[[... sequences across chunks', ["#{CSI}[", "A#{CSI}[5~"], typed('A5~'), [ink('f1', '', "#{CSI}[A"), ink('pageup', '', "#{CSI}[5~")], CYGWIN]
  ['parses legacy and standard CSI sequences mixed together', "#{CSI}[A#{CSI}B#{CSI}[6~#{CSI}1;5D", [...typed('A'), down(), ...typed('6~'), ink('left', 'c', "#{CSI}1;5D")], [ink('f1', '', "#{CSI}[A"), down(), ink('pagedown', '', "#{CSI}[6~"), ink('left', 'c', "#{CSI}1;5D")], CYGWIN]
  ['holds incomplete CSI sequence until final byte arrives', timed(({ feed, clock }) ->
    eq feed(CSI), []
    eq clock.waiting, 1
