console.log "\nInk: input-parser"

table 'input-parser', [
  ['passes through plain text chunks', ['hello', ' ', 'world'], typed('hello world')]
  ['keeps plain text and control sequences separate', "a#{CSI}Ab", [...typed('a'), up(), ...typed('b')]]
  ['parses multiple standard CSI keys in one chunk', "#{CSI}A#{CSI}B#{CSI}C#{CSI}D", [up(), down(), ink('right', '', "#{CSI}C"), ink('left', '', "#{CSI}D")]]
  ['parses CSI sequences with parameters', "#{CSI}1;5A#{CSI}5~#{CSI}6~", [up('c', "#{CSI}1;5A"), ink('pageup', '', "#{CSI}5~"), ink('pagedown', '', "#{CSI}6~")]]
  ['keeps rxvt shifted editing keys separate from following text', "#{CSI}3$hello", typed('ello'), [ink('delete', 's', "#{CSI}3$"), ...typed('hello')], RXVT]
  ['keeps rxvt shifted editing keys separate from following text', "#{CSI}7$hello", typed('ello'), [ink('home', 's', "#{CSI}7$"), ...typed('hello')], RXVT]
  ['emits rxvt Shift+Delete as soon as its final byte arrives', ["#{CSI}3", '$', 'hello'], typed('ello'), [ink('delete', 's', "#{CSI}3$"), ...typed('hello')], RXVT]
  ['parses consecutive rxvt shifted keys including meta', "#{CSI}3$#{ESC}#{CSI}5$#{CSI}A", [ESCAPE, up()], [ink('delete', 's', "#{CSI}3$"), ink('pageup', 'sm', "#{ESC}#{CSI}5$"), up()], RXVT]
  ['preserves CSI intermediate bytes outside rxvt shifted keys', ["#{CSI}1;", '2$', 'yhello'], typed('hello')]
  ['parses kitty protocol sequence as one key event', "#{CSI}97;5u", [ink('a', 'c')]]
  ['parses SS3 sequences as one key event', "#{SS3}A#{SS3}B#{SS3}C#{SS3}D", [up('', "#{SS3}A"), down('', "#{SS3}B"), ink('right', '', "#{SS3}C"), ink('left', '', "#{SS3}D")]]
  ['preserves modified SS3 keys and following text', "#{SS3}2Phello", [ink('f1', 's', "#{SS3}2P"), ...typed('hello')]]
  ['preserves modified SS3 keys and following text', "#{SS3}1;5Ahello", [up('c', "#{SS3}1;5A"), ...typed('hello')]]
  ['preserves modified SS3 keys and following text', "#{ESC}#{SS3}5Dhello", [ESCAPE, ink('left', 'c', "#{SS3}5D"), ...typed('hello')], [ink('left', 'cm', "#{ESC}#{SS3}5D"), ...typed('hello')], DOUBLE]
  ['holds modified SS3 sequences until their final byte arrives', timed(({ feed, clock }) ->
