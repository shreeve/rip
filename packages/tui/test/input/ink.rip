# Ink's input tests, ported as tables: bytes in, events out, each row
# under the title of the Ink test it comes from. A row of three is held
# to Ink's answer under the mapping of harness.rip; a row of five is a
# stated difference — ours, Ink's, and the decision. SOURCE.md counts
# them and lists what is left out.

import { test, ok, eq } from 'rip/testing'
import { ESC, CSI, SS3, open, bytes, key, typed, paste, FOCUS, BLUR, mouse, reply, ink, holds, differs } from './harness.rip'

BEL =! '\x07'
DEL =! '\x7f'
BS  =! '\b'
START =! "#{CSI}200~"
END   =! "#{CSI}201~"
ESCAPE =! key 'Escape', '', ESC

# The decisions the stated differences rest on.
DISCARD =! 'a partial sequence that times out is discarded, never typed: on a slow link Ink types the tail of an arrow key as text'
ABORTED =! 'a sequence cut short by a byte that cannot continue it is discarded like one that times out, and that byte is read fresh'
RXVT    =! 'rxvt\'s `$` and `^` finals are a dropped terminal form: `$` is an intermediate byte (ECMA-48 5.4), so the sequence runs on to the next final byte and is a sequence this package has no key for'
CYGWIN  =! 'the Linux console and Cygwin `CSI [ A` function keys are a dropped terminal form: `[` is a final byte (ECMA-48 5.4), so `CSI [` is a whole sequence with no key, and what follows is typed'
DOUBLE  =! 'a doubled ESC as Meta is a dropped terminal form: the first ESC, followed by a byte that cannot continue it, is the Escape key, and the second starts the sequence it introduces'
RELEASE =! 'key releases are dropped: the package has @keydown and no @keyup, and asks no terminal for release reports'
PASTED  =! 'a carriage return or a tab outside a bracketed paste is the key wherever it arrives: the host turns bracketed paste on for the app\'s lifetime (PLAN §8), so pasted text is a paste event; Ink keeps the chunk whole for a terminal without it'

# One test per Ink title, its rows in order.
table =! (file, rows) ->
  groups = {}
  (groups[row[0]] ?= []).push row for row in rows
  for own title, group of groups
    test "#{file}: #{title}", ->
      for row in group
        if row.length is 3 then holds file, row[0], row[1], row[2] else differs file, row[0], row[1], row[2], row[3], row[4]
  return

# A case that moves the clock: what `steps` leaves in `all`.
timed =! (steps) ->
  ->
    session = open()
    steps session
    session.all

kitty =! (code, mods, kind, text) ->
  out = "#{CSI}#{code}"
  out += ";#{mods ?? 1}" if mods? or kind? or text?
  out += ":#{kind ?? 1}" if kind? or text?
  out += ";#{text.join ':'}" if text?
  out + 'u'

up    =! (flags = '', sequence = "#{CSI}A") -> ink 'up', flags, sequence
down  =! (flags = '', sequence = "#{CSI}B") -> ink 'down', flags, sequence

