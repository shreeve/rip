# ==[ stdin and the terminal ]==

console.log "\nstdin"

Echo =! component
  @keys := []
  @label := 'x'
  render
    Box focusable: true, autofocus: true, @keydown: ((event) => @keys.push event.key)
      Text "#{@label}"

test! "run sets raw mode, asks for bracketed paste and focus reports, and quit gives all of it back, in order", ->
  stdin = Stdin.new()
  term = Terminal.new()
  running = run Echo, stdin: stdin, stdout: term
  ok term.since(0).startsWith(ON), JSON.stringify term.since 0
  eq [stdin.calls, stdin.raw, stdin.listenerCount('data')], [['raw on', 'ref', 'resume'], true, 1]
  ok term.modes.has(2004) and term.modes.has(1004) and not term.shown
  stdin.key 'a'
  stdin.key Buffer.from "#{CSI}A"
  eq running.app.keys.value, ['a', 'ArrowUp']
  mark = term.sent.length
  quit()
  await running.done
  eq term.since(mark), "#{OFF}\n#{CSI}?25h"
  eq [stdin.calls, stdin.raw, stdin.listenerCount('data')], [['raw on', 'ref', 'resume', 'raw off', 'pause', 'unref'], false, 0]
  ok not term.modes.has(2004) and not term.modes.has(1004) and term.shown
  stdin.key 'b'

test! "Ctrl-C from stdin is the same way out", ->
