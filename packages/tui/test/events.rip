test! "a child that a key's change makes, and which fails to construct, fails the key with its own error, and leaves nothing half mounted", ->
  Grows = component
    @bad := false
    render
      Box focusable: true, autofocus: true, flexDirection: 'column', @keydown: ((event) => @bad = true if event.key is 'B')
        Text "x"
