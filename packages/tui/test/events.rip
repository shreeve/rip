        for n in [0, 1, 2, 3, 4, 5]
          Text key: n
            "row #{n}"
  mounted Tall, { rows: 4 }, (view) ->
    term = hiddenTerminal 40, 4
    eq shown(view, term), { x: 1, y: 3 }
    view.app.row.value = 2
