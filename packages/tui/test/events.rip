    render
      Box focusable: true, autofocus: true, cursor: { x: 4, y: 0 }
        Text "你好!"
  mounted Wide, {}, (view) ->
    term = hiddenTerminal()
    eq shown(view, term), { x: 4, y: 0 }
    eq term.lines[0][4], '!'

test "in a frame taller than the terminal the cursor is counted from the first row shown, and hidden on a row that is not", ->
