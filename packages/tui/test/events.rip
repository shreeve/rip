test! "a `quit`, a `close` by hand, and a second mount in one turn: the quit is the first app's alone, and both `done`s settle", ->
  first = mount Echo
  quit 'first'
  first.close()
  second = mount Echo
  sleep! 0
  eq second.frame(), 'x', 'the second app is still mounted'
  eq await first.done, undefined, 'an app closed by hand resolves with nothing'
  settled = 'pending'
  second.done.then -> settled = 'resolved'
  sleep! 0
  eq settled, 'pending'
  second.close()
  eq await second.done, undefined

