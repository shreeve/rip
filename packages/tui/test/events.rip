  ok term.since(0).endsWith("#{OFF}#{CSI}?25l\r\n#{CSI}?25h"), JSON.stringify term.since(0).slice -40
  eq [term.cursor, term.modes.has(2004), term.modes.has(1004)], [{ x: 0, y: 1 }, false, false], 'the cursor is on the line below the frame, shown, and the modes are withdrawn'
  eq [stdin.raw, stdin.listenerCount('data'), typeof document], [false, 0, 'undefined']

