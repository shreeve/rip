# ==============================================================================
# tui event tests — keys to listeners, focus, the cursor, and stdin
#
#   rip test/events.rip
#
# Ink's focus, input-hook, cursor and exit cases come first, ported
# through `mount` and `run` (test/events/ink.rip; test/events/SOURCE.md
# counts them). Then what this package pins for itself: the three phases
# of a dispatch in their exact order, propagation stopped at each,
# default actions and their prevention, focus in tree order and what
# clears it, the cursor's arithmetic, what `run` asks of stdin and the
# terminal and gives back on every way out, what a key costs, and a fuzz
# of focus under a changing tree.
# ==============================================================================

import { test, eq, ok, throws } from 'rip/testing'
import { run, quit, mount, screen, focus, Box, Text } from 'rip/tui'
import { Event } from '../document.rip'
import { Terminal, Stdin, find, idOf, tally } from './events/harness.rip'
import './events/ink.rip'

ESC =! '\x1b'
CSI =! '\x1b['

ON  =! "#{CSI}?25l#{CSI}?2004h#{CSI}?1004h"   # what `run` opens a terminal with
OFF =! "#{CSI}?1004l#{CSI}?2004l"             # and withdraws, before the cursor is shown

mounted =! (App, options, body) ->
  view = mount App, { cols: 40, ...options }
  try
    body view
  finally
    view.close()

# ==[ Ink's count ]==

console.log "\nInk's cases, counted"

test "the ported titles are the ones SOURCE.md counts", ->
  eq tally, {
    'focus':                      { held: 40, differs: 5 }
    'focus-order':                { held: 0, differs: 3 }
    'focus-empty-id-regression':  { held: 3, differs: 0 }
    'hooks-use-input':            { held: 27, differs: 6 }
    'hooks-use-input-kitty':      { held: 23, differs: 1 }
    'hooks-use-input-navigation': { held: 14, differs: 4 }
    'hooks-use-paste':            { held: 4, differs: 0 }
    'input-keypad-enter':         { held: 2, differs: 0 }
    'input-buffered-ctrl-c':      { held: 2, differs: 3 }
    'exit-keyboard':              { held: 2, differs: 5 }
    'rerender-input':             { held: 4, differs: 0 }
    'cursor':                     { held: 10, differs: 2 }
    'cursor-exit-position':       { held: 4, differs: 0 }
  }

# ==[ Dispatch ]==

console.log "\nDispatch"

log = []
note = (name) -> (event) -> log.push "#{name} #{event.eventPhase}"

# Three boxes, one inside the other, each listening in both phases.
Nest =! component
  render
    Box id: 'outer', @keydownCapture: note('outer capture'), @keydown: note('outer')
      Box id: 'middle', @keydownCapture: note('middle capture'), @keydown: note('middle')
        Box id: 'inner', focusable: true, autofocus: true, @keydownCapture: note('inner capture'), @keydown: note('inner')
          Text "x"

test "a key runs the capture phase root to target, then the target, then bubbles to the document", ->
  mounted Nest, {}, (view) ->
    log.length = 0
    document.addEventListener 'keydown', note('document capture'), true
    document.addEventListener 'keydown', note('document')
    view.press 'a'
    eq log, ['document capture 1', 'outer capture 1', 'middle capture 1', 'inner capture 2', 'inner 2', 'middle 3', 'outer 3', 'document 3']

test "a capture listener is asked for by `@keydownCapture:`, by `true`, or by `{ capture: true }`, and taken away the same way", ->
  mounted Nest, {}, (view) ->
    outer = find 'outer'
    heard = []
    first = -> heard.push 'flag'
    second = -> heard.push 'option'
    outer.addEventListener 'keydown', first, true
    outer.addEventListener 'keydown', second, { capture: true }
    log.length = 0
    view.press 'a'
    eq heard, ['flag', 'option']
    eq log.indexOf('outer capture 1') < log.indexOf('inner 2'), true
    outer.removeEventListener 'keydown', first
    view.press 'a'
    eq heard, ['flag', 'option', 'flag', 'option'], 'a capture listener is not taken away as a bubble one'
    outer.removeEventListener 'keydown', first, true
    outer.removeEventListener 'keydown', second, { capture: true }
    view.press 'a'
    eq heard.length, 4

test "one handler under one type and phase is one listener, and an event dispatched again starts clear", ->
  mounted Nest, {}, (view) ->
    inner = find 'inner'
    heard = []
    twice = -> heard.push 'x'
    inner.addEventListener 'keydown', twice
    inner.addEventListener 'keydown', twice
    inner.addEventListener 'keydown', twice, true
    view.press 'a'
    eq heard, ['x', 'x'], 'once as a bubble listener, once as a capture listener'
    event = Event.new 'keydown', { key: 'a' }
    inner.addEventListener 'keydown', (event) ->
      event.preventDefault()
      event.stopPropagation()
    eq inner.dispatchEvent(event), false
    eq [event.defaultPrevented, event.cancelBubble], [true, true]
    inner.removeEventListener 'keydown', twice
    inner.removeEventListener 'keydown', twice, true
    log.length = 0
    inner.listeners.keydown = []
    eq inner.dispatchEvent(event), true, 'the flags are cleared as the dispatch begins'
    eq log, ['outer capture 1', 'middle capture 1', 'inner capture 2', 'middle 3', 'outer 3']

# Stop the key at `where`, in `phase`, and answer who heard it.
stopped =! (where, phase) ->
  mounted Nest, {}, (view) ->
    log.length = 0
    find(where).addEventListener 'keydown', ((event) -> log.push 'stop'; event.stopPropagation()), phase is 'capture'
    view.press 'a'
  log.slice()

test "stopPropagation ends the dispatch in the capture phase, at the target, and in the bubble phase", ->
  eq stopped('outer', 'capture'), ['outer capture 1', 'stop']
  eq stopped('middle', 'capture'), ['outer capture 1', 'middle capture 1', 'stop']
  eq stopped('inner', 'capture'), ['outer capture 1', 'middle capture 1', 'inner capture 2', 'stop'], 'a stop at the target in the capture phase stops its bubble listeners too, as the DOM Standard has it'
  eq stopped('inner', 'bubble'), ['outer capture 1', 'middle capture 1', 'inner capture 2', 'inner 2', 'stop']
  eq stopped('middle', 'bubble'), ['outer capture 1', 'middle capture 1', 'inner capture 2', 'inner 2', 'middle 3', 'stop']

test "stopPropagation lets the node's other listeners hear the event, and stopImmediatePropagation does not", ->
  mounted Nest, {}, (view) ->
    inner = find 'inner'
    inner.addEventListener 'keydown', (event) -> event.stopImmediatePropagation()
    inner.addEventListener 'keydown', -> log.push 'late'
    log.length = 0
    view.press 'a'
    eq log, ['outer capture 1', 'middle capture 1', 'inner capture 2', 'inner 2']

test "one event object is handed to every listener, with DOM's fields", ->
  mounted Nest, {}, (view) ->
    seen = []
    targets = []
    hear = (event) ->
      seen.push event
      targets.push [idOf(event.target), idOf(event.currentTarget)]
    find('outer').addEventListener 'keydown', hear, true
    find('inner').addEventListener 'keydown', hear
    find('outer').addEventListener 'keydown', hear
    view.press 'ArrowUp', ctrl: true, shift: true
    eq seen.length, 3
    ok seen[0] is seen[1] and seen[1] is seen[2], 'each listener was handed an event of its own'
    eq targets, [['inner', 'outer'], ['inner', 'inner'], ['inner', 'outer']]
    event = seen[0]
    eq [event.type, event.key, event.ctrlKey, event.shiftKey, event.altKey, event.metaKey, event.repeat], ['keydown', 'ArrowUp', true, true, false, false, false]
    eq [event.eventPhase, event.currentTarget, event.defaultPrevented, event.bubbles], [0, null, false, true], 'after the dispatch the event is at rest'

test "the bytes of a key reach its listeners as `sequence`, and a held key as `repeat`", ->
  mounted Nest, {}, (view) ->
    seen = []
    document.addEventListener 'keydown', (event) -> seen.push [event.key, event.sequence, event.repeat, event.altKey]
    view.send "#{CSI}1;5A#{CSI}97;1:2u#{ESC}x"
    eq seen, [['ArrowUp', "#{CSI}1;5A", false, false], ['a', "#{CSI}97;1:2u", true, false], ['x', "#{ESC}x", false, true]]

test "with nothing focused a key goes to the body, as DOM sends it: the app's root element does not hear it, and the document does", ->
  Plain = component
    render
      Box id: 'root', @keydown: note('root')
        Text "x"
  mounted Plain, {}, (view) ->
    log.length = 0
    document.addEventListener 'keydown', note('document')
    document.body.addEventListener 'keydown', note('body')
    view.press 'a'
    eq log, ['body 2', 'document 3']
    find('root').set 'focusable', true
    find('root').focus()
    view.press 'a'
    eq log, ['body 2', 'document 3', 'root 2', 'body 3', 'document 3'], 'a root that holds focus hears every key nothing under it took'

test "the path is the tree as the dispatch began: a listener that moves the target out changes nothing of who hears", ->
  mounted Nest, {}, (view) ->
    log.length = 0
    find('outer').addEventListener 'keydown', (-> find('middle').remove()), true
    view.press 'a'
    eq log, ['outer capture 1', 'middle capture 1', 'inner capture 2', 'inner 2', 'middle 3', 'outer 3']
    eq view.focused, null, 'the node that left the tree has lost focus by the next read'

test "a listener added to a node during its turn is not called in that turn, and one taken away is not called", ->
  mounted Nest, {}, (view) ->
    inner = find 'inner'
    heard = []
    late = -> heard.push 'late'
    gone = -> heard.push 'gone'
    inner.addEventListener 'keydown', ->
      inner.addEventListener 'keydown', late
      inner.removeEventListener 'keydown', gone
    inner.addEventListener 'keydown', gone
    view.press 'a'
    eq heard, []
    view.press 'a'
    eq heard, ['late']

test "a dispatch inside a dispatch keeps both paths: focus moved by a listener fires its events at once", ->
  mounted Nest, {}, (view) ->
    log.length = 0
    find('middle').set 'focusable', true
    find('inner').addEventListener 'blur', note('blur')
    find('middle').addEventListener 'focus', note('focus')
    find('inner').addEventListener 'keydown', -> find('middle').focus()
    view.press 'a'
    eq log, ['outer capture 1', 'middle capture 1', 'inner capture 2', 'inner 2', 'blur 2', 'focus 2', 'middle 3', 'outer 3']

test "a paste goes to the focused node as one `paste` event with its text, and bubbles", ->
  got = []
  Pasted = component
    render
      Box @paste: ((event) -> got.push ['outer', event.text, idOf event.target])
        Box id: 'field', focusable: true, autofocus: true, @paste: ((event) -> got.push ['field', event.text, event.type])
          Text "x"
  mounted Pasted, {}, (view) ->
    view.paste 'two\rlines'
    view.send "#{CSI}200~from the terminal#{CSI}201~"
    eq got, [['field', 'two\rlines', 'paste'], ['outer', 'two\rlines', 'field'], ['field', 'from the terminal', 'paste'], ['outer', 'from the terminal', 'field']]

test "a component's `emit` bubbles through the same dispatch", ->
  got = []
  Child = component
    render
      Box focusable: true, autofocus: true, @keydown: (=> @emit 'chosen', 7)
        Text "x"
  Parent = component
    render
      Box @chosen: ((event) -> got.push [event.type, event.detail, event.eventPhase])
        Child
  mounted Parent, {}, (view) ->
    view.press 'Enter'
    eq got, [['chosen', 7, 3]]

test "`press`, `type`, `paste` and `send` take one road: what a listener hears is the same", ->
  mounted Nest, {}, (view) ->
    seen = []
    document.addEventListener 'keydown', (event) -> seen.push [event.key, event.shiftKey, event.ctrlKey]
    view.press 'a'
    view.type 'a'
    view.send 'a'
    view.press 'A', shift: true
    view.type 'A'
    view.press "#{CSI}1;5A"
    view.press 'ArrowUp', ctrl: true
    eq seen, [['a', false, false], ['a', false, false], ['a', false, false], ['A', true, false], ['A', true, false], ['ArrowUp', false, true], ['ArrowUp', false, true]]

test "a lone ESC is the Escape key only once its wait has run out", ->
  mounted Nest, {}, (view) ->
    seen = []
    document.addEventListener 'keydown', (event) -> seen.push event.key
    view.send ESC
    view.tick 49
    eq seen, []
    view.tick 1
    eq seen, ['Escape']
    view.send ESC
    view.send '[A'
    view.tick 1000
    eq seen, ['Escape', 'ArrowUp']

test "a close leaves no wait of the parser armed", ->
  view = mount Nest
  view.send ESC
  eq view.held.clock.due.length, 1
  view.close()
  eq view.held.clock.due.length, 0

# ==[ Default actions ]==

console.log "\nDefault actions"

Trio =! component
  @keep := false
  render
    Box @keydown: ((event) => event.preventDefault() if @keep)
      Box id: 'a', focusable: true
        Text "a"
      Box id: 'b', focusable: true
        Text "b"
      Box id: 'c', focusable: true
        Text "c"

test "Tab and Shift-Tab move focus, and a prevented one does not", ->
  mounted Trio, {}, (view) ->
    view.press 'Tab'
    view.press 'Tab'
    eq idOf(view.focused), 'b'
    view.press 'Tab', shift: true
    eq idOf(view.focused), 'a'
    view.app.keep.value = true
    view.press 'Tab'
    view.send '\t'
    view.send "#{CSI}Z"
    eq idOf(view.focused), 'a'

test "Tab under Ctrl, Alt or Meta is no focus key", ->
  mounted Trio, {}, (view) ->
    view.press 'Tab', ctrl: true
    view.press 'Tab', alt: true
    view.press 'Tab', meta: true
    eq view.focused, null

test! "Ctrl-C quits as `quit()` does, and a prevented one does not", ->
  view = mount Trio
  view.press 'c', ctrl: true
  eq await view.done, undefined
  eq typeof document, 'undefined'
  kept = mount Trio, props: { keep: true }
  try
    kept.press 'Tab'
    kept.send '\x03'
    kept.press 'c', ctrl: true
    sleep! 0
    ok document?, 'a Ctrl-C the app kept closed it'
    kept.press 'C', ctrl: true, shift: true
    kept.press 'c', ctrl: true, alt: true
  finally
    kept.close()

test! "a key that follows the one that quit, in the same read, is nobody's", ->
  heard = []
  Quits = component
    render
      Box focusable: true, autofocus: true, @keydown: ((event) -> heard.push event.key; quit 'done' if event.key is 'q')
        Text "x"
  view = mount Quits
  try
    view.send 'aqbc'
    eq heard, ['a', 'q']
    eq await view.done, 'done'
  finally
    view.close()

test "Escape does nothing by default", ->
  mounted Trio, {}, (view) ->
    view.press 'Tab'
    view.press 'Escape'
    eq idOf(view.focused), 'a'
    ok document?

# ==[ Focus ]==

console.log "\nFocus"

Board =! component
  @order := ['a', 'b', 'c', 'd']
  @gone := null
  @hidden := null
  @off := null
  @none := null
  left ~= @order.filter (name) => name isnt @gone
  render
    Box flexDirection: 'column'
      for name in left
        Box key: name, id: name, focusable: true, hidden: name is @hidden, disabled: name is @off, display: (if name is @none then 'none' else 'flex')
          Text "#{name}"

# Every id Tab reaches from where focus is, until it comes back round.
cycle =! (view, key = 'Tab', mods = {}) ->
  reached = []
  loop
    view.press key, mods
    id = idOf view.focused
    break if id is null or id in reached
    reached.push id
  reached

test "focus order is tree order, found when Tab is pressed: a keyed list reordered is walked as it stands", ->
  mounted Board, {}, (view) ->
    eq cycle(view), ['a', 'b', 'c', 'd']
    view.app.order.value = ['d', 'b', 'a', 'c']
    focus.to null
    eq cycle(view), ['d', 'b', 'a', 'c']
    focus.to null
    eq cycle(view, 'Tab', shift: true), ['c', 'a', 'b', 'd']

test "a focused node that a reorder moves keeps its focus, and hears neither blur nor focus", ->
  mounted Board, {}, (view) ->
    find('b').focus()
    heard = []
    find('b').addEventListener 'blur', -> heard.push 'blur'
    find('b').addEventListener 'focus', -> heard.push 'focus'
    view.app.order.value = ['d', 'c', 'b', 'a']
    view.frame()
    eq [idOf(view.focused), heard], ['b', []]
    view.press 'Tab'
    eq idOf(view.focused), 'a'

test "a focused node that is removed, hidden, disabled or taken out of layout loses focus to nothing, and hears blur once", ->
  for how in ['gone', 'hidden', 'off', 'none']
    mounted Board, {}, (view) ->
      heard = []
      node = find 'b'
      node.focus()
      node.addEventListener 'blur', -> heard.push 'blur'
      view.app[how].value = 'b'
      eq [how, document.activeElement, focus.active], [how, null, null]
      view.frame()
      eq [how, view.focused, heard, node.focused], [how, null, ['blur'], false]
      view.press 'Tab'
      eq [how, idOf view.focused], [how, 'a'], 'Tab starts again from the top'

test "hidden and disabled subtrees are passed over whole, and an ancestor's `disabled` is its descendants'", ->
  Deep = component
    @shut := 'hidden'
    render
      Box flexDirection: 'column'
        Box id: 'one', focusable: true
          Text "one"
        Box id: 'group', hidden: @shut is 'hidden', disabled: @shut is 'disabled', display: (if @shut is 'none' then 'none' else 'flex')
          Box id: 'two', focusable: true
            Box id: 'three', focusable: true
              Text "three"
        Box id: 'four', focusable: true
          Text "four"
  for shut in ['hidden', 'disabled', 'none']
    mounted Deep, { props: { shut } }, (view) ->
      eq cycle(view), ['one', 'four']
      focus.to null
      eq cycle(view, 'Tab', shift: true), ['four', 'one']
      find('three').focus()
      focus.to find 'two'
      eq idOf(view.focused), 'four', "a node under a #{shut} box took focus"
      view.app.shut.value = ''
      focus.to null
      eq cycle(view), ['one', 'two', 'three', 'four'], 'a focusable node inside a focusable node is reached after it'

test "`focus()` on a node that cannot take it changes nothing, and `blur()` on a node that does not hold it", ->
  mounted Board, { props: { off: 'c' } }, (view) ->
    find('a').focus()
    find('c').focus()
    document.body.focus()
    document.createElement('div').focus()
    eq idOf(view.focused), 'a'
    find('b').blur()
    eq idOf(view.focused), 'a'
    find('a').blur()
    eq view.focused, null

test "focus and blur pair up, do not bubble, and are heard above in the capture phase", ->
  heard = []
  Pairs = component
    render
      Box @focus: (-> heard.push 'bubbled focus'), @blur: (-> heard.push 'bubbled blur'), @focusCapture: ((event) -> heard.push "capture focus #{idOf event.target}"), @blurCapture: ((event) -> heard.push "capture blur #{idOf event.target}")
        Box id: 'a', focusable: true, @focus: (-> heard.push 'focus a'), @blur: (-> heard.push 'blur a')
          Text "a"
        Box id: 'b', focusable: true, @focus: (-> heard.push 'focus b'), @blur: (-> heard.push 'blur b')
          Text "b"
  mounted Pairs, {}, (view) ->
    view.press 'Tab'
    view.press 'Tab'
    find('b').focus()
    focus.to null
    eq heard, ['capture focus a', 'focus a', 'capture blur a', 'blur a', 'capture focus b', 'focus b', 'capture blur b', 'blur b']

test "inside `focus` and `blur` every read agrees with the event, as DOM's do", ->
  seen = []
  snap = (tag) -> -> seen.push [tag, idOf(document.activeElement), idOf(focus.active), find('a').focused, find('b').focused]
  mounted Board, {}, (view) ->
    find('a').focused
    find('b').focused
    find('a').addEventListener 'focus', snap 'focus a'
    find('a').addEventListener 'blur', snap 'blur a'
    find('b').addEventListener 'focus', snap 'focus b'
    find('a').focus()
    find('b').focus()
    eq seen, [['focus a', 'a', 'a', true, false], ['blur a', null, null, false, false], ['focus b', 'b', 'b', false, true]]

test "a `blur` listener that throws leaves the state whole: the reads agree, keys go where they say, and the next Tab is one blur and one focus", ->
  mounted Board, {}, (view) ->
    a = find 'a'
    b = find 'b'
    a.focus()
    boom = -> raise 'blur boom'
    a.addEventListener 'blur', boom
    throws (-> b.focus()), 'blur boom'
    a.removeEventListener 'blur', boom
    eq [idOf(document.activeElement), idOf(focus.active), idOf(view.focused), a.focused, b.focused], [null, null, null, false, false]
    heard = []
    a.addEventListener 'keydown', -> heard.push 'a'
    b.addEventListener 'keydown', -> heard.push 'b'
    document.body.addEventListener 'keydown', -> heard.push 'body'
    view.press 'x'
    eq heard, ['body']
    events = []
    for node in [a, b]
      node.addEventListener 'focus', ((event) -> events.push "focus #{idOf event.target}")
      node.addEventListener 'blur', ((event) -> events.push "blur #{idOf event.target}")
    view.press 'Tab'
    view.press 'Tab'
    eq events, ['focus a', 'blur a', 'focus b']

test "`focus.active`, `document.activeElement` and `view.focused` agree the moment an `autofocus` node arrives", ->
  Arrives = component
    @more := false
    render
      Box flexDirection: 'column'
        Text "x"
        if @more
          Box id: 'late', focusable: true, autofocus: true
            Text "late"
  mounted Arrives, {}, (view) ->
    eq [focus.active, document.activeElement, view.focused], [null, null, null]
    view.app.more.value = true
    eq idOf(focus.active), 'late'
    eq [idOf(document.activeElement), idOf(view.focused)], ['late', 'late']

test "a node styles itself by `focused`, a reactive read, and `focus.active` is one too", ->
  Lit = component
    el := null
    render
      Box flexDirection: 'column'
        div ref: el, id: 'field', focusable: true
          Text inverse: el?.focused
            "#{if el?.focused then 'on' else 'off'}"
        Text "#{focus.active?.getAttribute('id') ?? 'nothing'} has focus"
  mounted Lit, {}, (view) ->
    eq view.frame(), "off\nnothing has focus"
    view.press 'Tab'
    eq view.frame(), "on\nfield has focus"
    ok view.ansi.includes("#{CSI}7mon"), JSON.stringify view.ansi
    view.press 'Tab'
    eq view.frame(), "on\nfield has focus", 'Tab from the only node comes back to it'
    find('field').blur()
    eq view.frame(), "off\nnothing has focus"

test "`autofocus` is a claim made once: on mount the first in tree order takes it, a later node takes it only if nothing holds it", ->
  Claims = component
    @more := false
    @again := false
    render
      Box flexDirection: 'column'
        Box id: 'plain', focusable: true
          Text "plain"
        Box id: 'first', focusable: true, autofocus: true
          Text "first"
        Box id: 'second', focusable: true, autofocus: true
          Text "second"
        if @more
          Box id: 'later', focusable: true, autofocus: true
            Text "later"
        if @again
          Box id: 'again', focusable: true, autofocus: true
            Text "again"
  mounted Claims, {}, (view) ->
    eq idOf(view.focused), 'first'
    view.app.more.value = true
    eq idOf(view.focused), 'first', 'a node that arrives takes no focus from the one that holds it'
    focus.to null
    view.frame()
    eq view.focused, null, 'a claim is made once, and is not made again when focus is let go'
    view.app.again.value = true
    eq idOf(view.focused), 'again', 'a node that arrives when nothing holds focus takes it'

test "claims are settled in tree order, whatever order they were made in", ->
  mounted Trio, {}, (view) ->
    find('c').set 'autofocus', true
    find('b').set 'autofocus', true
    eq idOf(view.focused), 'b'

test "`autofocus` on a disabled node claims nothing", ->
  Cannot = component
    render
      Box
        Box id: 'a', disabled: true
          Box id: 'inner', autofocus: true
            Text "a"
        Box id: 'b', focusable: true, autofocus: true, disabled: true
          Text "b"
        Box id: 'c', autofocus: true, disabled: true
          Text "c"
  mounted Cannot, {}, (view) ->
    eq view.focused, null

test "`autofocus` on a node that is not `focusable` is refused by name where the claim is settled, whichever switch came first", ->
  Unfit = component
    @late := false
    render
      Box flexDirection: 'column'
        Box id: 'plain', autofocus: true
          Text "plain"
        if @late
          Box id: 'late', autofocus: true
            Text "late"
  refused = "rip/tui: autofocus on <div> that is not focusable — write focusable: true"
  view = mount Unfit, cols: 20
  try
    throws (-> view.frame()), "#{refused} (on div > div[data-part=Box] > div#plain[data-part=Box])"
    eq view.focused, null, 'the claim was settled when it was refused'
    view.app.late.value = true
    throws (-> view.focused), "#{refused} (on div > div[data-part=Box] > div#late[data-part=Box])"
  finally
    view.close()
  Fit = component
    render
      Box flexDirection: 'column'
        Box id: 'first', autofocus: true, focusable: true
          Text "first"
        Box id: 'second', focusable: true, autofocus: true
          Text "second"
  mounted Fit, {}, (view) ->
    eq idOf(view.focused), 'first'
    for order in [['autofocus', 'focusable'], ['focusable', 'autofocus']]
      focus.to null
      node = document.createElement 'div'
      node.set 'id', order[0]
      node.set key, true for key in order
      document.body.firstChild.appendChild node
      eq idOf(view.focused), order[0], order.join ' then '
    node = document.createElement 'div'
    node.set 'id', 'unfit'
    document.body.firstChild.appendChild node
    node.set 'autofocus', true
    throws (-> view.frame()), "#{refused} (on div > div[data-part=Box] > div#unfit)"

test "`screen.focused` follows the terminal's focus reports", ->
  Shown = component
    render
      Text "#{if screen.focused then 'here' else 'away'}"
  mounted Shown, {}, (view) ->
    eq view.frame(), 'here'
    view.send "#{CSI}O"
    eq view.frame(), 'away'
    view.send "#{CSI}I"
    eq view.frame(), 'here'

# ==[ README ]==

console.log "\nREADME"

# The select list of README.md, "Input and focus", as it is written there.
Select =! component
  @items := []
  @chosen := null
  at := 0
  el := null
  move: (event) ->
    switch event.key
      when 'ArrowDown' then @at = (@at + 1) % @items.length
      when 'ArrowUp'   then @at = (@at - 1 + @items.length) % @items.length
      when 'Enter'     then @chosen = @items[@at]
  render
    div ref: el, focusable: true, autofocus: true, @keydown: @move, borderStyle: 'round', borderColor: (if el?.focused then 'cyan' else 'gray')
      for item, n in @items
        Text key: item, inverse: n is at
          "#{item}"

test "the README's select list: arrows move the choice, Enter takes it, and the border says who has focus", ->
  mounted Select, { cols: 12, props: { items: ['tea', 'coffee', 'water'] } }, (view) ->
    eq view.frame(), "╭──────────╮\n│tea       │\n│coffee    │\n│water     │\n╰──────────╯"
    ok view.ansi.includes("#{CSI}36m╭") and /7mtea/.test(view.ansi), JSON.stringify view.ansi
    view.press 'ArrowDown'
    view.frame()
    ok /7mcoffee/.test(view.ansi) and not /7mtea/.test(view.ansi), JSON.stringify view.ansi
    view.press 'ArrowUp'
    view.press 'ArrowUp'
    view.press 'Enter'
    eq view.app.chosen.value, 'water'
    view.focused.blur()
    view.frame()
    ok view.ansi.includes("#{CSI}90m╭"), 'a border that lost focus is gray'

# The text input of README.md: a key that types is one code point, and
# the buffer is cut into clusters for the cursor and for Backspace.
clusters =! Intl.Segmenter.new undefined, { granularity: 'grapheme' }
Input =! component
  @value := ''
  typed: (event) ->
    if event.key is 'Backspace'
      parts = Array.from clusters.segment(@value), (part) -> part.segment
      @value = parts.slice(0, -1).join ''
    else if Array.from(event.key).length is 1 and not event.ctrlKey and not event.altKey and not event.metaKey
      @value += event.key
  render
    Box focusable: true, autofocus: true, borderStyle: 'single', width: 20, cursor: { x: 1 + Bun.stringWidth(@value), y: 1 }, @keydown: @typed, @paste: ((event) => @value += event.text)
      Text "#{@value}"

test "the README's text input: code points in, clusters out, and the cursor after the last cell", ->
  family = '\u{1F468}‍\u{1F469}‍\u{1F467}'
  mounted Input, {}, (view) ->
    view.type 'hi 你'
    view.frame()
    eq [view.app.value.value, view.cursor], ['hi 你', { x: 6, y: 1 }]
    view.type family
    eq Array.from(view.app.value.value).length, 9, 'a family emoji is five key events'
    view.press 'Backspace'
    eq view.app.value.value, 'hi 你', 'and one Backspace'
    view.paste '!!'
    view.press 'a', ctrl: true
    view.press 'ArrowLeft'
    view.frame()
    eq [view.app.value.value, view.cursor], ['hi 你!!', { x: 8, y: 1 }]

# ==[ Cursor ]==

console.log "\nCursor"

# Draw a frame, send its bytes to a terminal `run` would have opened, and
# hold the terminal's cursor to the mount's.
shown =! (view, term) ->
  text = view.frame()
  term.write view.bytes
  eq term.text, text.trimEnd()
  eq term.cursor, view.cursor
  view.cursor

hiddenTerminal =! (cols = 40, rows = 10) ->
  term = Terminal.new cols, rows
  term.write "#{CSI}?25l"
  term

test "a focused node's cursor is parked at its corner plus (x, y), under the padding and borders above it", ->
  Padded = component
    @x := 0
    @y := 0
    render
      Box borderStyle: 'single', padding: 1, paddingLeft: 3
        Text "title"
        Box id: 'field', focusable: true, autofocus: true, borderStyle: 'round', paddingX: 2, cursor: { x: @x, y: @y }
          Text "value"
  mounted Padded, {}, (view) ->
    term = hiddenTerminal()
    eq shown(view, term), { x: 4, y: 3 }, 'the corner of the field: a border and 3 cells in, a border, a row of padding and a title down'
    view.app.x.value = 3
    view.app.y.value = 1
    eq shown(view, term), { x: 7, y: 4 }
    eq term.lines[4][7], 'v', 'x and y count from the field\'s own border, so its text begins at (3, 1)'

test "only the focused node's cursor counts, and with none the cursor is hidden", ->
  Two = component
    render
      Box flexDirection: 'column'
        Box id: 'a', focusable: true, cursor: { x: 1, y: 0 }
          Text "aaa"
        Box id: 'b', focusable: true
          Text "bbb"
        Box id: 'c', focusable: true, cursor: { x: 2, y: 0 }
          Text "ccc"
  mounted Two, {}, (view) ->
    term = hiddenTerminal()
    eq shown(view, term), null
    eq view.bytes.includes("#{CSI}?25"), false, 'a cursor that stays hidden is not hidden again'
    view.press 'Tab'
    eq shown(view, term), { x: 1, y: 0 }
    view.press 'Tab'
    eq shown(view, term), null
    view.press 'Tab'
    eq shown(view, term), { x: 2, y: 2 }
    find('c').set 'cursor', null
    eq shown(view, term), null

test "content offsets above the node move its cursor, nested ones add up, and a clip that hides it hides the cursor", ->
  Scrolled = component
    @outer := 0
    @inner := 0
    @across := 0
    render
      Box height: 4, width: 12, overflow: 'hidden', borderStyle: 'single', contentOffsetY: @outer, contentOffsetX: @across
        Box flexDirection: 'column', flexShrink: 0, contentOffsetY: @inner
          Text "zero"
          Text "one"
          Box id: 'field', focusable: true, autofocus: true, flexShrink: 0, cursor: { x: 1, y: 0 }
            Text "two"
  mounted Scrolled, {}, (view) ->
    term = hiddenTerminal()
    eq shown(view, term), null, 'the field is on the row the bottom border is drawn over: clipped'
    view.app.outer.value = 1
    eq shown(view, term), { x: 2, y: 2 }
    view.app.inner.value = 1
    eq shown(view, term), { x: 2, y: 1 }
    view.app.inner.value = 2
    eq shown(view, term), null, 'scrolled onto the top border: the clip is the padding box, inside the border'
    view.app.inner.value = 0
    view.app.across.value = 1
    eq shown(view, term), { x: 1, y: 2 }
    view.app.across.value = 2
    eq shown(view, term), null, 'scrolled under the left border'
    view.app.across.value = -9
    eq shown(view, term), null, 'and past the right one'

test "x is in cells: a cursor after two wide glyphs is four cells in", ->
