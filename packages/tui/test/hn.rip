# The Hacker News example, offline. The data layer: the errors and
# their copy, the item validator, the live transport against a loopback
# server, the timeout and retry policy on a hand clock, the item cache,
# the parent walk, the comment tree, the formatting of HN's text, and
# the saved and history files in a temp directory. Then the app itself
# through `mount` at 100 by 30 over the fake, with the clock and the
# browser in the test's hands: every view's rows, the keys, the mouse,
# the overlays, the theme and its wipe, the files, and the loading,
# failing and cancelled requests.
#
#   rip test/hn.rip

import { test, eq, ok, throws } from 'rip/testing'
import { mkdtempSync, rmSync, readFileSync, writeFileSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
import { mount, screen } from 'rip/tui'
import * as cells from './ink/cells.rip'
import { Api, HnError, HnRequestError, HnStatusError, HnTimeoutError, HnDecodeError, HnItemGone, hnErrorMessage, DELAYS, decodeItem, fetcher, timed, retrying, flattenTree } from '../examples/hn/api.rip'
import { Fake, NOW } from '../examples/hn/fake.rip'
import { relativeTime, hostname, decodeEntities, htmlToText, extractLinks, parseHnItemLink } from '../examples/hn/format.rip'
import { Store, HISTORY_CAP, configDir } from '../examples/hn/store.rip'
import { App } from '../examples/hn/hn.rip'
import { FRAMES, INDEXES, ALPHAS, COUNT, colorsOver } from '../examples/hn/spinner.rip'
import { DARK, LIGHT, opaque } from '../examples/hn/theme.rip'

# ---------------------------------------------------------------------
# Harness
# ---------------------------------------------------------------------

# Waits for the fake to go quiet: nothing in flight but what is parked
# on a hold or a hang, and no new request between two turns.
settle =! (fake) ->
  loop
    before = fake.log.length
    sleep! 0
    sleep! 0
    break if fake.inflight - fake.waiting is 0 and fake.log.length is before
  return

# The error `promise` rejects with, which must be a `want` when given.
rejects =! (promise, want = null) ->
  try
    await promise
  catch error
    return error if not want or error instanceof want
    throw Error.new "expected #{want.name}, got #{error?.constructor?.name}: #{error?.message}"
  throw Error.new "expected a rejection#{if want then ' with ' + want.name else ''}"

# What `promise` settles to, as `{ value }` or `{ error }`, so a test
# that expects a value can hold the promise across the clock's ticks.
settled =! (promise) -> promise.then ((value) -> { value }), ((error) -> { error })

# A clock the test moves: `after` and `wait` stand in for the policy's
# timers, `waits` records each backoff asked for, and `tick` fires what
# is due and lets the promises behind it run.
handClock =! ->
  clock = { now: 0, timers: [], waits: [] }
  clock.after = (ms, fn) ->
    timer = { at: clock.now + ms, fn }
    clock.timers.push timer
    -> timer.fn = null
  clock.wait = (ms) ->
    clock.waits.push ms
    gate = Promise.withResolvers()
    clock.timers.push { at: clock.now + ms, fn: gate.resolve }
    gate.promise
  clock.tick = (ms) ->
    clock.now += ms
    due = clock.timers.filter (timer) -> timer.at <= clock.now
    clock.timers = clock.timers.filter (timer) -> timer.at > clock.now
    timer.fn?() for timer in due.sort((a, b) -> a.at - b.at)
    sleep! 0 for n in [1..6]
    return
  clock

# The retry policy with no waiting, over a fake.
instant =! (fake) -> retrying fake.transport().getJson, [0, 0], (-> Promise.resolve())

# hntui's own canned transport: six pins port over it verbatim.
DB =! {
  'item/1.json': { id: 1, type: 'story', title: 'Root story', kids: [2, 4] }
  'item/2.json': { id: 2, type: 'comment', parent: 1, text: 'child' }
  'item/3.json': { id: 3, type: 'comment', parent: 2, text: 'grandchild' }
  'item/4.json': { id: 4, type: 'comment', parent: 1, deleted: true }
  'item/5.json': { id: 5, type: 'story', title: 'Deleted story', deleted: true }
  'item/9.json': { id: 'not-a-number', type: 'story' }
}
canned =! (log = []) ->
  getJson: (path) ->
    log.push path
    Promise.resolve DB[path] ?? null

ids =! (rows) -> (row.node.item.id for row in rows)

console.log "\nhn: errors and decode"

test "hnErrorMessage: one line of copy per HnError, and anything else is refused as a bug", ->
  eq hnErrorMessage(HnRequestError.new 'x', 1), "Couldn't reach Hacker News — check your connection."
  eq hnErrorMessage(HnTimeoutError.new 'x'), 'Hacker News took too long to respond.'
  eq hnErrorMessage(HnStatusError.new 'x', 503), 'Hacker News returned HTTP 503.'
  eq hnErrorMessage(HnDecodeError.new 'x', 'bad'), "Hacker News sent a response the app couldn't understand."
  throws (-> hnErrorMessage Error.new 'plain'), TypeError, 'not an HnError'
  throws (-> hnErrorMessage HnItemGone.new 7), TypeError

test "the errors are Errors with their name, their path and their message", ->
  error = HnStatusError.new 'item/1.json', 503
  ok error instanceof Error and error instanceof HnError and error instanceof HnStatusError
  eq [error.name, error.path, error.status, error.message], ['HnStatusError', 'item/1.json', 503, 'HTTP 503: item/1.json']
  gone = HnItemGone.new 7
  ok gone instanceof Error and not (gone instanceof HnError)
  eq [gone.name, gone.id, gone.message], ['HnItemGone', 7, 'item 7 is gone']

test "decodeItem: null stays null, a non-object is refused before any field, and a field present with the wrong type names itself", ->
  eq decodeItem(null, 'p'), null
  throws (-> decodeItem 5, 'p'), HnDecodeError, 'expected an object'
  throws (-> decodeItem [1], 'p'), HnDecodeError, 'expected an object'
  throws (-> decodeItem { id: 'not-a-number', type: 'story' }, 'p'), HnDecodeError, 'id: expected a number, got "not-a-number"'
  throws (-> decodeItem { id: 1, type: 'user' }, 'p'), HnDecodeError, 'type: expected one of story, comment, job, poll, pollopt, got "user"'
  throws (-> decodeItem { id: 1, type: 'story', by: null }, 'p'), HnDecodeError, 'by: expected a string, got null'
  throws (-> decodeItem { id: 1, type: 'story', kids: [1, 'x'] }, 'p'), HnDecodeError, 'kids: expected an array of numbers'
  error = try decodeItem({ id: 1, type: 'story', score: '5' }, 'item/1.json') catch e then e
  eq [error.path, error.issue], ['item/1.json', 'score: expected a number, got "5"']

test "decodeItem: the known keys are copied, kids is a fresh array, and unknown keys such as parts are dropped", ->
  raw = { id: 1, type: 'poll', by: 'pg', time: 5, kids: [2], parts: [3], score: 9, extra: true }
  item = decodeItem raw, 'p'
  eq item, { id: 1, type: 'poll', by: 'pg', time: 5, score: 9, kids: [2] }
  ok item.kids isnt raw.kids
  eq decodeItem({ id: 2, type: 'comment', text: undefined }, 'p'), { id: 2, type: 'comment' }, 'an undefined field is absent'

console.log "\nhn: the live transport, against a loopback server"

test! "fetcher: a 200 is its JSON, a 404 is HnStatusError, a bad body is HnRequestError, and a closed port is HnRequestError", ->
  server = Bun.serve
    port: 0
    fetch: (req) ->
      switch URL.new(req.url).pathname
        when '/v0/ok.json' then Response.json { a: 1 }
        when '/v0/bad.json' then Response.new '{oops', headers: { 'content-type': 'application/json' }
        else Response.new 'nope', status: 404
  try
    get = fetcher "http://127.0.0.1:#{server.port}/v0"
    eq (get! 'ok.json'), { a: 1 }
    error = rejects! get('missing.json'), HnStatusError
    eq [error.status, error.path], [404, 'missing.json']
    error = rejects! get('bad.json'), HnRequestError
    eq error.path, 'bad.json'
    ok error.cause instanceof Error, 'the JSON failure is the cause'
  finally
    server.stop true
  error = rejects! get('ok.json'), HnRequestError
  ok error.cause instanceof Error, "a refused connection is the cause: #{error.cause}"

test! "fetcher: an abort passes through as the signal's own error, not as a request failure", ->
  server = Bun.serve
    port: 0
    fetch: ->
      sleep! 50
      Response.json 1
  try
    controller = AbortController.new()
    get = fetcher "http://127.0.0.1:#{server.port}/v0"
    p = get 'slow.json', controller.signal
    controller.abort()
    error = rejects! p
    eq error.name, 'AbortError'
  finally
    server.stop true

console.log "\nhn: the policy on a hand clock"

test! "retrying: a 503 twice then a 200 resolves after three requests, waiting 250 then 500 ms", ->
  fake = Fake.new()
  clock = handClock()
  fake.fail 'topstories.json', 503, 503
  get = retrying fake.transport().getJson, DELAYS, clock.wait
  outcome = settled get('topstories.json')
  settle! fake
  eq clock.waits, [250]
  clock.tick! 250
  settle! fake
  eq clock.waits, [250, 500]
  clock.tick! 500
  settle! fake
  found = await outcome
  eq found.error, undefined, found.error?.message
  eq found.value.slice(0, 3), [1001, 1002, 1005]
  eq fake.requests('topstories.json'), 3

test! "retrying: a 503 three times is HnStatusError 503, after three requests", ->
  fake = Fake.new()
  clock = handClock()
  fake.fail 'topstories.json', 503, 503, 503
  get = retrying fake.transport().getJson, DELAYS, clock.wait
  outcome = rejects get('topstories.json'), HnStatusError
  settle! fake
  clock.tick! 250
  settle! fake
  clock.tick! 500
  settle! fake
  error = await outcome
  eq [error.status, fake.requests('topstories.json'), clock.waits], [503, 3, [250, 500]]

test! "retrying: a 404 is never retried — one request, HnStatusError 404", ->
  fake = Fake.new()
  clock = handClock()
  fake.fail 'jobstories.json', 404
  get = retrying fake.transport().getJson, DELAYS, clock.wait
  error = rejects! get('jobstories.json'), HnStatusError
  eq [error.status, fake.requests('jobstories.json'), clock.waits], [404, 1, []]

test! "retrying: a network failure three times is HnRequestError", ->
  fake = Fake.new()
  fake.fail 'topstories.json', 'network', 'network', 'network'
  error = rejects! instant(fake)('topstories.json'), HnRequestError
  eq [error.path, fake.requests('topstories.json')], ['topstories.json', 3]

test! "retrying: a 500 once then a 200 is exactly two requests", ->
  fake = Fake.new()
  fake.fail 'beststories.json', 500
  get = instant fake
  eq (get! 'beststories.json'), [1007, 1005, 1001]
  eq fake.requests('beststories.json'), 2

test! "timed: a request that hangs is aborted at the timeout and is HnTimeoutError, three attempts in all", ->
  fake = Fake.new()
  clock = handClock()
  fake.fail 'jobstories.json', 'hang', 'hang', 'hang'
  get = retrying timed(fake.transport().getJson, 5000, clock.after), DELAYS, clock.wait
  outcome = rejects get('jobstories.json'), HnTimeoutError
  settle! fake
  eq fake.waiting, 1
  clock.tick! 5000
  settle! fake
  eq clock.waits, [250]
  clock.tick! 250
  settle! fake
  clock.tick! 5000
  settle! fake
  clock.tick! 500
  settle! fake
  clock.tick! 5000
  settle! fake
  error = await outcome
  eq error.path, 'jobstories.json'
  eq fake.requests('jobstories.json'), 3
  eq fake.log.filter((entry) -> entry is 'abort jobstories.json').length, 3
  eq [fake.inflight, fake.waiting], [0, 0]

test! "timed: an answer inside the timeout cancels the timer, and a caller's abort reaches the request", ->
  fake = Fake.new()
  clock = handClock()
  get = timed fake.transport().getJson, 5000, clock.after
  eq (get! 'askstories.json'), [1002]
  eq clock.timers.filter((timer) -> timer.fn).length, 0, 'the timer is cancelled'
  fake.fail 'askstories.json', 'hang'
  controller = AbortController.new()
  outcome = rejects get('askstories.json', controller.signal)
  settle! fake
  controller.abort()
  error = await outcome
  eq error.name, 'AbortError'
  eq fake.log.at(-1), 'abort askstories.json'

test! "retrying: an abort during the backoff is the signal's error, and no further request starts", ->
  fake = Fake.new()
  clock = handClock()
  fake.fail 'topstories.json', 503
  controller = AbortController.new()
  get = retrying fake.transport().getJson, DELAYS, clock.wait
  outcome = rejects get('topstories.json', controller.signal)
  settle! fake
  eq clock.waits, [250]
  controller.abort()
  error = await outcome
  eq error.name, 'AbortError'
  clock.tick! 250
  settle! fake
  eq fake.requests('topstories.json'), 1

console.log "\nhn: the item cache"

test! "resolveStory: a grandchild comment walks up to the root story and focuses itself", ->
  api = Api.new canned()
  found = api.resolveStory! { id: 3 }
  eq [found.story.id, found.focusId], [1, 3]

test! "resolveStory: an explicit #anchor wins over the walked-from comment", ->
  found = Api.new(canned()).resolveStory! { id: 1, anchorId: 2 }
  eq [found.story.id, found.focusId], [1, 2]

test! "resolveStory: an unknown id is HnItemGone", ->
  error = rejects! Api.new(canned()).resolveStory({ id: 404 }), HnItemGone
  eq error.id, 404

test! "resolveStory: a deleted story is HnItemGone", ->
  rejects! Api.new(canned()).resolveStory({ id: 5 }), HnItemGone

test! "resolveStory: a deleted comment still walks through to its living root", ->
  found = Api.new(canned()).resolveStory! { id: 4 }
  eq [found.story.id, found.focusId], [1, 4]

test! "fetchItem: a payload that violates the schema is HnDecodeError", ->
  error = rejects! Api.new(canned()).fetchItem(9), HnDecodeError
  eq error.path, 'item/9.json'

test! "fetchItem: three sequential gets of one id hit the transport once", ->
  log = []
  api = Api.new canned(log)
  api.fetchItem! 1
  api.fetchItem! 1
  api.fetchItem! 1
  eq log.filter((path) -> path is 'item/1.json').length, 1

test! "fetchItem: two concurrent gets share one request and see the same item", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  first = api.fetchItem 1001
  second = api.fetchItem 1001
  found = Promise.all! [first, second]
  eq fake.requests('item/1001.json'), 1
  eq found[0], found[1]
  eq found[0].title, 'Show HN: A Hacker News reader for the terminal, in 900 lines'

test! "fetchItem: a failure is evicted, so the next get issues a new request and can succeed", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  fake.fail 'item/1001.json', 'network'
  rejects! api.fetchItem(1001), HnRequestError
  eq fake.requests('item/1001.json'), 1
  item = api.fetchItem! 1001
  eq [item.id, fake.requests('item/1001.json'), api.cache.size], [1001, 2, 1]

test! "fetchItem: a null is a success and is cached", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  eq (api.fetchItem! 1099), null
  eq (api.fetchItem! 1099), null
  eq fake.requests('item/1099.json'), 1

test! "fetchItem: a caller that aborts stops waiting, and the shared entry still lands in the cache whole", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  gate = fake.hold 'item/1001.json'
  controller = AbortController.new()
  outcome = rejects api.fetchItem(1001, controller.signal)
  settle! fake
  controller.abort()
  error = await outcome
  eq error.name, 'AbortError'
  gate.release()
  settle! fake
  eq (api.fetchItem! 1001).id, 1001
  eq fake.requests('item/1001.json'), 1
  error = rejects! api.fetchItem(1001, controller.signal)
  eq error.name, 'AbortError', 'an already-aborted signal is refused at once'

console.log "\nhn: feeds and pools"

test! "fetchIds: null is an empty feed, and a payload that is not a list of numbers is HnDecodeError", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  eq (api.fetchIds! 'top').length, 40
  eq (api.fetchIds! 'nosuch'), []
  fake.fail 'topstories.json', { payload: { a: 1 } }, { payload: [1, 'x'] }
  error = rejects! api.fetchIds('top'), HnDecodeError
  eq [error.path, error.issue], ['topstories.json', 'expected an array of ids']
  rejects! api.fetchIds('top'), HnDecodeError

test! "fetchItems: order kept, a null and a decode failure dropped, a deleted item kept", ->
  eq (Api.new(canned()).fetchItems! [5, 1, 404, 2, 9]).map((item) -> item.id), [5, 1, 2]

test! "fetchItems: at most ten requests are in flight at once", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  found = api.fetchItems! [1013..1037]
  eq found.length, 25
  eq fake.peak, 10

test! "fetchItems: an abort mid-pool starts no further request and rejects with the signal's error", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  controller = AbortController.new()
  outcome = rejects api.fetchItems([1013..1037], controller.signal)
  eq fake.log.length, 10, 'the first ten start at once'
  controller.abort()
  error = await outcome
  eq error.name, 'AbortError'
  settle! fake
  eq fake.log.length, 10
  eq api.cache.size, 10, 'the ten in flight still fill the cache'

console.log "\nhn: the parent walk"

test! "resolveStory: 3063 reaches its story in 64 hops with itself as the focus, and 3064 is gone at the 65th", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  found = api.resolveStory! { id: 3063 }
  eq [found.story.id, found.focusId], [1001, 3063]
  error = rejects! api.resolveStory({ id: 3064 }), HnItemGone
  eq error.id, 3064

test! "resolveStory: a comment with no parent, a missing first item, and a deleted story are gone; a transport error is not", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  rejects! api.resolveStory({ id: 2301 }), HnItemGone
  rejects! api.resolveStory({ id: 999999 }), HnItemGone
  rejects! api.resolveStory({ id: 1004 }), HnItemGone
  fake.fail 'item/1003.json', 503
  error = rejects! api.resolveStory({ id: 1003 }), HnStatusError
  eq error.status, 503
  eq (api.resolveStory! { id: 1003 }).story.id, 1003, 'the failure was evicted'

test! "resolveStory: a story is its own answer with no focus, and an anchor is not validated", ->
  api = Api.new Fake.new().transport()
  eq (api.resolveStory! { id: 1001 }), { story: (api.fetchItem! 1001), focusId: undefined }
  eq (api.resolveStory! { id: 1001, anchorId: 5 }).focusId, 5
  eq (api.resolveStory! { id: 2102 }).story.id, 1002

test! "resolveStory: an abort mid-walk stops the hops", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  gate = fake.hold 'item/3050.json'
  controller = AbortController.new()
  outcome = rejects api.resolveStory({ id: 3060 }, controller.signal)
  settle! fake
  eq fake.requests('item/3050.json'), 1
  controller.abort()
  gate.release()
  error = await outcome
  eq error.name, 'AbortError'
  settle! fake
  eq fake.requests('item/3049.json'), 0

console.log "\nhn: the comment tree"

test! "loadComments and flattenTree: the rows of 1001 in reading order with their depths; the dead, deleted and null replies are left out", ->
  api = Api.new Fake.new().transport()
  story = api.fetchItem! 1001
  tree = api.loadComments! story.kids
  rows = flattenTree tree, Set.new()
  eq ids(rows), [2001, 2002, 2003, 2008, 2009]
  eq (row.depth for row in rows), [0, 1, 2, 0, 1]
  eq (row.hiddenChildren for row in rows), [0, 0, 0, 0, 0]

test! "flattenTree: a collapsed node counts the loaded replies it hides and skips them", ->
  api = Api.new Fake.new().transport()
  tree = api.loadComments! [2001, 2005, 2008]
  rows = flattenTree tree, Set.new([2001])
  eq ids(rows), [2001, 2008, 2009]
  eq rows[0].hiddenChildren, 2
  eq (row.hiddenChildren for row in flattenTree(tree, Set.new([2002]))), [0, 1, 0, 0]
  eq (row.hiddenChildren for row in flattenTree(tree, Set.new([2003]))), [0, 0, 0, 0, 0]
  eq ids(flattenTree(tree, Set.new([2001, 2008]))), [2001, 2008]

test! "loadTree: replies load to depth 8, so a chain of eleven gives nine rows", ->
  api = Api.new Fake.new().transport()
  rows = flattenTree (api.loadComments! [4000]), Set.new()
  eq ids(rows), [4000..4008]
  eq (row.depth for row in rows), [0..8]

test! "loadTree: a reply that fails to load is left out with its replies, and the parent's row stays", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  fake.fail 'item/2002.json', 'network'
  rows = flattenTree (api.loadComments! [2001, 2005, 2008]), Set.new()
  eq ids(rows), [2001, 2008, 2009]
  eq fake.requests('item/2003.json'), 0

test! "loadComments: an abort after the first level issues no request for the next, and rejects", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  gate = fake.hold 'item/2001.json'
  controller = AbortController.new()
  outcome = rejects api.loadComments([2001, 2005, 2008], controller.signal)
  settle! fake
  eq fake.requests('item/2001.json'), 1
  controller.abort()
  gate.release()
  error = await outcome
  eq error.name, 'AbortError'
  settle! fake
  eq fake.requests('item/2002.json'), 0

test! "prefetch: the internal links of a comment resolve into the cache, and a failure is ignored", ->
  fake = Fake.new()
  api = Api.new fake.transport()
  fake.fail 'item/1003.json', 503
  api.prefetch! [{ id: 2102 }, { id: 999999 }, { id: 1003 }]
  eq (fake.requests(path) for path in ['item/2102.json', 'item/2101.json', 'item/1002.json']), [1, 1, 1]
  eq (api.resolveStory! { id: 2102 }).story.id, 1002
  eq fake.requests('item/1002.json'), 1, 'the walk is served from the cache'

console.log "\nhn: format"

test "parseHnItemLink: /item?id=N with an optional #M anchor is internal; every other url is not", ->
  eq parseHnItemLink('https://news.ycombinator.com/item?id=8863'), { id: 8863, anchorId: undefined }
  eq parseHnItemLink('https://news.ycombinator.com/item?id=8863#8917'), { id: 8863, anchorId: 8917 }
  eq parseHnItemLink('http://www.news.ycombinator.com/item?id=1'), { id: 1, anchorId: undefined }
  eq parseHnItemLink('https://news.ycombinator.com/item?id=42&p=2').id, 42
  eq parseHnItemLink('https://news.ycombinator.com/user?id=pg'), null
  eq parseHnItemLink('https://news.ycombinator.com/newest'), null
  eq parseHnItemLink('https://example.com/item?id=1'), null
  eq parseHnItemLink('https://hn.algolia.com/item?id=1'), null
  eq parseHnItemLink('https://news.ycombinator.com/item'), null
  eq parseHnItemLink('https://news.ycombinator.com/item?id=abc'), null
  eq parseHnItemLink('https://news.ycombinator.com/item?id=-5'), null
  eq parseHnItemLink('https://news.ycombinator.com/item?id=7#up_8'), { id: 7, anchorId: undefined }
  eq parseHnItemLink('not a url'), null

test "relativeTime: seconds, minutes, hours, days, months and years at their boundaries; no time is no age", ->
  at = (age) -> relativeTime NOW - age, NOW * 1000
  eq [relativeTime(0, NOW * 1000), relativeTime(undefined, NOW * 1000)], ['', '']
  eq [at(59), at(60), at(3599), at(3600), at(86399), at(86400)], ['59s ago', '1m ago', '59m ago', '1h ago', '23h ago', '1d ago']
  eq [at(29 * 86400), at(30 * 86400), at(364 * 86400), at(365 * 86400)], ['29d ago', '1mo ago', '12mo ago', '1y ago']
  eq at(-30), '-30s ago', 'a time in the future is a negative age'

test "hostname: the host without www., and '' for no url or a bad one", ->
  eq hostname('https://www.example.com/flexbox-terminal'), 'example.com'
  eq hostname('https://blog.example.org/diff-grid'), 'blog.example.org'
  eq [hostname(''), hostname(undefined), hostname('not a url')], ['', '', '']

test "decodeEntities: the named entities, then decimal, then hex references, in that order", ->
  eq decodeEntities('&amp; &lt; &gt; &quot; &#x27; &#39; &#x2F; &#47; &nbsp; &#65; &#x41;'), '& < > " \' \' / /   A A'
  eq decodeEntities('&amp;#39;'), "'", 'a doubly-encoded reference decodes twice'
  eq decodeEntities('&amp;lt;'), '&lt;', 'a doubly-encoded named entity decodes once'
  eq decodeEntities('&AMP; &bogus;'), '&AMP; &bogus;', 'the named pass is case-sensitive'

test "extractLinks: each anchor once by url, the url standing in for an empty text, nested tags stripped", ->
  html = '<a href="https://a.example/?a=1&amp;b=2">One</a> <a href="https://a.example/?a=1&amp;b=2">Dup</a> <a href="https://b.example/"></a> <a href="https://c.example/" rel="nofollow"><i>Nested</i> <b>tags</b></a>'
  eq extractLinks(html), [
    { text: 'One', url: 'https://a.example/?a=1&b=2' }
    { text: 'https://b.example/', url: 'https://b.example/' }
    { text: 'Nested tags', url: 'https://c.example/' }
  ]
  eq [extractLinks(''), extractLinks(undefined)], [[], []]

test "htmlToText: paragraphs, breaks, unwrapped italics, links with their href, fenced pre blocks, backticked code, other tags dropped, then decoded and trimmed", ->
  eq htmlToText('<p>First<p>Second<br>line<br/>more'), 'First\n\nSecond\nline\nmore'
  eq htmlToText('Deep reply with <i>emphasis</i> and <code>code</code>.'), 'Deep reply with emphasis and `code`.'
  eq htmlToText('See <a href="https://x.example/?a=1&amp;b=2" rel="nofollow">the docs</a>.'), 'See the docs (https://x.example/?a=1&b=2).'
  eq htmlToText('Run:<pre><code>a\nb</code></pre>done'), 'Run:\na\nb\ndone'
  eq htmlToText('Agreed. Rust &amp; Rip both &quot;just work&quot;.<p>Second paragraph.'), 'Agreed. Rust & Rip both "just work".\n\nSecond paragraph.'
  eq htmlToText('<b>bold</b> <span class="x">span</span>'), 'bold span'
  eq [htmlToText(''), htmlToText(undefined)], ['', '']

console.log "\nhn: the store"

# A Store over a temp directory, removed when `body` is done.
withStore =! (body) ->
  dir = mkdtempSync join(tmpdir(), 'rip-hn-')
  try
    body! Store.new(dir), dir
  finally
    rmSync dir, { recursive: true, force: true }

test "configDir: HN_CONFIG_DIR, or ~/.config/rip-hn", ->
  eq configDir({ HN_CONFIG_DIR: '/tmp/x' }), '/tmp/x'
  ok configDir({}).endsWith(join('.config', 'rip-hn'))

test! "store: nothing saved and no history before any write, and no file is made by a read", ->
  withStore! (store, dir) ->
    eq [store.saved(), store.history()], [[], []]
    throws (-> readFileSync join(dir, 'saved.json')), Error

test! "store: toggling a save prepends it, writes the file byte for byte, and toggling again removes it", ->
  withStore! (store, dir) ->
    t1 = NOW * 1000
    t2 = t1 + 60000
    eq store.toggleSaved(1001, t1), [{ id: 1001, savedAt: t1 }]
    eq store.toggleSaved(1002, t2), [{ id: 1002, savedAt: t2 }, { id: 1001, savedAt: t1 }]
    eq readFileSync(join(dir, 'saved.json'), 'utf8'), JSON.stringify([{ id: 1002, savedAt: t2 }, { id: 1001, savedAt: t1 }], null, 2)
    eq store.saved(), [{ id: 1002, savedAt: t2 }, { id: 1001, savedAt: t1 }]
    eq store.toggleSaved(1002, t2 + 1), [{ id: 1001, savedAt: t1 }]
    eq Store.new(dir).saved(), [{ id: 1001, savedAt: t1 }], 'a fresh store reads the same file'

test! "store: a view moves its id to the front of the history, once, and clearing empties the file", ->
  withStore! (store, dir) ->
    t = NOW * 1000
    store.markViewed 1001, t
    store.markViewed 1005, t + 1
    eq store.markViewed(1001, t + 2), [{ id: 1001, viewedAt: t + 2 }, { id: 1005, viewedAt: t + 1 }]
    eq readFileSync(join(dir, 'history.json'), 'utf8'), JSON.stringify([{ id: 1001, viewedAt: t + 2 }, { id: 1005, viewedAt: t + 1 }], null, 2)
    eq store.clearHistory(), []
    eq readFileSync(join(dir, 'history.json'), 'utf8'), '[]'
    eq store.history(), []

test! "store: the history is capped at 1000 on read and on write", ->
  withStore! (store, dir) ->
    writeFileSync join(dir, 'history.json'), JSON.stringify(({ id: n, viewedAt: n } for n in [1..1005]))
    eq store.history().length, HISTORY_CAP
    eq store.history()[999].id, 1000
    entries = store.markViewed 5000, 1
    eq [entries.length, entries[0].id, entries[999].id], [HISTORY_CAP, 5000, 999]
    eq JSON.parse(readFileSync(join(dir, 'history.json'), 'utf8')).length, HISTORY_CAP

test! "store: a malformed file is an empty list, and entries of another shape are dropped", ->
  withStore! (store, dir) ->
    writeFileSync join(dir, 'saved.json'), '[{"id":1001,"savedAt":1},{"id":"x"},5,null,{"id":2,"viewedAt":3}]'
    eq store.saved(), [{ id: 1001, savedAt: 1 }]
    writeFileSync join(dir, 'history.json'), '{"not":"a list"}'
    eq store.history(), []
    writeFileSync join(dir, 'history.json'), 'not json'
    eq store.history(), []

console.log "\nhn: the spinner"

test "the scanner's first twelve frames, their ramp indexes and their alphas are opentui-spinner's; frame 3 is the ramp then the inactive color faded over the strip", ->
  eq COUNT, 54
  eq FRAMES.slice(0, 12), ['■⬝⬝⬝⬝⬝⬝⬝', '■■⬝⬝⬝⬝⬝⬝', '■■■⬝⬝⬝⬝⬝', '■■■■⬝⬝⬝⬝', '■■■■■⬝⬝⬝', '■■■■■■⬝⬝', '⬝■■■■■■⬝', '⬝⬝■■■■■■', '⬝⬝■■■■■■', '⬝⬝⬝■■■■■', '⬝⬝⬝⬝■■■■', '⬝⬝⬝⬝⬝■■■']
  eq INDEXES[3], [3, 2, 1, 0, -1, -1, -1, -1]
  eq INDEXES[8], [7, 6, 5, 4, 3, 2, 1, 0], 'the hold at the end counts on from the ramp'
  eq INDEXES[17], [-1, -1, -1, -1, -1, -1, 0, 1], 'the way back is mirrored'
  eq ALPHAS.slice(0, 12).map((alpha) -> Math.round(alpha * 10000) / 10000), [0, 0.1429, 0.2857, 0.4286, 0.5714, 0.7143, 0.8571, 1, 1, 0.8889, 0.7778, 0.6667]
  eq FRAMES[23], '■■■■■■⬝⬝'
  eq FRAMES.slice(30).every((frame) -> frame is '⬝⬝⬝⬝⬝⬝⬝⬝'), true
  eq Math.round(ALPHAS[53] * 10000) / 10000, 0.0333
  # #2a1500 at 0.4286 over #0e0e0e: 42·0.4286 + 14·0.5714 = 26, 21·… + 14·… = 17, 14·… = 8.
  eq colorsOver('#0e0e0e')[3], ['#aa4400', '#dd5500', '#ffaa66', '#ff6600', '#1a1108', '#1a1108', '#1a1108', '#1a1108']
  eq colorsOver('#0e0e0e'), colorsOver('#0e0e0e'), 'one palette per background'
  eq [opaque(DARK.body), opaque(LIGHT.body), opaque('#ffffff1a')], ['#080808', '#f6f6ef', '#1a1a1a']

# ---------------------------------------------------------------------
# The app
# ---------------------------------------------------------------------

# The app over `fake`, mounted at 100 by 30 with the mouse on, the real
# retry policy with no waits, a temp store, a browser that records what
# it was asked to open, and a clock the test moves; `body` gets the
# mount, the fake and those hands, and the mount is closed and the
# store removed after it. The first frame is drawn and the fake settled
# before `body` runs, unless `raw`.
reader! =! (fake, body, options = {}) ->
  api = Api.new { getJson: retrying(fake.transport().getJson, options.delays ?? [0, 0], (-> Promise.resolve())) }
  dir = mkdtempSync join(tmpdir(), 'rip-hn-')
  options.seed? dir
  store = Store.new dir
  opened = []
  clockAt = { now: NOW * 1000 }
  view = mount App, cols: 100, rows: 30, mouse: 'all', props: { api, store, open: ((url) -> opened.push url), now: (-> clockAt.now), origin: (-> { x: 0, y: 0 }) }
  try
    unless options.raw
      view.frame()
      settle! fake
      view.frame()
    body! { view, fake, store, dir, opened, clockAt, app: view.app }
  finally
    view.close()
    rmSync dir, { recursive: true, force: true }

# A frame's rows, each with its trailing blanks cut, and the same with
# its styles in the notation of test/ink/cells.rip.
lines =! (view) -> (row.trimEnd() for row in view.frame().split '\n')
styled =! (view) -> cells.styled(view.frame() and view.ansi)

# Mouse reports at a column and a row counted from zero: a press and
# its release, and one tick of the wheel.
click =! (view, col, row, button = 0) -> view.send "\x1b[<#{button};#{col + 1};#{row + 1}M\x1b[<#{button};#{col + 1};#{row + 1}m"
wheel =! (view, col, row, down = true) -> view.send "\x1b[<#{if down then 65 else 64};#{col + 1};#{row + 1}M"
hover =! (view, col, row) -> view.send "\x1b[<35;#{col + 1};#{row + 1}M"

# The story rows of a frame: the frame's rows with the scrollbar's
# column cut, since the bar's glyph is not the row's.
BAR =! /[█▀▄]$/
plain =! (row) -> row.replace(BAR, '').trimEnd()

# The head rows of a thread: those with a gutter mark.
heads =! (view) -> (plain(row) for row in lines(view) when /^ +[│▶] \S/.test row)

TABS   =! '  1 Top   2 New   3 Best   4 Ask   5 Show   6 Jobs'.padEnd(79) + '[H]istory   [S]aved'
RULE   =! '─'.repeat 100
BRAND  =! '  Y   HackerNews  · TUI'
STATUS =! ' j/k move · c/⏎ open · s save · q quit'.padEnd(93) + '? help'
DETAIL =! ' j/k move · space collapse · ⏎ links · h/esc back'.padEnd(93) + '? help'

console.log "\nhn: the list"

test! "the list at 100 by 30: the brand row, the tabs, the rules, the story rows with their ranks running on from 1, the status hints, and the selected row's colors", ->
  reader! Fake.new(), ({ view }) ->
    frame = lines view
    eq frame[1], BRAND
    eq frame[3], TABS
    eq frame[4], RULE
    eq plain(frame[5]), '   1. Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
    eq plain(frame[6]), '      ▲ 312  by shreeve  3h ago  | 8 comments'
    eq plain(frame[9]), '   3. The unreasonable effectiveness of flexbox in a terminal (example.com)'
    eq plain(frame[10]), '      ▲ 1204  by alice  45m ago  | 0 comments'
    eq plain(frame[12]), '      ▲ 97  by bob  1d ago  | 1 comment', 'one comment is singular'
    eq frame[28], RULE
    eq frame[29], STATUS
    eq frame.length, 30
    ranks = (Number(m[1]) for row in frame when m = /^ +(\d+)\. /.exec row)
    eq ranks, [1..12], 'the null story is dropped and the ranks close up'
    look = styled view
    ok look[3].includes('«on #ff6600» «#000000 on #ff6600»1«on #ff6600» «#000000 on #ff6600»Top«on #ff6600» '), "the active tab: #{look[3]}"
    ok look[5].includes('«#ff6600 on #212121»1.«on #212121» «#ffffff on #212121 bold»Show'), "the selected row's rank and title on the highlight: #{look[5]}"
    ok look[7].includes('«#666666 on #080808»2.«on #080808» «#dddddd on #080808»Ask'), "an unselected row: #{look[7]}"
    ok look[5].endsWith('«#555555 on #1a1a1a»█'), "the scrollbar's thumb on its track: #{look[5].slice -40}"

test! "the cursor moves by j and k, stops at both ends, and G jumps to the last story, which is scrolled into view at the bottom edge", ->
  reader! Fake.new(), ({ view, app }) ->
    view.press 'k'
    eq app.listCursor.value, 0
    view.press 'j'
    look = styled view
    ok look[7].includes('on #212121') and not look[5].includes('on #212121'), 'the highlight moved to rank 2'
    view.press 'j' for n in [1..40]
    eq app.listCursor.value, 28, 'the cursor stops at the last story'
    view.press 'k'
    view.press 'G'
    eq app.listCursor.value, 28
    frame = lines view
    eq plain(frame[26]), '  29. Generated story 32 (example.com)', "the last story's title is at the bottom edge"
    eq plain(frame[27]), '      ▲ 32  by user1032  1d ago  | 0 comments'

test! "gg goes to the top when the two presses are within 500 ms, and not when they are not", ->
  reader! Fake.new(), ({ view, app, clockAt }) ->
    view.press 'G'
    view.press 'g'
    clockAt.now += 600
    view.press 'g'
    eq app.listCursor.value, 28, 'too slow'
    clockAt.now += 100
    view.press 'g'
    eq app.listCursor.value, 0

test! "Ctrl-d, Ctrl-u, PageDown and PageUp move by a page of eleven stories, and the cursor's row stays in view with the least scroll", ->
  reader! Fake.new(), ({ view, app }) ->
    view.press 'd', ctrl: true
    eq app.listCursor.value, 11
    frame = lines view
    eq plain(frame[26]), '  12. Generated story 15 (example.com)', 'the twelfth story lands at the bottom edge'
    view.press 'u', ctrl: true
    eq app.listCursor.value, 0
    eq plain(lines(view)[5]), '   1. Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
    view.press 'PageDown'
    eq app.listCursor.value, 11
    view.press 'PageUp'
    eq app.listCursor.value, 0

test! "the tabs: l and h cycle through top new best ask show job history saved and wrap, Tab and Shift-Tab do the same with the default kept from the root, 1 to 6 jump, and every switch resets the cursor", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    view.press 'j'
    view.press 'l'
    settle! fake
    eq app.category.value, 'new'
    eq app.listCursor.value, 0
    frame = lines view
    ok styled(view)[3].includes('«on #ff6600» «#000000 on #ff6600»2«on #ff6600» «#000000 on #ff6600»New«on #ff6600» '), 'New is the active tab'
    eq plain(frame[5]), '   1. Generated story 44 (example.com)'
    view.press 'h'
    view.press 'h'
    eq app.category.value, 'saved'
    view.press 'h'
    eq app.category.value, 'history'
    view.press 'Tab'
    eq app.category.value, 'saved'
    eq view.focused?.tagName, 'div', 'focus stays on the root'
    view.press 'Tab', shift: true
    eq app.category.value, 'history'
    view.press '4'
    settle! fake
    eq app.category.value, 'ask'
    frame = lines view
    eq plain(frame[5]), '   1. Ask HN: What are you reading this fall?'
    eq frame[7], ''
    view.press 'Enter'
    settle! fake
    view.press 'S'
    eq [app.category.value, app.view.value.kind], ['saved', 'list']
    view.press 'H'
    eq app.category.value, 'history'

console.log "\nhn: the thread"

test! "Enter and c open the story's thread: the header loses its tabs, the story strip shows its title, meta and url, the status hints change, and the story is in history.json", ->
  for key in ['Enter', 'c']
    reader! Fake.new(), ({ view, app, fake, dir }) ->
      view.press key
      settle! fake
      frame = lines view
      eq frame[1], BRAND
      eq frame[2], RULE
      eq frame[4], ' Show HN: A Hacker News reader for the terminal, in 900 lines'
      eq frame[5], ' ▲ 312 by shreeve  3h ago  | 8 comments  · github.com'
      eq frame[6], ' https://github.com/shreeve/rip/tree/main/packages/tui/examples/hn'
      eq frame[8], RULE
      eq frame[29], DETAIL
      eq (entry.id for entry in JSON.parse readFileSync(join(dir, 'history.json'), 'utf8')), [1001]

test! "the thread's rows in reading order with their depths and gutter colors; the dead, deleted and null replies are left out; a body keeps its paragraphs and its code", ->
  reader! Fake.new(), ({ view, fake }) ->
    view.press 'Enter'
    settle! fake
    view.resize 100, 40
    eq heads(view), [' ▶ alice · 2h ago', '   │ bob · 1h ago', '     │ carol · 30m ago', ' │ frank · 1h ago', '   │ gina · 10m ago']
    look = styled view
    ok look[11].includes('«#ff6600 on #212121»▶'), "depth 0 in the first gutter color, on the highlight: #{look[11]}"
    ok look[15].includes('«#ffaa44 on #080808»│'), "depth 1: #{look[15]}"
    ok look[20].includes('«#ffd58a on #080808»│'), "depth 2: #{look[20]}"
    frame = lines view
    eq frame[16], '   Agreed. Rust & Rip both "just work".'
    eq frame[17], ''
    eq frame[18], '   Second paragraph.'
    eq frame[21], '     Deep reply with emphasis and `code`.'
    text = frame.join '\n'
    ok not text.includes('spam') and not text.includes('buy now'), 'the dead reply is gone'

test! "space collapses the comment under the cursor with the count of the replies it hides, and again expands it; a leaf collapses to 0 replies", ->
  reader! Fake.new(), ({ view, fake }) ->
    view.press 'Enter'
    settle! fake
    view.resize 100, 40
    view.press ' '
    eq heads(view), [' ▶ alice · 2h ago · [+] 2 replies', ' │ frank · 1h ago', '   │ gina · 10m ago']
    ok not lines(view).some((row) -> row.includes 'Nice. Compare'), 'the body is hidden too'
    view.press ' '
    eq heads(view).length, 5
    view.press 'j'
    view.press ' '
    eq heads(view)[1], '   ▶ bob · 1h ago · [+] 1 reply'
    view.press ' '
    view.press 'j'
    view.press ' '
    eq heads(view)[2], '     ▶ carol · 30m ago · [+] 0 replies'

# The bar hides on the frame that takes the rows out; the framework
# flushes that box read after the layout pass, not inside it.
test! "a thread taller than the pane has a scrollbar, and collapsing it until it fits hides the bar on that frame", ->
  reader! Fake.new(), ({ view, fake }) ->
    view.press 'Enter'
    settle! fake
    ok lines(view)[11].endsWith('█'), 'the thread does not fit: a bar'
    view.press ' '
    frame = lines view
    eq heads(view)[0], ' ▶ alice · 2h ago · [+] 2 replies'
    ok not frame.some((row) -> BAR.test row), "it fits: no bar\n#{frame.join '\n'}"

test! "G, gg and the half page in the thread: a page is a quarter of the pane's rows, and the cursor's comment stays in view", ->
  reader! Fake.new(), ({ view, app, fake, clockAt }) ->
    view.press 'Enter'
    settle! fake
    view.press 'G'
    eq app.detailCursor.value, 4
    ok heads(view).includes('   ▶ gina · 10m ago'), 'gina is selected and in view'
    view.press 'g'
    clockAt.now += 100
    view.press 'g'
    eq app.detailCursor.value, 0
    eq heads(view)[0], ' ▶ alice · 2h ago'
    view.press 'd', ctrl: true
    eq app.detailCursor.value, Math.min(4, Math.floor(19 / 4)), 'a quarter of the 19-row pane'
    view.press 'u', ctrl: true
    eq app.detailCursor.value, 0

test! "replies load to depth 8, so a chain of eleven is nine rows, and the gutter colors cycle every six", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    view.press 'j' for n in [1..8]
    view.press 'Enter'
    settle! fake
    view.resize 100, 40
    eq app.view.value.story.id, 1012
    found = heads view
    eq found.length, 9
    eq found[8], '                 │ deep8 · 1h ago'
    look = styled(view).filter (row) -> row.includes 'deep6'
    ok look[0].includes('«#ff6600 on #080808»│'), "depth 6 is the first color again: #{look[0]}"

console.log "\nhn: links"

test! "Enter on a comment lists its links in a popup titled by their count: j, k, g and G move, o opens the link in the browser, and Escape or Backspace closes it", ->
  reader! Fake.new(), ({ view, app, fake, opened }) ->
    view.press 'Enter'
    settle! fake
    view.press 'Enter'
    frame = lines view
    ok frame.some((row) -> row.includes '╭─ Links (2) ─'), 'the title in the border'
    ok frame.some((row) -> row.indexOf('▶ 1. the reading thread') is 19), 'the cursor row, indented inside the panel'
    ok frame.some((row) -> row.indexOf('https://news.ycombinator.com/item?id=1002') is 23), 'its url under it'
    ok frame.some((row) -> row.indexOf('2. the docs') is 21)
    ok frame.some((row) -> row.includes 'j/k move · ⏎ open · o browser · esc close')
    view.press 'j'
    eq app.linkAt.value, 1
    ok lines(view).some((row) -> row.includes '▶ 2. the docs')
    view.press 'g'
    eq app.linkAt.value, 0
    view.press 'G'
    eq app.linkAt.value, 1
    view.press 'o'
    eq opened, ['https://example.com/docs']
    ok app.links.value?, 'an external open keeps the popup'
    view.press 'Escape'
    eq app.links.value, null
    view.press 'Enter'
    ok app.links.value?, 'opened again'
    view.press 'Backspace'
    eq app.links.value, null, 'Backspace closes it too'
    eq app.view.value.kind, 'detail', 'and goes no further back'

test! "a link into a comment resolves to its story and lands the cursor on it with ↩ 1; h goes back to the thread as it was left, and Escape from there to the list", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    view.press 'Enter'
    settle! fake
    view.press 'j' for n in [1..3]
    view.press 'Enter'
    view.press 'Enter'
    settle! fake
    eq app.view.value.story.id, 1002
    frame = lines view
    ok frame[1].endsWith('↩ 1'), frame[1]
    eq frame[1].length, 99
    ok heads(view).includes('   ▶ hank · 3h ago'), "the linked comment is selected: #{heads(view).join ' / '}"
    view.press 'h'
    settle! fake
    eq [app.view.value.story.id, app.detailCursor.value, app.stack.value.length], [1001, 3, 0]
    ok not lines(view)[1].includes('↩')
    view.press 'Escape'
    eq app.view.value.kind, 'list'

test! "an anchor link into the same story pushes a new thread with the cursor on the anchored comment, and the focus is spent: gg then space keep the cursor where it is; an anchor to no comment leaves it at the top", ->
  reader! Fake.new(), ({ view, app, fake, clockAt }) ->
    view.press 'Enter'
    settle! fake
    view.press 'j' for n in [1..3]
    view.press 'Enter'
    view.press 'G'
    view.press 'Enter'
    settle! fake
    eq [app.view.value.story.id, app.stack.value.length], [1001, 1]
    ok heads(view).includes('   ▶ gina · 10m ago')
    ok lines(view)[1].endsWith('↩ 1')
    eq app.pendingFocus.value, null, 'the thread was in, so the focus was applied at once'
    view.press 'g'
    clockAt.now += 100
    view.press 'g'
    eq app.detailCursor.value, 0
    view.press ' '
    eq app.detailCursor.value, 0, 'collapsing alice does not drag the cursor back to gina'
    eq heads(view)[0], ' ▶ alice · 2h ago · [+] 2 replies'
    app.links.value = [{ text: 'gone', url: 'https://news.ycombinator.com/item?id=1001#9999' }]
    app.linkAt.value = 0
    view.press 'Enter'
    settle! fake
    eq [app.view.value.story.id, app.stack.value.length, app.detailCursor.value, app.pendingFocus.value], [1001, 2, 0, null]

test! "a link to nothing viewable is the not-found view, where r asks nothing", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    view.press 'Enter'
    settle! fake
    view.press 'j' for n in [1..3]
    view.press 'Enter'
    view.press 'j'
    view.press 'Enter'
    settle! fake
    frame = lines view
    eq frame[12], ' '.repeat(45) + '¯\\_(ツ)_/¯'
    eq frame[14], ' '.repeat(43) + 'Post not found'
    eq frame[16], ' '.repeat(18) + "This link points to a post that doesn't exist (or was deleted)."
    eq frame[18], ' '.repeat(43) + 'esc to go back'
    eq frame[29], ' h/esc go back · q quit'.padEnd(93) + '? help'
    was = fake.log.length
    view.press 'r'
    settle! fake
    eq fake.log.length, was
    view.press 'Escape'
    eq [app.view.value.kind, app.view.value.story.id], ['detail', 1001]

test! "a link whose story fails to load is an error view with the error's copy, and r retries it in place: the retry replaces the error, and h then goes back to the thread", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    fake.fail 'item/1003.json', 503, 503, 503
    view.press 'Enter'
    settle! fake
    view.press 'j' for n in [1..3]
    view.press 'Enter'
    view.press 'j'
    view.press 'j'
    view.press 'Enter'
    settle! fake
    frame = lines view
    eq frame[12], ' '.repeat(47) + '(×_×)'
    eq frame[14], ' '.repeat(38) + "Couldn't open that post"
    eq frame[16], ' '.repeat(35) + 'Hacker News returned HTTP 503.'
    eq frame[18], ' '.repeat(36) + 'r to retry · esc to go back'
    eq frame[29], ' r retry · h/esc go back · q quit'.padEnd(93) + '? help'
    view.press 'r'
    settle! fake
    eq [app.view.value.kind, app.view.value.story.id, app.stack.value.length], ['detail', 1003, 1]
    view.press 'h'
    eq [app.view.value.story.id, app.stack.value.length], [1001, 0]

test! "Escape while a link resolves cancels it: the spinner goes, the thread stays, and the answer that comes later opens nothing", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    view.press 'Enter'
    settle! fake
    view.press 'j' for n in [1..3]
    gate = fake.hold 'item/2102.json'
    view.press 'Enter'
    settle! fake
    view.press 'Enter'
    eq app.resolving.value, true
    ok /^ [■⬝]{8} j\/k move/.test(lines(view)[29]), 'the status bar spins'
    view.press 'Escape'
    eq app.resolving.value, false
    ok /^ j\/k move/.test(lines(view)[29])
    gate.release()
    settle! fake
    eq app.view.value.story.id, 1001

test! "the popup prefetches its internal links into the cache, four at a time, so Enter on one is instant; moving the cursor restarts nothing, and closing the popup stops the hops", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    view.press 'Enter'
    settle! fake
    view.press 'j' for n in [1..3]
    view.press 'Enter'
    settle! fake
    eq (fake.requests(path) for path in ['item/2102.json', 'item/2101.json', 'item/1002.json']), [1, 1, 1], 'the walk ran'
    view.press 'j'
    view.press 'k'
    settle! fake
    eq (fake.requests(path) for path in ['item/2102.json', 'item/2101.json', 'item/1002.json']), [1, 1, 1]
    was = fake.log.length
    view.press 'Enter'
    settle! fake
    eq [app.view.value.story.id, fake.log.length], [1002, was], 'served from the cache'
  reader! Fake.new(), ({ view, app, fake }) ->
    view.press 'Enter'
    settle! fake
    view.press 'j' for n in [1..3]
    gate = fake.hold 'item/2101.json'
    view.press 'Enter'
    settle! fake
    view.press 'Escape'
    was = fake.log.length
    gate.release()
    settle! fake
    eq fake.log.length, was, 'no hop after the held one'

console.log "\nhn: the mouse"

test! "a right press opens the context menu at the press, kept on the screen and off its last row, with the item under the pointer selected; k and Enter take an item, Escape and a press outside close it, a press on its frame does not, and the save label follows the file", ->
  reader! Fake.new(), ({ view, app, opened }) ->
    click view, 95, 26, 2
    eq app.listCursor.value, 10, 'the press selects rank 11 first'
    frame = lines view
    eq (frame[n].slice(77) for n in [24..28]), ['┌─────────────────────┐', '│ ☆ Save              │', '│ Open URL in browser │', '│ Open comments       │', '└─────────────────────┘']
    eq app.menu.value.cursor, 1, 'the pointer rests on the second item'
    ok styled(view)[26].includes('«#000000 on #aaaaaa»Open'), "the cursor item in the hover colors: #{styled(view)[26].slice -120}"
    ok styled(view)[25].includes('«#ffffff on #1a1a1a»☆'), "the others in the menu's own: #{styled(view)[25].slice -120}"
    view.press 'k'
    view.press 'j'
    view.press 'Enter'
    eq opened, ['https://example.com/1014']
    eq app.menu.value, null
    ok styled(view)[25].includes('«#666666 on #212121»11.'), "the row is visited: #{styled(view)[25]}"
    click view, 2, 5, 2
    frame = lines view
    eq frame[5].slice(2, 25), '┌─────────────────────┐', 'a press near the corner places the menu at the press'
    view.press 'Escape'
    eq app.menu.value, null
    click view, 2, 5, 2
    view.frame()
    click view, 60, 20
    eq app.menu.value, null, 'a press outside closes it'
    click view, 2, 5, 2
    view.frame()
    click view, 10, 5
    ok app.menu.value?, 'a press on the top border keeps it open'
    click view, 24, 7
    ok app.menu.value?, 'and one on the right border'
    view.press 'Escape'
    eq app.menu.value, null
    click view, 2, 5, 2
    view.frame()
    view.press 'Enter'
    eq app.savedIds.value.has(1001), true
    click view, 2, 5, 2
    eq lines(view)[6].slice(2, 25), '│ ★ Unsave            │'
    hover view, 10, 8
    eq app.menu.value.cursor, 2, 'the pointer over an item selects it'

test! "a key goes to the menu before the popup: with both open, Escape closes the menu and leaves the popup, and the next Escape closes the popup", ->
  reader! Fake.new(), ({ view, app }) ->
    click view, 2, 5, 2
    app.links.value = [{ text: 'a link', url: 'https://example.com/' }]
    view.press 'Escape'
    eq [app.menu.value, app.links.value?.length], [null, 1]
    view.press 'Escape'
    eq app.links.value, null

test! "a press selects a row, a press on the selected row opens it, and a second press within 400 ms opens it too; a comment's head press selects and toggles it; two body presses within 400 ms list its links", ->
  reader! Fake.new(), ({ view, app, fake, clockAt }) ->
    click view, 10, 9
    eq [app.listCursor.value, app.view.value.kind], [2, 'list']
    view.frame()
    click view, 10, 9
    eq app.view.value.story.id, 1005
    view.press 'Escape'
    view.frame()
    click view, 10, 5
    clockAt.now += 100
    view.frame()
    click view, 10, 5
    eq app.view.value.story.id, 1001, 'a double press opens an unselected row'
    settle! fake
    view.frame()
    click view, 5, 15
    eq [app.detailCursor.value, app.collapsed.value.has(2002)], [1, true]
    view.frame()
    click view, 5, 12
    clockAt.now += 500
    view.frame()
    click view, 5, 12
    eq [app.detailCursor.value, app.links.value], [0, null], 'two slow presses only select'
    clockAt.now += 100
    view.frame()
    click view, 5, 12
    eq app.links.value?.length, 2, 'a quick second press lists the links'

test! "the wheel scrolls the list a row a tick without moving the cursor, clamps at the top, and a cursor move then reveals the cursor's row", ->
  reader! Fake.new(), ({ view, app }) ->
    wheel view, 10, 10
    wheel view, 10, 10
    wheel view, 10, 10
    frame = lines view
    eq plain(frame[5]), '      ▲ 88  by reader42  5h ago  | 2 comments', "three rows up: the byline of rank 2 is the first row"
    eq [app.listCursor.value, app.listTop.value], [0, 3]
    view.press 'j'
    eq app.listCursor.value, 1
    eq plain(lines(view)[5]), '   2. Ask HN: What are you reading this fall?', "the cursor's row is aligned to the top"
    wheel view, 10, 10, false for n in [1..5]
    eq app.listTop.value, 0

console.log "\nhn: the theme, the help, the files"

test! "t toggles the theme, and the wipe sweeps it in from the origin: the frame a beat later shows the new theme at the origin, a glow band on the accent, and the old frame beyond, and after half a second the wipe is gone and a frame costs what it did", ->
  reader! Fake.new(), ({ view, app }) ->
    ok styled(view)[1].includes('«#000000 on #ff6600 bold»Y'), 'dark to begin with'
    view.press 't'
    eq app.theme.value.name, 'light'
    view.tick 16
    look = styled view
    ok look[1].startsWith('«on #ff6600» «on #ffffff» «#000000 on #ffffff bold»Y'), "the light tile at the origin: #{look[1]}"
    ok look[1].includes('«#000000 on #ff6600 bold»H'), "the glow band: #{look[1]}"
    ok look[1].includes('on #0e0e0e bold»') and look[1].includes('kerNews'), "the old frame beyond the front: #{look[1]}"
    eq view.damage, 3000, 'a whole frame while the wipe runs'
    view.tick 600
    look = styled view
    eq app.wipe.value, null
    eq screen.post, null
    ok look[1].includes('«#000000 on #ffffff bold»Y') and look[1].includes('«#000000 on #ff6600 bold»HackerNews'), "light throughout: #{look[1]}"
    ok look[7].includes('on #f6f6ef'), "the light body: #{look[7]}"
    view.press 'j'
    view.frame()
    ok view.damage < 3000, 'a partial frame again'
    view.press 't'
    view.tick 600
    view.frame()
    ok styled(view)[1].includes('«#000000 on #ff6600 bold»Y'), 'dark again'

test! "? opens the help over a scrim that dims the rows beneath, with the view's groups and the keys padded to the longest; j does nothing while it is open; Escape and ? close it; the thread's help says space", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    view.press '?'
    frame = lines view
    ok frame[1].includes('╭─ Keyboard shortcuts ─'), frame[1]
    ok frame[3].includes('Navigation')
    ok frame[4].includes('  ' + 'j k  ↑ ↓'.padEnd(15) + '   move down / up'), frame[4]
    ok frame[9].includes('  ' + '1 – 6'.padEnd(15) + '   jump to category'), frame[9]
    ok frame[26].includes('esc / ? close')
    eq frame[28].slice(20, 80), '╰' + '─'.repeat(58) + '╯'
    look = styled view
    ok look[7].includes('«#676767 on #040404»Ask'), "a row under the scrim, dimmed: #{look[7].slice 0, 120}"
    view.press 'j'
    eq app.listCursor.value, 0
    view.press 'Escape'
    eq app.help.value, false
    view.press '?'
    view.press '?'
    eq app.help.value, false
    view.press 'Enter'
    settle! fake
    view.press '?'
    ok lines(view).some((row) -> row.includes '  ' + 'space'.padEnd(15) + '   collapse / expand')

test! "s saves and unsaves the story under the cursor, newest first in saved.json; S lists the saved stories in that order; with none saved the tab says so", ->
  reader! Fake.new(), ({ view, app, fake, dir, clockAt }) ->
    t1 = clockAt.now
    view.press 's'
    eq plain(lines(view)[5]), '   1. ★ Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
    ok styled(view)[5].includes('«#ff6600 on #212121»★'), 'the star in the accent'
    view.press 'j'
    clockAt.now += 60000
    t2 = clockAt.now
    view.press 's'
    eq readFileSync(join(dir, 'saved.json'), 'utf8'), JSON.stringify([{ id: 1002, savedAt: t2 }, { id: 1001, savedAt: t1 }], null, 2)
    view.press 'S'
    settle! fake
    frame = lines view
    eq plain(frame[5]), '   1. ★ Ask HN: What are you reading this fall?'
    eq plain(frame[7]), '   2. ★ Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
    ok styled(view)[3].includes('«on #ff6600» «#000000 on #ff6600»[S]aved«on #ff6600» ')
    view.press 's'
    settle! fake
    frame = lines view
    eq plain(frame[5]), '   1. ★ Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
    eq JSON.parse(readFileSync(join(dir, 'saved.json'), 'utf8')).length, 1
    view.press 's'
    settle! fake
    eq lines(view)[16], ' '.repeat(29) + "No saved posts yet. Press 's' on a story."

test! "the stories opened are in the history, newest first and dimmed; H lists them with its own hints, x clears them there and nowhere else", ->
  reader! Fake.new(), ({ view, app, fake, dir }) ->
    view.press 'Enter'
    settle! fake
    view.press 'Escape'
    view.press 'j'
    view.press 'j'
    view.press 'Enter'
    settle! fake
    view.press 'Escape'
    view.press 'x'
    eq JSON.parse(readFileSync(join(dir, 'history.json'), 'utf8')).length, 2, 'x on the top tab does nothing'
    look = styled view
    ok look[5].includes('«#666666 on #080808»Show') and look[6].includes('«#666666 on #080808»▲'), "a visited row is dim throughout: #{look[5]}"
    view.press 'H'
    settle! fake
    frame = lines view
    eq plain(frame[5]), '   1. The unreasonable effectiveness of flexbox in a terminal (example.com)'
    eq plain(frame[7]), '   2. Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
    eq frame[29], ' j/k move · c/⏎ open · x clear history · q quit'.padEnd(93) + '? help'
    view.press 'x'
    settle! fake
    eq lines(view)[16], ' '.repeat(25) + 'No history yet. Posts you open will show up here.'
    eq readFileSync(join(dir, 'history.json'), 'utf8'), '[]'

test! "the files are read as they are: a saved.json of mixed shapes lists its one good entry, and a history past the cap is cut to 1000", ->
  seed = (dir) ->
    writeFileSync join(dir, 'saved.json'), '[{"id":1001,"savedAt":1},{"id":"x"},5,null]'
    writeFileSync join(dir, 'history.json'), JSON.stringify(({ id: n, viewedAt: n } for n in [1..1005]))
  reader! Fake.new(), (({ view, app, fake }) ->
    view.press 'S'
    settle! fake
    frame = lines view
    eq plain(frame[5]), '   1. ★ Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
    eq frame[7], ''
    eq app.history.value.length, 1000), { seed }

console.log "\nhn: loading, failing and cancelled requests"

test! "while the feed loads the list is a centered loader with its message and the status bar spins; released, the list is shown; a thread loads the same way", ->
  fake = Fake.new()
  gate = fake.hold 'topstories.json'
  reader! fake, (({ view, app }) ->
    view.frame()
    settle! fake
    frame = lines view
    eq frame[15], ' '.repeat(46) + '■⬝⬝⬝⬝⬝⬝⬝'
    eq frame[17], ' '.repeat(42) + 'Loading stories…'
    ok /^ [■⬝]{8} j\/k move · c\/⏎ open · s save · q quit/.test(frame[29]), frame[29]
    gate.release()
    settle! fake
    eq plain(lines(view)[5]), '   1. Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
    held = fake.hold 'item/2001.json'
    view.press 'Enter'
    settle! fake
    frame = lines view
    eq frame[10], ' ■⬝⬝⬝⬝⬝⬝⬝ Loading comments…'
    ok /^ [■⬝]{8} j\/k move · space/.test(frame[29])
    held.release()
    settle! fake
    eq heads(view)[0], ' ▶ alice · 2h ago'), { raw: true }

test! "a feed that answers 500 once is asked again and shown", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    fake.fail 'beststories.json', 500
    view.press '3'
    settle! fake
    eq plain(lines(view)[5]), '   1. Bun 1.4 released (bun.sh)'
    eq fake.requests('beststories.json'), 2

test! "a feed that answers 404 is not asked again: the error view with its copy and hints, and r asks once more and recovers", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    fake.fail 'jobstories.json', 404
    view.press '6'
    settle! fake
    frame = lines view
    eq frame[13], ' '.repeat(47) + '(×_×)'
    eq frame[15], ' '.repeat(39) + "Couldn't load stories"
    eq frame[17], ' '.repeat(35) + 'Hacker News returned HTTP 404.'
    eq frame[19], ' '.repeat(45) + 'r to retry'
    eq frame[29], ' r retry · q quit'.padEnd(93) + '? help'
    eq fake.requests('jobstories.json'), 1
    view.press 'r'
    settle! fake
    eq plain(lines(view)[5]), '   1. Acme (YC S21) is hiring a terminal engineer (acme.example)'
    eq fake.requests('jobstories.json'), 2

test! "a feed left for another is aborted, and a transport that ignores the abort still lands nothing: the stale answer never shows", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    gate = fake.hold 'newstories.json'
    view.press '2'
    settle! fake
    view.press '1'
    settle! fake
    ok fake.log.includes('abort newstories.json'), fake.log.join ', '
    eq plain(lines(view)[5]), '   1. Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
  reader! Fake.new(deaf: true), ({ view, app, fake }) ->
    gate = fake.hold 'newstories.json'
    view.press '2'
    settle! fake
    view.press '1'
    settle! fake
    gate.release()
    settle! fake
    eq app.category.value, 'top'
    eq plain(lines(view)[5]), '   1. Show HN: A Hacker News reader for the terminal, in 900 lines (github.com)'
    ok not lines(view).some((row) -> row.includes 'Generated story 44'), 'the stale feed never landed'

test! "a thread whose replies all fail says so with r, r loads them again since the failure was evicted, and r on a loaded thread asks nothing", ->
  reader! Fake.new(), ({ view, app, fake }) ->
    fake.fail 'item/2201.json', 'network', 'network', 'network'
    view.press 'j' for n in [1..3]
    view.press 'Enter'
    settle! fake
    eq app.view.value.story.id, 1006
    eq lines(view)[10], " Couldn't load comments — press r to retry."
    view.press 'r'
    settle! fake
    eq heads(view), [' ▶ ivy · 20h ago']
    was = fake.log.length
    view.press 'r'
    settle! fake
    eq fake.log.length, was

test! "o and y open the story's url and its HN page in the browser: from the list they mark the story viewed, from the thread they do not, and s from the thread stars the title", ->
  reader! Fake.new(), ({ view, app, fake, opened }) ->
    view.press 'o'
    eq opened, ['https://github.com/shreeve/rip/tree/main/packages/tui/examples/hn']
    ok styled(view)[5].includes('«#666666 on #212121 bold»Show'), "visited: #{styled(view)[5]}"
    view.press 'y'
    eq opened[1], 'https://news.ycombinator.com/item?id=1001'
    view.press 'j'
    view.press 'Enter'
    settle! fake
    view.press 'o'
    view.press 'y'
    eq opened.slice(2), ['https://news.ycombinator.com/item?id=1002']
    eq app.history.value.length, 2
    view.press 's'
    eq lines(view)[4], ' ★ Ask HN: What are you reading this fall?'

test! "q quits, with an overlay open too, and so does Ctrl-C", ->
  for keys in [['q'], ['Enter', '?', 'q']]
    reader! Fake.new(), ({ view, fake }) ->
      view.press key for key in keys
      eq (await view.done), undefined
      eq typeof document, 'undefined'
  reader! Fake.new(), ({ view }) ->
    view.press 'c', ctrl: true
    eq (await view.done), undefined
    eq typeof document, 'undefined'
  return
