# Ink's test/flex-align-content.tsx, ported.
#
# Each test keeps Ink's title and draws Ink's tree, prop for prop.
# SOURCE.md says where each expected frame comes from and which of
# Ink's cases are left out.
#
#   rip test/ink/flex-align-content.rip

import { test, eq } from 'rip/testing'
import { Box, Text, plain, tall } from './harness.rip'

console.log "\nFlex Align Content"

test "align content flex-start", ->
  App = component
    render
      Box width: 2, height: 6, flexWrap: 'wrap', alignContent: 'flex-start'
        Text "A"
        Text "B"
        Text "C"
        Text "D"
  eq plain(App), [
    "AB"
    "CD"
  ]
  eq tall(App), 6

test "align content center", ->
  App = component
    render
      Box width: 2, height: 6, flexWrap: 'wrap', alignContent: 'center'
        Text "A"
        Text "B"
        Text "C"
        Text "D"
  eq plain(App), [
    ""
    ""
    "AB"
    "CD"
  ]
  eq tall(App), 6

