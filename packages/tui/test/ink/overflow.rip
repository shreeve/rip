  ]

test "overflow - box intersecting with bottom right edge of overflow container", ->
  App = component
    render
      Box width: 4, height: 4, overflow: 'hidden'
        Box marginTop: 2, marginLeft: 2, width: 4, height: 4, flexShrink: 0
          Text
            "AAAA"
            "\n"
            "BBBB"
            "\n"
            "CCCC"
            "\n"
            "DDDD"
  eq plain(App), [
    ""
    ""
    "  AA"
    "  BB"
  ]

test "nested overflow", ->
  App = component
    render
      Box paddingBottom: 1
        Box width: 4, height: 4, overflow: 'hidden', flexDirection: 'column'
          Box width: 2, height: 2, overflow: 'hidden'
            Box width: 4, height: 4, flexShrink: 0
              Text
                "AAAA"
                "\n"
                "BBBB"
                "\n"
                "CCCC"
                "\n"
                "DDDD"
          Box width: 4, height: 3
            Text
              "XXXX"
              "\n"
              "YYYY"
              "\n"
              "ZZZZ"
  eq plain(App), [
    "AA"
    "BB"
    "XXXX"
    "YYYY"
  ]
  eq tall(App), 5

# The box is 12 columns wide on a 10-column terminal. Published Ink
# writes past the terminal's edge (its top and bottom rows come out 12
# wide, and the rows between lose a column from the middle); what it
# draws inside the 10 columns is the frame here.
test "out of bounds writes do not crash", ->
  App = component
    render
      Box width: 12, height: 10, borderStyle: 'round'
  eq plain(App, 10), [
    "╭─────────"
    "│"
    "│"
    "│"
    "│"
    "│"
    "│"
    "│"
    "│"
    "╰─────────"
  ]
