# Ink's test/overflow.tsx, ported.
#
# Each test keeps Ink's title and draws Ink's tree, prop for prop.
# SOURCE.md says where each expected frame comes from and which of
# Ink's cases are left out.
#
#   rip test/ink/overflow.rip

import { test, eq } from 'rip/testing'
import { Box, Text, plain, tall } from './harness.rip'

console.log "\nOverflow"

test "overflowX - single text node in a box inside overflow container", ->
  App = component
    render
      Box width: 6, overflowX: 'hidden'
        Box width: 16, flexShrink: 0
          Text "Hello World"
  eq plain(App), ["Hello"]

test "overflowX - single text node in a zero-width overflow container", ->
  App = component
    render
      Box
        Box width: 0, overflowX: 'hidden'
          Text "hello"
        Text "|"
  # Ink's test asks for this frame; published Ink 7.1.1 draws "|\n\n\n\n"
  eq plain(App), ["|"]

test "overflowX - single text node inside overflow container with border", ->
  App = component
    render
      Box width: 6, overflowX: 'hidden', borderStyle: 'round'
        Box width: 16, flexShrink: 0
          Text "Hello World"
  eq plain(App), [
    "╭────╮"
    "│Hell│"
    "╰────╯"
  ]

test "overflowX - single text node in a box with border inside overflow container", ->
  App = component
    render
      Box width: 6, overflowX: 'hidden'
        Box width: 16, flexShrink: 0, borderStyle: 'round'
          Text "Hello World"
  eq plain(App), [
    "╭─────"
    "│Hello"
    "╰─────"
  ]

test "overflowX - multiple text nodes in a box inside overflow container", ->
  App = component
    render
      Box width: 6, overflowX: 'hidden'
        Box width: 12, flexShrink: 0
          Text "Hello "
          Text "World"
  eq plain(App), ["Hello"]

test "overflowX - multiple text nodes in a box inside overflow container with border", ->
