test "overflowX visible overrides overflow hidden while preserving vertical clipping", ->
  App = component
    render
      Box width: 6, height: 2
        Box width: 3, height: 1, overflow: 'hidden', overflowX: 'visible'
          Box width: 6, height: 2, flexShrink: 0
            Text "ABCDEF\nGHIJKL"
  # Ink's test asks for this frame; published Ink 7.1.1 draws "ABC\n"
  eq plain(App), ["ABCDEF"]
  eq tall(App), 2

test "overflowY visible overrides overflow hidden while preserving horizontal clipping", ->
  App = component
    render
      Box width: 6, height: 2
        Box width: 3, height: 1, overflow: 'hidden', overflowY: 'visible'
          Box width: 6, height: 2, flexShrink: 0
            Text "ABCDEF\nGHIJKL"
  # Ink's test asks for this frame; published Ink 7.1.1 draws "ABC\n"
  eq plain(App), [
    "ABC"
    "GHI"
  ]

test "overflow - single text node inside overflow container", ->
  App = component
    render
      Box paddingBottom: 1
        Box width: 6, height: 1, overflow: 'hidden'
          Box width: 12, height: 2, flexShrink: 0
            Text
              "Hello"
              "\n"
              "World"
  eq plain(App), ["Hello"]
  eq tall(App), 2

test "overflow - single text node inside overflow container with border", ->
  App = component
    render
      Box paddingBottom: 1
        Box width: 8, height: 3, overflow: 'hidden', borderStyle: 'round'
          Box width: 12, height: 2, flexShrink: 0
            Text
              "Hello"
              "\n"
              "World"
  eq plain(App), [
    "╭──────╮"
    "│Hello │"
    "╰──────╯"
  ]
  eq tall(App), 4

test "overflow - multiple boxes inside overflow container", ->
  App = component
    render
      Box paddingBottom: 1
        Box width: 4, height: 1, overflow: 'hidden'
          Box width: 2, height: 2, flexShrink: 0
            Text
              "TL"
              "\n"
              "BL"
          Box width: 2, height: 2, flexShrink: 0
            Text
              "TR"
              "\n"
              "BR"
  eq plain(App), ["TLTR"]
  eq tall(App), 2

test "overflow - multiple boxes inside overflow container with border", ->
  App = component
    render
      Box paddingBottom: 1
        Box width: 6, height: 3, overflow: 'hidden', borderStyle: 'round'
          Box width: 2, height: 2, flexShrink: 0
            Text
              "TL"
              "\n"
              "BL"
          Box width: 2, height: 2, flexShrink: 0
            Text
              "TR"
              "\n"
              "BR"
  eq plain(App), [
    "╭────╮"
    "│TLTR│"
    "╰────╯"
  ]
  eq tall(App), 4

test "overflow - box intersecting with top left edge of overflow container", ->
  App = component
    render
      Box width: 4, height: 4, overflow: 'hidden'
        Box marginTop: -2, marginLeft: -2, width: 4, height: 4, flexShrink: 0
          Text
            "AAAA"
            "\n"
            "BBBB"
            "\n"
            "CCCC"
            "\n"
            "DDDD"
  eq plain(App), [
    "CC"
    "DD"
  ]
  eq tall(App), 4

test "overflow - box intersecting with top right edge of overflow container", ->
  App = component
