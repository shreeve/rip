# Ink's test/components.tsx, ported.
#
# Each test keeps Ink's title and draws Ink's tree, prop for prop.
# SOURCE.md says where each expected frame comes from and which of
# Ink's cases are left out.
#
#   rip test/ink/components.rip

import { test, eq } from 'rip/testing'
import { Box, Text, Spacer, plain, styled } from './harness.rip'

console.log "\nComponents"

test "text", ->
  App = component
    render
      Text "Hello World"
  eq plain(App), ["Hello World"]

test "text with variable", ->
  App = component
    render
      Text
        "Count: "
        "1"
  eq plain(App), ["Count: 1"]

test "multiple text nodes", ->
  App = component
    render
      Text
        "Hello"
        " World"
  eq plain(App), ["Hello World"]

test "text with component", ->
  App = component
    render
      Text
        "Hello "
        Text "World"
  eq plain(App), ["Hello World"]

test "text with fragment", ->
  App = component
    render
      Text
        "Hello "
        "World"
        " "
  eq plain(App), ["Hello World"]

test "wrap text", ->
  App = component
    render
      Box width: 7
        Text wrap: 'wrap'
          "Hello World"
  eq plain(App), [
    "Hello"
    "World"
  ]

test "don’t wrap text if there is enough space", ->
  App = component
    render
      Box width: 20
        Text wrap: 'wrap'
          "Hello World"
  eq plain(App), ["Hello World"]

test "hard wrap text", ->
  App = component
    render
      Box width: 7
        Text wrap: 'hard'
          "Hello World"
  eq plain(App), [
    "Hello W"
    "orld"
  ]

test "hard wrap with long word", ->
  App = component
    render
      Box width: 5
        Text wrap: 'hard'
          "aaaaaaaaaa"
  eq plain(App), [
    "aaaaa"
    "aaaaa"
  ]

test "don’t hard wrap text if there is enough space", ->
  App = component
    render
      Box width: 20
        Text wrap: 'hard'
          "Hello World"
  eq plain(App), ["Hello World"]

test "truncate text in the end", ->
  App = component
    render
      Box width: 7
        Text wrap: 'truncate'
          "Hello World"
  eq plain(App), ["Hello …"]

test "truncate text in the middle", ->
  App = component
    render
      Box width: 7
        Text wrap: 'truncate-middle'
          "Hello World"
  eq plain(App), ["Hel…rld"]

test "truncate text in the beginning", ->
  App = component
    render
      Box width: 7
        Text wrap: 'truncate-start'
          "Hello World"
  eq plain(App), ["… World"]

test "do not wrap text with BEL-terminated OSC hyperlinks", ->
  App = component
    render
      Box width: 20
        Text wrap: 'wrap'
          "\u001b]8;;https://example.com\u0007Click here\u001b]8;;\u0007"
  # Ink's test compares the frame's text, escape sequences taken out.
  # Ink keeps the hyperlink around this text; here a hyperlink is the `link` prop, never an escape sequence in the text.
  eq plain(App), ["Click here"]

test "do not wrap text with ST-terminated OSC hyperlinks", ->
  App = component
    render
      Box width: 20
        Text wrap: 'wrap'
          "\u001b]8;;https://example.com\u001b\\Click here\u001b]8;;\u001b\\"
  # Ink's test compares the frame's text, escape sequences taken out.
  # Ink keeps the hyperlink around this text; here a hyperlink is the `link` prop, never an escape sequence in the text.
  eq plain(App), ["Click here"]

test "do not wrap text with non-hyperlink OSC sequences", ->
  App = component
    render
      Box width: 20
        Text wrap: 'wrap'
          "\u001b]0;My Title\u0007Some text"
  # Ink's test compares the frame's text, escape sequences taken out.
  eq plain(App), ["Some text"]

test "hard-wrap single-word BEL-terminated OSC hyperlink", ->
  App = component
    render
      Box width: 5
        Text wrap: 'wrap'
          "\u001b]8;;https://example.com\u0007abcdefghij\u001b]8;;\u0007"
  # Ink's test compares the frame's text, escape sequences taken out.
  # Ink keeps the hyperlink around this text; here a hyperlink is the `link` prop, never an escape sequence in the text.
  eq plain(App), ["abcde", "fghij"]

test "hard-wrap single-word ST-terminated OSC hyperlink", ->
  App = component
    render
      Box width: 5
        Text wrap: 'wrap'
          "\u001b]8;;https://example.com\u001b\\abcdefghij\u001b]8;;\u001b\\"
  # Ink's test compares the frame's text, escape sequences taken out.
  # Ink keeps the hyperlink around this text; here a hyperlink is the `link` prop, never an escape sequence in the text.
  eq plain(App), ["abcde", "fghij"]

test "ignore empty text node", ->
  App = component
    render
      Box flexDirection: 'column'
        Box
          Text "Hello World"
        Text ""
  eq plain(App), ["Hello World"]

test "render a single empty text node", ->
  App = component
    render
      Text ""
  eq plain(App), [""]

test "number", ->
  App = component
    render
      Text "1"
  eq plain(App), ["1"]

test "fragment", ->
  App = component
    render
      Text "Hello World"
  eq plain(App), ["Hello World"]

test "ensure wrap-ansi doesn’t trim leading whitespace", ->
  App = component
    render
      Text color: 'red'
        " ERROR "
  eq styled(App), [" «red»ERROR"]

test "newline", ->
  App = component
    render
      Text
        "Hello"
        "\n"
        "World"
  eq plain(App), [
    "Hello"
    "World"
  ]

test "multiple newlines", ->
  App = component
    render
      Text
        "Hello"
        "\n\n"
        "World"
  eq plain(App), [
    "Hello"
    ""
    "World"
  ]

test "horizontal spacer", ->
  App = component
    render
      Box width: 20
        Text "Left"
        Spacer
        Text "Right"
  eq plain(App), ["Left           Right"]

test "vertical spacer", ->
  App = component
    render
      Box flexDirection: 'column', height: 6
        Text "Top"
        Spacer
        Text "Bottom"
  eq plain(App), [
    "Top"
    ""
    ""
    ""
    ""
    "Bottom"
  ]

# Ink writes the hyperlink into the text with `ansiEscapes.link`; here it
# is the `link` prop. The frame reader refuses a hyperlink left open at
# the end of a row, which is what Ink's test looks for.
test "link ansi escapes are closed properly", ->
  App = component
    render
      Text link: 'https://example.com'
        "Example"
  eq styled(App), ["«link https://example.com»Example"]
