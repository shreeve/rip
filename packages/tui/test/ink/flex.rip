# Ink's test/flex.tsx, ported.
#
# Each test keeps Ink's title and draws Ink's tree, prop for prop.
# SOURCE.md says where each expected frame comes from and which of
# Ink's cases are left out.
#
#   rip test/ink/flex.rip

import { test, eq } from 'rip/testing'
import { Box, Text, plain, tall } from './harness.rip'

console.log "\nFlex"

test "grow equally", ->
  App = component
    render
      Box width: 6
        Box flexGrow: 1
          Text "A"
        Box flexGrow: 1
          Text "B"
  eq plain(App), ["A  B"]

test "grow one element", ->
  App = component
    render
      Box width: 6
        Box flexGrow: 1
          Text "A"
        Text "B"
  eq plain(App), ["A    B"]

test "do not shrink", ->
  App = component
    render
      Box width: 16
        Box flexShrink: 0, width: 6
          Text "A"
        Box flexShrink: 0, width: 6
          Text "B"
        Box width: 6
          Text "C"
  eq plain(App), ["A     B     C"]

test "shrink equally", ->
  App = component
    render
      Box width: 10
        Box flexShrink: 1, width: 6
          Text "A"
        Box flexShrink: 1, width: 6
          Text "B"
        Text "C"
  eq plain(App), ["A    B   C"]

test "set flex basis with flexDirection=\"row\" container", ->
  App = component
    render
      Box width: 6
        Box flexBasis: 3
          Text "A"
        Text "B"
  eq plain(App), ["A  B"]

test "set flex basis in percent with flexDirection=\"row\" container", ->
  App = component
    render
      Box width: 6
        Box flexBasis: '50%'
          Text "A"
        Text "B"
  eq plain(App), ["A  B"]

test "set flex basis with flexDirection=\"column\" container", ->
  App = component
    render
      Box height: 6, flexDirection: 'column'
        Box flexBasis: 3
          Text "A"
        Text "B"
  eq plain(App), [
    "A"
    ""
    ""
    "B"
  ]
  eq tall(App), 6

test "set flex basis in percent with flexDirection=\"column\" container", ->
  App = component
    render
      Box height: 6, flexDirection: 'column'
        Box flexBasis: '50%'
          Text "A"
        Text "B"
  eq plain(App), [
    "A"
    ""
    ""
    "B"
  ]
  eq tall(App), 6

