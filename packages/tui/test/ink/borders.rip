test "custom border style", ->
  App = component
    render
      Box borderStyle: { topLeft: '↘', top: '↓', topRight: '↙', left: '→', bottomLeft: '↗', bottom: '↑', bottomRight: '↖', right: '←' }
        Text "Content"
  eq plain(App), [
    "↘↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↙"
    "→Content                                                                                           ←"
    "↗↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↖"
  ]

test "dim border color", ->
  App = component
    render
      Box borderDimColor: true, borderStyle: 'round'
        Text "Content"
  eq styled(App), [
    "«dim»╭──────────────────────────────────────────────────────────────────────────────────────────────────╮"
    "«dim»│«»Content                                                                                           «dim»│"
    "«dim»╰──────────────────────────────────────────────────────────────────────────────────────────────────╯"
  ]

