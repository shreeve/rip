test "borderDimColor does not dim styled child Text touching left edge", ->
  App = component
    render
      Box borderDimColor: true, borderStyle: 'round', alignSelf: 'flex-start'
        Text bold: true, color: 'blue'
          "styled text"
  # Ink's test checks part of this frame; the whole of it is published Ink's.
  eq styled(App), [
    "«dim»╭───────────╮"
    "«dim»│«blue bold»styled«» «blue bold»text«dim»│"
    "«dim»╰───────────╯"
  ]

