# Ink's test/borders.tsx, ported.
#
# Each test keeps Ink's title and draws Ink's tree, prop for prop.
# SOURCE.md says where each expected frame comes from and which of
# Ink's cases are left out.
#
#   rip test/ink/borders.rip

import { test, eq } from 'rip/testing'
import { Box, Text, plain, styled } from './harness.rip'

console.log "\nBorders"

test "single node - full width box", ->
  App = component
    render
      Box borderStyle: 'round'
        Text "Hello World"
  eq plain(App), [
    "╭──────────────────────────────────────────────────────────────────────────────────────────────────╮"
    "│Hello World                                                                                       │"
    "╰──────────────────────────────────────────────────────────────────────────────────────────────────╯"
  ]

test "single node - full width box with colorful border", ->
  App = component
    render
      Box borderStyle: 'round', borderColor: 'green'
        Text "Hello World"
  eq styled(App), [
    "«green»╭──────────────────────────────────────────────────────────────────────────────────────────────────╮"
    "«green»│«»Hello World                                                                                       «green»│"
    "«green»╰──────────────────────────────────────────────────────────────────────────────────────────────────╯"
  ]

test "single node - fit-content box", ->
  App = component
    render
      Box borderStyle: 'round', alignSelf: 'flex-start'
        Text "Hello World"
  eq plain(App), [
    "╭───────────╮"
    "│Hello World│"
    "╰───────────╯"
  ]

test "single node - fit-content box with wide characters", ->
  App = component
    render
      Box borderStyle: 'round', alignSelf: 'flex-start'
        Text "こんにちは"
  eq plain(App), [
    "╭──────────╮"
    "│こんにちは│"
    "╰──────────╯"
  ]

