    "││🦾││"
    "│╰──╯│"
    "│╭──╮│"
    "││🌏││"
    "│╰──╯│"
    "│╭──╮│"
    "││😋││"
    "│╰──╯│"
    "╰────╯"
  ]

test "hide top border", ->
  App = component
    render
      Box flexDirection: 'column', alignItems: 'flex-start'
        Text "Above"
        Box borderStyle: 'round', borderTop: false
          Text "Content"
        Text "Below"
  eq plain(App), [
    "Above"
    "│Content│"
    "╰───────╯"
    "Below"
  ]

test "hide bottom border", ->
  App = component
    render
      Box flexDirection: 'column', alignItems: 'flex-start'
        Text "Above"
        Box borderStyle: 'round', borderBottom: false
          Text "Content"
        Text "Below"
  eq plain(App), [
    "Above"
    "╭───────╮"
    "│Content│"
    "Below"
  ]

test "hide top and bottom borders", ->
  App = component
    render
      Box flexDirection: 'column', alignItems: 'flex-start'
        Text "Above"
        Box borderStyle: 'round', borderTop: false, borderBottom: false
          Text "Content"
        Text "Below"
  eq plain(App), [
    "Above"
    "│Content│"
    "Below"
  ]

test "hide left border", ->
  App = component
    render
      Box flexDirection: 'column', alignItems: 'flex-start'
        Text "Above"
        Box borderStyle: 'round', borderLeft: false
          Text "Content"
        Text "Below"
  eq plain(App), [
    "Above"
    "───────╮"
    "Content│"
    "───────╯"
    "Below"
  ]

test "hide right border", ->
  App = component
    render
      Box flexDirection: 'column', alignItems: 'flex-start'
        Text "Above"
        Box borderStyle: 'round', borderRight: false
          Text "Content"
        Text "Below"
  eq plain(App), [
    "Above"
    "╭───────"
    "│Content"
    "╰───────"
    "Below"
  ]

test "hide left and right border", ->
  App = component
    render
      Box flexDirection: 'column', alignItems: 'flex-start'
        Text "Above"
        Box borderStyle: 'round', borderLeft: false, borderRight: false
          Text "Content"
        Text "Below"
  eq plain(App), [
    "Above"
    "───────"
    "Content"
    "───────"
    "Below"
  ]

test "hide all borders", ->
  App = component
    render
      Box flexDirection: 'column', alignItems: 'flex-start'
        Text "Above"
        Box borderStyle: 'round', borderTop: false, borderBottom: false, borderLeft: false, borderRight: false
          Text "Content"
        Text "Below"
  eq plain(App), [
    "Above"
    "Content"
    "Below"
  ]

test "change color of top border", ->
  App = component
    render
      Box flexDirection: 'column', alignItems: 'flex-start'
        Text "Above"
        Box borderStyle: 'round', borderTopColor: 'green'
          Text "Content"
        Text "Below"
  eq styled(App), [
    "Above"
    "«green»╭───────╮"
    "│Content│"
    "╰───────╯"
    "Below"
  ]

