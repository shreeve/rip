# Ink's test/position.tsx, ported.
#
# Each test keeps Ink's title and draws Ink's tree, prop for prop.
# SOURCE.md says where each expected frame comes from and which of
# Ink's cases are left out.
#
#   rip test/ink/position.rip

import { test, eq } from 'rip/testing'
import { Box, Text, plain } from './harness.rip'

console.log "\nPosition"

test "absolute position with top and left offsets", ->
  App = component
    render
      Box width: 5, height: 3
        Box position: 'absolute', top: 1, left: 2
          Text "X"
  eq plain(App), [
    ""
    "  X"
    ""
  ]

test "absolute position with bottom and right offsets", ->
  App = component
    render
      Box width: 6, height: 4
        Box position: 'absolute', bottom: 1, right: 1
          Text "X"
  eq plain(App), [
    ""
    ""
    "    X"
    ""
  ]

test "renders visible lines of text positioned above the output area", ->
  App = component
    render
      Box width: 6, height: 2
        Box position: 'absolute', top: -1
          Text "Hidden\nFirst\nSecond"
  # Ink's test asks for this frame; published Ink 7.1.1 draws "\n"
  eq plain(App), [
    "First"
    "Second"
  ]

test "absolute position with percentage offsets", ->
  App = component
    render
      Box width: 6, height: 4
        Box position: 'absolute', top: '50%', left: '50%'
          Text "X"
  eq plain(App), [
    ""
    ""
    "   X"
    ""
  ]

test "absolute position with percentage bottom and right offsets", ->
  App = component
    render
      Box width: 6, height: 4
        Box position: 'absolute', bottom: '50%', right: '50%'
          Text "X"
  eq plain(App), [
    ""
    "  X"
    ""
    ""
  ]

test "relative position offsets visual position while keeping flow", ->
  App = component
    render
      Box width: 5
        Box position: 'relative', left: 2
          Text "A"
        Text "B"
  eq plain(App), [" BA"]

test "static position ignores offsets", ->
  App = component
    render
      Box width: 5
        Box position: 'static', left: 2
          Text "A"
        Text "B"
  eq plain(App), ["AB"]

test "static position ignores percentage offsets", ->
  App = component
    render
      Box width: 5
        Box position: 'static', left: '50%'
          Text "A"
        Text "B"
  eq plain(App), ["AB"]

