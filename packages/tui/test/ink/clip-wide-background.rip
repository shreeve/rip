test "clipping wide text preserves its background (nested: true, offset: 1, width: 3)", ->
  App = component
    render
      Box width: 3, height: 1, overflowX: 'hidden', contentOffsetX: 1
        Box width: 4, flexShrink: 0
          Text
            Text backgroundColor: 'blue'
              "你好"
  # The frame is the literal Ink's test compares against: `contentOffsetX`
  # is on Ink's main branch only.
  eq styled(App, 80), ["«on blue» 好"]

