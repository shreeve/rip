test "clipped halves retain their own background colors", ->
  App1 = component
    render
      Box width: 2, height: 1, overflowX: 'hidden', contentOffsetX: 1
        Box width: 4, flexShrink: 0
          Text
            Text backgroundColor: 'blue'
              "你"
            Text backgroundColor: 'red'
              "好"
  # The frame is the literal Ink's test compares against: `contentOffsetX`
  # is on Ink's main branch only.
  eq styled(App1, 80), ["«on blue» «on red» "]
  App2 = component
    render
      Text
        Text backgroundColor: 'blue'
          " "
        Text backgroundColor: 'red'
          " "
  # The tree Ink's test draws its expected frame with.
  eq styled(App2, 80), ["«on blue» «on red» "]

test "clipping a joined emoji preserves its background and adjacent text", ->
  App = component
    render
      Box width: 2, height: 1, overflowX: 'hidden', contentOffsetX: 1
        Box width: 3, flexShrink: 0
          Text
            Text backgroundColor: 'blue'
              "👩\u200d💻X"
  # The frame is the literal Ink's test compares against: `contentOffsetX`
  # is on Ink's main branch only.
  eq styled(App, 80), ["«on blue» X"]

