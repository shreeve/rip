# Ink's test/overlap-wide-background.tsx, ported.
#
# Each test keeps Ink's title and draws Ink's tree, prop for prop.
# SOURCE.md says where each expected frame comes from and which of
# Ink's cases are left out.
#
#   rip test/ink/overlap-wide-background.rip

import { test, eq } from 'rip/testing'
import { Box, Text, styled, differs } from './harness.rip'

console.log "\nOverlap Wide Background"

test "overwriting 你 cell 0 preserves the other cell's background", ->
  App1 = component
    render
      Box width: 3, height: 1
        Text backgroundColor: 'blue'
          "你"
          "Z"
        Box position: 'absolute', left: 0, top: 0
          Text "X"
  # Ink's test asks for this frame; published Ink 7.1.1 draws "X \u001b[44mZ\u001b[49m"
  differs styled(App1, 80), ["«on blue»X Z"], ["X«on blue» Z"],
    'Text with no background of its own keeps the background of the cell beneath it (PLAN §6), so an overlay drawn on a colored strip sits on that color; Ink carries backgrounds down the tree and leaves the overlay bare.'
  App2 = component
    render
      Text
        Text "X"
        Text backgroundColor: 'blue'
          " Z"
  # The tree Ink's test draws its expected frame with.
  eq styled(App2, 80), ["X«on blue» Z"]

test "overwriting 你 cell 1 preserves the other cell's background", ->
  App1 = component
    render
      Box width: 3, height: 1
        Text backgroundColor: 'blue'
          "你"
          "Z"
        Box position: 'absolute', left: 1, top: 0
          Text "X"
  # Ink's test asks for this frame; published Ink 7.1.1 draws " X\u001b[44mZ\u001b[49m"
  differs styled(App1, 80), ["«on blue» XZ"], ["«on blue» «»X«on blue»Z"],
    'Text with no background of its own keeps the background of the cell beneath it (PLAN §6), so an overlay drawn on a colored strip sits on that color; Ink carries backgrounds down the tree and leaves the overlay bare.'
  App2 = component
    render
      Text
        Text backgroundColor: 'blue'
          " "
        Text "X"
        Text backgroundColor: 'blue'
          "Z"
  # The tree Ink's test draws its expected frame with.
  eq styled(App2, 80), ["«on blue» «»X«on blue»Z"]

