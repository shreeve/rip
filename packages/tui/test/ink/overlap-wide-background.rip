test "fully overwriting a wide character with XY replaces its styles", ->
  App1 = component
    render
      Box width: 3, height: 1
        Text backgroundColor: 'blue'
          "你Z"
        Box position: 'absolute', left: 0, top: 0
          Text backgroundColor: 'red'
            "XY"
  eq styled(App1, 80), ["«on red»XY«on blue»Z"]
  App2 = component
    render
      Text
        Text backgroundColor: 'red'
          "XY"
        Text backgroundColor: 'blue'
          "Z"
  # The tree Ink's test draws its expected frame with.
  eq styled(App2, 80), ["«on red»XY«on blue»Z"]

test "fully overwriting a wide character with 好 replaces its styles", ->
  App1 = component
    render
      Box width: 3, height: 1
        Text backgroundColor: 'blue'
          "你Z"
        Box position: 'absolute', left: 0, top: 0
          Text backgroundColor: 'red'
            "好"
  eq styled(App1, 80), ["«on red»好«on blue»Z"]
  App2 = component
    render
      Text
        Text backgroundColor: 'red'
          "好"
        Text backgroundColor: 'blue'
          "Z"
  # The tree Ink's test draws its expected frame with.
  eq styled(App2, 80), ["«on red»好«on blue»Z"]

test "an overlay crossing two wide characters preserves both exposed backgrounds", ->
  App1 = component
    render
      Box width: 4, height: 1
        Text
          Text backgroundColor: 'blue'
            "你"
          Text backgroundColor: 'green'
            "好"
        Box position: 'absolute', left: 1, top: 0
          Text backgroundColor: 'red'
            "XY"
  # Ink's test asks for this frame; published Ink 7.1.1 draws " \u001b[41mXY\u001b[49m"
  eq styled(App1, 80), ["«on blue» «on red»XY«on green» "]
  App2 = component
    render
      Text
        Text backgroundColor: 'blue'
          " "
        Text backgroundColor: 'red'
          "XY"
        Text backgroundColor: 'green'
          " "
  # The tree Ink's test draws its expected frame with.
  eq styled(App2, 80), ["«on blue» «on red»XY«on green» "]

