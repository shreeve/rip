# Yoga's hand-written aspect ratio cases, ported one call for one.
#
#   Upstream: facebook/yoga, tests/YGAspectRatioTest.cpp
#   Commit:   9d159f2d3d8dbc777e1f82c20b94e369c113d608
#
# A port under Yoga's MIT license, © Meta Platforms, Inc. and affiliates;
# the text is in test/yoga/LICENSE. Each case keeps its upstream name, builds
# the same tree through the `yoga-layout` shim, and asserts every box the
# C++ case asserts.
#
#   rip test/yoga-aspect.rip

import { test, eq } from 'rip/testing'
import Yoga, { Align, Direction, Edge, FlexDirection, Justify, MeasureMode, PositionType } from './yoga-shim.rip'

# Upstream's `_measure`: 50 on any axis it is not given exactly.
measure =! (width, widthMode, height, heightMode) ->
  width: if widthMode is MeasureMode.Exactly then width else 50
  height: if heightMode is MeasureMode.Exactly then height else 50

test 'aspect_ratio_cross_defined', ->
  root = Yoga.Node.create()
  root.setAlignItems Align.FlexStart
  root.setWidth 100
  root.setHeight 100

  root_child0 = Yoga.Node.create()
  root_child0.setWidth 50
  root_child0.setAspectRatio 1
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root_child0.getComputedLeft(), 0
  eq root_child0.getComputedTop(), 0
  eq root_child0.getComputedWidth(), 50
  eq root_child0.getComputedHeight(), 50

  root.freeRecursive()

