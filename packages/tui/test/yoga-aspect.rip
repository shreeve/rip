  root_child0.setPosition Edge.Left, 10
  root_child0.setPosition Edge.Top, 10
  root_child0.setPosition Edge.Right, 10
  root_child0.setAspectRatio 1
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root_child0.getComputedLeft(), 10
  eq root_child0.getComputedTop(), 10
  eq root_child0.getComputedWidth(), 80
  eq root_child0.getComputedHeight(), 80

  root.freeRecursive()

