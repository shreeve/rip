test 'aspect_ratio_should_prefer_explicit_height', ->
  config = Yoga.Config.create()
  config.setUseWebDefaults true

  root = Yoga.Node.create config
  root.setFlexDirection FlexDirection.Column

  root_child0 = Yoga.Node.create config
  root_child0.setFlexDirection FlexDirection.Column
  root.insertChild root_child0, 0

  root_child0_child0 = Yoga.Node.create config
  root_child0_child0.setFlexDirection FlexDirection.Column
  root_child0_child0.setHeight 100
  root_child0_child0.setAspectRatio 2
  root_child0.insertChild root_child0_child0, 0

  root.calculateLayout 100, 200, Direction.LTR

  eq root.getComputedWidth(), 100
  eq root.getComputedHeight(), 200

  eq root_child0.getComputedWidth(), 100
  eq root_child0.getComputedHeight(), 100

  eq root_child0_child0.getComputedWidth(), 200
  eq root_child0_child0.getComputedHeight(), 100

  root.freeRecursive()

test 'aspect_ratio_should_prefer_explicit_width', ->
  config = Yoga.Config.create()
  config.setUseWebDefaults true

  root = Yoga.Node.create config
  root.setFlexDirection FlexDirection.Row

  root_child0 = Yoga.Node.create config
  root_child0.setFlexDirection FlexDirection.Row
  root.insertChild root_child0, 0

  root_child0_child0 = Yoga.Node.create config
  root_child0_child0.setFlexDirection FlexDirection.Row
  root_child0_child0.setWidth 100
  root_child0_child0.setAspectRatio 0.5
  root_child0.insertChild root_child0_child0, 0

  root.calculateLayout 200, 100, Direction.LTR

  eq root.getComputedWidth(), 200
  eq root.getComputedHeight(), 100

  eq root_child0.getComputedWidth(), 100
  eq root_child0.getComputedHeight(), 100

  eq root_child0_child0.getComputedWidth(), 100
  eq root_child0_child0.getComputedHeight(), 200

  root.freeRecursive()

test 'aspect_ratio_should_prefer_flexed_dimension', ->
  config = Yoga.Config.create()
  config.setUseWebDefaults true

  root = Yoga.Node.create config

  root_child0 = Yoga.Node.create config
  root_child0.setFlexDirection FlexDirection.Column
  root_child0.setAspectRatio 2
  root_child0.setFlexGrow 1
  root.insertChild root_child0, 0

  root_child0_child0 = Yoga.Node.create config
  root_child0_child0.setAspectRatio 4
  root_child0_child0.setFlexGrow 1
  root_child0.insertChild root_child0_child0, 0

  root.calculateLayout 100, 100, Direction.LTR

  eq root.getComputedWidth(), 100
  eq root.getComputedHeight(), 100

  eq root_child0.getComputedWidth(), 100
  eq root_child0.getComputedHeight(), 50

  eq root_child0_child0.getComputedWidth(), 200
  eq root_child0_child0.getComputedHeight(), 50

  root.freeRecursive()
