test 'aspect_ratio_flex_shrink_2', ->
  root = Yoga.Node.create()
  root.setWidth 100
  root.setHeight 100

  root_child0 = Yoga.Node.create()
  root_child0.setHeight '100%'
  root_child0.setFlexShrink 1
  root_child0.setAspectRatio 1
  root.insertChild root_child0, 0

  root_child1 = Yoga.Node.create()
  root_child1.setHeight '100%'
  root_child1.setFlexShrink 1
  root_child1.setAspectRatio 1
  root.insertChild root_child1, 1

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root_child0.getComputedLeft(), 0
  eq root_child0.getComputedTop(), 0
  eq root_child0.getComputedWidth(), 50
  eq root_child0.getComputedHeight(), 50

  eq root_child1.getComputedLeft(), 0
  eq root_child1.getComputedTop(), 50
  eq root_child1.getComputedWidth(), 50
  eq root_child1.getComputedHeight(), 50

  root.freeRecursive()

