    drag view, 0, 5, 3, 5
    eq screen.selection, 'row'
    view.app.tall.value = 3
    view.frame()
    eq [screen.selection, view.held.view.selection.from], ['', -1]
    view.app.tall.value = 6
    view.frame()
    ok not view.ansi.includes('7m'), JSON.stringify view.ansi
    drag view, 0, 1, 3, 4
    view.app.tall.value = 3
    view.frame()
    eq screen.selection, 'row 1 text\nrow 2 text\nrow 3 text\nrow'
    ok view.ansi.includes("#{CSI}7mrow 1 text"), JSON.stringify view.ansi

test "`screen.selection` is a reactive read: a binding that shows it redraws when the text is copied", ->
  Shows = component
    render
      Box flexDirection: 'column'
        Text "hello world"
