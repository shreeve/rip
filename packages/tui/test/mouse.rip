test! "quit while a selection stands leaves no inverse cell in the scrollback", ->
  stdin = Stdin.new()
  term = Terminal.new 40, 10
  running = run Lines, stdin: stdin, stdout: term, mouse: true
  stdin.key "#{CSI}?1;1R"
