  await running.done
  ok term.since(mark).includes('Gllo world') and not term.since(mark).includes('7m'), JSON.stringify term.since mark

test! "on a terminal the clipboard receives the text", ->
  stdin = Stdin.new()
  term = Terminal.new()
  running = run Lines, stdin: stdin, stdout: term, mouse: true
  stdin.key "#{CSI}?1;1R"
