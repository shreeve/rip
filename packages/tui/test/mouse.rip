# ==[ Negotiation ]==

console.log "\nNegotiation"

test! "keyboard: 'enhanced' sends the kitty query and then the attributes query after the modes; a kitty answer first pushes the flag once, and quit pops it before the modes", ->
  stdin = Stdin.new()
  term = Terminal.new()
  running = run Keys, stdin: stdin, stdout: term, keyboard: 'enhanced'
  ok term.since(0).startsWith(ON + QUERY), JSON.stringify term.since 0
  eq [term.queries, screen.keyboard, term.kitty], [['keyboard', 'attributes'], 'basic', 0]
  stdin.key KITTY
  eq [screen.keyboard, term.kitty], ['enhanced', 1]
  stdin.key DA1
  eq [screen.keyboard, term.kitty, term.since(0).split(PUSH).length - 1], ['enhanced', 1, 1], 'the attributes answer after the decision changes nothing'
  mark = term.sent.length
  quit()
  await running.done
  eq term.since(mark), "#{POP}#{OFF}\n#{CSI}?25h"
  eq [term.kitty, screen.keyboard], [0, 'basic']

