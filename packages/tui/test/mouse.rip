# ==[ Fuzz ]==

console.log "\nFuzz"

wide = (...codes) -> String.fromCodePoint ...codes
WORDS =! ['a', 'hello', 'hello world', 'two\nlines', 'x'.repeat(14), 'abc de', wide(0x65E5, 0x672C, 0x8A9E) + ' ok', 'q' + wide(0x4E2D) + 'r', 'the quick brown fox jumps']
STYLES =! {
  flexDirection: ['row', 'column', 'row-reverse', undefined, undefined]
  flexWrap: ['wrap', undefined, undefined]
  width: [2, 4, 8, 12, '50%', undefined, undefined]
  height: [1, 2, 3, 5, undefined, undefined]
  padding: [1, undefined, undefined, undefined]
  margin: [1, -1, undefined, undefined]
  marginLeft: [-2, 2, undefined, undefined]
  marginTop: [-1, undefined, undefined, undefined]
  borderStyle: ['single', 'round', undefined, undefined]
  overflow: ['hidden', 'hidden', undefined, undefined]
  contentOffsetX: [1, 2, undefined, undefined, undefined]
  contentOffsetY: [1, 2, -1, undefined, undefined]
  position: ['absolute', 'absolute', undefined, undefined, undefined]
  left: [0, 1, 3, -1, undefined]
  top: [0, 1, 2, -1, undefined]
  display: ['none', 'contents', undefined, undefined, undefined, undefined]
  hidden: [true, undefined, undefined, undefined, undefined, undefined]
}
KEYS =! Object.keys STYLES

# Every node under `node`, in tree order.
all =! (node, into = []) ->
  into.push node
  kid = node.firstChild
  while kid
    all kid, into
    kid = kid.nextSibling
  into

# How far the content offsets above `node` shift it (a `contents` node
# has no box to scroll).
shift =! (node) ->
  dx = dy = 0
  above = node.parentNode
  while above
    s = above.styles
    if s and s.display isnt 'contents'
      dx -= Math.trunc s.contentOffsetX if s.contentOffsetX
      dy -= Math.trunc s.contentOffsetY if s.contentOffsetY
    above = above.parentNode
  { dx, dy }

# Whether the cells `node` and everything under it can ink hold (x, y).
holds =! (node, x, y) ->
  { dx, dy } = shift node
  x >= node.bl + dx and x < node.br + dx and y >= node.bt + dy and y < node.bb + dy

# Whether `node`'s own rounded box holds (x, y).
boxed =! (node, x, y) ->
  { dx, dy } = shift node
  r = node.rect
  x >= r.x + dx and x < r.x + r.w + dx and y >= r.y + dy and y < r.y + r.h + dy

under =! (node, above) ->
  while node
    return true if node is above
    node = node.parentNode
  false

test "random trees, random cells: the target is the node the painter put there, and the coordinates are from its corner", ->
  seed = 20260921
  rand = ->
    seed = (seed * 1664525 + 1013904223) % 4294967296
    seed / 4294967296
  pick = (list) -> list[Math.floor rand() * list.length]
  counts = { rounds: 0, clicks: 0, spans: 0, divs: 0, bodies: 0, texts: 0, covered: 0, scrolled: 0, targets: 0, cursors: 0 }
  for round in [0...300]
    view = mount Bare, cols: 30, mouse: true, selection: false
    try
      root = find 'root'
      names = 0
      colors = 0
      byId = Map.new()
      say = (problem) -> raise "seed 20260921 round #{round}: #{problem}"
      # Every box is painted in a color of its own, border included, and
      # no text has any: what a cell shows says which box painted it.
      tint = (node) ->
        color = "ansi256(#{colors += 1})"
        node.set 'backgroundColor', color
        node.set 'borderBackgroundColor', color
        byId.set intern(null, color, 0), node
      tint document.body
      tint root
      root.set 'width', 24   # a strip of the body shows on the right
      make = (depth) ->
        roll = rand()
        if roll < 0.2
          node = document.createElement 'span'
          node.appendChild document.createTextNode pick WORDS
          node.set 'id', "s#{names += 1}"
          return node
        return document.createTextNode pick WORDS if roll < 0.4
        node = document.createElement 'div'
        node.set 'id', "d#{names += 1}"
        for key in KEYS when rand() < 0.3
          value = pick STYLES[key]
          node.set key, value if value isnt undefined
        tint node
        if depth < 4
          node.appendChild make depth + 1 for n in [0...Math.floor rand() * 4]
        node
      root.appendChild make 1 for n in [0...2 + Math.floor rand() * 3]
      view.frame()
      front = view.held.view.front
      continue unless front.rows
      counts.rounds += 1
      nodes = all document.body
      order = Map.new()
      order.set node, n for node, n in nodes
      before = (a, b) -> order.get(a) <= order.get(b)
      got = null
      document.addEventListener 'mousedown', (event) -> got = event
      seen = Set.new()
      for n in [0...20]
        x = Math.floor rand() * 30
        y = Math.floor rand() * front.rows
        got = null
        view.send down(x, y) + up(x, y)
        say "no mousedown for (#{x}, #{y})" unless got
        target = got.target
        counts.clicks += 1
        seen.add target
        owner = byId.get front.style[y * 30 + x]
        say "cell (#{x}, #{y}) shows a style no box painted" unless owner
        if target.tagName is 'span'
          say "(#{x}, #{y}) hit #{idOf target}, whose words do not reach it" unless holds target, x, y
          say "(#{x}, #{y}) hit #{idOf target}, painted before #{idOf owner}" unless before owner, target
          counts.spans += 1
        else if owner is target
          if target is document.body then counts.bodies += 1 else counts.divs += 1
        else
          bare = target.childNodes.find (kid) -> kid.nodeType is 3 and holds kid, x, y
          say "(#{x}, #{y}) hit #{idOf target}, and the painter says #{idOf owner}" unless bare and before owner, bare
          counts.texts += 1
        { dx, dy } = shift target
        say "(#{x}, #{y}) on #{idOf target} at (#{target.rect.x + dx}, #{target.rect.y + dy}) came as (#{got.x}, #{got.y})" unless got.x is x - target.rect.x - dx and got.y is y - target.rect.y - dy
        # The cursor's place is the hit test's cell: a cursor declared at
        # the cell's place in the target lands on the cell (screen.rip). A
        # `contents` node has no box of its own, so no cursor: it is the
        # target only as the parent of a bare text.
        if target.nodeType is 1 and target isnt document.body and target.styles.display isnt 'contents'
          target.focusable = true
          target.set 'cursor', { x: got.x, y: got.y }
          target.focus()
          view.frame()
          say "(#{x}, #{y}) on #{idOf target}: a cursor at its place in the node is placed at #{JSON.stringify view.cursor}" unless view.cursor?.x is x and view.cursor?.y is y
          target.set 'cursor', undefined
          target.blur()
          counts.cursors += 1
        counts.covered += 1 if nodes.some (node) -> node.nodeType is 1 and node isnt target and not under(target, node) and boxed node, x, y
        counts.scrolled += 1 if nodes.some (node) -> node isnt target and under(target, node) and node.styles?.overflow is 'hidden' and (node.styles.contentOffsetX or node.styles.contentOffsetY)
      counts.targets += seen.size
    finally
      view.close()
  # A fuzz that does nothing passes everything: hold it to its volume.
  floors = { rounds: 250, clicks: 5000, spans: 450, divs: 3500, bodies: 900, texts: 60, covered: 1000, scrolled: 40, targets: 1000, cursors: 3000 }
  ok counts[name] >= floor, "#{name}: #{counts[name]} is under the floor of #{floor} — #{JSON.stringify counts}" for own name, floor of floors
