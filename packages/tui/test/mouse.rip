# ==[ Selection ]==

console.log "\nSelection"

Lines =! component
  @n := 0
  render
    Box flexDirection: 'column'
      Text "hello world"
      Text "foo bar #{@n}"
      Text "日本語 wide"

copied =! (text) -> "\x1b]52;c;#{Buffer.from(text).toString 'base64'}\x1b\\"

# What the last write put on the clipboard, or null.
clipped =! (view) ->
  found = /\x1b\]52;c;([^\x1b]*)\x1b\\/.exec view.bytes
  if found then Buffer.from(found[1], 'base64').toString() else null

test "a drag selects the cells from the press to the pointer in reading order, painted inverse in the styled frame and absent from the plain one, and the release puts the text on the clipboard by OSC 52", ->
  mounted Lines, {}, (view) ->
    drag view, 2, 0, 4, 1
    ok view.bytes.endsWith(copied 'llo world\nfoo b'), JSON.stringify view.bytes
    eq screen.selection, 'llo world\nfoo b'
    eq view.frame(), 'hello world\nfoo bar 0\n日本語 wide'
    ok view.ansi.includes("he#{CSI}7mllo world") and view.ansi.includes("#{CSI}7mfoo b#{CSI}0mar 0"), JSON.stringify view.ansi

test "wide glyphs are selected whole, from either cell", ->
  mounted Lines, {}, (view) ->
    drag view, 1, 2, 4, 2
    eq [screen.selection, clipped view], ['日本語', '日本語']
    view.frame()
    ok view.ansi.includes("#{CSI}7m日本語#{CSI}0m wide"), JSON.stringify view.ansi

test "a click clears the selection, and nothing is copied; the right button selects nothing", ->
  mounted Lines, {}, (view) ->
    drag view, 2, 0, 4, 1
    view.frame()
    click view, 0, 1
    eq [screen.selection, clipped view], ['', null]
    view.frame()
    ok not view.ansi.includes('7m'), JSON.stringify view.ansi
    view.send down(2, 0, 2) + move(4, 1, 2) + up(4, 1, 2)
    eq [screen.selection, clipped view], ['', null]

test "selection: false sends nothing and paints nothing", ->
  mounted Lines, { selection: false }, (view) ->
    drag view, 2, 0, 4, 1
    eq [screen.selection, clipped view], ['', null]
    view.frame()
    ok not view.ansi.includes('7m'), JSON.stringify view.ansi

test "preventDefault on the mousedown keeps the drag from selecting", ->
  mounted Lines, {}, (view) ->
    document.addEventListener 'mousedown', (event) -> event.preventDefault()
    drag view, 2, 0, 4, 1
    eq [screen.selection, clipped view], ['', null]

test "a drag's damage is the cells that changed hands, and clearing owes the selection", ->
  mounted Lines, {}, (view) ->
    view.send down(0, 0) + move(5, 0, 0)
    view.frame()
    eq view.damage, 6
    view.send move 8, 0, 0
    view.frame()
    eq view.damage, 3
    view.send move 5, 0, 0
    view.frame()
    eq view.damage, 3
    view.send up 5, 0
    view.frame()
    eq view.damage, 0
    click view, 0, 2
    view.frame()
    eq view.damage, 6

test "the selection stands through the app's own redraws, Escape included, and a resize clears it", ->
  mounted Lines, {}, (view) ->
    drag view, 0, 1, 4, 1
    view.frame()
    view.app.n.value = 7
    eq view.frame(), 'hello world\nfoo bar 7\n日本語 wide'
    ok view.ansi.includes("#{CSI}7mfoo b#{CSI}0mar 7"), JSON.stringify view.ansi
    view.press 'Escape'
    view.frame()
    ok view.ansi.includes("#{CSI}7mfoo b"), 'Escape has no default action'
    view.resize 30
    view.frame()
    eq screen.selection, ''
    ok not view.ansi.includes('7m'), JSON.stringify view.ansi

Tall =! component
  @tall := 6
  rows ~= (r for r in [0...@tall])
  render
    Box flexDirection: 'column'
      for r in rows
        Text key: r, "row #{r} text"

test "a selection whose rows are all gone is none, and one whose rows remain stands", ->
