test! "the mouse modes are withdrawn on every way out: Ctrl-C, a listener that throws, a mouse listener that throws", ->
  for [name, leave] in [['Ctrl-C', (stdin) -> stdin.key '\x03'], ['a key listener that throws', (stdin) -> stdin.key 'a'], ['a mouse listener that throws', (stdin) -> stdin.key "#{CSI}?1;1R" + down(0, 0)]]
    stdin = Stdin.new()
