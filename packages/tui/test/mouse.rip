  quit()
  await running.done
  ok not term.since(0).includes('1006') and not term.since(0).includes('?6n'), JSON.stringify term.since 0
  term = Terminal.new()
  running = run Keys, stdin: Stdin.new(false), stdout: term, mouse: true, keyboard: 'enhanced'
  quit()
