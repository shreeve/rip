# Pins for the layout engine: answers that are easy to get wrong, changes
# that are easy to lose, and values that must fail by name. Trees are
# built straight from the document's nodes and laid out by `layout`;
# `settled` lays a live tree out and holds it to a twin cloned from it
# and laid out once.
#
#   rip test/layout.rip

import { test, eq, ok, throws } from 'rip/testing'
import { Element, Text, Node } from '../document.rip'
import { layout, edges, admit } from '../layout.rip'

div = (styles = {}, kids = []) ->
  node = Element.new 'div'
  node.styles[key] = value for own key, value of styles
  node.appendChild kid for kid in kids
  node

span = (text, styles = {}) ->
  node = Element.new 'span'
  node.styles[key] = value for own key, value of styles
  node.appendChild Text.new text
  node

clone = (node) ->
  return Text.new node.data if node.nodeType is 3
  return Node.new 8 if node.nodeType is 8
  copy = Element.new node.tagName
  copy.styles[key] = value for own key, value of node.styles
  copy.measure = node.measure if node.measure
  kid = node.firstChild
  while kid
    copy.appendChild clone kid
    kid = kid.nextSibling
  copy

boxes = (node, out = []) ->
  box = node.rect
  out.push "#{box.x},#{box.y} #{box.w}x#{box.h}"
  kid = node.firstChild
  while kid
    boxes kid, out
    kid = kid.nextSibling
  out

dirty = (node) ->
  return true if node.dirty
  kid = node.firstChild
  while kid
    return true if dirty kid
    kid = kid.nextSibling
  false

# Lay `live` out, and hold every box in it to a fresh twin's.
settled = (live, wide, tall = null) ->
  layout live, wide, tall
  twin = clone live
  layout twin, wide, tall
  eq boxes(live).join(' | '), boxes(twin).join(' | ')
  ok not dirty(live), 'a node is still dirty after layout'

at = (node) -> "#{node.rect.x},#{node.rect.y} #{node.rect.w}x#{node.rect.h}"

# ==[ Text ]==

console.log "\nText"

test "a text leaf is measured at the width it is offered: it wraps, and its height follows", ->
  words = span 'the quick brown fox jumps'
  layout div({ width: 10 }, [words]), 100
  eq at(words), '0,0 10x3'
  fitted = span 'the quick brown fox jumps', { alignSelf: 'flex-start' }
  layout div({ width: 12 }, [fitted]), 100
  eq at(fitted), '0,0 10x3'
  # Along a row too: a basis is measured at most as wide as the container.
  along = span 'the quick brown fox jumps'
  layout div({ flexDirection: 'row', width: 10 }, [along]), 100
  eq at(along), '0,0 10x3'
  free = span 'the quick brown fox jumps'
  layout div({ flexDirection: 'row' }, [free]), null
  eq at(free), '0,0 25x1'

test "truncated text takes the width it is offered and one row a line", ->
  cut = span 'the quick brown fox\njumps', { wrap: 'truncate-middle' }
  layout div({ width: 10 }, [cut]), 100
  eq at(cut), '0,0 10x2'

test "text with no words takes no row", ->
  empty = span ''
  layout div({ width: 10 }, [empty, span('x')]), 100
  eq at(empty), '0,0 10x0'

test "a wrap mode that changes lays the text out again", ->
  words = span 'the quick brown fox jumps'
  root = div { width: 10 }, [words]
  settled root, 100
  eq words.rect.h, 3
  words.set 'wrap', 'truncate'
  settled root, 100
  eq words.rect.h, 1

test "a new text lays out again only when it answers an offer differently", ->
  text = Text.new 'aaa bbb ccc'
  root = div { width: 7 }, [div({}, [text])]
  settled root, 100
  eq at(text), '0,0 7x2'
  text.data = 'ccc bbb aaa'
  ok not dirty(root), 'the same rows at the width it was offered'
  settled root, 100
  text.data = 'aaaa bbbbbb'
  ok dirty(root), 'rows of another width'
  settled root, 100
  eq at(text), '0,0 7x2'
  text.data = 'a b c d e f g h i j'
  ok dirty(root), 'a third row'
  settled root, 100
  eq at(text), '0,0 7x3'

test "a text wider than its offer leaves no stale height behind when the offer widens", ->
  # At 3 columns the bordered box offers its text 1, and "中on" answers 2
  # wide (the cluster cannot be narrower) and 3 tall. At 4 the text is
  # exactly 2 wide — the same width, and another height.
  root = div {}, [div({ flexDirection: 'row' }, [div({ borderStyle: 'single' }, [Text.new "#{String.fromCodePoint 0x4E2D}on"])])]
  settled root, 3
  settled root, 4
  eq root.rect.h, 4

test "text sits inside the box it is in when both land on a fraction of a cell", ->
  # Three shrink to 4.615, 4.615 and 0.769 cells; the second box starts
  # at 4.615 and rounds to cell 5, and its text rounds with it.
  first = span 'A'
  second = span 'B'
  boxed = div { width: 6, flexShrink: 1, flexDirection: 'row' }, [second]
  layout div({ width: 10, flexDirection: 'row' }, [div({ width: 6, flexShrink: 1, flexDirection: 'row' }, [first]), boxed, span('C', { flexShrink: 1 })]), 100
  eq [at(boxed), at(second)], ['5,0 4x1', '5,0 1x1']

# ==[ An incremental layout equals a fresh one ]==

console.log "\nIncremental layout"

test "a relayout with no change moves nothing: a baseline row reads only what this pass measured", ->
  tall = div { height: 1, aspectRatio: 2 }, [div()]
  root = div {}, [div({ flexDirection: 'row' }, [div({ alignSelf: 'baseline' }), tall])]
  layout root, 60
  first = boxes(root).join ' | '
  layout root, 60
  eq boxes(root).join(' | '), first
  settled root, 60

test "a change inside a hidden subtree shows when the subtree does", ->
  words = span 'a'
  inner = div { width: 4, height: 1 }
  panel = div {}, [words, inner]
  root = div {}, [panel, div({ height: 1 })]
  settled root, 40
  panel.set 'hidden', true
  settled root, 40
  words.firstChild.data = 'a\nb\nc'
  inner.set 'height', 5
  settled root, 40
  panel.set 'hidden', false
  settled root, 40
  eq root.rect.h, 9

test "a bare text rewritten while its panel is hidden is measured again when it shows", ->
  count = Text.new 'count 1'
  panel = div {}, [count]
  root = div {}, [div({ height: 1 }), panel, span('footer')]
  settled root, 40
  panel.toggleAttribute 'hidden', true
  settled root, 40
  count.data = 'count 1\ncount 2'
  settled root, 40
  panel.toggleAttribute 'hidden', false
  settled root, 40
  eq panel.rect.h, 2

test "a node that was `display: contents` lays its children out again when it makes a box", ->
  grown = div { height: 2 }
  wrap = div {}, [grown]
  root = div {}, [wrap, div({ height: 1 })]
  settled root, 40
  wrap.set 'display', 'contents'
  settled root, 40
  grown.set 'height', 5
  settled root, 40
  wrap.set 'display', undefined
  settled root, 40
  eq wrap.rect.h, 5

test "display flex → contents → flex leaves no stale child position", ->
  kid = div { width: 3, height: 1 }
  wrap = div { paddingLeft: 4 }, [kid]
  root = div { flexDirection: 'row' }, [div({ width: 10, height: 1 }), wrap]
  settled root, 40
  eq kid.rect.x, 14
  wrap.set 'display', 'contents'
  settled root, 40
  eq kid.rect.x, 10
  wrap.set 'display', 'flex'
  settled root, 40
  eq kid.rect.x, 14

test "an absolute node under a static chain follows its parent's laid-out size, not a later measurement", ->
  pinned = div { position: 'absolute', width: 2, height: 2 }
  chain = div { position: 'static', flexGrow: 1, justifyContent: 'flex-end' }, [pinned]
  root = div {}, [div({ position: 'static', width: 50, minHeight: 10 }, [chain])]
  settled root, 100, 40
  settled root, 100, 30
  eq pinned.rect.y, 8

test "edges answers the padding the node was laid out with", ->
  make = ->
    padded = div { width: 10, height: 1, paddingLeft: '10%' }
    root = div { flexDirection: 'row', alignItems: 'flex-start' }, [div({ flexDirection: 'row' }, [div({ width: 30, height: 1 }), padded])]
    { root, padded }
  live = make()
  layout live.root, 100
  layout live.root, 90
  fresh = make()
  layout fresh.root, 90
  eq edges(live.padded), edges(fresh.padded)

test "an offer of −1 is an offer like any other", ->
  inner = div { height: 3 }
  root = div { flexDirection: 'row', alignItems: 'flex-start' }, [div({ width: 1, marginLeft: -2 }, [inner])]
  settled root, 80
  inner.set 'height', 6
  settled root, 80
  eq root.rect.h, 6
  words = span 'x'
  root = div { flexDirection: 'row', alignItems: 'flex-start' }, [div({ width: 5, height: 1 }), div({ width: 0, marginLeft: -1 }, [words])]
  settled root, 80
  words.firstChild.data = 'x\ny'
  settled root, 80
  eq root.rect.h, 2

test "the cache answers only the very offer it was made for", ->
  words = span 'hello'
  root = div {}, [div({}, [div({ flex: 2 }, [div({ paddingTop: '10%', margin: '3%', width: 40 }, [div({}, [words])])])])]
  settled root, 77, 5
  settled root, 23, 5
  root = div {}, [div({ margin: '3%', flexDirection: 'row-reverse' }, [div({ flexWrap: 'wrap' }, [div({}, [div({ minWidth: 3 })]), div({ paddingTop: 1 })])])]
  settled root, 60
  settled root, 86

test "a content-box child's percent padding ties its container to the owner's width", ->
  kid = div { boxSizing: 'content-box', padding: '10%', maxWidth: 20, width: 45, height: 2 }
  row = div { width: 50, height: 10, flexDirection: 'row' }, [kid, div({ flexGrow: 1, height: 2 })]
  root = div { alignItems: 'flex-start' }, [row]
  settled root, 100
  settled root, 200
  settled root, 100

test "a style that throws leaves nothing behind: the corrected tree lays out as a fresh one", ->
  kid = div { width: 10, height: 2 }
  root = div { alignItems: 'flex-start' }, [kid]
  settled root, 40
  kid.styles.width = 20
  kid.styles.height = 'abc'
  kid.changed true
  throws (-> layout root, 40), 'height: "abc" is not a length'
  delete kid.styles.height
  kid.changed true
  settled root, 40
  eq at(kid), '0,0 20x0'

test "a subtree laid out as a root, then under its parent", ->
  words = span 'one'
  part = div {}, [words]
  root = div {}, [part, div({ height: 2 })]
  settled root, 40
  words.firstChild.data = 'one\ntwo\nthree'
  layout part, 40
  settled root, 40
  eq root.rect.h, 5

test "a root that becomes a child, and a child that becomes a root, forget what the root's rules gave them", ->
  part = div { width: 20, flexGrow: 1, rowGap: '10%' }, [div({ flexGrow: 1, height: 10 }), div({ height: 10 })]
  settled part, 20
  settled div({ flexDirection: 'row', alignItems: 'flex-start', width: 20 }, [part]), 20
  corner = div { position: 'absolute', right: 0, bottom: 0, width: 2, height: 1 }
  block = div { position: 'static', width: 20, height: 5 }, [corner]
  settled block, 20
  eq at(corner), '18,4 2x1'
  outer = div { width: 40, height: 10, alignItems: 'flex-start' }, [block]
  settled outer, 40
  eq at(corner), '38,9 2x1'
  block.remove()
  settled block, 20
  eq at(corner), '18,4 2x1'

test "nodes that make no box hold no stale one", ->
  ghost = div { display: 'contents' }
  root = div {}, [div({ height: 3 }), div({ height: 2 }, [ghost])]
  settled root, 40
  root.insertBefore ghost, root.firstChild
  settled root, 40
  eq at(ghost), '0,0 0x0'
  moved = div { width: 5, height: 2 }
  words = span 'hi'
  root = div {}, [div({ height: 3 }), moved, words]
  settled root, 40
  words.appendChild moved
  settled root, 40
  eq at(moved), '0,0 0x0'
  bare = Text.new 'bare'
  root.appendChild bare
  settled root, 40
  words.appendChild bare
  settled root, 40
  words.set 'hidden', true
  settled root, 40
  words.set 'hidden', false
  settled root, 40
  eq at(bare), '0,0 0x0'

test "a comment anchor is cleaned like any node", ->
  anchor = Node.new 8
  hidden = Node.new 8
  root = div {}, [anchor, div({ height: 1 }), div({ hidden: true }, [hidden])]
  layout root, 10
  ok not anchor.dirty
  ok not hidden.dirty

# ==[ Plain trees ]==

console.log "\nPlain trees"

test "a share that lands on a min, a max, or a floor is not frozen short of it", ->
  shrunk = div { height: 25, minHeight: 11, flexShrink: 1 }
  layout div({}, [div({ height: 30 }), shrunk]), 100, 41
  eq shrunk.rect.h, 11
  grown = div { height: 1, flexGrow: 7, maxHeight: '100%' }
  layout div({}, [grown]), 100, 30
  eq grown.rect.h, 30
  narrow = div { maxWidth: 10, flexGrow: 1 }
  wide = div { maxWidth: 30, flexGrow: 0.2 }
  layout div({ flexDirection: 'row' }, [narrow, wide]), 200
  eq narrow.rect.w, 10
  eq wide.rect.w, 30

test "a grower frozen at its max keeps it when space is left over", ->
  capped = div { maxHeight: 60, flex: 1 }
  layout div({}, [capped]), 40, 100
  eq capped.rect.h, 60

test "two halves of a fractional width share one line", ->
  row = div { width: 12, paddingLeft: 0.3, flexDirection: 'row', flexWrap: 'wrap' }, [div({ width: '50%', height: 1 }), div({ width: '50%', height: 1 })]
  layout row, null
  eq row.rect.h, 1

test "space-around on a line with no in-flow item divides nothing", ->
  root = div { justifyContent: 'space-around', minHeight: 5 }, [div({ position: 'absolute', width: 2, height: 1 })]
  layout root, 80
  eq at(root), '0,0 80x5'
  eq at(root.firstChild), '0,2 2x1'

test "a box that is not finite is refused by name", ->
  leaf = div()
  leaf.measure = -> { width: Infinity, height: 1 }
  throws (-> layout div({ alignItems: 'flex-start' }, [leaf]), 20), 'a box that is not finite'

test "an item that wraps to the next line has lent its auto margins to the line it left", ->
  first = div { width: 30, height: 1 }
  root = div { flexDirection: 'row', flexWrap: 'wrap', justifyContent: 'center', width: 50 }, [first, div({ width: 30, height: 1, marginLeft: 'auto' })]
  layout root, null
  eq first.rect.x, 0

test "a hidden flexible child keeps a lone flexible child from the zero-basis shortcut", ->
  # Alone, the child is given the whole line and its content is never
  # measured; Yoga counts the hidden sibling, and measures it.
  asked = (flexGrow) ->
    calls = 0
    lone = div { flexGrow: 1, flexShrink: 1 }
    lone.measure = ->
      calls += 1
      { width: 5, height: 2 }
    layout div({ height: 10 }, [lone, div({ height: 4 }), div({ flexGrow, hidden: true })]), 20
    eq lone.rect.h, 6
    calls
  eq asked(0), 0
  ok asked(1) > 0

test "a box whose children are all hidden is still a container, bounded line by line as Yoga bounds it", ->
  root = div {}, [div({ minWidth: 100, maxWidth: 60 }, [div({ hidden: true })])]
  layout root, null
  eq root.rect.w, 60
  eq root.firstChild.rect.w, 100

# ==[ Stated divergences from Yoga ]==
#
# Each holds this engine's answer where Yoga's is another ON PURPOSE
# (PLAN §5). Yoga's answers are `yoga-layout` 3.2.1's, the release Ink
# ships, run on the same trees.

console.log "\nStated divergences from Yoga"

test "divergence: the owner's size is part of a cached answer's key", ->
  # Yoga keys a cached answer by the offer alone. The box is offered a
  # width of exactly 0 under either space, so at 10 columns Yoga answers
  # from the 100-column layout: padding of 5, a 10×10 box, and a root
  # 10×10 around it. A fresh Yoga layout at 10 gives what is held here:
  # an incremental layout equals a fresh one.
  box = div { width: 0, padding: '5%' }
  root = div {}, [box]
  settled root, 100
  eq [at(root), at(box)], ['0,0 100x10', '0,0 10x10']
  settled root, 10
  eq [at(root), at(box)], ['0,0 10x1', '0,0 1x1']

test "divergence: a first flex basis stands for one pass", ->
  # Yoga keeps the first basis it resolves until the child is dirtied, so
  # the child stays at half of 100 when the space doubles: 50 wide at
  # 200, and 50 tall at 200 rows. A fresh Yoga layout gives half of 200,
  # as every pass does here.
  half = div { flexBasis: '50%', height: 5 }
  root = div { flexDirection: 'row' }, [half]
  settled root, 100
  eq half.rect.w, 50
  settled root, 200
  eq half.rect.w, 100
  half = div { flexBasis: '50%' }
  root = div {}, [half]
  settled root, 100, 100
  eq half.rect.h, 50
  settled root, 100, 200
  eq half.rect.h, 100

test "divergence: sizes are compared within a tolerance, in doubles", ->
  # 17.9 wide less 16 of padding leaves 1.9 for children 1 and 0.9 wide.
  # In Yoga's float32, 17.9 − 16 is 1.8999996 and 1 + 0.9 is more: the
  # line overflows, the second child wraps, and the box is two rows tall
  # — auto-sized or not. Doubles miss too, by one part in 1e15 and to
  # either side from one sum to the next; `near` calls the two equal, so
  # what fits by arithmetic fits.
  for auto in [true, false]
    first = div { width: 1, height: 1 }
    second = div { width: 0.9, height: 1 }
    shelf = div { flexDirection: 'row', flexWrap: 'wrap', paddingLeft: 8, paddingRight: 8 }, [first, second]
    if auto then shelf.styles.alignSelf = 'flex-start' else shelf.styles.width = 17.9
    layout div({ width: 17.9 }, [shelf]), null
    eq [at(shelf), at(first), at(second)], ['0,0 18x1', '8,0 1x1', '9,0 1x1']

test "divergence: a percent min or max is one length wherever it is read", ->
  # Yoga resolves a child's percent min and max against the container's
  # OWNER when it breaks lines and shares space, and against the
  # container everywhere else. Under 100 columns Yoga makes the first
  # child of the 10-wide row 50 wide; under 20 columns it holds the
  # 18-wide child of a 40-wide row to 10; the column's child comes out
  # 20 tall in a box of 10. Here the percent is of the space inside the
  # container, as a percent width is, and as CSS has it.
  least = div { minWidth: '50%', height: 1 }
  after = div { width: 1, height: 1 }
  layout div({}, [div({ width: 10, flexDirection: 'row' }, [least, after])]), 100
  eq [at(least), at(after)], ['0,0 5x1', '5,0 1x1']
  most = div { maxWidth: '50%', width: 18, height: 1 }
  layout div({}, [div({ width: 40, flexDirection: 'row' }, [most])]), 20
  eq most.rect.w, 18
  tall = div { minHeight: '50%' }
  layout div({}, [div({ height: 10 }, [tall, div({ height: 1 })])]), 100, 40
  eq tall.rect.h, 5
  # A percent min bounds the basis as the same min in points does, and
  # the owner's width has no say (Yoga: 600 and 200 under 1000 columns).
  for mins in [['60%', '20%'], [120, 40]]
    a = div { flexGrow: 1, flexBasis: '15%', minWidth: mins[0] }
    b = div { flexGrow: 4, flexBasis: '10%', minWidth: mins[1] }
    root = div {}, [div({ width: 200, height: 2, flexDirection: 'row' }, [a, b])]
    settled root, 1000
    eq [a.rect.w, b.rect.w], [128, 72]
    settled root, 200
    eq [a.rect.w, b.rect.w], [128, 72]

# ==[ Styles ]==

console.log "\nStyles"

test "flex: n grows by n from a zero basis; a negative one shrinks", ->
  a = div { flex: 1 }, [span('tall\ntall\ntall')]
  b = div { flex: 3 }
  layout div({ height: 8 }, [a, b]), 20
  eq "#{a.rect.h} #{b.rect.h}", '2 6'
  squeezed = div { flex: -1, height: 8 }
  layout div({ height: 10 }, [div({ height: 6 }), squeezed]), 20
  eq squeezed.rect.h, 4

test "flexGrow, flexShrink, and flexBasis each outrank flex, whichever is written first", ->
  for styles in [{ flex: 1, flexGrow: 3 }, { flexGrow: 3, flex: 1 }]
    a = div styles
    b = div { flex: 1 }
    layout div({ height: 8 }, [a, b]), 20
    eq "#{a.rect.h} #{b.rect.h}", '6 2'
  a = div { flex: 1, flexBasis: 4 }
  b = div { flex: 1 }
  layout div({ height: 10 }, [a, b]), 20
  eq "#{a.rect.h} #{b.rect.h}", '7 3'
  a = div { flex: -1, flexShrink: 0, height: 8 }
  layout div({ height: 10 }, [div({ height: 6 }), a]), 20
  eq a.rect.h, 8

test "a shorthand yields to its longhands", ->
  inner = div()
  outer = div { padding: 1, paddingX: 3, paddingLeft: 5, margin: 2, marginY: 0, marginTop: 4, width: 30, height: 10 }, [inner]
  layout div({ alignItems: 'flex-start' }, [outer]), 60
  eq at(outer), '2,4 30x10'
  eq at(inner), '7,5 22x0'
  eq edges(outer), [1, 3, 1, 5]

test "a value layout cannot use is refused by name, for the key it was written to", ->
  refused = [
    ['flexGrow', 'lots', 'flexGrow: "lots" is not a number']
    ['flexGrow', -1, 'flexGrow: -1 is not a number']
    ['flex', '1 1 auto', 'flex: "1 1 auto" is not a number']
    ['aspectRatio', '2', 'aspectRatio: "2" is not a number']
    ['alignItems', 'space-between', 'alignItems: "space-between" is not one of flex-start, center, flex-end, stretch, baseline']
    ['alignContent', 'baseline', 'alignContent: "baseline" is not one of']
    ['alignSelf', 'space-around', 'alignSelf: "space-around" is not one of auto,']
    ['padding', 'auto', "padding: \"auto\" is not a length — write a number or 'N%'"]
    ['gap', 'auto', "gap: \"auto\" is not a length — write a number or 'N%'"]
    ['minWidth', 'auto', 'minWidth: "auto" is not a length']
    ['width', '50px%', 'width: "50px%" is not a length']
    ['width', '1e2%', 'width: "1e2%" is not a length']
    ['width', -5, 'width: -5 is below zero']
    ['maxHeight', '-5%', 'maxHeight: "-5%" is below zero']
    ['width', NaN, 'width: NaN is not a length']
    ['margin', Infinity, 'margin: Infinity is not a length']
    ['hidden', 'false', 'hidden: "false" is not true or false']
    ['display', 'block', 'display: "block" is not one of']
  ]
  for [key, value, message] in refused
    throws (-> admit key, value), message
    node = div()
    node.styles[key] = value
    throws (-> layout div({}, [node]), 20), message

test "a value layout can use is admitted, and so is a key that is not layout's", ->
  admitted = [['margin', 'auto'], ['marginLeft', -3], ['left', 'auto'], ['width', '50%'], ['width', '12.5%'], ['width', 'auto'],
    ['flexBasis', 'auto'], ['aspectRatio', 0], ['hidden', true], ['display', 'contents'], ['alignSelf', 'auto'], ['color', 'red'], ['width', undefined]]
  eq admit(key, value), undefined for [key, value] in admitted
