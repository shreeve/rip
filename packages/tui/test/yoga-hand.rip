test 'cant_call_negative_measure', ->
  root = Yoga.Node.create()
  root.setFlexDirection FlexDirection.Column
  root.setWidth 50
  root.setHeight 10

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc neverNegative
  root_child0.setMargin Edge.Top, 20
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

test 'cant_call_negative_measure_horizontal', ->
  root = Yoga.Node.create()
  root.setFlexDirection FlexDirection.Row
  root.setWidth 10
  root.setHeight 20

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc neverNegative
  root_child0.setMargin Edge.Start, 20
  root.insertChild root_child0, 0

