  root_child0.setWidth 100
  root_child0.setHeight 100
  root_child0.setPadding Edge.Top, 0
  root_child0.setMeasureFunc measure100
  root.insertChild root_child0, 0

  root_child1 = Yoga.Node.create()
  root_child1.setWidth 100
  root_child1.setHeight 100
  root_child1.setPadding Edge.Top, 100
  root_child1.setMeasureFunc measure100
  root.insertChild root_child1, 1

  root_child2 = Yoga.Node.create()
  root_child2.setPadding Edge.Top, '10%'
  root_child2.setMeasureFunc measure100
  root.insertChild root_child2, 2

  root_child3 = Yoga.Node.create()
  root_child3.setPadding Edge.Top, '20%'
  root_child3.setMeasureFunc measure100
  root.insertChild root_child3, 3

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root.getComputedLeft(), 0
  eq root.getComputedTop(), 0
  eq root.getComputedWidth(), 500
  eq root.getComputedHeight(), 500
  eq root_child0.getComputedLeft(), 0
  eq root_child0.getComputedTop(), 0
  eq root_child0.getComputedWidth(), 100
  eq root_child0.getComputedHeight(), 100
  eq root_child1.getComputedLeft(), 100
  eq root_child1.getComputedTop(), 0
  eq root_child1.getComputedWidth(), 100
  eq root_child1.getComputedHeight(), 100
  eq root_child2.getComputedLeft(), 200
  eq root_child2.getComputedTop(), 0
  eq root_child2.getComputedWidth(), 100
  eq root_child2.getComputedHeight(), 150
  eq root_child3.getComputedLeft(), 300
  eq root_child3.getComputedTop(), 0
  eq root_child3.getComputedWidth(), 100
  eq root_child3.getComputedHeight(), 200

test 'percent_padding_and_percent_margin_with_measure_func', ->
  root = Yoga.Node.create()
  root.setFlexDirection FlexDirection.Row
  root.setAlignItems Align.FlexStart
  root.setAlignContent Align.FlexStart
  root.setWidth 500
  root.setHeight 500

  root_child0 = Yoga.Node.create()
  root_child0.setWidth 100
  root_child0.setHeight 100
  root_child0.setPadding Edge.Top, 0
  root_child0.setMeasureFunc measure100
  root.insertChild root_child0, 0

  root_child1 = Yoga.Node.create()
  root_child1.setWidth 100
  root_child1.setHeight 100
  root_child1.setPadding Edge.Top, 100
  root_child1.setMeasureFunc measure100
  root.insertChild root_child1, 1

  root_child2 = Yoga.Node.create()
  root_child2.setPadding Edge.Top, '10%'
  root_child2.setMargin Edge.Top, '10%'
  root_child2.setMeasureFunc measure100
  root.insertChild root_child2, 2

  root_child3 = Yoga.Node.create()
  root_child3.setPadding Edge.Top, '20%'
  root_child3.setMargin Edge.Top, '20%'
  root_child3.setMeasureFunc measure100
  root.insertChild root_child3, 3

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root.getComputedLeft(), 0
  eq root.getComputedTop(), 0
  eq root.getComputedWidth(), 500
  eq root.getComputedHeight(), 500
  eq root_child0.getComputedLeft(), 0
  eq root_child0.getComputedTop(), 0
  eq root_child0.getComputedWidth(), 100
  eq root_child0.getComputedHeight(), 100
  eq root_child1.getComputedLeft(), 100
  eq root_child1.getComputedTop(), 0
  eq root_child1.getComputedWidth(), 100
  eq root_child1.getComputedHeight(), 100
  eq root_child2.getComputedLeft(), 200
  eq root_child2.getComputedTop(), 50
  eq root_child2.getComputedWidth(), 100
  eq root_child2.getComputedHeight(), 150
  eq root_child3.getComputedLeft(), 300
  eq root_child3.getComputedTop(), 100
  eq root_child3.getComputedWidth(), 100
  eq root_child3.getComputedHeight(), 200

test 'measure_content_box', ->
  root = Yoga.Node.create()
  root.setWidth 100
  root.setHeight 200
  root.setBoxSizing BoxSizing.ContentBox
  root.setPadding Edge.All, 5
  root.setBorder Edge.All, 10
  measureCount = 0

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc counting halves, -> measureCount += 1
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq measureCount, 1
  eq root.getComputedLeft(), 0
  eq root.getComputedTop(), 0
  eq root.getComputedWidth(), 130
  eq root.getComputedHeight(), 230
  eq root_child0.getComputedLeft(), 15
  eq root_child0.getComputedTop(), 15
  eq root_child0.getComputedWidth(), 100
  eq root_child0.getComputedHeight(), 100

test 'measure_border_box', ->
  root = Yoga.Node.create()
  root.setWidth 100
  root.setHeight 200
  root.setBoxSizing BoxSizing.BorderBox
  root.setPadding Edge.All, 5
  root.setBorder Edge.All, 10
  measureCount = 0

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc counting halves, -> measureCount += 1
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq measureCount, 1
  eq root.getComputedLeft(), 0
  eq root.getComputedTop(), 0
  eq root.getComputedWidth(), 100
  eq root.getComputedHeight(), 200
  eq root_child0.getComputedLeft(), 15
  eq root_child0.getComputedTop(), 15
  eq root_child0.getComputedWidth(), 70
  eq root_child0.getComputedHeight(), 85

test 'min_width_larger_than_width_propagates_to_auto_parent', ->
  root = Yoga.Node.create()

  root_child0 = Yoga.Node.create()
  root_child0.setFlexDirection FlexDirection.Row
  root_child0.setHeight 50
  root.insertChild root_child0, 0

  root_child0_child0 = Yoga.Node.create()
  root_child0_child0.setWidth 50
  root_child0_child0.setMinWidth 100
  root_child0_child0.setHeight 50
  root_child0.insertChild root_child0_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root.getComputedLeft(), 0
  eq root.getComputedTop(), 0
  eq root.getComputedWidth(), 100
  eq root.getComputedHeight(), 50
  eq root_child0.getComputedLeft(), 0
  eq root_child0.getComputedTop(), 0
  eq root_child0.getComputedWidth(), 100
  eq root_child0.getComputedHeight(), 50
  eq root_child0_child0.getComputedLeft(), 0
  eq root_child0_child0.getComputedTop(), 0
  eq root_child0_child0.getComputedWidth(), 100
  eq root_child0_child0.getComputedHeight(), 50

# ==[ tests/YGMeasureCacheTest.cpp ]==

console.log "\ntests/YGMeasureCacheTest.cpp"

measureMax =! (width, widthMode, height, heightMode) ->
  width: if widthMode is MeasureMode.Undefined then 10 else width
  height: if heightMode is MeasureMode.Undefined then 10 else height

measureMin =! (width, widthMode, height, heightMode) ->
  width: if widthMode is MeasureMode.Undefined or (widthMode is MeasureMode.AtMost and width > 10) then 10 else width
  height: if heightMode is MeasureMode.Undefined or (heightMode is MeasureMode.AtMost and height > 10) then 10 else height

measure84x49 =! -> { width: 84, height: 49 }

test 'measure_once_single_flexible_child', ->
  root = Yoga.Node.create()
  root.setFlexDirection FlexDirection.Row
  root.setAlignItems Align.FlexStart
  root.setWidth 100
  root.setHeight 100

  root_child0 = Yoga.Node.create()
  measureCount = 0
  root_child0.setMeasureFunc counting measureMax, -> measureCount += 1
  root_child0.setFlexGrow 1
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq measureCount, 1

test 'remeasure_with_same_exact_width_larger_than_needed_height', ->
  root = Yoga.Node.create()

  root_child0 = Yoga.Node.create()
  measureCount = 0
  root_child0.setMeasureFunc counting measureMin, -> measureCount += 1
  root.insertChild root_child0, 0

  root.calculateLayout 100, 100, Direction.LTR

  root.calculateLayout 100, 50, Direction.LTR

  eq measureCount, 1

test 'remeasure_with_same_atmost_width_larger_than_needed_height', ->
  root = Yoga.Node.create()
  root.setAlignItems Align.FlexStart

  root_child0 = Yoga.Node.create()
  measureCount = 0
  root_child0.setMeasureFunc counting measureMin, -> measureCount += 1
  root.insertChild root_child0, 0

  root.calculateLayout 100, 100, Direction.LTR

  root.calculateLayout 100, 50, Direction.LTR

  eq measureCount, 1

test 'remeasure_with_computed_width_larger_than_needed_height', ->
  root = Yoga.Node.create()
  root.setAlignItems Align.FlexStart

  root_child0 = Yoga.Node.create()
  measureCount = 0
  root_child0.setMeasureFunc counting measureMin, -> measureCount += 1
  root.insertChild root_child0, 0

  root.calculateLayout 100, 100, Direction.LTR

  root.setAlignItems Align.Stretch

  root.calculateLayout 10, 50, Direction.LTR

  eq measureCount, 1

test 'remeasure_with_atmost_computed_width_undefined_height', ->
  root = Yoga.Node.create()
  root.setAlignItems Align.FlexStart

  root_child0 = Yoga.Node.create()
  measureCount = 0
  root_child0.setMeasureFunc counting measureMin, -> measureCount += 1
  root.insertChild root_child0, 0

  root.calculateLayout 100, undefined, Direction.LTR

  root.calculateLayout 10, undefined, Direction.LTR

  eq measureCount, 1

test 'remeasure_with_already_measured_value_smaller_but_still_float_equal', ->
  measureCount = 0

  root = Yoga.Node.create()
  root.setWidth 288
  root.setHeight 288
  root.setFlexDirection FlexDirection.Row

  root_child0 = Yoga.Node.create()
  root_child0.setPadding Edge.All, 2.88
  root_child0.setFlexDirection FlexDirection.Row
  root.insertChild root_child0, 0

  root_child0_child0 = Yoga.Node.create()
  root_child0_child0.setMeasureFunc counting measure84x49, -> measureCount += 1
  root_child0.insertChild root_child0_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  # Upstream asserts 1. The 84 cells measured come back as an exact
  # offer of 89.76 − 5.76, which is 84.00000000000001; Yoga's cache calls
  # the two equal within a tolerance and answers from the measurement.
  # Here the cache compares exactly (PLAN §5), so the leaf is measured
  # again, and answers the same.
  eq measureCount, 2
  eq root_child0_child0.getComputedWidth(), 84

