  eq constraints[0].height, 100
  eq constraints[0].heightMode, MeasureMode.AtMost

# ==[ tests/YGRoundingMeasureFuncTest.cpp ]==

console.log "\ntests/YGRoundingMeasureFuncTest.cpp"

measureFloor =! -> { width: 10.2, height: 10.2 }
measureCeil =! -> { width: 10.5, height: 10.5 }
measureFractial =! -> { width: 0.5, height: 0.5 }

# The grid here has one scale, a cell, so each case keeps what upstream
# asserts at a point scale factor of 1.

test 'rounding_feature_with_custom_measure_func_floor', ->
  root = Yoga.Node.create()

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc measureFloor
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root_child0.getComputedWidth(), 11
  eq root_child0.getComputedHeight(), 11

test 'rounding_feature_with_custom_measure_func_ceil', ->
  root = Yoga.Node.create()

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc measureCeil
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root_child0.getComputedWidth(), 11
  eq root_child0.getComputedHeight(), 11

# Upstream lays this out at a scale of 2 alone, and asserts 0.5 × 0.5 at
# 73.5. The boxes held here are `yoga-layout` 3.2.1's at a scale of 1:
# the corner rounds down, and the far edge, at 74.125, rounds up.
test 'rounding_feature_with_custom_measure_and_fractial_matching_scale', ->
  root = Yoga.Node.create()
  root.setPositionType PositionType.Absolute

  root_child0 = Yoga.Node.create()
  root_child0.setPosition Edge.Left, 73.625
  root_child0.setPositionType PositionType.Relative
  root_child0.setMeasureFunc measureFractial
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root_child0.getComputedWidth(), 2
  eq root_child0.getComputedHeight(), 1
  eq root_child0.getComputedLeft(), 73

# ==[ javascript/tests/YGMeasureTest.test.ts ]==
#
# Its other case, and YGMeasureCacheTest.test.ts's one, are ports of C++
# cases above, under the same names.

console.log "\njavascript/tests/YGMeasureTest.test.ts"

test 'dont_fail_with_incomplete_measure_dimensions', ->
  heightOnly = 0
  widthOnly = 0
  empty = 0

  root = Yoga.Node.create()
  root.setWidth 100
  root.setHeight 100

  node1 = Yoga.Node.create()
  node2 = Yoga.Node.create()
  node3 = Yoga.Node.create()

  root.insertChild node1, root.getChildCount()
  root.insertChild node2, root.getChildCount()
  root.insertChild node3, root.getChildCount()

  node1.setMeasureFunc counting (-> { height: 10 }), -> heightOnly += 1
  node2.setMeasureFunc counting (-> { width: 10 }), -> widthOnly += 1
  node3.setMeasureFunc counting (-> {}), -> empty += 1

  root.calculateLayout undefined, undefined, Direction.LTR

  eq heightOnly, 1
  eq widthOnly, 1
  eq empty, 1

  eq node1.getComputedWidth(), 100
  eq node1.getComputedHeight(), 10

  eq node2.getComputedWidth(), 100
  eq node2.getComputedHeight(), 0

  eq node3.getComputedWidth(), 100
  eq node3.getComputedHeight(), 0

# ==[ javascript/tests/YGDirtiedTest.test.ts ]==

console.log "\njavascript/tests/YGDirtiedTest.test.ts"

test 'dirtied', ->
  root = Yoga.Node.create()
  root.setAlignItems Align.FlexStart
  root.setWidth 100
  root.setHeight 100

  root.calculateLayout undefined, undefined, Direction.LTR

  dirtied = 0
  root.setDirtiedFunc -> dirtied += 1

  # only nodes with a measure function can be marked dirty
  root.setMeasureFunc -> { width: 0, height: 0 }

  eq dirtied, 0

  # dirtied func MUST be called in case of explicit dirtying.
  root.markDirty()
  eq dirtied, 1

  # dirtied func MUST be called ONCE.
  root.markDirty()
  eq dirtied, 1

test 'dirtied_propagation', ->
  root = Yoga.Node.create()
  root.setAlignItems Align.FlexStart
  root.setWidth 100
  root.setHeight 100

  root_child0 = Yoga.Node.create()
  root_child0.setAlignItems Align.FlexStart
  root_child0.setWidth 50
  root_child0.setHeight 20
  root_child0.setMeasureFunc -> { width: 0, height: 0 }
  root.insertChild root_child0, 0

  root_child1 = Yoga.Node.create()
  root_child1.setAlignItems Align.FlexStart
  root_child1.setWidth 50
  root_child1.setHeight 20
  root.insertChild root_child1, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  dirtied = 0
  root.setDirtiedFunc -> dirtied += 1

  eq dirtied, 0

  # dirtied func MUST be called for the first time.
  root_child0.markDirty()
  eq dirtied, 1

  # dirtied func must NOT be called for the second time.
  root_child0.markDirty()
  eq dirtied, 1

test 'dirtied_hierarchy', ->
  root = Yoga.Node.create()
  root.setAlignItems Align.FlexStart
  root.setWidth 100
  root.setHeight 100

  root_child0 = Yoga.Node.create()
  root_child0.setAlignItems Align.FlexStart
  root_child0.setWidth 50
  root_child0.setHeight 20
  root_child0.setMeasureFunc -> { width: 0, height: 0 }
  root.insertChild root_child0, 0

  root_child1 = Yoga.Node.create()
  root_child1.setAlignItems Align.FlexStart
  root_child1.setWidth 50
  root_child1.setHeight 20
  root_child0.setMeasureFunc -> { width: 0, height: 0 }
  root.insertChild root_child1, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  dirtied = 0
  root_child0.setDirtiedFunc -> dirtied += 1

  eq dirtied, 0

  # dirtied func must NOT be called for descendants.
  # NOTE: nodes without a measure function cannot be marked dirty manually,
  # but nodes with a measure function can not have children.
  # Update the width to dirty the node instead.
  root.setWidth 110
  eq dirtied, 0

  # dirtied func MUST be called in case of explicit dirtying.
  root_child0.markDirty()
  eq dirtied, 1

test 'dirtied_reset', ->
  root = Yoga.Node.create()
  root.setAlignItems Align.FlexStart
  root.setWidth 100
  root.setHeight 100
  root.setMeasureFunc -> { width: 0, height: 0 }

  root.calculateLayout undefined, undefined, Direction.LTR

  dirtied = 0
  root.setDirtiedFunc -> dirtied += 1

  eq dirtied, 0

  # dirtied func MUST be called in case of explicit dirtying.
  root.markDirty()
  eq dirtied, 1

  # recalculate so the root is no longer dirty
  root.calculateLayout undefined, undefined, Direction.LTR

  root.reset()
  root.setAlignItems Align.FlexStart
  root.setWidth 100
  root.setHeight 100
  root.setMeasureFunc -> { width: 0, height: 0 }

  root.markDirty()

  # dirtied func must NOT be called after reset.
  root.markDirty()
  eq dirtied, 1

# ==[ javascript/tests/YGComputed{Padding,Border,Margin}Test.test.ts ]==
#
# The left-to-right half of each. The engine keeps the padding and the
# border it resolved and no margin, so `margin_start` reads the margin
# where it lands: in the root's own position.

console.log "\njavascript/tests/YGComputedPaddingTest, YGComputedBorderTest, YGComputedMarginTest"

test 'padding_start', ->
  root = Yoga.Node.create()
  root.setWidth 100
  root.setHeight 100
  root.setPadding Edge.Start, '10%'

  root.calculateLayout 100, 100, Direction.LTR

  eq root.getComputedPadding(Edge.Left), 10
  eq root.getComputedPadding(Edge.Right), 0

test 'border_start', ->
  root = Yoga.Node.create()
  root.setWidth 100
  root.setHeight 100
  root.setBorder Edge.Start, 10

  root.calculateLayout 100, 100, Direction.LTR

  eq root.getComputedBorder(Edge.Left), 10
  eq root.getComputedBorder(Edge.Right), 0

test 'margin_start', ->
  root = Yoga.Node.create()
  root.setWidth 100
  root.setHeight 100
  root.setMargin Edge.Start, '10%'

  root.calculateLayout 100, 100, Direction.LTR

  eq root.getComputedLeft(), 10
  eq root.getComputedWidth(), 100
