# Yoga's hand-written cases for measure functions, the measure cache,
# dirtying, and computed edges, ported one call for one.
#
#   Upstream: facebook/yoga
#             tests/YGMeasureTest.cpp, YGMeasureCacheTest.cpp,
#             YGMeasureModeTest.cpp, YGRoundingMeasureFuncTest.cpp
#             javascript/tests/YGMeasureTest.test.ts,
#             YGDirtiedTest.test.ts, YGComputedPaddingTest.test.ts,
#             YGComputedBorderTest.test.ts, YGComputedMarginTest.test.ts
#   Commit:   9d159f2d3d8dbc777e1f82c20b94e369c113d608
#
# A port under Yoga's MIT license, © Meta Platforms, Inc. and affiliates;
# the text is in test/yoga/LICENSE. Each case keeps its upstream name,
# builds the same tree through the `yoga-layout` shim, and asserts what
# the upstream case asserts. Where a case is cut or adapted, a comment
# at the case says how; test/yoga/SOURCE.md lists what is not ported.
#
#   rip test/yoga-hand.rip

import { test, eq, ok } from 'rip/testing'
import Yoga, { Align, BoxSizing, Direction, Edge, FlexDirection, Justify, MeasureMode, Overflow, PositionType } from './yoga-shim.rip'

# Upstream keeps a counter, or a list of the offers a node was made, in
# the node's context. Here the measure function is wrapped instead.
counting =! (measure, bump) ->
  (width, widthMode, height, heightMode) ->
    bump()
    measure width, widthMode, height, heightMode

recording =! (constraints) ->
  (width, widthMode, height, heightMode) ->
    constraints.push { width, widthMode, height, heightMode }
    width: if widthMode is MeasureMode.Undefined then 10 else width
    height: if heightMode is MeasureMode.Undefined then 10 else width

# ==[ tests/YGMeasureTest.cpp ]==

console.log "\ntests/YGMeasureTest.cpp"

measure10 =! -> { width: 10, height: 10 }
measure90x10 =! -> { width: 90, height: 10 }
measure100 =! -> { width: 100, height: 100 }
halves =! (width, widthMode, height) -> { width: 0.5 * width, height: 0.5 * height }

wrappingText =! (width, widthMode) ->
  if widthMode is MeasureMode.Undefined or width >= 68 then { width: 68, height: 16 } else { width: 50, height: 32 }

neverNegative =! (width, widthMode, height) ->
  ok width >= 0
  ok height >= 0
  { width: 0, height: 0 }

test 'dont_measure_single_grow_shrink_child', ->
  root = Yoga.Node.create()
  root.setWidth 100
  root.setHeight 100
  measureCount = 0

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc counting measure10, -> measureCount += 1
  root_child0.setFlexGrow 1
  root_child0.setFlexShrink 1
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq measureCount, 0

test 'measure_absolute_child_with_no_constraints', ->
  root = Yoga.Node.create()

  root_child0 = Yoga.Node.create()
  root.insertChild root_child0, 0
  measureCount = 0

  root_child0_child0 = Yoga.Node.create()
  root_child0_child0.setPositionType PositionType.Absolute
  root_child0_child0.setMeasureFunc counting measure10, -> measureCount += 1
  root_child0.insertChild root_child0_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq measureCount, 1

test 'dont_measure_when_min_equals_max', ->
  root = Yoga.Node.create()
  root.setAlignItems Align.FlexStart
  root.setWidth 100
  root.setHeight 100
  measureCount = 0

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc counting measure10, -> measureCount += 1
  root_child0.setMinWidth 10
  root_child0.setMaxWidth 10
  root_child0.setMinHeight 10
  root_child0.setMaxHeight 10
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq measureCount, 0
  eq root_child0.getComputedLeft(), 0
  eq root_child0.getComputedTop(), 0
  eq root_child0.getComputedWidth(), 10
  eq root_child0.getComputedHeight(), 10

