test 'exactly_measure_stretched_child_column', ->
  constraints = []

  root = Yoga.Node.create()
  root.setWidth 100
  root.setHeight 100

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc recording constraints
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq constraints.length, 1
  eq constraints[0].width, 100
  eq constraints[0].widthMode, MeasureMode.Exactly

