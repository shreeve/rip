  root_child0.setMaxWidth '10%'
  root_child0.setMinHeight '10%'
  root_child0.setMaxHeight '10%'
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq measureCount, 0
  eq root_child0.getComputedLeft(), 0
  eq root_child0.getComputedTop(), 0
  eq root_child0.getComputedWidth(), 10
  eq root_child0.getComputedHeight(), 10

test 'measure_nodes_with_margin_auto_and_stretch', ->
  root = Yoga.Node.create()
  root.setWidth 500
  root.setHeight 500

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc measure10
  root_child0.setMargin Edge.Left, 'auto'
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root_child0.getComputedLeft(), 490
  eq root_child0.getComputedTop(), 0
  eq root_child0.getComputedWidth(), 10
  eq root_child0.getComputedHeight(), 10

