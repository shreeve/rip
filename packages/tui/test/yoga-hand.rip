test 'measure_enough_size_should_be_in_single_line', ->
  root = Yoga.Node.create()
  root.setWidth 100

  root_child0 = Yoga.Node.create()
  root_child0.setAlignSelf Align.FlexStart
  root_child0.setMeasureFunc wrappingText
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root_child0.getComputedWidth(), 68
  eq root_child0.getComputedHeight(), 16

test 'measure_not_enough_size_should_wrap', ->
  root = Yoga.Node.create()
  root.setWidth 55

  root_child0 = Yoga.Node.create()
  root_child0.setAlignSelf Align.FlexStart
  root_child0.setMeasureFunc wrappingText
  root.insertChild root_child0, 0

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root_child0.getComputedWidth(), 50
  eq root_child0.getComputedHeight(), 32

test 'measure_zero_space_should_grow', ->
  root = Yoga.Node.create()
  root.setHeight 200
  root.setFlexDirection FlexDirection.Column
  root.setFlexGrow 0
  measureCount = 0

  root_child0 = Yoga.Node.create()
  root_child0.setFlexDirection FlexDirection.Column
  root_child0.setPadding Edge.All, 100
  root_child0.setMeasureFunc counting measure10, -> measureCount += 1
  root.insertChild root_child0, 0

  root.calculateLayout 282, undefined, Direction.LTR

  eq root_child0.getComputedWidth(), 282
  eq root_child0.getComputedTop(), 0

test 'measure_flex_direction_row_and_padding', ->
  root = Yoga.Node.create()
  root.setFlexDirection FlexDirection.Row
  root.setPadding Edge.Left, 25
  root.setPadding Edge.Top, 25
  root.setPadding Edge.Right, 25
  root.setPadding Edge.Bottom, 25
  root.setWidth 50
  root.setHeight 50

  root_child0 = Yoga.Node.create()
  root_child0.setMeasureFunc wrappingText
  root.insertChild root_child0, 0

  root_child1 = Yoga.Node.create()
  root_child1.setWidth 5
  root_child1.setHeight 5
  root.insertChild root_child1, 1

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root.getComputedLeft(), 0
  eq root.getComputedTop(), 0
  eq root.getComputedWidth(), 50
  eq root.getComputedHeight(), 50
  eq root_child0.getComputedLeft(), 25
  eq root_child0.getComputedTop(), 25
  eq root_child0.getComputedWidth(), 50
  eq root_child0.getComputedHeight(), 0
  eq root_child1.getComputedLeft(), 75
  eq root_child1.getComputedTop(), 25
  eq root_child1.getComputedWidth(), 5
  eq root_child1.getComputedHeight(), 5

