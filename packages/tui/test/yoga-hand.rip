test 'percent_with_text_node', ->
  root = Yoga.Node.create()
  root.setFlexDirection FlexDirection.Row
  root.setJustifyContent Justify.SpaceBetween
  root.setAlignItems Align.Center
  root.setWidth 100
  root.setHeight 80

  root_child0 = Yoga.Node.create()
  root.insertChild root_child0, 0

  root_child1 = Yoga.Node.create()
  root_child1.setMeasureFunc measure90x10
  root_child1.setMaxWidth '50%'
  root_child1.setPadding Edge.Top, '50%'
  root.insertChild root_child1, 1

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root.getComputedLeft(), 0
  eq root.getComputedTop(), 0
  eq root.getComputedWidth(), 100
  eq root.getComputedHeight(), 80
  eq root_child0.getComputedLeft(), 0
  eq root_child0.getComputedTop(), 40
  eq root_child0.getComputedWidth(), 0
  eq root_child0.getComputedHeight(), 0
  eq root_child1.getComputedLeft(), 50
  eq root_child1.getComputedTop(), 10
  eq root_child1.getComputedWidth(), 50
  eq root_child1.getComputedHeight(), 60

test 'percent_margin_with_measure_func', ->
  root = Yoga.Node.create()
  root.setFlexDirection FlexDirection.Row
  root.setWidth 500
  root.setHeight 500

  root_child0 = Yoga.Node.create()
  root_child0.setWidth 100
  root_child0.setHeight 100
  root_child0.setMargin Edge.Top, 0
  root_child0.setMeasureFunc measure100
  root.insertChild root_child0, 0

  root_child1 = Yoga.Node.create()
  root_child1.setWidth 100
  root_child1.setHeight 100
  root_child1.setMargin Edge.Top, 100
  root_child1.setMeasureFunc measure100
  root.insertChild root_child1, 1

  root_child2 = Yoga.Node.create()
  root_child2.setWidth 100
  root_child2.setHeight 100
  root_child2.setMargin Edge.Top, '10%'
  root_child2.setMeasureFunc measure100
  root.insertChild root_child2, 2

  root_child3 = Yoga.Node.create()
  root_child3.setWidth 100
  root_child3.setHeight 100
  root_child3.setMargin Edge.Top, '20%'
  root_child3.setMeasureFunc measure100
  root.insertChild root_child3, 3

  root.calculateLayout undefined, undefined, Direction.LTR

  eq root.getComputedLeft(), 0
  eq root.getComputedTop(), 0
  eq root.getComputedWidth(), 500
  eq root.getComputedHeight(), 500
  eq root_child0.getComputedLeft(), 0
  eq root_child0.getComputedTop(), 0
  eq root_child0.getComputedWidth(), 100
  eq root_child0.getComputedHeight(), 100
  eq root_child1.getComputedLeft(), 100
  eq root_child1.getComputedTop(), 100
  eq root_child1.getComputedWidth(), 100
  eq root_child1.getComputedHeight(), 100
  eq root_child2.getComputedLeft(), 200
  eq root_child2.getComputedTop(), 50
  eq root_child2.getComputedWidth(), 100
  eq root_child2.getComputedHeight(), 100
  eq root_child3.getComputedLeft(), 300
  eq root_child3.getComputedTop(), 100
  eq root_child3.getComputedWidth(), 100
  eq root_child3.getComputedHeight(), 100

test 'percent_padding_with_measure_func', ->
  root = Yoga.Node.create()
