# An incremental layout equals a fresh one. A random tree is laid out,
# then changed a step at a time — a style set, set to what it holds, or
# set and put back; a text rewritten or replaced; a node hidden, shown,
# removed, inserted, reordered, moved to another parent, or taken out,
# changed, and put back elsewhere; the width or the height of the space —
# and laid out again after every step. Each time, every box in the tree,
# text nodes and comment anchors included, must equal the box of a twin
# cloned from the live tree and laid out once, and no node may be left
# dirty. Trees carry bare text children, comment anchors, and measure
# functions whose height follows the width they are offered.
#
# Every round draws from its own seed, so a failure replays alone:
#
#   rip test/fuzz.rip              the checked-in seeds
#   rip test/fuzz.rip 7            seed 7, every round
#   rip test/fuzz.rip 7 412        seed 7, round 412 only, narrated
#
# A run stops at its first failure and prints the step, the two trees,
# and the command that replays the round.

import { test, ok } from 'rip/testing'
import { Element, Text, Node } from '../document.rip'
import { layout } from '../layout.rip'

SEEDS =! [1, 7, 13, 21, 42]
ROUNDS =! 1500
STEPS =! 10

STYLES =! {
  flexDirection: ['row', 'column', 'row-reverse', 'column-reverse', undefined]
  flexWrap: ['wrap', 'nowrap', 'wrap-reverse', undefined]
  flexGrow: [0, 1, 2, 0.5, undefined]
  flexShrink: [0, 1, 3, undefined]
  flexBasis: [0, 10, '50%', 'auto', undefined]
  flex: [1, 2, undefined]
  width: [2, 3, 5, 20, 40, '50%', '100%', '33%', 'auto', undefined, undefined]
  height: [1, 3, 10, '50%', '100%', undefined, undefined]
  minWidth: [3, '20%', undefined, undefined]
  maxWidth: [10, 30, '80%', undefined, undefined]
  minHeight: [2, '30%', undefined, undefined]
  maxHeight: [4, 8, '60%', undefined, undefined]
  aspectRatio: [1, 2, 0.5, undefined, undefined]
  padding: [1, 2, '5%', undefined, undefined]
  paddingX: [1, 3, undefined, undefined]
  paddingTop: [1, '10%', undefined, undefined]
  margin: [1, -1, 'auto', '3%', undefined, undefined]
  marginLeft: [2, -2, 'auto', undefined, undefined]
  marginY: [1, undefined, undefined]
  borderStyle: ['single', undefined, undefined]
  gap: [1, 2, '10%', undefined, undefined]
  rowGap: [1, '20%', undefined, undefined]
  alignItems: ['flex-start', 'center', 'flex-end', 'stretch', 'baseline', undefined]
  alignSelf: ['auto', 'flex-start', 'center', 'flex-end', 'stretch', 'baseline', undefined, undefined]
  alignContent: ['flex-start', 'center', 'flex-end', 'stretch', 'space-between', 'space-around', 'space-evenly', undefined]
  justifyContent: ['flex-start', 'center', 'flex-end', 'space-between', 'space-around', 'space-evenly', undefined]
  position: ['static', 'static', 'relative', 'absolute', 'absolute', undefined, undefined]
  left: [1, '10%', undefined, undefined]
  top: [1, '10%', undefined, undefined]
  right: [2, undefined, undefined, undefined]
  bottom: [1, '5%', undefined, undefined, undefined]
  display: ['none', 'flex', 'contents', 'contents', undefined, undefined, undefined]
  boxSizing: ['content-box', 'border-box', undefined]
  overflow: ['scroll', 'hidden', undefined, undefined]
}
KEYS =! Object.keys STYLES

# Texts of equal width and different height sit side by side, so a change
# of height alone is one the fuzz makes.
# Wide characters, clusters, and words no row can break sit among the
# ASCII, so a text can answer WIDER than it is offered and a wrap can
# turn on a cluster's width.
wide = (...codes) -> String.fromCodePoint ...codes
WORDS =! [
  'a', 'hello', 'hello world', 'two\nlines here', '', 'x'.repeat(30), 'one\ntwo\nthree', 'abcde', 'fghij', 'abc\nde'
  wide(0x4E2D) + 'on', wide(0x65E5, 0x672C, 0x8A9E) + ' ' + wide(0x65E5, 0x672C), 'a' + wide(0x4E2D) + 'b ' + wide(0x4E2D, 0x4E2D)
  wide(0x1F468, 0x200D, 0x1F469, 0x200D, 0x1F467) + ' ok', 'e' + wide(0x301) + ' ' + wide(0x1F1FA, 0x1F1F8) + 'x'
  wide(0x9AC, 0x9BE, 0x982, 0x9B2, 0x9BE) + ' go', 'supercalifragilistic', 'un' + wide(0x4E2D).repeat(9) + ' z'
]
PROSE =! ['the quick brown fox jumps over the lazy dog', 'aa bb cc dd ee ff gg', 'z']

state = 1
rnd = ->
  state = (state * 1664525 + 1013904223) % 4294967296
  state / 4294967296
pick = (list) -> list[Math.floor rnd() * list.length]

# A measure function that wraps `text` on spaces at the width it is
# offered, so its height follows its width.
wrapper = (text) ->
  (wide, mode) ->
    return { width: text.length, height: 1 } if mode is 0 or text.length <= wide
    lines = 1
    at = 0
    widest = 0
    for word in text.split ' '
      if at > 0 and at + 1 + word.length > wide
        lines += 1
        widest = Math.max widest, at
        at = word.length
      else
        at += (if at > 0 then 1 else 0) + word.length
    { width: (if mode is 1 then wide else Math.max widest, at), height: lines }

make = (depth) ->
  roll = rnd()
  if depth > 0 and roll < 0.2
    node = Element.new 'span'
    node.appendChild Text.new pick WORDS
    return node
  return Text.new pick WORDS if depth > 0 and roll < 0.27
  if depth > 0 and roll < 0.32
    node = Element.new 'div'
    node.prose = pick PROSE
    node.measure = wrapper node.prose
    return node
  node = Element.new 'div'
  for n in [0...Math.floor rnd() * 6]
    key = pick KEYS
    value = pick STYLES[key]
    node.styles[key] = value unless value is undefined
  if depth < 4
    for n in [0...Math.floor rnd() * 4]
      node.appendChild Node.new 8 if rnd() < 0.1
      node.appendChild make depth + 1
  node

# The twin: the live tree's structure, styles, texts, and measure
# functions, with none of its layout.
clone = (node) ->
  return Text.new node.data if node.nodeType is 3
  return Node.new 8 if node.nodeType is 8
  copy = Element.new node.tagName
  copy.styles[key] = value for own key, value of node.styles
  if node.measure
    copy.prose = node.prose
    copy.measure = wrapper node.prose
  kid = node.firstChild
  while kid
    copy.appendChild clone kid
    kid = kid.nextSibling
  copy

# The nodes a step may pick: every element and text outside a leaf.
all = (node, out, inLeaf = false) ->
  out.push node unless inLeaf or node.nodeType is 8
  inLeaf or= node.tagName is 'span' or node.measure?
  kid = node.firstChild
  while kid
    all kid, out, inLeaf
    kid = kid.nextSibling
  out

inside = (node, top) ->
  while node
    return true if node is top
    node = node.parentNode
  false

boxy = (node) -> node.nodeType is 1 and node.tagName is 'div' and not node.measure

homesFor = (nodes, node) -> nodes.filter (home) -> boxy(home) and not inside(home, node)

# Write a style the way an app does, through the document — which has no
# `overflow` yet, so that one is written as the Yoga harness writes it.
write = (node, key, value) ->
  return node.set key, value unless key is 'overflow'
  if value is undefined then delete node.styles[key] else node.styles[key] = value
  node.changed true

# One change to the live tree; answers what it did.
mutate = (root) ->
  nodes = all root, []
  node = pick nodes
  roll = rnd()
  if node.nodeType is 3
    node.data = pick WORDS
    return 'text rewritten'
  if node.tagName is 'span'
    if roll < 0.4
      node.firstChild.data = pick WORDS
      return 'span text rewritten'
    if roll < 0.7
      node.removeChild node.firstChild
      node.appendChild Text.new pick WORDS
      return 'span text replaced'
    node.toggleAttribute 'hidden', not node.styles.hidden
    return "span hidden #{node.styles.hidden}"
  if node.measure
    node.prose = pick PROSE
    node.measure = wrapper node.prose
    node.changed true
    return 'measure function replaced'
  if roll < 0.35
    key = pick KEYS
    value = pick STYLES[key]
    write node, key, value
    return "set #{key}: #{value}"
  if roll < 0.40
    key = pick KEYS
    held = node.styles[key]
    write node, key, pick STYLES[key]
    write node, key, held
    return "set and put back #{key}"
  if roll < 0.45
    key = pick KEYS
    write node, key, node.styles[key]
    return "set #{key} to what it holds"
  if roll < 0.52
    node.toggleAttribute 'hidden', not node.styles.hidden
    return "hidden #{node.styles.hidden}"
  if roll < 0.62 and node isnt root
    node.remove()
    return 'removed'
  if roll < 0.74 and node isnt root
    homes = homesFor nodes, node
    return 'nowhere to move' unless homes.length
    home = pick homes
    before = if home.firstChild and rnd() < 0.7 then pick(home.childNodes) else null
    before = null if before is node
    home.insertBefore node, before
    return 'moved to another parent'
  if roll < 0.80 and node.firstChild and node.firstChild isnt node.lastChild
    node.insertBefore node.lastChild, node.firstChild
    return 'last child moved first'
  if roll < 0.88 and node isnt root
    homes = homesFor nodes, node
    node.remove()
    node.set 'width', pick STYLES.width
    node.appendChild make 3
    inner = pick all node, []
    inner.set 'height', pick(STYLES.height) if boxy inner
    pick(homes).appendChild node if homes.length
    return 'taken out, changed, put back elsewhere'
  node.insertBefore make(3), (if node.firstChild and rnd() < 0.5 then node.firstChild else null)
  'subtree inserted'

boxes = (node, out) ->
  box = node.rect
  out.push "#{box.x},#{box.y},#{box.w},#{box.h}"
  kid = node.firstChild
  while kid
    boxes kid, out
    kid = kid.nextSibling
  out

dirtyLeft = (node) ->
  return true if node.dirty
  kid = node.firstChild
  while kid
    return true if dirtyLeft kid
    kid = kid.nextSibling
  false

# The tree as text: each node's styles, its box, and a mark where it is
# still dirty.
draw = (node, pad, out) ->
  box = node.rect
  what = if node.nodeType is 3 then "text #{JSON.stringify node.data}" else if node.nodeType is 8 then 'comment' else "#{node.tagName}#{if node.measure then ' measure ' + JSON.stringify(node.prose) else ''} #{JSON.stringify node.styles}"
  out.push "#{pad}#{what}  [#{box.x},#{box.y} #{box.w}×#{box.h}]#{if node.dirty then '  DIRTY' else ''}"
  kid = node.firstChild
  while kid
    draw kid, pad + '  ', out
    kid = kid.nextSibling
  out

# One round: a tree, and STEPS changes. Answers null, or what went wrong.
round = (start, number, narrate) ->
  state = (start * 2654435761 + number * 40503 + 1) % 4294967296
  root = make 0
  width = 60
  height = null
  layout root, width, height
  for step in [0...STEPS]
    roll = rnd()
    did = if roll < 0.15
      # A space of a few cells offers a text less than a wide cluster takes.
      width = if rnd() < 0.3 then 1 + Math.floor rnd() * 6 else 20 + Math.floor rnd() * 80
      "width #{width}"
    else if roll < 0.25
      height = if rnd() < 0.3 then null else 5 + Math.floor rnd() * 40
      "height #{height}"
    else
      mutate root
    console.log "  step #{step}: #{did}" if narrate
    layout root, width, height
    twin = clone root
    layout twin, width, height
    same = boxes(root, []).join(' ') is boxes(twin, []).join(' ')
    continue if same and not dirtyLeft root
    return [
      "seed #{start} round #{number} step #{step} (#{did}; space #{width} × #{height}): " + (if same then 'a node is still dirty after layout' else 'the incremental boxes are not the fresh ones')
      '  incremental:'
      ...draw(root, '    ', [])
      '  fresh:'
      ...draw(twin, '    ', [])
      "  replay: rip test/fuzz.rip #{start} #{number}"
    ].join '\n'
  null

def run(start, from, to, narrate)
  for number in [from...to]
    failure = round start, number, narrate
    if failure
      console.log failure
      ok false, failure.split('\n')[0]
      return
  ok true

console.log "\nIncremental layout equals fresh layout"

picked = Number process.argv[2]
only = process.argv[3]
if picked and only?
  test "seed #{picked}, round #{only}", -> run picked, Number(only), Number(only) + 1, true
else if picked
  test "seed #{picked}, #{ROUNDS} rounds of #{STEPS} steps", -> run picked, 0, ROUNDS, false
else
  for start in SEEDS
    test "seed #{start}, #{ROUNDS} rounds of #{STEPS} steps", -> run start, 0, ROUNDS, false
