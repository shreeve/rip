# The terminal document: the node surface a compiled render block calls.
# A node is one object for the tree, the layout, and the paint — it
# carries its links, its terminal styles, and its computed box. Every
# mutation arrives through a method here, so the document always knows
# what changed. A member the terminal cannot honor throws by name.

import { __setChildFailureReporter } from '../../src/runtime/components.js'
import { admit, blame } from './layout.rip'
import { allow, Damage, PARTS } from './paint.rip'
import { sanitize, refresh } from './text.rip'

# Styles that move boxes, and styles that only recolor cells.
LAYOUT =! [
  'flexDirection', 'flexWrap', 'flexGrow', 'flexShrink', 'flexBasis', 'flex'
  'alignItems', 'alignSelf', 'alignContent', 'justifyContent'
  'gap', 'rowGap', 'columnGap'
  'width', 'height', 'minWidth', 'minHeight', 'maxWidth', 'maxHeight', 'aspectRatio', 'boxSizing'
  'padding', 'paddingX', 'paddingY', 'paddingTop', 'paddingBottom', 'paddingLeft', 'paddingRight'
  'margin', 'marginX', 'marginY', 'marginTop', 'marginBottom', 'marginLeft', 'marginRight'
  'position', 'top', 'right', 'bottom', 'left'
  'display', 'hidden', 'borderStyle', 'borderTop', 'borderBottom', 'borderLeft', 'borderRight', 'wrap'
]
PAINT =! [
  'color', 'backgroundColor', 'bold', 'dimColor', 'italic', 'underline', 'strikethrough', 'inverse', 'link'
  'overflow', 'overflowX', 'overflowY', 'contentOffsetX', 'contentOffsetY'
  'borderColor', 'borderTopColor', 'borderBottomColor', 'borderLeftColor', 'borderRightColor'
  'borderDimColor', 'borderTopDimColor', 'borderBottomDimColor', 'borderLeftDimColor', 'borderRightDimColor'
  'borderBackgroundColor', 'borderTopBackgroundColor', 'borderBottomBackgroundColor', 'borderLeftBackgroundColor', 'borderRightBackgroundColor'
]

# Switches that stand unless they are turned off, so `false` is a value
# to keep and not a style taken away.
PRESENT =! Set.new ['hidden']   # keys the compiler writes as bare presence
# Keys whose `false` says something and is kept: an edge switched off,
# and an edge that stays bright under a dimmed border.
STANDING =! Set.new ['borderTop', 'borderBottom', 'borderLeft', 'borderRight',
  'borderTopDimColor', 'borderBottomDimColor', 'borderLeftDimColor', 'borderRightDimColor']

KIND =! Map.new()
KIND.set key, 'layout' for key in LAYOUT
KIND.set key, 'paint' for key in PAINT

# Attributes the runtime or an accessible component writes, which carry
# no terminal style: kept on the node, never rejected.
kept =! (key) -> key is 'data-part' or key is 'id' or key is 'role' or key.startsWith('aria-')

distance =! (a, b) ->
  row = (i for i in [0..b.length])
  for i in [1..a.length]
    corner = row[0]
    row[0] = i
    for j in [1..b.length]
      above = row[j]
      row[j] = Math.min row[j] + 1, row[j - 1] + 1, corner + (if a[i - 1] is b[j - 1] then 0 else 1)
      corner = above
  row[b.length]

# The real style a mistyped one most likely meant: the closest by edits,
# or one the typed word begins (`dim` for `dimColor`).
nearest =! (key) ->
  best = null
  score = 3
  for [name] in KIND
    return name if key.length > 2 and name.toLowerCase().startsWith key.toLowerCase()
    d = distance key.toLowerCase(), name.toLowerCase()
    if d < score
      best = name
      score = d
  best

unknown =! (key, tag) ->
  hint = nearest key
  Error.new "rip/tui: '#{key}' is not a terminal style of <#{tag}>" + (if hint then " — did you mean '#{hint}'?" else '')

# A reactive cell over a node's box, minted on the first `box` read, so
# a node nobody measures carries none.
watch =! (node) ->
  box := node.rect
  { read: (-> box), write: ((next) -> box = next) }

export NOWHERE =! Object.freeze { x: 0, y: 0, w: 0, h: 0 }

# The leaf that draws `node`'s words: the outermost text it is a run of.
# A `contents` text is no leaf — it lends its words to its parent, each
# a leaf of its own.
leafOf =! (node) ->
  node = node.parentNode while node.parentNode?.tagName is 'span' and node.parentNode.styles.display isnt 'contents'
  node

export class Node
  constructor: (@nodeType) ->
    @ownerDocument = null
    @parentNode = null
    @firstChild = null
    @lastChild = null
    @nextSibling = null
    @previousSibling = null
    @list = null
    @rect = NOWHERE
    @cell = null
    @dirty = true
    @stain = 3                       # what the painter has yet to survey (paint.rip)
    @bl = @bt = @br = @bb = 0        # the bounds of everything inked from here down
    @lay = null       # layout's record of the node
    @measure = null   # a function that sizes it, where one is set

  # The children as an array, rebuilt only after the list changed.
  get childNodes: ->
    unless @list
      @list = []
      kid = @firstChild
      while kid
        @list.push kid
        kid = kid.nextSibling
    @list

  appendChild: (node) -> @insertBefore node, null

  insertBefore: (node, ref) ->
    if node.nodeType is 11
      @insertBefore kid, ref for kid in [...node.childNodes]
      return node
    throw Error.new 'rip/tui: a node cannot be inserted into itself' if node is this
    throw Error.new 'rip/tui: a node cannot be inserted before itself' if node is ref
    throw Error.new 'rip/tui: insertBefore names a reference that is not a child' if ref and ref.parentNode isnt this
    node.parentNode?.removeChild node
    before = if ref then ref.previousSibling else @lastChild
    node.previousSibling = before
    node.nextSibling = ref
    if before then before.nextSibling = node else @firstChild = node
    if ref then ref.previousSibling = node else @lastChild = node
    node.parentNode = this
    if @tagName is 'span' and node.tagName is 'span'
      for own key of node.styles
        if KIND.get(key) is 'layout'
          throw blame Error.new("rip/tui: '#{key}' has no meaning on text nested in text — it is a run of words, styled by color and weight only"), node
    node.adopt @ownerDocument
    node.mark 3
    @list = null
    @changed true
    node

  removeChild: (node) ->
    throw Error.new 'rip/tui: removeChild names a node that is not a child' unless node.parentNode is this
    node.mark 3
    before = node.previousSibling
    after = node.nextSibling
    if before then before.nextSibling = after else @firstChild = after
    if after then after.previousSibling = before else @lastChild = before
    node.parentNode = node.previousSibling = node.nextSibling = null
    @list = null
    @changed true
    node

  remove!: -> @parentNode?.removeChild this

  adopt!: (doc) ->
    return if @ownerDocument is doc
    @ownerDocument = doc
    kid = @firstChild
    while kid
      kid.adopt doc
      kid = kid.nextSibling

  # The rounded box the last layout gave this node. Reading it inside a
  # binding or an effect subscribes to every later layout.
  get box: -> (@cell ?= watch this).read()

  place!: (x, y, w, h) ->
    rect = @rect
    return if rect.x is x and rect.y is y and rect.w is w and rect.h is h
    @mark 2
    @rect = Object.freeze { x, y, w, h }
    @cell?.write @rect

  # Tell the painter this node is about to change, BEFORE it does: the
  # cells it inked are owed as they stand, and the node and every
  # ancestor are marked for the survey that finds what it inks next.
  # `level` 2 is a box whose own rectangle is all that changes, 3 is
  # everything under it — and a box that clips, since its rectangle is
  # the clip its children are held to; `still` says it will ink no cell
  # it did not, so there is nothing to survey. A run of words is drawn by
  # the leaf it is in, and a `contents` node inks nothing itself: what it
  # says reaches the children it lends its parent.
  mark!: (level, still = false) ->
    node = leafOf this
    s = node.styles
    level = 3 if s and (s.overflow? or s.overflowX? or s.overflowY?)
    if level is 3 and s?.display is 'contents'
      kid = node.firstChild
      while kid
        kid.mark 3
        kid = kid.nextSibling
      return
    @ownerDocument?.damage.old node, level is 3 or not s or node.tagName is 'span'
    return if still
    node.stain = level if level > node.stain
    # A stained box's ancestors are stained already, so the climb stops
    # at the first one — but passes a `contents` node, which no survey
    # visits: its stain says nothing of the boxes above it.
    node = node.parentNode
    while node and (not node.stain or node.styles?.display is 'contents')
      node.stain ||= 1
      node = node.parentNode

  # Tell the document a frame is owed: `moved` when boxes may move,
  # false when only cells recolor. A move dirties this node and every
  # ancestor, which is where layout looks for what changed; whether an
  # ancestor's cached answer still stands is layout's to say (a change
  # under a layout boundary stops there). A dirty node's ancestors are
  # dirty already, so the climb stops at the first one that is.
  changed!: (moved) ->
    if moved
      node = this
      while node and not node.dirty
        node.dirty = true
        node = node.parentNode
    @ownerDocument?.owe moved

export class Element extends Node
  constructor: (@tagName) ->
    super 1
    @styles = {}
    @attributes = null
    @listeners = null
    @road = null
    @styled = null

  # A style that is refused is refused by name, and the error says which
  # node it was written on.
  set: (key, value) ->
    try
      @put key, value
    catch error
      throw blame error, this

  put: (key, value) ->
    if kept key
      (@attributes ?= Map.new()).set key, value
      return
    kind = KIND.get key
    throw unknown(key, @tagName) unless kind
    # Text is drawn glyph by glyph: it has no inside to pad, frame, clip or
    # scroll, and text nested in text is a run of words, not a box to size
    # or place. A box holds no words of its own to wrap.
    meant = value? and value isnt false and value isnt ''
    if meant and @tagName is 'span'
      if key.startsWith('border') or key.startsWith('padding')
        throw Error.new "rip/tui: '#{key}' has no meaning on text — put the text in a box and style the box"
      if key.startsWith('overflow') or key.startsWith('contentOffset')
        throw Error.new "rip/tui: '#{key}' has no meaning on text — it clips and scrolls a box's children; text is cut by `wrap`, or by the box it is in"
      if kind is 'layout' and @parentNode?.tagName is 'span'
        throw Error.new "rip/tui: '#{key}' has no meaning on text nested in text — it is a run of words, styled by color and weight only"
    else if meant and key is 'wrap'
      throw Error.new "rip/tui: 'wrap' has no meaning on a box — it breaks or cuts the words of a text; a box wraps its children with flexWrap"
    else if meant and key is 'link'
      throw Error.new "rip/tui: 'link' has no meaning on a box — it makes a hyperlink of a text's words"
    value = undefined if value is '' or value is null or (value is false and not STANDING.has key)
    # A border written as an object is kept as a copy of its eight
    # glyphs: an object changed in place says nothing until it is set
    # again, and then it is another border only if a glyph differs.
    if key is 'borderStyle' and value and typeof value is 'object'
      held = @styles[key]
      return if held and PARTS.every (part) -> held[part] is value[part]
      value = Object.freeze { ...value }
    return if @styles[key] is value
    # A value is refused here, on the line that wrote it, and not from
    # inside a later frame.
    if value isnt undefined
      admit key, value if kind is 'layout'
      allow key, value
    # A border or a background recolors the box; any other style can
    # reach everything under it.
    @mark (if key.startsWith('border') or key is 'backgroundColor' then 2 else 3)
    if value is undefined then delete @styles[key] else @styles[key] = value
    @mark 3 if key is 'display'
    @changed kind is 'layout'

  setAttribute!: (key, value) ->
    throw blame Error.new("rip/tui: a string `style` has no terminal meaning on <#{@tagName}> — pass the styles as props, or `style:` an object"), this if key is 'style'
    # An HTML boolean attribute written on a raw tag arrives as presence,
    # the empty string (`div hidden: true`). For every other key an empty
    # string clears it, as it does on the style road.
    @set key, (if value is '' and PRESENT.has(key) then true else value)

  # A `style:` object taken away takes every key it wrote with it.
  removeAttribute!: (key) ->
    if key is 'style'
      @set name, undefined for name in [...(@styled ?? [])]
      @styled = null
    else
      @set key, undefined

  toggleAttribute!: (key, force) -> @set key, (if force then true else if STANDING.has(key) then false else undefined)
  getAttribute: (key) -> @attributes?.get(key) ?? @styles[key] ?? null

  # `style:` with an object lands here key by key (`el.style[key] = value`).
  get style: -> @road ?= road this

  get className: -> ''
  set className: (value) -> throw blame Error.new("rip/tui: a class has no terminal meaning on <#{@tagName}> — style the node with props"), this

  addEventListener!: (type, handler) -> ((@listeners ?= {})[type] ?= []).push handler
  removeEventListener!: (type, handler) ->
    held = @listeners?[type]
    @listeners[type] = held.filter((h) -> h isnt handler) if held

  dispatchEvent: (event) ->
    event.target ?= this
    node = this
    while node and not event.cancelBubble
      if node.listeners?[event.type]
        event.currentTarget = node
        handler.call node, event for handler in [...node.listeners[event.type]]
      node = node.parentNode
    not event.defaultPrevented

# The object behind `el.style`: every key written to it goes through the
# node's own `set`, so a key that is no terminal style is refused by
# name on this road as on the other, and is remembered for the day the
# object is taken away. The runtime writes a handful of keys here once
# per change; a node's hot path is `setAttribute`.
road =! (node) ->
  Proxy.new {},
    get: (target, key) -> node.styles[key]
    set: (target, key, value) ->
      node.set key, value
      (node.styled ?= Set.new()).add key
      true

export class Text extends Node
  constructor: (data) ->
    super 3
    @text = sanitize data

  # Text is sanitized once, here, and never again on its way to the
  # screen. A new text owes a layout only when its leaf — this node, or
  # the span it is a run of — would answer some offer it was measured
  # under differently; a counter ticking from 41 to 42 owes a paint.
  get data: -> @text
  set data: (value) ->
    value = sanitize value
    return if value is @text
    @text = value
    leaf = leafOf this
    moved = true
    moved = refresh(leaf).moved if leaf.flow and leaf.lay and not leaf.dirty
    # One line that fits its box inks cells of that box and no others,
    # and the box lies within the bounds already owed.
    leaf.mark 3, not moved and leaf.rect.h > 0 and leaf.flow.fits leaf.rect.w
    @changed moved

export class Document
  constructor: ->
    @damage = Damage.new()
    @body = Element.new 'div'
    @body.adopt this
    @moved = true
    @stale = true
    @onOwe = null

  createElement: (tag) ->
    throw Error.new "rip/tui: <#{tag}> has no terminal meaning — a box is a div and text is a span" unless tag is 'div' or tag is 'span'
    Element.new tag
  createElementNS: (namespace, tag) -> throw Error.new "rip/tui: <#{tag}> has no terminal meaning — a box is a div and text is a span"
  createTextNode: (data) -> Text.new data
  createComment: -> Node.new 8
  createDocumentFragment: -> Node.new 11

  get head: -> throw Error.new 'rip/tui: a transition (~name) has no terminal meaning'
  querySelector: -> throw Error.new 'rip/tui: a selector has no terminal meaning — mount onto a node'

  owe!: (moved) ->
    @moved = true if moved
    was = @stale
    @stale = true
    @onOwe?() unless was

# Put the document where compiled render blocks look for it, and hand
# back the way to take it out again. A foreign `document` is refused.
#
# The runtime contains a child that fails to construct: it reports the
# error and leaves a marker comment where the child would be. On a
# terminal that is a silent hole in the screen, so while this document
# is installed the report is a throw, and the mount fails with the
# child's own error.
export install =! ->
  if globalThis.document?
    throw Error.new 'rip/tui: a `document` is already installed in this process — a terminal app and a DOM cannot share one'
  doc = Document.new()
  held = { Node: globalThis.Node, SVGElement: globalThis.SVGElement }
  held.reporter = __setChildFailureReporter (name, error) -> throw error
  globalThis.document = doc
  globalThis.Node = Node
  globalThis.SVGElement = class SVGElement
  restore = ->
    __setChildFailureReporter held.reporter
    delete globalThis.document
    if held.Node then globalThis.Node = held.Node else delete globalThis.Node
    if held.SVGElement then globalThis.SVGElement = held.SVGElement else delete globalThis.SVGElement
  { doc, restore }
