# ==============================================================================
# tui tests — the terminal document, layout, paint, and the live diff
# ==============================================================================

import { test, eq, ok, throws } from 'rip/testing'
import { run, quit, renderToString, screen, Box, Text, Spacer } from 'rip/tui'
import * as mod from 'rip/tui'
import { install } from './document.rip'
import { layout } from './layout.rip'
import { Grid, paint, diff } from './paint.rip'
import { __setChildFailureReporter } from '../../src/runtime/components.js'
import { EventEmitter } from 'node:events'
import { readFileSync } from 'fs'
import { join } from 'path'

# A terminal that remembers what it was sent.
def terminal(columns = 40, rows = 10)
  out = EventEmitter.new()
  out.columns = columns
  out.rows = rows
  out.sent = []
  out.write = (text) ->
    out.sent.push text
    true
  out

# The visible screen after replaying everything a terminal was sent: the
# escape sequences `diff` emits, applied to a grid of characters.
def replay(sent, columns, rows)
  lines = (Array(columns).fill(' ') for i in [0...rows])
  row = 0
  col = 0
  text = sent.join ''
  i = 0
  while i < text.length
    ch = text[i]
    if ch is '\x1b'
      m = /^\x1b\[([?0-9;]*)([A-Za-z])/.exec text.slice(i)
      n = parseInt(m[1]) or 1
      switch m[2]
        when 'A' then row -= n
        when 'B' then row += n
        when 'G' then col = n - 1
        when 'J'
          for r in [row...rows]
            for c in [(if r is row then col else 0)...columns]
              lines[r][c] = ' '
      i += m[0].length
    else if ch is '\n'
      row += 1
      col = 0
      i += 1
    else if ch is '\r'
      col = 0
      i += 1
    else
      glyph = String.fromCodePoint text.codePointAt(i)
      lines[row][col] = glyph
      col += 1
      i += glyph.length
  (line.join('').trimEnd() for line in lines).join('\n').trimEnd()

tick = -> Promise.new (resolve) -> setTimeout resolve, 20

# Mount `App` on a fresh document, hand `body(app, show, doc)` the
# instance and a way to draw it, and always give the document back.
def mounted(App, body)
  { doc, restore } = install()
  try
    app = App.new({})
    app.mount doc.body
    show = (cols = 20) ->
      { h } = layout doc.body, cols
      grid = Grid.new cols, Math.max(h, 1)
      paint grid, doc.body
      grid.toString()
    body app, show, doc
    app.unmount()
  finally
    restore()

# ==[ Package surface ]==

console.log "\nPackage"

test "module exports the entry surface and nothing else", ->
  eq Object.keys(mod).sort(), ['Box', 'Spacer', 'Text', 'quit', 'renderToString', 'run', 'screen']

test "declares no dependencies", ->
  pkg = JSON.parse readFileSync(join(import.meta.dir, 'package.json'), 'utf8')
  eq pkg.dependencies, undefined
  eq pkg.devDependencies, undefined

# ==[ Document ]==

console.log "\nDocument"

test "install is scoped: the process gets its document slot back", ->
  eq typeof document, 'undefined'
  { doc, restore } = install()
  try
    ok document is doc
    throws (-> install()), 'already installed'
  finally
    restore()
  eq typeof document, 'undefined'

test "an unknown style is refused by name, with the nearest real one", ->
  Typo = component
    render
      Box flexDirecton: 'row'
  throws (-> renderToString Typo), "'flexDirecton' is not a terminal style of <div> — did you mean 'flexDirection'?"
  eq typeof document, 'undefined'

test "a child that fails to construct fails the mount, through the runtime's reporter", ->
  Typo = component
    render
      Box flexDirecton: 'row'
  held = console.error
  printed = []
  console.error = (label) -> printed.push label
  try
    throws (-> renderToString Typo), "'flexDirecton' is not a terminal style"
  finally
    console.error = held
  eq printed, []

test "restore hands the runtime its own reporter back", ->
  renderToString (component
    render
      Text "ok")
  printed = []
  held = console.error
  console.error = (label) -> printed.push label
  try
    reporter = __setChildFailureReporter (->)
    __setChildFailureReporter reporter
    reporter 'Kid', Error.new('boom')
  finally
    console.error = held
  eq printed, ['[Rip] Kid construction failed:']

test "an unknown border style is refused when the frame is drawn", ->
  Wavy = component
    render
      Box borderStyle: 'wavy'
        Text "never drawn"
  throws (-> renderToString Wavy), "'wavy' is not a border style"

test "a tag with no terminal meaning is refused", ->
  Web = component
    render
      button "save"
  throws (-> renderToString Web), '<button> has no terminal meaning'

test "role and aria-* are kept on the node, never refused", ->
  { doc, restore } = install()
  try
    node = doc.createElement 'div'
    node.setAttribute 'role', 'list'
    node.setAttribute 'aria-label', 'Results'
    eq node.getAttribute('aria-label'), 'Results'
  finally
    restore()

test "a string style and a class are refused", ->
  { doc, restore } = install()
  try
    node = doc.createElement 'div'
    throws (-> node.setAttribute 'style', 'color: red'), 'string `style`'
    throws (-> node.className = 'card'), 'class has no terminal meaning'
  finally
    restore()

test "a style object takes the same road as props", ->
  Styled = component
    render
      Box style: { borderStyle: 'single', width: 6 }
        Text "hi"
  eq renderToString(Styled, cols: 10), "┌────┐\n│hi  │\n└────┘"

# ==[ Layout ]==

console.log "\nLayout"

test "a column stacks and a row sits side by side", ->
  Stack = component
    render
      Box flexDirection: 'column'
        Text "one"
        Box flexDirection: 'row', gap: 1
          Text "a"
          Text "b"
  eq renderToString(Stack, cols: 10), "one\na b"

test "three equal shares of 100 round to 33, 34, 33", ->
  Thirds = component
    render
      Box flexDirection: 'row', width: 100
        Box flexGrow: 1
        Box flexGrow: 1
        Box flexGrow: 1
  mounted Thirds, (app, show, doc) ->
    show 100
    row = doc.body.firstChild
    eq (kid.rect.w for kid in row.childNodes), [33, 34, 33]
    eq (kid.rect.x for kid in row.childNodes), [0, 33, 67]

test "a spacer takes the free space", ->
  Ends = component
    render
      Box flexDirection: 'row', width: 12
        Text "L"
        Spacer
        Text "R"
  eq renderToString(Ends, cols: 20), "L          R"

test "padding and a border inset the content", ->
  Card = component
    render
      Box borderStyle: 'round', paddingX: 1, width: 9
        Text "ok"
  eq renderToString(Card, cols: 20), "╭───────╮\n│ ok    │\n╰───────╯"

test "bare text under a box is a text leaf", ->
  Bare = component
    render
      Box
        "plain"
  eq renderToString(Bare, cols: 10), "plain"

test "a hidden child is never the baseline child", ->
  # Yoga picks the first child as a row's baseline child even when it
  # is `display: none`, reads its zeroed height, and answers NaN for
  # the row's top. A box that draws nothing has no baseline: the first
  # child that shows is the one that aligns.
  Aligned = component
    render
      div flexDirection: 'row', alignItems: 'baseline', width: 100, height: 50
        div width: 20
          div hidden: true, height: 7
          div height: 10
        div width: 20, height: 30
  mounted Aligned, (app, show, doc) ->
    show 100
    [first, second] = doc.body.firstChild.childNodes
    eq [first.rect.y, first.rect.h], [20, 10]
    eq [second.rect.y, second.rect.h], [0, 30]

test "wrapped rows break at the box's width and keep their gap", ->
  Shelf = component
    render
      Box width: 22, borderStyle: 'single', flexDirection: 'row', flexWrap: 'wrap', columnGap: 1
        Text "one"
        Text "two"
        Text "three"
        Text "four"
        Text "five"
  eq renderToString(Shelf, cols: 30), [
    "┌────────────────────┐"
    "│one two three four  │"
    "│five                │"
    "└────────────────────┘"
  ].join('\n')

test "an absolute node positions against its nearest ancestor that is not static", ->
  corner = (position) ->
    Card = component
      render
        Box width: 12, height: 5, borderStyle: 'single'
          Box position: position, width: 4, height: 1
            Box position: 'absolute', bottom: 0, right: 0
              Text "*"
    renderToString Card, cols: 14
  eq corner('static').split('\n')[3], "│         *│"
  eq corner('relative').split('\n')[1], "│   *      │"

test "text wider than its box is cut at the screen's edge, never wrapped onto the row above", ->
  Wide = component
    render
      Box flexDirection: 'column'
        Text "first row"
        Box width: 10, alignItems: 'center'
          Text "0123456789ABCDEF"
  eq renderToString(Wide, cols: 20), "first row\n3456789ABCDEF"

test "a glyph over half of a wide character blanks the other half", ->
  for at in [2, 3]
    Badge = component
      render
        Box width: 12, borderStyle: 'single'
          Text "日本語日本"
          Box position: 'absolute', top: 0, left: at
            Text "*"
    row = renderToString(Badge, cols: 14).split('\n')[1]
    eq Bun.stringWidth(row), 12
    eq row, (if at is 2 then "│日* 語日本│" else "│日 *語日本│")

test "text takes no padding or border, and text nested in text no layout at all", ->
  Padded = component
    render
      Text paddingX: 2
        "hi"
  Nested = component
    render
      Text
        "shown "
        Text width: 3
          "cut"
  throws (-> renderToString Padded), "'paddingX' has no meaning on text"
  throws (-> renderToString Nested), "'width' has no meaning on text nested in text"

test "a contents node draws no box, and its color still reaches its children", ->
  Lent = component
    render
      Box
        Box display: 'contents', color: 'green'
          Text "leaf"
  eq renderToString(Lent, cols: 8, ansi: true).trimEnd(), "\x1b[32mleaf\x1b[0m"

# ==[ The component model on a terminal ]==

console.log "\nComponents"

test "if / else swaps in place, between its neighbors", ->
  Gate = component
    @open := false
    render
      Box flexDirection: 'column'
        Text "top"
        if @open
          Text "open"
        else
          Text "shut"
        Text "bottom"
  mounted Gate, (app, show) ->
    eq show(), "top\nshut\nbottom"
    app.open.value = true
    eq show(), "top\nopen\nbottom"

test "a keyed for reorders, inserts, and removes rows", ->
  Rows = component
    @items := ['a', 'b', 'c']
    render
      Box flexDirection: 'column'
        for item in @items
          Text key: item
            "row #{item}"
  mounted Rows, (app, show) ->
    eq show(), "row a\nrow b\nrow c"
    app.items.value = ['c', 'a', 'd']
    eq show(), "row c\nrow a\nrow d"

test "nested text restyles its own words", ->
  Mixed = component
    render
      Text
        "all "
        Text color: 'green', bold: true
          "green"
  eq renderToString(Mixed, cols: 20, ansi: true).trimEnd(), "all \x1b[1;32mgreen\x1b[0m"

test "a ref reads its node's box, and the read follows layout", ->
  seen = []
  Measured = component
    @wide := 5
    el := null
    ~> seen.push el.box.w if el
    render
      Box flexDirection: 'row'
        div ref: el, width: @wide
  mounted Measured, (app, show) ->
    show 40
    app.wide.value = 9
    show 40
    eq seen, [0, 5, 9]

# ==[ The live screen ]==

console.log "\nScreen"

test "the first diff of a grid reproduces it", ->
  grid = Grid.new 6, 2
  grid.write 0, 0, 'hello', 0
  grid.write 2, 1, 'you', 0
  eq replay([diff(null, grid)], 6, 4), "hello\n  you"

test "an unchanged grid costs no bytes", ->
  a = Grid.new 6, 2
  b = Grid.new 6, 2
  a.write 0, 0, 'same', 0
  b.write 0, 0, 'same', 0
  eq diff(a, b), ''

test "a wide character takes two cells", ->
  grid = Grid.new 6, 1
  grid.write 0, 0, '日本', 0
  eq grid.toString(), '日本'
  eq Array.from(grid.wide), [2, 0, 2, 0, 1, 1]

test! "a run that fails to mount gives the terminal and the process back", ->
  out = terminal 30, 8
  Bad = component
    render
      Box justifyContent: 'centre'
        Text "x"
  throws (-> run Bad, stdout: out), '"centre" is not one of'
  eq typeof document, 'undefined'
  ok out.sent.join('').endsWith("\x1b[?25h"), 'the cursor is shown again'
  Fine = component
    render
      Text "ok"
  again = run Fine, stdout: terminal(30, 8)
  quit()
  await again.done

test! "a quit from an effect that runs during construction is heard", ->
  Early = component
    ~> quit 'at once'
    render
      Text "bye"
  eq await run(Early, stdout: terminal(30, 8)).done, 'at once'
  eq typeof document, 'undefined'

test! "a frame that fails later rejects done and gives the terminal back", ->
  out = terminal 30, 8
  Turns = component
    @how := 'center'
    render
      Box justifyContent: @how
        Text "x"
  running = run Turns, stdout: out
  running.app.how.value = 'centre'
  failure = null
  try
    await running.done
  catch error
    failure = error
  ok failure?.message.includes('"centre" is not one of'), "done rejected with #{failure?.message}"
  eq typeof document, 'undefined'
  ok out.sent.join('').endsWith("\x1b[?25h"), 'the cursor is shown again'

test! "a resize to the same size writes nothing", ->
  out = terminal 30, 8
  Still = component
    render
      Text "still"
  running = run Still, stdout: out
  before = out.sent.length
  out.emit 'resize'
  tick!
  eq out.sent.length, before
  quit()
  await running.done

test! "a running app redraws only the cells that changed, and quit gives the process back", ->
  out = terminal 30, 8
  Counter = component
    @count := 0
    render
      Box borderStyle: 'single', width: 14
        Text "count #{@count}"
  running = run Counter, stdout: out
  eq replay(out.sent, 30, 8), "┌────────────┐\n│count 0     │\n└────────────┘"
  before = out.sent.length
  running.app.count.value = 7
  tick!
  eq replay(out.sent, 30, 8), "┌────────────┐\n│count 7     │\n└────────────┘"
  change = out.sent.slice(before).join ''
  ok change.includes('7') and not change.includes('count'), "the update rewrote more than the changed cell: #{JSON.stringify change}"
  quit 'bye'
  eq await running.done, 'bye'
  eq typeof document, 'undefined'
