  Rows = component
    @items := ['a', 'b', 'c']
    render
      Box flexDirection: 'column'
        for item in @items
          Text key: item
            "row #{item}"
  mounted Rows, (app, show) ->
    eq show(), "row a\nrow b\nrow c"
    app.items.value = ['c', 'a', 'd']
    eq show(), "row c\nrow a\nrow d"

test "nested text restyles its own words", ->
  Mixed = component
    render
      Text
        "all "
        Text color: 'green', bold: true
          "green"
  eq renderToString(Mixed, cols: 20, ansi: true).trimEnd(), "all \x1b[1;32mgreen\x1b[0m"

test "a ref reads its node's box, and the read follows layout", ->
  seen = []
  Measured = component
    @wide := 5
    el := null
    ~> seen.push el.box.w if el
    render
      Box flexDirection: 'row'
        div ref: el, width: @wide
  mounted Measured, (app, show) ->
    show 40
    app.wide.value = 9
    show 40
    eq seen, [0, 5, 9]

# ==[ The live screen ]==

console.log "\nScreen"

test "the first diff of a grid reproduces it", ->
  grid = Grid.new 6, 2
  grid.write 0, 0, 'hello', 0
  grid.write 2, 1, 'you', 0
  eq replay([diff(null, grid)], 6, 4), "hello\n  you"

test "an unchanged grid costs no bytes", ->
  a = Grid.new 6, 2
  b = Grid.new 6, 2
  a.write 0, 0, 'same', 0
  b.write 0, 0, 'same', 0
  eq diff(a, b), ''

test "no background is held across a line feed, so a row scrolled in at the bottom is never striped", ->
  Bars = component
    render
      Box flexDirection: 'column', width: 10
        Box backgroundColor: 'blue', height: 1
          Text "row 0"
        Box backgroundColor: 'blue', height: 1
          Text "row 1"
        Box backgroundColor: 'blue', height: 1
          Text "row 2"
  mounted Bars, (app, show, doc, view) ->
    show 24
    { bytes } = view
    held = null
    at = 0
    feeds = 0
    while at < bytes.length
      if m = /^\x1b\[([0-9;]*)m/.exec bytes.slice(at)
        held = background m[1], held
        at += m[0].length
      else
        if bytes[at] is '\n'
          feeds += 1
          ok held is null, "a line feed at byte #{at} with background #{held} in force"
        at += 1
    eq feeds, 2
    # Drawn from the last row of a 6-row terminal, every line feed scrolls.
    { lines, backs } = screenOf [bytes], 24, 6, 5
    eq (line.join('').trimEnd() for line in lines.slice 3), ['row 0', 'row 1', 'row 2']
    for row in backs.slice 3
      eq row.slice(0, 10), Array(10).fill(44)
      eq row.slice(10), Array(14).fill(null)

test "the cell after a cluster of several code points is reached by an absolute column move", ->
  family = [0x1F468, 0x200D, 0x1F469, 0x200D, 0x1F467].map((code) -> String.fromCodePoint code).join ''
  grid = Grid.new 8, 1
  grid.write 0, 0, "a#{family}bc", 0
  eq diff(null, grid), "\x1b[J\x1b[1Ga#{family}\x1b[4Gbc\r"
  plain = Grid.new 8, 1
  plain.write 0, 0, "a日本bc", 0
  eq diff(null, plain), "\x1b[J\x1b[1Ga日本bc\r"

test "an unassigned code point earns the column move after it, and a private use one does not", ->
  grid = Grid.new 8, 1
  grid.write 0, 0, "a\u{1F6D9}bc", 0
  eq diff(null, grid), "\x1b[J\x1b[1Ga\u{1F6D9}\x1b[3Gbc\r"
  eq grid.toString(), "a\u{1F6D9}bc"
  arrow = Grid.new 8, 1
  arrow.write 0, 0, "a\uE0B0bc", 0
  eq diff(null, arrow), "\x1b[J\x1b[1Ga\uE0B0bc\r"

test "a wide character takes two cells", ->
  grid = Grid.new 6, 1
  grid.write 0, 0, '日本', 0
  eq grid.toString(), '日本'
  eq Array.from(grid.wide), [2, 0, 2, 0, 1, 1]

# A screen's two grids over a mounted document, as screen.rip keeps
# them: `frame()` answers the bytes of the next frame, `front()` the grid
# those bytes leave on the terminal.
def screenFor(doc, cols)
  front = null
  spare = null
  frame = ->
    doc.moved = doc.stale = false
    { h } = layout doc.body, cols
    back = spare
    if back?.rows is h then back.clear() else back = Grid.new cols, h
    paint back, doc.body
    bytes = diff front, back
    spare = front
    front = back
    bytes
  { frame, front: (-> front) }

test "a link is open only while its cells are written: closed before a cursor move and at the end of a run", ->
  accent = String.fromCodePoint 0x301
  Linked = component
    @to := 'https://example.com/a'
    render
      Box flexDirection: 'column', width: 5
        Text link: @to, backgroundColor: 'blue'
          "one"
        Text "plain"
        Text link: @to
          "e#{accent}x"
        Box flexDirection: 'row'
          Text link: @to
            "a"
          Text link: 'https://example.com/z'
            "z"
  mounted Linked, (app, show, doc) ->
    view = screenFor doc, 5
    a = OPEN 'https://example.com/a'
    eq view.frame(), "\x1b[J\x1b[1G\x1b[44m#{a}one#{SHUT}\x1b[0m\n\x1b[1Gplain\n\x1b[1G#{a}e#{accent}#{SHUT}\x1b[2G#{a}x#{SHUT}\n\x1b[1G#{a}a#{OPEN 'https://example.com/z'}z#{SHUT}\x1b[3A\r"
    # A link is part of a cell's style: a new one redraws its cells and no others.
    app.to.value = 'https://example.com/b'
    b = OPEN 'https://example.com/b'
    eq view.frame(), "\x1b[1G\x1b[44m#{b}one#{SHUT}\x1b[0m\n\n\x1b[1G#{b}e#{accent}#{SHUT}\x1b[2G#{b}x#{SHUT}\n\x1b[1G#{b}a#{SHUT}\x1b[3A\r"
    eq view.frame(), ''

# '#rrggbb' for the `n`th color.
hue = (n) -> '#' + n.toString(16).padStart(6, '0')
TEN =! (n for n in [0...10])

test "styles no cell holds are let go: 70,000 colors pass through sixteen bits, and the diff stands across a sweep", ->
  accent = String.fromCodePoint 0x61, 0x328, 0x301
  Glow = component
    @tick := 0
    render
      Box flexDirection: 'row', backgroundColor: '#654321', paddingLeft: 1
        Text color: '#123456'
          "#{accent}till "
        for n in TEN
          Text key: n, color: hue(@tick * 10 + n)
            "x"
  # Every colored cell is a style and, over the box, a blend of two.
  mounted Glow, (app, show, doc) ->
    view = screenFor doc, 17
    view.frame()
    most = 0
    swept = 0
    step = 0
    while step < 7000
      before = styleCount()
      app.tick.value = step += 1
      bytes = view.frame()
      most = Math.max most, styleCount()
      if styleCount() < before
        swept += 1
        # The grid a sweep renumbers reads as it did.
        eq view.front().toString(), " #{accent}till xxxxxxxxxx"
        # The frame after a sweep is a diff against the grid before it.
        app.tick.value = step += 1
        bytes = view.frame()
        ok not bytes.includes('till') and not bytes.includes("\x1b[J"), "the frame after a sweep redrew what had not changed: #{JSON.stringify bytes.slice 0, 80}"
        eq bytes.match(/x/g).length, 10
    ok swept >= 3, "#{swept} sweeps"
    ok most <= 32768 + 20, "#{most} styles were held at once"
    row = "\x1b[48;2;101;67;33m \x1b[0;38;2;18;52;86;48;2;101;67;33m#{accent}till "
    for n in TEN
      code = 70000 + n
      row += "\x1b[0;38;2;#{code >> 16};#{(code >> 8) & 255};#{code & 255};48;2;101;67;33mx"
    eq view.front().toString(true), row + "\x1b[0m"

test "a frame painted with no diff is swept as it starts, and a grid held across that sweep is drawn from nothing", ->
  Flag = component
    render
      Text color: 'red'
        "kept"
  Rainbow = component
    @from := 0
    render
      Box flexDirection: 'row', flexWrap: 'wrap', width: 100
        for n in [0...1000]
          Text key: n, color: hue(0x800000 + @from + n)
            "x"
  drawn = ->
    grid = Grid.new 8, 1
    mounted Flag, (app, show, doc) ->
      layout doc.body, 8
      paint grid, doc.body
    grid
  front = drawn()
  eq diff(front, drawn()), ''
  swept = 0
  for from in [0...70000] by 1000
    before = styleCount()
    last = renderToString Rainbow, cols: 100, ansi: true, props: { from }
    swept += 1 if styleCount() < before
    code = 0x800000 + from
    ok last.startsWith("\x1b[38;2;#{code >> 16};#{(code >> 8) & 255};#{code & 255}mx"), JSON.stringify last.slice(0, 40)
  ok swept >= 1, "#{swept} sweeps"
  eq diff(front, drawn()), "\x1b[J\x1b[1G\x1b[31mkept\x1b[0m\r"

test "clusters no cell shows are let go: 300,000 pass through a table that holds under 16,500", ->
  # A letter with two combining marks: 26 × 112 × 112 clusters, a cell each.
  cluster = (n) -> String.fromCodePoint(0x61 + n % 26, 0x300 + Math.floor(n / 26) % 112, 0x300 + Math.floor(n / 2912) % 112)
  row = (from) -> (cluster from + n for n in [0...100]).join ''
  accent = String.fromCodePoint 0x61, 0x328, 0x301
  rim = String.fromCodePoint 0x6f, 0x302
  rule = { topLeft: '+', top: '-', topRight: '+', right: '|', bottomRight: rim, bottom: rim, bottomLeft: rim, left: '|' }
  shown = (from) -> "#{accent} still\n#{row from}\n#{rim.repeat 100}"
  Stream = component
    @from := 0
    render
      Box flexDirection: 'column', borderStyle: rule, borderTop: false, borderLeft: false, borderRight: false
        Text "#{accent} still"
        Text row(@from)
  mounted Stream, (app, show, doc) ->
    view = screenFor doc, 100
    view.frame()
    most = 0
    swept = 0
    from = 0
    while from < 300000
      before = clusterCount()
      app.from.value = from += 100
      bytes = view.frame()
      most = Math.max most, clusterCount()
      continue unless clusterCount() < before
      swept += 1
      # The cells the grids hold are renumbered; the flow of the row that
      # stands takes its cells again, and the border its glyphs.
      eq view.front().toString(), shown from
      app.from.value = from += 100
      bytes = view.frame()
      ok not bytes.includes('still'), "the frame after a sweep redrew what had not changed"
      eq view.front().toString(), shown from
    ok swept >= 10, "#{swept} sweeps"
    ok most <= 16384 + 100, "#{most} clusters were held at once"

test! "a run that fails to mount gives the terminal and the process back", ->
  out = terminal 30, 8
  Bad = component
    render
      Box justifyContent: 'centre'
        Text "x"
  throws (-> run Bad, stdout: out), '"centre" is not one of'
  eq typeof document, 'undefined'
  ok out.sent.join('').endsWith("\x1b[?25h"), 'the cursor is shown again'
  Fine = component
    render
      Text "ok"
  again = run Fine, stdout: terminal(30, 8)
  quit()
  await again.done

test! "a quit from an effect that runs during construction is heard", ->
  Early = component
    ~> quit 'at once'
    render
      Text "bye"
  eq await run(Early, stdout: terminal(30, 8)).done, 'at once'
  eq typeof document, 'undefined'

test! "a bad layout value is refused on the line that writes it, and the app runs on", ->
  out = terminal 30, 8
  Turns = component
    @how := 'center'
    render
      Box justifyContent: @how
        Text "x"
  running = run Turns, stdout: out
  throws (-> running.app.how.value = 'centre'), '"centre" is not one of'
  ok document?, 'the app is still mounted'
  quit()
  await running.done

test! "a bad paint value is refused on the line that writes it, and the app runs on", ->
  out = terminal 30, 8
  Tinted = component
    @ink := 'green'
    render
      Text color: @ink
        "x"
  running = run Tinted, stdout: out
  throws (-> running.app.ink.value = 'grean'), 'color: "grean" is not a color'
  ok document?, 'the app is still mounted'
  quit()
  await running.done

test! "a frame that fails later rejects done and gives the terminal back", ->
  out = terminal 30, 8
  Restless = component
    @grows := false
    el := null
    render
      Box flexDirection: 'row'
        div ref: el, width: (if @grows then (el?.box.w ?? 0) + 1 else 5)
  running = run Restless, stdout: out
  running.app.grows.value = true
  failure = null
  try
    await running.done
  catch error
    failure = error
  ok failure?.message.includes('layout did not settle'), "done rejected with #{failure?.message}"
  eq typeof document, 'undefined'
  ok out.sent.join('').endsWith("\x1b[?25h"), 'the cursor is shown again'

test! "a resize to the same size writes nothing", ->
  out = terminal 30, 8
  Still = component
    render
      Text "still"
  running = run Still, stdout: out
  before = out.sent.length
  out.emit 'resize'
  tick!
  eq out.sent.length, before
  quit()
  await running.done

test! "a running app redraws only the cells that changed, and quit gives the process back", ->
  out = terminal 30, 8
  Counter = component
    @count := 0
    render
      Box borderStyle: 'single', width: 14
        Text "count #{@count}"
  running = run Counter, stdout: out
  eq replay(out.sent, 30, 8), "┌────────────┐\n│count 0     │\n└────────────┘"
  before = out.sent.length
  running.app.count.value = 7
  tick!
  eq replay(out.sent, 30, 8), "┌────────────┐\n│count 7     │\n└────────────┘"
  change = out.sent.slice(before).join ''
  ok change.includes('7') and not change.includes('count'), "the update rewrote more than the changed cell: #{JSON.stringify change}"
  quit 'bye'
  eq await running.done, 'bye'
  eq typeof document, 'undefined'

# ==[ The test driver ]==

console.log "\nMount"

Tally =! component
  @count := 0
  @tint := undefined
  render
    Box borderStyle: 'single', width: 14
      Text color: @tint
        "count #{@count}"

test "a mount draws when asked: state set through `app` is in the next frame, plain and styled", ->
  view = mount Tally, cols: 30, props: { count: 3 }
  try
    eq view.ansi, '', 'nothing is drawn before the first frame'
    eq view.frame(), "┌────────────┐\n│count 3     │\n└────────────┘"
    view.app.count.value = 7
    view.app.tint.value = 'green'
    eq view.frame().split('\n')[1], "│count 7     │"
    eq view.ansi.split('\n')[1].trimEnd(), "│\x1b[32mcount 7\x1b[0m     │"
  finally
    view.close()

test "bytes are what a terminal was sent: each frame's difference from the one before", ->
  view = mount Tally, cols: 30, rows: 8
  try
    sent = []
    first = view.frame()
    sent.push view.bytes
    ok view.bytes.startsWith("\x1b[?2026h\x1b[J") and view.bytes.endsWith("\x1b[?2026l"), JSON.stringify view.bytes
    eq replay(sent, 30, 8), first
    view.app.count.value = 7
    second = view.frame()
    sent.push view.bytes
    ok view.bytes.includes('7') and not view.bytes.includes('count'), "the update rewrote more than the changed cell: #{JSON.stringify view.bytes}"
    eq replay(sent, 30, 8), second
    view.app.count.value = 7
    view.frame()
    eq view.bytes, '', 'a frame that changes no cell sends nothing'
  finally
    view.close()

test "a mount's terminal has a size: a tall frame shows its bottom, and a resize draws the next frame whole", ->
  Sized = component
    render
      Box flexDirection: 'column'
        Text "#{screen.cols} wide"
        Text "two"
        Text "three"
  view = mount Sized, cols: 30, rows: 2
  try
    eq view.frame(), "two\nthree"
    view.resize 30, 3
    eq view.frame(), "30 wide\ntwo\nthree"
    ok view.bytes.includes("\x1b[J") and view.bytes.includes('two'), 'a taller terminal is drawn whole, the rows it showed included'
    view.resize 9
    eq view.frame(), "9 wide\ntwo\nthree"
    eq [screen.cols, screen.rows], [9, 3]
  finally
    view.close()

test "one app is mounted at a time: a second is refused by name, and close gives the process back", ->
  held = { Node: globalThis.Node, SVGElement: globalThis.SVGElement }
  view = mount Tally
  ok document? and globalThis.Node isnt held.Node, 'the globals stand for the life of the mount'
  throws (-> mount Tally), 'an app is already mounted in this process'
  throws (-> renderToString Tally), 'an app is already mounted in this process'
  throws (-> run Tally, stdout: terminal()), 'an app is already mounted in this process'
  eq view.frame().split('\n')[1], "│count 0     │", 'a refusal leaves the mount as it was'
  view.close()
  view.close()
  eq typeof document, 'undefined'
  ok globalThis.Node is held.Node and globalThis.SVGElement is held.SVGElement
  throws (-> view.frame()), 'this mount is closed'
  mount(Tally).close()

test "a mount that fails to construct gives the process back", ->
  Bad = component
    render
      Box justifyContent: 'centre'
  throws (-> mount Bad), '"centre" is not one of'
  eq typeof document, 'undefined'
  mount(Tally).close()

test "a frame that fails later throws from `frame`, to the test that asked for it", ->
  Restless = component
    @grows := false
    el := null
    render
      Box flexDirection: 'row'
        div ref: el, width: (if @grows then (el?.box.w ?? 0) + 1 else 5)
  view = mount Restless
  try
    view.frame()
    view.app.grows.value = true
    throws (-> view.frame()), 'layout did not settle'
  finally
    view.close()
  eq typeof document, 'undefined'

test! "a quit from a mounted app closes the mount and resolves done", ->
  Leaver = component
    @over := false
    ~> quit 'left' if @over
    render
      Text "here"
  view = mount Leaver
  eq view.frame(), "here"
  view.app.over.value = true
  eq await view.done, 'left'
  eq typeof document, 'undefined'
  throws (-> view.frame()), 'this mount is closed'

# ==[ Damage: a frame paints and compares the cells a change owes ]==

console.log "\nDamage"

# The frame the screen keeps is the tree painted whole: glyph, colors
# and link, cell for cell.
def wholly(view)
  front = view.held.view.front
  whole = Grid.new front.cols, front.rows, front.top
  paint whole, document.body
  eq view.ansi, whole.toString true

# Mount `App` on a terminal of 40 by 12 and hand `body(app, draw, view)`
# a `draw` that draws the next frame, holds it to the whole paint and to
# the bytes sent so far, replayed, and answers the cells the frame owed.
def owing(App, body)
  view = mount App, cols: 40, rows: 12
  sent = []
  try
    draw = ->
      text = view.frame()
      sent.push view.bytes
      wholly view
      eq replay(sent, view.held.view.front.cols, 12), text.trimEnd()
      view.damage
    body view.app, draw, view
  finally
    view.close()

test "a text of unchanged size owes its own words; a first frame and a resized one owe every cell", ->
  Board = component
    @count := 41
    render
      Box flexDirection: 'column', height: 3
        Text "header line"
        Box flexDirection: 'row', gap: 2
          Text "left"
          Text "count #{@count}"
        Text "footer"
  owing Board, (app, draw, view) ->
    eq draw(), 40 * 3
    app.count.value = 42
    eq draw(), 8
    eq draw(), 0
    view.resize 30, 12
    eq draw(), 30 * 3
    app.count.value = 43
    eq draw(), 8

test "a frame that gains or loses its last rows owes the rows that come, and keeps the rows that stay", ->
  Log = component
    @lines := ['one', 'two']
    render
      Box flexDirection: 'column', alignItems: 'flex-start', color: 'green'
        for line in @lines
          Text key: line, wrap: 'truncate'
            "#{line}"
  owing Log, (app, draw, view) ->
    eq draw(), 40 * 2
    app.lines.value = ['one', 'two', 'three']
    eq draw(), 40
    eq view.bytes, "\x1b[?2026h\n\n\x1b[1G\x1b[32mthree\x1b[0m\x1b[2A\r\x1b[?2026l"
    app.lines.value = ['one', 'two', 'three', 'four', 'six']
    eq draw(), 40 * 2
    # The rows that go are erased, and a row that stays is compared
    # where its words changed.
    app.lines.value = ['one', 'six']
    eq draw(), 3
    eq view.bytes, "\x1b[?2026h\n\x1b[1G\x1b[32msix\x1b[0m\n\r\x1b[J\x1b[2A\r\x1b[?2026l"
    app.lines.value = []
    eq draw(), 0
    eq view.frame(), ''
    app.lines.value = ['back']
    eq draw(), 40
    eq view.frame().trimEnd(), 'back'
    # A frame taller than the terminal shows its bottom rows: one more
    # shifts every row it shows.
    app.lines.value = (String n for n in [1..12])
    draw()
    app.lines.value = (String n for n in [1..13])
    eq draw(), 40 * 12

test "a border or a background owes the box, and a color that passes down owes everything under it", ->
  Panel = component
    @edge := 'red'
    @back := undefined
    @tone := undefined
    render
      Box flexDirection: 'row', height: 4, alignItems: 'flex-start'
        Box width: 10, height: 3, borderStyle: 'single', borderColor: @edge, backgroundColor: @back
          Text "words"
        Box width: 4, flexDirection: 'row', color: @tone
          Text width: 6
            "spills"
        Text " beside"
  owing Panel, (app, draw) ->
    draw()
    app.edge.value = 'blue'
    eq draw(), 30
    app.back.value = 'blue'
    eq draw(), 30
    # The words are wider than their box, and take its color all the same.
    app.tone.value = 'green'
    eq draw(), 6
    app.tone.value = undefined
    eq draw(), 6

test "a box that moves or resizes owes where it was and where it is, and a box that inks nothing owes nothing", ->
  Row = component
    @wide := 4
    render
      Box flexDirection: 'column', height: 3
        Text "above"
        Box flexDirection: 'row'
          Box width: @wide, backgroundColor: 'blue'
            Text "ab"
          Text "tail"
        Text "below"
  owing Row, (app, draw) ->
    draw()
    app.wide.value = 6
    eq draw(), 10
    app.wide.value = 3
    eq draw(), 10

test "a node inserted, removed, reordered or hidden owes its box and the boxes that move for it", ->
  Rows = component
    @items := ['a', 'b', 'c', 'd']
    @gone := false
    render
      Box flexDirection: 'column', height: 8, alignItems: 'flex-start'
        Text "first"
        for item in @items
          Text key: item, hidden: @gone and item is 'a'
            "row #{item}"
        Text "last"
  owing Rows, (app, draw) ->
    draw()
    app.items.value = ['a', 'c', 'd']
    eq draw(), 5 + 5 + 5 + 4
    app.items.value = ['a', 'c', 'x', 'd']
    eq draw(), 5 + 5 + 4
    app.items.value = ['c', 'a', 'x', 'd']
    eq draw(), 5 + 5
    app.gone.value = true
    eq draw(), 5 + 5 + 5 + 4
    app.gone.value = false
    eq draw(), 5 + 5 + 5 + 4

test "a content offset owes the box that clips, and no layout", ->
  List = component
    @offset := 0
    render
      Box flexDirection: 'row', height: 5
        Box flexDirection: 'column', width: 10, height: 3, overflow: 'hidden', contentOffsetY: @offset
          for n in [1, 2, 3, 4, 5, 6]
            Text key: n
              "line #{n}"
        Text "beside"
  owing List, (app, draw) ->
    draw()
    document.moved = false
    app.offset.value = 2
    eq draw(), 30
    eq document.moved, false
    # With nothing to clip them the rows ink outside the box, and are owed
    # there: two above the screen, four on it.
    document.body.firstChild.firstChild.set 'overflow', undefined
    eq draw(), 40

test "what lies over or under a change is painted again inside it: an overlay, and text with no background", ->
  Layers = component
    @count := 1
    @back := 'blue'
    render
      Box flexDirection: 'column', height: 4
        Box backgroundColor: @back, width: 12, height: 2
          Text "count #{@count} of 9"
        Box position: 'absolute', top: 0, left: 4, backgroundColor: 'red'
          Text "TOP"
  owing Layers, (app, draw, view) ->
    draw()
    app.count.value = 2
    eq draw(), 12
    eq view.frame().trimEnd(), "counTOP of 9"
    app.back.value = 'green'
    eq draw(), 24
    eq view.ansi.split('\n')[0].trimEnd(), "\x1b[42mcoun\x1b[0;41mTOP\x1b[0;42m of 9\x1b[0m"

test "no span cuts a wide glyph: one on the terminal, or one the words under a change put there", ->
  Wide = component
    @at := 1
    @shown := true
    render
      Box flexDirection: 'column', height: 3
        Text "日本語"
        if @shown
          Box position: 'absolute', top: 0, left: @at
            Text "x"
  owing Wide, (app, draw, view) ->
    draw()
    eq view.frame().trimEnd(), " x本語"
    # The overlay leaves half of a glyph it blanked: the words beneath
    # owe the whole of it, and the run it is in.
    app.at.value = 5
    eq draw(), 6
    eq view.frame().trimEnd(), "日本 x"
    # …and arrives on half of one the terminal shows.
    app.at.value = 3
    eq draw(), 6
    eq view.frame().trimEnd(), "日 x語"
    app.shown.value = false
    eq draw(), 6
    eq view.frame().trimEnd(), "日本語"

test "words that spill out of their box are owed where they were drawn", ->
  Spill = component
    @words := "aaabbbccc"
    render
      Box flexDirection: 'row', height: 4
        Text width: 3, height: 1
          "#{@words}"
        Text " beside"
  owing Spill, (app, draw, view) ->
    draw()
    eq view.frame().trimEnd(), "aaa beside\nbbb\nccc"
    app.words.value = "aaa"
    eq draw(), 9
    eq view.frame().trimEnd(), "aaa beside"

test "words of one length that take other rows owe them, with no layout to say so", ->
  Turn = component
    @words := "aaaabbbb"
    render
      Box flexDirection: 'row', height: 4
        Text width: 4, height: 1
          "#{@words}"
  owing Turn, (app, draw, view) ->
    draw()
    document.moved = false
    app.words.value = "a bbbb c"
    eq document.moved, false
    eq draw(), 12
    eq view.frame().trimEnd(), "a\nbbbb\n c"

test "a box that clips one axis owes its children where they leave it on the other", ->
  Slot = component
    @label := "ab"
    render
      Box flexDirection: 'row', width: 12, height: 4, alignItems: 'flex-start'
        Box flexGrow: 1, flexShrink: 1, flexBasis: 0, height: 1, overflowX: 'hidden', flexDirection: 'row'
          Text width: 12
            "abcdefghijkl\nmnopqrstuvwx"
        Text "#{@label}"
  owing Slot, (app, draw, view) ->
    draw()
    eq view.frame().trimEnd(), "abcdefghijab\nmnopqrstuv"
    # The label takes two columns from the box, on the row below it too.
    app.label.value = "abcd"
    eq draw(), 12 + 10
    eq view.frame().trimEnd(), "abcdefghabcd\nmnopqrst"

test "a node moved to another parent is owed where that parent's offset puts it", ->
  Shelves = component
    render
      Box height: 5
        Box position: 'absolute', top: 0, left: 0, width: 8, height: 4, contentOffsetY: -2
          Text "note"
        Box position: 'absolute', top: 0, left: 0, width: 8, height: 4
  owing Shelves, (app, draw, view) ->
    draw()
    eq view.frame().trimEnd(), "\n\nnote"
    [from, to] = document.body.firstChild.childNodes.filter (node) -> node.tagName is 'div'
    to.appendChild from.firstChild
    eq draw(), 4 + 4
    eq view.frame().trimEnd(), "note"

test "a box that turns into a contents node, or back, owes what its children ink without it", ->
  Shell = component
    @display := 'flex'
    render
      Box flexDirection: 'column', height: 5, alignItems: 'flex-start'
        Text "top"
        Box display: @display, height: 1, contentOffsetY: 3
          Text "one"
          Text "two"
  owing Shell, (app, draw, view) ->
    draw()
    eq view.frame().trimEnd(), "top"
    # The box scrolled its rows off the top of the screen; without it
    # they ink where layout put them. Its bounds reach up over "top".
    app.display.value = 'contents'
    eq draw(), 3 + 3 + 3
    eq view.frame().trimEnd(), "top\none\ntwo"
    app.display.value = 'flex'
    eq draw(), 3 + 3 + 3
    eq view.frame().trimEnd(), "top"

test "a contents node's color reaches the children it lends, and owes their cells", ->
  Lent = component
    @tone := 'red'
    render
      Box flexDirection: 'column', height: 3, alignItems: 'flex-start'
        Text "plain"
        Box display: 'contents', color: @tone
          Text "lent"
  owing Lent, (app, draw, view) ->
    draw()
    app.tone.value = 'green'
    eq draw(), 4
    eq view.ansi.split('\n')[1].trimEnd(), "\x1b[32mlent\x1b[0m"

test "a text owes the cells its words ink, however far layout stretches its box", ->
  Flank = component
    @tick := 0
    render
      Box flexDirection: 'row', height: 8
        Text "#{'|/-\\'[@tick %% 4]}"
        Box width: 20, height: 8, borderStyle: 'single'
        Box flexDirection: 'column'
          Text "clock #{10 + @tick}"
          Text ""
          Text wrap: 'truncate-end', width: 6
            "cut #{@tick} short"
        Text width: 3, inverse: @tick %% 2 is 1
          ""
  owing Flank, (app, draw, view) ->
    draw()
    eq document.body.firstChild.firstChild.rect.h, 8
    # One span a row: the spinner to the clock on the first, the cut
    # line on the third, and none of the six rows under them; a text of
    # no words inks nothing.
    app.tick.value = 1
    eq draw(), 29 + 6
    app.tick.value = 2
    eq draw(), 29 + 6

test "a span that would cut a wide glyph takes its run in, so a stack of staggered layers settles in two paints", ->
  Stack = component
    @tick := 0
    render
      Box height: 2
        for n in [0...4]
          Text key: n, position: 'absolute', left: 4 - n, top: 0
            "\u4E2D\u4E2D\u4E2D\u4E2D\u4E2D\u4E2D\u4E2D\u4E2D"
        Text position: 'absolute', top: 0, left: 9
          "#{@tick %% 10}"
  owing Stack, (app, draw, view) ->
    draw()
    app.tick.value = 1
    eq draw(), 19
    eq document.damage.passes, 2
    app.tick.value = 2
    eq draw(), 19
    eq document.damage.passes, 2
  # Each layer is cut only once the one drawn after it is taken in: two
  # runs, then the whole row, and the fourth paint settles.
  Chain = component
    @tick := 0
    render
      Box height: 2
        for n in [0...6]
          Text key: n, position: 'absolute', left: 15 - 3 * n, top: 0
            "\u4E2D\u4E2D"
        Text position: 'absolute', top: 0, left: 1
          "#{@tick %% 10}"
  owing Chain, (app, draw, view) ->
    draw()
    app.tick.value = 1
    eq draw(), 40
    eq document.damage.passes, 4

test "a survey that fails is made again: what it did not reach is still owed", ->
  Two = component
    @word := 'ab'
    render
      Box flexDirection: 'column', height: 3, alignItems: 'flex-start'
        Text "#{@word} first"
        Text "#{@word} second"
  owing Two, (app, draw, view) ->
    draw()
    app.word.value = 'abcd'
    first = document.body.firstChild.firstChild
    flow = first.flow
    first.flow = Object.assign Object.create(flow), { fits: -> throw Error.new 'no survey' }
    throws (-> view.frame()), 'no survey'
    first.flow = flow
    document.owe false
    draw()
    eq view.frame().trimEnd(), "abcd first\nabcd second"

test "a node out of the tree owes nothing, whatever is done to it", ->
  Pair = component
    render
      Box flexDirection: 'column', height: 6, alignItems: 'flex-start'
        Box backgroundColor: 'blue', height: 3
          Text "soon gone"
        Text "kept"
  owing Pair, (app, draw, view) ->
    draw()
    gone = document.body.firstChild.firstChild
    gone.remove()
    eq draw(), 9 * 3 + 4
    gone.set 'backgroundColor', 'red'
    gone.firstChild.firstChild.data = 'words that are longer, and nowhere'
    eq draw(), 0
    eq view.bytes, ''
    document.body.firstChild.appendChild gone
    draw()
    eq view.frame().trimEnd(), "kept\nwords that are longer, and nowhere"

test "a contents text lends its words to its parent: each is a leaf, marked and measured as one", ->
  Lender = component
    @n := 1
    @display := 'contents'
    render
      Box flexDirection: 'row', height: 2, alignItems: 'flex-start'
        Text display: @display, color: 'red'
          "count #{@n}"
        Text "after"
  owing Lender, (app, draw, view) ->
    draw()
    eq view.ansi.split('\n')[0].trimEnd(), "\x1b[31mcount 1\x1b[0mafter"
    app.n.value = 2
    eq draw(), 7
    # Longer words move their neighbor: the text under a contents one
    # answers for its own size.
    app.n.value = 22
    eq draw(), 8 + 5
    eq view.frame().trimEnd(), "count 22after"
    app.display.value = undefined
    draw()
    app.display.value = 'contents'
    draw()
    eq view.frame().trimEnd(), "count 22after"

test "words that grow under a contents node, or under a box while it is hidden, are surveyed", ->
  Nested = component
    @word := 'lent'
    @shut := false
    render
      Box flexDirection: 'column', height: 3, alignItems: 'flex-start'
        Box display: 'contents'
          Box hidden: @shut
            Text
              "#{@word}"
  owing Nested, (app, draw, view) ->
    draw()
    app.word.value = 'lent and longer'
    eq draw(), 15
    app.shut.value = true
    eq draw(), 15
    app.word.value = 'lent, longer, and shown'
    eq draw(), 0
    app.shut.value = false
    eq draw(), 23
    eq view.frame().trimEnd(), 'lent, longer, and shown'

test "a sweep between frames leaves the next frame an ordinary one", ->
  Lit = component
    @tint := 0
    render
      Box flexDirection: 'column', height: 3, alignItems: 'flex-start'
        Text "still"
        Text color: "##{@tint.toString(16).padStart 6, '0'}"
          "lit"
  view = mount Lit, cols: 40, rows: 12
  try
    view.frame()
    swept = 0
    tint = 0
    while tint < 70000
      before = styleCount()
      view.app.tint.value = tint += 1
      view.frame()
      continue unless styleCount() < before
      # The grid the terminal shows is renumbered where it stands: the
      # frame the sweep followed and the one after it are whole, and the
      # second owed the recolored words and no more.
      swept += 1
      wholly view
      view.app.tint.value = tint += 1
      view.frame()
      wholly view
      eq view.damage, 3
      ok not view.bytes.includes('still'), 'the frame after a sweep redrew what had not changed'
    ok swept >= 2, "#{swept} sweeps"
  finally
    view.close()

test "a sweep as a paint starts owes every cell", ->
  cluster = (n) -> String.fromCodePoint(0x61 + n % 26, 0x300 + Math.floor(n / 26) % 112, 0x300 + Math.floor(n / 2912) % 112)
  Flood = component
    @words := "few"
    render
      Box flexDirection: 'column', height: 6
        Text "still"
        Text wrap: 'truncate'
          "#{@words}"
  view = mount Flood, cols: 40, rows: 12
  try
    view.frame()
    view.app.words.value = "two"
    view.frame()
    eq view.damage, 3
    # 25,000 clusters arrive between two frames: past the mark, and half again.
    view.app.words.value = (cluster n for n in [0...25000]).join ''
    view.frame()
    eq view.damage, 40 * 6
    ok view.bytes.includes('still'), 'the frame was not drawn from nothing'
    wholly view
  finally
    view.close()

# ==[ Static, print ]==

console.log "\nScrollback"

# A log of finished steps above a live line.
Journal =! component
  @done := []
  @live := 'live'
  render
    Box flexDirection: 'column'
      Static
        for step in @done
          Text key: step, step
      Text "#{@live}"

test "a static item is written in the frame's write: the frame's rows cleared, the item's rows, the frame drawn again below", ->
  view = mount Journal, cols: 20, rows: 10
  try
    eq view.frame(), 'live'
    eq view.bytes, "\x1b[?2026h\x1b[J\x1b[1Glive\r\x1b[?2026l"
    view.app.done.value = ['step one']
    eq view.frame(), 'live', 'the live frame does not grow'
    eq view.bytes, "\x1b[?2026h\x1b[Jstep one\n\x1b[J\x1b[1Glive\r\x1b[?2026l"
    eq view.scrollback, "step one\n"
    view.app.done.value = ['step one', 'two', 'three']
    view.frame()
    eq view.bytes, "\x1b[?2026h\x1b[Jtwo\nthree\n\x1b[J\x1b[1Glive\r\x1b[?2026l", 'two new items are written in order, in one write'
    eq view.scrollback, "step one\ntwo\nthree\n"
    eq replay([view.bytes], 20, 10), "two\nthree\nlive"
  finally
    view.close()

test "an item is painted once, at the terminal's width: a change to it or its removal writes nothing, and the frame stays", ->
  Steps = component
    @done := ['a']
    @tint := undefined
    render
      Box flexDirection: 'column'
        Static
          for step in @done
            Text key: step, color: @tint, wrap: 'truncate'
              "#{step} #{'x'.repeat 30}"
        Text "live"
  view = mount Steps, cols: 20
  try
    eq view.frame(), 'live'
    eq view.scrollback, "a xxxxxxxxxxxxxxxxx…\n"
    view.app.tint.value = 'red'
    view.frame()
    eq view.bytes, '', 'a written item that changes writes nothing'
    eq view.scrollback, "a xxxxxxxxxxxxxxxxx…\n"
    view.app.done.value = ['a', 'b']
    view.frame()
    eq view.scrollback, "a xxxxxxxxxxxxxxxxx…\n\x1b[31mb xxxxxxxxxxxxxxxxx…\x1b[0m\n", 'the new item is written in its color, the old one not again'
    view.app.done.value = ['b']
    view.frame()
    eq view.bytes, '', 'a removal writes nothing'
    eq view.damage, 0
  finally
    view.close()

test "the mouse lands right after a static write: the frame's origin moves down by the rows written", ->
  hits = []
  Rows = component
    @done := []
    render
      Box flexDirection: 'column'
        Static
          for step in @done
            Text key: step, step
        for n in [0, 1]
          Text key: n, @click: (-> hits.push n)
            "row #{n}"
  view = mount Rows, cols: 20, rows: 10, mouse: true
  try
    view.frame()
    view.send "\x1b[<0;1;2M\x1b[<0;1;2m"
    eq hits, [1]
    view.app.done.value = ['one', 'two']
    view.frame()
    view.send "\x1b[<0;1;4M\x1b[<0;1;4m"
    eq hits, [1, 1], 'the frame sits two rows lower'
    view.send "\x1b[<0;1;2M\x1b[<0;1;2m"
    eq hits, [1, 1], 'a click on a written row hits nothing'
  finally
    view.close()

test "under the alternate screen a static item writes nothing and paints nothing", ->
  view = mount Journal, cols: 20
  try
    view.held.view.alt = true
    view.app.done.value = ['x']
    eq view.frame(), 'live'
    ok not view.bytes.includes('x'), JSON.stringify view.bytes
    eq view.scrollback, ''
  finally
    view.close()

test "off a terminal, items are written as plain text as they arrive", ->
  Tinted = component
    @done := []
    render
      Box flexDirection: 'column'
        Static
          for step in @done
            Text key: step, color: 'red', step
        Text "live"
  view = mount Tinted, cols: 20
  try
    view.held.view.interactive = false
    view.app.done.value = ['x']
    view.frame()
    ok view.bytes.startsWith("x\n"), JSON.stringify view.bytes
    eq view.scrollback, "x\n"
  finally
    view.close()

test "an item under a hidden ancestor waits, and is written once shown", ->
  Folded = component
    @open := false
    render
      Box flexDirection: 'column'
        Box display: (if @open then undefined else 'none')
          Static
            for step in ['x']
              Text key: step, step
        Text "live"
  view = mount Folded, cols: 20
  try
    view.frame()
    eq view.scrollback, ''
    view.app.open.value = true
    view.frame()
    eq view.scrollback, "x\n"
    view.app.open.value = false
    view.app.open.value = true
    view.frame()
    eq view.scrollback, "x\n"
  finally
    view.close()

test "renderToString is the rows written above and then the frame, plain or with escape sequences", ->
  eq renderToString(Journal, cols: 20, props: { done: ['a', 'b'] }), "a\nb\nlive"
  eq renderToString(Journal, cols: 20, props: { done: ['a', 'b'], live: '' }), "a\nb\n"
  Only = component
    render
      Static
        for step in ['a', 'b']
          Text key: step, color: 'red', step
  eq renderToString(Only, cols: 20), "a\nb"
  eq renderToString(Only, cols: 20, ansi: true), "\x1b[31ma\x1b[0m\n\x1b[31mb\x1b[0m"

test "print writes above the frame, ending its line; print.err the same on stderr, the frame cleared on stdout first", ->
  view = mount Journal, cols: 20
  try
    view.frame()
    print 'warning'
    view.frame()
    eq view.bytes, "\x1b[?2026h\x1b[Jwarning\n\x1b[J\x1b[1Glive\r\x1b[?2026l"
    print 'two\nlines\n'
    view.frame()
    eq view.bytes, "\x1b[?2026h\x1b[Jtwo\nlines\n\x1b[J\x1b[1Glive\r\x1b[?2026l"
    print.err 'oops'
    ok view.bytes.endsWith("\x1b[J"), 'the frame is cleared at once'
    eq view.stderr, "oops\n"
    view.frame()
    eq view.bytes, "\x1b[?2026h\x1b[J\x1b[1Glive\r\x1b[?2026l", 'the frame is drawn again below'
    eq view.scrollback, "warning\ntwo\nlines\noops\n"
  finally
    view.close()

test "rowsToString is the grid's serializer, plain and with escape sequences", ->
  view = mount Journal, cols: 20, props: { live: 'here' }
  try
    view.frame()
    front = view.held.view.front
    eq rowsToString(front), 'here'
    eq rowsToString(front, true), front.toString true
  finally
    view.close()

test "Newline breaks a line inside text, `count` times", ->
  One = component
    render
      Text
        "Hello"
        Newline
        "World"
  eq renderToString(One, cols: 20), "Hello\nWorld"
  Two = component
    render
      Text
        "Hello"
        Newline count: 2
        "World"
  eq renderToString(Two, cols: 20), "Hello\n\nWorld"

# ==[ The clock ]==

console.log "\nClock"

# A timer source a test drives by hand and counts: `tick` jumps its
# time and runs what fell due, in order.
def timers()
  fake = { time: 0, due: [], afters: 0, cancels: 0 }
  fake.now = -> fake.time
  fake.after = (ms, fn) ->
    fake.afters += 1
    entry = { at: fake.time + ms, fn }
    fake.due.push entry
    ->
      fake.cancels += 1
      fake.due = fake.due.filter (other) -> other isnt entry
  fake.tick = (ms) ->
    fake.time += ms
    ready = fake.due.filter((entry) -> entry.at <= fake.time).sort (a, b) -> a.at - b.at
    fake.due = fake.due.filter (entry) -> entry.at > fake.time
    entry.fn() for entry in ready
  fake

test "a clock a component holds but never reads costs no timer", ->
  fake = timers()
  Holder = component
    tick = clock 30, fake
    render
      Text "still"
  view = mount Holder, cols: 20
  try
    eq view.frame(), 'still'
    eq fake.afters, 0
  finally
    view.close()
  eq fake.cancels, 0

test "two components reading one interval share one timer, which runs while a reader remains and stops at close", ->
  fake = timers()
  Spin = component
    tick = clock 40, fake
    render
      Text "#{tick.frame}"
  Pair = component
    @second := true
    render
      Box flexDirection: 'row'
        Spin
        if @second
          Spin
  view = mount Pair, cols: 20
  try
    eq view.frame(), '00'
    eq fake.afters, 1, 'one timer for two readers'
    fake.tick 80
    eq view.frame(), '22', 'the frame is the time elapsed over the interval, however late the tick'
    eq fake.afters, 2, 'the one timer is set again after the tick'
    view.app.second.value = false
    eq view.frame(), '2'
    eq fake.cancels, 0, 'the timer stays while a reader remains'
    fake.tick 40
    eq view.frame(), '3'
  finally
    view.close()
  eq fake.cancels, 1, 'the timer stops at close'
  eq fake.due, [], 'nothing is left to run'

test "`tick` moves the mount's clock: frame counts intervals, time the milliseconds, delta the time since the last tick", ->
  Watch = component
    tick = clock 50
    render
      Text "#{tick.frame},#{tick.time},#{tick.delta}"
  view = mount Watch, cols: 20
  try
    eq view.frame(), '0,0,0'
    view.tick 50
    eq view.frame(), '1,50,50'
    view.tick 120
    eq view.frame(), '3,150,50'
    view.tick 30
    eq view.frame(), '4,200,50', 'the parser and the clock share one time'
  finally
    view.close()

test "the frame catches up when the timer is late, and the interval defaults to 100 where none is given or the one given is no number", ->
  fake = timers()
  Late = component
    tick = clock 60, fake
    render
      Text "#{tick.frame}"
  view = mount Late, cols: 20
  try
    view.frame()
    fake.tick 250
    eq view.frame(), '4'
  finally
    view.close()
  ok clock(NaN) is clock(100) and clock() is clock(100) and clock(Infinity) is clock(100)

test "a clock never runs where the output is not interactive", ->
  fake = timers()
  Quiet = component
    tick = clock 70, fake
    render
      Text "#{tick.frame}"
  view = mount Quiet, cols: 20
  try
    view.held.view.interactive = false
    eq view.frame(), '0'
    eq fake.afters, 0
  finally
    view.close()

# ==[ Progress ]==

console.log "\nProgress"

test "progress goes out with the next frame's write: a percent, error, indeterminate, and the clear", ->
  view = mount Journal, cols: 20
  try
    view.frame()
    screen.progress 0.5
    view.frame()
    eq view.bytes, "\x1b[?2026h\x1b]9;4;1;50\x1b\\\x1b[?2026l"
    screen.progress 'error'
    view.frame()
    eq view.bytes, "\x1b[?2026h\x1b]9;4;2\x1b\\\x1b[?2026l"
    screen.progress 'indeterminate'
    view.app.live.value = 'busy'
    view.frame()
    eq view.bytes, "\x1b[?2026h\x1b[1Gbusy\r\x1b]9;4;3\x1b\\\x1b[?2026l", 'one write carries the cells and the progress'
    screen.progress null
    view.frame()
    eq view.bytes, "\x1b[?2026h\x1b]9;4;0\x1b\\\x1b[?2026l"
    screen.progress 1
    screen.progress 0.333
    view.frame()
    eq view.bytes, "\x1b[?2026h\x1b]9;4;1;33\x1b\\\x1b[?2026l", 'the last value set before the write is the one sent'
    throws (-> screen.progress 2), "progress: 2 is not a number from 0 to 1, 'error', 'indeterminate' or null"
  finally
    view.close()

test "the clear on the way out is answered once a progress was reported, and not otherwise", ->
  view = mount Journal, cols: 20
  try
    view.frame()
    eq view.held.view.clearProgress(), ''
    screen.progress null
    view.frame()
    eq view.bytes, '', 'a clear with nothing reported is nothing'
    screen.progress 0.25
    view.frame()
    eq view.held.view.clearProgress(), "\x1b]9;4;0\x1b\\"
    eq view.held.view.clearProgress(), ''
  finally
    view.close()

test "progress is nothing off a terminal, and with no app mounted", ->
  screen.progress 0.5
  view = mount Journal, cols: 20
  try
    view.held.view.interactive = false
    view.frame()
    screen.progress 0.5
    view.frame()
    ok not view.bytes.includes("\x1b]9;4"), JSON.stringify view.bytes
    eq view.held.view.clearProgress(), ''
  finally
    view.close()
