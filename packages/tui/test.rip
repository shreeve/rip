# ==============================================================================
# tui tests — the terminal document, layout, paint, and the live diff
# ==============================================================================

import { test, eq, ok, throws } from 'rip/testing'
import { run, quit, mount, renderToString, screen, print, clock, Box, Text, Spacer, Static, Newline } from 'rip/tui'
import * as mod from 'rip/tui'
import { install } from './document.rip'
import { layout } from './layout.rip'
import { Grid, paint, diff, rowsToString, tally as styleCount } from './paint.rip'
import { tally as clusterCount, clusterWidth } from './text.rip'
import { __setChildFailureReporter } from '../../src/runtime/components.js'
import { EventEmitter } from 'node:events'
import { readFileSync } from 'fs'
import { join } from 'path'

# A terminal that remembers what it was sent.
def terminal(columns = 40, rows = 10)
  out = EventEmitter.new()
  out.columns = columns
  out.rows = rows
  out.sent = []
  out.write = (text) ->
    out.sent.push text
    true
  out

# The background an SGR sequence's parameters leave in force, given the
# one before it: a code, or null for the terminal's own.
def background(params, held)
  codes = (Number(part or 0) for part in params.split ';')
  at = 0
  while at < codes.length
    code = codes[at]
    if code is 0 or code is 49
      held = null
    else if (40 <= code <= 47) or (100 <= code <= 107)
      held = code
    else if code is 38 or code is 48
      held = codes.slice(at, at + (if codes[at + 1] is 5 then 3 else 5)).join(';') if code is 48
      at += if codes[at + 1] is 5 then 2 else 4
    at += 1
  held

# The screen after replaying everything a terminal was sent, the cursor
# starting on row `from`: the escape sequences `diff` emits, applied to a
# grid of characters and a grid of backgrounds. The terminal erases with
# the background color (bce), as xterm and Ghostty do: a line feed on the
# last row scrolls, and the row it makes — like every cell an erase
# clears — takes the background then in force. A wide character takes
# two cells.
def screenOf(sent, columns, rows, from = 0)
  lines = (Array(columns).fill(' ') for i in [0...rows])
  backs = (Array(columns).fill(null) for i in [0...rows])
  row = from
  col = 0
  held = null
  text = sent.join ''
  i = 0
  while i < text.length
    ch = text[i]
    if ch is '\x1b'
      m = /^\x1b\[([?0-9;]*)([A-Za-z])/.exec text.slice(i)
      n = parseInt(m[1]) or 1
      switch m[2]
        when 'A' then row -= n
        when 'B' then row = Math.min rows - 1, row + n
        when 'G' then col = n - 1
        when 'm' then held = background m[1], held
        when 'J'
          for r in [row...rows]
            for c in [(if r is row then col else 0)...columns]
              lines[r][c] = ' '
              backs[r][c] = held
      i += m[0].length
    else if ch is '\n'
      if row is rows - 1
        lines.shift()
        backs.shift()
        lines.push Array(columns).fill(' ')
        backs.push Array(columns).fill(held)
      else
        row += 1
      col = 0
      i += 1
    else if ch is '\r'
      col = 0
      i += 1
    else
      glyph = String.fromCodePoint text.codePointAt(i)
      for part in [glyph, ''].slice 0, clusterWidth glyph
        lines[row][col] = part
        backs[row][col] = held
        col += 1
      i += glyph.length
  { lines, backs }

def replay(sent, columns, rows)
  (line.join('').trimEnd() for line in screenOf(sent, columns, rows).lines).join('\n').trimEnd()

# The styled frame of a tree built straight from the document's nodes:
# `build(doc)` answers the node to draw.
def inked(cols, build)
  { doc, restore } = install()
  try
    doc.body.appendChild build doc
    { h } = layout doc.body, cols
    grid = Grid.new cols, Math.max(h, 1)
    paint grid, doc.body
    grid.toString true
  finally
    restore()

# A span of `words` with `styles`, and whatever else goes inside it.
def words(doc, styles, text, inner = null)
  node = doc.createElement 'span'
  node.set key, value for key, value of styles
  node.appendChild doc.createTextNode text
  node.appendChild inner if inner
  node

tick = -> Promise.new (resolve) -> setTimeout resolve, 20

# Mount `App`, hand `body(app, show, doc, view)` the instance, a way to
# draw it at a width, its document, and the mount, and always close it.
def mounted(App, body)
  view = mount App, cols: 20
  try
    show = (cols = 20) ->
      view.resize cols
      view.frame()
    body view.app, show, document, view
  finally
    view.close()

# ==[ Package surface ]==

console.log "\nPackage"

test "module exports the entry surface and nothing else", ->
  eq Object.keys(mod).sort(), ['Box', 'Newline', 'Spacer', 'Static', 'Text', 'clock', 'focus', 'mount', 'print', 'quit', 'renderToString', 'run', 'screen']

test "declares no dependencies", ->
  pkg = JSON.parse readFileSync(join(import.meta.dir, 'package.json'), 'utf8')
  eq pkg.dependencies, undefined
  eq pkg.devDependencies, undefined

# ==[ Document ]==

console.log "\nDocument"

test "install is scoped: the process gets its document slot back", ->
  eq typeof document, 'undefined'
  { doc, restore } = install()
  try
    ok document is doc
    throws (-> install()), 'already installed'
  finally
    restore()
  eq typeof document, 'undefined'

test "an unknown style is refused by name, with the nearest real one", ->
  Typo = component
    render
      Box flexDirecton: 'row'
  throws (-> renderToString Typo), "'flexDirecton' is not a terminal style of <div> — did you mean 'flexDirection'?"
  eq typeof document, 'undefined'

test "a child that fails to construct after the mount fails the next frame, and the unmount is clean", ->
  Later = component
    @bad := false
    render
      Box
        Text "x"
        if @bad
          Box flexDirecton: 'row'
  printed = []
  held = console.error
  console.error = (label) -> printed.push label
  try
    view = mount Later
    eq view.frame(), 'x'
    view.app.bad.value = true
    throws (-> view.frame()), "'flexDirecton' is not a terminal style"
    view.close()
  finally
    console.error = held
  eq printed, []

test "a child that fails to construct fails the mount, through the runtime's reporter", ->
  Typo = component
    render
      Box flexDirecton: 'row'
  held = console.error
  printed = []
  console.error = (label) -> printed.push label
  try
    throws (-> renderToString Typo), "'flexDirecton' is not a terminal style"
  finally
    console.error = held
  eq printed, []

test "restore hands the runtime its own reporter back", ->
  renderToString (component
    render
      Text "ok")
  printed = []
  held = console.error
  console.error = (label) -> printed.push label
  try
    reporter = __setChildFailureReporter (->)
    __setChildFailureReporter reporter
    reporter 'Kid', Error.new('boom')
  finally
    console.error = held
  eq printed, ['[Rip] Kid construction failed:']

test "a paint value is refused where it is written, by key, with the words the key takes", ->
  Wavy = component
    render
      Box borderStyle: 'wavy'
        Text "never drawn"
  throws (-> renderToString Wavy), 'borderStyle: "wavy" is not one of single, double, round, bold, singleDouble, doubleSingle, classic, arrow'
  { doc, restore } = install()
  try
    box = doc.createElement 'div'
    words = doc.createElement 'span'
    throws (-> words.set 'bold', 'no'), 'bold: "no" is not true or false'
    throws (-> words.set 'color', 'grean'), 'color: "grean" is not a color'
    throws (-> box.set 'borderTopColor', 'rgb(1, 2, 300)'), 'borderTopColor: "rgb(1, 2, 300)" is not a color'
    throws (-> box.set 'borderDimColor', 1), 'borderDimColor: 1 is not true or false'
    throws (-> box.set 'overflow', 'scroll'), 'overflow: "scroll" is not one of visible, hidden'
    throws (-> box.set 'contentOffsetY', '2'), 'contentOffsetY: "2" is not a number of cells'
    throws (-> box.set 'contentOffsetY', NaN), 'contentOffsetY: NaN is not a number of cells'
    throws (-> words.set 'wrap', 'clip'), 'wrap: "clip" is not one of wrap, hard, truncate, truncate-end, truncate-start, truncate-middle'
    throws (-> box.set 'borderStyle', { top: '-' }), 'borderStyle: topLeft: undefined is not a border glyph'
    throws (-> box.set 'borderTop', 'no'), 'borderTop: "no" is not true or false'
    throws (-> words.set 'link', "https://example.com/\x1b\\\x1b[2J"), 'is not a link — write a URL in printable ASCII'
    throws (-> words.set 'link', "https://example.com/\x07"), 'is not a link'
    throws (-> words.set 'link', "https://example.com/\u009c"), 'is not a link'
    throws (-> words.set 'link', 'https://example.com/日本'), 'is not a link'
    throws (-> words.set 'link', 42), 'link: 42 is not a link'
    eq [box.styles, words.styles], [{}, {}]
    box.set key, value for key, value of { color: '#0af', backgroundColor: 'ansi256(208)', borderColor: 'rgb(0, 128, 255)', borderTop: false, overflowX: 'hidden', contentOffsetX: 3 }
    eq box.styles.borderTop, false
  finally
    restore()

test "a name every object inherits is no word: a color, a border style, a wrap mode, a layout word", ->
  { doc, restore } = install()
  try
    box = doc.createElement 'div'
    words = doc.createElement 'span'
    for name in ['constructor', 'toString', '__proto__', 'hasOwnProperty', 'valueOf']
      throws (-> words.set 'color', name), "color: \"#{name}\" is not a color"
      throws (-> box.set 'borderColor', name), "borderColor: \"#{name}\" is not a color"
      throws (-> box.set 'borderStyle', name), "borderStyle: \"#{name}\" is not one of single,"
      throws (-> words.set 'wrap', name), "wrap: \"#{name}\" is not one of wrap,"
      throws (-> box.set 'flexDirection', name), "flexDirection: \"#{name}\" is not one of column,"
      throws (-> box.set 'display', name), "display: \"#{name}\" is not one of flex,"
    eq [box.styles, words.styles], [{}, {}]
  finally
    restore()

test "a style with no meaning on its node is refused: a box's on text, text's on a box", ->
  { doc, restore } = install()
  try
    box = doc.createElement 'div'
    words = doc.createElement 'span'
    throws (-> words.set 'overflow', 'hidden'), "'overflow' has no meaning on text"
    throws (-> words.set 'contentOffsetY', 1), "'contentOffsetY' has no meaning on text"
    throws (-> words.set 'borderTop', true), "'borderTop' has no meaning on text"
    throws (-> box.set 'wrap', 'truncate'), "'wrap' has no meaning on a box"
    throws (-> box.set 'link', 'https://example.com'), "'link' has no meaning on a box"
    throws (-> box.set 'dim', true), "'dim' is not a terminal style of <div> — did you mean 'dimColor'?"
  finally
    restore()

test "a refused style names the node it was written on: its tag, its id or data-part, and the way to it", ->
  { doc, restore } = install()
  try
    # A node is styled before it is attached, so a first write has no
    # ancestors to name; a later one has.
    loose = doc.createElement 'span'
    loose.set 'data-part', 'label'
    throws (-> loose.set 'colr', 'red'), "did you mean 'color'? (on span[data-part=label])"
    list = doc.createElement 'div'
    list.set 'id', 'list'
    doc.body.appendChild list
    list.appendChild loose
    throws (-> loose.set 'overflow', 'hidden'), "text is cut by `wrap`, or by the box it is in (on div > div#list > span[data-part=label])"
    throws (-> list.set 'width', 'wide'), "'fit-content' or 'stretch' (on div > div#list)"
    throws (-> list.set 'color', 'nope'), '(on div > div#list)'
    throws (-> list.setAttribute 'style', 'color: red'), 'an object (on div > div#list)'
    throws (-> list.className = 'card'), 'with props (on div > div#list)'
    # A long way keeps its last four.
    deep = list
    for depth in [0...3]
      deep = deep.appendChild doc.createElement 'div'
    throws (-> deep.set 'gap', 'auto'), "(on … > div#list > div > div > div)"
    inner = doc.createElement 'span'
    inner.styles.width = 3
    throws (-> loose.appendChild inner), 'styled by color and weight only (on div > div#list > span[data-part=label] > span)'
  finally
    restore()

test "a tag with no terminal meaning is refused", ->
  Web = component
    render
      button "save"
  throws (-> renderToString Web), '<button> has no terminal meaning'

test "role and aria-* are kept on the node, never refused", ->
  { doc, restore } = install()
  try
    node = doc.createElement 'div'
    node.setAttribute 'role', 'list'
    node.setAttribute 'aria-label', 'Results'
    eq node.getAttribute('aria-label'), 'Results'
  finally
    restore()

test "a node is inserted neither into itself nor before itself", ->
  { doc, restore } = install()
  try
    box = doc.createElement 'div'
    kid = doc.createElement 'div'
    box.appendChild kid
    throws (-> box.insertBefore box, null), 'into itself'
    throws (-> box.insertBefore kid, kid), 'before itself'
    eq box.childNodes.length, 1
  finally
    restore()

test "a string style and a class are refused", ->
  { doc, restore } = install()
  try
    node = doc.createElement 'div'
    throws (-> node.setAttribute 'style', 'color: red'), 'string `style`'
    throws (-> node.className = 'card'), 'class has no terminal meaning'
  finally
    restore()

test "a style object refuses what props refuse", ->
  Styled = component
    render
      Box style: { colour: 'red' }
        Text "x"
  throws (-> renderToString Styled), "'colour' is not a terminal style"

test "a per-edge dim switch set to false stands against the shared one", ->
  { doc, restore } = install()
  try
    box = doc.createElement 'div'
    box.set 'borderDimColor', true
    box.set 'borderLeftDimColor', false
    eq box.styles.borderLeftDimColor, false
    box.set 'bold', false
    eq box.styles.bold, undefined
  finally
    restore()

test "a style object takes the same road as props", ->
  Styled = component
    render
      Box style: { borderStyle: 'single', width: 6 }
        Text "hi"
  eq renderToString(Styled, cols: 10), "┌────┐\n│hi  │\n└────┘"

test "a style object taken away takes its keys with it, and leaves the props", ->
  Dressed = component
    @look := { borderStyle: 'single', paddingLeft: 1 }
    render
      div width: 6, style: @look
        span "hi"
  mounted Dressed, (app, show) ->
    eq show(), "┌────┐\n│ hi │\n└────┘"
    app.look.value = { borderStyle: 'single' }
    eq show(), "┌────┐\n│hi  │\n└────┘"
    app.look.value = undefined
    eq show(), "hi"
    eq document.body.firstChild.styles, { width: 6 }

# ==[ Layout ]==

console.log "\nLayout"

test "a column stacks and a row sits side by side", ->
  Stack = component
    render
      Box flexDirection: 'column'
        Text "one"
        Box flexDirection: 'row', gap: 1
          Text "a"
          Text "b"
  eq renderToString(Stack, cols: 10), "one\na b"

test "three equal shares of 100 round to 33, 34, 33", ->
  Thirds = component
    render
      Box flexDirection: 'row', width: 100
        Box flexGrow: 1
        Box flexGrow: 1
        Box flexGrow: 1
  mounted Thirds, (app, show, doc) ->
    show 100
    row = doc.body.firstChild
    eq (kid.rect.w for kid in row.childNodes), [33, 34, 33]
    eq (kid.rect.x for kid in row.childNodes), [0, 33, 67]

test "a spacer takes the free space", ->
  Ends = component
    render
      Box flexDirection: 'row', width: 12
        Text "L"
        Spacer
        Text "R"
  eq renderToString(Ends, cols: 20), "L          R"

test "padding and a border inset the content", ->
  Card = component
    render
      Box borderStyle: 'round', paddingX: 1, width: 9
        Text "ok"
  eq renderToString(Card, cols: 20), "╭───────╮\n│ ok    │\n╰───────╯"

test "bare text under a box is a text leaf", ->
  Bare = component
    render
      Box
        "plain"
  eq renderToString(Bare, cols: 10), "plain"

test "a hidden child is never the baseline child", ->
  # Yoga picks the first child as a row's baseline child even when it
  # is `display: none`, reads its zeroed height, and answers NaN for
  # the row's top. A box that draws nothing has no baseline: the first
  # child that shows is the one that aligns.
  Aligned = component
    render
      div flexDirection: 'row', alignItems: 'baseline', width: 100, height: 50
        div width: 20
          div hidden: true, height: 7
          div height: 10
        div width: 20, height: 30
  mounted Aligned, (app, show, doc) ->
    show 100
    [first, second] = doc.body.firstChild.childNodes
    eq [first.rect.y, first.rect.h], [20, 10]
    eq [second.rect.y, second.rect.h], [0, 30]

test "wrapped rows break at the box's width and keep their gap", ->
  Shelf = component
    render
      Box width: 22, borderStyle: 'single', flexDirection: 'row', flexWrap: 'wrap', columnGap: 1
        Text "one"
        Text "two"
        Text "three"
        Text "four"
        Text "five"
  eq renderToString(Shelf, cols: 30), [
    "┌────────────────────┐"
    "│one two three four  │"
    "│five                │"
    "└────────────────────┘"
  ].join('\n')

test "an absolute node positions against its nearest ancestor that is not static", ->
  corner = (position) ->
    Card = component
      render
        Box width: 12, height: 5, borderStyle: 'single'
          Box position: position, width: 4, height: 1
            Box position: 'absolute', bottom: 0, right: 0
              Text "*"
    renderToString Card, cols: 14
  eq corner('static').split('\n')[3], "│         *│"
  eq corner('relative').split('\n')[1], "│   *      │"

test "text wider than its box wraps inside it, or is cut with `wrap: 'truncate'`", ->
  Wide = component
    render
      Box flexDirection: 'column'
        Text "first row"
        Box width: 10, alignItems: 'center'
          Text "0123456789ABCDEF"
        Box width: 10
          Text wrap: 'truncate'
            "0123456789ABCDEF"
  eq renderToString(Wide, cols: 20), "first row\n0123456789\nABCDEF\n012345678…"

test "a box wider than the screen is cut at the screen's edge, never wrapped onto the row above", ->
  Wide = component
    render
      Box flexDirection: 'column'
        Text "first row"
        Box width: 10, alignItems: 'center'
          Box width: 16
            Text "0123456789ABCDEF"
  eq renderToString(Wide, cols: 20), "first row\n3456789ABCDEF"

test "a glyph over half of a wide character blanks the other half", ->
  for at in [2, 3]
    Badge = component
      render
        Box width: 12, borderStyle: 'single'
          Text "日本語日本"
          Box position: 'absolute', top: 0, left: at
            Text "*"
    row = renderToString(Badge, cols: 14).split('\n')[1]
    eq Bun.stringWidth(row), 12
    eq row, (if at is 2 then "│日* 語日本│" else "│日 *語日本│")

test "text takes no padding or border, and text nested in text no layout at all", ->
  Padded = component
    render
      Text paddingX: 2
        "hi"
  Nested = component
    render
      Text
        "shown "
        Text width: 3
          "cut"
  throws (-> renderToString Padded), "'paddingX' has no meaning on text"
  throws (-> renderToString Nested), "'width' has no meaning on text nested in text"

test "a contents node draws no box, and its color still reaches its children", ->
  Lent = component
    render
      Box
        Box display: 'contents', color: 'green'
          Text "leaf"
  eq renderToString(Lent, cols: 8, ansi: true).trimEnd(), "\x1b[32mleaf\x1b[0m"

# ==[ Text and the painter ]==

console.log "\nPaint"

test "text wraps at its box, and nested runs keep their styles across the rows", ->
  Mixed = component
    render
      Box width: 10
        Text
          "plain "
          Text color: 'green', bold: true
            "green words"
          " end"
  eq renderToString(Mixed, cols: 12), "plain\ngreen\nwords end"
  rows = renderToString(Mixed, cols: 12, ansi: true).split '\n'
  eq rows[1].trimEnd(), "\x1b[1;32mgreen \x1b[0m"
  eq rows[2].trimEnd(), "\x1b[1;32mwords\x1b[0m end"

test "a cut line's ellipsis takes the style of the words it stands beside", ->
  cut = (wrap) ->
    Cut = component
      render
        Box width: 8
          Text wrap: wrap
            Text color: 'red'
              "red red "
            Text color: 'blue'
              "blue blue"
    renderToString(Cut, cols: 8, ansi: true).trimEnd()
  eq cut('truncate-end'), "\x1b[31mred red…\x1b[0m"
  eq cut('truncate-start'), "\x1b[34m…ue blue\x1b[0m"
  eq cut('truncate-middle'), "\x1b[31mred \x1b[0m…\x1b[34mlue\x1b[0m"

test "overflow: 'hidden' clips children to the padding box; overflowX and overflowY clip one axis", ->
  clipped = (styles) ->
    Clipped = component
      render
        Box width: 8, height: 4, borderStyle: 'single', style: styles
          Box width: 12, height: 4, flexShrink: 0
            Text "0123456789AB\nsecond row..\nthird row...\nfourth row.."
    renderToString Clipped, cols: 14
  eq clipped({ overflow: 'hidden' }), "┌──────┐\n│012345│\n│second│\n└──────┘"
  eq clipped({ overflowX: 'hidden' }), "┌──────┐\n│012345│\n│second│\n└third ┘"
  eq clipped({ overflowY: 'hidden' }), "┌──────┐\n│0123456789AB\n│second row..\n└──────┘"

test "nested clips intersect", ->
  Nested = component
    render
      Box width: 6, height: 2, overflow: 'hidden'
        Box width: 4, height: 4, overflow: 'hidden', marginLeft: 3, flexShrink: 0
          Box width: 9, flexShrink: 0
            Text "ABCDEFGHI\nabcdefghi\n123456789"
  eq renderToString(Nested, cols: 12), "   ABC\n   abc"

test "a wide character cut by a clip edge is a space in its style", ->
  Cut = component
    render
      Box width: 3, overflow: 'hidden'
        Box width: 6, flexShrink: 0
          Text backgroundColor: 'blue'
            "日本語"
  eq renderToString(Cut, cols: 6), "日"
  eq renderToString(Cut, cols: 6, ansi: true), "\x1b[44m日 \x1b[0m   "

test "content offsets shift a box's children, and owe a paint but no layout", ->
  Scrolled = component
    @down := 0
    render
      Box width: 6, height: 2, overflow: 'hidden', contentOffsetY: @down, contentOffsetX: 1
        Box flexShrink: 0
          Text "row 0\nrow 1\nrow 2\nrow 3"
  mounted Scrolled, (app, show, doc) ->
    eq show(), "ow 0\now 1"
    app.down.value = 2
    ok doc.stale and not doc.moved, 'a scroll is paint only'
    eq show(), "ow 2\now 3"

test "a border draws the edges it keeps, with a corner only where two of them meet", ->
  edge = (styles) ->
    Edged = component
      render
        Box width: 6, borderStyle: 'round', style: styles
          Text "ab"
    renderToString Edged, cols: 8
  eq edge({ borderTop: false }), "│ab  │\n╰────╯"
  eq edge({ borderBottom: false }), "╭────╮\n│ab  │"
  eq edge({ borderLeft: false }), "─────╮\nab   │\n─────╯"
  eq edge({ borderRight: false }), "╭─────\n│ab\n╰─────"
  eq edge({ borderLeft: false, borderRight: false }), "──────\nab\n──────"
  eq edge({ borderTop: false, borderBottom: false }), "│ab  │"

test "every border style of Ink's, and a style of one's own", ->
  framed = (look) ->
    Framed = component
      render
        Box width: 4, borderStyle: look
          Text "ab"
    renderToString Framed, cols: 4
  eq framed('single'), "┌──┐\n│ab│\n└──┘"
  eq framed('double'), "╔══╗\n║ab║\n╚══╝"
  eq framed('round'), "╭──╮\n│ab│\n╰──╯"
  eq framed('bold'), "┏━━┓\n┃ab┃\n┗━━┛"
  eq framed('singleDouble'), "╓──╖\n║ab║\n╙──╜"
  eq framed('doubleSingle'), "╒══╕\n│ab│\n╘══╛"
  eq framed('classic'), "+--+\n|ab|\n+--+"
  eq framed('arrow'), "↘↓↓↙\n→ab←\n↗↑↑↖"
  eq framed({ topLeft: '1', top: '2', topRight: '3', right: '4', bottomRight: '5', bottom: '6', bottomLeft: '7', left: '8' }), "1223\n8ab4\n7665"

test "each border edge takes its own color and dimming, else the border's", ->
  Tinted = component
    render
      Box width: 3, height: 3, borderStyle: 'single', borderColor: 'green', borderTopColor: 'red', borderLeftDimColor: true
  eq renderToString(Tinted, cols: 3, ansi: true).split('\n'), [
    "\x1b[31m┌─┐\x1b[0m"
    "\x1b[2;32m│\x1b[0m \x1b[32m│\x1b[0m"
    "\x1b[32m└─┘\x1b[0m"
  ]

test "a box's background fills inside its border, and text over it keeps it", ->
  Panel = component
    render
      Box width: 6, height: 3, borderStyle: 'single', backgroundColor: 'blue'
        Text "hi"
  eq renderToString(Panel, cols: 6, ansi: true).split('\n')[1], "│\x1b[44mhi  \x1b[0m│"

test "a background covers what lies under it", ->
  Covered = component
    render
      Box width: 8, height: 1
        Text "日本語日"
        Box position: 'absolute', left: 3, top: 0, width: 2, height: 1, backgroundColor: 'red'
  eq renderToString(Covered, cols: 8, ansi: true), "日 \x1b[41m  \x1b[0m 日"

test "text's own background fills its glyph cells and no more", ->
  Marked = component
    render
      Box width: 8
        Text backgroundColor: 'yellow'
          "ab"
  eq renderToString(Marked, cols: 8, ansi: true), "\x1b[43mab\x1b[0m      "

test "'default' is the terminal's own color: it stands against an ancestor's color and the background beneath", ->
  Bare = component
    render
      Box width: 6, backgroundColor: 'blue', color: 'red', flexDirection: 'row'
        Text "a"
        Text backgroundColor: 'default'
          "b"
        Text color: 'default'
          "c"
  eq renderToString(Bare, cols: 6, ansi: true), "\x1b[31;44ma\x1b[0;31;49mb\x1b[0;39;44mc\x1b[0;44m   \x1b[0m"
  # On a box it is a fill like any other: it covers what lies under it,
  # and text over it sits on it.
  Hole = component
    render
      Box width: 5, height: 1, backgroundColor: 'red'
        Text "abcde"
        Box position: 'absolute', left: 1, top: 0, width: 3, height: 1, backgroundColor: 'default'
          Box position: 'absolute', left: 1, top: 0
            Text "x"
  eq renderToString(Hole, cols: 5, ansi: true), "\x1b[41ma\x1b[0;49m x \x1b[0;41me\x1b[0m"
  eq inked(1, (doc) -> words doc, { color: 'red' }, '', words(doc, { color: 'default' }, 'x')), "\x1b[39mx\x1b[0m"

OPEN =! (url) -> "\x1b]8;;#{url}\x1b\\"
SHUT =! "\x1b]8;;\x1b\\"

test "a link wraps its words in OSC 8, nested text inherits it, and a plain frame has none of it", ->
  Linked = component
    render
      Box width: 16, flexDirection: 'row'
        Text "see "
        Text link: 'https://example.com/a?b=1;c'
          "the "
          Text bold: true
            "docs"
          Text link: 'https://example.com/other'
            "!"
  eq renderToString(Linked, cols: 16, ansi: true), "see #{OPEN 'https://example.com/a?b=1;c'}the \x1b[1mdocs\x1b[0m#{OPEN 'https://example.com/other'}!#{SHUT}   "
  eq renderToString(Linked, cols: 16), "see the docs!"
  # Over a box's background the words keep their link and the box does not take it.
  Panel = component
    render
      Box width: 4, backgroundColor: 'blue'
        Text link: 'https://example.com'
          "go"
  eq renderToString(Panel, cols: 4, ansi: true), "\x1b[44m#{OPEN 'https://example.com'}go\x1b[0;44m#{SHUT}  \x1b[0m"

test "a link that wraps is closed on every row and opened again on the next, its '…' inside it", ->
  Long = component
    render
      Box width: 5, flexDirection: 'column'
        Text link: 'https://example.com'
          "ab cd"
          Text color: 'red'
            " ef"
        Text link: 'https://example.com', wrap: 'truncate'
          "abcdefgh"
  eq renderToString(Long, cols: 5, ansi: true).split('\n'), [
    "#{OPEN 'https://example.com'}ab cd#{SHUT}"
    "\x1b[31m#{OPEN 'https://example.com'} ef\x1b[0m#{SHUT}  "
    "#{OPEN 'https://example.com'}abcd…#{SHUT}"
  ]

test "dimColor and strikethrough are text attributes beside bold, italic, underline, and inverse", ->
  Faint = component
    render
      Text dimColor: true, strikethrough: true
        "old"
  eq renderToString(Faint, cols: 3, ansi: true), "\x1b[2;9mold\x1b[0m"

test "a cluster is one glyph: a mark stays with its base, a joined emoji takes two cells", ->
  mark = String.fromCodePoint 0x301
  family = [0x1F468, 0x200D, 0x1F469, 0x200D, 0x1F467].map((code) -> String.fromCodePoint code).join ''
  Glyphs = component
    render
      Box width: 6, borderStyle: 'single'
        Text "e#{mark}#{family}!"
  row = renderToString(Glyphs, cols: 6).split('\n')[1]
  eq row, "│e#{mark}#{family}!│"
  eq Bun.stringWidth(row), 6

test "a text change that keeps its wrapped size owes a paint; one that changes its rows owes a layout", ->
  Note = component
    @words := 'aaa bbb ccc'
    render
      Box width: 7
        Text
          "#{@words}"
  mounted Note, (app, show, doc) ->
    eq show(), "aaa bbb\n ccc"
    flow = doc.body.firstChild.firstChild.flow
    eq flow.wraps, 1
    show()
    eq flow.wraps, 1, 'a frame that changes nothing wraps nothing'
    app.words.value = 'ccc bbb aaa'
    ok doc.stale and not doc.moved, 'the same rows at the same width'
    eq show(), "ccc bbb\n aaa"
    app.words.value = 'aaaa bbbbbb'
    ok doc.moved, 'rows of another width'
    eq show(), "aaaa\nbbbbbb"
    app.words.value = 'a b c d e f g h i j'
    ok doc.moved, 'a third row'

test "a background is what a box fills, and is never carried down the tree", ->
  Spill = component
    render
      Box flexDirection: 'row'
        Box width: 6, height: 1, backgroundColor: 'blue', flexShrink: 0
          Box width: 14, flexShrink: 0
            Text "spills-outside"
  eq renderToString(Spill, cols: 14, ansi: true), "\x1b[44mspills\x1b[0m-outside"
  Tip = component
    render
      Box flexDirection: 'column', width: 12
        Box height: 1, backgroundColor: 'red'
          Text "red row"
        Box height: 1, backgroundColor: 'blue'
          Text "blue"
          Box position: 'absolute', top: -1, left: 8
            Text "tip"
  eq renderToString(Tip, cols: 12, ansi: true).split('\n'), ["\x1b[41mred row tip \x1b[0m", "\x1b[44mblue        \x1b[0m"]

test "overlay text takes the background beneath it and keeps its own color and weight", ->
  Badge = component
    render
      Box width: 4, height: 1, backgroundColor: 'blue'
        Box position: 'absolute', left: 1, top: 0
          Text bold: true, color: 'red'
            "X"
  eq renderToString(Badge, cols: 4, ansi: true), "\x1b[44m \x1b[0;1;31;44mX\x1b[0;44m  \x1b[0m"

test "every text attribute sets its own cell flag and SGR parameter, alone, together, and nested", ->
  for [key, code] in [['bold', 1], ['dimColor', 2], ['italic', 3], ['underline', 4], ['inverse', 7], ['strikethrough', 9]]
    eq inked(1, (doc) -> words doc, { [key]: true }, 'x'), "\x1b[#{code}mx\x1b[0m", key
  eq inked(1, (doc) -> words doc, { bold: true, italic: true, underline: true }, 'x'), "\x1b[1;3;4mx\x1b[0m"
  eq inked(1, (doc) -> words doc, { dimColor: true, inverse: true, strikethrough: true }, 'x'), "\x1b[2;7;9mx\x1b[0m"
  eq inked(2, (doc) -> words doc, { bold: true }, 'a', words(doc, { underline: true }, 'b')), "\x1b[1ma\x1b[0;1;4mb\x1b[0m"
  eq inked(2, (doc) -> words doc, { italic: true }, 'a', words(doc, { strikethrough: true }, 'b')), "\x1b[3ma\x1b[0;3;9mb\x1b[0m"

test "color and weight pass down: a box's to the text inside it, a text's to the text nested in it", ->
  Toned = component
    render
      Box color: 'green', bold: true, dimColor: true
        Text "a"
  eq renderToString(Toned, cols: 1, ansi: true), "\x1b[1;2;32ma\x1b[0m"
  eq inked(2, (doc) -> words doc, { color: 'red' }, 'a', words(doc, { underline: true }, 'b')), "\x1b[31ma\x1b[0;4;31mb\x1b[0m"
  eq inked(2, (doc) -> words doc, { backgroundColor: 'yellow' }, 'a', words(doc, { bold: true }, 'b')), "\x1b[43ma\x1b[0;1;43mb\x1b[0m"

test "a border edge switched off insets neither the background nor the clip", ->
  filled = (styles) ->
    Filled = component
      render
        Box width: 4, height: 3, borderStyle: 'single', backgroundColor: 'blue', style: styles
    renderToString(Filled, cols: 4, ansi: true).split '\n'
  blue = (cells) -> "\x1b[44m#{' '.repeat cells}\x1b[0m"
  eq filled({ borderTop: false }), ["│#{blue 2}│", "│#{blue 2}│", "└──┘"]
  eq filled({ borderBottom: false }), ["┌──┐", "│#{blue 2}│", "│#{blue 2}│"]
  eq filled({ borderLeft: false }), ["───┐", "#{blue 3}│", "───┘"]
  eq filled({ borderRight: false }), ["┌───", "│#{blue 3}", "└───"]
  clipped = (styles) ->
    Clipped = component
      render
        Box width: 4, height: 3, borderStyle: 'single', overflow: 'hidden', style: styles
          Box width: 8, height: 4, flexShrink: 0
            Text "abcdefgh\nABCDEFGH\n12345678\nzzzzzzzz"
    renderToString(Clipped, cols: 4).split '\n'
  eq clipped({}), ["┌──┐", "│ab│", "└──┘"]
  eq clipped({ borderTop: false }), ["│ab│", "│AB│", "└──┘"]
  eq clipped({ borderBottom: false }), ["┌──┐", "│ab│", "│AB│"]
  eq clipped({ borderLeft: false }), ["───┐", "abc│", "───┘"]
  eq clipped({ borderRight: false }), ["┌───", "│abc", "└───"]

test "a border that straddles a clip edge is cut there, column by column", ->
  Straddle = component
    render
      Box width: 6, height: 3, overflowX: 'hidden'
        Box width: 4, height: 3, marginLeft: 3, borderStyle: 'single', flexShrink: 0
          Text "ab"
  rows = renderToString(Straddle, cols: 10, ansi: true).split '\n'
  eq rows, ["   ┌──    ", "   │ab    ", "   └──    "]
  Under = component
    render
      Box width: 6, height: 2, overflowY: 'hidden'
        Box width: 4, height: 3, borderStyle: 'single', flexShrink: 0
          Text "ab"
  eq renderToString(Under, cols: 6).split('\n'), ["┌──┐", "│ab│"]

test "a border edge's dimming falls back to the border's, and a false of its own stands against it", ->
  edges = (styles) ->
    Dimmed = component
      render
        Box width: 3, height: 3, borderStyle: 'single', borderColor: 'green', style: styles
    renderToString(Dimmed, cols: 3, ansi: true).split '\n'
  faint = "\x1b[2;32m"
  plain = "\x1b[32m"
  eq edges({ borderDimColor: true }), ["#{faint}┌─┐\x1b[0m", "#{faint}│\x1b[0m #{faint}│\x1b[0m", "#{faint}└─┘\x1b[0m"]
  eq edges({ borderDimColor: true, borderLeftDimColor: false })[1], "#{plain}│\x1b[0m #{faint}│\x1b[0m"
  eq edges({ borderDimColor: true, borderTopDimColor: false })[0], "#{plain}┌─┐\x1b[0m"
  eq edges({ borderDimColor: true, borderLeftColor: 'red' })[1], "\x1b[2;31m│\x1b[0m #{faint}│\x1b[0m"
  eq edges({ borderDimColor: true, borderBottomColor: 'red' })[2], "\x1b[2;31m└─┘\x1b[0m"
  eq edges({ borderRightDimColor: true }), ["#{plain}┌─┐\x1b[0m", "#{plain}│\x1b[0m #{faint}│\x1b[0m", "#{plain}└─┘\x1b[0m"]
  eq edges({ borderBottomDimColor: true })[2], "#{faint}└─┘\x1b[0m"

test "a border glyph obeys the rule text does: a control character is refused by name", ->
  { doc, restore } = install()
  try
    box = doc.createElement 'div'
    frame = { topLeft: '1', top: '2', topRight: '3', right: '4', bottomRight: '5', bottom: '6', bottomLeft: '7', left: '8' }
    for bad in ['\x1b', '\t', '\x07', '\n', "\x1b[31m-", String.fromCharCode(0x9B)]
      throws (-> box.set 'borderStyle', { ...frame, top: bad }), "borderStyle: top: #{JSON.stringify bad} is not a border glyph"
    eq box.styles, {}
  finally
    restore()

# The document hears a style that is written, never an object changed in
# place: a box keeps the eight glyphs its border had when it was set, so
# a frame that owes half of the box draws the glyphs of the other half.
test "a border object is copied when it is set: a change in place is not seen until it is set again", ->
  frame = { topLeft: '1', top: '2', topRight: '3', right: '4', bottomRight: '5', bottom: '6', bottomLeft: '7', left: '8' }
  Framed = component
    @word := 'ab'
    render
      Box flexDirection: 'column', alignItems: 'flex-start'
        Box width: 4, borderStyle: frame
          Text "ab"
        Box position: 'absolute', top: 0, left: 1
          Text "#{@word}"
  view = mount Framed, cols: 8, rows: 6
  try
    eq view.frame(), "1ab3\n8ab4\n7665"
    frame.top = frame.bottom = '='
    # The words over the top edge change, and owe two cells of it.
    view.app.word.value = 'c'
    eq view.frame(), "1c23\n8ab4\n7665"
    view.resize 9, 6
    eq view.frame(), "1c23\n8ab4\n7665"
    box = document.body.firstChild.firstChild
    box.set 'borderStyle', frame
    eq view.frame(), "1c=3\n8ab4\n7==5"
    eq view.damage, 4 * 3
    box.set 'borderStyle', { ...frame }
    view.frame()
    eq view.damage, 0
    frame.top = '\x07'
    throws (-> box.set 'borderStyle', frame), 'borderStyle: top: "\\u0007" is not a border glyph'
    eq view.frame(), "1c=3\n8ab4\n7==5"
  finally
    view.close()

