# Rip TUI: Rip components on a terminal. `run` installs the terminal
# document, mounts the app onto it, draws every change, and reads stdin
# into events; `mount` does the same off any terminal, draws when a test
# asks, and takes the test's keys by the same road.

import { __effect, __batch } from '../../src/runtime/reactive.js'
import { install, failed, watch, Event } from './document.rip'
import { tend, take, advance } from './focus.rip'
import { Parser, TIMERS } from './input.rip'
import { Screen, PACE } from './screen.rip'
import { Pointer } from './mouse.rip'
import { palette, backdrop, BACKDROP } from './paint.rip'
import { guard, setup, probe, reply, teardown, handover, stepping, stop as halt, ask, interactive as attended, depth as depthOf } from './terminal.rip'

# ── Widgets ───────────────────────────────────────────────────────────────────
# A box is a div and text is a span. Every prop a widget does not
# declare is a terminal style, forwarded to its node as written.

export Box = component extends div
  render
    div
      slot

export Text = component extends span
  render
    span
      slot

export Spacer = component
  render
    div flexGrow: 1

# The rows of a scrollbar's column, joined by line breaks, from half
# cells as OpenTUI draws them: the thumb is `view / total` of the
# `2 · tall` half cells, one at least, floored; it starts where the
# offset stands in `total − view`, rounded over the half cells it does
# not fill, so its foot meets the track's foot at the last offset. A
# cell the thumb fills is `█`, one it starts in at the top `▀`, else
# `▄`, and the rest are spaces on the track.
column =! (total, view, offset, tall) ->
  for [name, value] in [['total', total], ['shown', view], ['offset', offset]]
    throw Error.new "rip/tui: Scrollbar: #{name}: #{value} is not a number of rows, 0 or more" unless Number.isFinite(value) and value >= 0
  return '' if total <= view or tall < 1
  size = Math.max 1, Math.floor(2 * tall * view / total)
  from = Math.round Math.min(offset, total - view) / (total - view) * (2 * tall - size)
  to = from + size
  glyphs = for row in [0...tall]
    lo = if from > row * 2 then from else row * 2
    hi = if to < row * 2 + 2 then to else row * 2 + 2
    if hi - lo >= 2 then '█' else if hi > lo then (if lo is row * 2 then '▀' else '▄') else ' '
  glyphs.join '\n'

# A one-column track and thumb for a box that scrolls its children with
# `contentOffsetY`: `total` rows of content, `shown` rows the box shows,
# `offset` the box's content offset, and `height` the track's rows,
# `shown` unless given. Nothing is drawn while everything fits, and the
# neighbours take the column.
export Scrollbar = component
  @total := 0
  @shown := 0
  @offset := 0
  @height := null
  @trackColor := '#252527'
  @thumbColor := '#9a9ea3'
  thumb ~= column @total, @shown, @offset, @height ?? @shown
  render
    div width: 1, flexShrink: 0, backgroundColor: @trackColor, hidden: @total <= @shown
      span color: @thumbColor, thumb

# The content offset that brings rows [start, end) into a box `view`
# rows tall, from `offset` — as OpenTUI scrolls a child into view: rows
# past both ends move nothing; rows that start above and fit, or end
# below and do not, align to the top; rows that start above and do not
# fit, or end below and fit, align to the bottom; rows in view move
# nothing.
export reveal =! (start, end, offset, view) ->
  size = end - start
  above = start < offset
  below = end > offset + view
  return offset if above and below
  return start if (above and size < view) or (below and size > view)
  return end - view if (above and size > view) or (below and size < view)
  offset

# `count` line breaks inside text.
export Newline = component
  @count := 1
  render
    span "\n".repeat(@count)

# Items written once above the live frame, into the scrollback, and
# never painted in the frame: `Static` around a keyed `for`. Each item
# is painted when it first appears, at the terminal's width, with the
# items that appear in the same frame, in tree order; a change to it or
# its removal afterwards changes nothing written. The box's own styles
# — padding, margins, a background — go around each batch. On the
# alternate screen it writes nothing (screen.rip).
export Static = component extends div
  el := null
  ~>
    return unless el and live
    view = live.view
    view.statics.push el
    -> view.statics = view.statics.filter (other) -> other isnt el

  render
    div ref: el, display: 'none'
      slot

# Text written above the live frame, its line ended, by the road a
# `Static` item takes (`Screen.above`); `print.err` writes it to stderr,
# with the frame cleared on stdout first. With no app mounted the text
# goes to the stream as it is.
export print =! (text, err = null) ->
  text = String text
  text += '\n' unless text.endsWith '\n'
  return (err ?? process.stdout).write text unless live
  live.view.above text, err
print.err = (text) -> print text, live?.err ?? process.stderr

# ── Animation ─────────────────────────────────────────────────────────────────


# A clock: `frame`, `time` and `delta` as reactive reads, moved by one
# timer for its interval. The timer runs only while a component that
# holds the clock is mounted and something has read it — on the mount's
# own clock under `mount`, so `view.tick` moves it — and never off a
# terminal. A component holds the clock it makes in its body
# (`tick = clock 80`) and lets go when it unmounts, which stops the
# timer once no holder is left; a clock made outside any component is
# held for good, and its timer stops when the app closes. A stopped
# clock reads 0, whatever its cell holds: the runtime drops a write to
# a state made while that state's own effects run, so the reset `stop`
# writes is lost when the last holder lets go from an effect a beat ran
# — the Wipe ending itself — and the cell keeps that beat until the next
# run's first one lands. `stale` says so, and `read` answers zeros
# meanwhile; the write is kept for the readers it does reach.
ZERO =! Object.freeze { frame: 0, time: 0, delta: 0 }

class Tick
  constructor: (@interval) ->
    @cell = watch ZERO
    @holders = 0
    @cancel = null   # the running timer's cancel, while it runs
    @timers = null   # a timer source given by hand, a test's
    @source = null
    @began = @last = 0
    @stale = false   # the cell holds a beat of a run that has stopped

  get frame: -> @read().frame
  get time: -> @read().time
  get delta: -> @read().delta

  read: ->
    @start() if not @cancel and @holders and live and live.view.interactive isnt false
    beat = @cell.read()
    if @stale then ZERO else beat

  start!: ->
    @source = @timers ?? live.clock ?? TIMERS
    @began = @last = @source.now()
    @cancel = @source.after @interval, => @beat()

  # The timer is set again before the cells are written, so a reader
  # that runs again on the write finds it running.
  beat!: ->
    @cancel = null
    unless @holders and live
      @stop()
      return
    @cancel = @source.after @interval, => @beat()
    now = @source.now()
    @stale = false
    @cell.write Object.freeze { frame: Math.floor((now - @began) / @interval), time: now - @began, delta: now - @last }
    @last = now

  stop!: ->
    @cancel?()
    @cancel = null
    @stale = true
    @cell.write ZERO

  release!: ->
    @holders -= 1
    @stop() unless @holders

clocks =! Map.new()

# The clock for `interval` milliseconds (100 by default, and where the
# interval is no number); `timers` is a `{ now, after }` of a test's
# own to run it on.
export clock =! (interval = 100, timers = null) ->
  interval = if Number.isFinite(interval) then Math.max(1, interval) else 100
  tick = clocks.get interval
  clocks.set interval, tick = Tick.new interval unless tick
  tick.timers = timers if timers
  __effect ->
    tick.holders += 1
    -> tick.release()
  tick

# ── The mounted app ───────────────────────────────────────────────────────────

cols := 80
rows := 24
shown := true
keyboard := 'basic'
selected := ''
interactive := true
colors := 16777216
live = null

DEPTHS =! [0, 16, 256, 16777216]

class Viewport
  get cols: -> cols
  get rows: -> rows
  get focused: -> shown
  get keyboard: -> keyboard
  get selection: -> selected
  get interactive: -> interactive
  get colors: -> colors
  # Progress on the terminal's own indicator: 0 to 1, 'error',
  # 'indeterminate', or null to clear (screen.rip).
  progress: (value) -> live?.view.progress value
  # A function that rewrites each frame after it is painted and before
  # it is diffed, `(back, front) ->` on the two grids (screen.rip), or
  # null. Every set owes a whole frame, so a clock that sets it each
  # beat drives the frames it rewrites, and an unset draws one more,
  # which leaves nothing of the rewrite on the terminal.
  get post: -> live?.view.post ?? null
  set post: (fn) ->
    throw Error.new 'rip/tui: no app is running — screen.post rewrites the frames run draws' unless live
    throw Error.new "rip/tui: screen.post: #{JSON.stringify fn} is not a function — write (back, front) ->, or null to stop rewriting" unless fn is null or typeof fn is 'function'
    live.view.post = fn
    live.doc.damage.whole = true
    live.doc.owe false

# The terminal's size, whether it is the window the user is in (its
# focus reports), and whether its keyboard is enhanced, as reactive
# reads; the text the mouse has selected, as it was copied; whether
# frames go to a terminal someone is watching, and how many colors it
# is drawn with, as `run` read them.
export screen =! Viewport.new()

# The node the keyboard goes to, a reactive read that settles what the
# tree's changes left open, and the ways to move it: Tab's and
# Shift-Tab's, and to a node — or to nothing, with null.
class Focus
  get active: ->
    return null unless live
    tend live.doc
    live.doc.activeElement
  next!: -> advance live.doc, false if live
  previous!: -> advance live.doc, true if live
  to!: (node) -> if node then node.focus() else if live then take live.doc, null

export focus =! Focus.new()

# ── Input ─────────────────────────────────────────────────────────────────────

# Hand the app what was read. A listener that throws under `run` — or
# a child a key's change made, which failed to construct — has no
# caller to throw to: the terminal is given back, and `done` rejects.
receive! =! (held, events) ->
  try
    deliver held, events
    failed held.doc
  catch error
    throw error unless held.terminal
    fail held, error

fail! =! (held, error) ->
  close false, error if live is held

# Each event is a turn of its own: the tree is as the key before left it.
# A key goes to the focused node, or to the body while nothing has
# focus, as DOM sends it; the document hears it either way. Once the app
# is closing, or the terminal is another's, what is left of a read is
# nobody's. A mouse report is the
# pointer's to hit-test, and dropped while the mouse is off; a reply
# answers a probe.
deliver! =! (held, events) ->
  for event in events
    return unless live is held and not held.closing and not held.suspended
    switch event.type
      when 'focus' then shown = true
      when 'blur'
        shown = false
        held.pointer?.leave()
      when 'mouse' then held.pointer?.report event
      when 'reply' then keyboard = 'enhanced' if reply held, event
      when 'key', 'paste'
        tend held.doc
        sent = Event.new (if event.type is 'key' then 'keydown' else 'paste'), event
        act held, sent if (held.doc.active ?? held.doc.body).dispatchEvent(sent) and sent.type is 'keydown'

# The default actions, which run for a key no listener prevented: Tab
# and Shift-Tab move focus, Ctrl-C quits, Ctrl-Z stops the process
# (terminal.rip).
act! =! (held, event) ->
  return if event.altKey or event.metaKey
  if event.key is 'Tab' and not event.ctrlKey
    advance held.doc, event.shiftKey
  else if event.key is 'c' and event.ctrlKey
    quit()
  else if event.key is 'z' and event.ctrlKey
    halt held

# A clock a test moves by hand, for the parser's waits and the
# animation clocks: `tick` runs what falls due in order, the time
# standing at each as it runs.
class Clock
  constructor: ->
    @time = 0
    @due = []

  now: -> @time

  after: (ms, fn) ->
    entry = { at: @time + ms, fn }
    @due.push entry
    => @due = @due.filter (other) -> other isnt entry

  tick!: (ms) ->
    stop = @time + ms
    loop
      next = null
      next = entry for entry in @due when entry.at <= stop and (not next or entry.at < next.at)
      break unless next
      @due = @due.filter (entry) -> entry isnt next
      @time = next.at
      next.fn()
    @time = stop

# Put `App` on a terminal document of its own, to be drawn to `out`.
# The document is a global of the process, so one app is mounted at a
# time and a second is refused. `live` stands before the app is
# constructed, so a `quit` from an effect that runs during construction
# is heard. A terminal is taken as terminal.rip takes it — unless `out`
# is no terminal, or CI, in which case the frames are kept and only the
# last is written, at the end, as text.
open =! (App, options, out, terminal, stdin = null, clock = undefined) ->
  throw Error.new 'rip/tui: an app is already mounted in this process — `quit` or `close` it first' if live
  mouse = options.mouse ?? false
  throw Error.new "rip/tui: mouse: #{JSON.stringify mouse} is not true, false or 'all'" unless mouse is true or mouse is false or mouse is 'all'
  keys = options.keyboard ?? 'basic'
  throw Error.new "rip/tui: keyboard: #{JSON.stringify keys} is not 'basic' or 'enhanced'" unless keys is 'basic' or keys is 'enhanced'
  pace = options.pace ?? PACE
  throw Error.new "rip/tui: pace: #{JSON.stringify pace} is not a number of milliseconds, 0 or more" unless typeof pace is 'number' and pace >= 0 and pace < Infinity
  # A terminal's depth is its environment's; a mount's is the test's.
  shades = if terminal then -1 else DEPTHS.indexOf options.colors ?? 16777216
  throw Error.new "rip/tui: colors: #{JSON.stringify options.colors} is not 0, 16, 256 or 16777216" if shades < 0 and not terminal
  # What the terminal's own colors are taken to be under a translucent
  # background (paint.rip); refused before anything is installed.
  backdrop options.backdrop ?? BACKDROP
  { doc, restore } = install()
  attending = not terminal or attended out
  alternate = terminal and attending and options.altScreen is true
  # On a terminal the frame sits wherever the cursor was, which the
  # probe answers; until then, and where nothing answers, at the bottom.
  # The alternate screen's is its top.
  view = Screen.new doc, out, { whole: options.damage is false, interactive: attending, alt: alternate, origin: (if terminal and not alternate then Infinity else 0), pace, clock: (if terminal then null else clock) }
  cols = view.cols
  rows = view.rows
  interactive = view.interactive
  depth = if terminal then depthOf out else shades
  colors = DEPTHS[depth]
  palette depth
  held = null
  # The next frame is drawn whole, at the size the terminal has now.
  redraw = ->
    cols = view.cols
    rows = view.rows
    held.pointer?.clear()
    view.front = null
    doc.owe true
  # A resize reflows the terminal, so where the frame sits is asked again.
  resized = ->
    return if view.cols is cols and view.rows is rows
    redraw()
    ask held if held.mouse and held.raw and not view.alt
  settled = {}
  done = Promise.new (resolve, reject) ->
    settled.resolve = resolve
    settled.reject = reject
  live = held = { app: null, view, out, err: options.stderr ?? out.err ?? process.stderr, doc, restore, resized, redraw, done, settled, terminal, depth, console: options.console isnt false, closing: false, over: false, parser: null, stdin, read: null, clock, mouse, pointer: null, probing: keys is 'enhanced', asked: false, enhanced: false, pushed: false, raw: false, up: false, entered: false, suspended: false, wake: null, hold: null, handlers: null, was: null, logs: [], close: (drawn, error = null) -> close drawn, error if live is held }
  held.parser = Parser.new { clock, late: (events) -> receive held, events }
  held.read = (chunk) -> receive held, held.parser.feed chunk
  if mouse
    held.pointer = Pointer.new doc, view, out, mouse, options.selection isnt false, (text) -> selected = text
    view.after = -> held.pointer.rest()
  shown = true
  keyboard = 'basic'
  selected = ''
  try
    if terminal
      guard held
      setup held
    live.app = App.new(options.props ?? {})
    live.app.mount doc.body
    failed doc
    probe held if terminal
  catch error
    close false
    throw error
  live

# Every option run, mount and renderToString read. A misspelled key
# (`colz`) or a size that is no whole number (`cols: -5`) would otherwise
# fall back to a default and draw at the wrong size silently. 0 is the
# size a pty reports before it is set, and reads as the default.
OPTIONS =! Set.new ['altScreen', 'ansi', 'backdrop', 'colors', 'cols', 'console', 'damage', 'keyboard', 'mouse', 'pace', 'props', 'rows', 'selection', 'stderr', 'stdin', 'stdout']

checkOptions =! (options) ->
  for own key of options when not OPTIONS.has(key)
    throw TypeError.new "rip/tui: unknown option '#{key}'"
  for key in ['cols', 'rows'] when options[key]?
    size = options[key]
    unless typeof size is 'number' and size >= 0 and (Number.isInteger(size) or (key is 'rows' and size is Infinity))
      throw RangeError.new "rip/tui: #{key} must be a whole number#{if key is 'rows' then ' or Infinity' else ''}, got #{String(size)}"
  options

# Mount `App` on the terminal and keep it drawn until `quit`. Keys are
# read from `stdin`, which is the process's own unless `stdout` is given
# and `stdin` is not: a stream of one's own takes no keys from the
# terminal the process happens to be on.
export run =! (App, options = {}) ->
  checkOptions options
  stdin = if options.stdin isnt undefined then options.stdin else if options.stdout then null else process.stdin
  held = open App, options, options.stdout ?? process.stdout, true, stdin
  { view, out, doc, settled } = held
  try
    view.frame()
  catch error
    close false
    throw error
  # A frame that fails later is drawn from a timer, with no caller to
  # throw to: the terminal is given back first, and `done` rejects.
  view.failed = (error) -> fail held, error
  doc.onOwe = -> view.book()
  out.on? 'resize', held.resized
  { app: held.app, done: held.done, quit, flush: (-> view.frame() if doc.stale) }

# An app mounted off any terminal, for a test to drive: set its state
# through `app`, then draw. Nothing is drawn until `frame` asks, so a
# frame that fails throws to the test that asked for it — unless the
# mount has a `pace`: then a change books a frame as under `run`, drawn
# once `tick` moves the mount's clock to it, and a frame that fails
# throws from that `tick`.
class Mount
  constructor: (@held) ->

  get app: -> @held.app
  get done: -> @held.done

  # The last frame with its escape sequences, and what a terminal was
  # sent to draw it: the difference from the frame before.
  get ansi: -> @held.view.front?.toString(true) ?? ''
  get bytes: -> @held.out.sent

  # What was written above the frame so far, as it was written, and
  # what stderr was sent.
  get scrollback: -> @held.view.scrollback
  get stderr: -> @held.out.err.sent

  # The cells the last frame owed: those it painted and compared.
  get damage: -> @held.view.owed

  # The node that has focus, and where the last frame parked the cursor:
  # `{ x, y }` on the mount's terminal, or null while it is hidden.
  get focused: ->
    tend @held.doc
    @held.doc.activeElement
  get cursor: -> @held.view.parked

  # Input, by the road `run` reads stdin by. `press` is one key — DOM's
  # name or a character, with `ctrl`, `shift`, `alt`, `meta`, `repeat` —
  # or, given bytes that begin with a control character, those bytes;
  # `type` is text as a terminal sends it, a key per code point; `paste`
  # is one paste; `send` is raw bytes through the parser, whose waits run
  # on a clock `tick` moves.
  press!: (key, mods = {}) ->
    @driven()
    if key.charCodeAt(0) < 0x20 or key is '\x7f'
      @send key
      return
    receive @held, [{ type: 'key', key, ctrlKey: !!mods.ctrl, shiftKey: !!mods.shift, altKey: !!mods.alt, metaKey: !!mods.meta, repeat: !!mods.repeat, sequence: key }]
  type!: (text) -> @send text
  paste!: (text) -> @driven(); receive @held, [{ type: 'paste', text }]
  send!: (bytes) -> @driven(); receive @held, @held.parser.feed bytes
  # A closed mount takes no key, as it draws no frame.
  driven!: -> throw Error.new 'rip/tui: this mount is closed — there is no app to drive' unless live is @held
  tick!: (ms) -> @held.clock.tick ms

  # Draw what the app shows and hand the frame back as plain text.
  frame: ->
    throw Error.new 'rip/tui: this mount is closed — there is no app to draw' unless live is @held
    @held.out.sent = ''
    @held.view.frame()
    @held.view.front.toString()

  # The terminal takes another size; the next frame is drawn whole.
  resize!: (wide, tall) ->
    @held.out.columns = wide
    @held.out.rows = tall if tall?
    @held.resized()

  # Unmount the app and give the process its `document` slot back.
  close!: -> close false if live is @held

# Mount `App` once on a terminal of `cols` by `rows` that only keeps
# what it is sent, with a stderr of the same kind. With no `rows` it is
# as tall as the frame.
export mount =! (App, options = {}) ->
  checkOptions options
  out = { columns: options.cols ?? 80, rows: options.rows ?? Infinity, sent: '', write: (text) -> @sent += text }
  out.err = { sent: '', write: (text) -> @sent += text }
  held = open App, options, out, false, null, Clock.new()
  if options.pace?
    held.doc.onOwe = -> held.view.book()
    held.view.book()
  Mount.new held

# Give the terminal and the process back: the terminal as terminal.rip
# gives it back, the listeners, the `document` slot. `drawn` leaves the
# last frame in the scrollback — a mount's too, drawn with whatever the
# closing turn owed; a failure leaves whatever reached the screen. Every
# step is taken whatever the others do, so a write that fails cannot
# leave stdin raw or the document installed, and `done` is settled here
# — with `error`, the first step that failed, or `result`.
close! =! (drawn, error = null, result = undefined) ->
  held = live
  { app, view, out, doc, restore, resized, pointer, settled } = held
  live = null
  held.over = true
  keyboard = 'basic'
  doc.onOwe = null
  view.booked = false
  caught = { error }
  step = stepping caught
  # A selection is the screen's, never the scrollback's.
  step -> pointer.clear() if pointer
  selected = ''
  if held.terminal
    step ->
      missed = teardown held, drawn
      caught.error ?= missed
  else if drawn
    step -> view.frame() if doc.stale
  # What the teardown writes — a clock's last holder letting go resets
  # it — is flushed once the app is down, so no effect of its runs
  # against an app that is gone.
  step -> __batch -> app?.unmount()
  # The parser's wait is disarmed on every road, a mount's included.
  step -> held.parser.flush()
  step -> out.off? 'resize', resized
  step restore
  palette 3
  backdrop BACKDROP
  if caught.error then settled.reject caught.error else settled.resolve result

# Hand the terminal to `fn` — an editor, a shell — and take it back
# once `fn` settles, with a whole frame: the road Ctrl-Z takes, without
# the signal. A key that arrives meanwhile is nobody's.
export suspend =! (fn) ->
  throw Error.new 'rip/tui: no app is running — `suspend` hands over the terminal `run` holds' unless live
  handover live, fn

# Unmount the mounted app, leave its last frame on screen, and give the
# process its `document` slot back. The work waits for the turn to end,
# so a `quit` called from inside an effect still draws what that same
# change owed; an app closed by hand before then is left as it was.
export quit! =! (result) ->
  return unless live and not live.closing
  held = live
  held.closing = true
  queueMicrotask ->
    close true, null, result if live is held

# Text with its escape sequences taken out, and each row's trailing
# blanks with them.
SGR =! /\x1b\[[0-9;]*m|\x1b\]8;;[^\x1b]*\x1b\\/g
bare =! (text) -> (line.replace(SGR, '').trimEnd() for line in text.split '\n').join '\n'

# What `App` draws in `cols` columns, as text — plain by default, with
# escape sequences when `ansi` is set: mount, one frame, close. The
# rows its `Static` items wrote come first, then the frame.
export renderToString =! (App, options = {}) ->
  view = mount App, options
  try
    text = view.frame()
    above = view.scrollback
    above = above.slice 0, -1 if above.endsWith('\n') and not view.held.view.front.rows
    above = bare above unless options.ansi
    above + (if options.ansi then view.ansi else text)
  finally
    view.close()
