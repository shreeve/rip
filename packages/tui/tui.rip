# Rip TUI: Rip components on a terminal. `run` installs the terminal
# document, mounts the app onto it, and draws every change; `mount`
# does the same off any terminal and draws when a test asks.

import { install } from './document.rip'
import { Screen } from './screen.rip'

# ── Widgets ───────────────────────────────────────────────────────────────────
# A box is a div and text is a span. Every prop a widget does not
# declare is a terminal style, forwarded to its node as written.

export Box = component extends div
  render
    div
      slot

export Text = component extends span
  render
    span
      slot

export Spacer = component
  render
    div flexGrow: 1

# ── The mounted app ───────────────────────────────────────────────────────────

cols := 80
rows := 24
live = null

class Viewport
  get cols: -> cols
  get rows: -> rows

# The terminal's size, as reactive reads.
export screen =! Viewport.new()

# Put `App` on a terminal document of its own, to be drawn to `out`.
# The document is a global of the process, so one app is mounted at a
# time and a second is refused. `live` stands before the app is
# constructed, so a `quit` from an effect that runs during construction
# is heard.
open =! (App, options, out, terminal) ->
  throw Error.new 'rip/tui: an app is already mounted in this process — `quit` or `close` it first' if live
  { doc, restore } = install()
  view = Screen.new doc, out
  view.whole = options.damage is false
  cols = view.cols
  rows = view.rows
  resized = ->
    return if view.cols is cols and view.rows is rows
    cols = view.cols
    rows = view.rows
    view.front = null
    doc.owe true
  settled = {}
  done = Promise.new (resolve, reject) ->
    settled.resolve = resolve
    settled.reject = reject
  live = { app: null, view, out, doc, restore, resized, interrupted: (-> quit()), done, settled, terminal, closing: false }
  out.write "\x1b[?25l" if terminal
  try
    live.app = App.new(options.props ?? {})
    live.app.mount doc.body
  catch error
    close false
    throw error
  live

# Mount `App` on the terminal and keep it drawn until `quit`.
export run =! (App, options = {}) ->
  held = open App, options, options.stdout ?? process.stdout, true
  { view, out, doc, settled } = held
  try
    view.frame()
  catch error
    close false
    throw error
  # A frame that fails later is drawn from a timer, with no caller to
  # throw to: the terminal is given back first, and `done` rejects.
  view.failed = (error) ->
    close false
    settled.reject error
  doc.onOwe = -> view.book()
  out.on? 'resize', held.resized
  process.on 'SIGINT', held.interrupted
  { app: held.app, done: held.done, quit, flush: (-> view.frame() if doc.stale) }

# An app mounted off any terminal, for a test to drive: set its state
# through `app`, then draw. Nothing is drawn until `frame` asks, so a
# frame that fails throws to the test that asked for it.
class Mount
  constructor: (@held) ->

  get app: -> @held.app
  get done: -> @held.done

  # The last frame with its escape sequences, and what a terminal was
  # sent to draw it: the difference from the frame before.
  get ansi: -> @held.view.front?.toString(true) ?? ''
  get bytes: -> @held.out.sent

  # The cells the last frame owed: those it painted and compared.
  get damage: -> @held.view.owed

  # Draw what the app shows and hand the frame back as plain text.
  frame: ->
    throw Error.new 'rip/tui: this mount is closed — there is no app to draw' unless live is @held
    @held.out.sent = ''
    @held.view.frame()
    @held.view.front.toString()

  # The terminal takes another size; the next frame is drawn whole.
  resize!: (wide, tall) ->
    @held.out.columns = wide
    @held.out.rows = tall if tall?
    @held.resized()

  # Unmount the app and give the process its `document` slot back.
  close!: -> close false if live is @held

# Mount `App` once on a terminal of `cols` by `rows` that only keeps
# what it is sent. With no `rows` it is as tall as the frame.
export mount =! (App, options = {}) ->
  out = { columns: options.cols ?? 80, rows: options.rows ?? Infinity, sent: '', write: (text) -> @sent += text }
  Mount.new open(App, options, out, false)

# Give the terminal and the process back: the cursor, the listeners, the
# `document` slot. `drawn` leaves the last frame in the scrollback; a
# failure leaves whatever reached the screen.
close =! (drawn) ->
  { app, view, out, doc, restore, resized, interrupted, terminal } = live
  live = null
  doc.onOwe = null
  try
    if terminal
      if drawn then view.leave() else out.write "\x1b[?25h"
    app?.unmount()
  finally
    out.off? 'resize', resized
    process.off 'SIGINT', interrupted
    restore()

# Unmount the mounted app, leave its last frame on screen, and give the
# process its `document` slot back. The work waits for the turn to end,
# so a `quit` called from inside an effect still draws what that same
# change owed.
export quit =! (result) ->
  return unless live and not live.closing
  live.closing = true
  queueMicrotask ->
    return unless live
    { settled } = live
    try
      close true
      settled.resolve result
    catch error
      settled.reject error

# The frame `App` draws in `cols` columns, as text — plain by default,
# with escape sequences when `ansi` is set: mount, one frame, close.
export renderToString =! (App, options = {}) ->
  view = mount App, options
  try
    text = view.frame()
    if options.ansi then view.ansi else text
  finally
    view.close()
