# Rip TUI: Rip components on a terminal. `run` installs the terminal
# document, mounts the app onto it, and draws every change; the same
# tree renders to a string for tests.

import { install } from './document.rip'
import { Grid, paint } from './paint.rip'
import { Screen, settle } from './screen.rip'

# ── Widgets ───────────────────────────────────────────────────────────────────
# A box is a div and text is a span. Every prop a widget does not
# declare is a terminal style, forwarded to its node as written.

export Box = component extends div
  render
    div
      slot

export Text = component extends span
  render
    span
      slot

export Spacer = component
  render
    div flexGrow: 1

# ── The running app ───────────────────────────────────────────────────────────

cols := 80
rows := 24
live = null

class Viewport
  get cols: -> cols
  get rows: -> rows

# The terminal's size, as reactive reads.
export screen =! Viewport.new()

# Mount `App` on the terminal and keep it drawn until `quit`.
export run =! (App, options = {}) ->
  throw Error.new 'rip/tui: an app is already running in this process — `quit` it first' if live
  out = options.stdout ?? process.stdout
  { doc, restore } = install()
  view = Screen.new doc, out
  cols = view.cols
  rows = view.rows
  resized = ->
    return if view.cols is cols and view.rows is rows
    cols = view.cols
    rows = view.rows
    view.front = null
    doc.owe true
  interrupted = -> quit()
  settled = {}
  done = Promise.new (resolve, reject) ->
    settled.resolve = resolve
    settled.reject = reject
  # `live` stands before the app is constructed, so a `quit` from an
  # effect that runs during construction is heard.
  live = { app: null, view, out, doc, restore, resized, interrupted, settled, closing: false }
  out.write "\x1b[?25l"
  try
    live.app = App.new(options.props ?? {})
    live.app.mount doc.body
    view.frame()
  catch error
    close false
    throw error
  # A frame that fails later is drawn from a timer, with no caller to
  # throw to: the terminal is given back first, and `done` rejects.
  view.failed = (error) ->
    close false
    settled.reject error
  doc.onOwe = -> view.book()
  out.on? 'resize', resized
  process.on 'SIGINT', interrupted
  { app: live.app, done, quit, flush: (-> view.frame() if doc.stale) }

# Give the terminal and the process back: the cursor, the listeners, the
# `document` slot. `drawn` leaves the last frame in the scrollback; a
# failure leaves whatever reached the screen.
close =! (drawn) ->
  { app, view, out, doc, restore, resized, interrupted } = live
  live = null
  doc.onOwe = null
  try
    if drawn then view.leave() else out.write "\x1b[?25h"
    app?.unmount()
  finally
    out.off? 'resize', resized
    process.off 'SIGINT', interrupted
    restore()

# Unmount the running app, leave its last frame on screen, and give the
# process its `document` slot back. The work waits for the turn to end,
# so a `quit` called from inside an effect still draws what that same
# change owed.
export quit =! (result) ->
  return unless live and not live.closing
  live.closing = true
  queueMicrotask ->
    return unless live
    { settled } = live
    try
      close true
      settled.resolve result
    catch error
      settled.reject error

# The frame `App` draws in `cols` columns, as text — plain by default,
# with escape sequences when `ansi` is set.
export renderToString =! (App, options = {}) ->
  { doc, restore } = install()
  try
    app = App.new(options.props ?? {})
    app.mount doc.body
    settle doc, options.cols ?? 80, options.rows ?? null
    grid = Grid.new options.cols ?? 80, doc.body.rect.h
    paint grid, doc.body
    text = grid.toString options.ansi ?? false
    app.unmount()
    text
  finally
    restore()
