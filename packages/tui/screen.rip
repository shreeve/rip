# The screen: owed frames become one write each. A frame is laid out
# only when a box may have moved; the cells it owes — the document's
# damage — are painted into the spare grid and sent as their difference
# from the grid the terminal already shows, inside a synchronized update
# so the terminal never shows half of it.

import { layout } from './layout.rip'
import { Grid, paint, diff } from './paint.rip'

PACE =! 8     # the least milliseconds between two frames
PASSES =! 32  # the most layouts one frame may take to settle

# Lay the document out until a pass moves nothing. A binding that reads
# a node's box changes the tree it measured, so one change can take a
# pass per reader in a chain; readers that never agree are refused.
settle =! (doc, cols) ->
  passes = 0
  while doc.moved
    if (passes += 1) > PASSES
      throw Error.new "rip/tui: layout did not settle in #{PASSES} passes — a binding keeps changing the box it reads, so no size satisfies it"
    doc.moved = false
    layout doc.body, cols
  return

export class Screen
  constructor: (@doc, @out) ->
    @front = null
    @spare = null
    @booked = false
    @last = 0
    @failed = null
    @whole = false   # owe every cell of every frame, for a test to compare against
    @owed = 0        # the cells the last frame owed

  get cols: -> @out.columns ?? 80
  get rows: -> @out.rows ?? 24

  # Draw what is owed, now.
  frame!: ->
    @booked = false
    @last = performance.now()
    settle @doc, @cols
    @doc.stale = false
    tall = @doc.body.rect.h
    shown = Math.min tall, @rows
    back = @spare
    back = Grid.new @cols, shown unless back and back.cols is @cols and back.rows is shown
    back.top = tall - shown
    damage = @doc.damage
    damage.whole = true if @whole
    paint back, @doc.body, damage, @front
    bytes = diff @front, back, damage
    @owed = damage.count()
    # A whole frame is the spare grid entire; any other was copied into
    # the front one as it was compared.
    @spare = if damage.whole then @front else back
    @front = back if damage.whole
    damage.shape @front, false
    @out.write "\x1b[?2026h#{bytes}\x1b[?2026l" if bytes

  # Draw what is owed, once this turn's writes are in and no sooner than
  # the pace allows.
  book!: ->
    return if @booked
    @booked = true
    wait = PACE - (performance.now() - @last)
    if wait > 0 then setTimeout (=> @drawBooked()), wait else queueMicrotask (=> @drawBooked())

  # A booked frame has no caller to throw to, so its failure goes to
  # whoever runs the app.
  drawBooked!: ->
    try
      @frame()
    catch error
      throw error unless @failed
      @failed error

  # Leave the last frame in the scrollback, the cursor on the line below.
  leave!: ->
    @frame() if @doc.stale
    @out.write '\n'.repeat(@front?.rows ?? 0) + "\x1b[?25h"
