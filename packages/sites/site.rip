#!/usr/bin/env rip

# ==============================================================================
# rip/sites — Rip Sites authoring framework
# ==============================================================================
#
# Routes, smart responses, read() validation, and AsyncLocalStorage-powered
# request context for App + API workers managed behind Janus.
#
# Public exports:
#   DSL:        get, post, put, patch, del, all, use, prefix
#   Runtime:    start, fetch, App
#   Filters:    raw, before, after
#   Handlers:   onError, notFound
#   Errors:     error!, notice!, bail!
#   Validation: read, registerValidator, getValidator, isRawType,
#               validatorNames, check
#   Context:    ctx, session, env, subrequest, mark
#   Hub:        hub
#   Utilities:  isBlank, toName, toPhone, formatMoney
#   OpenAPI:    openapi, errorEnvelope
#   Dev:        resetGlobals, requestContext
# ==============================================================================

import { AsyncLocalStorage } from 'node:async_hooks'
import { posix, resolve } from 'node:path'

# ==============================================================================
# Module State
# ==============================================================================

_: RegExpMatchArray | null            = null  # Match capture holder for Rip's =~
_errorHandler: Function | null        = null  # Custom error handler
_notFoundHandler: Function | null     = null  # Custom 404 handler
_rawFilter: Function | null           = null  # Raw request filter (before body parsing)
_beforeFilters: Function[]            = []    # Before request filters
_afterFilters: Function[]             = []    # After request filters
_routes: any[]                        = []    # Route definitions
_middlewares: { fn: Function, regex?: RegExp, path?: string }[] = []  # Global + path-scoped middleware, in registration order
SESSION = :rip.server.session
_prefix: string                       = ''    # Current route prefix for grouping
_openapiRegistered: boolean           = false # GET /openapi.json auto-registered?
_openapiInfo: Record<string, any>     = { title: 'Rip API', version: '0.0.0' }
_routeIndex: any                      = null  # method → { statics, dynamics }; built lazily, cleared on registration
_composeEpoch: number                 = 0     # bumped when use/before/after mutate the chain inputs

export resetGlobals = ->
  _errorHandler        = null
  _notFoundHandler     = null
  _rawFilter           = null
  _beforeFilters       = []
  _afterFilters        = []
  _routes              = []
  _middlewares         = []
  _prefix              = ''
  _openapiRegistered   = false
  _openapiInfo         = { title: 'Rip API', version: '0.0.0' }
  _routeIndex          = null
  _composeEpoch++

# AsyncLocalStorage for request context (enables sync read() in handlers)
export requestContext: AsyncLocalStorage<{ env?: any, data: any }> = AsyncLocalStorage.new()

# ==============================================================================
# Router: Pattern Compiler
# ==============================================================================

# Lift :param slots (with their optional inline {pattern}) out of the path
# BEFORE literal escaping, so a custom pattern like :id{\d+} arrives as live
# regex — escaping first would neuter the braces and leave it unmatchable.
liftParams = (path, capture, keys = null) ->
  paramRe = /:(\w+)(?:\{([^}]+)\})?/g
  escapeLiteral = (s) -> s.replace /[.+^${}()|[\]\\]/g, '\\$&'
  out = ''
  last = 0
  loop
    m = paramRe.exec(path)
    break unless m?
    out += escapeLiteral(path.slice(last, m.index))
    keys?.push m[1]
    inner = m[2] or '[^/]+'
    out += if capture then "(#{inner})" else "(?:#{inner})"
    last = m.index + m[0].length
  out + escapeLiteral(path.slice(last))

compilePattern = (path) ->
  keys = []
  path = path.replace /\?$/, ''
  regex = liftParams(path, true, keys)
  wildcard = /(?<![\\*])\*(?!\*)/.test(regex)
  regex = regex.replace /(?<![\\*])\*(?!\*)/g, '(.*)'
  # A pattern with no captures and no wildcard matches exactly one path
  # (modulo the /?$ trailing slash) — eligible for the static-path Map.
  staticPath = if keys.length is 0 and not wildcard then path else null
  { regex: RegExp.new("^#{regex}/?$"), keys, staticPath }

# ==============================================================================
# Router: Route Matching
# ==============================================================================
#
# Routes are indexed per method on first lookup: static paths (no params, no
# wildcards) live in a Map under both spellings the compiled /?$ tolerates
# (`/x` and `/x/`); everything else stays an ordered regex list. Registration
# order is the tiebreak across both — a static hit only wins over dynamic
# routes registered after it, so `get '/users/:id'` before `get '/users/list'`
# still routes /users/list to :id, exactly as the linear walk did. Only the
# standard verbs are indexed (an arbitrary request method cannot grow the
# table); anything else takes the full walk. Route registration drops the
# index; resetGlobals does too.

INDEXED_METHODS =! Set.new(['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS', 'HEAD'])

routeBucket = (method) ->
  return null unless INDEXED_METHODS.has(method)
  _routeIndex ?= Map.new()
  bucket = _routeIndex.get(method)
  return bucket if bucket?
  bucket = { statics: Map.new(), dynamics: [] }
  for route, order in _routes
    continue unless route.method is method or route.method is 'ALL'
    if route.staticPath?
      entry = { route, order }
      bucket.statics.set(route.staticPath, entry) unless bucket.statics.has(route.staticPath)
      slashed = "#{route.staticPath}/"
      bucket.statics.set(slashed, entry) unless bucket.statics.has(slashed)
    else
      bucket.dynamics.push { route, order }
  _routeIndex.set(method, bucket)
  bucket

# Malformed %-encoding in a matched param (e.g. /u/%zz) is a client error:
# a status-400 throw that fetch() converts to a clean envelope, never a raw
# URIError escaping the exported handler.
decodeParam = (raw) ->
  try
    decodeURIComponent(raw)
  catch
    throw Object.assign(Error.new('malformed percent-encoding in path'), { status: 400 })

matchOne = (route, pathname) ->
  match = pathname.match route.regex
  return null unless match
  params = {}
  for key, i in route.keys
    params[key] = decodeParam(match[i + 1]) if match[i + 1]?
  { handler: route.handler, params, route }

matchRoute = (method, pathname) ->
  bucket = routeBucket(method)
  unless bucket?
    for route in _routes
      continue unless route.method is method or route.method is 'ALL'
      found = matchOne(route, pathname)
      return found if found?
    return null
  hit = bucket.statics.get(pathname)
  limit = if hit? then hit.order else Infinity
  for entry in bucket.dynamics
    break unless entry.order < limit
    found = matchOne(entry.route, pathname)
    return found if found?
  return { handler: hit.route.handler, params: {}, route: hit.route } if hit?
  null

# ==============================================================================
# Context Factory
# ==============================================================================

# Public type surface for route handlers. The `Ctx` shape mirrors the object
# returned by `createContext` below; `RouteHandler` types the `this`-bound
# context that handlers receive (passed as both `this` and first positional
# arg via `handler.call!(c, c)`), so `@req.json!`, `@params.id`, `@json(...)`
# all type-check in user code without needing per-app declarations.

export type CtxReq =
  raw: Request
  method: string
  url: string
  path: string
  site: string | null
  param: (key?: string) => any
  query: (key?: string) => any
  header: (key?: string) => any
  json: () => Promise<any>
  text: () => Promise<string>
  formData: () => Promise<FormData>
  parseBody: (opts?: Record<string, unknown>) => Promise<any>

export type Ctx =
  input: any
  json: (data: any, status?: number, headers?: Record<string, string>) => Response
  text: (str: string, status?: number, headers?: Record<string, string>) => Response
  html: (str: string, status?: number, headers?: Record<string, string>) => Response
  body: (data: BodyInit | null, status?: number, headers?: Record<string, string>) => Response
  redirect: (location: string, status?: number) => Response
  send: (path: string, type?: string) => Response
  header: (name: string, value?: string, opts?: { append?: boolean }) => string | null | undefined
  cache: (duration: number | string | false) => void
  session: Record<string, any>
  req: CtxReq

export type RouteHandler = (this: Ctx, c: Ctx, next?: () => Promise<void>) => any

# Duration units for @cache. Every accepted spelling is listed — plurals
# included — so nothing is inferred: `m` is minutes, a month is spelled
# `mo`/`month(s)` (30 days by convention), and `ms` matches nothing.
CACHE_UNITS =
  s: 1, sec: 1, secs: 1, second: 1, seconds: 1
  m: 60, min: 60, mins: 60, minute: 60, minutes: 60
  h: 3600, hr: 3600, hrs: 3600, hour: 3600, hours: 3600
  d: 86400, day: 86400, days: 86400
  w: 604800, week: 604800, weeks: 604800
  mo: 2592000, month: 2592000, months: 2592000
  y: 31536000, yr: 31536000, yrs: 31536000, year: 31536000, years: 31536000

# The helpers live on shared prototypes and take the context as `this`
# (handler.call(c, c) semantics unchanged), so a request allocates two small
# objects with own data fields instead of ~15 fresh closures. The outgoing
# `out` Headers is lazy — created on the first header write; a response whose
# headers were never touched builds from a plain object and skips it.

CtxReqProto =
  param: (key) -> if key? then @_params[key] else { ...@_params }
  query: (key) -> if key? then @_url.searchParams.get(key) else Object.fromEntries(@_url.searchParams)
  header: (key) -> if key? then @raw.headers.get(key) else Object.fromEntries(@raw.headers)
  json: -> @raw.json()
  text: -> @raw.text()
  formData: -> @raw.formData()
  parseBody: (opts = {}) ->
    ct = @raw.headers.get('content-type') or ''
    if ct =~ /json/i
      @raw.json!
    else if ct =~ /form/i
      fd = @raw.formData!
      Object.fromEntries(fd)
    else
      {}

CtxProto =
  # One response builder: an existing `out` takes the content type and the
  # per-call headers (which may override it, matching set-then-set order);
  # without one, a plain-object headers init avoids the Headers allocation.
  _respond: (data, status, headers, ctype) ->
    if @_out?
      @_out.set('Content-Type', ctype) if ctype?
      for k, v of headers then @_out.set(k, v)
      return Response.new data, { status, headers: @_out }
    h = if ctype? then { 'Content-Type': ctype, ...headers } else headers
    Response.new data, { status, headers: h }

  json: (data, status = 200, headers = {}) ->
    @_respond JSON.stringify(data), status, headers, 'application/json'

  text: (str, status = 200, headers = {}) ->
    @_respond str, status, headers, 'text/plain; charset=UTF-8'

  html: (str, status = 200, headers = {}) ->
    @_respond str, status, headers, 'text/html; charset=UTF-8'

  redirect: (location, status = 302) ->
    Response.new null, { status, headers: { Location: String(location) } }

  body: (data, status = 200, headers = {}) ->
    @_respond data, status, headers, null

  send: (path, type) ->
    out = (@_out ?= Headers.new())
    out.set 'X-Sendfile', resolve(path)
    out.set 'Content-Type', type if type?
    out.set 'Cache-Control', 'no-cache' unless out.has 'Cache-Control'
    Response.new null, { status: 200, headers: out }

  header: (name, value, opts: { append?: boolean } = {}) ->
    if value?
      out = (@_out ?= Headers.new())
      if opts.append then out.append(name, value) else out.set(name, value)
      return
    @_out?.get(name) ?? null

  # Sugar over standard Cache-Control — the same header steers a micro-cache
  # (Janus), a CDN, and the browser alike:
  #   @cache 10 / '90' / '36m' / '2 hours' / '1 month'  — freshness in seconds
  #   @cache 0 / false / 'off' / 'no-store'             — never store
  #   @cache 'forever'                                  — a year, immutable
  # A directive that does not parse throws: a cache instruction the framework
  # failed to read is a bug, never a preference to guess at.
  cache: (duration) ->
    out = (@_out ?= Headers.new())

    if duration is 0 or duration is false or duration is 'off' or duration is 'no-store'
      out.set 'Cache-Control', 'no-store'
      out.delete 'Expires'
      return

    if duration is 'forever'
      out.set 'Cache-Control', 'public, max-age=31536000, immutable'
      out.delete 'Expires'
      return

    seconds = 0
    if typeof duration is 'number'
      seconds = duration if Number.isInteger(duration)
    else if typeof duration is 'string'
      parts = duration.match(/^(\d+)\s*([a-z]+)$/i)
      if parts
        seconds = parseInt(parts[1], 10) * (CACHE_UNITS[parts[2].toLowerCase()] or 0)
      else if /^\d+$/.test(duration)
        seconds = parseInt(duration, 10)

    unless seconds > 0
      throw TypeError.new "cache() takes a duration (10, '36m', '2 hours'), 'forever', or a never-store form (0, false, 'off', 'no-store'); got #{JSON.stringify(duration)}"

    out.set 'Cache-Control', "public, max-age=#{seconds}"
    out.set 'Expires', Date.new(Date.now() + seconds * 1000).toUTCString()
    return

# fetch() passes its already-parsed url + normalized pathname through so the
# request is parsed exactly once; the defaults keep direct calls working.
createContext = (req, params = {}, url = null, pathname = null) ->
  url ?= URL.new(req.url)
  pathname ?= posix.normalize(url.pathname)
  r = Object.create(CtxReqProto)
  r.raw = req
  r.method = req.method
  r.url = req.url
  r.path = pathname
  # Janus strips a client-supplied Rip-Site and injects its resolved tenant
  # before proxying to a private worker socket. Standalone listeners have no
  # trusted edge and therefore never project the header into request context.
  r.site = if process.env.WORKER_ID? or process.env.SOCKET_PATH? then req.headers.get('rip-site') else null
  r._url = url
  r._params = params
  c = Object.create(CtxProto)
  c._out = null
  c.session = req[SESSION] or {}
  c.csrfToken = req.csrfToken if req.csrfToken?
  c.req = r
  c

# ==============================================================================
# Filter Composition
# ==============================================================================

compose = (beforeFilters, afterFilters, handler) ->
  (c) ->
    for filter in beforeFilters
      result = filter.call!(c, c)
      if result instanceof Response
        c._response = result
        return c
    result = handler.call!(c, c)
    c._response = result if result instanceof Response
    for filter in afterFilters
      filter.call!(c, c)
    c

# ==============================================================================
# Smart Response Wrapper
# ==============================================================================

STATUS_TEXT: Record<number, string> =
  400: 'Bad Request'
  401: 'Unauthorized'
  403: 'Forbidden'
  404: 'Not Found'
  409: 'Conflict'
  422: 'Unprocessable Entity'
  429: 'Too Many Requests'
  500: 'Internal Server Error'
  502: 'Bad Gateway'
  503: 'Service Unavailable'

export type ApiError = { message?: string, notice?: string, issues?: unknown[] }

# One JSON error envelope for every thrown error. `notice` (notice!) and
# `issues` (read/schema validation) are explicitly user-facing, so they're
# always shown. A plain `error!` message is shown only for 4xx; 5xx and raw
# throws (no/invalid status) are masked to a generic status message so internal
# details never leak. Exported so a custom `onError` can reuse the same shape.
# (`err` is an arbitrary thrown value — untyped by nature, like a catch binding.)
export errorEnvelope = (err: any): { status: number, error: ApiError } ->
  raw = err?.status
  status = if Number.isInteger(raw) and 400 <= raw <= 599 then raw else 500
  error =
    if err?.issues
      { message: err.message or 'Validation failed', issues: err.issues }
    else if err?.notice
      { notice: err.notice }
    else if status < 500
      { message: err.message or STATUS_TEXT[status] or 'Error' }
    else
      { message: STATUS_TEXT[status] or 'Internal Server Error' }
  { status, error }

smart = (fn) ->
  (c, next) ->
    result = if fn.length > 0 then fn.call!(c, c) else fn.call!(c)
    return result if result instanceof Response
    return c.json(result) if result? and typeof result is 'object'
    if typeof result is 'string'
      type = if result.trimStart().startsWith('<') then 'html' else 'text'
      return c[type](result)
    return c.text(String(result)) if typeof result in ['number', 'boolean']
    if result is null or result is undefined
      return Response.new(null, { status: 204 })
    result

# ==============================================================================
# DSL: Route Registration
# ==============================================================================

# Validate the JSON body through a schema before the handler runs. On
# failure the request never reaches the handler — a 400 with structured
# {field, error, message} issues goes out instead.
# On success the parsed, defaulted, coerced value is `@input`. Uses
# safeAsync so schemas with @ensure! async refinements work too.
withInput = (schema, fn) ->
  (c) ->
    if c._bodyInvalid
      err = Error.new 'Invalid JSON body'
      err.status = 400
      err.issues = [{ field: '', error: 'json', message: 'request body is not valid JSON' }]
      throw err
    r = schema.safeAsync! (c._body ?? {})
    unless r.ok
      err = Error.new 'Validation failed'
      err.status = 400
      err.issues = r.errors
      throw err
    c.input = r.value
    if fn.length > 0 then fn.call!(c, c) else fn.call!(c)

addRoute = (method, path, ...handlers) ->
  throw TypeError.new("#{method} requires an absolute path") unless typeof path is 'string' and path.startsWith('/')
  # Route options: a leading plain-object slot carries route metadata.
  # `input: SomeSchema` wires schema validation + the OpenAPI contract:
  #
  #   post '/signup', input: SignupInput, ->
  #     # @input is the parsed value; 400 with issues is automatic
  opts = null
  if handlers.length > 1 and handlers[0]? and typeof handlers[0] is 'object'
    opts = handlers[0]
    handlers = handlers.slice(1)
  throw TypeError.new("#{method} #{path} requires a handler") unless handlers.length and handlers.every((handler) -> typeof handler is 'function')
  _routeIndex = null
  fullPath = "#{_prefix}#{path}"
  if fullPath.includes(':') and fullPath.endsWith('?')
    basePath = fullPath.slice(0, -1).replace(/\/:[^\/]+$/, '')
    if basePath and basePath isnt fullPath.slice(0, -1)
      addRoute method, basePath, ...(if opts then [opts, ...handlers] else handlers)
    fullPath = fullPath.slice(0, -1)
  { regex, keys, staticPath } = compilePattern(fullPath)
  for handler in handlers
    h = if opts?.input then withInput(opts.input, handler) else handler
    _routes.push {
      method: method.toUpperCase(), regex, keys, staticPath,
      handler: smart(h), path: fullPath,
      inputSchema: opts?.input ?? null,
    }
  # The first input-validated route turns on the generated OpenAPI
  # document — GET /openapi.json reflects every such route, always
  # current, with zero additional authoring. Registered directly (no
  # _prefix) so it lives at the server root even inside prefix blocks.
  if opts?.input and not _openapiRegistered
    _openapiRegistered = true
    oa = compilePattern('/openapi.json')
    _routes.push {
      method: 'GET', regex: oa.regex, keys: oa.keys, staticPath: oa.staticPath,
      handler: smart(-> buildOpenAPI()), path: '/openapi.json',
      inputSchema: null,
    }

export get:   (path: string, ...handlers: RouteHandler[]) => void = (path, ...handlers) -> addRoute 'GET',    path, ...handlers
export post:  (path: string, ...handlers: RouteHandler[]) => void = (path, ...handlers) -> addRoute 'POST',   path, ...handlers
export put:   (path: string, ...handlers: RouteHandler[]) => void = (path, ...handlers) -> addRoute 'PUT',    path, ...handlers
export patch: (path: string, ...handlers: RouteHandler[]) => void = (path, ...handlers) -> addRoute 'PATCH',  path, ...handlers
export del:   (path: string, ...handlers: RouteHandler[]) => void = (path, ...handlers) -> addRoute 'DELETE', path, ...handlers
export all:   (path: string, ...handlers: RouteHandler[]) => void = (path, ...handlers) -> addRoute 'ALL',    path, ...handlers

# ==============================================================================
# OpenAPI generation
# ==============================================================================
#
# Every route registered with an `input:` schema contributes an
# operation: path params from the route pattern, requestBody from
# `schema.toJSONSchema()` (draft 2020-12), and the standard 400
# validation-failure shape. The document is rebuilt per request — route
# tables are small and this keeps it always-current.

ISSUE_SCHEMA =!
  type: 'object'
  properties:
    field:   { type: 'string' }
    error:   { type: 'string' }
    message: { type: 'string' }

buildOpenAPI = ->
  paths = {}
  for r in _routes
    continue unless r.inputSchema
    continue if r.method is 'ALL'
    oaPath = r.path.replace(/:([A-Za-z0-9_]+)\??/g, '{$1}')
    entry = (paths[oaPath] ?= {})
    op: Record<string, any> =
      responses:
        '200': { description: 'OK' }
        '400':
          description: 'Validation failed'
          content:
            'application/json':
              schema:
                type: 'object'
                properties:
                  error:
                    type: 'object'
                    properties:
                      message: { type: 'string' }
                      issues:  { type: 'array', items: ISSUE_SCHEMA }
      requestBody:
        required: true
        content:
          'application/json':
            schema: r.inputSchema.toJSONSchema()
    if r.keys?.length
      op.parameters = r.keys.map (k) -> { name: k, in: 'path', required: true, schema: { type: 'string' } }
    entry[r.method.toLowerCase()] = op
  { openapi: '3.1.0', info: _openapiInfo, paths }

# Customize the document's info block and/or build it imperatively:
#
#   openapi title: 'Trust Health API', version: '1.4.0'
export openapi = (info = null) ->
  Object.assign(_openapiInfo, info) if info
  buildOpenAPI()

# use(mw) registers global middleware; use(path, mw) scopes it to requests
# whose path matches the pattern — the pattern covers the path itself AND
# anything beneath it (use '/api' runs for /api and /api/users), using the
# same :param / * grammar as routes. Patterns are match-only: their :params
# are never exposed to middleware or handlers. Global and scoped middleware
# share ONE registration order; a scoped entry is skipped when the request
# path is outside its pattern.
compileMiddlewarePattern = (path) ->
  path = path.replace /\/+$/, ''
  source = liftParams(path, false)
  source = source.replace /(?<![\\*])\*(?!\*)/g, '.*'
  RegExp.new("^#{source}(?:/|$)")

export use = (pathOrMw, mw = null) ->
  _composeEpoch++
  if typeof pathOrMw is 'function' and not mw?
    _middlewares.push { fn: pathOrMw }
  else if typeof pathOrMw is 'string' and pathOrMw.startsWith('/') and typeof mw is 'function'
    _middlewares.push { fn: mw, regex: compileMiddlewarePattern(pathOrMw), path: pathOrMw }
  else
    throw TypeError.new 'use() takes a middleware function or an absolute path and middleware function'

export prefix = (base, fn) ->
  old = _prefix
  _prefix = "#{_prefix}#{base}"
  try
    fn?.()
  finally
    _prefix = old

export onError:  (handler: RouteHandler) => void = (handler) -> _errorHandler = handler
export notFound: (handler: RouteHandler) => void = (handler) -> _notFoundHandler = handler

export raw: (fn: (req: Request) => any) => void = (fn) -> _rawFilter = fn

export before: (fn: RouteHandler) => void = (fn) ->
  _composeEpoch++
  _beforeFilters.push fn

export after: (fn: RouteHandler) => void = (fn) ->
  _composeEpoch++
  _afterFilters.push fn

# ==============================================================================
# Main Fetch Handler
# ==============================================================================

dispatchRequest = (req) ->
  url = URL.new(req.url)
  pathname = posix.normalize(url.pathname)
  method = req.method

  match = null
  try
    match = matchRoute((if method is 'HEAD' then 'GET' else method), pathname)
  catch err
    { status, error } = errorEnvelope(err)
    return Response.new JSON.stringify({ error }), { status, headers: { 'Content-Type': 'application/json; charset=utf-8' } }

  unless match
    c = createContext(req, {}, url, pathname)
    if _notFoundHandler?
      data = c.req.query()
      return requestContext.run! { env: c, data }, -> _notFoundHandler.call!(c, c)
    return Response.new('Not Found', { status: 404 })

  c = createContext(req, match.params, url, pathname)

  # Run raw filter before body parsing (e.g., fix content-type)
  _rawFilter?.(req) if method in ['POST', 'PUT', 'PATCH']

  # Pre-parse body and query for sync read() — baked in, zero ceremony
  data: any = {}
  try
    ct = req.headers.get('content-type') or ''
    if method in ['POST', 'PUT', 'PATCH']
      if ct =~ /json/i
        data = c.req.json!
      else if ct =~ /x-www-form-urlencoded/i
        # Parse from the raw text so the bare-body heuristic can see it:
        # `curl -d 'some text'` sends no '=' and parses as {text: ''} —
        # surface that as {body: text}. A real form clearing its only
        # field (`subscribe=`) contains '=' and parses normally.
        rawBody = c.req.text!
        data = Object.fromEntries(URLSearchParams.new(rawBody))
        keys = Object.keys(data)
        data = { body: keys[0] } if keys.length is 1 and not rawBody.includes('=')
      else if ct =~ /form-data/i
        data = c.req.parseBody!
      else if ct =~ /text\//i
        data = { body: c.req.text! }
  catch
    data = {}
    c._bodyInvalid = true
  # The body stream is consumed now — route `input:` validation reads
  # the parsed value from here, never from c.req.json() again.
  c._body = data
  merged = { ...data, ...c.req.query(), ...match.params }

  # Run handler inside AsyncLocalStorage context
  requestContext.run! { env: c, data: merged }, ->
    runHandler!(c, match.route)

# Web-standard middleware wraps routing. Passing a Request to next() replaces
# the downstream request while preserving request-local middleware state.
invokeMiddleware = (request) ->
  last = -1
  invoke = (index, currentRequest) ->
    throw Error.new('middleware called next() more than once') if index <= last
    last = index
    if index < _middlewares.length
      entry = _middlewares[index]
      path = posix.normalize(URL.new(currentRequest.url).pathname)
      return invoke!(index + 1, currentRequest) if entry.regex? and not entry.regex.test(path)
      return entry.fn currentRequest, (nextRequest = currentRequest) ->
        throw TypeError.new('middleware next() replacement must be a Request') unless nextRequest instanceof Request
        if nextRequest isnt currentRequest
          nextRequest[SESSION] = currentRequest[SESSION] if currentRequest[SESSION]?
          nextRequest[key] = currentRequest[key] for key in Object.keys(currentRequest)
        invoke!(index + 1, nextRequest)
    dispatchRequest! currentRequest
  invoke! 0, request

export fetch = (request) ->
  try
    response = invokeMiddleware! request
    throw TypeError.new('middleware chain returned no Response') unless response instanceof Response
    if request.method is 'HEAD'
      Response.new null, { status: response.status, statusText: response.statusText, headers: response.headers }
    else
      response
  catch err
    console.warn 'Request error:', err if not err?.status or err.status >= 500
    { status, error } = errorEnvelope(err)
    Response.new JSON.stringify({ error }), { status, headers: { 'Content-Type': 'application/json; charset=utf-8' } }

# Each route's filter chain is cached on the route object.
composedChain = (route) ->
  return route._chain if route._chain? and route._chainEpoch is _composeEpoch
  route._chainEpoch = _composeEpoch
  route._chain = compose(_beforeFilters, _afterFilters, route.handler)

# Internal: Execute handler with middleware and error handling
runHandler = (c, route) ->
  # Stamp the opt-in correlation id (`@mark = ...` in the handler) onto an
  # internal response header. Janus scrubs `rip-mark` from client responses
  # in its data plane and surfaces it for access logging — so one handler
  # line (`@mark = corrId`) ties the access log, any `mark()` reads in
  # library code, and downstream logs together without leaking the id.
  applyMark = (r) ->
    return r unless r? and c.mark?
    try r.headers.set('rip-mark', String(c.mark))
    r
  try
    chain = composedChain(route)
    chain!(c)
    applyMark(c._response or Response.new('', { status: 204 }))
  catch err
    console.warn 'Request error:', err if not err?.status or err.status >= 500
    res = if _errorHandler?
      _errorHandler.call!(c, err, c)
    else
      # Same masked JSON envelope smart() emits: 5xx internals never leak.
      masked = errorEnvelope(err)
      Response.new JSON.stringify({ error: masked.error }), { status: masked.status, headers: { 'Content-Type': 'application/json; charset=utf-8' } }
    applyMark(res)

# ==============================================================================
# Server Startup
# ==============================================================================

export start = ->
  unless process.env.APP_ARTIFACT? and process.env.SOCKET_PATH?
    throw Error.new 'start() requires the Rip worker runtime — run the application with `rip site`'
  globalThis.__ripHandler = fetch
  fetch

# Bam Hub bridge — Janus POSTs open|text|close here; return directive
# frames (or null for 204). `bridge: 'hub'` matches serve.rip and becomes
# POST /hub. auth: true (default) requires session.authenticated.
export hub = (opts = {}) ->
  throw TypeError.new('hub options must be an object') unless opts? and typeof opts is 'object' and not Array.isArray(opts)
  name = opts.bridge ?? 'hub'
  throw TypeError.new('hub.bridge must be a nonempty string') unless typeof name is 'string' and name.length > 0
  name = name.replace(/^\/+/, '').replace(/\/+$/, '')
  throw TypeError.new('hub.bridge must be a path name without ? #') if name.length is 0 or /[?#\s]/.test(name) or name.includes('\\') or name.includes('//')
  for part in name.split('/')
    throw TypeError.new('hub.bridge must not contain . or .. segments') if part is '' or part is '.' or part is '..'
  bridgePath = "/#{name}"
  auth = opts.auth
  auth = true if auth is undefined
  throw TypeError.new('hub.auth must be boolean or a function') unless typeof auth is 'boolean' or typeof auth is 'function'
  open = opts.open ?? (-> null)
  text = opts.text ?? (-> null)
  close = opts.close ?? (-> null)
  for [label, fn] in [['open', open], ['text', text], ['close', close]]
    throw TypeError.new("hub.#{label} must be a function") unless typeof fn is 'function'
  post bridgePath, ->
    if auth is true
      bail! unless session.authenticated is true
    else if typeof auth is 'function'
      bail! unless auth.call(@)
    kind = (@req.header('sec-websocket-frame') or '').toLowerCase()
    if kind is 'open' then return open.call(@)
    if kind is 'close' then return close.call(@)
    if kind is 'text' then return text.call(@)
    null

export App = (fn) ->
  resetGlobals()
  fn?.()
  fetch

# ==============================================================================
# Utility: Get Current Environment/Context
# ==============================================================================

export ctx = ->
  store = requestContext.getStore()
  store?.env or null

# mark() — current request's correlation id (whatever the handler assigned
# to `@mark`). Returns null if no handler has set one, or if called outside
# a request. Use from library code that needs to tag logs/artifacts with
# the same id the access log shows:
#
#   labcorpFetch = (path, opts) ->
#     corrId = mark()
#     console.log "[labcorp] #{corrId or '-'} → #{opts.method} #{path}"
#
export mark = -> requestContext.getStore()?.env?.mark or null

# Subrequest — run a function with new data but same @ context
# Enables read() to work against a synthetic payload while preserving
# all @ variables from the parent request (e.g., @token).
export subrequest = (data, fn) ->
  store = requestContext.getStore() or throw Error.new 'no context for subrequest()'
  requestContext.run! { env: store.env, data }, ->
    fn.call!(store.env)

# Session proxy — access session.foo anywhere (via AsyncLocalStorage)
export session: Record<string, any> = Proxy.new {},
  get: (_, key) ->
    requestContext.getStore()?.env?.session?[key]
  set: (_, key, value) ->
    ctx = requestContext.getStore()?.env or throw Error.new 'session is only available during a request'
    ctx.session ?= {}
    ctx.session[key] = value
    true
  deleteProperty: (_, key) ->
    ctx = requestContext.getStore()?.env or throw Error.new 'session is only available during a request'
    delete ctx.session[key] if ctx.session?
    true

# Env proxy — access env.FOO anywhere (shortcut for process.env)
export env = Proxy.new {}, get: (_, key) -> process.env[String(key)]

# ==============================================================================
# Error Helpers — Halt request with an HTTP error
# ==============================================================================

export error = (message = 'Bad request', status = 400) ->
  throw Object.assign(Error.new(message), { status })

export notice = (message = 'Something went wrong', status = 400) ->
  throw Object.assign(Error.new(message), { status, notice: message })

export bail = ->
  store = requestContext.getStore()
  if store?.env?.session?
    for key of store.env.session
      delete store.env.session[key]
  # 401, not 403: bail is the no/invalid-session case (missing credentials),
  # which is "(re)authenticate" — and it just cleared the session. 403
  # (authenticated-but-refused) stays with `error! '…', 403`.
  throw Object.assign(Error.new('Unauthorized'), { status: 401 })

# ==============================================================================
# Utility Functions
# ==============================================================================

# The validation/normalization vocabulary lives in rip/validate — a
# zero-dependency, browser-safe (`rip.browser: true`) package, so the same
# validators that power `read()` here also power `~:name` schema coercers
# in client-side `.parse()` calls. Importing it registers every validator
# as a named schema coercer. Re-exported here: these are part of
# rip/sites's public surface.

import { isBlank, toName, toPhone, formatMoney, registerValidator, getValidator, isRawType, validatorNames, check } from 'rip/validate'
export { isBlank, toName, toPhone, formatMoney, registerValidator, getValidator, isRawType, validatorNames, check }

# ==============================================================================
# read() — Sinatra-style Parameter Reading
# ==============================================================================

export read = (name?: string, type?: string | RegExp | any[] | Record<string, any>, miss?: any) ->
  store = requestContext.getStore() or throw Error.new 'no context for read()'

  # missing value helper
  done = (must = false) ->
    return miss() if typeof miss is 'function'
    throw Object.assign(Error.new("Missing required field: #{name}"), { status: 400 }) if must
    return miss ?? null

  # get value from store — supports dotted paths for nested JSON bodies,
  # e.g. read 'patient.firstName' walks {patient: {firstName: ...}}
  v = store.data or {}
  if name?
    for part in name.split('.')
      break unless v? and typeof v is 'object'
      v = v[part]
  return v if type is 'raw'
  v = v.trim() if typeof v is 'string'

  # value only, no validator
  if !type?
    return v if v?
    return done()

  # String: apply validator function
  else if typeof type is 'string'

    # detect required value (trailing '!')
    if type.endsWith '!'
      must = true
      type = type.slice(0, -1)

    # detect loud-optional (trailing '?'): an absent/empty value stays a
    # quiet null — optional means optional — but a SUPPLIED value that
    # fails its validator throws, naming the field. Without this, a
    # typo'd value coerces to null and impersonates an omitted one; at a
    # boundary that distinction is the whole point of validating.
    else if type.endsWith '?'
      loud = true
      type = type.slice(0, -1)

    # apply validator function — raw validators (array/hash/json) take
    # the value untouched; the registry's isRawType seam decides.
    f = getValidator(type)
    supplied = v? and v isnt ''
    v = String(v ?? '') unless isRawType(type)
    v = if f then f(v) else null
    if loud and supplied and not v?
      throw Object.assign(Error.new("#{name} is not a valid #{type}"), { status: 422, field: name, invalid: true })

  # Regex: apply regex pattern
  else if type instanceof RegExp
    s = String(v ?? '')
    v = s.match(type)?[0] or null

  # Array: [min, max] constraint or enumeration
  else if Array.isArray(type)
    s = String(v ?? '')
    y: boolean = true
    if typeof type[0] is 'number'
      [min, max] = type
      if typeof v is 'number' or (s =~ /^[-+]?\d+$/)
        n = if typeof v is 'number' then v else +s
        y = false if min? and n < min
        y = false if max? and n > max
        v = if y then n else null
      else
        y = false if min? and s.length < min
        y = false if max? and s.length > max
        v = if y then s else null
    else
      v = if type.includes(s) then s else null

  # Object: start/end, min/max
  else if type? and typeof type is 'object'
    s = String(v ?? '')
    if type.start? or type.end?
      n = if s =~ /^[-+]?\d+$/ then +s else NaN
      v = if not isNaN(n) and (not type.start? or n >= type.start) and (not type.end? or n <= type.end) then n else null
    else if type.min? or type.max?
      y: boolean = true
      if typeof v is 'number' or (s =~ /^[-+]?\d+$/)
        n = if typeof v is 'number' then v else +s
        y = false if type.min? and n < type.min
        y = false if type.max? and n > type.max
        v = if y then n else null
      else
        y = false if type.min? and s.length < type.min
        y = false if type.max? and s.length > type.max
        v = if y then s else null

  # blank / missing value handling
  if not v? or (typeof v is 'string' and v.trim() is '')
    return done(must)

  v

# Executed directly, this file is the framework library only.
# The user CLI is `rip sites`; the control plane spawns manager.rip.
if import.meta.main
  abort 'rip-sites: this module is the Sites framework library — use `rip sites run` (or other `rip sites` verbs)'
