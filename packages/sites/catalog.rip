#!/usr/bin/env rip

# Durable Sites catalog — Rip owns sites.json. Janus never writes this file.
# The agent is the only writer; CLI readers use the same schema.

import { closeSync, existsSync, fsyncSync, openSync, readFileSync, renameSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import { agentPaths } from './appliance.rip'
import { managerRuntime } from './control.rip'

export RESERVED = ['edge', 'all', 'agent']

isRecord = (value) -> value? and typeof value is 'object' and not Array.isArray(value)

fail = (message, status = 400) ->
  error = Error.new message
  error.status = status
  throw error

# The edge is Janus's process and so is its exposure scope; the catalog
# keeps only Rip's URL shape and last edge configuration error.
defaultEdge = ->
  baseUrl: 'https://{host}/'
  lastError: null

export defaultCatalog = ->
  version: 1
  apps: []
  edge: defaultEdge()

writeSecure = (paths, path, text) ->
  temporary = "#{path}.tmp-#{process.pid}"
  fd = openSync temporary, 'w', 0o600
  try
    writeFileSync fd, text
    fsyncSync fd
  finally
    closeSync fd
  renameSync temporary, path
  directory = openSync paths.stateRoot, 'r'
  try fsyncSync(directory) finally closeSync(directory)

validateCatalog = (state, path) ->
  fail("malformed state at #{path}", 500) unless isRecord(state) and state.version is 1 and Array.isArray(state.apps) and isRecord(state.edge)
  ids = Set.new()
  names = Set.new()
  roots = Set.new()
  for app in state.apps
    valid = isRecord(app) and /^[a-f0-9]{16}$/.test(app.id) and typeof app.name is 'string' and typeof app.root is 'string' and Array.isArray(app.hosts) and app.hosts.every((host) -> typeof host is 'string') and isRecord(app.options) and Number.isInteger(app.options.workers) and app.options.workers > 0 and Number.isInteger(app.options.concurrency) and app.options.concurrency > 0 and typeof app.options.watchApp is 'boolean' and typeof app.options.watchApi is 'boolean' and typeof app.options.eager is 'boolean' and app.desired in ['running', 'stopped']
    fail("malformed app record at #{path}", 500) unless valid
    fail("reserved app name #{JSON.stringify(app.name)} at #{path}", 500) if app.name in RESERVED
    fail("duplicate app record at #{path}", 500) if ids.has(app.id) or names.has(app.name) or roots.has(app.root)
    ids.add app.id
    names.add app.name
    roots.add app.root
  edge = state.edge
  valid = typeof edge.baseUrl is 'string' and edge.baseUrl.includes('{host}') and (edge.lastError is null or typeof edge.lastError is 'string')
  fail("malformed edge record at #{path}", 500) unless valid
  state

export loadCatalog = (label = 'rip-sites') ->
  paths = agentPaths label
  return defaultCatalog() unless existsSync paths.catalog
  try
    validateCatalog JSON.parse(readFileSync(paths.catalog, 'utf8')), paths.catalog
  catch error
    fail "cannot read catalog at #{paths.catalog}: #{error?.message or error}"

export saveCatalog = (doc, label = 'rip-sites') ->
  paths = agentPaths label
  validateCatalog doc, paths.catalog
  writeSecure paths, paths.catalog, JSON.stringify(doc, null, 2) + '\n'
  doc

export findCatalogApp = (doc, selector, required = true) ->
  matches = doc.apps.filter (app) -> app.id is selector or app.name is selector or app.root is selector
  return null unless required or matches.length
  fail "unknown app #{JSON.stringify(selector)}", 404 unless matches.length
  fail "ambiguous app #{JSON.stringify(selector)}", 409 unless matches.length is 1
  matches[0]

readOwnerPid = (root, label) ->
  owner = managerRuntime(root, label).owner
  return null unless existsSync owner
  try
    value = JSON.parse readFileSync(owner, 'utf8')
    if Number.isInteger(value.pid) then value.pid else null
  catch then null

# Live manager probe without the control plane — keeps list/status honest after crash.
# Hosts mirror the agent's effective order (manager → catalog pin → serve.rip);
# this runs in a one-shot CLI process, so importing serve.rip directly is
# always fresh — the module-cache staleness the agent must dodge cannot occur.
export snapshotCatalogApp = (app, label = 'rip-sites') ->
  manager = null
  try
    response = fetch! 'http://manager/status', { method: 'GET', unix: managerRuntime(app.root, label).socket, signal: AbortSignal.timeout(500) }
    manager = response.json! if response.ok
  catch then null
  hosts = app.hosts or []
  site = manager?.site or null
  serveError = null
  if manager?.hosts?.length
    hosts = manager.hosts
  else if site?
    hosts = Object.keys site.aliases or {}
  else if not hosts.length and existsSync join(app.root, 'serve.rip')
    try
      # Lazy: manager.rip's module graph is heavy and only this offline
      # serve.rip branch needs it — keep it off the common CLI path.
      { loadServeConfig } = import!(join(import.meta.dir, 'manager.rip'))
      serve = loadServeConfig! app.root
      site = serve?.site or null
      hosts = serve?.hosts or []
      hosts = Object.keys site.aliases or {} if not hosts.length and site?
      # A bare serve.rip makes the manager serve the app name as its host.
      hosts = [app.name] unless hosts.length
    catch error
      serveError = error?.message or String(error)
  host = hosts.find((h) -> h.endsWith '.via.rip') or hosts[0]
  {
    ...app
    state: if manager? then (if manager.stopping then 'stopping' else 'running') else 'stopped'
    pid: if manager? then readOwnerPid(app.root, label) else null
    url: if host? then "https://#{host}/" else null
    hosts
    sitePattern: site?.host or null
    serveError
    manager
  }
