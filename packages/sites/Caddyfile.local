# Rip development edge — LOCAL posture (LAN / Bonjour).
# Shared mDNS front door stays on HTTP for Janus; product status URL is HTTPS.
# Enter only after `rip edge trust` on this machine.
{
	admin unix/{$RIP_EDGE_ADMIN}
	persist_config off
	auto_https disable_redirects
	default_bind {$RIP_EDGE_BIND:0.0.0.0}
	skip_install_trust
	servers {
		protocols h1 h2
	}

	janus {
		control internal {$RIP_EDGE_CONTROL}
		ping
		cache {
			ttl 1s
			ttl_max 10s
			max_body 256kb
			max_bytes 64mb
			max_app_share 50
		}
		hub {
			mode bridge
			origin same
		}
		files {
			precompressed
		}
		browse
		mdns {
			name sites.local
			apps on
		}
	}
}

# Janus mdns front door stays plain HTTP. /trust is the CA bootstrap without
# needing a temporary HTTPS accept (phones / peers).
http://sites.local {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	handle /trust* {
		reverse_proxy unix/{$RIP_EDGE_STATUS}
	}
	handle {
		janus
	}
}

http://*.local {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	redir https://{host}{uri} 308
}

http://ripdev.io, http://sites.ripdev.io, http://*.ripdev.io {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	redir https://{host}{uri} 308
}

# Product status + /trust on HTTPS (same Rip page as sites.ripdev.io).
sites.local {
	tls internal
	reverse_proxy unix/{$RIP_EDGE_STATUS}
}

*.local {
	tls internal
	janus
	log {
		output stderr
		format janus
	}
}

sites.ripdev.io, ripdev.io {
	tls {$RIP_EDGE_CERT} {$RIP_EDGE_KEY}
	reverse_proxy unix/{$RIP_EDGE_STATUS}
}

*.ripdev.io {
	tls {$RIP_EDGE_CERT} {$RIP_EDGE_KEY}
	janus
	log {
		output stderr
		format janus
	}
}
