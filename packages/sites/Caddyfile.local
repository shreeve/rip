# Rip development edge — LOCAL posture (LAN / Bonjour).
# Shared mDNS front door stays on HTTP for Janus; product status URL is HTTPS.
# Enter only after `rip edge trust` on this machine.
{
	admin unix/{$RIP_EDGE_ADMIN}
	persist_config off
	auto_https disable_redirects
	default_bind {$RIP_EDGE_BIND:0.0.0.0}
	skip_install_trust
	servers {
		protocols h1 h2
	}
	# Browsers reject second-level wildcards (SAN DNS:*.local). Issue one
	# exact-host cert per SNI name from the local CA instead — trust the CA
	# once (`rip sites trust edge`), then https://{app}.local works.
	# Ask must be a plain HTTP URL (unix dial syntax is not honored here).
	on_demand_tls {
		ask http://127.0.0.1:{$RIP_EDGE_HTTP_PORT:80}/tls-ask
	}

	janus {
		control internal {$RIP_EDGE_CONTROL}
		ping
		cache {
			ttl 1s
			ttl_max 10s
			max_body 256kb
			max_bytes 64mb
			max_app_share 50
		}
		hub {
			mode bridge
			origin same
		}
		files {
			precompressed
		}
		browse
		mdns {
			name rip.local
			apps on
			# Dedicated front-door listener: :80 belongs to the HTTPS
			# redirect, so the Janus mdns dashboard serves on its own port.
			listen :7680
		}
	}
}

# Front door with a brain: plain-HTTP "/" serves the trust probe page — its
# JS checks whether this device already trusts the local CA (an https fetch
# to /trust/check survives the handshake only if trusted) and either hops
# straight to the HTTPS dashboard or walks the user through installing the
# CA. /trust* stays plain HTTP — it is the CA bootstrap, and a phone cannot
# pass certificate validation for the very cert /trust hands it (chicken
# and egg). A blind 308 here would shove untrusted phones into the browser
# interstitial before any onboarding could happen; deep links still bounce.
http://rip.local {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	handle /trust* {
		reverse_proxy unix/{$RIP_EDGE_STATUS}
	}
	handle / {
		rewrite * /trust
		reverse_proxy unix/{$RIP_EDGE_STATUS}
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# on_demand_tls ask target (loopback; no Host / Bonjour dependency).
# Caddy itself dials this from loopback; the remote_ip guard keeps LAN
# peers (who can reach this 0.0.0.0 listener with a Host: 127.0.0.1
# header) away from the agent. Known accepted exposure that a guard here
# CANNOT close: any LAN peer can still trigger on-demand minting via TLS
# handshakes with fresh allowed SNI names — a dev-tool trade-off on a
# trusted LAN.
http://127.0.0.1 {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	@ask {
		path /tls-ask*
		remote_ip 127.0.0.1
	}
	handle @ask {
		reverse_proxy unix/{$RIP_EDGE_STATUS}
	}
}

http://*.local {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	redir https://{host}{uri} 308
}

http://via.rip, http://*.via.rip {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	redir https://{host}{uri} 308
}

# Product status + /trust on HTTPS (same Rip page as via.rip).
# on_demand so we mint DNS:rip.local — not a leftover *.local wildcard.
rip.local {
	tls {
		issuer internal
		on_demand
	}
	reverse_proxy unix/{$RIP_EDGE_STATUS}
}

# Catch-all app hosts: on-demand exact names (hello.local), never *.local.
*.local {
	tls {
		issuer internal
		on_demand
	}
	janus
	log {
		output stderr
		format janus
	}
}

# via.rip and *.via.rip publicly resolve to 127.0.0.1 — same local CA and
# on-demand exact-host certs as the .local family; one trust ceremony.
via.rip {
	tls {
		issuer internal
		on_demand
	}
	reverse_proxy unix/{$RIP_EDGE_STATUS}
}

*.via.rip {
	tls {
		issuer internal
		on_demand
	}
	janus
	log {
		output stderr
		format janus
	}
}

# Machine-local site blocks (domains + certs owned by this operator, e.g.
# *.medlabs.health). One small .caddy snippet per project; the packaged
# posture files stay canonical and platform updates flow without copy-drift.
import {$HOME}/.config/janus/sites/*.caddy
