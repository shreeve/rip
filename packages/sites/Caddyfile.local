# Rip development edge — LOCAL posture (LAN / Bonjour).
# Shared mDNS front door stays on HTTP for Janus; product status URL is HTTPS.
# Enter only after `rip edge trust` on this machine.
{
	admin unix/{$RIP_EDGE_ADMIN}
	persist_config off
	auto_https disable_redirects
	default_bind {$RIP_EDGE_BIND:0.0.0.0}
	skip_install_trust
	servers {
		protocols h1 h2
	}
	# Browsers reject second-level wildcards (SAN DNS:*.local). Issue one
	# exact-host cert per SNI name from the local CA instead — trust the CA
	# once (`rip sites trust edge`), then https://{app}.local works.
	# Ask must be a plain HTTP URL (unix dial syntax is not honored here).
	on_demand_tls {
		ask http://127.0.0.1/tls-ask
	}

	janus {
		control internal {$RIP_EDGE_CONTROL}
		ping
		cache {
			ttl 1s
			ttl_max 10s
			max_body 256kb
			max_bytes 64mb
			max_app_share 50
		}
		hub {
			mode bridge
			origin same
		}
		files {
			precompressed
		}
		browse
		mdns {
			name sites.local
			apps on
		}
	}
}

# Janus mdns front door stays plain HTTP. /trust is the CA bootstrap without
# needing a temporary HTTPS accept (phones / peers).
http://sites.local {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	handle /trust* {
		reverse_proxy unix/{$RIP_EDGE_STATUS}
	}
	handle {
		janus
	}
}

# on_demand_tls ask target (loopback; no Host / Bonjour dependency).
http://127.0.0.1 {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	handle /tls-ask* {
		reverse_proxy unix/{$RIP_EDGE_STATUS}
	}
}

http://*.local {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	redir https://{host}{uri} 308
}

http://ripdev.io, http://sites.ripdev.io, http://*.ripdev.io {
	bind {$RIP_EDGE_HTTP_BIND:0.0.0.0}
	redir https://{host}{uri} 308
}

# Product status + /trust on HTTPS (same Rip page as sites.ripdev.io).
# on_demand so we mint DNS:sites.local — not a leftover *.local wildcard.
sites.local {
	tls {
		issuer internal
		on_demand
	}
	reverse_proxy unix/{$RIP_EDGE_STATUS}
}

# Catch-all app hosts: on-demand exact names (hello.local), never *.local.
*.local {
	tls {
		issuer internal
		on_demand
	}
	janus
	log {
		output stderr
		format janus
	}
}

sites.ripdev.io, ripdev.io {
	tls {$RIP_EDGE_CERT} {$RIP_EDGE_KEY}
	reverse_proxy unix/{$RIP_EDGE_STATUS}
}

*.ripdev.io {
	tls {$RIP_EDGE_CERT} {$RIP_EDGE_KEY}
	janus
	log {
		output stderr
		format janus
	}
}
