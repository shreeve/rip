# Rip Manager constructs the complete browser Rip program. It follows
# compiler-recorded imports, admits only browser-safe packages, materializes
# permitted schema projections, and keeps package manifests off the wire.
import { readFileSync, readdirSync, existsSync } from 'node:fs'
import { dirname, join, relative, resolve } from 'node:path'
import { rash } from 'rip/app/rash'
import { compile } from '../../src/compile.js'
import { extractClientProjections } from '../../src/projections.js'

RUNTIME_RE =! /(?:^|\/)src\/runtime\/(intrinsics|stdlib|schema|reactive|components)\.js$/
VERB_FILES =! Set.new ['test.rip', 'demo.rip', 'bench.rip']
SKIP_DIRS =! Set.new ['node_modules', 'test', 'bench']

unquote = (specifier) -> specifier.slice 1, -1

decodeRipBytes = (path, bytes) ->
  try
    TextDecoder.new('utf-8', { fatal: true, ignoreBOM: true }).decode bytes
  catch error
    framed = Error.new "rip: '#{path}' is not valid UTF-8"
    framed.cause = error
    throw framed

readRipSource = (path) -> decodeRipBytes path, readFileSync(path)

ripFilesUnder = (dir) ->
  out = []
  walk = (at, depth) ->
    for entry in readdirSync(at, { withFileTypes: true })
      continue if entry.name.startsWith '.'
      continue if SKIP_DIRS.has entry.name
      full = join at, entry.name
      if entry.isDirectory()
        walk full, depth + 1
      else if entry.name.endsWith('.rip') and not (depth is 0 and VERB_FILES.has(entry.name))
        out.push full
  walk dir, 0
  out

# Fresh per scan because the expression is global and validation must be
# stateless. Captures an optional named-binding clause and relative `.rip`
# specifier from imports and re-exports that can cross the App boundary.
ripRelativeImport = ->
  /(?:^|\n)[ \t]*(?:import|export)\s+(?:([\s\S]*?)\s+from\s+)?['"](\.[^'"]*\.rip)['"]/g

importedBindingNames = (clause) ->
  return [] unless clause?
  match = clause.match /\{([^}]*)\}/
  return [] unless match?
  names = []
  for name in match[1].split ','
    name = name.trim()
    continue unless name
    names.push name.split(/\s+as\s+/)[0].trim()
  names

# A named schema import may cross from browser code to a server module. The
# projection is overlaid at its project-relative path so the author's import
# specifier remains unchanged. Behavior and persistence refuse loudly.
materializeSharedSchemas = (modules, moduleFiles, appDir, appRoot) ->
  absToStore = Map.new()
  for [store, absolute] in Object.entries moduleFiles
    absToStore.set resolve(absolute), store
  insideBundle = (absolute) -> absToStore.has resolve(absolute)

  needs = Map.new()
  overlayKeys = Map.new()

  for [key, source] in Object.entries modules
    file = moduleFiles[key]
    continue unless file?
    fileDir = dirname file
    for match in source.matchAll ripRelativeImport()
      clause = match[1]
      specifier = match[2]
      absolute = resolve fileDir, specifier
      continue unless existsSync absolute
      continue if insideBundle absolute
      names = importedBindingNames clause
      unless names.length
        throw Error.new "rip: cannot import server-only module '#{specifier}' into browser code (#{key}). Only named schema projections can cross the client boundary."

      entry = needs.get absolute
      unless entry?
        overlayKey = relative(appDir, absolute).replace(/\\/g, '/')
        if not overlayKey or overlayKey.startsWith('../') or overlayKey.startsWith('/')
          throw Error.new "rip: cannot materialize '#{absolute}' into the browser bundle — the server file must sit under the app project root"
        if modules[overlayKey]?
          throw Error.new "rip: projection overlay '#{overlayKey}' collides with a bundle module"
        prior = overlayKeys.get overlayKey
        if prior? and prior isnt absolute
          throw Error.new "rip: projection key collision: '#{absolute}' and '#{prior}' both map to '#{overlayKey}'. Two server-only modules cannot materialize to the same browser-bundle key."
        overlayKeys.set overlayKey, absolute
        entry = { key: overlayKey, names: Set.new() }
        needs.set absolute, entry
      entry.names.add name for name in names

  consumed = []
  for [absolute, entry] in needs
    relativeRoot = relative(appDir, appRoot).replace(/\\/g, '/') if appRoot?
    if appRoot? and relativeRoot isnt 'app'
      throw Error.new "rip: browser schema projections require the conventional 'app' root; '#{relativeRoot}' cannot preserve imports that cross the App boundary"
    bytes = readFileSync absolute
    consumed.push { path: absolute, hash: rash bytes }
    result = extractClientProjections decodeRipBytes(absolute, bytes), [...entry.names], { path: entry.key }
    unless result.ok
      throw Error.new "rip: cannot ship schema import to the browser bundle: #{result.error}"
    modules[entry.key] = result.source

  consumed

export assembleBundle = ({ modules, packagesDir, data = null, moduleFiles = null, appDir = null, appRoot = null } = {}) ->
  unless modules? and typeof modules is 'object'
    throw TypeError.new 'rip: assembleBundle requires a modules object'

  # inputHashes records every input's bytes AS CONSUMED by this assembly —
  # the manager's settled check compares later disk state against these, so
  # they must never be re-read after the fact (a file changing between the
  # read and a re-hash would certify content that was never built).
  bundle = { modules: { ...modules }, packages: {}, inputHashes: [], watchRoots: [] }
  for path in Object.keys bundle.modules
    if path is 'rip/app' or path.startsWith('rip/app/')
      throw Error.new "rip: App module '#{path}' collides with embedded browser package 'rip/app'"
  bundle.data = data if data?

  if moduleFiles? and appDir?
    projectionInputs = materializeSharedSchemas(bundle.modules, moduleFiles, appDir, appRoot) or []
    bundle.inputHashes.push ...projectionInputs
    bundle.watchRoots.push dirname(entry.path) for entry in projectionInputs

  claimPackage = (name, importer) ->
    return if bundle.packages[name]?
    short = name.replace /^rip\//, ''
    root = if packagesDir? then join(packagesDir, short) else null
    unless root? and existsSync join(root, 'package.json')
      throw Error.new "rip: '#{importer}' imports '#{name}', which is not a known package"

    manifestPath = join root, 'package.json'
    manifestBytes = readFileSync manifestPath
    bundle.inputHashes.push { path: manifestPath, hash: rash manifestBytes }
    manifest = JSON.parse decodeRipBytes(manifestPath, manifestBytes)
    bundle.watchRoots.push root
    unless manifest?.rip?.browser is true
      throw Error.new "rip: '#{importer}' imports '#{name}', which does not declare browser safety — a package travels to the browser only with \"rip\": { \"browser\": true }"

    entryFor = (value) -> (if typeof value is 'string' then value else value?.default) ?? null
    packageExports = manifest.exports or {}
    entryTarget = entryFor(packageExports['.']) ?? 'index.rip'
    exportsMap = {}
    for [key, value] in Object.entries packageExports
      continue if key is '.'
      target = entryFor value
      exportsMap[key] = target.replace(/^\.\//, '') if target?.endsWith '.rip'

    bundle.packages[name] =
      root: name
      entry: entryTarget.replace /^\.\//, ''
      exports: exportsMap

    for file in ripFilesUnder root
      relativePath = file.slice root.length + 1
      key = "#{name}/#{relativePath}"
      if bundle.modules[key]?
        throw Error.new "rip: App module '#{key}' collides with browser package '#{name}'"
      fileBytes = readFileSync file
      bundle.inputHashes.push { path: file, hash: rash fileBytes }
      bundle.modules[key] = decodeRipBytes file, fileBytes

  queue = Object.keys bundle.modules
  seen = Set.new()
  while queue.length
    path = queue.pop()
    continue if seen.has path
    seen.add path
    source = bundle.modules[path]
    compiled = null
    try
      compiled = compile source, { path, runtimeDelivery: 'none' }
    catch error
      framed = Error.new "rip: '#{path}' failed to compile during bundle assembly: #{error.message}"
      framed.cause = error
      throw framed

    if compiled.runtimes? and compiled.runtimes.has('orm')
      throw Error.new "rip: '#{path}' declares a :model schema — persistence is server-only and cannot travel to the browser"

    for span in compiled.imports
      specifier = unquote span.specifier
      continue if RUNTIME_RE.test specifier
      continue if specifier in ['rip/app', 'rip/app/rash']
      if specifier.startsWith 'rip/app/'
        throw Error.new "rip: '#{path}' imports '#{specifier}', which embedded package 'rip/app' does not export"
      continue if specifier.startsWith('./') or specifier.startsWith('../') or bundle.modules[specifier]?

      bare = specifier.match /^rip\/([\w-]+)(?:\/.+)?$/
      unless bare?
        throw Error.new "rip: '#{path}' imports '#{specifier}', which cannot travel to the browser — server-only and unknown modules stay on the server"
      claimPackage "rip/#{bare[1]}", path
      queue.push added for added in Object.keys(bundle.modules) when not seen.has(added)

  bundle

joinModulePath = (from, specifier) ->
  parts = from.split('/').slice 0, -1
  for piece in specifier.split '/'
    continue if piece is '' or piece is '.'
    if piece is '..'
      return null unless parts.length
      parts.pop()
    else
      parts.push piece
  parts.join '/'

validBrowserModulePath = (path) ->
  return false unless typeof path is 'string' and path.length
  return false if path.startsWith('/') or path.includes '\\'
  segments = path.split '/'
  return false if segments.some((segment) -> not segment or segment is '.' or segment is '..' or segment.startsWith '.')
  filename = segments[-1]
  return false if filename is '.rip' or not filename.endsWith '.rip'
  not segments.slice(0, -1).some((segment) -> segment.endsWith '.rip')

validateRipProgram = (modules) ->
  edges = Map.new()
  resolveImport = (from, specifier) ->
    if specifier.startsWith('./') or specifier.startsWith('../')
      joined = joinModulePath from, specifier
      return joined if joined? and modules[joined]?
      unless from.startsWith 'rip/'
        physical = joinModulePath "app/#{from}", specifier
        mounted = if physical?.startsWith('app/') then physical.slice('app/'.length) else physical
        return mounted if mounted? and modules[mounted]?
      hint = if specifier.endsWith('.rip') then '' else " — did you mean '#{specifier}.rip'?"
      throw Error.new "rip: '#{from}' imports '#{specifier}', which is not in the bundle#{hint}"

    bare = specifier.match /^rip\/([\w-]+)(?:\/(.+))?$/
    if bare?
      subpath = if bare[2]? then (if bare[2].endsWith('.rip') then bare[2] else "#{bare[2]}.rip") else 'index.rip'
      target = "rip/#{bare[1]}/#{subpath}"
      throw Error.new "rip: '#{from}' imports '#{specifier}', but '#{target}' is not in the bundle" unless modules[target]?
      return target

    throw Error.new "rip: '#{from}' imports '#{specifier}', which is not loadable in a browser"

  for [path, source] in Object.entries modules
    unless validBrowserModulePath path
      throw Error.new "rip: invalid browser module path '#{path}'"
    compiled = compile source, { path, runtimeDelivery: 'none', browserModule: true }
    dependencies = []
    for span in compiled.imports
      specifier = unquote span.specifier
      continue if RUNTIME_RE.test specifier
      continue if specifier in ['rip/app', 'rip/app/rash']
      dependencies.push resolveImport(path, specifier)
    edges.set path, dependencies

  visiting = Set.new()
  visited = Set.new()
  visit = (path, chain = []) ->
    return if visited.has path
    if visiting.has path
      throw Error.new "rip: import cycle through '#{path}' (#{[...chain, path].join ' -> '})"
    visiting.add path
    visit dependency, [...chain, path] for dependency in (edges.get(path) or [])
    visiting.delete path
    visited.add path
  visit path for path in Object.keys modules
  return

# The wire program is only canonical `[[path, source], ...]`. Bare package
# roots resolve by convention to `rip/<name>/index.rip`, keeping resolver
# metadata private to Manager.
export assembleRipPublication = (options = {}) ->
  assembled = assembleBundle options
  modules = { ...assembled.modules }

  for [name, packageInfo] in Object.entries assembled.packages
    entry = "#{packageInfo.root}/#{packageInfo.entry}"
    canonical = "#{packageInfo.root}/index.rip"
    unless entry of modules
      throw Error.new "rip: browser package '#{name}' entry '#{packageInfo.entry}' is not Rip source"
    if entry isnt canonical
      if canonical of modules
        throw Error.new "rip: browser package '#{name}' entry '#{packageInfo.entry}' collides with canonical 'index.rip'"
      modules[canonical] = modules[entry]
      delete modules[entry]

    for [subpath, target] in Object.entries packageInfo.exports
      requested = subpath.slice 2
      canonicalTarget = if requested.endsWith('.rip') then requested else "#{requested}.rip"
      unless target is canonicalTarget
        throw Error.new "rip: browser package '#{name}' export '#{subpath}' must target './#{canonicalTarget}'"

  validateRipProgram modules
  seenInputs = Map.new()
  for entry in assembled.inputHashes
    seenInputs.set entry.path, entry.hash unless seenInputs.has entry.path
  inputHashes = [...seenInputs.entries()]
    .map(([path, hash]) -> { path, hash })
    .sort (a, b) -> if a.path < b.path then -1 else if a.path > b.path then 1 else 0
  {
    list: Object.entries(modules).sort ([a], [b]) -> if a < b then -1 else if a > b then 1 else 0
    inputs: inputHashes.map (entry) -> entry.path
    inputHashes
    watchRoots: [...Set.new(assembled.watchRoots)].sort()
  }

export assembleRipBundle = (options = {}) -> assembleRipPublication(options).list
