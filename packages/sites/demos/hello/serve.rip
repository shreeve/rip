export default
  name: 'hello'
  hosts: ['hello.ripdev.io', 'hello.local'] # loopback + LAN (after `rip sites expose local`)
  hub:
    bridge: 'hub'           # Janus Bam door for live App watch (see index.rip)
  access:
    log: 'pretty'           # pretty | raw | off — CLI --access-log overrides
    format: %w[
      {local_time} {local_timezone} {duration_seconds:@s} │
      {status} {mime_abbrev:<4} {response_bytes:@B} │
      {method:<4} {path:25^} │
      {mark}
    ].join ' '
  app:
    root: 'app'             # default
    changes:                # default
      update: ['**/*.rip']  # default
      css: ['**/*.css']     # default
      reload: ['**/*']      # default for every other App file
