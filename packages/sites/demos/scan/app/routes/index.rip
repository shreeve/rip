# One camera, three readers. QRCanvas and QRCamera decode QR through the
# VideoFrame path and paint the finder overlay; the luma that lands in the
# scanner's arena goes on to readCode128 and readPDF417 without another
# copy. Every hit is announced once until a different code appears. The
# stats line reports what the camera delivers and how the readers keep up,
# so a change to the pipeline is measured, not felt.
import { QRCanvas, rearCamera, frameLoop } from 'rip/barcodes/dom'
import { readCode128 } from 'rip/barcodes/code128'
import { readPDF417 } from 'rip/barcodes/pdf417'

export Home = component
  player  := null
  overlay := null
  status  := 'Starting the camera'
  latest  := null
  history := []
  cancel  := null
  camera  := null
  canvas  := null
  stream  := ''        # delivered width x height and frame rate
  fps     := 0
  decodeMs := 0        # moving average over frames
  frames  := 0         # since the last reset
  reads   := 0
  firstMs := null      # time to the first read since the last reset
  armedAt := 0
  zoom    := 1
  zoomRange := null
  torchable := false
  torch   := false
  quality := '4k'
  seen    := 0         # id of the last frame the 1D and stacked readers saw
  stamps  := []

  mounted: ->
    try
      camera = rearCamera! player, format: 'auto'
    catch error
      status = "Camera unavailable: #{error.message}"
      return
    canvas = QRCanvas.new { overlay }, cropToSquare: false, async: true
    status = 'Fill the box with a QR code, a PDF417 symbol or a Code 128 label'
    armedAt = performance.now()
    describe()
    player.addEventListener 'loadedmetadata', (-> describe()), once: true
    cancel = frameLoop (-> scan().catch (error) -> report error), player

  # A failure anywhere in the loop lands in the status line, since a phone
  # shows no console.
  failed := ''
  report: (error) ->
    return if failed is error.message
    failed = error.message
    status = "Error: #{error.message}"

  # What the track settled on, and the controls it offers.
  describe: ->
    try
      s = camera.settings()
      w = s.width  or player.videoWidth
      h = s.height or player.videoHeight
      stream = "#{w}x#{h}#{if s.frameRate then ' @' + Math.round(s.frameRate) else ''}"
      caps = camera.capabilities()
      zoomRange = if caps.zoom then { min: caps.zoom.min, max: Math.min(caps.zoom.max, 5), step: caps.zoom.step or 0.1 } else null
      torchable = !!caps.torch
      setZoom 2 if zoomRange and zoom is 1
    catch error
      report error

  setZoom: (value) ->
    zoom = value
    camera.zoom(value).catch (error) -> report error

  toggleTorch: ->
    torch = not torch
    camera.torch(torch).catch (error) -> report error

  # Reopen at another size to measure what resolution buys.
  setQuality: (name) ->
    quality = name
    size = if name is '4k' then { width: { ideal: 3840 }, height: { ideal: 2160 } } else if name is '1080p' then { width: { ideal: 1920 }, height: { ideal: 1080 } } else { width: { ideal: 1280 }, height: { ideal: 720 } }
    camera.reopen! size
    describe()
    reset()

  reset: ->
    frames  = 0
    reads   = 0
    firstMs = null
    armedAt = performance.now()

  # Per presented frame: QR through the canvas (its own async decode), then
  # the other readers on the same luma while the scanner is not busy.
  scan: ->
    t0   = performance.now()
    text = camera.readFrame! canvas, true
    frame = canvas.lastFrame()
    hit = null
    if text isnt undefined
      hit = { kind: 'QR', text }
    else if frame and frame.id isnt seen
      seen = frame.id
      c128 = readCode128 frame, format: 'I420'
      if c128 then hit = { kind: 'Code 128', text: c128.text }
      else
        pdf = readPDF417 frame, format: 'I420'
        hit = { kind: 'PDF417', text: pdf.text } if pdf
    dt = performance.now() - t0
    decodeMs = if frames then decodeMs * 0.9 + dt * 0.1 else dt
    frames++
    tick t0
    if hit
      reads++
      firstMs = t0 - armedAt if firstMs is null
      found hit.kind, hit.text

  # Frames per second over the last second.
  tick: (now) ->
    stamps.push now
    stamps.shift() while stamps.length and stamps[0] < now - 1000
    fps = stamps.length

  found: (kind, text) ->
    return if latest? and latest.kind is kind and latest.text is text
    latest  = { kind, text }
    history = [{ kind, text, at: Date.new().toLocaleTimeString() }, ...history].slice 0, 20

  beforeUnmount: ->
    cancel?()
    camera?.stop()

  render
    h1 'Scan'
    p status
    div class: 'viewfinder'
      video ref: player, playsinline: true, muted: true
      canvas ref: overlay
      div class: 'aimer'
    div class: 'stats'
      span "#{stream or 'no stream'}"
      span "#{fps} fps"
      span "#{decodeMs.toFixed 1} ms"
      span "reads #{reads}/#{frames}"
      span (if firstMs? then "first #{(firstMs / 1000).toFixed 2} s" else 'no read yet')
    div class: 'controls'
      for name in ['720p', '1080p', '4k']
        button class: (if quality is name then 'on' else ''), @click: (-> setQuality name), name
      if zoomRange?
        label "zoom #{zoom.toFixed 1}x"
          input type: 'range', min: zoomRange.min, max: zoomRange.max, step: zoomRange.step, value: zoom, @input: (e) -> setZoom Number(e.target.value)
      if torchable
        button class: (if torch then 'on' else ''), @click: (-> toggleTorch()), 'torch'
      button @click: (-> reset()), 'reset'
    if latest?
      div class: 'latest'
        span class: 'kind', latest.kind
        code latest.text
    ul class: 'history'
      for hit in history
        li
          span class: 'kind', hit.kind
          code hit.text
          span class: 'at', hit.at
