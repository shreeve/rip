import { expect, test, Page } from '@playwright/test'
import { cards, fetchProducts, nav, usd } from './support/util.rip'

names = (page: Page) -> page.locator("#{cards} h5")

test 'lists every product with its image, name and price', ({ page }) ->
  page.goto!('/')
  products = fetchProducts!(page)
  expect(page.locator(cards)).toHaveCount!(products.length)

  for [index, product] in products.entries()
    card = page.locator(cards).nth(index)
    expect(card.locator('h5')).toHaveText!(product.name)
    expect(card.locator('.image')).toHaveText!(product.image)
    expect(card.locator('p')).toHaveText!(usd(product.price))

test 'search filters the list, ignores case, and records the term in the url', ({ page }) ->
  page.goto!('/')
  products = fetchProducts!(page)
  matching = products.filter((product) -> product.name.toLowerCase().includes('mug')).map((product) -> product.name)
  expect(matching.length, 'the products should have something to search for').toBeGreaterThan(0)

  page.getByRole('searchbox').fill!('mug')
  expect(names(page)).toHaveText!(matching)
  expect(page).toHaveURL!(/[?&]search=mug/)

  page.getByRole('searchbox').fill!('MUG')
  expect(names(page)).toHaveText!(matching)

test 'sorting orders by price both ways and records it in the url', ({ page }) ->
  page.goto!('/')
  products = fetchProducts!(page)
  cheapestFirst = [...products].sort((a, b) -> a.price - b.price).map((product) -> product.name)

  page.getByRole('combobox').selectOption!('price-asc')
  expect(names(page)).toHaveText!(cheapestFirst)
  expect(page).toHaveURL!(/[?&]sort=price-asc/)

  page.getByRole('combobox').selectOption!('price-desc')
  expect(names(page)).toHaveText!([...cheapestFirst].reverse())
  expect(page).toHaveURL!(/[?&]sort=price-desc/)

test 'a deep link applies both filters on first render', ({ page }) ->
  page.goto!('/?search=o&sort=price-desc')
  products = fetchProducts!(page)
  expected = products
    .filter((product) -> product.name.toLowerCase().includes('o'))
    .sort((a, b) -> b.price - a.price)
    .map((product) -> product.name)
  expect(expected.length, 'the deep link should match more than one product').toBeGreaterThan(1)

  expect(names(page)).toHaveText!(expected)
  expect(page.getByRole('searchbox')).toHaveValue!('o')
  expect(page.getByRole('combobox')).toHaveValue!('price-desc')

test 'a search matching nothing offers to clear the filters, and clearing empties the url', ({ page }) ->
  page.goto!('/')
  products = fetchProducts!(page)

  page.getByRole('searchbox').fill!('zzz')
  expect(page.locator(cards)).toHaveCount!(0)
  expect(page.locator('#content')).toContainText!('No products found.')

  page.getByRole('button', { name: 'Clear Filters' }).click!
  expect(page.locator(cards)).toHaveCount!(products.length)
  expect(page.getByRole('searchbox')).toHaveValue!('')
  expect(page).toHaveURL!(/\/$/)

test 'adding a product flips its button, and removing puts it back', ({ page }) ->
  page.goto!('/')
  button = page.locator(cards).first().getByRole('button')

  expect(button).toHaveText!('Add to Cart')
  expect(page.locator(nav.cart)).toHaveText!('Cart (0)')

  button.click!
  expect(button).toHaveText!('Added to Cart')
  expect(page.locator(nav.cart)).toHaveText!('Cart (1)')

  button.click!
  expect(button).toHaveText!('Add to Cart')
  expect(page.locator(nav.cart)).toHaveText!('Cart (0)')
