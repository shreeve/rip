import { User } from '../types.rip'
import { api, ApiError, parseApiError } from '../api-client.rip'
import { Button } from '../components/button.rip'
import { title } from '../config.rip'
import { createMutation } from 'rip/app'

export Profile = component
  user <~ @stash.user
  form: User := { ...user }
  error: ApiError<keyof User> := {}

  mounted: -> document.title = title('Profile')

  updateUser = createMutation (data: User) -> User.parse(api.patch!('user', { json: data }).json!),
    onSuccess: (user) =>
      error = {}
      @stash.user = user
    onError: (err) => error = parseApiError!(err)

  render
    h1 'Profile'
    form @submit: ((e) -> e.preventDefault(); updateUser(form))
      div.grid
        label
          'First name'
          input
            value <=> form.firstName
            aria-invalid: error.fields?.firstName?!
          if error.fields?.firstName
            small error.fields?.firstName
        label
          'Last name'
          input
            value <=> form.lastName
            aria-invalid: error.fields?.lastName?!
          if error.fields?.lastName
            small error.fields?.lastName
      div.grid
        label
          'Email'
          input value: form.email, type: 'email', readonly
        label
          'Phone'
          input
            value <=> form.phone
            type: 'tel'
      Button type: 'submit', loading: updateUser.pending, 'Update Profile'
      if error.message
        p.error error.message
      if updateUser.succeeded
        p.success 'Profile updated!'
