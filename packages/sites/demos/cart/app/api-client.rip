import { http, HTTPError, NetworkError } from 'rip/http'

export api = http.create({ prefixUrl: '/api', retry: 0 })

ErrorBody = schema
  error!  string
  code!   string
  fields  json

export type ApiError<K extends string = string> =
  message?: string
  fields?: Partial<Record<K, string>>

export def parseApiError(err: unknown): Promise<ApiError>
  unless err instanceof HTTPError
    console.error(err)
    return { message: if err instanceof NetworkError then 'Network error' else 'Something went wrong' }
  body = try err.response.json! catch then null
  parsed = ErrorBody.safe(body)
  unless parsed.ok
    console.error('API error in an unexpected shape', body, parsed.errors)
    return { message: 'Something went wrong' }
  { error, fields } = parsed.value
  if fields then { fields } else { message: error }
