import './db.rip'
import { get, post, patch, read, error } from 'rip/sites'
import { User, Product, Order, OrderItem, OrderLine, UserPublic, ProductPublic, OrderPublic } from './models.rip'

currentUser = () -> User.find!(1)

get '/api/user' ->
  user = currentUser!
  if not user then error('No user found', 404)
  return UserPublic.parse(user)

patch '/api/user' ->
  firstName = read 'firstName', 'name'
  lastName  = read 'lastName',  'name'
  phone     = read 'phone',     'text'

  errors: Partial<Record<keyof UserPublic, string>> = {}
  errors.firstName = 'Enter a first name' unless firstName
  errors.lastName  = 'Enter a last name'  unless lastName
  error(errors)

  user = currentUser!
  if not user then error('No user found', 404)

  Object.assign(user, { firstName, lastName, phone })
  user.save!

  return UserPublic.parse(user)

get '/api/products' -> Product.all!.map((p) -> ProductPublic.parse(p))

get '/api/orders' ->
  user = currentUser!
  if not user then return []
  return user.orders!.reverse().map((o) -> OrderPublic.parse(o))

get '/api/orders/:id' ->
  id = read 'id', 'id'

  user = currentUser!
  if not user then error('No user found', 404)

  order = Order.where({ id, userId: user.id }).first!
  if not order then error('Order not found', 404)

  return OrderPublic.parse(order)

post '/api/orders' ->
  raw = read 'items', 'array'

  if not raw?.length then error('Invalid order data', 400)

  total = 0
  items: OrderItem[] = []
  for line in raw
    result = OrderLine.safe(line)
    if not result.ok then error('Invalid order data', 400)
    { productId, quantity } = result.value
    product = Product.find!(productId)
    if not product then error("Product #{productId} not found", 422)
    total += product.price * quantity
    items.push({ productId, name: product.name, price: product.price, image: product.image, quantity })

  user = currentUser!
  if not user then error('No user found', 404)

  order = Order.create!({ userId: user.id, total, items })
  return @json(OrderPublic.parse(order), 201)
