# @ts-nocheck — throwaway SQLite shim; the exemption dies with the file.

import { Database } from 'bun:sqlite'
import { User, Product, Order } from './models.rip'

export db = Database.new "#{import.meta.dir}/cart.sqlite"

db.exec 'PRAGMA busy_timeout = 5000'

# Creation, not migration: IF NOT EXISTS means a models.rip edit never reaches
# an existing cart.sqlite. Delete the file to rebuild it.
export createSchema = ->
  # toSQL emits DuckDB DDL by design; these adapt it to SQLite.
  ddl = (User.toSQL() + '\n' + Product.toSQL() + '\n' + Order.toSQL())
    .replace(/CREATE SEQUENCE[^;]*;/g, '')
    .replace(/ DEFAULT nextval\('[^']*'\)/g, '')
    .replace(/\bENUM\((?:'(?:[^']|'')*'\s*,?\s*)+\)/g, 'VARCHAR')
    .replace(/timezone\('UTC',\s*now\(\)\)/g, 'CURRENT_TIMESTAMP')
    .replace(/CREATE (TABLE|UNIQUE INDEX|INDEX) /g, 'CREATE $1 IF NOT EXISTS ')
  for stmt in ddl.split(';') when stmt.trim()
    db.run stmt

# Only declared JSON columns decode, so a VARCHAR that merely looks like JSON is
# left alone. toSQL quotes identifiers, hence the optional quote in the pattern.
jsonCols = Set.new([...(User.toSQL() + Product.toSQL() + Order.toSQL()).matchAll(/"?(\w+)"?\s+JSON\b/g)].map((m) -> m[1]))

# bun:sqlite binds primitives only, so the Date the ORM binds for @times'
# updated_at is encoded here. create() takes the column default and never shows
# this; save() of an existing row fails without it.
globalThis.__ripSchema.__schemaSetAdapter
  query: (sql, params) ->
    bound = (params or []).map (p) ->
      if p instanceof Date then p.toISOString()
      else if p? and typeof p is 'object' then JSON.stringify(p)
      else p
    stmt = db.query(sql)
    names = stmt.columnNames
    # .values() returns null for a write with no RETURNING; the write still ran.
    data = stmt.values(...bound) or []
    decode = (v, i) ->
      if jsonCols.has(names[i]) and typeof v is 'string'
        try return JSON.parse(v) catch then return v
      v
    {
      columns: names.map((n) -> { name: n })
      data:    data.map((row) -> row.map(decode))
      rows:    data.length
    }
