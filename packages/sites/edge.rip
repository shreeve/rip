# The seam between Rip Sites and Janus. Janus owns the edge: its process
# (`janus autostart` installs it under launchd or systemd; `janus start`,
# `stop`, `restart`, and `status` manage it), its reach (`janus mode`),
# its local names (*.local, *.localhost), and trust in its CA (`janus
# trust`, http://janus.local/trust). Rip brings one thing: the site file
# for its own names beside this module, kept in Janus's sites directory,
# which the service Caddyfile imports. Apps register over the control
# socket Janus names.
#
# JANUS_CONTROL names an edge Rip does not configure: apps register there
# and nothing here writes a file or reloads anything. Tests and custom
# edges use it.

import { existsSync, mkdirSync, readFileSync, renameSync, unlinkSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'

export JANUS_MISSING = 'no janus on PATH — install Janus: curl -fsSL https://raw.githubusercontent.com/shreeve/janus/main/install.sh | bash'
export JANUS_STOPPED = "Janus is not running — 'janus autostart' installs it as a service (once), 'janus start' starts it"

export janusBinary = -> Bun.which('janus')

# `janus status --json`: exit 0 running, 3 stopped. null when there is no
# janus on PATH or it did not answer as expected.
export janusStatus = ->
  janus = janusBinary()
  return null unless janus?
  result = Bun.spawnSync [janus, 'status', '--json'], { stdout: 'pipe', stderr: 'pipe' }
  return null unless result.exitCode in [0, 3]
  try JSON.parse(result.stdout.toString()) catch then null

# The control target apps register with: JANUS_CONTROL when set, else the
# service's control socket.
export edgeControl = (janus = null) ->
  return process.env.JANUS_CONTROL if process.env.JANUS_CONTROL
  (janus or janusStatus())?.socket or null

export externalEdge = -> process.env.JANUS_CONTROL?

# The dashboard belongs to Janus. Discover its configured front door instead
# of assuming a default name, port, or an enabled mDNS capability.
validDashboardUrl = (value) ->
  return null unless typeof value is 'string' and value.length
  parsed = try URL.new(value) catch then null
  return null unless parsed? and parsed.protocol in ['http:', 'https:'] and not parsed.username and not parsed.password
  parsed.href

export dashboardUrl = (edge) ->
  return null unless edge.state is 'running'
  return validDashboardUrl(edge.dashboardUrl) if edge.external is false
  return null unless edge.control?
  try
    response = edgeFetch! edge.control, '/1.0/mdns', { signal: AbortSignal.timeout(2000) }
    return null unless response.ok
    mdns = response.json!
    if mdns?.enabled is true then validDashboardUrl(mdns.dashboard_url) else null
  catch then null

# Rip's site file: via.rip and *.via.rip, on Janus's edge as a drop-in.
export SITE = join(import.meta.dir, 'rip.caddy')
export SITE_NAME = 'rip.caddy'

# rip needs a Janus that owns exposure: `janus status --json` carries
# `scope` and `bind` from 1.13.0 on. An older Janus is refused; nothing
# falls back to a wildcard bind.
export requireExposureJanus = (janus, report = abort) ->
  return report(JANUS_MISSING, 503) unless janus?
  return report("janus exposure state is unusable: #{janus.scope_error}", 503) if janus.scope_error
  return report("rip requires janus >= 1.13.0 (exposure modes); this is janus #{janus.janus or 'of unknown version'}", 503) unless Array.isArray(janus.bind) and typeof janus.scope is 'string'
  janus

# The edge's exposure scope, from Janus. localhost when there is no Janus
# to ask: nothing is rendered then, and loopback routing claims the least.
export edgeScope = (janus = janusStatus()) -> janus?.scope or 'localhost'

lastLine = (result) ->
  lines = (result.stderr.toString() + result.stdout.toString()).trim().split('\n').filter (line) -> line and not line.startsWith('{')
  (lines.at(-1) or '').replace /^Error: /, ''

writeSite = (target, content) ->
  temporary = "#{target}.tmp-#{process.pid}"
  try
    writeFileSync temporary, content
    renameSync temporary, target
  finally
    unlinkSync temporary if existsSync temporary

# Keep rip's site file in Janus's sites directory, as shipped, and reload
# a running edge when it changed. `janus` is Janus's status; `report(message,
# status)` receives a failure. Returns the status.
export ensureEdgeSite = (janus, report = abort) ->
  desired = readFileSync SITE, 'utf8'
  target = join janus.sites, SITE_NAME
  current = try readFileSync(target, 'utf8') catch then null
  return janus if current is desired
  mkdirSync janus.sites, { recursive: true }
  writeSite target, desired
  if janus.running
    try
      reload = Bun.spawnSync [janusBinary(), 'reload'], { stdout: 'pipe', stderr: 'pipe' }
      throw Error.new(lastLine(reload)) unless reload.exitCode is 0
    catch error
      # Restore the pre-reload file so a later attempt retries the change.
      # Preserve an operator edit made while reload was running.
      if (try readFileSync(target, 'utf8') catch then null) is desired
        if current? then writeSite(target, current) else unlinkSync(target)
      return report("janus reload failed: #{error?.message or error}", 503)
  janus

# The service edge, with rip's site file in place. An external edge
# (JANUS_CONTROL) is used as found.
export configureEdge = (report = abort) ->
  return null if externalEdge()
  janus = requireExposureJanus janusStatus(), report
  return null unless janus?
  ensureEdgeSite janus, report

# Snapshot readers share the same short-lived service facts. No disk state
# is cached: this only avoids spawning Janus once for every app in a list.
snapshotCache = { at: 0, value: null }
export snapshotEnvironment = ->
  return { scope: 'localhost', sites: null } if externalEdge()
  now = Date.now()
  if now - snapshotCache.at >= 2000
    snapshotCache = { at: now, value: janusStatus() }
  snapshotCache.value or { scope: 'localhost', sites: null }

export snapshotEdgeState = (edge, janus, health = null) ->
  {
    state: if health? then 'running' else 'stopped'
    external: externalEdge()
    control: edgeControl(janus)
    dashboardUrl: janus?.dashboard_url or null
    scope: janus?.scope or null
    interface: janus?.interface or null
    bind: janus?.bind or null
    firewall: janus?.firewall or null
    baseUrl: edge?.baseUrl or 'https://{host}/'
    pid: janus?.pid or null
    uptime: janus?.uptime or null
    supervisor: janus?.supervisor or null
    autostart: janus?.autostart is true
    version: janus?.janus or null
    binaryNewer: janus?.binary_newer is true
    config: janus?.config or null
    sites: janus?.sites or null
    log: janus?.log or null
    admin: janus?.admin or null
    janus: health
    lastError: edge?.lastError or null
  }

export edgeFetch = (target, path = '/1.0', init = {}) ->
  options = { signal: AbortSignal.timeout(5000), ...init }
  if target.startsWith('http://') or target.startsWith('https://')
    fetch "#{target.replace(/\/$/, '')}#{path}", options
  else
    options.unix = target
    fetch "http://janus#{path}", options
