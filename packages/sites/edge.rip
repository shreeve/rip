#!/usr/bin/env rip

import { printJson, requestAgent } from './appliance.rip'
import { writeFileSync } from 'node:fs'
import { resolve } from 'node:path'

throw Error.new('@rip-lang/sites/edge is a CLI, not a library; run `rip edge`') unless import.meta.main

HELP = '''
  usage: rip edge <command> [options]

  Commands:
    status                               Show Caddy and Janus health
    start [options]                      Start the shared Caddy+Janus edge (default posture)
    stop                                 Gracefully stop a Rip-owned edge
    reload                               Reload a Rip-owned Caddyfile
    local [--off]                        LAN / Bonjour posture (requires trust first)
    trust [--export [PATH]]              Install the local edge CA (or export it)
    public                               Refuse — public posture is phase 2

  Start options:
    --caddy PATH                         Janus-enabled Caddy binary
    --config PATH                        Caddyfile (default: packaged for current mode)
    --control TARGET                     Janus HTTP URL or Unix socket
    --base-url TEMPLATE                  App URL, containing {host}
    --http-port N                        HTTP listen port (default 80)
    --https-port N                       HTTPS listen port (default 443)

  Output:
    --json                               Print the complete JSON response

  An already-running external edge is reported but never stopped or reloaded.
'''

args = process.argv.slice 2
if args.length is 0 or args[0] in ['-h', '--help', 'help']
  console.log HELP
  exit 0

command = args.shift()
json = false
body = {}
exportPath = null
localOff = false
trustExport = false

take = (flag) ->
  abort "rip-edge: #{flag} requires a value" unless args.length
  args.shift()

parsePort = (flag, text) ->
  value = parseInt text, 10
  abort "rip-edge: #{flag} must be an integer from 1 through 65535" unless Number.isInteger(value) and value >= 1 and value <= 65535 and String(value) is text
  value

while args.length
  value = args.shift()
  switch value
    when '--json' then json = true
    when '--off' then localOff = true
    when '--export'
      trustExport = true
      exportPath = if args[0]? and not args[0].startsWith('-') then args.shift() else 'rip-edge-local-ca.crt'
    when '--caddy' then body.caddy = take value
    when '--config' then body.config = take value
    when '--control' then body.control = take value
    when '--base-url'
      body.baseUrl = take value
      abort 'rip-edge: --base-url must contain {host}' unless body.baseUrl.includes '{host}'
    when '--http-port' then body.httpPort = parsePort value, take(value)
    when '--https-port' then body.httpsPort = parsePort value, take(value)
    else
      abort "rip-edge: unknown option #{value}"

abort "rip-edge: unknown command #{JSON.stringify(command)} — run `rip edge --help`" unless command in ['status', 'start', 'stop', 'reload', 'local', 'trust', 'public']
abort "rip-edge: #{command} does not accept start options" if command isnt 'start' and Object.keys(body).length
abort "rip-edge: --off is only valid on `local`" if localOff and command isnt 'local'
abort "rip-edge: --export is only valid on `trust`" if trustExport and command isnt 'trust'

if command is 'public'
  abort 'rip-edge: public posture is not available yet — use default (`rip edge start`) or `rip edge local`'

if command is 'trust' and trustExport
  edge = requestAgent! 'rip-edge', 'POST', '/1.0/edge/export-ca'
  target = resolve exportPath
  writeFileSync target, edge.pem, { mode: 0o600 }
  if json
    printJson { path: target, source: edge.path }
  else
    console.log "Exported edge CA → #{target}"
  exit 0

edge = switch command
  when 'status' then requestAgent! 'rip-edge', 'GET', '/1.0/edge'
  when 'local' then requestAgent! 'rip-edge', 'POST', '/1.0/edge/local', { off: localOff }
  when 'trust' then requestAgent! 'rip-edge', 'POST', '/1.0/edge/trust'
  else requestAgent! 'rip-edge', 'POST', "/1.0/edge/#{command}", body

if json
  printJson edge
else if command is 'trust'
  console.log '● Edge CA trusted for local mode'
  console.log "  Root: #{edge.root}" if edge.root
else
  marker = if edge.state is 'running' then '●' else '○'
  ownership = if edge.managed then 'Rip-owned' else if edge.state is 'running' then 'external' else 'not running'
  console.log "#{marker} Edge  #{edge.state} (#{ownership})"
  console.log "  Mode:    #{edge.mode}" if edge.mode?
  console.log "  Control: #{edge.control}"
  console.log "  Caddy:   #{edge.caddy}" if edge.caddy
  console.log "  Config:  #{edge.config}" if edge.config
  console.log "  Ports:   HTTP #{edge.httpPort} / HTTPS #{edge.httpsPort}" if edge.httpPort? and edge.httpsPort?
  console.log "  Trusted: #{if edge.localCaTrusted then 'yes' else 'no (run rip edge trust)'}" if edge.mode is 'local' or command is 'local'
  console.log "  Error:   #{edge.lastError}" if edge.lastError
