#!/usr/bin/env rip

# Thin alias: `rip edge <verb> …` → `rip sites <verb> edge …`
# Prefer the unified Sites grammar; this file exists so old spells keep working.

import { join } from 'node:path'

throw Error.new('@rip-lang/sites/edge is a CLI alias; prefer `rip sites … edge`') unless import.meta.main

HELP = '''
  usage: rip edge <command> [options]

  Alias of `rip sites <command> edge`. Prefer the unified Sites CLI:

    rip sites start edge
    rip sites stop edge
    rip sites status edge
    rip sites reload edge
    rip sites trust edge [--export [PATH]]
    rip sites local edge [--off]
    rip sites public edge

  Start options (on `start`): --caddy --config --control --base-url
  --http-port --https-port · Output: --json
'''

args = process.argv.slice 2
if args.length is 0 or args[0] in ['-h', '--help', 'help']
  console.log HELP
  exit 0

verb = args[0]
rest = args.slice 1
# Insert the reserved noun `edge` after the verb for the Sites matrix.
forwarded = [verb, 'edge', ...rest]
sites = join(import.meta.dir, 'sites.rip')
preload = process.execArgv.find (arg) -> arg.startsWith '--preload='
abort 'rip-edge: the Rip loader is missing' unless preload?
result = Bun.spawnSync [process.execPath, preload, sites, ...forwarded],
  stdout: 'pipe'
  stderr: 'pipe'
process.stdout.write result.stdout.toString() if result.stdout?.length
process.stderr.write result.stderr.toString() if result.stderr?.length
exit result.exitCode ?? 1
