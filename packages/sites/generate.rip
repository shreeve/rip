import { existsSync, readdirSync, readFileSync, writeFileSync, renameSync, unlinkSync } from 'node:fs'
import { basename, dirname, join, resolve } from 'node:path'

preload = process.execArgv.find((arg) -> arg.startsWith('--preload='))?.slice('--preload='.length)
abort 'rip-site generate: the Rip loader is missing' unless preload?
# Preload lives in src/cli/; the compiler root is one level up.
compiler = import!(join(dirname(resolve(preload)), '..', 'compile.js')).compile

# Bare specifiers (`rip/<pkg>` stdlib, bun-global fallback) share the
# loader's enumeration — but Bun.build never consults the runtime's
# virtual modules, so the bundler needs its own onResolve over the
# same map.
bare = import!(join(dirname(resolve(preload)), 'resolve.js')).bareSpecifierMap()

rewriteMeta = (code, path) ->
  return code unless code.includes 'import.meta'
  full = JSON.stringify path
  folder = JSON.stringify dirname(path)
  transpiler = Bun.Transpiler.new
    loader: 'js'
    define:
      'import.meta.url': JSON.stringify(Bun.pathToFileURL(path).href)
      'import.meta.path': full
      'import.meta.filename': full
      'import.meta.dir': folder
      'import.meta.dirname': folder
      'import.meta.file': JSON.stringify(basename(path))
  transpiler.transformSync code

inventory = {}
record = (path, bytes) ->
  inventory[path] = Bun.CryptoHasher.new('sha256').update(bytes).digest('hex')

# Directory-membership inputs (the sites dir): verified by re-listing,
# not re-reading — a directory has no bytes, but its listing shapes the
# generated module just as file bytes do.
dirInventory = {}
siteDirNames = (sitesDir) ->
  readdirSync(sitesDir, { withFileTypes: true })
    .filter((entry) -> entry.isDirectory() and not entry.name.startsWith('.'))
    .map((entry) -> entry.name)
    .sort()
recordDir = (path, names) ->
  dirInventory[path] = JSON.stringify names

plugin =
  name: 'rip'
  setup: (build) ->
    # Bare specifiers only — a catch-all filter here makes Bun treat
    # relative .rip imports it declines as side-effect-free, silently
    # dropping route-registration modules from the bundle (measured on
    # 1.3.14 — .js modules are unaffected).
    build.onResolve { filter: /^[^.\/]/ }, (args) ->
      path = bare.get args.path
      return { path } if path?
      return
    # rip/sites/configs — tenant branding as DATA. Enumerate the entry
    # project's sites dir (serve.rip sites.dir), evaluate each site's
    # config.rip through the loader, and emit ONE module keyed by
    # DIRECTORY NAME. Tenant names are data, never identifiers: a new
    # tenant is a new directory, not an edit to a registry, and the
    # recorded inputs make watch mode regenerate on any config edit or
    # membership change.
    build.onResolve { filter: /^rip\/sites\/configs$/ }, ->
      { path: 'rip/sites/configs', namespace: 'rip-sites-configs' }
    build.onLoad { filter: /.*/, namespace: 'rip-sites-configs' }, ->
      root = dirname resolve(entry)
      servePath = join root, 'serve.rip'
      serveConfig = import!(servePath).default
      dir = serveConfig?.sites?.dir
      unless typeof dir is 'string' and dir
        throw Error.new "rip/sites/configs: #{servePath} does not declare sites.dir — tenant configs require sites mode"
      sitesDir = join root, dir
      names = siteDirNames sitesDir
      recordDir sitesDir, names
      configs = {}
      for name in names
        configPath = join sitesDir, name, 'config.rip'
        continue unless existsSync configPath
        record configPath, readFileSync(configPath)
        configs[name] = import!(configPath).default
      { contents: "export default #{JSON.stringify(configs)}", loader: 'js' }
    build.onLoad { filter: /\.rip$/ }, (args) ->
      bytes = readFileSync args.path
      record args.path, bytes
      { code } = compiler(bytes.toString('utf8'), { path: args.path, runtimeDelivery: 'import' })
      { contents: rewriteMeta(code, args.path), loader: 'js' }
    build.onLoad { filter: /\.[mc]?js$/ }, (args) ->
      bytes = readFileSync args.path
      record args.path, bytes
      source = bytes.toString 'utf8'
      { contents: (if source.includes('import.meta') then rewriteMeta(source, args.path) else source), loader: 'js' }
    build.onLoad { filter: /.*/, namespace: 'file' }, (args) ->
      record args.path, readFileSync(args.path)
      return
    return

buildArtifact = (entry, artifact) ->
  result = Bun.build!
    entrypoints: [entry]
    target: 'bun'
    format: 'esm'
    sourcemap: 'none'
    throw: false
    plugins: [plugin]
  unless result.success
    throw Error.new result.logs.map((log) -> log?.message or String(log)).join('\n')
  Bun.write! artifact, result.outputs[0].text!

[entry, artifact, resultPath, taskId, epochText] = process.argv.slice 2
unless entry? and artifact? and resultPath? and taskId? and epochText?
  abort 'rip-site generate: want <entry> <artifact> <result> <task-id> <source-epoch>'

sourceEpoch = parseInt epochText
abort "rip-site generate: invalid source epoch #{epochText}" unless Number.isFinite(sourceEpoch) and sourceEpoch >= 0

try
  buildArtifact! entry, artifact

  inputs = []
  for path, expected of inventory
    actual = Bun.CryptoHasher.new('sha256').update(readFileSync(path)).digest('hex')
    throw Error.new("input changed during generation: #{path}") unless actual is expected
    inputs.push path
  for path, expected of dirInventory
    throw Error.new("site directory changed during generation: #{path}") unless JSON.stringify(siteDirNames(path)) is expected
    inputs.push path
  inputs.sort()

  tmp = "#{resultPath}.tmp"
  writeFileSync tmp, JSON.stringify({ taskId, sourceEpoch, artifact, inputs })
  renameSync tmp, resultPath
catch error
  try unlinkSync artifact
  warn error?.message or String(error)
  exit 1
