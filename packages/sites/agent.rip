import { closeSync, existsSync, fsyncSync, mkdirSync, openSync, readdirSync, readFileSync, realpathSync, renameSync, statSync, unlinkSync, writeFileSync } from 'node:fs'
import { spawn } from 'node:child_process'
import { basename, join, resolve } from 'node:path'
import { createHash, randomBytes } from 'node:crypto'
import { homedir, platform } from 'node:os'
import { agentPaths, loaderArg, secureDirectory } from './appliance.rip'
import { managerRequest, managerRuntime, resolveProject, waitManagerStopped } from './control.rip'

throw Error.new('rip/sites/agent is private process machinery') unless import.meta.main

paths = agentPaths 'rip-agent'
secureDirectory paths.appLogs, 'rip-agent'
PACKAGED_DEFAULT = realpathSync join(import.meta.dir, 'Caddyfile')
PACKAGED_LOCAL = realpathSync join(import.meta.dir, 'Caddyfile.local')
STATUS_HTML = join(import.meta.dir, 'status.html')
TRUST_HTML = join(import.meta.dir, 'trust.html')
TRUST_SAFARI_HTML = join(import.meta.dir, 'trust-safari.html')
PACKAGED_CADDYFILES = Set.new [PACKAGED_DEFAULT, PACKAGED_LOCAL]
CADDY_PKI_ROOT = if platform() is 'darwin'
  join process.env.HOME, 'Library', 'Application Support', 'Caddy', 'pki', 'authorities', 'local', 'root.crt'
else
  join process.env.XDG_DATA_HOME or join(process.env.HOME, '.local', 'share'), 'caddy', 'pki', 'authorities', 'local', 'root.crt'

usesLaunchd = (config) -> platform() is 'darwin' and PACKAGED_CADDYFILES.has(config)

packagedConfigForMode = (mode) -> if mode is 'local' then PACKAGED_LOCAL else PACKAGED_DEFAULT

# Dual-claim so default (loopback) and local (LAN) stay reachable without remapping.
defaultAppHosts = (name) -> ["#{name}.via.rip", "#{name}.local"]

# For every *.via.rip host, ensure the matching *.local twin is present.
ensureLanHosts = (hosts) ->
  out = [...hosts]
  seen = Set.new out
  for host in hosts
    continue unless host.endsWith '.via.rip'
    twin = "#{host.slice(0, -'.via.rip'.length)}.local"
    continue if seen.has twin
    fail "invalid LAN twin host #{JSON.stringify(twin)}" unless validHost twin
    out.push twin
    seen.add twin
  out

preferredHost = (hosts) ->
  return null unless hosts?.length
  if state.edge.mode is 'local'
    match = hosts.find (host) -> host.endsWith '.local'
    return match if match?
  else
    match = hosts.find (host) -> host.endsWith '.via.rip'
    return match if match?
  hosts[0]

bindHost = -> if state.edge.mode is 'local' then '0.0.0.0' else '127.0.0.1'

fail = (message, status = 400) ->
  error = Error.new message
  error.status = status
  throw error

isRecord = (value) -> value? and typeof value is 'object' and not Array.isArray(value)

rejectUnknown = (value, allowed, at) ->
  fail "#{at} must be an object" unless isRecord value
  fail "unknown #{at} key #{JSON.stringify(key)}" for key of value when not allowed.includes(key)

processAlive = (pid) ->
  return false unless Number.isInteger(pid) and pid > 0
  try
    process.kill pid, 0
    true
  catch error
    error?.code is 'EPERM'

defaultState = ->
  version: 1
  apps: []
  edge:
    desired: 'stopped'
    managed: false
    pid: null
    caddy: null
    config: null
    control: process.env.JANUS_CONTROL or 'http://127.0.0.1:7600'
    admin: null
    baseUrl: 'https://{host}/'
    mode: 'default'
    httpPort: 80
    httpsPort: 443
    localCaTrusted: false
    lastError: null

validateState = (state) ->
  fail("malformed state at #{paths.state}", 500) unless isRecord(state) and state.version is 1 and Array.isArray(state.apps) and isRecord(state.edge)
  ids = Set.new()
  names = Set.new()
  roots = Set.new()
  for app in state.apps
    valid = isRecord(app) and /^[a-f0-9]{16}$/.test(app.id) and typeof app.name is 'string' and typeof app.root is 'string' and Array.isArray(app.hosts) and app.hosts.every((host) -> typeof host is 'string') and isRecord(app.options) and Number.isInteger(app.options.workers) and app.options.workers > 0 and Number.isInteger(app.options.concurrency) and app.options.concurrency > 0 and typeof app.options.watchApp is 'boolean' and typeof app.options.watchApi is 'boolean' and typeof app.options.eager is 'boolean' and app.desired in ['running', 'stopped']
    fail("malformed app record at #{paths.state}", 500) unless valid
    fail("reserved app name #{JSON.stringify(app.name)} at #{paths.state}", 500) if app.name in ['edge', 'all', 'tray', 'agent']
    fail("duplicate app record at #{paths.state}", 500) if ids.has(app.id) or names.has(app.name) or roots.has(app.root)
    ids.add app.id
    names.add app.name
    roots.add app.root
  edge = state.edge
  valid = edge.desired in ['running', 'stopped'] and typeof edge.managed is 'boolean' and (edge.pid is null or Number.isInteger(edge.pid)) and (edge.caddy is null or typeof edge.caddy is 'string') and (edge.config is null or typeof edge.config is 'string') and typeof edge.control is 'string' and edge.control.length > 0 and (edge.admin is null or typeof edge.admin is 'string') and typeof edge.baseUrl is 'string' and edge.baseUrl.includes('{host}') and edge.mode in ['default', 'local'] and Number.isInteger(edge.httpPort) and edge.httpPort >= 1 and edge.httpPort <= 65535 and Number.isInteger(edge.httpsPort) and edge.httpsPort >= 1 and edge.httpsPort <= 65535 and typeof edge.localCaTrusted is 'boolean' and (edge.lastError is null or typeof edge.lastError is 'string')
  fail("malformed edge record at #{paths.state}", 500) unless valid
  state

normalizeAppOptions = (options) ->
  fail 'app options must be an object', 500 unless isRecord options
  watchApp = options.watchApp
  watchApi = options.watchApi
  if typeof options.watch is 'boolean'
    watchApp = options.watch unless typeof watchApp is 'boolean'
    watchApi = options.watch unless typeof watchApi is 'boolean'
  {
    workers: options.workers
    concurrency: options.concurrency
    watchApp: watchApp
    watchApi: watchApi
    eager: options.eager
  }

migrateState = (raw) ->
  return { state: raw, dirty: false } unless isRecord(raw) and Array.isArray(raw.apps)
  changed = false
  apps = raw.apps.map (app) ->
    return app unless isRecord(app) and isRecord(app.options)
    options = normalizeAppOptions app.options
    return app if typeof options.watchApp is 'boolean' and typeof options.watchApi is 'boolean' and not ('watch' of app.options)
    changed = true
    { ...app, options }
  edge = if isRecord(raw.edge) then { ...raw.edge } else null
  if edge?
    unless edge.mode in ['default', 'local']
      edge.mode = 'default'
      changed = true
    unless Number.isInteger(edge.httpPort) and edge.httpPort >= 1 and edge.httpPort <= 65535
      edge.httpPort = 80
      changed = true
    unless Number.isInteger(edge.httpsPort) and edge.httpsPort >= 1 and edge.httpsPort <= 65535
      edge.httpsPort = 443
      changed = true
    unless typeof edge.localCaTrusted is 'boolean'
      edge.localCaTrusted = false
      changed = true
  return { state: (if edge? then { ...raw, apps, edge } else { ...raw, apps }), dirty: true } if changed
  { state: raw, dirty: false }

loadState = ->
  return { state: defaultState(), dirty: false } unless existsSync paths.state
  try
    migrated = migrateState JSON.parse(readFileSync(paths.state, 'utf8'))
    { state: validateState(migrated.state), dirty: migrated.dirty }
  catch error
    throw error if error?.status?
    fail "cannot read state at #{paths.state}: #{error?.message or error}", 500

writeSecure = (path, text) ->
  temporary = "#{path}.tmp-#{process.pid}"
  fd = openSync temporary, 'w', 0o600
  try
    writeFileSync fd, text
    fsyncSync fd
  finally
    closeSync fd
  renameSync temporary, path
  directory = openSync paths.stateRoot, 'r'
  try fsyncSync(directory) finally closeSync(directory)

saveState = -> writeSecure paths.state, JSON.stringify(state, null, 2) + '\n'
loaded = loadState()
state = loaded.state
saveState() if loaded.dirty

tail = (path, lines = 100) ->
  return '' unless existsSync path
  text = readFileSync path, 'utf8'
  rows = text.split '\n'
  rows.pop() if rows.at(-1) is ''
  rows.slice(-lines).join('\n') + if rows.length then '\n' else ''

readLog = (path, lines, after) ->
  bytes = if existsSync(path) then readFileSync(path) else Buffer.alloc(0)
  if after?
    start = if after <= bytes.length then after else 0
    return { path, text: bytes.subarray(start).toString('utf8'), next: bytes.length, truncated: after > bytes.length }
  { path, text: tail(path, lines), next: bytes.length, truncated: false }

# Managers get a CLEAN environment, never the agent's. The long-lived
# agent carries whatever Bun auto-loaded from the directory it happened
# to boot in — including that project's .env — and `{ ...process.env }`
# stamped those secrets into every app it spawned (observed in the field:
# one demo's workers holding another project's RIP_DB_TOKEN, and stale
# tokens outliving the .env that minted them). The manager runs with cwd
# at its own app root, so Bun loads that project's .env into it; the
# agent forwards process basics only.
MANAGER_ENV_KEEP = ['PATH', 'HOME', 'USER', 'LOGNAME', 'SHELL', 'TMPDIR', 'TERM', 'LANG', 'TZ']
managerEnv = ->
  env = {}
  for key in MANAGER_ENV_KEEP
    env[key] = process.env[key] if process.env[key]?
  for key of process.env
    env[key] = process.env[key] if key.startsWith 'LC_'
  env

readOwnerPid = (root) ->
  owner = managerRuntime(root, 'rip-agent').owner
  return null unless existsSync owner
  try
    value = JSON.parse readFileSync(owner, 'utf8')
    if Number.isInteger(value.pid) then value.pid else null
  catch then null

managerStatus = (app) ->
  socket = managerRuntime(app.root, 'rip-agent').socket
  try
    response = fetch! 'http://manager/status', { method: 'GET', unix: socket, signal: AbortSignal.timeout(1000) }
    return null unless response.ok
    response.json!
  catch then null

edgeFetch = (target, path = '/1.0') ->
  options = { signal: AbortSignal.timeout(1000) }
  if target.startsWith('http://') or target.startsWith('https://')
    fetch "#{target}#{path}", options
  else
    options.unix = target
    fetch "http://janus#{path}", options

edgeHealth = ->
  try
    response = edgeFetch! state.edge.control
    return null unless response.ok
    response.json!
  catch then null

# ── serve.rip host declarations ──────────────────────────────────────
#
# serve.rip owns its app's hosts: the catalog stores [] for such apps
# and the manager re-reads the file on every start. Display needs that
# same truth while an app is STOPPED, so the agent reads it through a
# fresh subprocess per change — this process's module cache would mask
# edits forever — and caches the result by serve.rip mtime. Successes
# stay cached until the file changes; failures retry after a TTL
# because validation also reads paths (sites dir, files roots) whose
# repair never touches serve.rip's mtime.
SERVE_PROBE_MARK = 'rip-serve-hosts:'
SERVE_PROBE_TIMEOUT = 5000
SERVE_FAIL_TTL = 30000
serveDecls = Map.new()
serveProbes = Set.new()

readServeDecl = (root) ->
  child = null
  try
    child = Bun.spawn [process.execPath, loaderArg('rip-agent'), join(import.meta.dir, 'serve-hosts.rip'), root], { stdin: 'ignore', stdout: 'pipe', stderr: 'pipe', env: { ...process.env, NO_COLOR: '1' } }
  catch error
    return { error: error?.message or String(error) }
  serveProbes.add child
  timer = setTimeout (-> try child.kill 'SIGKILL'), SERVE_PROBE_TIMEOUT
  try
    stdout = Response.new(child.stdout).text!
    stderr = Response.new(child.stderr).text!
    code = await child.exited
    line = stdout.split('\n').findLast (candidate) -> candidate.startsWith SERVE_PROBE_MARK
    return JSON.parse line.slice(SERVE_PROBE_MARK.length) if code is 0 and line?
    { error: stderr.trim().split('\n')[0]?.trim() or "serve.rip probe exited #{code}" }
  catch error
    { error: error?.message or String(error) }
  finally
    clearTimeout timer
    serveProbes.delete child

# Returns a promise for { name, hosts, site } | { error } | null (no
# serve.rip). The entry lands in the cache before the first await so
# concurrent status polls share one probe.
serveDecl = (app) ->
  path = join app.root, 'serve.rip'
  mtime = try statSync(path).mtimeMs catch then null
  unless mtime?
    serveDecls.delete app.root
    return null
  cached = serveDecls.get app.root
  if cached? and cached.mtime is mtime
    return cached.promise unless cached.failedAt? and Date.now() - cached.failedAt >= SERVE_FAIL_TTL
  entry = { mtime, promise: null, failedAt: null }
  entry.promise = readServeDecl(app.root).then (decl) ->
    entry.failedAt = Date.now() if decl?.error?
    decl
  serveDecls.set app.root, entry
  entry.promise

# Effective hosts in serving-truth order: what a live manager claims
# (a site-template manager claims hosts: [] — its concrete alias hosts
# stand in), then an operator pin in the catalog, then the serve.rip
# declaration read from disk. Built into snapshots ONLY — never assign
# the result to app.hosts: the catalog feeds serverArgv --host flags,
# and a site-template manager aborts on any --host.
effectiveHosts = (app, manager) ->
  if manager?
    site = manager.site or null
    return { hosts: manager.hosts, site, error: null } if manager.hosts?.length
    return { hosts: Object.keys(site.aliases or {}), site, error: null } if site?
  return { hosts: app.hosts, site: null, error: null } if app.hosts.length
  decl = serveDecl! app
  return { hosts: [], site: null, error: null } unless decl?
  return { hosts: [], site: null, error: decl.error } if decl.error?
  site = decl.site or null
  hosts = decl.hosts or []
  hosts = Object.keys(site.aliases or {}) if not hosts.length and site?
  # A bare serve.rip (neither hosts nor sites) makes the manager serve
  # the app name as its host — mirror that.
  hosts = [app.name] unless hosts.length
  { hosts, site, error: null }

# The default URL template carries the real HTTPS port: on a non-443 edge
# a portless https://{host}/ refuses to connect while the app serves fine
# one port over (observed in the field). An explicit baseUrl is honored
# verbatim; the bare default self-corrects from the port the agent
# already tracks and validates.
defaultBaseUrl = ->
  port = state.edge.httpsPort
  if Number.isInteger(port) and port isnt 443 then "https://{host}:#{port}/" else 'https://{host}/'

appUrl = (hosts) ->
  host = preferredHost hosts
  return null unless host?
  template = state.edge.baseUrl or defaultBaseUrl()
  template = defaultBaseUrl() if template is 'https://{host}/'
  template.replace '{host}', host

SITES_D = join homedir(), '.config', 'janus', 'sites.d'

# Hosts beyond the packaged postures (*.local, via.rip) answer only when
# a sites.d snippet declares them — and Caddy's import glob is silent
# when nothing matches, so an app advertising its own domain with no
# snippet looks healthy everywhere while its URL answers nothing
# (observed in the field). The snapshot carries the warning instead.
hostCovered = (host) ->
  return true if host is 'via.rip' or host is 'rip.local' or host.endsWith('.via.rip') or host.endsWith('.local')
  names = try
    readdirSync(SITES_D).filter (name) -> name.endsWith '.caddy'
  catch then []
  for name in names
    text = try
      readFileSync join(SITES_D, name), 'utf8'
    catch then ''
    return true if text.includes host
    for match in text.matchAll /\*\.([a-z0-9.-]+)/gi
      return true if host.endsWith ".#{match[1]}"
  false

snapshotApp = (app) ->
  manager = managerStatus! app
  { hosts, site, error } = effectiveHosts! app, manager
  uncovered = (host for host in hosts when not hostCovered(host))
  {
    id: app.id
    name: app.name
    root: app.root
    desired: app.desired
    state: if manager? then (if manager.stopping then 'stopping' else if manager.ready is false then 'starting' else 'running') else 'stopped'
    pid: if manager? then readOwnerPid(app.root) else null
    url: appUrl(hosts)
    hosts: hosts
    sitePattern: site?.host or null
    serveError: error
    hostWarning: if uncovered.length then "no edge site block covers #{uncovered.join(', ')} — add ~/.config/janus/sites.d/#{app.name}.caddy (or any *.caddy declaring these hosts)" else null
    manager
    lastError: app.lastError or null
    lastExit: app.lastExit or null
  }

findApp = (selector) ->
  decoded = decodeURIComponent selector
  matches = state.apps.filter (app) -> app.id is decoded or app.name is decoded or app.root is decoded
  fail "unknown app #{JSON.stringify(decoded)}", 404 unless matches.length
  fail "ambiguous app #{JSON.stringify(decoded)}", 409 unless matches.length is 1
  matches[0]

validHost = (host) ->
  return false unless typeof host is 'string'
  return false if host.length > 253 or host.includes(':') or host.includes('/') or host.includes(' ')
  labels = host.split '.'
  return false if labels.some (label) -> label.length is 0 or label.length > 63
  labels.every (label) -> /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/i.test label

validName = (name) -> typeof name is 'string' and /^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$/i.test(name) and name.length <= 80

addApp = (body) ->
  rejectUnknown body, ['root', 'name', 'hosts', 'options'], 'app add body'
  project = resolveProject body.root, 'rip-sites'
  fail "project is already registered: #{project.root}", 409 if state.apps.some((app) -> app.root is project.root)
  name = body.name or basename(project.root).replace(/\.[^.]+$/, '')
  fail "invalid app name #{JSON.stringify(name)}" unless validName name
  fail "#{JSON.stringify(name)} is reserved (edge | all | tray | agent) — not an app name" if name in ['edge', 'all', 'tray', 'agent']
  fail "app name is already registered: #{name}", 409 if state.apps.some((app) -> app.name is name)
  hosts = body.hosts
  if not hosts?
    hosts = if existsSync(join(project.root, 'serve.rip')) then [] else defaultAppHosts(name)
  fail 'hosts must be an array' unless Array.isArray hosts
  fail "invalid host #{JSON.stringify(host)}" for host in hosts when not validHost(host)
  hosts = ensureLanHosts hosts
  fail 'hosts must not contain duplicates' unless Set.new(hosts).size is hosts.length
  options = body.options or {}
  rejectUnknown options, ['workers', 'concurrency', 'watch', 'watchApp', 'watchApi', 'eager'], 'app options'
  fail 'watch must be Boolean' if options.watch? and typeof options.watch isnt 'boolean'
  fail 'watchApp must be Boolean' if options.watchApp? and typeof options.watchApp isnt 'boolean'
  fail 'watchApi must be Boolean' if options.watchApi? and typeof options.watchApi isnt 'boolean'
  fail 'eager must be Boolean' if options.eager? and typeof options.eager isnt 'boolean'
  watchApp = if options.watchApp? then options.watchApp else if options.watch? then options.watch else true
  watchApi = if options.watchApi? then options.watchApi else if options.watch? then options.watch else true
  app =
    id: randomBytes(8).toString('hex')
    name: name
    root: project.root
    hosts: hosts
    options:
      workers: options.workers ?? 2
      concurrency: options.concurrency ?? 1
      watchApp: watchApp
      watchApi: watchApi
      eager: options.eager is true
    desired: 'stopped'
    addedAt: Date.new().toISOString()
    lastError: null
    lastExit: null
  fail 'workers must be a positive integer' unless Number.isInteger(app.options.workers) and app.options.workers > 0
  fail 'concurrency must be a positive integer' unless Number.isInteger(app.options.concurrency) and app.options.concurrency > 0
  state.apps.push app
  saveState()
  snapshotApp! app

serverArgv = (app) ->
  argv = [process.execPath, loaderArg('rip-agent'), join(import.meta.dir, 'manager.rip'), app.root, '--name', app.name, '--control', state.edge.control, '--workers', String(app.options.workers), '--concurrency', String(app.options.concurrency)]
  argv.push '--host', host for host in app.hosts
  if app.options.watchApp and app.options.watchApi
    argv.push '--watch'
  else if not app.options.watchApp and not app.options.watchApi
    argv.push '--no-watch'
  else
    argv.push if app.options.watchApp then '--watch-app' else '--no-watch-app'
    argv.push if app.options.watchApi then '--watch-api' else '--no-watch-api'
  argv.push '--eager' if app.options.eager
  argv

children = Map.new()
starting = Map.new()
restartCounts = Map.new()

# A manager answers /status as soon as its control socket is up, which
# is well before its workers have booted and it has registered with the
# edge. Only `ready` says the site is actually serving, so both the
# short-circuit and the readiness wait below hold out for it -- without
# that, a manager crash-looping on a failed boot (an unreachable
# database, say) reports "running" forever and never surfaces the log
# tail that explains why. `isnt false` so a manager predating the field
# still counts as ready.
ready = (live) -> live? and live.ready isnt false

startApp = (app, automatic = false) ->
  live = managerStatus! app
  if ready live
    app.desired = 'running'
    app.lastError = null
    saveState()
    return snapshotApp! app
  pending = starting.get app.id
  return pending if pending?
  task = do ->
    health = edgeHealth!
    fail "edge is not reachable at #{state.edge.control}", 503 unless health?
    logPath = join paths.appLogs, "#{app.id}.log"
    log = openSync logPath, 'a', 0o600
    child = null
    try
      # A manager that is up but not yet ready is mid-boot (or looping
      # through one). Wait it out rather than spawn a rival that would
      # only lose the manager lock and confuse the diagnosis.
      unless live?
        argv = serverArgv app
        child = spawn argv[0], argv.slice(1),
          cwd: app.root
          detached: true
          stdio: ['ignore', log, log]
          env: { ...managerEnv(), JANUS_CONTROL: state.edge.control }
        children.set app.id, child
        child.on 'exit', (code, signal) ->
          children.delete app.id
          app.lastExit = { code, signal: signal or null, at: Date.new().toISOString() }
          saveState()
          if app.desired is 'running'
            count = (restartCounts.get(app.id) or 0) + 1
            restartCounts.set app.id, count
            delay = Math.min 30000, 500 * 2 ** Math.min(count - 1, 6)
            # Re-read `desired` when the timer fires, not when it is set:
            # a start that gives up marks the app stopped, and a restart
            # scheduled just before that must not undo it. Without this
            # a site whose boot can never succeed restarts forever.
            setTimeout (->
              return unless app.desired is 'running'
              startApp(app, true).catch((error) -> app.lastError = error.message; saveState())), delay
    finally
      closeSync log
    deadline = Date.now() + 30000
    loop
      live = managerStatus! app
      if ready live
        restartCounts.set app.id, 0
        app.desired = 'running'
        app.lastError = null
        saveState()
        return snapshotApp! app
      break if child?.exitCode? or Date.now() >= deadline
      sleep! 25
    diagnostic = tail(logPath, 20).trim()
    message = if child?.exitCode? then "manager exited #{child.exitCode}" else 'manager readiness deadline expired'
    message += ":\n#{diagnostic}" if diagnostic
    app.lastError = message
    app.desired = 'stopped' unless automatic
    saveState()
    fail message, 503
  starting.set app.id, task
  try
    await task
  finally
    starting.delete app.id

stopApp = (app) ->
  app.desired = 'stopped'
  restartCounts.delete app.id
  saveState()
  runtime = managerRuntime app.root, 'rip-agent'
  live = managerStatus! app
  unless live?
    # A dead control socket is not a dead manager: the probe can miss a
    # live process (observed in the field: status said 'stopped' while a
    # manager and two workers ran on). The owner pid is the backstop —
    # SIGTERM lets the manager stop its own workers, SIGKILL is last.
    pid = readOwnerPid app.root
    if processAlive pid
      try process.kill pid, 'SIGTERM'
      deadline = Date.now() + 5000
      while processAlive(pid) and Date.now() < deadline
        sleep! 100
      if processAlive pid
        try process.kill pid, 'SIGKILL'
    snap = snapshotApp! app
    maybeExitIdle()
    return snap
  response = managerRequest! runtime.socket, 'POST', '/stop'
  body = response.text!
  fail "manager stop failed (#{response.status}): #{body}", 503 unless response.ok
  waitManagerStopped! runtime.socket
  snap = snapshotApp! app
  maybeExitIdle()
  snap

restartApp = (app) ->
  stopApp! app
  startApp! app

removeApp = (app) ->
  fail "app #{app.name} is running — stop it before removal", 409 if managerStatus!(app)? or app.desired is 'running'
  state.apps = state.apps.filter (candidate) -> candidate isnt app
  serveDecls.delete app.root
  saveState()
  { removed: app.id, name: app.name, root: app.root }

readEdgePid = ->
  return null unless existsSync paths.edgePid
  try
    value = parseInt readFileSync(paths.edgePid, 'utf8')
    if Number.isInteger(value) and value > 0 then value else null
  catch then null

readEdgeExit = ->
  return null unless existsSync paths.edgeExit
  try return JSON.parse(readFileSync(paths.edgeExit, 'utf8')) catch then return null

snapshotEdge = ->
  health = edgeHealth!
  pid = readEdgePid! or state.edge.pid
  managed = state.edge.managed and processAlive(pid)
  launcher = if managed and state.edge.config? then (if usesLaunchd(state.edge.config) then 'launchd' else 'direct') else null
  {
    state: if health? then 'running' else 'stopped'
    desired: state.edge.desired
    managed: managed
    pid: if managed then pid else null
    caddy: state.edge.caddy
    config: state.edge.config
    control: state.edge.control
    admin: state.edge.admin
    baseUrl: state.edge.baseUrl
    mode: state.edge.mode
    httpPort: state.edge.httpPort
    httpsPort: state.edge.httpsPort
    localCaTrusted: state.edge.localCaTrusted
    launcher: launcher
    janus: health
    lastError: state.edge.lastError
  }

resolveFile = (value, description) ->
  fail "#{description} must be a non-empty path" unless typeof value is 'string' and value.length
  path = resolve value
  fail "#{description} not found: #{value}" unless existsSync path
  path = realpathSync path
  fail "#{description} is not a file: #{value}" unless statSync(path).isFile()
  path

resolveCaddy = (explicit = null) ->
  packagedCaddy = join(import.meta.dir, 'bin', 'janus')
  caddyInput = explicit or state.edge.caddy or process.env.JANUS_CADDY or (existsSync(packagedCaddy) and packagedCaddy) or Bun.which('caddy')
  fail 'no Janus-enabled Caddy binary — pass --caddy PATH or set JANUS_CADDY', 503 unless caddyInput?
  caddy = resolveFile caddyInput, 'Caddy binary'
  modules = Bun.spawnSync [caddy, 'list-modules'], { stdout: 'pipe', stderr: 'pipe' }
  fail "Caddy binary does not contain Janus: #{caddy}", 503 unless modules.exitCode is 0 and modules.stdout.toString().split('\n').includes('janus')
  caddy

edgeAddress = (path) -> "unix/#{path}"

edgeEnv = (launcher, control) ->
  {
    ...process.env
    RIP_EDGE_ADMIN: paths.edgeAdmin
    RIP_EDGE_HTTP_BIND: if launcher is 'launchd' then 'fd/3' else bindHost()
    RIP_EDGE_BIND: if launcher is 'launchd' then 'fd/4' else bindHost()
    RIP_EDGE_CONTROL: control
    # The on_demand_tls ask URL must dial the real HTTP port — hardwiring
    # :80 under --http-port would fail every mint (and so every handshake).
    RIP_EDGE_HTTP_PORT: String(state.edge.httpPort or 80)
    RIP_EDGE_STATUS: paths.edgeStatus
  }

LAUNCHD_LABEL = 'rip.via.edge'
# Pre-via.rip label — boot it out on start so exactly one edge job exists.
LAUNCHD_RETIRED = 'io.ripdev.edge'
LAUNCHD_DOMAIN = if typeof process.getuid is 'function' then "gui/#{process.getuid!}" else null
LAUNCHD_SERVICE = if LAUNCHD_DOMAIN? then "#{LAUNCHD_DOMAIN}/#{LAUNCHD_LABEL}" else null

xml = (value) -> String(value).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;')
xmlEntry = (key, value) -> "<key>#{xml key}</key><string>#{xml value}</string>"

launchdSocket = (name, port) ->
  node = if state.edge.mode is 'local' then '' else '<key>SockNodeName</key><string>127.0.0.1</string>'
  """
        <key>#{xml name}</key><dict>
          <key>SockFamily</key><string>IPv4</string>
          #{node}
          <key>SockServiceName</key><integer>#{port}</integer>
          <key>SockType</key><string>stream</string>
        </dict>
  """

launchdPlist = (caddy, config, control) ->
  launcher = resolveFile join(import.meta.dir, 'launchd-listener.js'), 'launchd edge listener'
  argv = [process.execPath, launcher, caddy, config, paths.edgePid, paths.edgeExit]
  environment =
    HOME: process.env.HOME
    PATH: '/usr/bin:/bin:/usr/sbin:/sbin'
    TMPDIR: process.env.TMPDIR
    RIP_EDGE_ADMIN: paths.edgeAdmin
    RIP_EDGE_CONTROL: control
    RIP_EDGE_HTTP_PORT: String(state.edge.httpPort or 80)
    RIP_EDGE_STATUS: paths.edgeStatus
  argumentXml = argv.map((value) -> "<string>#{xml value}</string>").join('')
  environmentXml = Object.keys(environment).sort().filter((key) -> environment[key]?).map((key) -> xmlEntry(key, environment[key])).join('')
  """<?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0"><dict>
      <key>Label</key><string>#{LAUNCHD_LABEL}</string>
      <key>ProgramArguments</key><array>#{argumentXml}</array>
      <key>EnvironmentVariables</key><dict>#{environmentXml}</dict>
      <key>WorkingDirectory</key><string>#{xml paths.stateRoot}</string>
      <key>RunAtLoad</key><true/>
      <key>ProcessType</key><string>Background</string>
      <key>Umask</key><integer>63</integer>
      <key>StandardOutPath</key><string>#{xml paths.edgeLog}</string>
      <key>StandardErrorPath</key><string>#{xml paths.edgeLog}</string>
      <key>Sockets</key><dict>
#{launchdSocket 'HTTP', state.edge.httpPort}
#{launchdSocket 'HTTPS', state.edge.httpsPort}
      </dict>
    </dict></plist>
    """

launchctl = (args, missing = false) ->
  result = Bun.spawnSync ['/bin/launchctl', ...args], { stdout: 'pipe', stderr: 'pipe' }
  return true if result.exitCode is 0
  detail = result.stderr.toString().trim() or result.stdout.toString().trim()
  return false if missing and (detail.includes('Could not find service') or detail.includes('No such process') or detail.includes('service not found'))
  fail "launchctl #{args[0]} failed#{if detail then ": #{detail}" else ''}", 503

# Boot out the retired label too, on EVERY path: the edge is socket-
# activated, so a lingering old-label job resurrects on the next stray
# connection to 80/443 and wedges start (early-return "running") against
# stop (409 not-owned) until someone boots it out by hand.
bootoutLaunchd = (missing = false) ->
  launchctl ['bootout', "#{LAUNCHD_DOMAIN}/#{LAUNCHD_RETIRED}"], true if LAUNCHD_DOMAIN?
  launchctl ['bootout', LAUNCHD_SERVICE], missing

startLaunchd = (caddy, config, control) ->
  fail 'launchd user domain is unavailable', 503 unless LAUNCHD_SERVICE?
  bootoutLaunchd true
  writeSecure paths.edgePlist, launchdPlist(caddy, config, control)
  launchctl ['bootstrap', LAUNCHD_DOMAIN, paths.edgePlist]

edgeStarting = null
edgeRestartCount = 0
edgeRestartAt = 0

startEdge = (body = {}, automatic = false) ->
  return edgeStarting if edgeStarting?
  task = do ->
    rejectUnknown body, ['caddy', 'config', 'control', 'baseUrl', 'httpPort', 'httpsPort'], 'edge start body'
    fail 'control must be a non-empty string' if body.control? and (typeof body.control isnt 'string' or not body.control)
    fail 'baseUrl must be a string containing {host}' if body.baseUrl? and (typeof body.baseUrl isnt 'string' or not body.baseUrl.includes('{host}'))
    fail 'httpPort must be an integer from 1 through 65535' if body.httpPort? and (not Number.isInteger(body.httpPort) or body.httpPort < 1 or body.httpPort > 65535)
    fail 'httpsPort must be an integer from 1 through 65535' if body.httpsPort? and (not Number.isInteger(body.httpsPort) or body.httpsPort < 1 or body.httpsPort > 65535)
    current = snapshotEdge!
    return current if current.state is 'running'
    fail 'local mode requires `rip sites trust edge` first — install the edge CA, then retry', 403 if state.edge.mode is 'local' and not state.edge.localCaTrusted
    caddy = resolveCaddy! body.caddy
    configInput = body.config or state.edge.config or packagedConfigForMode(state.edge.mode)
    config = resolveFile configInput, 'Caddyfile'
    control = body.control or paths.edgeControl
    httpPort = if body.httpPort? then body.httpPort else state.edge.httpPort
    httpsPort = if body.httpsPort? then body.httpsPort else state.edge.httpsPort
    state.edge.httpPort = httpPort
    state.edge.httpsPort = httpsPort
    baseUrl = body.baseUrl or state.edge.baseUrl or defaultBaseUrl()
    # Identity fields persist only on a start that SUCCEEDS: a rejected
    # --config or a renamed binary must not poison later bare starts by
    # being silently remembered and failing identically (observed in the
    # field). The mid-boot write below is still needed — health checks
    # and stop-during-boot read it — so failure restores these.
    prior = { caddy: state.edge.caddy, config: state.edge.config, control: state.edge.control, admin: state.edge.admin, baseUrl: state.edge.baseUrl }
    # Machine-local site snippets import from here; the directory existing
    # from day one makes `ls` discovery and drop-in creation obvious.
    try mkdirSync SITES_D, { recursive: true }
    launcher = if usesLaunchd(config) then 'launchd' else 'direct'
    environment = edgeEnv launcher, control
    # These paths belong exclusively to a Rip-owned edge. An unclean exit can
    # leave the filesystem entries behind after no listener remains.
    try unlinkSync paths.edgeAdmin
    try unlinkSync paths.edgePid
    try unlinkSync paths.edgeExit
    try unlinkSync control if control is paths.edgeControl
    log = openSync paths.edgeLog, 'a', 0o600
    child = null
    try
      if launcher is 'launchd'
        startLaunchd caddy, config, control
      else
        child = spawn caddy, ['run', '--config', config, '--adapter', 'caddyfile', '--pidfile', paths.edgePid],
          cwd: paths.stateRoot
          detached: true
          stdio: ['ignore', log, log]
          env: environment
    finally
      closeSync log
    state.edge = { ...state.edge, desired: 'running', managed: true, pid: child?.pid or null, caddy, config, control, admin: paths.edgeAdmin, baseUrl, lastError: null }
    saveState()
    deadline = Date.now() + 10000
    loop
      health = edgeHealth!
      if health?
        caddyPid = readEdgePid!
        fail 'Caddy wrote an invalid pidfile', 503 unless caddyPid?
        state.edge.pid = caddyPid
        saveState()
        edgeRestartCount = 0
        edgeRestartAt = 0
        return snapshotEdge!
      break if child?.exitCode? or existsSync(paths.edgeExit) or Date.now() >= deadline
      sleep! 25
    diagnostic = tail(paths.edgeLog, 30).trim()
    outcome = readEdgeExit!
    code = child?.exitCode ?? outcome?.code
    message = if code? then "Caddy exited #{code}" else 'Caddy readiness deadline expired'
    message += ":\n#{diagnostic}" if diagnostic
    bootoutLaunchd true if launcher is 'launchd'
    state.edge = { ...state.edge, ...prior, desired: (if automatic then 'running' else 'stopped'), managed: false, pid: null, lastError: message }
    saveState()
    fail message, 503
  edgeStarting = task
  try
    await task
  finally
    edgeStarting = null

stopEdge = ->
  fail 'edge is not owned by Rip; stop the external Caddy service with its own supervisor', 409 unless state.edge.managed
  pid = readEdgePid! or state.edge.pid
  launcher = if usesLaunchd(state.edge.config) then 'launchd' else 'direct'
  unless edgeHealth! or processAlive(pid)
    bootoutLaunchd true if launcher is 'launchd'
    state.edge = { ...state.edge, desired: 'stopped', managed: false, pid: null, lastError: null }
    saveState()
    snap = snapshotEdge!
    maybeExitIdle()
    return snap
  running = []
  for app in state.apps
    running.push app if managerStatus!(app)?
  fail "stop #{running.map((app) -> app.name).join(', ')} before stopping the edge", 409 if running.length
  result = Bun.spawnSync [state.edge.caddy, 'stop', '--config', state.edge.config, '--adapter', 'caddyfile', '--address', edgeAddress(state.edge.admin)], { stdout: 'pipe', stderr: 'pipe', env: edgeEnv(launcher, state.edge.control) }
  fail "Caddy stop failed: #{result.stderr.toString().trim()}", 503 unless result.exitCode is 0
  bootoutLaunchd true if launcher is 'launchd'
  state.edge = { ...state.edge, desired: 'stopped', managed: false, pid: null, lastError: null }
  saveState()
  snap = snapshotEdge!
  maybeExitIdle()
  snap

reloadEdge = ->
  fail 'edge is not owned by Rip; reload the external Caddy service with its own supervisor', 409 unless state.edge.managed
  launcher = if usesLaunchd(state.edge.config) then 'launchd' else 'direct'
  result = Bun.spawnSync [state.edge.caddy, 'reload', '--config', state.edge.config, '--adapter', 'caddyfile', '--address', edgeAddress(state.edge.admin)], { stdout: 'pipe', stderr: 'pipe', env: edgeEnv(launcher, state.edge.control) }
  fail "Caddy reload failed: #{result.stderr.toString().trim()}", 503 unless result.exitCode is 0
  snapshotEdge!

# Full recreate with the choreography built in: stop the running apps (the
# ordering stopEdge's guard protects), recreate the edge, then start every
# app this call stopped — even when the edge start fails, so a broken
# posture never strands the apps.
restartEdge = ->
  # For-loop, not .filter — an async predicate returns a Promise, which is
  # always truthy, and every cataloged app would restart.
  wasRunning = []
  for app in state.apps
    wasRunning.push app if managerStatus!(app)?
  for app in wasRunning
    stopApp! app
  stopEdge! if state.edge.managed
  try
    startEdge!
  finally
    for app in wasRunning
      try
        startApp! app
      catch error
        app.lastError = error.message
        saveState()
  snapshotEdge!

# Mode flips recreate the edge (launchd sockets + Caddyfile) — reload is not enough.
setEdgeMode = (mode) ->
  fail "edge mode must be default or local, got #{JSON.stringify(mode)}" unless mode in ['default', 'local']
  fail 'local mode requires `rip sites trust edge` first — install the edge CA, then retry', 403 if mode is 'local' and not state.edge.localCaTrusted
  return snapshotEdge! if state.edge.mode is mode and (not state.edge.config? or state.edge.config is packagedConfigForMode(mode))
  current = snapshotEdge!
  wasRunning = current.state is 'running' and state.edge.managed
  stopEdge! if wasRunning
  state.edge.mode = mode
  state.edge.config = packagedConfigForMode mode
  state.edge.baseUrl = 'https://{host}/'
  state.edge.lastError = null
  # Catalog-stored hosts get a *.local twin so LAN peers can open apps after restart.
  if mode is 'local'
    for app in state.apps when app.hosts.length
      app.hosts = ensureLanHosts app.hosts
  saveState()
  return startEdge!({}) if wasRunning
  snapshotEdge!

# Exit when nothing remains to supervise — no idle forever control plane.
#
# "Nothing to supervise" is not the same as "nobody is talking to me", and
# a timer knows neither. A client reaches us the long way round — the CLI
# spawns this process, polls /1.0 until it answers, and only THEN sends
# what it came for — so a sweep landing in that gap kills a connection it
# was just told was good (seen under a loaded `test:all`: ECONNRESET on
# POST /1.0/apps/<name>/start). In-flight covers the other half, and must
# be the whole request, not its arrival: stopApp clears `desired` FIRST
# and then waits, unbounded, for the manager to go quiet — nothing is
# marked running for that entire span. Boot counts too; nobody spawns a
# control plane with nothing to ask it.
IDLE_GRACE = 2000
inFlight = 0
lastActivity = Date.now()

maybeExitIdle = ->
  return unless state.edge.desired is 'stopped' and not state.edge.managed
  return if state.apps.some (app) -> app.desired is 'running'
  return if inFlight > 0 or Date.now() - lastActivity < IDLE_GRACE
  setTimeout shutdown, 100

trustEdge = ->
  caddy = resolveCaddy!
  # Edge admin is a unix socket (Caddyfile `admin unix/{$RIP_EDGE_ADMIN}`),
  # never the stock localhost:2019 — same address stop/reload already use.
  admin = state.edge.admin or paths.edgeAdmin
  fail 'edge must be running to trust the CA — run `rip sites start edge` first', 503 unless existsSync(admin)
  result = Bun.spawnSync [caddy, 'trust', '--address', edgeAddress(admin)], { stdout: 'pipe', stderr: 'pipe' }
  detail = result.stderr.toString().trim() or result.stdout.toString().trim()
  unless result.exitCode is 0
    # The install escalates via sudo, and this daemon has no terminal to
    # prompt with — the CLI runs the install itself for exactly that
    # reason. Anyone landing here through the HTTP API gets the way out.
    hint = 'the agent cannot prompt for sudo — run `rip sites trust edge` from a terminal, or export the CA (`rip sites trust edge --export ca.crt`) and add it to the system trust store yourself'
    fail "Caddy trust failed#{if detail then ": #{detail}" else ''} (#{hint})", 503
  markEdgeTrusted()

# The CLI performs the certificate install in the user's terminal (sudo
# can prompt there) and then records the outcome here. Recording requires
# a live edge so the flag can never precede a CA existing to trust.
markEdgeTrusted = ->
  admin = state.edge.admin or paths.edgeAdmin
  fail 'edge must be running to trust the CA — run `rip sites start edge` first', 503 unless existsSync(admin)
  state.edge.localCaTrusted = true
  saveState()
  { trusted: true, root: if existsSync(CADDY_PKI_ROOT) then CADDY_PKI_ROOT else null }

exportEdgeCa = ->
  fail "edge CA not found at #{CADDY_PKI_ROOT} — run `rip sites trust edge` (and start local once if needed)", 404 unless existsSync CADDY_PKI_ROOT
  { path: CADDY_PKI_ROOT, pem: readFileSync(CADDY_PKI_ROOT, 'utf8') }

# iOS installs CA trust only through a configuration profile — a bare .crt
# saved from Chrome is a dead file in the Files app. Wrap the root in a
# .mobileconfig (payload is base64 DER, which is exactly the PEM body).
# UUIDs derive from the cert digest so reinstalling replaces the profile
# instead of stacking duplicates.
caMobileconfig = ->
  pem = readFileSync CADDY_PKI_ROOT, 'utf8'
  der = pem.replace(/-----[^-]+-----/g, '').replace(/\s+/g, '')
  hex = createHash('sha256').update(der).digest('hex')
  uuidAt = (offset) ->
    "#{hex.slice(offset, offset + 8)}-#{hex.slice(offset + 8, offset + 12)}-#{hex.slice(offset + 12, offset + 16)}-#{hex.slice(offset + 16, offset + 20)}-#{hex.slice(offset + 20, offset + 32)}".toUpperCase()
  """
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
\t<key>PayloadContent</key>
\t<array>
\t\t<dict>
\t\t\t<key>PayloadCertificateFileName</key>
\t\t\t<string>rip-edge-local-ca.crt</string>
\t\t\t<key>PayloadContent</key>
\t\t\t<data>#{der}</data>
\t\t\t<key>PayloadDescription</key>
\t\t\t<string>Trusts the Rip local edge CA so https://*.local and https://*.via.rip sites verify on this device.</string>
\t\t\t<key>PayloadDisplayName</key>
\t\t\t<string>Rip Local Edge CA</string>
\t\t\t<key>PayloadIdentifier</key>
\t\t\t<string>rip.via.edge.ca</string>
\t\t\t<key>PayloadType</key>
\t\t\t<string>com.apple.security.root</string>
\t\t\t<key>PayloadUUID</key>
\t\t\t<string>#{uuidAt 0}</string>
\t\t\t<key>PayloadVersion</key>
\t\t\t<integer>1</integer>
\t\t</dict>
\t</array>
\t<key>PayloadDisplayName</key>
\t<string>Rip Local HTTPS (rip.local · via.rip)</string>
\t<key>PayloadIdentifier</key>
\t<string>rip.via.edge.trust</string>
\t<key>PayloadRemovalDisallowed</key>
\t<false/>
\t<key>PayloadType</key>
\t<string>Configuration</string>
\t<key>PayloadUUID</key>
\t<string>#{uuidAt 32}</string>
\t<key>PayloadVersion</key>
\t<integer>1</integer>
</dict>
</plist>
"""

escapeHtml = (value) -> String(value).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;')

statusActions = (app) ->
  id = encodeURIComponent app.id
  if app.state is 'running'
    """
    <form method="post" action="/apps/#{id}/stop"><button type="submit">Stop</button></form>
    <form method="post" action="/apps/#{id}/restart"><button type="submit">Restart</button></form>
    """
  else
    """<form method="post" action="/apps/#{id}/start"><button type="submit">Start</button></form>"""

statusPage = ->
  apps = Promise.all! state.apps.map (app) -> snapshotApp! app
  edge = snapshotEdge!
  # Trailing `.join` after an indented `map ->` body binds to the last
  # expression (the string), not the array — parenthesize the map call.
  rows = (apps.map (app) ->
    hosts = app.hosts or []
    url = if app.url? then "<a href=\"#{escapeHtml app.url}\">#{escapeHtml app.url}</a>" else '—'
    extras = (hosts.filter((host) -> not app.url? or not app.url.includes(host)).map (host) ->
      "<div class=\"alt\"><a href=\"https://#{escapeHtml host}/\">https://#{escapeHtml host}/</a></div>"
    ).join ''
    """
    <tr>
      <td>#{escapeHtml app.name}</td>
      <td>#{escapeHtml app.state}</td>
      <td>#{url}#{extras}</td>
      <td class="actions">#{statusActions app}</td>
    </tr>
    """
  ).join ''
  statusHost = if edge.mode is 'local' then 'https://rip.local/' else 'https://via.rip/'
  trustHint = if edge.mode is 'local'
    'Trust bootstrap: <a href="/trust">/trust</a> (HTTPS) · phone/peer without cert accept: <a href="http://rip.local/trust">http://rip.local/trust</a>'
  else
    'Trust bootstrap: <a href="/trust">/trust</a> · CLI: <code>rip sites status edge</code>'
  """<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rip Sites</title>
<style>
  :root { color-scheme: light dark; font-family: ui-sans-serif, system-ui, sans-serif; }
  body { margin: 2rem auto; max-width: 56rem; padding: 0 1rem; line-height: 1.45; }
  h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
  .meta { color: #666; margin-bottom: 1.5rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.5rem 0.4rem; border-bottom: 1px solid #ccc3; vertical-align: top; }
  td.actions form { display: inline-block; margin: 0 0.25rem 0.25rem 0; }
  td.actions button { font: inherit; padding: 0.2rem 0.55rem; cursor: pointer; }
  .alt { font-size: 0.85em; opacity: 0.75; margin-top: 0.2rem; }
  a { color: inherit; }
</style></head><body>
  <h1>Rip Sites</h1>
  <p class="meta">Edge #{escapeHtml edge.state} · mode #{escapeHtml edge.mode} · #{escapeHtml statusHost}</p>
  <table><thead><tr><th>App</th><th>State</th><th>URL</th><th>Actions</th></tr></thead><tbody>
  #{rows or '<tr><td colspan="4">No apps registered.</td></tr>'}
  </tbody></table>
  <p class="meta" style="margin-top:1.5rem">#{trustHint}</p>
</body></html>
"""

# Janus's redacted per-app view (workers, heartbeats, counters, launch
# links) rides the mdns front door; Caddyfile.local pins `name rip.local`
# and `listen :7680`. null when unavailable (default mode, edge down).
janusStatus = ->
  return null unless state.edge.mode is 'local' and state.edge.pid?
  try
    response = fetch! 'http://127.0.0.1:7680/status.json', { headers: { host: 'rip.local' }, signal: AbortSignal.timeout(1200) }
    return null unless response.ok
    response.json!
  catch
    null

handleStatus = (request) ->
  url = URL.new request.url
  try
    if request.method is 'GET' and (url.pathname is '/' or url.pathname is '')
      if existsSync STATUS_HTML
        return Response.new readFileSync(STATUS_HTML), { headers: { 'content-type': 'text/html; charset=utf-8' } }
      return Response.new statusPage!, { headers: { 'content-type': 'text/html; charset=utf-8' } }
    if request.method is 'GET' and url.pathname is '/status.json'
      apps = Promise.all! state.apps.map (app) -> snapshotApp! app
      return Response.json { edge: snapshotEdge!, apps: apps, janus: janusStatus! }
    # Caddy on_demand_tls ask — allow single-label *.local names, the
    # via.rip apex (the loopback dashboard), and single-label *.via.rip
    # app names. Both families are minted by the same local CA.
    if request.method is 'GET' and url.pathname is '/tls-ask'
      domain = String(url.searchParams.get('domain') or '').toLowerCase()
      allowed = /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.(local|via\.rip)$/.test(domain) or domain is 'via.rip'
      return Response.new null, { status: if allowed then 200 else 404 }
    # Trust onboarding. The page itself rides both plain HTTP (the CA
    # bootstrap — an untrusted device cannot load anything over https) and
    # HTTPS (informational once trusted). /trust/check is the probe target:
    # an https fetch from the http-served page resolves only when this
    # device already trusts the CA — surviving the handshake is the signal.
    if request.method is 'GET' and url.pathname is '/trust/check'
      return Response.new null, { status: 204, headers: { 'access-control-allow-origin': '*', 'cache-control': 'no-store' } }
    # Safari-side landing for the x-safari-https jump: auto-starts the
    # profile download but keeps the remaining Settings steps on screen —
    # a raw-file target strands the user on a blank page after the prompts.
    if request.method is 'GET' and url.pathname is '/trust/safari'
      return Response.new readFileSync(TRUST_SAFARI_HTML), { headers: { 'content-type': 'text/html; charset=utf-8' } } if existsSync TRUST_SAFARI_HTML
      return Response.new null, { status: 302, headers: { location: '/trust' } }
    if request.method is 'GET' and url.pathname is '/trust/ca.crt'
      fail 'edge CA not ready — on the Mac run `rip sites trust edge`, then `rip sites expose local`', 404 unless existsSync CADDY_PKI_ROOT
      return Response.new readFileSync(CADDY_PKI_ROOT), {
        headers:
          'content-type': 'application/x-x509-ca-cert'
          'content-disposition': 'attachment; filename="rip-edge-local-ca.crt"'
      }
    if request.method is 'GET' and url.pathname is '/trust/ca.mobileconfig'
      fail 'edge CA not ready — on the Mac run `rip sites trust edge`, then `rip sites expose local`', 404 unless existsSync CADDY_PKI_ROOT
      return Response.new caMobileconfig!, {
        headers:
          'content-type': 'application/x-apple-aspen-config'
          'content-disposition': 'attachment; filename="rip-local-edge.mobileconfig"'
      }
    if request.method is 'GET' and (url.pathname is '/trust' or url.pathname is '/trust/')
      if existsSync TRUST_HTML
        return Response.new readFileSync(TRUST_HTML), { headers: { 'content-type': 'text/html; charset=utf-8' } }
      # Fallback when the page file is missing: hand over the raw CA.
      if existsSync CADDY_PKI_ROOT
        return Response.new readFileSync(CADDY_PKI_ROOT), {
          headers:
            'content-type': 'application/x-x509-ca-cert'
            'content-disposition': 'attachment; filename="rip-edge-local-ca.crt"'
        }
      html = '''<!doctype html><html><body style="font-family:system-ui;margin:2rem">
        <h1>Trust this edge</h1>
        <p>Local CA is not ready yet. On the Mac run <code>rip sites trust edge</code>, then <code>rip sites expose local</code>.</p>
        </body></html>'''
      return Response.new html, { headers: { 'content-type': 'text/html; charset=utf-8' }, status: 503 }
    actionMatch = url.pathname.match /^\/apps\/([^/]+)\/(start|stop|restart)$/
    if request.method is 'POST' and actionMatch?
      selector = decodeURIComponent actionMatch[1]
      action = actionMatch[2]
      mutate! ->
        app = findApp! selector
        if action is 'start' then startApp! app
        else if action is 'stop' then stopApp! app
        else restartApp! app
      return Response.new null, { status: 303, headers: { location: '/' } }
    Response.json { error: 'not found' }, { status: 404 }
  catch error
    Response.json({ error: error?.message or String(error) }, { status: error?.status or 500 })

jsonBody = (request) ->
  try request.json! catch then fail! 'request body must be valid JSON'

mutationChain = Promise.resolve()

mutate = (run) ->
  task = mutationChain.then run, run
  mutationChain = task.catch -> null
  task

route = (request) ->
  url = URL.new request.url
  parts = url.pathname.split('/').filter(Boolean)
  try
    if request.method is 'GET' and url.pathname is '/1.0'
      return Response.json { type: 'rip-agent', api_version: '1.0', pid: process.pid }
    if parts[0] is '1.0' and parts[1] is 'apps'
      if parts.length is 2
        if request.method is 'GET'
          apps = Promise.all! state.apps.map (app) -> snapshotApp! app
          return Response.json apps
        if request.method is 'POST'
          app = mutate! -> addApp! jsonBody! request
          return Response.json app, { status: 201 }
      if parts.length is 3
        return Response.json(snapshotApp!(findApp!(parts[2]))) if request.method is 'GET'
        return Response.json(mutate!(-> removeApp! findApp! parts[2])) if request.method is 'DELETE'
      action = parts[3]
      if request.method is 'POST'
        return Response.json(mutate!(-> startApp! findApp! parts[2])) if action is 'start'
        return Response.json(mutate!(-> stopApp! findApp! parts[2])) if action is 'stop'
        return Response.json(mutate!(-> restartApp! findApp! parts[2])) if action is 'restart'
      if request.method is 'GET' and action is 'logs'
        app = findApp parts[2]
        lines = parseInt(url.searchParams.get('lines') or '100')
        fail 'lines must be an integer from 1 through 10000' unless Number.isInteger(lines) and lines >= 1 and lines <= 10000
        afterText = url.searchParams.get 'after'
        after = if afterText? then parseInt(afterText) else null
        fail 'after must be a nonnegative integer' if afterText? and (not Number.isInteger(after) or after < 0 or String(after) isnt afterText)
        logPath = join paths.appLogs, "#{app.id}.log"
        return Response.json readLog(logPath, lines, after)
    if parts[0] is '1.0' and parts[1] is 'edge'
      return Response.json(snapshotEdge!) if request.method is 'GET' and parts.length is 2
      if request.method is 'POST' and parts.length is 3
        return Response.json(mutate!(-> startEdge! jsonBody! request)) if parts[2] is 'start'
        return Response.json(mutate!(-> stopEdge!)) if parts[2] is 'stop'
        return Response.json(mutate!(-> restartEdge!)) if parts[2] is 'restart'
        return Response.json(mutate!(-> reloadEdge!)) if parts[2] is 'reload'
        return Response.json(mutate!(-> trustEdge!)) if parts[2] is 'trust'
        return Response.json(mutate!(-> markEdgeTrusted())) if parts[2] is 'trusted'
        return Response.json(exportEdgeCa!) if parts[2] is 'export-ca'
        return Response.json(mutate!(-> setEdgeMode! if (jsonBody! request).off then 'default' else 'local')) if parts[2] is 'local'
        if parts[2] is 'public'
          fail 'public edge posture is not available yet — use default (`rip sites expose loopback`) or `rip sites expose local`', 501
    if parts[0] is '1.0' and parts[1] is 'agent'
      if request.method is 'POST' and parts[2] is 'stop' and parts.length is 3
        # Graceful recycle: answer first, then exit. Edge and apps are
        # detached and survive; the next control request boots a fresh
        # agent running current code.
        setTimeout shutdown, 100
        return Response.json { pid: process.pid, stopping: true }
    Response.json({ error: 'not found' }, { status: 404 })
  catch error
    Response.json({ error: error?.message or String(error) }, { status: error?.status or 500 })

# Only the control socket counts as activity. The edge-status socket is
# polled by Caddy, and an EXTERNAL Caddy polling it must not be able to
# pin an otherwise idle control plane alive forever.
handle = (request) ->
  inFlight++
  try
    route! request
  finally
    inFlight--
    lastActivity = Date.now()

acquire = ->
  try
    fd = openSync paths.owner, 'wx', 0o600
    try writeFileSync(fd, JSON.stringify({ pid: process.pid })) finally closeSync(fd)
    return
  catch error
    throw error unless error?.code is 'EEXIST'
  owner = try JSON.parse(readFileSync(paths.owner, 'utf8')) catch then null
  fail "another Rip Agent owns #{paths.socket} (pid #{owner?.pid or 'unknown'})", 409 if processAlive(owner?.pid)
  unlinkSync paths.owner
  acquire()

acquire()
try unlinkSync paths.socket
try unlinkSync paths.edgeStatus
server = null
statusServer = null
stopping = false

shutdown = ->
  return if stopping
  stopping = true
  serveProbes.forEach (child) -> try child.kill 'SIGKILL'
  try server?.stop true
  try statusServer?.stop true
  try unlinkSync paths.socket
  try unlinkSync paths.edgeStatus
  try unlinkSync paths.owner
  exit 0

process.on 'SIGINT', shutdown
process.on 'SIGTERM', shutdown

try
  server = Bun.serve { unix: paths.socket, fetch: handle }
  statusServer = Bun.serve { unix: paths.edgeStatus, fetch: handleStatus }
  reconcile = ->
    for app in state.apps when app.desired is 'running' and not managerStatus!(app)?
      startApp(app, true).catch (error) ->
        app.lastError = error.message
        saveState()
    if state.edge.desired is 'running' and not edgeStarting? and not edgeHealth! and Date.now() >= edgeRestartAt
      edgeRestartCount++
      delay = Math.min 30000, 500 * 2 ** Math.min(edgeRestartCount - 1, 6)
      edgeRestartAt = Date.now() + delay
      startEdge({}, true).catch (error) ->
        state.edge.lastError = error.message
        saveState()
  setTimeout reconcile, 0
  setInterval (->
    reconcile()
    maybeExitIdle()
  ), 2000
catch error
  try unlinkSync paths.owner
  throw error
