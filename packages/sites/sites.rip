#!/usr/bin/env rip

# Unified Sites CLI: rip sites <verb> <noun>
# Reserved nouns: edge, all, tray — never real app names.

import { agentPaths, printJson, probeAgent, requestAgent } from './appliance.rip'
import { addCatalogApp, findCatalogApp, loadCatalog, removeCatalogApp, snapshotCatalogApp } from './catalog.rip'
import { writeFileSync } from 'node:fs'
import { join, resolve } from 'node:path'

throw Error.new('@rip-lang/sites/sites is a CLI, not a library; run `rip sites`') unless import.meta.main

RESERVED = ['edge', 'all', 'tray']
TRAY_AGENT = join(import.meta.dir, 'bin', 'rip-tray-agent')

HELP = '''
  usage: rip sites <verb> [noun] [options]

  Grammar: rip sites <verb> <noun>
  Reserved nouns (not app names): edge · all · tray

  Catalog:
    list                                 List remembered apps
    add [project] [options]              Remember a project (default: cwd)
    remove <app>                         Forget a stopped app

  Lifecycle (noun: <app> | all | edge | tray):
    start <noun>                         Start app(s), edge, or tray
    stop <noun>                          Stop app(s), edge, or tray
    restart <noun>                       Restart app(s), edge, or tray
    status [noun]                        Edge+apps summary, or one target

  Edge-only (noun must be edge):
    reload edge                          Reload the Rip-owned Caddyfile
    trust edge [--export [PATH]]         Install (or export) the local CA
    local edge [--off]                   LAN / Bonjour posture (trust first)
    public edge                          Refuse — public posture is phase 2

  Daily:
    open <app|edge>                      Open the app URL or status dashboard
    logs <app|edge|all> [--lines N] [-f] Manager or edge logs

  Advanced (catalog app → manager; same nouns as start/stop):
    run [project] …                      Foreground manager (no catalog)
    browse <dir> …                       Publish one directory (no catalog)
    hold|release <app> […]               Deploy barriers on a remembered app
    migrate <app> [entry] […]            Coordinated DB migrate (cwd = app root)
    recover <app> <op-id> […]            Fix-forward recovery (cwd = app root)

  Start edge options:
    --caddy PATH  --config PATH  --control TARGET
    --base-url TEMPLATE  --http-port N  --https-port N

  Add options:
    --name NAME  --host HOST (repeatable)  --workers N  --concurrency N
    --no-watch  --no-watch-app  --no-watch-api  --eager

  Output:
    --json                               Machine-readable response

  `rip edge …` remains a thin alias of these spells (e.g. start → start edge).
'''

args = process.argv.slice 2
if args.length is 0 or args[0] in ['-h', '--help', 'help']
  console.log HELP
  exit 0

verb = args.shift()
json = false
follow = false
lines = 100
name = null
hosts = null
workers = 2
concurrency = 1
watchApp = true
watchApi = true
eager = false
positionals = []
addFlags = []
logFlags = []
edgeBody = {}
edgeFlags = []
exportPath = null
trustExport = false
localOff = false

# Advanced verbs: run/browse stay thin `rip site` forwards.
# hold/release/migrate/recover take a catalog <app> noun (id|name|root),
# resolve it, then invoke site.rip against that project — same selectors as start/stop.
ADVANCED = ['run', 'browse', 'hold', 'release', 'migrate', 'recover']

seedJanusControl = (env) ->
  return env if env.JANUS_CONTROL
  try
    doc = loadCatalog()
    control = doc.edge?.control
    want = doc.edge?.desired is 'running' or doc.apps.some((app) -> app.desired is 'running')
    if want
      edge = requestAgent! 'rip-sites', 'GET', '/1.0/edge', null, { start: true }
      env.JANUS_CONTROL = edge.control if edge?.control?
    else if control?
      env.JANUS_CONTROL = control
  catch then null
  env

forwardSite = (argv, options = {}) ->
  site = join(import.meta.dir, 'site.rip')
  preload = process.execArgv.find (arg) -> arg.startsWith '--preload='
  abort 'rip-sites: the Rip loader is missing' unless preload?
  env = seedJanusControl! { ...process.env }
  result = Bun.spawnSync [process.execPath, preload, site, ...argv],
    cwd: options.cwd or process.cwd()
    stdout: 'inherit'
    stderr: 'inherit'
    stdin: 'inherit'
    env: env
  exit result.exitCode ?? 1

takeAppNoun = ->
  abort "rip-sites: #{verb} requires an app noun (id | name | root)" unless args.length and not args[0].startsWith('-')
  selector = args.shift()
  abort "rip-sites: #{JSON.stringify(selector)} is reserved (edge | all | tray) — not an app name" if selector in RESERVED
  findCatalogApp loadCatalog(), selector

if verb in ADVANCED
  if verb is 'run'
    forwardSite! args
  else if verb is 'browse'
    forwardSite! ['browse', ...args]
  else if verb in ['hold', 'release']
    app = takeAppNoun!
    forwardSite! [verb, app.root, ...args]
  else if verb is 'migrate'
    app = takeAppNoun!
    forwardSite! ['migrate', ...args], { cwd: app.root }
  else if verb is 'recover'
    app = takeAppNoun!
    abort 'rip-sites: recover requires an operation id' unless args.length and not args[0].startsWith('-')
    forwardSite! ['recover', ...args], { cwd: app.root }

take = (flag) ->
  abort "rip-sites: #{flag} requires a value" unless args.length
  args.shift()

parsePort = (flag, text) ->
  value = parseInt text, 10
  abort "rip-sites: #{flag} must be an integer from 1 through 65535" unless Number.isInteger(value) and value >= 1 and value <= 65535 and String(value) is text
  value

while args.length
  value = args.shift()
  switch value
    when '--json' then json = true
    when '--follow', '-f'
      follow = true
      logFlags.push value
    when '--lines', '-n'
      logFlags.push value
      text = take value
      lines = parseInt text
      abort 'rip-sites: --lines must be an integer from 1 through 10000' unless Number.isInteger(lines) and lines >= 1 and lines <= 10000 and String(lines) is text
    when '--name'
      addFlags.push value
      name = take value
    when '--host'
      addFlags.push value
      hosts or= []
      hosts.push take(value)
    when '--workers'
      addFlags.push value
      text = take value
      workers = parseInt text
      abort 'rip-sites: --workers must be a positive integer' unless Number.isInteger(workers) and workers > 0 and String(workers) is text
    when '--concurrency'
      addFlags.push value
      text = take value
      concurrency = parseInt text
      abort 'rip-sites: --concurrency must be a positive integer' unless Number.isInteger(concurrency) and concurrency > 0 and String(concurrency) is text
    when '--no-watch'
      addFlags.push value
      watchApp = false
      watchApi = false
    when '--no-watch-app'
      addFlags.push value
      watchApp = false
    when '--no-watch-api'
      addFlags.push value
      watchApi = false
    when '--eager'
      addFlags.push value
      eager = true
    when '--off'
      localOff = true
      edgeFlags.push value
    when '--export'
      trustExport = true
      edgeFlags.push value
      exportPath = if args[0]? and not args[0].startsWith('-') then args.shift() else 'rip-edge-local-ca.crt'
    when '--caddy'
      edgeFlags.push value
      edgeBody.caddy = take value
    when '--config'
      edgeFlags.push value
      edgeBody.config = take value
    when '--control'
      edgeFlags.push value
      edgeBody.control = take value
    when '--base-url'
      edgeFlags.push value
      edgeBody.baseUrl = take value
      abort 'rip-sites: --base-url must contain {host}' unless edgeBody.baseUrl.includes '{host}'
    when '--http-port'
      edgeFlags.push value
      edgeBody.httpPort = parsePort value, take(value)
    when '--https-port'
      edgeFlags.push value
      edgeBody.httpsPort = parsePort value, take(value)
    else
      abort "rip-sites: unknown option #{value}" if value.startsWith '-'
      positionals.push value

noun = if positionals.length then positionals[0] else null
extra = positionals.slice 1

abort "rip-sites: #{verb} does not accept add options: #{addFlags.join(', ')}" if verb isnt 'add' and addFlags.length
abort "rip-sites: #{verb} does not accept log options: #{logFlags.join(', ')}" if verb isnt 'logs' and logFlags.length
abort 'rip-sites: --follow conflicts with --json' if follow and json
abort "rip-sites: #{verb} does not accept start options" if Object.keys(edgeBody).length and not (verb is 'start' and noun is 'edge')
abort "rip-sites: --off is only valid on `local edge`" if localOff and verb isnt 'local'
abort "rip-sites: --export is only valid on `trust edge`" if trustExport and verb isnt 'trust'
abort "rip-sites: unexpected arguments #{JSON.stringify(extra)}" if extra.length and verb isnt 'add'

requireNoun = (allowed) ->
  abort "rip-sites: #{verb} requires a noun (#{allowed.join(' | ')})" unless noun?
  abort "rip-sites: #{verb} does not accept noun #{JSON.stringify(noun)}" unless noun in allowed or (allowed.includes('<app>') and noun not in RESERVED)
  noun

requireApp = ->
  abort "rip-sites: #{verb} requires an app name" unless noun?
  abort "rip-sites: #{JSON.stringify(noun)} is reserved — pick another app name" if noun in RESERVED
  noun

reservedAsApp = (label) ->
  abort "rip-sites: #{JSON.stringify(label)} is reserved (edge | all | tray) — not an app name" if label in RESERVED

isAppNoun = (n) -> n? and n not in RESERVED

renderApp = (app) ->
  marker = if app.state is 'running' then '●' else '○'
  url = if app.url then "  #{app.url}" else ''
  "#{marker} #{app.name}  #{app.state}#{url}\n  #{app.root}"

renderEdge = (edge) ->
  marker = if edge.state is 'running' then '●' else '○'
  ownership = if edge.managed then 'Rip-owned' else if edge.state is 'running' then 'external' else 'not running'
  lines = ["#{marker} Edge  #{edge.state} (#{ownership})"]
  lines.push "  Mode:    #{edge.mode}" if edge.mode?
  lines.push "  Control: #{edge.control}"
  lines.push "  Caddy:   #{edge.caddy}" if edge.caddy
  lines.push "  Config:  #{edge.config}" if edge.config
  lines.push "  Ports:   HTTP #{edge.httpPort} / HTTPS #{edge.httpsPort}" if edge.httpPort? and edge.httpsPort?
  lines.push "  Trusted: #{if edge.localCaTrusted then 'yes' else 'no (run rip sites trust edge)'}" if edge.mode is 'local' or verb is 'local'
  lines.push "  Error:   #{edge.lastError}" if edge.lastError
  lines.join '\n'

printEdge = (edge) ->
  if json then printJson edge else console.log renderEdge(edge)

printApp = (app) ->
  if json then printJson app else console.log renderApp(app)

eachApp = (action) ->
  apps = requestAgent! 'rip-sites', 'GET', '/1.0/apps', null, { start: true }
  abort 'rip-sites: no apps in the catalog' unless apps.length
  results = []
  for app in apps
    results.push requestAgent!('rip-sites', 'POST', "/1.0/apps/#{encodeURIComponent(app.id)}/#{action}", {}, { start: true })
  results

dashboardUrl = (edge) ->
  host = if edge.mode is 'local' then 'sites.local' else 'sites.ripdev.io'
  port = if Number.isInteger(edge.httpsPort) and edge.httpsPort isnt 443 then ":#{edge.httpsPort}" else ''
  "https://#{host}#{port}/"

runTray = (action) ->
  result = Bun.spawnSync [TRAY_AGENT, action], { stdout: 'pipe', stderr: 'pipe' }
  out = result.stdout.toString()
  err = result.stderr.toString()
  unless result.exitCode is 0
    # status exits 1 when stopped — still a successful query for humans.
    if action is 'status' and result.exitCode is 1 and out.trim() is 'stopped'
      if json then printJson { state: 'stopped' } else console.log out.trim()
      return
    abort "rip-sites: tray #{action} failed: #{(err or out).trim() or "exit #{result.exitCode}"}"
  text = (out or err).trim()
  if json
    state = if text.includes('running') then 'running' else if text.includes('stopped') then 'stopped' else text
    printJson { state, detail: text }
  else
    console.log text or "tray #{action} ok"

edgePost = (path, body = {}, start = true) ->
  requestAgent! 'rip-sites', 'POST', path, body, { start }

# Revive the control plane only when the catalog still wants something running
# (adoption after crash). Idle catalog reads never spawn it.
wantsControl = ->
  doc = loadCatalog()
  doc.edge?.desired is 'running' or doc.apps.some((app) -> app.desired is 'running')

controlGet = (path) ->
  requestAgent! 'rip-sites', 'GET', path, null, { start: wantsControl! }

offlineApp = (app) -> snapshotCatalogApp app

ensureLiveControl = ->
  live = probeAgent! 'rip-sites'
  return live if live
  return null unless wantsControl!
  try
    requestAgent! 'rip-sites', 'GET', '/1.0', null, { start: true }
    probeAgent! 'rip-sites'
  catch then null

offlineEdge = (edge, health = null) ->
  control = process.env.JANUS_CONTROL or edge?.control or null
  {
    state: if health? then 'running' else 'stopped'
    desired: edge?.desired or 'stopped'
    managed: false
    pid: null
    caddy: edge?.caddy or null
    config: edge?.config or null
    control: control
    baseUrl: edge?.baseUrl or 'https://{host}/'
    mode: edge?.mode or 'default'
    httpPort: edge?.httpPort or 80
    httpsPort: edge?.httpsPort or 443
    localCaTrusted: edge?.localCaTrusted is true
    launcher: null
    janus: health
    lastError: edge?.lastError or null
  }

# Live Janus without a Rip control plane (external edge) — no spawn.
probeJanus = (control) ->
  return null unless typeof control is 'string' and control.length
  try
    options = { signal: AbortSignal.timeout(1000) }
    if control.startsWith('http://') or control.startsWith('https://')
      response = fetch! "#{control}/1.0", options
    else
      options.unix = control
      response = fetch! 'http://janus/1.0', options
    return response.json! if response.ok
  catch then null
  null

readOfflineEdge = ->
  doc = loadCatalog()
  control = process.env.JANUS_CONTROL or doc.edge?.control
  offlineEdge doc.edge, probeJanus!(control)

switch verb
  when 'list'
    abort 'rip-sites: list takes no noun' if noun?
    live = ensureLiveControl!
    if live
      apps = requestAgent! 'rip-sites', 'GET', '/1.0/apps', null, { start: false }
    else
      apps = loadCatalog().apps.map offlineApp
    if json then printJson apps else if apps.length then console.log(apps.map(renderApp).join('\n')) else console.log 'No Rip sites. Add one with `rip sites add [project]`.'

  when 'add'
    abort 'rip-sites: add takes at most one project path' if positionals.length > 1
    reservedAsApp name if name?
    body =
      root: positionals[0] or process.cwd()
      name: name
      hosts: hosts
      options: { workers, concurrency, watchApp, watchApi, eager: eager is true }
    if probeAgent! 'rip-sites'
      app = requestAgent! 'rip-sites', 'POST', '/1.0/apps', body, { start: false }
    else
      app = addCatalogApp! body
    if json then printJson app else console.log "Added #{app.name}\n#{app.root}"

  when 'remove'
    requireApp!
    if probeAgent! 'rip-sites'
      app = requestAgent! 'rip-sites', 'DELETE', "/1.0/apps/#{encodeURIComponent(noun)}", null, { start: false }
    else
      app = removeCatalogApp! noun
    if json then printJson app else console.log "Removed #{app.name}"

  when 'start', 'stop', 'restart'
    requireNoun ['<app>', 'all', 'edge', 'tray']
    if noun is 'edge'
      abort "rip-sites: restart edge is not supported — use stop edge && start edge" if verb is 'restart'
      abort "rip-sites: start options only apply to `start edge`" if verb isnt 'start' and Object.keys(edgeBody).length
      edge = if verb is 'start' then edgePost!('/1.0/edge/start', edgeBody, true) else edgePost!('/1.0/edge/stop', {}, true)
      printEdge edge
    else if noun is 'tray'
      abort "rip-sites: restart tray is not supported — use stop tray && start tray" if verb is 'restart'
      runTray! if verb is 'start' then 'start' else 'stop'
    else if noun is 'all'
      results = eachApp! verb
      if json then printJson results else console.log results.map(renderApp).join('\n')
    else
      app = requestAgent! 'rip-sites', 'POST', "/1.0/apps/#{encodeURIComponent(noun)}/#{verb}", {}, { start: true }
      printApp app

  when 'status'
    abort 'rip-sites: status takes at most one noun' if positionals.length > 1
    live = ensureLiveControl!
    if not noun? or noun is 'all'
      if live
        edge = requestAgent! 'rip-sites', 'GET', '/1.0/edge', null, { start: false }
        apps = requestAgent! 'rip-sites', 'GET', '/1.0/apps', null, { start: false }
      else
        doc = loadCatalog()
        edge = readOfflineEdge!
        apps = doc.apps.map offlineApp
      if json
        printJson if noun is 'all' then apps else { edge, apps }
      else if noun is 'all'
        if apps.length then console.log(apps.map(renderApp).join('\n')) else console.log 'No Rip sites.'
      else
        console.log renderEdge(edge)
        console.log ''
        if apps.length then console.log(apps.map(renderApp).join('\n')) else console.log 'No Rip sites.'
    else if noun is 'edge'
      if live or wantsControl!
        printEdge requestAgent!('rip-sites', 'GET', '/1.0/edge', null, { start: true })
      else
        printEdge readOfflineEdge!
    else if noun is 'tray'
      runTray! 'status'
    else
      requireApp!
      if live or wantsControl!
        printApp requestAgent!('rip-sites', 'GET', "/1.0/apps/#{encodeURIComponent(noun)}", null, { start: true })
      else
        printApp offlineApp(findCatalogApp(loadCatalog(), noun))

  when 'open'
    requireNoun ['<app>', 'edge']
    if noun is 'edge'
      edge = requestAgent! 'rip-sites', 'GET', '/1.0/edge', null, { start: wantsControl! }
      abort 'rip-sites: edge is not running' unless edge.state is 'running'
      url = dashboardUrl edge
    else
      requireApp!
      app = requestAgent! 'rip-sites', 'GET', "/1.0/apps/#{encodeURIComponent(noun)}", null, { start: true }
      abort "rip-sites: #{app.name} has no URL" unless app.url
      url = app.url
    result = Bun.spawnSync ['open', url], { stdout: 'ignore', stderr: 'pipe' }
    abort "rip-sites: cannot open #{url}: #{result.stderr.toString().trim()}" unless result.exitCode is 0
    printJson({ url }) if json

  when 'logs'
    requireNoun ['<app>', 'edge', 'all']
    if noun is 'edge'
      abort 'rip-sites: edge log follow is not implemented yet' if follow
      paths = agentPaths 'rip-sites'
      console.log "Edge logs: #{paths.edgeLog}"
      console.log "Control log: #{paths.agentLog}"
      printJson({ edgeLog: paths.edgeLog, agentLog: paths.agentLog }) if json
    else if noun is 'all'
      apps = requestAgent! 'rip-sites', 'GET', '/1.0/apps', null, { start: wantsControl! }
      abort 'rip-sites: no apps in the catalog' unless apps.length
      for app in apps
        id = encodeURIComponent app.id
        log = requestAgent! 'rip-sites', 'GET', "/1.0/apps/#{id}/logs?lines=#{lines}", null, { start: false }
        console.log "—— #{app.name} ——"
        process.stdout.write log.text or '(empty)\n'
    else
      requireApp!
      id = encodeURIComponent noun
      read = (after = null) -> requestAgent! 'rip-sites', 'GET', "/1.0/apps/#{id}/logs?#{if after? then "after=#{after}" else "lines=#{lines}"}", null, { start: true }
      log = read!
      if json
        printJson log
      else
        process.stdout.write log.text
        if follow
          offset = log.next
          loop
            sleep! 250
            next = read! offset
            process.stdout.write next.text if next.text
            offset = next.next

  when 'reload'
    requireNoun ['edge']
    printEdge edgePost!('/1.0/edge/reload', {}, true)

  when 'trust'
    requireNoun ['edge']
    if trustExport
      edge = edgePost! '/1.0/edge/export-ca', {}, true
      target = resolve exportPath
      writeFileSync target, edge.pem, { mode: 0o600 }
      if json then printJson { path: target, source: edge.path } else console.log "Exported edge CA → #{target}"
    else
      edge = edgePost! '/1.0/edge/trust', {}, true
      if json then printJson edge else console.log "● Edge CA trusted for local mode#{if edge.root then "\n  Root: #{edge.root}" else ''}"

  when 'local'
    requireNoun ['edge']
    printEdge edgePost!('/1.0/edge/local', { off: localOff }, true)

  when 'public'
    requireNoun ['edge']
    abort 'rip-sites: public posture is not available yet — use default (`rip sites start edge`) or `rip sites local edge`'

  else
    abort "rip-sites: unknown verb #{JSON.stringify(verb)} — run `rip sites --help`"
