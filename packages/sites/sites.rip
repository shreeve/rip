#!/usr/bin/env rip

# Unified Sites CLI: rip sites <verb> [noun]
# Reserved nouns: edge, all, agent — never real app names.
# The only user-facing Sites CLI — no rip site / rip edge commands.

import { agentPaths, printJson, probeAgent, requestAgent } from './appliance.rip'
import { readLog } from './logs.rip'
import { RESERVED, findCatalogApp, loadCatalog, snapshotCatalogApp } from './catalog.rip'
import { JANUS_MISSING, dashboardUrl, edgeControl, edgeFetch, snapshotEdgeState, externalEdge, janusBinary, janusStatus } from './edge.rip'
import { existsSync } from 'node:fs'
import { join, resolve } from 'node:path'

throw Error.new('rip/sites/sites is a CLI, not a library; run `rip sites`') unless import.meta.main

HELP = '''
  usage: rip sites <verb> [noun] [options]

  Grammar: rip sites <verb> <noun>
  Reserved nouns (not app names): edge · all · agent
  Path nouns default to the current directory when omitted.

  Catalog:
    list                                 List remembered apps
    add [project] [options]              Remember a project (default: cwd)
    remove <app>                         Forget a stopped app

  Lifecycle (noun: <app> | all | agent | <path>):
    start <app|all|agent>                Start supervised app(s) or the agent
    stop [noun]                          Stop (default: manager at cwd)
    restart <app|all|agent>              Restart (agent = recycle)
    status [noun]                        Summary, or one target (default: edge+apps)

  Edge: Janus's (janus autostart | start | stop | status | mode | trust)

  Daily:
    open <app|edge>                      Open the app URL or status dashboard
    logs <app|all> [--lines N] [-f]      Manager logs

  Manager (cwd default for path forms):
    run [project] …                      Foreground manager
    publish [dir] …                      Publish one directory through Janus
    hold|release <app> […]               Deploy barriers on a remembered app
    migrate <app> [entry] […]            Coordinated DB migrate
    recover <app> <op-id> […]            Fix-forward recovery

  Add options:
    --name NAME  --host HOST (repeatable)  --workers N  --concurrency N
    --no-watch  --no-watch-app  --no-watch-api  --eager

  Output:
    --json                               Machine-readable response
'''

args = process.argv.slice 2
if args.length is 0 or args[0] in ['-h', '--help', 'help']
  console.log HELP
  exit 0

verb = args.shift()
json = false
follow = false
lines = 100
name = null
hosts = null
workers = 2
concurrency = 1
watchApp = true
watchApi = true
eager = false
positionals = []
addFlags = []
logFlags = []

# Manager verbs invoke manager.rip as an internal module (not a user CLI).
MANAGER = ['run', 'publish', 'hold', 'release', 'migrate', 'recover']

# A foreground manager registers where the supervised apps do: Janus's
# control socket, unless JANUS_CONTROL already says otherwise.
seedJanusControl = (env) ->
  return env if env.JANUS_CONTROL
  control = try edgeControl() catch then null
  env.JANUS_CONTROL = control if control?
  env

runManager = (argv, options = {}) ->
  manager = join(import.meta.dir, 'manager.rip')
  preload = process.execArgv.find (arg) -> arg.startsWith '--preload='
  abort 'rip-sites: the Rip loader is missing' unless preload?
  env = seedJanusControl! { ...process.env }
  result = Bun.spawnSync [process.execPath, preload, manager, ...argv],
    cwd: options.cwd or process.cwd()
    stdout: 'inherit'
    stderr: 'inherit'
    stdin: 'inherit'
    env: env
  exit result.exitCode ?? 1

takeAppNoun = ->
  abort "rip-sites: #{verb} requires an app noun (id | name | root)" unless args.length and not args[0].startsWith('-')
  selector = args.shift()
  abort "rip-sites: #{JSON.stringify(selector)} is reserved (edge | all | agent) — not an app name" if selector in RESERVED
  findCatalogApp loadCatalog(), selector

# Path forms keep manager flags intact — handle before Sites option parsing.
if verb in MANAGER
  if verb is 'run'
    runManager! args
  else if verb is 'publish'
    runManager! ['browse', ...args]
  else if verb in ['hold', 'release']
    app = takeAppNoun!
    runManager! [verb, app.root, ...args]
  else if verb is 'migrate'
    app = takeAppNoun!
    runManager! ['migrate', ...args], { cwd: app.root }
  else if verb is 'recover'
    app = takeAppNoun!
    abort 'rip-sites: recover requires an operation id' unless args.length and not args[0].startsWith('-')
    runManager! ['recover', ...args], { cwd: app.root }

take = (flag) ->
  abort "rip-sites: #{flag} requires a value" unless args.length
  args.shift()

while args.length
  value = args.shift()
  switch value
    when '--json' then json = true
    when '--follow', '-f'
      follow = true
      logFlags.push value
    when '--lines', '-n'
      logFlags.push value
      text = take value
      lines = parseInt text
      abort 'rip-sites: --lines must be an integer from 1 through 10000' unless Number.isInteger(lines) and lines >= 1 and lines <= 10000 and String(lines) is text
    when '--name'
      addFlags.push value
      name = take value
    when '--host'
      addFlags.push value
      hosts or= []
      hosts.push take(value)
    when '--workers'
      addFlags.push value
      text = take value
      workers = parseInt text
      abort 'rip-sites: --workers must be a positive integer' unless Number.isInteger(workers) and workers > 0 and String(workers) is text
    when '--concurrency'
      addFlags.push value
      text = take value
      concurrency = parseInt text
      abort 'rip-sites: --concurrency must be a positive integer' unless Number.isInteger(concurrency) and concurrency > 0 and String(concurrency) is text
    when '--no-watch'
      addFlags.push value
      watchApp = false
      watchApi = false
    when '--no-watch-app'
      addFlags.push value
      watchApp = false
    when '--no-watch-api'
      addFlags.push value
      watchApi = false
    when '--eager'
      addFlags.push value
      eager = true
    else
      abort "rip-sites: unknown option #{value}" if value.startsWith '-'
      positionals.push value

noun = if positionals.length then positionals[0] else null
extra = positionals.slice 1

abort "rip-sites: #{verb} does not accept add options: #{addFlags.join(', ')}" if verb isnt 'add' and addFlags.length
abort "rip-sites: #{verb} does not accept log options: #{logFlags.join(', ')}" if verb isnt 'logs' and logFlags.length
abort 'rip-sites: --follow conflicts with --json' if follow and json
abort "rip-sites: unexpected arguments #{JSON.stringify(extra)}" if extra.length and verb isnt 'add'

requireNoun = (allowed) ->
  abort "rip-sites: #{verb} requires a noun (#{allowed.join(' | ')})" unless noun?
  abort "rip-sites: #{verb} does not accept noun #{JSON.stringify(noun)}" unless noun in allowed or (allowed.includes('<app>') and noun not in RESERVED) or (allowed.includes('<path>') and noun not in RESERVED)
  noun

requireApp = ->
  abort "rip-sites: #{verb} requires an app name" unless noun?
  abort "rip-sites: #{JSON.stringify(noun)} is reserved — pick another app name" if noun in RESERVED
  noun

reservedAsApp = (label) ->
  abort "rip-sites: #{JSON.stringify(label)} is reserved (edge | all | agent) — not an app name" if label in RESERVED

catalogHas = (selector) ->
  findCatalogApp(loadCatalog(), selector, false)?

pathNoun = (selector = null) ->
  raw = selector or process.cwd()
  resolve if raw is '.' then process.cwd() else raw

renderApp = (app) ->
  marker = if app.state is 'running' then '●' else '○'
  url = if app.url then "  #{app.url}" else ''
  warning = if app.hostWarning then "\n  ⚠ #{app.hostWarning}" else ''
  error = if app.error then "\n  Error:   #{app.error.split('\n').join('\n           ')}" else ''
  "#{marker} #{app.name}  #{app.state}#{url}\n  #{app.root}#{warning}#{error}"

# The edge line: Janus's process facts and scope, then Rip's. Janus is
# what runs it, so what to do about a stopped edge is a janus verb; trust
# in its CA is `janus status`'s to report.
renderEdge = (edge) ->
  marker = if edge.state is 'running' then '●' else '○'
  head = if edge.state is 'running'
    detail = []
    detail.push "janus #{edge.version}" if edge.version
    detail.push "pid #{edge.pid}" if edge.pid?
    detail.push "up #{edge.uptime}" if edge.uptime
    detail.push(if edge.autostart then 'autostart on' else 'autostart off') unless edge.external
    detail.push 'external' if edge.external
    "#{marker} Edge  running#{if detail.length then " (#{detail.join(', ')})" else ''}"
  else if edge.external
    "#{marker} Edge  not reachable (JANUS_CONTROL=#{edge.control})"
  else
    "#{marker} Edge  stopped — janus autostart (once), or janus start"
  lines = [head]
  lines.push "  Scope:    #{edge.scope}#{if edge.interface then " (#{edge.interface})" else ''}" if edge.scope?
  lines.push "  Bind:     #{edge.bind.join ' '}" if edge.bind?.length
  lines.push "  Firewall: #{edge.firewall}" if edge.firewall?
  lines.push "  Control:  #{edge.control}" if edge.control?
  lines.push "  Config:   #{edge.config}" if edge.config
  lines.push "  Sites:    #{edge.sites}" if edge.sites
  lines.push "  Upgrade:  the installed janus is newer than the running edge — janus restart" if edge.binaryNewer
  lines.push "  Error:    #{edge.lastError}" if edge.lastError
  lines.join '\n'

printEdge = (edge) ->
  if json then printJson edge else console.log renderEdge(edge)

printApp = (app) ->
  if json then printJson app else console.log renderApp(app)

# Fan-out over the catalog, in catalog order. The agent answers per app,
# so one app that cannot boot is that app's line — its error in place —
# not a wall the apps after it never get past; the exit code (see the
# `all` noun) says whether any failed.
eachApp = (action) ->
  apps = requestAgent! 'rip-sites', 'GET', '/1.0/apps', null, { start: true }
  abort 'rip-sites: no apps in the catalog' unless apps.length
  results = []
  for app in apps
    result = requestAgent! 'rip-sites', 'POST', "/1.0/apps/#{encodeURIComponent(app.id)}/#{action}", {}, { start: true, tolerate: true }
    results.push if result?.error? then { ...app, error: result.error } else result
  results

# Graceful control-plane recycle. The agent exits after replying; edge and
# apps are detached and survive. Waits for the socket to clear so the next
# ensureAgent spawns a replacement instead of adopting the dying process.
stopAgentProcess = ->
  return false unless probeAgent!('rip-sites')?
  requestAgent! 'rip-sites', 'POST', '/1.0/agent/stop', {}, { start: false }
  deadline = Date.now() + 5000
  while Date.now() < deadline and probeAgent!('rip-sites')?
    sleep! 50
  true

wantsControl = ->
  loadCatalog().apps.some (app) -> app.desired is 'running'

# snapshotCatalogApp awaits a manager probe — map through Promise.all, never
# leave bare Promises (JSON.stringify turns those into `{}`).
offlineApps = (doc) -> Promise.all! doc.apps.map (app) -> snapshotCatalogApp! app, 'rip-sites', { baseUrl: doc.edge.baseUrl }

ensureLiveControl = ->
  live = probeAgent! 'rip-sites'
  return live if live
  return null unless wantsControl!
  try
    requestAgent! 'rip-sites', 'GET', '/1.0', null, { start: true }
    probeAgent! 'rip-sites'
  catch then null

probeJanus = (control) ->
  return null unless typeof control is 'string' and control.length
  try
    response = edgeFetch! control, '/1.0', { signal: AbortSignal.timeout(1000) }
    return response.json! if response.ok
  catch then null
  null

readOfflineEdge = ->
  doc = loadCatalog()
  janus = if externalEdge() then null else janusStatus()
  snapshotEdgeState doc.edge, janus, probeJanus!(edgeControl(janus))

# The edge is Janus's process; its verbs are janus's.
edgeIsJanus = (action) ->
  abort "rip-sites: the edge is Janus — `janus #{action}` (and `janus autostart` to keep it running)"

switch verb
  when 'list'
    abort 'rip-sites: list takes no noun' if noun?
    live = ensureLiveControl!
    if live
      apps = requestAgent! 'rip-sites', 'GET', '/1.0/apps', null, { start: false }
    else
      apps = offlineApps! loadCatalog()
    if json then printJson apps else if apps.length then console.log(apps.map(renderApp).join('\n')) else console.log 'No Rip sites. Add one with `rip sites add [project]`.'

  when 'add'
    abort 'rip-sites: add takes at most one project path' if positionals.length > 1
    reservedAsApp name if name?
    body =
      root: resolve(positionals[0] or process.cwd())
      name: name
      hosts: hosts
      options: { workers, concurrency, watchApp, watchApi, eager: eager is true }
    app = requestAgent! 'rip-sites', 'POST', '/1.0/apps', body
    if json then printJson app else console.log "Added #{app.name}\n#{app.root}"

  when 'remove'
    requireApp!
    app = requestAgent! 'rip-sites', 'DELETE', "/1.0/apps/#{encodeURIComponent(noun)}"
    if json then printJson app else console.log "Removed #{app.name}"

  when 'start', 'stop', 'restart'
    # Bare stop → manager at cwd. Path stop when noun is a filesystem path
    # (and not a catalog name). Otherwise supervised lifecycle.
    if verb is 'stop' and not noun?
      runManager! ['stop']
    else if verb is 'stop' and noun? and noun not in RESERVED and noun isnt 'all' and not catalogHas!(noun) and (noun is '.' or existsSync(noun))
      runManager! ['stop', pathNoun!(noun)]
    else
      edgeIsJanus verb if noun is 'edge'
      requireNoun ['<app>', 'all', 'agent']
      if noun is 'agent'
        stopped = if verb is 'start' then false else stopAgentProcess!
        if verb is 'stop'
          if json then printJson { stopped } else console.log(if stopped then 'Control agent stopped — the next control request boots a fresh one.' else 'Control agent is not running.')
        else
          info = requestAgent! 'rip-sites', 'GET', '/1.0', null, { start: true }
          if json then printJson info else console.log "Control agent running (pid #{info.pid})."
      else if noun is 'all'
        results = eachApp! verb
        if json then printJson results else console.log results.map(renderApp).join('\n')
        exit 1 if results.some (app) -> app.error?
      else
        app = requestAgent! 'rip-sites', 'POST', "/1.0/apps/#{encodeURIComponent(noun)}/#{verb}", {}, { start: true }
        printApp app

  when 'status'
    abort 'rip-sites: status takes at most one noun' if positionals.length > 1
    # Path / cwd manager JSON when noun is `.`, an existing path, or missing
    # from the catalog — but bare status stays the edge+apps summary.
    if noun is 'agent'
      info = requestAgent! 'rip-sites', 'GET', '/1.0', null, { start: false, soft: true }
      status = { state: (if info? then 'running' else 'stopped'), pid: info?.pid or null }
      if json then printJson status else console.log(if info? then "Control agent running (pid #{info.pid})." else 'Control agent is not running.')
    else if noun? and noun not in RESERVED and noun isnt 'all' and (noun is '.' or (not catalogHas!(noun) and existsSync(noun)))
      runManager! ['status', pathNoun!(noun)]
    else
      live = ensureLiveControl!
      if not noun? or noun is 'all'
        if live
          edge = requestAgent! 'rip-sites', 'GET', '/1.0/edge', null, { start: false }
          apps = requestAgent! 'rip-sites', 'GET', '/1.0/apps', null, { start: false }
        else
          doc = loadCatalog()
          edge = readOfflineEdge!
          apps = offlineApps! doc
        if json
          printJson if noun is 'all' then apps else { edge, apps }
        else if noun is 'all'
          if apps.length then console.log(apps.map(renderApp).join('\n')) else console.log 'No Rip sites.'
        else
          console.log renderEdge(edge)
          console.log ''
          if apps.length then console.log(apps.map(renderApp).join('\n')) else console.log 'No Rip sites.'
      else if noun is 'edge'
        edgeIsJanus 'status'
      else
        requireApp!
        if live or wantsControl!
          printApp requestAgent!('rip-sites', 'GET', "/1.0/apps/#{encodeURIComponent(noun)}", null, { start: true })
        else
          doc = loadCatalog()
          printApp snapshotCatalogApp!(findCatalogApp(doc, noun), 'rip-sites', { baseUrl: doc.edge.baseUrl })

  when 'open'
    requireNoun ['<app>', 'edge']
    if noun is 'edge'
      edge = if probeAgent!('rip-sites') then requestAgent!('rip-sites', 'GET', '/1.0/edge', null, { start: false }) else readOfflineEdge!
      abort 'rip-sites: edge is not running' unless edge.state is 'running'
      url = dashboardUrl! edge
      abort 'rip-sites: no reachable Janus dashboard is configured; configure a Janus mdns front door reachable by local listener, LAN name, or canonical HTTPS origin' unless url?
    else
      requireApp!
      app = requestAgent! 'rip-sites', 'GET', "/1.0/apps/#{encodeURIComponent(noun)}", null, { start: true }
      abort "rip-sites: #{app.name} has no URL" unless app.url
      url = app.url
    result = Bun.spawnSync ['open', url], { stdout: 'ignore', stderr: 'pipe' }
    abort "rip-sites: cannot open #{url}: #{result.stderr.toString().trim()}" unless result.exitCode is 0
    printJson({ url }) if json

  when 'logs'
    edgeIsJanus 'status (it names the log)' if noun is 'edge'
    requireNoun ['<app>', 'all']
    catalog = loadCatalog()
    apps = if noun is 'all' then catalog.apps else [findCatalogApp(catalog, noun)]
    abort 'rip-sites: no apps in the catalog' unless apps.length
    paths = agentPaths 'rip-sites'
    read = (app, after = null) -> readLog(join(paths.appLogs, app.id + '.log'), lines, after)
    logs = apps.map (app) -> read(app)
    if json
      printJson if noun is 'all' then logs.map((log, i) -> { id: apps[i].id, name: apps[i].name, ...log }) else logs[0]
    else
      for log, i in logs
        console.log "—— #{apps[i].name} ——" if noun is 'all'
        process.stdout.write log.text or (if noun is 'all' then '(empty)\n' else '')
      if follow
        offsets = Object.fromEntries logs.map (log, i) -> [apps[i].id, log.next]
        current = apps.at(-1).id
        loop
          sleep! 250
          for app in apps
            next = read app, offsets[app.id]
            if next.text
              if noun is 'all' and current isnt app.id
                console.log "—— #{app.name} ——"
                current = app.id
              process.stdout.write next.text
            offsets[app.id] = next.next

  when 'reload'
    edgeIsJanus 'reload'

  else
    abort "rip-sites: unknown verb #{JSON.stringify(verb)} — run `rip sites --help`"
