# Rip development edge — DEFAULT posture (loopback, no Bonjour).
# Ports default to 80/443 via launchd fds or RIP_EDGE_*_BIND.
# Status at ripdev.io / sites.ripdev.io is Rip-owned (not Janus Bonjour).
{
	admin unix/{$RIP_EDGE_ADMIN}
	persist_config off
	auto_https disable_redirects
	default_bind {$RIP_EDGE_BIND:127.0.0.1}
	skip_install_trust
	servers {
		protocols h1 h2
	}

	janus {
		control internal {$RIP_EDGE_CONTROL}
		ping
		cache {
			ttl 1s
			ttl_max 10s
			max_body 256kb
			max_bytes 64mb
			max_app_share 50
		}
		hub {
			mode bridge
			origin same
		}
		files {
			precompressed
		}
		browse
	}
}

http://ripdev.io, http://sites.ripdev.io, http://*.ripdev.io {
	bind {$RIP_EDGE_HTTP_BIND:127.0.0.1}
	redir https://{host}{uri} 308
}

sites.ripdev.io, ripdev.io {
	tls {$RIP_EDGE_CERT} {$RIP_EDGE_KEY}
	reverse_proxy unix/{$RIP_EDGE_STATUS}
}

*.ripdev.io {
	tls {$RIP_EDGE_CERT} {$RIP_EDGE_KEY}
	janus
	log {
		output stderr
		format janus
	}
}
