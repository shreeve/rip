# `rip sites serve`: one project's browser App on a loopback port, with no
# edge. It answers what Janus answers for the same project — the shell,
# the App's bundle.json and latest.json, the runtime under /@rip, and the
# file roots, by Janus's request-path, hidden-name, method, and Accept
# rules — from memory and the project's own directories, and writes
# nothing into the project. A source change tells open tabs to reload.
#
# A project serve cannot carry the way the edge does (API workers, tenant
# hosts, directory browsing) rejects at startup instead of half-running.
import { existsSync, realpathSync, statSync, watch } from 'node:fs'
import { basename, join, sep } from 'node:path'
import { resolveProject } from './control.rip'
import { appEventRelevant, appShell, buildAppDocuments, currentShipSet, defaultAppChanges, loadServeConfig, settleShipSet } from './manager.rip'

FIRST_PORT = 4000
LAST_PORT = 4099
SETTLE_MS = 50
BURST_MS = 250
# Loopback addresses a listener elsewhere answers on when it holds the
# port — on them, or on a wildcard that covers them. Binding 127.0.0.1
# succeeds beside such a listener, so serve asks first by connecting,
# which binds nothing beyond the loopback.
LOOPBACKS = ['127.0.0.1', '::1']
NO_CACHE = { 'Cache-Control': 'no-cache' }

USAGE = '''
  usage: rip sites serve [project] [--port N]

  Serves one project's browser App on http://127.0.0.1 with no edge, and
  reloads open tabs when its sources change. The port defaults to the
  first free one from 4000; --port 0 lets the system pick.
'''

parseServeArgs = (argv) ->
  args = { entry: null, port: null }
  i = 0
  while i < argv.length
    value = argv[i++]
    switch value
      when '--help', '-h'
        console.log USAGE
        exit 0
      when '--port'
        text = argv[i++]
        abort 'rip-sites: --port requires a value' unless text?
        port = Number text
        abort "rip-sites: --port must be an integer from 0 to 65535, not #{JSON.stringify(text)}" unless /^\d+$/.test(text) and port <= 65535
        args.port = port
      else
        abort "rip-sites: serve does not accept #{value}" if value.startsWith('-')
        abort "rip-sites: serve takes one project, not #{JSON.stringify(value)} after #{JSON.stringify(args.entry)}" if args.entry?
        args.entry = value
  args

refuse = (message) -> abort "rip-sites: serve #{message}"

# The file roots, in the order Janus searches them behind its dist root.
servedRoots = (project, serve) ->
  if serve?.files?
    for root in serve.files.roots
      refuse "cannot list directories; serve.rip roots #{root.path} with browse: true — run it behind the edge" if root.browse
      refuse "cannot fill the {site} in serve.rip root #{root.path} — run it behind the edge" if root.path.includes('{site}')
    return serve.files.roots.map (root) -> root.path
  roots = []
  publicRoot = join project.root, 'public'
  roots.push publicRoot if existsSync(publicRoot) and statSync(publicRoot).isDirectory()
  roots.push project.appRoot if project.appRoot?
  roots

# Janus's request path: escapes that decode exactly once, never to a
# separator, and no NUL or dot segment. Null is a 400. Bun has already
# turned a literal backslash into a slash and resolved literal dot
# segments before the handler runs, so those reach it as clean paths.
requestPath = (url) ->
  escaped = url.pathname or '/'
  return null if /%(?![0-9A-Fa-f]{2})|%2[Ff]|%5[Cc]/.test(escaped)
  decoded = try decodeURIComponent(escaped) catch then null
  return null unless decoded?.startsWith('/')
  return null if decoded.includes('\0')
  return null if decoded.split('/').some (segment) -> segment is '.' or segment is '..'
  decoded

# A dot-prefixed segment is a miss, never the shell; only a first segment
# of exactly `.well-known` is served.
hiddenPath = (path) ->
  path.split('/').slice(1).some (segment, i) -> segment.startsWith('.') and not (i is 0 and segment is '.well-known')

# Janus's shell test: some media range admitting HTML at a nonzero q. A
# malformed list admits nothing.
acceptsHtml = (value) ->
  return false unless value?.trim()
  items = []
  start = 0
  quoted = false
  escaping = false
  for char, i in value
    if escaping then escaping = false
    else if quoted and char is '\\' then escaping = true
    else if char is '"' then quoted = not quoted
    else if char is ',' and not quoted
      items.push value.slice(start, i)
      start = i + 1
  items.push value.slice(start)
  for item in items
    [range, ...params] = item.split(';').map (part) -> part.trim()
    range = range.toLowerCase()
    return false unless /^[!#$%&'*+.^_`|~0-9a-z-]+(\/[!#$%&'*+.^_`|~0-9a-z-]+)?$/.test(range)
    q = 1
    for param in params
      [key, raw] = param.split('=').map (part) -> part.trim()
      return false unless key and raw?
      continue unless key.toLowerCase() is 'q'
      raw = raw.slice(1, -1) if raw.length > 1 and raw.startsWith('"') and raw.endsWith('"')
      q = Number raw
      return false unless /^(\d+(\.\d*)?|\.\d+)$/.test(raw) and q <= 1
    return true if q > 0 and range in ['text/html', 'text/*', '*/*']
  false

# The first root holding the path as a regular file, the request path's
# trailing slash included (a file under a slash is a miss). A file whose
# real path leaves its root is a miss, as at the edge, and is named in the
# terminal so the broken link is found.
findFile = (roots, path) ->
  relative = path.slice(1)
  return null if not relative or relative.startsWith('/')
  for root in roots
    candidate = join root, relative
    candidate += '/' if relative.endsWith('/') and not candidate.endsWith('/')
    info = try statSync(candidate) catch then null
    continue unless info?.isFile()
    real = realpathSync candidate
    if real.startsWith(realpathSync(root) + sep)
      return candidate
    warn "rip-sites: serve skipped #{candidate}: it resolves to #{real}, outside its root"
  null

listen = (port, fetch, websocket) -> Bun.serve { hostname: '127.0.0.1', port, fetch, websocket }

answers = (hostname, port) ->
  try
    socket = Bun.connect! { hostname, port, socket: { data: -> return } }
    socket.end()
    true
  catch
    false

# A server on 127.0.0.1:port, or null when a listener already answers for
# the port on the loopback.
claim = (port, fetch, websocket) ->
  if port > 0
    for host in LOOPBACKS
      return null if answers!(host, port)
  try
    listen port, fetch, websocket
  catch error
    throw error unless error?.code is 'EADDRINUSE'
    null

export serveLocal = (argv) ->
  args = parseServeArgs argv
  project = resolveProject args.entry
  serve = try loadServeConfig!(project.root) catch error then abort(error?.message or String(error))

  refuse "runs App-only projects; #{project.entry} is an API entry — run it behind the edge with `rip sites run`" if project.entry?
  refuse 'cannot route serve.rip sites (tenant hosts) — run it behind the edge' if serve?.site?
  refuse 'has no API workers for serve.rip files.proxyFirst — run it behind the edge' if serve?.files?.proxy_first?.length
  refuse 'has no API workers for serve.rip hub.bridge — run it behind the edge' if serve?.hub?

  if serve?.app?
    project.appRoot = serve.app.root
    project.appChanges = serve.app.changes
  else if project.appRoot?
    project.appChanges = defaultAppChanges()
  name = serve?.name or basename(project.root).replace(/\.[^.]+$/, '')
  roots = servedRoots project, serve
  refuse "has nothing to serve in #{project.root}: no app/, public/, or serve.rip files roots" unless project.appRoot? or roots.length

  # The shell the edge registers: serve.rip's, else an authored
  # index.html, else the generated one — which exists only with an App.
  authoredShell = if project.appRoot? then join(project.appRoot, 'index.html') else null
  shellPath = serve?.files?.shell ?? (if authoredShell? and existsSync(authoredShell) then authoredShell else null)
  generatedShell = if shellPath? or not project.appRoot? then null else appShell(name, true)

  documents = null
  failure = null
  build = (prior) ->
    return null unless project.appRoot?
    ship = try
      currentShipSet prior?.ship
    catch error
      throw error unless error.shipSet is 'torn'
      settleShipSet!
    buildAppDocuments! project, ship
  try
    documents = build!
  catch error
    abort "rip-sites: #{error?.message or error}"

  # The manager's dist root, held in memory: it is searched first.
  distFile = (path) ->
    return null unless documents?
    return Response.new(documents.bundle, headers: { 'Content-Type': 'application/json', ...NO_CACHE }) if path is '/bundle.json'
    return Response.new(documents.latest, headers: { 'Content-Type': 'application/json', ...NO_CACHE }) if path is '/latest.json'
    return Response.new(generatedShell, headers: { 'Content-Type': 'text/html; charset=utf-8', ...NO_CACHE }) if path is '/index.html' and generatedShell?
    return null unless path.startsWith('/@rip/')
    file = documents.ship.files.find (file) -> file.name is path.slice('/@rip/'.length)
    return null unless file?
    type = if file.name.endsWith('.br') then 'application/octet-stream' else 'text/javascript; charset=utf-8'
    Response.new file.bytes, headers: { 'Content-Type': type, ...NO_CACHE }

  shell = ->
    return Response.new(Bun.file(shellPath), headers: { 'Content-Type': 'text/html; charset=utf-8', ...NO_CACHE }) if shellPath?
    return Response.new(generatedShell, headers: { 'Content-Type': 'text/html; charset=utf-8', ...NO_CACHE }) if generatedShell?
    null

  respond = (request, server) ->
    url = URL.new request.url
    if url.pathname is '/hub'
      return if server.upgrade(request)
      return Response.new('the Hub takes WebSocket connections only', status: 400)
    path = requestPath url
    return Response.new('Bad Request', status: 400) unless path?
    return Response.new('Not Found', status: 404) unless request.method in ['GET', 'HEAD']
    return Response.new('Not Found', status: 404) if hiddenPath(path)
    answer = distFile path
    return answer if answer?
    found = findFile roots, path
    return Response.new(Bun.file(found), headers: NO_CACHE) if found?
    answer = shell() if acceptsHtml(request.headers.get('accept'))
    answer ?? Response.new('Not Found', status: 404)

  hub =
    message: (socket, data) ->
      frame = try JSON.parse(String(data)) catch then null
      return unless frame? and typeof frame is 'object' and Array.isArray(frame['+']) and frame['+'].includes('/hub')
      socket.subscribe 'hub'
      socket.send JSON.stringify({ '!': frame['?'] }) if frame['?']?

  server = null
  if args.port?
    server = claim! args.port, respond, hub
    abort "rip-sites: serve cannot listen on 127.0.0.1:#{args.port}: the port is in use" unless server?
  else
    for port in [FIRST_PORT..LAST_PORT]
      server = claim! port, respond, hub
      break if server?
    abort "rip-sites: serve found no free port from #{FIRST_PORT} to #{LAST_PORT}; pass --port" unless server?

  publish = (frame) -> server.publish 'hub', JSON.stringify(frame)

  watched = Set.new()
  watchTree = (path, relevant) ->
    return if watched.has(path) or not existsSync(path)
    watched.add path
    watch path, { recursive: true }, (event, filename) -> relevant(filename)
  # Package and runtime roots the publication read; one a later
  # publication reaches is watched from then on.
  watchInputs = (publication) ->
    watchTree(root, -> schedule(false)) for root in publication?.watchRoots or []

  # One rebuild at a time; events landing during one run another pass, and
  # open tabs hear once, after the last. Only a pass that assembles replaces
  # what is served, so the served publication is always the one the tabs
  # were last told of. A change outside the App root reloads even though
  # the App hash holds, and stays owed through a failed assembly.
  timer = null
  running = false
  again = false
  outsideApp = false
  epoch = 0
  rebuild = ->
    if running
      again = true
      return
    running = true
    candidate = documents
    assembled = true
    loop
      again = false
      try
        candidate = build!(candidate)
        watchInputs candidate
        assembled = true
      catch error
        assembled = false
        message = error?.message or String(error)
        unless message is failure
          failure = message
          warn "rip-sites: #{message}"
          publish { assembly: { hash: documents.hash, failure } } if documents?
      break unless again
    if assembled
      changed = candidate?.hash isnt documents?.hash
      documents = candidate
      if changed or outsideApp
        failure = null
        outsideApp = false
        console.log "rip-sites: reload#{if documents? then " #{documents.hash}" else ''}"
        publish { reload: { epoch: ++epoch } }
      else if failure?
        failure = null
        publish { assembly: { hash: documents.hash, failure: null } }
    running = false

  # The manager's cadence: SETTLE_MS after the latest event, but never later
  # than BURST_MS after the first, so a burst of saves reloads once or twice.
  deadline = null
  schedule = (outside) ->
    outsideApp = true if outside
    now = Date.now()
    if timer?
      clearTimeout timer
      delay = Math.max 0, Math.min(SETTLE_MS, deadline - now)
    else
      deadline = now + BURST_MS
      delay = SETTLE_MS
    timer = setTimeout (->
      timer = null
      deadline = null
      rebuild!
    ), delay

  hidden = (filename) -> filename? and String(filename).replaceAll('\\', '/').split('/').some((segment) -> segment.startsWith('.'))
  if project.appRoot?
    watchTree project.appRoot, (filename) ->
      schedule(false) if appEventRelevant(project.appRoot, documents?.graph, project.appChanges, filename)
  for root in roots when root isnt project.appRoot
    watchTree root, (filename) -> schedule(true) unless hidden(filename)
  watchInputs documents
  # A change between the first build and the watchers arming is caught here.
  schedule(false)

  console.log "rip-sites: serving #{name} at http://127.0.0.1:#{server.port}/"
  console.log '  behind the edge, with HTTPS and in-place updates: rip sites run (or rip sites add, then rip sites start)'
  Promise.new -> return
