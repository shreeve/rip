#!/usr/bin/env rip

# Rip Sites menu-bar provider. Imports the reusable tray vocabulary from
# rip/tray and drives menus only through the unified `rip sites` CLI
# (`edge` / `all` / `tray` are reserved nouns).

import { dirname, join } from 'node:path'
import { action, directory, label, link, quit, separator, serve, submenu, svgFile, tray } from 'rip/tray'

trayDir = dirname(Bun.resolveSync('rip/tray', import.meta.dir))
asset = (name, options = {}) -> svgFile(join(trayDir, 'assets', name), options)

rip = process.env.RIP_TRAY_RIP or 'rip'

command = (args) ->
  proc = Bun.spawn [rip, ...args], { stdin: 'ignore', stdout: 'pipe', stderr: 'pipe' }
  out = Response.new(proc.stdout).text()
  err = Response.new(proc.stderr).text()
  code = await proc.exited
  out = await out
  err = await err
  throw Error.new(err.trim() or "rip #{args.join(' ')} exited #{code}") unless code is 0
  out

json = (...args) -> JSON.parse command! args
capitalize = (text) -> text[0].toUpperCase() + text.slice(1)

openUrl = (url) ->
  result = Bun.spawnSync ['open', url], { stdout: 'ignore', stderr: 'pipe' }
  throw Error.new(result.stderr.toString().trim() or "cannot open #{url}") unless result.exitCode is 0

openLog = (site) ->
  log = json! 'sites', 'logs', site.name, '--lines', '1', '--json'
  openUrl! log.path

# Browser status host for the current edge posture (portless when on 443).
dashboardUrl = (edge) ->
  host = if edge.mode is 'local' then 'sites.local' else 'sites.ripdev.io'
  port = if Number.isInteger(edge.httpsPort) and edge.httpsPort isnt 443 then ":#{edge.httpsPort}" else ''
  "https://#{host}#{port}/"

edgeMenu = (edge) ->
  mode = edge.mode or 'default'
  posture = if mode is 'local' then 'LAN' else 'loopback'
  # Ownership only when it isn't the usual Rip-managed edge.
  status = if edge.managed then "#{capitalize(edge.state)} · #{posture}"
  else if edge.state is 'running' then "Running · external · #{posture}"
  else 'Not running'
  items = [
    label status, icon: if edge.state is 'running' then 'checkmark.circle.fill' else 'circle'
  ]
  if edge.state is 'running'
    items.push link 'Open Dashboard', dashboardUrl(edge), id: 'edge.dashboard', icon: 'safari'
  # After a successful trust the action becomes this confirmation row — silent
  # success with an unchanged "Trust CA…" button reads as "nothing happened".
  if edge.localCaTrusted
    items.push label 'Local CA trusted', icon: 'checkmark.seal.fill'
  else if edge.managed or edge.state isnt 'running'
    items.push action 'Trust CA…', id: 'edge.trust', icon: 'lock.shield', run: -> json! 'sites', 'trust', 'edge', '--json'
  if mode is 'local'
    items.push action 'Use Default (loopback)', id: 'edge.expose.loopback', icon: 'laptopcomputer', run: -> json! 'sites', 'expose', 'loopback', '--json'
  else
    items.push action 'Use Local (LAN)…', id: 'edge.expose.local', icon: 'wifi', run: -> json! 'sites', 'expose', 'local', '--json'
  if edge.state is 'running'
    if edge.managed
      items.push separator()
      items.push action 'Reload', id: 'edge.reload', icon: 'arrow.clockwise', run: -> json! 'sites', 'reload', 'edge', '--json'
      items.push action 'Stop', id: 'edge.stop', icon: 'stop.fill', run: -> json! 'sites', 'stop', 'edge', '--json'
  else
    items.push separator()
    items.push action 'Start', id: 'edge.start', icon: 'play.fill', run: -> json! 'sites', 'start', 'edge', '--json'
  submenu 'Edge', items, id: 'edge', icon: 'network'

siteMenu = (site) ->
  running = site.state is 'running'
  items = [label site.root, subtitle: site.state]
  if running
    items.push link 'Open', site.url, id: "#{site.id}.open", icon: 'safari' if site.url?
    items.push action 'Stop', id: "#{site.id}.stop", icon: 'stop.fill', run: -> json! 'sites', 'stop', site.id, '--json'
    items.push action 'Restart', id: "#{site.id}.restart", icon: 'arrow.clockwise', run: -> json! 'sites', 'restart', site.id, '--json'
  else
    items.push action 'Start', id: "#{site.id}.start", icon: 'play.fill', run: -> json! 'sites', 'start', site.id, '--json'
  items.push action 'Open Log', id: "#{site.id}.logs", icon: 'doc.text', run: -> openLog! site
  submenu site.name, items, id: site.id, icon: if running then 'circle.fill' else 'circle'

serve! tray
  title: 'Rip'
  icon: asset 'rip-template.svg'
  logo: asset 'rip-color.svg', template: false
  tooltip: 'Rip Sites'
  refresh: 2
  menu: ->
    snapshot = json! 'sites', 'status', '--json'
    edge = snapshot.edge
    sites = snapshot.apps
    items = [edgeMenu(edge), separator()]
    items.push siteMenu(site) for site in sites
    items.push directory 'Add Site…', id: 'sites.add', icon: 'plus', prompt: 'Add', run: (path) -> json! 'sites', 'add', path, '--json'
    items.push separator()
    items.push action 'Refresh', id: 'tray.refresh', icon: 'arrow.clockwise', run: -> null
    items.push quit 'Quit', icon: 'power'
    items
