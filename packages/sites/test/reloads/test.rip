test! 'static edits ding /assets with URL paths: every edit once per burst, never content', ->
  dir = mkdtempSync join(tmpdir(), 'rip-reloads-assets-')
  project = join dir, 'project'
  cpSync join(import.meta.dir, 'project'), project, { recursive: true }
  # Two declared roots: a plain one and a '{site}' template — each watcher
  # must strip its OWN root prefix (a regression here once leaked the last
  # root's mapping into every callback).
  mkdirSync join(project, 'public', 'docs'), { recursive: true }
  writeFileSync join(project, 'public', 'docs', 'api.html'), '<h1>one</h1>'
  mkdirSync join(project, 'pods', 'acme', 'public'), { recursive: true }
  writeFileSync join(project, 'pods', 'acme', 'public', 'deep.css'), 'em {}'
  writeFileSync join(project, 'serve.rip'), """
  export default
    app: { root: 'app' }
    files:
      roots: [
        { path: 'public' }
        { path: 'pods/{site}/public' }
      ]
      shell: 'public/docs/api.html'
  """
  controlSocket = join dir, 'janus.sock'
  registration = null
  messages = []
  control = Bun.serve
    unix: controlSocket
    fetch: (request) ->
      url = URL.new request.url
      if request.method is 'POST' and url.pathname is '/1.0/apps'
        registration = request.json!
        return Response.json({ id: 'assets-registration' }, { status: 201 })
      if request.method is 'POST' and url.pathname is '/1.0/apps/assets-registration/hub/publish'
        messages.push ...(request.json!)
        return Response.json({ deliveries: 0 })
      Response.new(null, { status: 204 })
  proc = null
  try
    proc = Bun.spawn [process.execPath, PRELOAD, SERVER, project, '--watch', '--workers', '1', '--host', 'assets.test', '--control', controlSocket, '--access-log=off'],
      stdin: 'ignore'
      stdout: 'ignore'
      stderr: 'inherit'
    waitFor! -> registration?
    # endsWith, not equality: the manager realpaths the project root and
    # macOS tmpdirs live behind a /var → /private/var symlink.
    ok registration.files.roots.some((root) -> root.path.endsWith('/public')), 'public root registered'

    # A save burst arrives as one frame or several: the debounce fires 50ms
    # after the latest event and caps at 250ms after the first, so writes
    # that straddle a window are SPLIT, never dropped or merged with the
    # next burst. The union is what holds — each edited file dings once, as
    # the URL path a browser would be looking at, with the '{site}' root
    # stripping its tenant segment. A frame COUNT would assert the
    # scheduler instead, and fails whenever the burst is descheduled.
    touched = -> messages.filter (message) -> message.touched?
    dinged = (from = 0) -> [...Set.new(touched().slice(from).flatMap((frame) -> frame.touched))].sort()
    # `dinged` unions ACROSS frames, because a split burst may name the same
    # file in two of them. A file named twice INSIDE one frame is a defect
    # that union hides, so each frame answers for itself here.
    wellFormed = (from = 0) ->
      touched().slice(from).every (frame) ->
        frame['@'].length is 1 and frame['@'][0] is '/assets' and Set.new(frame.touched).size is frame.touched.length
    writeFileSync join(project, 'public', 'docs', 'api.html'), '<h1>two</h1>'
    writeFileSync join(project, 'public', 'docs', 'api.html'), '<h1>three</h1>'
    writeFileSync join(project, 'public', 'style.css'), 'body { color: red }'
    writeFileSync join(project, 'pods', 'acme', 'public', 'deep.css'), 'em { color: blue }'
    waitFor! -> touched().length > 0
    sleep! 400
    ok wellFormed(), 'every frame dings /assets, naming each path once'
    eq dinged(), ['/deep.css', '/docs/api.html', '/style.css']

    # A later burst is its own frame; paths are URL paths, no content ever.
    settled = touched().length
    writeFileSync join(project, 'public', 'docs', 'api.html'), '<h1>four</h1>'
    waitFor! -> touched().length > settled
    sleep! 400
    ok wellFormed(settled), 'the later burst dings /assets, naming each path once'
    eq dinged(settled), ['/docs/api.html']

    proc.kill 'SIGTERM'
    eq (await proc.exited), 143
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    control.stop true
    rmSync dir, { recursive: true, force: true }
