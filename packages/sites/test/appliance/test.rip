import { test, eq, ok } from 'rip/testing'
import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, unlinkSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import { tmpdir } from 'node:os'

PRELOAD = process.execArgv.find (arg) -> arg.startsWith '--preload='
APP = join(import.meta.dir, '..', '..', 'sites.rip')
FAKE_CADDY = join(import.meta.dir, 'fake-caddy.rip')

run = (file, args, env, cwd = null) ->
  proc = Bun.spawn [process.execPath, PRELOAD, file, ...args],
    stdin: 'ignore'
    stdout: 'pipe'
    stderr: 'pipe'
    env: { ...process.env, ...env }
    cwd: cwd or process.cwd()
  out = Response.new(proc.stdout).text()
  err = Response.new(proc.stderr).text()
  { proc, out, err }

cli = (file, args, env, cwd = null) ->
  result = run file, args, env, cwd
  code = await result.proc.exited
  { code, out: await result.out, err: await result.err }

waitFor = (name, fn, timeout = 5000) ->
  deadline = Date.now() + timeout
  loop
    value = fn!
    return value if value
    throw Error.new("timed out waiting for #{name}") if Date.now() >= deadline
    sleep! 10

fixture = (prefix) ->
  root = mkdtempSync join(tmpdir(), prefix)
  state = join root, 'state'
  runtime = join root, 'runtime'
  mkdirSync state, { mode: 0o700 }
  mkdirSync runtime, { mode: 0o700 }
  { root, state, runtime }

stopAgent = (runtime) ->
  owner = join runtime, 'agent.json'
  return unless existsSync owner
  pid = JSON.parse(readFileSync(owner, 'utf8')).pid
  try process.kill pid, 'SIGTERM'
  waitFor! 'agent shutdown', -> not existsSync(owner)

# via.rip replaced the purchased ripdev.io wildcard: both postures mint
# exact-host certs from the LOCAL CA on demand (dogfooding — we run exactly
# what users run; no packaged public certificate, no renewal treadmill).
test! 'the packaged macOS edge activates loopback HTTP+HTTPS sockets without Bonjour', ->
  caddyfile = readFileSync join(import.meta.dir, '..', '..', 'Caddyfile'), 'utf8'
  localfile = readFileSync join(import.meta.dir, '..', '..', 'Caddyfile.local'), 'utf8'
  launcher = readFileSync join(import.meta.dir, '..', '..', 'launchd-listener.js'), 'utf8'
  agent = readFileSync join(import.meta.dir, '..', '..', 'agent.rip'), 'utf8'
  ok caddyfile.includes 'default_bind {$RIP_EDGE_BIND:127.0.0.1}'
  ok caddyfile.includes 'protocols h1 h2'
  ok caddyfile.includes 'bind {$RIP_EDGE_HTTP_BIND:127.0.0.1}'
  ok caddyfile.includes 'redir https://{host}{uri} 308'
  ok caddyfile.includes 'http://via.rip, http://*.via.rip'
  ok caddyfile.includes 'reverse_proxy unix/{$RIP_EDGE_STATUS}'
  # Both postures mint from the local CA — no packaged certificate.
  ok caddyfile.includes 'issuer internal'
  ok caddyfile.includes 'ask http://127.0.0.1:{$RIP_EDGE_HTTP_PORT:80}/tls-ask'
  ok not caddyfile.includes 'RIP_EDGE_CERT'
  ok not localfile.includes 'RIP_EDGE_CERT'
  ok not /\bmdns\b/.test(caddyfile)
  ok not caddyfile.includes '7680'
  ok localfile.includes 'mdns'
  ok localfile.includes 'name rip.local'
  ok localfile.includes 'apps on'
  # Exact-host internal certs — browsers reject SAN DNS:*.local wildcards.
  ok localfile.includes 'on_demand_tls'
  ok localfile.includes 'ask http://127.0.0.1:{$RIP_EDGE_HTTP_PORT:80}/tls-ask'
  ok localfile.includes 'issuer internal'
  ok localfile.includes 'on_demand'
  ok localfile.includes 'http://127.0.0.1'
  ok agent.includes "/tls-ask"
  # Product HTTPS status is the Rip catalog — Janus stays on the HTTP mdns door.
  ok /rip\.local \{[\s\S]*?reverse_proxy unix\/\{\$RIP_EDGE_STATUS\}/.test(localfile)
  ok localfile.includes 'handle /trust*'
  ok not localfile.includes 'RIP_EDGE_JANUS_HTTP'
  ok launcher.includes "activate('HTTP')"
  ok launcher.includes "activate('HTTPS')"
  ok launcher.includes "RIP_EDGE_HTTP_BIND: 'fd/3'"
  ok launcher.includes "RIP_EDGE_BIND: 'fd/4'"
  ok launcher.includes "stdio: ['ignore', 'inherit', 'inherit', httpListener, httpsListener]"
  ok agent.includes 'PACKAGED_CADDYFILES'
  ok agent.includes "mode: 'default'"
  ok agent.includes 'localCaTrusted'
  ok agent.includes 'ensureLanHosts'
  ok agent.includes 'defaultAppHosts'
  # trust talks to the unix admin socket — never stock :2019
  ok agent.includes "'trust', '--address', edgeAddress(admin)"
  # status page: `.join` must follow a parenthesized map, not the row string
  ok agent.includes '(apps.map (app) ->'
  ok /\)\.join ''/.test(agent)
  helloServe = readFileSync join(import.meta.dir, '..', '..', 'demos', 'hello', 'serve.rip'), 'utf8'
  ok helloServe.includes 'hello.via.rip'
  ok helloServe.includes 'hello.local'

startJanus = (socket, calls) ->
  serial = 0
  Bun.serve
    unix: socket
    fetch: (request) ->
      url = URL.new request.url
      calls.push { method: request.method, path: url.pathname }
      return Response.json({ type: 'janus', api_version: '1.0' }) if request.method is 'GET' and url.pathname is '/1.0'
      if request.method is 'POST' and url.pathname is '/1.0/apps'
        serial++
        return Response.json({ id: "app-#{serial}" }, { status: 201 })
      Response.new null, { status: 204 }

test! 'rip sites remembers, supervises, observes, and removes one project', ->
  site = fixture 'rip-agent-app-'
  project = join site.root, 'project'
  mkdirSync join(project, 'app'), { recursive: true }
  writeFileSync join(project, 'app', 'index.rip'), "export default -> 'ok'\n"
  janusSocket = join site.root, 'janus.sock'
  calls = []
  janus = startJanus janusSocket, calls
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: janusSocket }
  try
    empty = cli! APP, ['list', '--json'], env
    eq empty.code, 0
    eq JSON.parse(empty.out), []
    ok not existsSync(join(site.runtime, 'agent.json')), 'list must not spawn the control plane'

    idleStatus = cli! APP, ['status', '--json'], env
    eq idleStatus.code, 0
    idle = JSON.parse idleStatus.out
    # Fixture Janus is already listening — report external, never spawn control.
    eq idle.edge.state, 'running'
    eq idle.edge.managed, false
    ok not existsSync(join(site.runtime, 'agent.json')), 'idle status must not spawn the control plane'

    added = cli! APP, ['add', project, '--name', 'fixture', '--host', 'fixture.via.rip', '--json'], env
    eq added.code, 0
    app = JSON.parse added.out
    eq app.name, 'fixture'
    eq app.state, 'stopped'
    eq app.url, 'https://fixture.via.rip/'
    ok existsSync(join(site.state, 'sites.json')), 'add writes sites.json'
    ok not existsSync(join(site.runtime, 'agent.json')), 'add must not spawn the control plane'

    # Offline list/status must await catalog snapshots — bare Promises JSON as `{}`
    # and the tray then throws "label title must be a non-empty string".
    offlineList = JSON.parse((cli!(APP, ['list', '--json'], env)).out)
    eq offlineList.length, 1
    eq offlineList[0].name, 'fixture'
    eq offlineList[0].root, app.root
    eq realpathSync(offlineList[0].root), realpathSync(project)
    eq offlineList[0].state, 'stopped'
    offlineSummary = JSON.parse((cli!(APP, ['status', '--json'], env)).out)
    eq offlineSummary.apps.length, 1
    eq offlineSummary.apps[0].name, 'fixture'
    eq offlineSummary.apps[0].root, app.root
    ok not existsSync(join(site.runtime, 'agent.json')), 'offline list/status must not spawn the control plane'

    # Catalog nouns resolve like start/stop — manager is internal, not `rip site`.
    held = cli! APP, ['hold', 'fixture'], env
    eq held.code, 1
    ok not held.err.includes('project not found: fixture'), 'hold must resolve catalog name to root'
    ok held.err.includes('hold failed') or held.err.includes('ECONNREFUSED') or held.err.includes('No such file') or held.err.includes('manager'), "hold reaches manager for #{project}: #{held.err}"
    migrated = cli! APP, ['migrate', 'fixture', '--dir', 'migrations'], env
    eq migrated.code, 1
    ok not migrated.err.includes('migration entries'), 'migrate must not treat the app name as a migration entry'
    ok not migrated.err.includes('project not found: fixture')
    unknownHold = cli! APP, ['hold', 'missing-app'], env
    eq unknownHold.code, 1
    ok unknownHold.err.includes 'unknown app'
    recoverShape = cli! APP, ['recover', 'fixture'], env
    eq recoverShape.code, 1
    ok recoverShape.err.includes 'operation id'
    exposeHelp = cli! APP, ['expose'], env
    eq exposeHelp.code, 1
    ok exposeHelp.err.includes 'local | public | loopback'

    duplicate = cli! APP, ['add', project], env
    eq duplicate.code, 1
    ok duplicate.err.includes 'project is already registered'

    wrongSurface = cli! APP, ['status', 'fixture', '--workers', '9'], env
    eq wrongSurface.code, 1
    ok wrongSurface.err.includes 'status does not accept add options: --workers'
    conflictingLogs = cli! APP, ['logs', 'fixture', '--follow', '--json'], env
    eq conflictingLogs.code, 1
    ok conflictingLogs.err.includes '--follow conflicts with --json'

    started = cli! APP, ['start', 'fixture', '--json'], env
    eq started.code, 0
    live = JSON.parse started.out
    eq live.state, 'running'
    eq live.desired, 'running'
    ok Number.isInteger live.pid

    listed = JSON.parse((cli!(APP, ['list', '--json'], env)).out)
    eq listed.length, 1
    eq listed[0].pid, live.pid
    summary = JSON.parse((cli!(APP, ['status', '--json'], env)).out)
    ok summary.edge?
    eq summary.apps.length, 1
    eq summary.apps[0].pid, live.pid
    reserved = cli! APP, ['add', project, '--name', 'edge'], env
    eq reserved.code, 1
    ok reserved.err.includes 'reserved'

    # The manager outlives the UI/control client. A replacement agent adopts
    # the same canonical manager socket and preserves the desired state.
    stopAgent! site.runtime
    adopted = JSON.parse((cli!(APP, ['status', 'fixture', '--json'], env)).out)
    eq adopted.state, 'running'
    eq adopted.desired, 'running'
    eq adopted.pid, live.pid
    # list must agree with status after control crash (revive or probe manager).
    listedAfter = JSON.parse((cli!(APP, ['list', '--json'], env)).out)
    eq listedAfter.length, 1
    eq listedAfter[0].state, 'running'
    eq listedAfter[0].pid, live.pid

    logs = cli! APP, ['logs', 'fixture', '--json'], env
    eq logs.code, 0
    log = JSON.parse logs.out
    ok log.path.endsWith("#{app.id}.log")
    ok Number.isInteger log.next
    eq log.truncated, false

    blocked = cli! APP, ['remove', 'fixture'], env
    eq blocked.code, 1
    ok blocked.err.includes 'is running — stop it before removal'

    stopped = cli! APP, ['stop', 'fixture', '--json'], env
    eq stopped.code, 0
    eq JSON.parse(stopped.out).state, 'stopped'
    ok calls.some((call) -> call.method is 'DELETE' and call.path is '/1.0/apps/app-1')

    removed = cli! APP, ['remove', 'fixture', '--json'], env
    eq removed.code, 0
    eq JSON.parse(removed.out).name, 'fixture'
    eq JSON.parse((cli!(APP, ['list', '--json'], env)).out), []

    # The grace that stops a just-probed client from being reset must not
    # curdle into "never exits": with nothing left to supervise, the control
    # plane still goes away on its own. Bound covers grace + the next sweep.
    waitFor! 'idle control plane exit', (-> not existsSync(join(site.runtime, 'agent.json'))), 15000
  finally
    try
      stopped = cli! APP, ['stop', 'fixture'], env
    stopAgent! site.runtime
    janus.stop true
    rmSync site.root, { recursive: true, force: true }

# serve.rip owns its app's hosts: the catalog stores [] and snapshots read
# the declaration itself. The effective hosts must never be persisted back
# into sites.json — stored hosts become manager --host flags, and a
# site-template manager refuses --host outright.
test! 'offline snapshots derive hosts from serve.rip without persisting them', ->
  site = fixture 'rip-serve-hosts-'
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime }
  hostsProject = join site.root, 'probe'
  mkdirSync join(hostsProject, 'app'), { recursive: true }
  writeFileSync join(hostsProject, 'app', 'index.rip'), "export default -> 'ok'\n"
  writeFileSync join(hostsProject, 'serve.rip'), "export default\n  name: 'probe'\n  hosts: ['probe.via.rip', 'probe.local']\n"
  siteProject = join site.root, 'tenants'
  mkdirSync join(siteProject, 'app'), { recursive: true }
  mkdirSync join(siteProject, 'sites'), { recursive: true }
  writeFileSync join(siteProject, 'app', 'index.rip'), "export default -> 'ok'\n"
  writeFileSync join(siteProject, 'app', 'index.html'), '<!doctype html><title>t</title>\n'
  writeFileSync join(siteProject, 'serve.rip'), "export default\n  sites:\n    host: '{site}.probe.dev'\n    dir: 'sites'\n    aliases: { 'beta.probe.dev': 'ola' }\n  files:\n    roots: ['app']\n    shell: 'app/index.html'\n"
  added = JSON.parse (cli!(APP, ['add', hostsProject, '--name', 'probe', '--json'], env)).out
  eq added.hosts, ['probe.via.rip', 'probe.local']
  eq added.url, 'https://probe.via.rip/'
  tenants = JSON.parse (cli!(APP, ['add', siteProject, '--name', 'tenants', '--json'], env)).out
  eq tenants.hosts, ['beta.probe.dev']
  eq tenants.sitePattern, '{site}.probe.dev'
  eq tenants.url, 'https://beta.probe.dev/'
  stored = JSON.parse readFileSync(join(site.state, 'sites.json'), 'utf8')
  eq (app.hosts for app in stored.apps), [[], []]
  listed = JSON.parse (cli!(APP, ['list', '--json'], env)).out
  eq (app.hosts.length for app in listed), [2, 1]
  ok not existsSync(join(site.runtime, 'agent.json')), 'offline serve.rip reads must not spawn the control plane'

test! 'rip sites distinguishes an external edge from one owned by Rip', ->
  external = fixture 'rip-agent-external-edge-'
  externalSocket = join external.root, 'janus.sock'
  janus = startJanus externalSocket, []
  externalEnv = { RIP_AGENT_HOME: external.state, RIP_AGENT_RUNTIME: external.runtime, JANUS_CONTROL: externalSocket }
  try
    status = JSON.parse((cli!(APP, ['status', 'edge', '--json'], externalEnv)).out)
    eq status.state, 'running'
    eq status.managed, false
    stopped = cli! APP, ['stop', 'edge'], externalEnv
    eq stopped.code, 1
    ok stopped.err.includes 'edge is not owned by Rip'
    wrongSurface = cli! APP, ['status', 'edge', '--caddy', FAKE_CADDY], externalEnv
    eq wrongSurface.code, 1
    ok wrongSurface.err.includes 'does not accept start options'
  finally
    stopAgent! external.runtime
    janus.stop true
    rmSync external.root, { recursive: true, force: true }

  owned = fixture 'rip-agent-owned-edge-'
  ownedEnv = { RIP_AGENT_HOME: owned.state, RIP_AGENT_RUNTIME: owned.runtime, JANUS_CONTROL: join(owned.root, 'absent.sock') }
  ownedConfig = join owned.root, 'Caddyfile'
  writeFileSync ownedConfig, ''
  chmodSync FAKE_CADDY, 0o755
  try
    started = cli! APP, ['start', 'edge', '--caddy', FAKE_CADDY, '--config', ownedConfig, '--json'], ownedEnv
    eq started.code, 0
    edge = JSON.parse started.out
    eq edge.state, 'running'
    eq edge.managed, true
    eq edge.launcher, 'direct'
    ok Number.isInteger edge.pid

    stopAgent! owned.runtime
    adopted = JSON.parse((cli!(APP, ['status', 'edge', '--json'], ownedEnv)).out)
    eq adopted.state, 'running'
    eq adopted.managed, true
    eq adopted.pid, edge.pid

    caddyPid = parseInt readFileSync(join(owned.runtime, 'caddy.pid'), 'utf8')
    process.kill caddyPid, 'SIGKILL'
    replacement = null
    deadline = Date.now() + 8000
    loop
      probe = JSON.parse((cli!(APP, ['status', 'edge', '--json'], ownedEnv)).out)
      if probe.state is 'running' and probe.pid? and probe.pid isnt edge.pid
        replacement = probe
        break
      if Date.now() >= deadline
        diagnostic = readFileSync join(owned.state, 'sites.json'), 'utf8'
        agentLog = readFileSync join(owned.state, 'agent.log'), 'utf8'
        edgeLog = readFileSync join(owned.state, 'edge.log'), 'utf8'
        throw Error.new("timed out waiting for owned edge restart: #{JSON.stringify(probe)}\n#{diagnostic}\nAGENT:\n#{agentLog}\nEDGE:\n#{edgeLog}")
      sleep! 50
    eq replacement.desired, 'running'
    eq replacement.managed, true

    reloaded = cli! APP, ['reload', 'edge', '--json'], ownedEnv
    eq reloaded.code, 0
    eq JSON.parse(reloaded.out).state, 'running'

    stopped = cli! APP, ['stop', 'edge', '--json'], ownedEnv
    eq stopped.code, 0
    waitFor! 'fake edge shutdown', -> not existsSync(join(owned.runtime, 'janus.sock'))
    final = JSON.parse((cli!(APP, ['status', 'edge', '--json'], ownedEnv)).out)
    eq final.state, 'stopped'
    eq final.managed, false
  finally
    try cli! APP, ['stop', 'edge'], ownedEnv
    stopAgent! owned.runtime
    rmSync owned.root, { recursive: true, force: true }

AGENT = join(import.meta.dir, '..', '..', 'agent.rip')

alive = (pid) ->
  try
    process.kill pid, 0
    true
  catch then false

ownerPid = (runtime) ->
  try JSON.parse(readFileSync(join(runtime, 'agent.json'), 'utf8')).pid catch then null

# The control socket path is the ownership token: a boot that finds it
# held by a live agent must lose even with the owner record gone, and an
# agent whose path was re-bound must stop before its next tick, leaving
# the successor's files alone and the world (state file, edge) untouched.
test! 'one control agent owns the socket; a superseded agent exits before acting', ->
  site = fixture 'rip-agent-superseded-'
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock') }
  config = join site.root, 'Caddyfile'
  writeFileSync config, ''
  chmodSync FAKE_CADDY, 0o755
  socket = join site.runtime, 'agent.sock'
  usurper = null
  first = null
  try
    started = cli! APP, ['start', 'edge', '--caddy', FAKE_CADDY, '--config', config, '--json'], env
    eq started.code, 0
    eq JSON.parse(started.out).managed, true
    first = ownerPid site.runtime
    ok alive(first), 'the control agent is running'

    # A second boot against a live agent loses, owner record or not.
    unlinkSync join(site.runtime, 'agent.json')
    second = run AGENT, [], env
    exited = Promise.race! [second.proc.exited, sleep(5000).then(-> null)]
    unless exited?
      second.proc.kill 'SIGKILL'
      throw Error.new 'second boot must exit instead of serving alongside a live agent'
    eq exited, 1
    err = await second.err
    ok err.includes('another Rip Agent owns'), "second boot must be refused: #{err}"
    ok alive(first), 'the live agent survives a rejected boot'
    live = JSON.parse((cli!(APP, ['status', 'edge', '--json'], env)).out)
    eq live.managed, true
    waitFor! 'owner record restored by its holder', -> ownerPid(site.runtime) is first

    # The path re-bound out from under the agent: it must go, and must not
    # take the successor's socket with it.
    unlinkSync socket
    usurper = Bun.serve { unix: socket, fetch: -> Response.json { type: 'rip-agent', api_version: '1.0', pid: process.pid } }
    waitFor! 'superseded agent exit', (-> not alive(first)), 6000
    ok existsSync(socket), 'a superseded agent must not remove the successor socket'
    answer = fetch!("http://agent/1.0", { unix: socket }).json!
    eq answer.pid, process.pid

    # The successor stops the edge; nothing revives it, nothing rewrites the state.
    caddyPid = parseInt readFileSync(join(site.runtime, 'caddy.pid'), 'utf8')
    doc = JSON.parse readFileSync(join(site.state, 'sites.json'), 'utf8')
    doc.edge = { ...doc.edge, desired: 'stopped', managed: false, pid: null }
    writeFileSync join(site.state, 'sites.json'), JSON.stringify(doc, null, 2) + '\n'
    process.kill caddyPid, 'SIGTERM'
    waitFor! 'fake edge shutdown', -> not alive(caddyPid)
    # Recovery fires after DOWN_TICKS consecutive 2 s ticks plus its restart delay.
    sleep! 7500
    ok not existsSync(join(site.runtime, 'caddy.pid')), 'no agent may revive an edge stopped by the owner'
    after = JSON.parse readFileSync(join(site.state, 'sites.json'), 'utf8')
    eq after.edge.desired, 'stopped'
    eq after.edge.managed, false
  finally
    try usurper?.stop true
    try process.kill(first, 'SIGKILL') if first? and alive(first)
    try process.kill parseInt(readFileSync(join(site.runtime, 'caddy.pid'), 'utf8')), 'SIGKILL'
    rmSync site.root, { recursive: true, force: true }

# A client's mistake is the client's error, never the agent's death: an
# add the agent cannot resolve answers 4xx and the agent keeps serving.
# Roots reach the agent absolute — the CLI resolves against ITS cwd, the
# agent has no idea where the caller stands.
test! 'an unresolvable add is refused by a live agent that stays up; relative roots resolve at the client', ->
  site = fixture 'rip-agent-bad-add-'
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock') }
  config = join site.root, 'Caddyfile'
  writeFileSync config, ''
  chmodSync FAKE_CADDY, 0o755
  mkdirSync join(site.root, 'project', 'app'), { recursive: true }
  writeFileSync join(site.root, 'project', 'app', 'index.rip'), "export default -> 'ok'\n"
  try
    started = cli! APP, ['start', 'edge', '--caddy', FAKE_CADDY, '--config', config, '--json'], env
    eq started.code, 0
    agent = ownerPid site.runtime
    ok alive(agent)

    missing = cli! APP, ['add', join(site.root, 'nowhere'), '--json'], env
    eq missing.code, 1
    ok missing.err.includes('project not found'), missing.err
    ok alive(agent), 'the agent must survive a client error'
    eq ownerPid(site.runtime), agent
    empty = cli! APP, ['add', site.root, '--json'], env
    eq empty.code, 1
    ok empty.err.includes('has no API entry'), empty.err
    ok alive(agent), 'the agent must survive a project with nothing to serve'

    added = cli! APP, ['add', 'project', '--name', 'rel', '--json'], env, site.root
    eq added.code, 0, added.err
    eq JSON.parse(added.out).root, realpathSync(join(site.root, 'project'))
    ok alive(agent)
  finally
    try cli! APP, ['stop', 'edge'], env
    stopAgent! site.runtime
    rmSync site.root, { recursive: true, force: true }

# A follower is a reader: it rides out a control-plane outage and never
# boots one — the boot it would spawn is the duplicate the socket guard
# exists to refuse, and its 5 s wait is what killed followers under a
# blocked agent.
test! 'logs -f keeps polling through a control-plane outage without booting an agent', ->
  site = fixture 'rip-agent-follow-'
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock') }
  config = join site.root, 'Caddyfile'
  writeFileSync config, ''
  chmodSync FAKE_CADDY, 0o755
  mkdirSync join(site.root, 'project', 'app'), { recursive: true }
  writeFileSync join(site.root, 'project', 'app', 'index.rip'), "export default -> 'ok'\n"
  follower = null
  try
    eq (cli!(APP, ['add', join(site.root, 'project'), '--name', 'fixture', '--json'], env)).code, 0
    started = cli! APP, ['start', 'edge', '--caddy', FAKE_CADDY, '--config', config, '--json'], env
    eq started.code, 0
    follower = run APP, ['logs', 'fixture', '-f'], env
    sleep! 1500
    ok not follower.proc.exitCode?, 'follower must be running after its first read'

    stopAgent! site.runtime
    sleep! 3000
    ok not follower.proc.exitCode?, 'follower must ride out the outage'
    ok not existsSync(join(site.runtime, 'agent.json')), 'follower must not boot a control plane'

    revived = cli! APP, ['status', 'edge', '--json'], env
    eq revived.code, 0
    sleep! 1000
    ok not follower.proc.exitCode?, 'follower must continue after the plane returns'
  finally
    try follower?.proc.kill 'SIGKILL'
    try cli! APP, ['stop', 'edge'], env
    stopAgent! site.runtime
    rmSync site.root, { recursive: true, force: true }
