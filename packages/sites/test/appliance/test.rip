import { test, eq, ok } from 'rip/testing'
import { existsSync, mkdirSync, readFileSync, realpathSync, rmSync, statSync, writeFileSync, mkdtempSync } from 'node:fs'
import { basename, join } from 'node:path'
import { tmpdir } from 'node:os'
import { SITE, SITE_NAME, ensureEdgeSite, requireExposureJanus } from '../../edge.rip'
import { defaultCatalog } from '../../catalog.rip'
import { APP, cli, fixture, startJanus, stopAgent, waitFor } from './support.rip'

# The catalog and the apps in it: the site file rip brings to Janus's
# edge, one project's whole life through `rip sites`, fan-out over the
# catalog, offline snapshots, and the agent's own status. The control
# plane's ownership, outages, and the CLI paths that never boot it live
# in test/appliance-control.

# The edge is Janus's: its process, its reach, its *.local names, and
# trust in its CA. Rip brings one site file for its own names, via.rip
# and *.via.rip, kept in Janus's sites directory as shipped: exact-host
# certs from the local CA on demand (dogfooding — we run exactly what
# users run; no packaged public certificate, no renewal treadmill), the
# janus handler, and the janus access log format. Nothing in it is
# global, nothing is rendered, and nothing varies with the mode.
test! "rip's site file joins Janus's edge as shipped", ->
  site = readFileSync SITE, 'utf8'
  eq basename(SITE), SITE_NAME
  ok site.includes('via.rip, *.via.rip {'), 'the via.rip family, one block'
  ok site.includes 'issuer internal'
  ok site.includes 'on_demand'
  ok site.includes 'format janus'
  ok not site.includes('{$'), 'no placeholders: nothing to render'
  for global in ['admin', 'default_bind', 'on_demand_tls', 'control', 'mdns', 'listen', 'import', 'skip_install_trust']
    ok not RegExp.new("^\\s*#{global}\\b", 'm').test(site), "no #{global}: site blocks only, the edge's options are Janus's"
  directives = site.split('\n').filter((line) -> not line.startsWith('#')).join '\n'
  ok not directives.includes('.local'), "the LAN names are Janus's own site"
  ok not directives.includes('trust'), 'trust is served by Janus'

  # The file lands in the sites directory Janus reports, as shipped, and
  # a second pass with nothing changed writes nothing.
  sites = mkdtempSync join(tmpdir(), 'rip-sites-edge-')
  try
    janus = { sites: join(sites, 'sites'), running: false }
    reports = []
    eq ensureEdgeSite(janus, (message) -> reports.push message; null), janus
    eq readFileSync(join(janus.sites, SITE_NAME), 'utf8'), site
    eq reports.length, 0
    written = statSync(join(janus.sites, SITE_NAME)).mtimeMs
    ensureEdgeSite janus, (message) -> reports.push message; null
    eq statSync(join(janus.sites, SITE_NAME)).mtimeMs, written
  finally
    rmSync sites, { recursive: true, force: true }

  packageRoot = join(import.meta.dir, '..', '..')
  manifest = JSON.parse(readFileSync(join(packageRoot, 'package.json'), 'utf8'))
  for file in manifest.files
    ok existsSync(join(packageRoot, file)), "packaged file exists: #{file}"
  ok not existsSync(join(packageRoot, 'tray-sites.rip')), 'Sites controls use the CLI'
  agent = readFileSync join(packageRoot, 'agent.rip'), 'utf8'
  ok not existsSync(join(import.meta.dir, '..', '..', 'status.html')), 'Janus owns the browser dashboard'
  ok not agent.includes('statusServer'), 'no separate dashboard listener'
  ok not agent.includes('registerStatus'), 'no synthetic dashboard app registration'
  ok not agent.includes("edge.mode"), "the scope is Janus's, not catalog state"
  ok not defaultCatalog().edge.mode?, "a fresh catalog records no scope"
  ok not agent.includes("'/trust"), 'the agent serves no trust route'
  ok not agent.includes('localCaTrusted'), 'trust is not rip state'
  ok not agent.includes('ca_trusted'), "trust facts are janus status's, not relayed"

  # The gate on Janus: a broken scope file is its own message, and an
  # older Janus (no bind/scope fields) is refused, never bound wide.
  reports = []
  report = (message) -> reports.push message; null
  requireExposureJanus null, report
  ok reports.pop().includes 'janus'
  requireExposureJanus { janus: '1.12.2' }, report
  ok reports.pop().includes 'janus >= 1.13.0'
  requireExposureJanus { scope: 'lan', bind: [], scope_error: 'scope.json does not parse' }, report
  ok reports.pop().includes 'scope.json does not parse'
  eq requireExposureJanus({ scope: 'lan', bind: ['0.0.0.0', '::'] }, report).scope, 'lan'
  eq reports.length, 0
  ok agent.includes 'ensureLanHosts'
  ok agent.includes 'defaultAppHosts'
  helloServe = readFileSync join(import.meta.dir, '..', '..', 'demos', 'hello', 'serve.rip'), 'utf8'
  ok helloServe.includes 'hello.via.rip'
  ok helloServe.includes 'hello.local'

test! 'rip sites remembers, supervises, observes, and removes one project', ->
  site = fixture 'rip-agent-app-'
  project = join site.root, 'project'
  mkdirSync join(project, 'app'), { recursive: true }
  writeFileSync join(project, 'app', 'index.rip'), "export default -> 'ok'\n"
  janusSocket = join site.root, 'janus.sock'
  calls = []
  janus = startJanus janusSocket, calls
  # A fast sweep bounds the idle exit waited on at the end; the grace
  # stays production's so no CLI spawn below can outlast it.
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: janusSocket, RIP_AGENT_TICK_MS: '250' }
  try
    empty = cli! APP, ['list', '--json'], env
    eq empty.code, 0
    eq JSON.parse(empty.out), []
    ok not existsSync(join(site.runtime, 'agent.json')), 'list must not spawn the control plane'

    idleStatus = cli! APP, ['status', '--json'], env
    eq idleStatus.code, 0
    idle = JSON.parse idleStatus.out
    # Fixture Janus is already listening — report it, never spawn control.
    eq idle.edge.state, 'running'
    eq idle.edge.external, true
    eq idle.edge.control, janusSocket
    ok not existsSync(join(site.runtime, 'agent.json')), 'idle status must not spawn the control plane'

    added = cli! APP, ['add', project, '--name', 'tray', '--host', 'fixture.via.rip', '--json'], env
    eq added.code, 0
    app = JSON.parse added.out
    eq app.name, 'tray'
    eq app.state, 'stopped'
    eq app.url, 'https://fixture.via.rip/'
    ok existsSync(join(site.state, 'sites.json')), 'add writes sites.json'
    ok existsSync(join(site.runtime, 'agent.json')), 'catalog mutations use the single writer'
    stopAgent! site.runtime

    # Offline list/status must await catalog snapshots — bare Promises JSON as `{}`.
    [offlineListed, offlineStatus] = Promise.all! [cli(APP, ['list', '--json'], env), cli(APP, ['status', '--json'], env)]
    offlineList = JSON.parse offlineListed.out
    eq offlineList.length, 1
    eq offlineList[0].name, 'tray'
    eq offlineList[0].root, app.root
    eq realpathSync(offlineList[0].root), realpathSync(project)
    eq offlineList[0].state, 'stopped'
    offlineSummary = JSON.parse offlineStatus.out
    eq offlineSummary.apps.length, 1
    eq offlineSummary.apps[0].name, 'tray'
    eq offlineSummary.apps[0].root, app.root
    ok not existsSync(join(site.runtime, 'agent.json')), 'offline list/status must not spawn the control plane'

    # Catalog nouns resolve like start/stop — manager is internal, not `rip site`.
    # Six refusals that never reach the control plane — no manager is
    # running, the noun is unknown, the id or flags are malformed — share
    # nothing, so they run at once; the duplicate add follows alone
    # because it boots the agent.
    [held, migrated, unknownHold, recoverShape, wrongSurface, conflictingLogs] = Promise.all! [
      cli APP, ['hold', 'tray'], env
      cli APP, ['migrate', 'tray', '--dir', 'migrations'], env
      cli APP, ['hold', 'missing-app'], env
      cli APP, ['recover', 'tray'], env
      cli APP, ['status', 'tray', '--workers', '9'], env
      cli APP, ['logs', 'tray', '--follow', '--json'], env
    ]
    eq held.code, 1
    ok not held.err.includes('project not found: tray'), 'hold must resolve catalog name to root'
    ok held.err.includes('hold failed') or held.err.includes('ECONNREFUSED') or held.err.includes('No such file') or held.err.includes('manager'), "hold reaches manager for #{project}: #{held.err}"
    eq migrated.code, 1
    ok not migrated.err.includes('migration entries'), 'migrate must not treat the app name as a migration entry'
    ok not migrated.err.includes('project not found: tray')
    eq unknownHold.code, 1
    ok unknownHold.err.includes 'unknown app'
    eq recoverShape.code, 1
    ok recoverShape.err.includes 'operation id'
    eq wrongSurface.code, 1
    ok wrongSurface.err.includes 'status does not accept add options: --workers'
    eq conflictingLogs.code, 1
    ok conflictingLogs.err.includes '--follow conflicts with --json'
    duplicate = cli! APP, ['add', project], env
    eq duplicate.code, 1
    ok duplicate.err.includes 'project is already registered'

    started = cli! APP, ['start', 'tray', '--json'], env
    eq started.code, 0
    live = JSON.parse started.out
    eq live.state, 'running'
    eq live.desired, 'running'
    ok Number.isInteger live.pid
    ok not existsSync(join(site.runtime, 'edge-status.sock')), 'no browser status socket'
    for path in ['/', '/status.json', '/v1/apps']
      response = fetch! "http://agent#{path}", { unix: join(site.runtime, 'agent.sock') }
      eq response.status, 404
    browserAction = fetch! "http://agent/apps/#{app.id}/stop", { method: 'POST', unix: join(site.runtime, 'agent.sock') }
    eq browserAction.status, 404

    [listedResult, summaryResult] = Promise.all! [cli(APP, ['list', '--json'], env), cli(APP, ['status', '--json'], env)]
    listed = JSON.parse listedResult.out
    eq listed.length, 1
    eq listed[0].pid, live.pid
    summary = JSON.parse summaryResult.out
    ok summary.edge?
    eq summary.apps.length, 1
    eq summary.apps[0].pid, live.pid
    # The edge's lifecycle is Janus's: the old edge verbs say so. Each
    # refusal is decided from the noun alone, so they run together with
    # the reserved-name add.
    edgeVerbs = ['start', 'stop', 'restart', 'status']
    refusals = Promise.all! [cli(APP, ['add', project, '--name', 'edge'], env), ...edgeVerbs.map((verb) -> cli(APP, [verb, 'edge'], env))]
    reserved = refusals[0]
    eq reserved.code, 1
    ok reserved.err.includes 'reserved'
    for verb, i in edgeVerbs
      refused = refusals[i + 1]
      eq refused.code, 1
      ok refused.err.includes("`janus #{verb}`"), refused.err

    # The manager outlives the UI/control client. A replacement agent adopts
    # the same canonical manager socket and preserves the desired state.
    stopAgent! site.runtime
    adopted = JSON.parse((cli!(APP, ['status', 'tray', '--json'], env)).out)
    eq adopted.state, 'running'
    eq adopted.desired, 'running'
    eq adopted.pid, live.pid
    # list must agree with status after control crash (revive or probe manager).
    listedAfter = JSON.parse((cli!(APP, ['list', '--json'], env)).out)
    eq listedAfter.length, 1
    eq listedAfter[0].state, 'running'
    eq listedAfter[0].pid, live.pid

    logs = cli! APP, ['logs', 'tray', '--json'], env
    eq logs.code, 0
    log = JSON.parse logs.out
    ok log.path.endsWith("#{app.id}.log")
    ok Number.isInteger log.next
    eq log.truncated, false

    blocked = cli! APP, ['remove', 'tray'], env
    eq blocked.code, 1
    ok blocked.err.includes 'is running — stop it before removal'

    stopped = cli! APP, ['stop', 'tray', '--json'], env
    eq stopped.code, 0
    eq JSON.parse(stopped.out).state, 'stopped'
    ok calls.some((call) -> call.method is 'DELETE' and call.path is '/1.0/apps/app-1')

    removed = cli! APP, ['remove', 'tray', '--json'], env
    eq removed.code, 0
    eq JSON.parse(removed.out).name, 'tray'
    eq JSON.parse((cli!(APP, ['list', '--json'], env)).out), []

    # The grace that stops a just-probed client from being reset must not
    # curdle into "never exits": with nothing left to supervise, the control
    # plane still goes away on its own. Bound covers grace + the next sweep
    # (RIP_AGENT_TICK_MS above).
    waitFor! 'idle control plane exit', (-> not existsSync(join(site.runtime, 'agent.json'))), 15000
  finally
    try
      stopped = cli! APP, ['stop', 'tray'], env
    stopAgent! site.runtime
    janus.stop true
    rmSync site.root, { recursive: true, force: true }

# `start all` fans out in catalog order. An app whose manager cannot boot
# is that app's line — its error in place, and a nonzero exit — not a
# wall the apps after it never get past. The agent already answers per
# app; the CLI used to abort on the first non-2xx reply.
test! 'start all reports a failed app in place and still starts the rest', ->
  site = fixture 'rip-agent-all-'
  broken = join site.root, 'broken'
  healthy = join site.root, 'healthy'
  for project in [broken, healthy]
    mkdirSync join(project, 'app'), { recursive: true }
    writeFileSync join(project, 'app', 'index.rip'), "export default -> 'ok'\n"
  janusSocket = join site.root, 'janus.sock'
  calls = []
  janus = startJanus janusSocket, calls
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: janusSocket }
  try
    eq (cli!(APP, ['add', broken, '--name', 'broken'], env)).code, 0
    eq (cli!(APP, ['add', healthy, '--name', 'healthy'], env)).code, 0
    # Registered clean; the manager rejects the declaration when it boots.
    writeFileSync join(broken, 'serve.rip'), "export default { hosts: ['broken.via.rip'], extra: true }\n"

    started = cli! APP, ['start', 'all', '--json'], env
    eq started.code, 1
    results = JSON.parse started.out
    eq results.map((app) -> app.name), ['broken', 'healthy']
    eq results[0].state, 'stopped'
    ok results[0].error.includes('manager exited'), results[0].error
    eq results[1].state, 'running'
    ok not results[1].error?

    text = cli! APP, ['start', 'all'], env
    eq text.code, 1
    ok text.out.includes('Error:   manager exited'), text.out
    ok text.out.includes('● healthy  running'), text.out

    stopped = cli! APP, ['stop', 'all', '--json'], env
    eq stopped.code, 0
    eq JSON.parse(stopped.out).map((app) -> app.state), ['stopped', 'stopped']
  finally
    try cli! APP, ['stop', 'all'], env
    stopAgent! site.runtime
    janus.stop true
    rmSync site.root, { recursive: true, force: true }

# serve.rip owns its app's hosts: the catalog stores [] and snapshots read
# the declaration itself. The effective hosts must never be persisted back
# into sites.json — stored hosts become manager --host flags, and a
# site-template manager refuses --host outright.
test! 'offline snapshots derive hosts from serve.rip without persisting them', ->
  site = fixture 'rip-serve-hosts-'
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock') }
  hostsProject = join site.root, 'probe'
  mkdirSync join(hostsProject, 'app'), { recursive: true }
  writeFileSync join(hostsProject, 'app', 'index.rip'), "export default -> 'ok'\n"
  writeFileSync join(hostsProject, 'serve.rip'), "export default\n  name: 'probe'\n  hosts: ['probe.via.rip', 'probe.local']\n"
  siteProject = join site.root, 'tenants'
  mkdirSync join(siteProject, 'app'), { recursive: true }
  mkdirSync join(siteProject, 'sites'), { recursive: true }
  writeFileSync join(siteProject, 'app', 'index.rip'), "export default -> 'ok'\n"
  writeFileSync join(siteProject, 'app', 'index.html'), '<!doctype html><title>t</title>\n'
  writeFileSync join(siteProject, 'serve.rip'), "export default\n  sites:\n    host: '{site}.probe.dev'\n    dir: 'sites'\n    aliases: { 'beta.probe.dev': 'ola' }\n  files:\n    roots: ['app']\n    shell: 'app/index.html'\n"
  added = JSON.parse (cli!(APP, ['add', hostsProject, '--name', 'probe', '--json'], env)).out
  eq added.hosts, ['probe.via.rip', 'probe.local']
  eq added.url, 'https://probe.via.rip/'
  tenants = JSON.parse (cli!(APP, ['add', siteProject, '--name', 'tenants', '--json'], env)).out
  eq tenants.hosts, ['beta.probe.dev']
  eq tenants.sitePattern, '{site}.probe.dev'
  eq tenants.url, 'https://beta.probe.dev/'
  stored = JSON.parse readFileSync(join(site.state, 'sites.json'), 'utf8')
  eq (app.hosts for app in stored.apps), [[], []]
  stopAgent! site.runtime
  listed = JSON.parse (cli!(APP, ['list', '--json'], env)).out
  eq (app.hosts.length for app in listed), [2, 1]
  stopAgent! site.runtime
  ok not existsSync(join(site.runtime, 'agent.json')), 'catalog writer can exit while all apps are stopped'

test! 'status agent reports liveness without starting it', ->
  site = fixture 'rip-agent-status-'
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock') }
  try
    before = cli! APP, ['status', 'agent', '--json'], env
    eq before.code, 0, before.err
    eq JSON.parse(before.out), { state: 'stopped', pid: null }
    ok not existsSync(join(site.runtime, 'agent.json'))
    started = cli! APP, ['start', 'agent', '--json'], env
    eq started.code, 0, started.err
    live = cli! APP, ['status', 'agent', '--json'], env
    eq live.code, 0, live.err
    eq JSON.parse(live.out), { state: 'running', pid: JSON.parse(started.out).pid }
  finally
    stopAgent! site.runtime
    rmSync site.root, { recursive: true, force: true }
