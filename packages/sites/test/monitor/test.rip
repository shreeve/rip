import { test, eq, ok, throws } from 'rip/testing'
import { mkdtempSync, rmSync } from 'node:fs'
import { EventEmitter } from 'node:events'
import { join } from 'node:path'
import { tmpdir } from 'node:os'
import {
  AccessClient, AccessFramer, DEFAULT_ACCESS_PICTURE, MAX_ACCESS_LINE_BYTES,
  parseAccessPicture, pumpAccessOutput,
  renderAccess, scaleAccess, validateAccessEvent, validateAccessLine,
  writeAccessOutput
} from '../../monitor.rip'

encoder = TextEncoder.new()
PRELOAD = process.execArgv.find (arg) -> arg.startsWith '--preload='
SERVER = join(import.meta.dir, '..', '..', 'manager.rip')
ENTRY = join(import.meta.dir, '..', 'hello-api', 'index.rip')

record = (changes = {}) ->
  {
    sequence: '42'
    timestamp: '2026-07-30T12:34:56.123456789Z'
    request_id: '12345678-1234-1234-1234-123456789abc'
    app_id: 'cart-abc123'
    app_name: 'cart'
    tenant_site: null
    request_host: 'cart.test'
    client_ip: '127.0.0.1'
    method: 'GET'
    path: '/api/items'
    status: 200
    duration_seconds: 0.0125
    response_bytes: '1536'
    mime_type: 'application/json; charset=utf-8'
    response_class: 'proxy'
    cache_verdict: 'bypass'
    selected_upstream: 'worker-0123456789abcdef'
    retry_count: 0
    outcome: 'complete'
    mark: 'items'
    ...changes
  }

accessLine = (changes = {}) ->
  encoder.encode "#{JSON.stringify({ v: 1, type: 'access', ...record(changes) })}\n"

helloLine = ->
  encoder.encode "#{JSON.stringify({
    v: 1, type: 'hello', app_id: 'cart-abc123', app_name: 'cart',
    after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192
  })}\n"

heartbeatLine = (head) ->
  encoder.encode "#{JSON.stringify({
    v: 1, type: 'heartbeat', app_id: 'cart-abc123', head,
    timestamp: '2026-07-30T12:34:56.123456789Z'
  })}\n"

waitFor = (fn, timeout = 8000) ->
  deadline = Date.now() + timeout
  loop
    value = fn()
    return value if value
    throw Error.new('monitor test timed out') if Date.now() >= deadline
    sleep! 5

memorySink = (writes, opts = {}) ->
  count = 0
  {
    isTTY: opts.isTTY is true
    write: (bytes, callback) ->
      count++
      value = Buffer.from bytes
      writes.push value
      writeError = opts.errorAt?(count, value)
      callback?(writeError)
      not writeError?
    once: -> null
  }

test! 'the default access picture carries every contracted derived and raw field', ->
  fields = parseAccessPicture(DEFAULT_ACCESS_PICTURE)
    .filter((part) -> part.kind is 'field')
    .map((part) -> part.field)
  eq fields, ['local_time', 'local_timezone', 'duration_seconds', 'status', 'mime_abbrev', 'response_bytes', 'method', 'path', 'mark']

test! 'pictures parse every alignment, overflow, scale composition, and bound', ->
  formats = [
    ['{method:8}', '<', 8, 'edge']
    ['{method:<8}', '<', 8, 'edge']
    ['{method:>8}', '>', 8, 'edge']
    ['{method:^8}', '^', 8, 'edge']
    ['{method:8^}', '<', 8, 'middle']
    ['{method:<8^}', '<', 8, 'middle']
    ['{method:>8^}', '>', 8, 'middle']
  ]
  for [picture, direction, width, overflow] in formats
    part = parseAccessPicture(picture)[0]
    eq [part.align.direction, part.align.width, part.align.overflow], [direction, width, overflow]
  scaled = parseAccessPicture('{response_bytes:>8@B}')[0]
  eq [scaled.align.direction, scaled.align.width, scaled.align.overflow, scaled.scaleUnit], ['>', 8, 'edge', 'B']
  middleScaled = parseAccessPicture('{response_bytes:20^@Hz}')[0]
  eq [middleScaled.align.direction, middleScaled.align.width, middleScaled.align.overflow, middleScaled.scaleUnit], ['<', 20, 'middle', 'Hz']
  eq parseAccessPicture('{duration_seconds:@s}')[0].align, null
  eq renderAccess(record(), '{{{method}}}'), '{GET}'
  throws (-> parseAccessPicture('{response_bytes:@}')), 'must not be empty'
  throws (-> parseAccessPicture('{response_bytes:@\n}')), 'unsafe scalar'
  throws (-> parseAccessPicture('{response_bytes:<1025}')), '1 through 1024'
  throws (-> parseAccessPicture('{method:^1}')), 'center width must be 3 through 1024'
  throws (-> parseAccessPicture('{method:^2}')), 'center width must be 3 through 1024'
  throws (-> parseAccessPicture('{method:^3^}')), 'center alignment cannot use trailing middle ellipsis'
  throws (-> parseAccessPicture('🙂{method:^3^}')), 'offset 10'
  throws (-> parseAccessPicture('{method:>2^^}')), "expected '}'"

test! 'exact widths pad and apply edge, center, and middle overflow', ->
  event = record(method: 'ABCDEFG')
  cases = [
    ['{method:5}', 'ABCD…']
    ['{method:<5}', 'ABCD…']
    ['{method:>5}', '…DEFG']
    ['{method:^5}', '…CDE…']
    ['{method:5^}', 'AB…FG']
    ['{method:<5^}', 'AB…FG']
    ['{method:>5^}', 'AB…FG']
  ]
  for [picture, expected] in cases
    actual = renderAccess event, picture
    eq actual, expected
    eq Bun.stringWidth(actual), 5
  short = record(method: 'ABC')
  eq renderAccess(short, '{method:6}'), 'ABC   '
  eq renderAccess(short, '{method:<6}'), 'ABC   '
  eq renderAccess(short, '{method:>6}'), '   ABC'
  eq renderAccess(short, '{method:^6}'), ' ABC  '
  eq renderAccess(short, '{method:6^}'), 'ABC   '
  eq renderAccess(short, '{method:>6^}'), '   ABC'
  expected = ['…', 'A…', 'A…G', 'AB…G', 'AB…FG', 'ABC…FG']
  for slot in [1..6]
    actual = renderAccess event, "{method:#{slot}^}"
    eq actual, expected[slot - 1]
    eq Bun.stringWidth(actual), slot

test! 'bounded Unicode rendering preserves graphemes and every requested display width', ->
  cases = [
    ['購物', '{mark:6}', '購物  ', 6]
    ['界A', '{mark:3}', '界A', 3]
    ['界A', '{mark:2}', ' …', 2]
    ['界A', '{mark:>2}', '…A', 2]
    ["e\u0301x", '{mark:2}', "e\u0301x", 2]
    ["e\u0301x", '{mark:1}', '…', 1]
    ['👩‍💻A', '{mark:3}', '👩‍💻A', 3]
    ['👩‍💻A', '{mark:2}', ' …', 2]
    ['A界BC', '{mark:4^}', 'A …C', 4]
    ['A界BC', '{mark:^4}', '…界…', 4]
  ]
  for [value, picture, expected, width] in cases
    actual = renderAccess record(mark: value), picture
    eq actual, expected
    eq Bun.stringWidth(actual), width
  ok not renderAccess(record(mark: '👩‍💻A'), '{mark:2}').includes('👩'), 'a ZWJ grapheme is never split'

  values = ['界界ABC', "e\u0301e\u0301ABC", '👩‍💻👨‍👩‍👧‍👦ABC', "\u0301ABCDEF", "A\nB界C"]
  for value in values
    event = record(mark: value)
    for slot in [1..8]
      pictures = ["{mark:#{slot}}", "{mark:<#{slot}}", "{mark:>#{slot}}", "{mark:#{slot}^}"]
      pictures.push "{mark:^#{slot}}" if slot >= 3
      for picture in pictures
        rendered = renderAccess event, picture
        eq Bun.stringWidth(rendered), slot, "#{JSON.stringify(value)} with #{picture}"
        ok not rendered.includes('……'), "#{picture} never emits adjacent ellipses"

test! 'escaped controls stay atomic under exact-width truncation', ->
  escaped = renderAccess record(mark: "A\nB"), '{mark}'
  eq escaped, 'A\\u{000A}B'
  eq Bun.stringWidth(escaped), 10
  end = renderAccess record(mark: "A\nB"), '{mark:7}'
  middle = renderAccess record(mark: "A\nB"), '{mark:9^}'
  eq end, 'A     …'
  eq middle, 'A   …   B'
  eq Bun.stringWidth(end), 7
  eq Bun.stringWidth(middle), 9
  ok not end.includes('\\u{'), 'an escaped control is omitted whole'
  ok not middle.includes('\\u{'), 'middle truncation never cuts an escaped control'

test! 'scale precedes width formatting and follows the SI-prefix oracle', ->
  event = record(response_bytes: '918')
  eq renderAccess(event, '{response_bytes:@B}'), '918 B'
  eq renderAccess(event, '{response_bytes:>8@B}'), '   918 B'
  eq renderAccess(event, '{response_bytes:>4@B}'), '…8 B'
  eq renderAccess(event, '{response_bytes:4^@B}'), '91…B'
  eq scaleAccess(0.000999, 's'), '1.0ms'
  eq scaleAccess(0.000000000001, 'Hz'), '1.0pHz'
  eq scaleAccess(999.49, 'B'), '999 B'
  eq scaleAccess(999.5, 'B'), '1.0kB'
  eq scaleAccess(Infinity, 'B'), '??? B'
  eq scaleAccess(1, ' '), '1.0  '

test! 'pretty rendering derives MIME and rejects unsafe values', ->
  event = record(path: '/x', mark: "wide界\n\u202E")
  line = renderAccess event, '{mime_abbrev:<4}|{path}|{mark:>8}'
  eq line, 'json|/x|…       '
  eq Bun.stringWidth(line.split('|').pop()), 8
  eq renderAccess(record(mime_type: 'application/vnd.microsoft.icon'), '{mime_abbrev}'), 'icon'
  eq renderAccess(record(mime_type: 'application/vnd.example'), '{mime_abbrev}'), 'vnd.example'
  eq renderAccess(record(mark: '👩‍💻'), '{mark}'), '👩‍💻'
  throws (-> renderAccess(record(status: '200'), '{status}')), 'status must be'
  throws (-> renderAccess(record(path: "\ud800"), '{path}')), 'lone surrogate'

test! 'access validation enforces every protocol field bound', ->
  bad = [
    [{ sequence: '01' }, 'sequence']
    [{ sequence: '18446744073709551616' }, 'sequence']
    [{ timestamp: '2026-02-29T00:00:00Z' }, 'timestamp']
    [{ request_id: 'not-a-uuid' }, 'request_id']
    [{ request_id: '10D21165-2701-4c37-b948-c93d891da3b1' }, 'request_id']
    [{ app_name: 'Bad', app_id: 'Bad-abc123' }, 'app_name']
    [{ app_id: 'cart-short' }, 'app_id']
    [{ app_name: 'a'.repeat(64), app_id: "#{'a'.repeat(64)}-abc123" }, 'app_name']
    [{ tenant_site: 'Bad_Site' }, 'tenant_site']
    [{ tenant_site: 'a'.repeat(64) }, 'tenant_site']
    [{ request_host: 'Bad Host' }, 'request_host']
    [{ request_host: 'UPPER.example' }, 'request_host']
    [{ client_ip: '999.1.1.1' }, 'client_ip']
    [{ method: 'GET QUERY' }, 'method']
    [{ method: '' }, 'method']
    [{ method: 'G'.repeat(33) }, 'method']
    [{ path: '/private?token=secret' }, 'path']
    [{ path: '/bad%2' }, 'path']
    [{ path: '/'.repeat(4097) }, 'path']
    [{ status: 99 }, 'status']
    [{ status: 600 }, 'status']
    [{ duration_seconds: -1 }, 'duration_seconds']
    [{ duration_seconds: Infinity }, 'duration_seconds']
    [{ response_bytes: '18446744073709551616' }, 'response_bytes']
    [{ mime_type: '' }, 'mime_type']
    [{ mime_type: ' text/html ' }, 'mime_type']
    [{ mime_type: 'x'.repeat(257) }, 'mime_type']
    [{ selected_upstream: 'worker-NOT-OPAQUE' }, 'selected_upstream']
    [{ retry_count: 1.5 }, 'retry_count']
    [{ retry_count: 4294967296 }, 'retry_count']
    [{ mark: '' }, 'mark']
    [{ mark: '界'.repeat(86) }, 'mark']
    [{ response_class: 'worker' }, 'response_class']
    [{ cache_verdict: 'warm' }, 'cache_verdict']
    [{ outcome: 'failed' }, 'outcome']
  ]
  for [change, field] in bad
    throws (-> validateAccessLine(accessLine(change))), field
  omittedWrong = { ...record(mark: 'present'), omitted_fields: ['mark'] }
  throws (-> validateAccessLine(encoder.encode("#{JSON.stringify({ v: 1, type: 'access', ...omittedWrong })}\n"))), 'must name null fields'
  name = 'a'.repeat(63)
  host = "#{'a'.repeat(63)}.#{'b'.repeat(63)}.#{'c'.repeat(63)}.#{'d'.repeat(61)}"
  validateAccessLine accessLine({
    app_name: name
    app_id: "#{name}-abc123"
    tenant_site: 's'.repeat(63)
    request_host: host
    client_ip: '2001:db8::1'
    method: 'M'.repeat(32)
    path: '/' + 'p'.repeat(4095)
    mime_type: 'm'.repeat(256)
    mark: 'k'.repeat(256)
    retry_count: 4294967295
  })

test! 'validated NDJSON accepts exactly the Janus v1.5 record shape', ->
  value = validateAccessEvent record()
  eq value.sequence, '42'
  eq value.response_bytes, '1536'
  eq value.status, 200
  eq value.duration_seconds, 0.0125

  eq validateAccessLine(accessLine()).record.method, 'GET'
  throws (-> validateAccessLine encoder.encode(JSON.stringify({ v: 1, type: 'access' }) + '\n')), 'missing, extra, duplicated, or out of order'
  throws (-> validateAccessLine encoder.encode(JSON.stringify({ v: 1, type: 'access', ...record(), surprise: true }) + '\n')), 'missing, extra, duplicated, or out of order'
  throws (-> validateAccessEvent record(sequence: 42)), 'canonical uint64 decimal'
  throws (-> validateAccessEvent record(response_bytes: '-1')), 'canonical uint64 decimal'
  throws (-> validateAccessEvent record(status: 99)), '100 through 599'
  throws (-> validateAccessEvent record(duration_seconds: -1)), 'finite nonnegative number'
  throws (-> validateAccessEvent record(timestamp: 'yesterday')), 'timestamp is malformed'
  throws (-> validateAccessEvent record(response_class: 'magic')), 'response_class is malformed'
  validateAccessEvent record(mime_type: '\u00a0text/plain\u00a0')
  throws (-> validateAccessEvent record(mime_type: ' text/plain')), 'mime_type is malformed'

test! 'picture parsing is strict and formatting owns scale, width, and Unicode', ->
  parsed = parseAccessPicture DEFAULT_ACCESS_PICTURE
  ok parsed.length > 10
  eq renderAccess(record(), '{method:>6} │ {path:<24} │ {response_bytes:@B}'), '   GET │ /api/items               │ 1.5kB'
  eq renderAccess(record(mark: '狐'), '🦊 {mark:^5}'), '🦊  狐  '
  eq renderAccess(record(mark: null), '{method} {mark}'), 'GET -'
  throws (-> parseAccessPicture('{bogus}')), 'unknown field'
  throws (-> parseAccessPicture('{method:0}')), 'width must start'
  throws (-> parseAccessPicture('{method:@ms}')), 'cannot be scaled'
  throws (-> parseAccessPicture('{method')), "expected '}'"
  throws (-> parseAccessPicture('method}')), 'unescaped'

test! 'scale keeps a fixed three-character significand and free-form units', ->
  eq scaleAccess(0, 's'), '  0 s'
  eq scaleAccess(0.0015, 's'), '1.5ms'
  eq scaleAccess(57, 'widgets'), ' 57 widgets'
  eq scaleAccess(1536, 'B'), '1.5kB'
  eq scaleAccess(NaN, ''), '??? '

test! 'framer accepts split LF records and rejects CRLF, malformed, or oversized input', ->
  lines = []
  errors = []
  framer = AccessFramer.new ((line) -> lines.push line), ((error) -> errors.push error)
  bytes = Uint8Array.new [...helloLine(), ...accessLine()]
  framer.feed bytes.slice(0, 5)
  framer.feed bytes.slice(5)
  framer.finish()
  eq lines.map((line) -> line.record.type), ['hello', 'access']
  eq errors, []

  crlf = AccessFramer.new (->), ((error) -> errors.push error)
  crlf.feed encoder.encode("#{TextDecoder.new().decode(helloLine()).trim()}\r\n")
  eq errors.length, 1
  ok errors.at(-1).message.includes 'CRLF'

  malformed = AccessFramer.new (->), ((error) -> errors.push error)
  malformed.feed Uint8Array.new [0xff, 0x0a]
  eq errors.length, 2

  oversized = AccessFramer.new (->), ((error) -> errors.push error)
  oversized.feed encoder.encode('x'.repeat(8193))
  eq errors.length, 3
  ok errors.at(-1).message.includes '8192'

  partial = AccessFramer.new (->), ((error) -> errors.push error)
  partial.feed encoder.encode('{"v":1}')
  partial.finish()
  eq errors.length, 4
  ok errors.at(-1).message.includes 'incomplete'

test! 'bounded output waits for callbacks and reports stream errors', ->
  writes = []
  output =
    write: (chunk, callback) ->
      writes.push chunk
      queueMicrotask -> callback()
      true
  writeAccessOutput! output, 'one\n'
  eq writes, ['one\n']

  broken =
    write: (_chunk, callback) ->
      error = Object.assign(Error.new('closed'), { code: 'EPIPE' })
      queueMicrotask -> callback error
      true
  failed = null
  try
    writeAccessOutput! broken, 'two\n'
  catch error
    failed = error
  eq failed.code, 'EPIPE'

test! 'access client subscribes by app id and preserves raw NDJSON bytes', ->
  source = null
  requested = null
  stdout =
    chunks: []
    write: (chunk, callback) ->
      @chunks.push chunk
      callback()
      true
  stderr =
    write: (_chunk, callback) ->
      callback()
      true
  client = AccessClient.new {
    mode: 'raw'
    control: { unix: '/tmp/janus.sock' }
    stdout
    stderr
    fetch: (url, options) ->
      requested = { url, options }
      body = ReadableStream.new
        start: (controller) ->
          source = controller
          controller.enqueue helloLine()
          options.signal.addEventListener 'abort', -> controller.close()
      Response.new body, { status: 200 }
  }
  task = client.move 'cart-abc123'
  waitFor! -> stdout.chunks.length > 0
  eq requested.url, 'http://janus/1.0/apps/cart-abc123/access?after=0'
  eq requested.options.unix, '/tmp/janus.sock'
  eq TextDecoder.new().decode(stdout.chunks[0]), TextDecoder.new().decode(helloLine())
  client.stop!
  await task

test! 'pretty client validates records and renders only access events', ->
  stdout =
    text: ''
    write: (chunk, callback) ->
      @text += chunk
      callback()
      true
  fetches = 0
  pretty = AccessClient.new {
    mode: 'pretty'
    picture: '{method} {path}'
    stdout
    control: { base: 'http://janus' }
    fetch: (_url, options) ->
      fetches++
      body = ReadableStream.new
        start: (controller) ->
          controller.enqueue Uint8Array.new [...helloLine(), ...accessLine(sequence: '1')]
          options.signal.addEventListener 'abort', -> controller.close()
      Response.new body
  }
  task = pretty.move 'cart-abc123'
  waitFor! -> stdout.text.length > 0
  eq stdout.text, "GET /api/items\n"
  pretty.stop!
  await task
  eq fetches, 1

test! 'stream heads never regress below an observed high-water mark', ->
  stderr =
    text: ''
    write: (chunk, callback) ->
      @text += chunk
      callback()
      true
  fetches = 0
  client = AccessClient.new {
    mode: 'pretty'
    picture: '{method}'
    stderr
    control: { base: 'http://janus' }
    sleep: -> null
    fetch: (_url, options) ->
      fetches++
      body = ReadableStream.new
        start: (controller) ->
          if fetches is 1
            controller.enqueue Uint8Array.new [...helloLine(), ...heartbeatLine('2'), ...heartbeatLine('1')]
            controller.close()
          else
            options.signal.addEventListener 'abort', -> controller.close()
      Response.new body
  }
  task = client.move 'cart-abc123'
  waitFor! -> stderr.text.includes 'heartbeat head regressed'
  client.stop!
  await task

test! 'the framer bounds retained and copied bytes for an attacker-sized chunk', ->
  lines = []
  errors = []
  attackBytes = 16 * 1024 * 1024
  hello = helloLine()
  chunk = Uint8Array.new(hello.length + attackBytes)
  chunk.set hello
  chunk.fill 120, hello.length
  Bun.gc true
  memoryBefore = process.memoryUsage().arrayBuffers
  peakGrowth = 0
  framer = AccessFramer.new ((line) -> lines.push(line.record.type)), ((error) ->
    peakGrowth = process.memoryUsage().arrayBuffers - memoryBefore
    errors.push error.message
  )
  framer.feed chunk
  Bun.gc true
  retainedGrowth = process.memoryUsage().arrayBuffers - memoryBefore
  eq lines, ['hello']
  ok errors.some((message) -> message.includes('before LF'))
  ok framer.buffer.length <= MAX_ACCESS_LINE_BYTES, "retained bytes stay bounded: #{framer.buffer.length}"
  ok peakGrowth < attackBytes / 2, "framing does not copy the attacker chunk: peak growth=#{peakGrowth}"
  ok retainedGrowth < attackBytes / 2, "framing does not retain the attacker chunk: growth=#{retainedGrowth}"

test! 'registration generations abort and move exactly one live subscription', ->
  seen = []
  sink = memorySink []
  fetcher = (url, options) ->
    appId = decodeURIComponent(URL.new(url).pathname.split('/')[3])
    seen.push appId
    appName = appId.slice(0, appId.lastIndexOf('-'))
    body = ReadableStream.new
      start: (controller) ->
        controller.enqueue encoder.encode("#{JSON.stringify({
          v: 1, type: 'hello', app_id: appId, app_name: appName,
          after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192
        })}\n")
        options.signal.addEventListener 'abort', (-> controller.close()), { once: true }
    Response.new body
  client = AccessClient.new { mode: 'pretty', control: { base: 'http://janus' }, stdout: sink, stderr: sink, fetch: fetcher, sample: -> 0 }
  client.move 'generation-aaaaaa'
  waitFor! -> seen.includes('generation-aaaaaa')
  client.move 'generation-bbbbbb'
  waitFor! -> seen.includes('generation-bbbbbb')
  client.stop!
  eq seen.filter((id) -> id is 'generation-aaaaaa').length, 1
  eq seen.filter((id) -> id is 'generation-bbbbbb').length, 1

test! 'a blocked old output completes before a replacement generation starts', ->
  writes = []
  callbacks = []
  active = 0
  maxActive = 0
  sink =
    write: (bytes, callback) ->
      active++
      maxActive = Math.max(maxActive, active)
      writes.push JSON.parse(Buffer.from(bytes).toString()).app_id
      callbacks.push (error = null) ->
        active--
        callback error
      true
    once: -> null
  calls = []
  fetcher = (url, options) ->
    appId = decodeURIComponent(URL.new(url).pathname.split('/')[3])
    calls.push appId
    appName = appId.slice(0, appId.lastIndexOf('-'))
    Response.new(ReadableStream.new
      start: (controller) ->
        controller.enqueue encoder.encode("#{JSON.stringify({
          v: 1, type: 'hello', app_id: appId, app_name: appName,
          after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192
        })}\n")
        options.signal.addEventListener 'abort', (-> controller.close()), { once: true }
    )
  client = AccessClient.new { mode: 'raw', control: { base: 'http://janus' }, stdout: sink, stderr: memorySink([]), fetch: fetcher }
  client.move 'old-aaaaaa'
  waitFor! -> writes.length is 1
  replacement = client.move 'new-bbbbbb'
  sleep! 20
  eq calls, ['old-aaaaaa']
  eq writes, ['old-aaaaaa']
  callbacks.shift()()
  waitFor! -> writes.length is 2
  eq calls, ['old-aaaaaa', 'new-bbbbbb']
  eq maxActive, 1
  callbacks.shift()()
  client.stop!
  await replacement

test! 'an aborted old generation keeps its blocked terminal output failure', ->
  callback = null
  sink =
    write: (_bytes, done) ->
      callback = done
      true
    once: -> null
  calls = []
  fetcher = (url, options) ->
    appId = decodeURIComponent(URL.new(url).pathname.split('/')[3])
    calls.push appId
    appName = appId.slice(0, appId.lastIndexOf('-'))
    Response.new(ReadableStream.new
      start: (controller) ->
        controller.enqueue encoder.encode("#{JSON.stringify({
          v: 1, type: 'hello', app_id: appId, app_name: appName,
          after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192
        })}\n")
        options.signal.addEventListener 'abort', (-> controller.close()), { once: true }
    )
  client = AccessClient.new { mode: 'raw', control: { base: 'http://janus' }, stdout: sink, stderr: memorySink([]), fetch: fetcher }
  client.move 'old-aaaaaa'
  waitFor! -> callback?
  replacement = client.move 'new-bbbbbb'
  failure = Object.assign(Error.new('old output failed'), { code: 'EPIPE' })
  callback failure
  caught = null
  try
    await replacement
  catch error
    caught = error
  ok caught?.accessOutput, 'the old terminal output failure propagates through the generation cut'
  eq calls, ['old-aaaaaa']

test! 'a stale generation resolving after move cannot write or reconnect', ->
  output = []
  oldGate: any = {}
  oldGate.promise = Promise.new (resolve) -> oldGate.open = resolve
  calls = []
  fetcher = (url, options) ->
    appId = decodeURIComponent(URL.new(url).pathname.split('/')[3])
    calls.push appId
    return oldGate.promise if appId is 'old-aaaaaa'
    body = ReadableStream.new
      start: (controller) ->
        controller.enqueue encoder.encode("#{JSON.stringify({
          v: 1, type: 'hello', app_id: 'new-bbbbbb', app_name: 'new',
          after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192
        })}\n")
        options.signal.addEventListener 'abort', (-> controller.close()), { once: true }
    Response.new body
  client = AccessClient.new { mode: 'raw', control: { base: 'http://janus' }, stdout: memorySink(output), stderr: memorySink([]), fetch: fetcher, sample: -> 0 }
  client.move 'old-aaaaaa'
  waitFor! -> calls.includes('old-aaaaaa')
  client.move 'new-bbbbbb'
  sleep! 20
  eq calls, ['old-aaaaaa']
  oldGate.open Response.new(ReadableStream.new({ start: (controller) ->
    controller.enqueue encoder.encode("#{JSON.stringify({
      v: 1, type: 'hello', app_id: 'old-aaaaaa', app_name: 'old',
      after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192
    })}\n")
    controller.enqueue accessLine(app_id: 'old-aaaaaa', app_name: 'old', sequence: '1')
    controller.close()
  }))
  waitFor! -> calls.includes('new-bbbbbb') and output.length is 1
  client.stop!
  text = Buffer.concat(output).toString()
  ok text.includes('new-bbbbbb')
  ok not text.includes('old-aaaaaa')
  eq calls.filter((id) -> id is 'old-aaaaaa').length, 1

test! 'valid records before malformed input in one chunk are consumed first', ->
  stdout = []
  stderr = []
  calls = 0
  hello = helloLine()
  event = accessLine(sequence: '1')
  malformed = encoder.encode('{}\n')
  fetcher = (_url, options) ->
    calls++
    if calls is 1
      bytes = Uint8Array.new(hello.length + event.length + malformed.length)
      bytes.set hello
      bytes.set event, hello.length
      bytes.set malformed, hello.length + event.length
      return Response.new(ReadableStream.new({ start: (controller) -> controller.enqueue(bytes); controller.close() }))
    Promise.new (_resolve, reject) ->
      options.signal.addEventListener 'abort', (-> reject(options.signal.reason)), { once: true }
  client = AccessClient.new
    mode: 'raw'
    control: { base: 'http://janus' }
    stdout: memorySink(stdout)
    stderr: memorySink(stderr)
    fetch: fetcher
    sample: -> 0
  client.move 'cart-abc123'
  waitFor! -> calls >= 2
  client.stop!
  eq Buffer.concat(stdout), Buffer.concat([Buffer.from(hello), Buffer.from(event)])
  ok Buffer.concat(stderr).toString().includes('reconnecting')

test! 'no_replay is exactly one immediate required post-hello transition', ->
  runCase = (records) ->
    stdout = []
    stderr = []
    calls = 0
    fetcher = (_url, options) ->
      calls++
      if calls is 1
        return Response.new(ReadableStream.new({ start: (controller) ->
          controller.enqueue encoder.encode("#{JSON.stringify(item)}\n") for item in records
          controller.close()
        }))
      Promise.new (_resolve, reject) ->
        options.signal.addEventListener 'abort', (-> reject(options.signal.reason)), { once: true }
    client = AccessClient.new { mode: 'raw', control: { base: 'http://janus' }, stdout: memorySink(stdout), stderr: memorySink(stderr), fetch: fetcher, sample: -> 0 }
    client.move 'cart-abc123'
    waitFor! -> calls >= 2
    client.stop!
    { stdout: Buffer.concat(stdout).toString(), stderr: Buffer.concat(stderr).toString() }
  hello0 = { v: 1, type: 'hello', app_id: 'cart-abc123', app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 }
  heartbeat0 = { v: 1, type: 'heartbeat', app_id: 'cart-abc123', head: '0', timestamp: '2026-08-01T14:16:15Z' }
  lateGap = { v: 1, type: 'gap', app_id: 'cart-abc123', from: '1', through: '1', head: '1', reason: 'no_replay' }
  late = runCase! [hello0, heartbeat0, lateGap]
  ok late.stderr.includes('only legal immediately after hello')
  ok not late.stdout.includes('"type":"gap"')
  hello2 = { ...hello0, head: '2' }
  initial = { v: 1, type: 'gap', app_id: 'cart-abc123', from: '1', through: '2', head: '2', reason: 'no_replay' }
  second = { v: 1, type: 'gap', app_id: 'cart-abc123', from: '3', through: '3', head: '3', reason: 'no_replay' }
  duplicate = runCase! [hello2, initial, second]
  ok duplicate.stderr.includes('only legal immediately after hello')
  eq duplicate.stdout.match(/"reason":"no_replay"/g)?.length, 1

test! 'overflow gaps advance the cursor with diagnostic-before-raw ordering', ->
  events = []
  calls = 0
  sink = (kind) ->
    write: (bytes, callback) ->
      events.push "#{kind}:#{Buffer.from(bytes).toString()}"
      callback()
      true
    once: -> null
  records = [
    { v: 1, type: 'hello', app_id: 'cart-abc123', app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 }
    { v: 1, type: 'access', ...record(sequence: '1') }
    { v: 1, type: 'gap', app_id: 'cart-abc123', from: '2', through: '4', head: '5', reason: 'overflow' }
    { v: 1, type: 'access', ...record(sequence: '5') }
    { v: 1, type: 'access', ...record(sequence: '7') }
  ]
  fetcher = (_url, options) ->
    calls++
    if calls is 1
      return Response.new(ReadableStream.new({ start: (controller) ->
        controller.enqueue encoder.encode("#{JSON.stringify(item)}\n") for item in records
        controller.close()
      }))
    Promise.new (_resolve, reject) ->
      options.signal.addEventListener 'abort', (-> reject(options.signal.reason)), { once: true }
  client = AccessClient.new { mode: 'raw', control: { base: 'http://janus' }, stdout: sink('out'), stderr: sink('err'), fetch: fetcher, sample: -> 0 }
  client.move 'cart-abc123'
  waitFor! -> calls >= 2
  client.stop!
  gapDiagnostic = events.findIndex((event) -> event.includes('access gap 2..4'))
  gapRaw = events.findIndex((event) -> event.startsWith('out:') and event.includes('"type":"gap"'))
  ok 0 <= gapDiagnostic < gapRaw, 'gap diagnostic completes before exact raw gap output'
  ok events.some((event) -> event.startsWith('out:') and event.includes('"sequence":"5"'))
  ok not events.some((event) -> event.startsWith('out:') and event.includes('"sequence":"7"'))

test! 'closed is consumed and reconnects without waiting for peer EOF', ->
  stdout = []
  calls = 0
  canceled = false
  fetcher = (_url, options) ->
    calls++
    if calls is 1
      return Response.new(ReadableStream.new
        start: (controller) ->
          controller.enqueue helloLine()
          controller.enqueue encoder.encode("#{JSON.stringify({
            v: 1, type: 'closed', app_id: 'cart-abc123', head: '0',
            timestamp: '2026-08-01T14:16:20Z', reason: 'generation_stop'
          })}\n")
        cancel: -> canceled = true
      )
    Promise.new (_resolve, reject) ->
      options.signal.addEventListener 'abort', (-> reject(options.signal.reason)), { once: true }
  client = AccessClient.new { mode: 'raw', control: { base: 'http://janus' }, stdout: memorySink(stdout), stderr: memorySink([]), fetch: fetcher, sample: -> 0 }
  client.move 'cart-abc123'
  waitFor! -> calls >= 2
  client.stop!
  ok canceled, 'the still-open first body was canceled'
  ok Buffer.concat(stdout).toString().includes('"type":"closed"')

test! 'backoff doubles with full jitter and resets only after a valid hello', ->
  delays = []
  calls = 0
  fetcher = (_url, options) ->
    calls++
    if calls is 2
      body = ReadableStream.new({ start: (controller) ->
        controller.enqueue encoder.encode("#{JSON.stringify({
          v: 1, type: 'hello', app_id: 'other-aaaaaa', app_name: 'other',
          after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192
        })}\n")
        controller.close()
      })
      return Response.new body
    return Response.new('no', { status: 500 }) if calls <= 8
    if calls is 9
      body = ReadableStream.new({ start: (controller) ->
        controller.enqueue helloLine()
        controller.close()
      })
      return Response.new body
    Promise.new (_resolve, reject) ->
      options.signal.addEventListener 'abort', (-> reject(options.signal.reason)), { once: true }
  sleep = (ms, _signal) -> delays.push ms
  client = AccessClient.new { mode: 'pretty', control: { base: 'http://janus' }, stdout: memorySink([]), stderr: memorySink([]), fetch: fetcher, sample: -> 0.5, sleep }
  client.move 'cart-abc123'
  waitFor! -> delays.length is 9
  client.stop!
  eq delays, [50, 100, 200, 400, 800, 1600, 2500, 2500, 50]

test! 'raw partial EPIPE is terminal and never reconnects', ->
  calls = 0
  writes = []
  broken = memorySink writes,
    errorAt: (count, bytes) ->
      return null unless count is 2
      writes[writes.length - 1] = bytes.subarray(0, Math.floor(bytes.length / 2))
      Object.assign(Error.new('broken pipe'), { code: 'EPIPE' })
  fetcher = ->
    calls++
    Response.new(ReadableStream.new({ start: (controller) ->
      controller.enqueue helloLine()
      controller.enqueue accessLine(sequence: '1')
      controller.close()
    }))
  client = AccessClient.new { mode: 'raw', control: { base: 'http://janus' }, stdout: broken, stderr: memorySink([]), fetch: fetcher, sample: -> 0 }
  caught = null
  try
    client.move!('cart-abc123')
  catch error
    caught = error
  ok caught?.accessOutput, 'partial stdout failure is terminal output'
  eq calls, 1

test! 'pretty ANSI wraps the complete picture only on color TTYs', ->
  event = { v: 1, type: 'access', ...record(sequence: '1') }
  line = { record: event, bytes: accessLine(sequence: '1') }
  prior = process.env.NO_COLOR
  try
    delete process.env.NO_COLOR
    color = []
    client = AccessClient.new { mode: 'pretty', picture: '{method:>5}', stdout: memorySink(color, { isTTY: true }), stderr: memorySink([]), control: {} }
    client.consume!(line)
    eq Buffer.concat(color).toString(), '\x1b[36m  GET\x1b[0m\n'
    mono = []
    client = AccessClient.new { mode: 'pretty', picture: '{method:>5}', stdout: memorySink(mono), stderr: memorySink([]), control: {} }
    client.consume!(line)
    eq Buffer.concat(mono).toString(), '  GET\n'
    process.env.NO_COLOR = '1'
    noColor = []
    client = AccessClient.new { mode: 'pretty', picture: '{method}', stdout: memorySink(noColor, { isTTY: true }), stderr: memorySink([]), control: {} }
    client.consume!(line)
    eq Buffer.concat(noColor).toString(), 'GET\n'
  finally
    if prior? then process.env.NO_COLOR = prior else delete process.env.NO_COLOR

test! 'output pumping drains high volume under destination backpressure', ->
  chunks = 256
  bytes = 8192
  readable = ReadableStream.new
    start: (controller) ->
      controller.enqueue Uint8Array.new(bytes).fill(i % 251) for i in [0...chunks]
      controller.close()
  total = 0
  destination =
    write: (chunk, callback) ->
      setTimeout (->
        total += chunk.length
        callback()
      ), 0
      false
    once: -> null
  pumpAccessOutput! readable, destination
  eq total, chunks * bytes

test! 'backpressured output removes every temporary error listener', ->
  sink = EventEmitter.new()
  sink.write = (_chunk, callback) ->
    queueMicrotask -> callback()
    false
  for _i in [0...1000]
    writeAccessOutput! sink, 'x'
    eq sink.listenerCount('error'), 0

test! 'foreground flags reject invalid modes and pictures before startup', ->
  invalidMode = Bun.spawnSync [process.execPath, PRELOAD, SERVER, ENTRY, '--control', '/tmp/missing-janus.sock', '--access-log=loud']
  eq invalidMode.exitCode, 1
  ok invalidMode.stderr.toString().includes '--access-log must be pretty, raw, or off'

  invalidPicture = Bun.spawnSync [process.execPath, PRELOAD, SERVER, ENTRY, '--control', '/tmp/missing-janus.sock', '--access-format', '{bogus}']
  eq invalidPicture.exitCode, 1
  ok invalidPicture.stderr.toString().includes 'unknown field'

  rawPicture = Bun.spawnSync [process.execPath, PRELOAD, SERVER, ENTRY, '--control', '/tmp/missing-janus.sock', '--access-log=raw', '--access-format', '{method}']
  eq rawPicture.exitCode, 1
  ok rawPicture.stderr.toString().includes 'only applies with --access-log=pretty'

test! 'foreground raw stdout is pure NDJSON and off opens no subscription', ->
  run = (mode) ->
    dir = mkdtempSync join(tmpdir(), 'rip-monitor-mode-')
    socket = join dir, 'janus.sock'
    registered = false
    accessCount = 0
    accessSource = null
    control = Bun.serve
      unix: socket
      fetch: (request) ->
        url = URL.new request.url
        if request.method is 'POST' and url.pathname is '/1.0/apps'
          registered = true
          return Response.json({ id: 'cart-abc123' }, { status: 201 })
        if request.method is 'GET' and url.pathname is '/1.0/apps/cart-abc123/access'
          accessCount++
          body = ReadableStream.new
            start: (controller) ->
              accessSource = controller
              controller.enqueue Uint8Array.new [...helloLine(), ...accessLine(sequence: '1')]
          return Response.new body
        if request.method is 'POST' and url.pathname is '/1.0/apps/cart-abc123/heartbeat'
          return Response.new(null, { status: 204 })
        if request.method is 'DELETE' and url.pathname is '/1.0/apps/cart-abc123'
          try accessSource?.close()
          return Response.new(null, { status: 204 })
        Response.new('Not Found', { status: 404 })
    proc = null
    try
      proc = Bun.spawn [process.execPath, PRELOAD, SERVER, ENTRY, '--name', 'cart', '--host', 'cart.test', '--control', socket, "--access-log=#{mode}"],
        stdin: 'ignore'
        stdout: 'pipe'
        stderr: 'pipe'
      output = Response.new(proc.stdout).text()
      diagnostic = Response.new(proc.stderr).text()
      if mode is 'raw'
        waitFor! -> accessCount is 1
        sleep! 25
      else
        waitFor! -> registered
        sleep! 25
      signal = if mode is 'off' then 'SIGINT' else 'SIGTERM'
      proc.kill signal
      code = await proc.exited
      diagnosticText = await diagnostic
      eq code, (if signal is 'SIGINT' then 130 else 143), diagnosticText
      { output: await output, diagnostic: diagnosticText, accessCount }
    finally
      try proc?.kill('SIGKILL')
      await proc.exited if proc?
      control.stop true
      rmSync dir, { recursive: true, force: true }

  raw = run! 'raw'
  eq raw.output, TextDecoder.new().decode(Uint8Array.new([...helloLine(), ...accessLine(sequence: '1')]))
  eq raw.accessCount, 1
  ok raw.diagnostic.includes 'rip-site: https://cart.test/'

  disabled = run! 'off'
  eq disabled.accessCount, 0
  ok disabled.output.includes 'rip-site: https://cart.test/'
