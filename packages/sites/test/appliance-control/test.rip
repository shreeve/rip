import { test, eq, ok } from 'rip/testing'
import { appendFileSync, existsSync, mkdirSync, readFileSync, realpathSync, rmSync, unlinkSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import { dashboardUrl } from '../../edge.rip'
import { managerRuntime } from '../../control.rip'
import { AGENT, APP, MANAGER, PRELOAD, alive, cli, fixture, ownerPid, run, startJanus, stopAgent, streamText, waitFor } from '../appliance/support.rip'

# The control plane as a process: who owns its socket, what survives its
# outage, one writer under concurrent clients, and the CLI surfaces that
# must answer without ever booting it (dashboard discovery, path
# controls, the public manager grammar). The catalog's own lifecycle is
# test/appliance.

# The control socket path is the ownership token: a boot that finds it
# held by a live agent must lose even with the owner record gone, and an
# agent whose path was re-bound must stop before its next tick, leaving
# the successor's files alone and the world (state file, edge) untouched.
test! 'one control agent owns the socket; a superseded agent exits before acting', ->
  site = fixture 'rip-agent-superseded-'
  project = join site.root, 'project'
  mkdirSync join(project, 'app'), { recursive: true }
  writeFileSync join(project, 'app', 'index.rip'), "export default -> 'ok'\n"
  janusSocket = join site.root, 'janus.sock'
  janus = startJanus janusSocket, []
  # The superseded check rides the reconcile tick: inject it so "before
  # its next tick" is a bound the test controls.
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: janusSocket, RIP_AGENT_TICK_MS: '250' }
  socket = join site.runtime, 'agent.sock'
  usurper = null
  first = null
  try
    eq (cli!(APP, ['add', project, '--name', 'fixture'], env)).code, 0
    started = cli! APP, ['start', 'fixture', '--json'], env
    eq started.code, 0, started.err
    eq JSON.parse(started.out).state, 'running'
    first = ownerPid site.runtime
    ok alive(first), 'the control agent is running'

    # A second boot against a live agent loses, owner record or not.
    unlinkSync join(site.runtime, 'agent.json')
    second = run AGENT, [], env
    exited = Promise.race! [second.proc.exited, sleep(5000).then(-> null)]
    unless exited?
      second.proc.kill 'SIGKILL'
      throw Error.new 'second boot must exit instead of serving alongside a live agent'
    eq exited, 1
    err = await second.err
    ok err.includes('another Rip Agent owns'), "second boot must be refused: #{err}"
    ok alive(first), 'the live agent survives a rejected boot'
    live = JSON.parse((cli!(APP, ['status', 'fixture', '--json'], env)).out)
    eq live.state, 'running'
    waitFor! 'owner record restored by its holder', -> ownerPid(site.runtime) is first

    # The path re-bound out from under the agent: it must go, and must not
    # take the successor's socket with it.
    unlinkSync socket
    usurper = Bun.serve { unix: socket, fetch: -> Response.json { type: 'rip-agent', api_version: '1.0', pid: process.pid } }
    waitFor! 'superseded agent exit', (-> not alive(first)), 6000
    ok existsSync(socket), 'a superseded agent must not remove the successor socket'
    answer = fetch!("http://agent/1.0", { unix: socket }).json!
    eq answer.pid, process.pid

    # The successor owns the world: the superseded agent rewrote nothing.
    after = JSON.parse readFileSync(join(site.state, 'sites.json'), 'utf8')
    eq after.apps[0].desired, 'running'
  finally
    try usurper?.stop true
    try process.kill(first, 'SIGKILL') if first? and alive(first)
    try cli! APP, ['stop', 'fixture'], env
    stopAgent! site.runtime
    janus.stop true
    rmSync site.root, { recursive: true, force: true }

# A client's mistake is the client's error, never the agent's death: an
# add the agent cannot resolve answers 4xx and the agent keeps serving.
# Roots reach the agent absolute — the CLI resolves against ITS cwd, the
# agent has no idea where the caller stands.
test! 'an unresolvable add is refused by a live agent that stays up; relative roots resolve at the client', ->
  site = fixture 'rip-agent-bad-add-'
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock') }
  mkdirSync join(site.root, 'project', 'app'), { recursive: true }
  writeFileSync join(site.root, 'project', 'app', 'index.rip'), "export default -> 'ok'\n"
  try
    booted = cli! APP, ['start', 'agent', '--json'], env
    eq booted.code, 0, booted.err
    agent = ownerPid site.runtime
    ok alive(agent)

    missing = cli! APP, ['add', join(site.root, 'nowhere'), '--json'], env
    eq missing.code, 1
    ok missing.err.includes('project not found'), missing.err
    ok alive(agent), 'the agent must survive a client error'
    eq ownerPid(site.runtime), agent
    empty = cli! APP, ['add', site.root, '--json'], env
    eq empty.code, 1
    ok empty.err.includes('has no API entry'), empty.err
    ok alive(agent), 'the agent must survive a project with nothing to serve'

    added = cli! APP, ['add', 'project', '--name', 'rel', '--json'], env, site.root
    eq added.code, 0, added.err
    eq JSON.parse(added.out).root, realpathSync(join(site.root, 'project'))
    ok alive(agent)
  finally
    stopAgent! site.runtime
    rmSync site.root, { recursive: true, force: true }

# A follower is a reader: it rides out a control-plane outage and never
# boots one — the boot it would spawn is the duplicate the socket guard
# exists to refuse, and its 5 s wait is what killed followers under a
# blocked agent. Each phase is proven by a line the follower PRINTS: one
# it read at start, one appended while the plane is down, one after the
# plane returns — not by the process merely being alive after a nap.
test! 'logs -f keeps polling through a control-plane outage without booting an agent', ->
  site = fixture 'rip-agent-follow-'
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock') }
  mkdirSync join(site.root, 'project', 'app'), { recursive: true }
  writeFileSync join(site.root, 'project', 'app', 'index.rip'), "export default -> 'ok'\n"
  follower = null
  printed = null
  try
    eq (cli!(APP, ['add', join(site.root, 'project'), '--name', 'fixture', '--json'], env)).code, 0
    booted = cli! APP, ['start', 'agent', '--json'], env
    eq booted.code, 0, booted.err
    catalog = JSON.parse readFileSync(join(site.state, 'sites.json'), 'utf8')
    logPath = join(site.state, 'apps', catalog.apps[0].id + '.log')
    writeFileSync logPath, 'first line\n'
    # Spawned by hand: `run` reads stdout to EOF, and the follower's
    # stdout must be read as it arrives.
    follower = Bun.spawn [process.execPath, PRELOAD, APP, 'logs', 'fixture', '-f'],
      stdin: 'ignore'
      stdout: 'pipe'
      stderr: 'inherit'
      env: { ...process.env, ...env }
    printed = streamText follower.stdout
    waitFor! 'the follower to print its first read', (-> printed.text.includes 'first line'), 15000
    ok not follower.exitCode?, 'follower must be running after its first read'

    stopAgent! site.runtime
    appendFileSync logPath, 'durable log line\n'
    offline = cli! APP, ['logs', 'fixture', '--json'], env
    eq offline.code, 0, offline.err
    eq JSON.parse(offline.out).text, 'first line\ndurable log line\n'
    all = cli! APP, ['logs', 'all', '--json'], env
    eq all.code, 0, all.err
    records = JSON.parse all.out
    eq records.length, 1
    eq records[0].id, catalog.apps[0].id
    eq records[0].text, 'first line\ndurable log line\n'
    waitFor! 'the follower to print through the outage', -> printed.text.includes 'durable log line'
    ok not follower.exitCode?, 'follower must ride out the outage'
    ok not existsSync(join(site.runtime, 'agent.json')), 'follower must not boot a control plane'

    revived = cli! APP, ['start', 'agent', '--json'], env
    eq revived.code, 0
    appendFileSync logPath, 'after the plane returned\n'
    waitFor! 'the follower to print after the plane returned', -> printed.text.includes 'after the plane returned'
    ok not follower.exitCode?, 'follower must continue after the plane returns'
  finally
    try follower?.kill 'SIGKILL'
    await printed.done if printed?
    stopAgent! site.runtime
    rmSync site.root, { recursive: true, force: true }

# The CLI uses Janus's advertised front door; no agent or dashboard
# registration is needed to discover it.
test! 'dashboard discovery consumes Janus URLs without reconstructing them', ->
  mdns = { enabled: true, dashboard_url: 'http://edge-2.local:8080/' }
  requests = []
  server = Bun.serve
    port: 0
    fetch: (request) ->
      requests.push URL.new(request.url).pathname
      Response.json mdns
  edge = { state: 'running', external: true, control: "http://127.0.0.1:#{server.port}/custom/" }
  try
    eq dashboardUrl!(edge), mdns.dashboard_url
    eq requests.at(-1), '/custom/1.0/mdns'
    for url in ['http://[::1]:7680/', 'https://edge.example/']
      mdns.dashboard_url = url
      eq dashboardUrl!(edge), url
    for bad in ['', 'javascript:alert(1)', 'https://user:password@edge.example/']
      mdns.dashboard_url = bad
      eq dashboardUrl!(edge), null
    mdns.dashboard_url = 'http://edge.local/'
    mdns.enabled = false
    eq dashboardUrl!(edge), null
    edge.external = false
    edge.dashboardUrl = 'https://local-status.example/'
    before = requests.length
    eq dashboardUrl!(edge), edge.dashboardUrl
    eq requests.length, before
    edge.state = 'stopped'
    eq dashboardUrl!(edge), null
  finally
    server.stop true

test! 'dashboard discovery uses the Unix control socket without booting an agent', ->
  site = fixture 'rip-dashboard-unix-'
  socket = join site.runtime, 'janus.sock'
  paths = []
  janus = Bun.serve
    unix: socket
    fetch: (request) ->
      paths.push URL.new(request.url).pathname
      Response.json { enabled: true, dashboard_url: 'http://127.0.0.1:7680/' }
  try
    eq dashboardUrl!({ state: 'running', scope: 'localhost', control: socket }), 'http://127.0.0.1:7680/'
    eq paths, ['/1.0/mdns']
    ok not existsSync(join(site.runtime, 'agent.json'))
  finally
    janus.stop true
    rmSync site.root, { recursive: true, force: true }

test! 'path status and stop reach an uncataloged manager', ->
  site = fixture 'rip-path-controls-'
  project = join site.root, 'project'
  mkdirSync project
  writeFileSync join(project, 'index.rip'), '# project\n'
  socket = managerRuntime(realpathSync(project)).socket
  requests = []
  manager = null
  manager = Bun.serve
    unix: socket
    fetch: (request) ->
      path = URL.new(request.url).pathname
      requests.push [request.method, path]
      if request.method is 'POST' and path is '/stop'
        setTimeout (-> manager.stop true), 50
      Response.json { fixture: true, ready: true }
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock') }
  try
    status = cli! APP, ['status', project], env
    eq status.code, 0, status.err
    eq JSON.parse(status.out).fixture, true
    stopped = cli! APP, ['stop', '.'], env, project
    eq stopped.code, 0, stopped.err
    ok requests.some((row) -> row[0] is 'POST' and row[1] is '/stop')
    ok not existsSync(join(site.runtime, 'agent.json'))
  finally
    manager.stop true
    rmSync site.root, { recursive: true, force: true }

test! 'path controls report a missing manager instead of crashing', ->
  site = fixture 'rip-path-absent-'
  project = join site.root, 'project'
  mkdirSync project
  writeFileSync join(project, 'index.rip'), '# project\n'
  root = realpathSync project
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock') }
  try
    # Every answer here is "no manager" and nothing gets created, so the
    # probes run together.
    absent = [['status', project], ['stop', project]]
    needing = [['hold', project], ['release', project], ['migrate'], ['recover', '0123456789abcdef0123456789abcdef']]
    results = Promise.all! [...absent.map((args) -> cli(APP, args, env)), ...needing.map((args) -> cli(MANAGER, args, env, project))]
    for args, i in absent
      result = results[i]
      eq result.code, 0, result.err
      eq result.out, "No manager is running for #{root}.\n"
      eq result.err, ''
    for args, i in needing
      result = results[absent.length + i]
      eq result.code, 1, args[0]
      eq result.out, ''
      eq result.err, "rip-sites: #{args[0]} needs a running manager for #{root}\n"
    # A socket file with no listener behind it is the same answer.
    writeFileSync managerRuntime(root).socket, ''
    [stale, refused] = Promise.all! [cli(APP, ['status', project], env), cli(MANAGER, ['hold', project], env, project)]
    eq stale.code, 0, stale.err
    eq stale.out, "No manager is running for #{root}.\n"
    eq refused.code, 1
    eq refused.err, "rip-sites: hold needs a running manager for #{root}\n"
  finally
    rmSync site.root, { recursive: true, force: true }

test! 'public manager grammar preserves option values and cwd defaults', ->
  site = fixture 'rip-public-manager-'
  project = join site.root, 'project'
  mkdirSync project
  socket = join site.root, 'janus.sock'
  calls = []
  janus = startJanus socket, calls
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: socket }
  try
    # A process-lease publish registers and exits; help never leaves the
    # parser. Neither depends on the other, so all four run together.
    publishes = [
      ['publish', '--host', 'review.local', project, '--until-restart']
      ['publish', '--host', 'review.local', '--until-restart']
    ]
    verbs = ['run', 'publish']
    results = Promise.all! [...publishes.map((args) -> cli(APP, args, env, project)), ...verbs.map((verb) -> cli(APP, [verb, '--help'], env))]
    for args, i in publishes
      published = results[i]
      eq published.code, 0, published.err
      ok published.out.includes 'https://review.local/'
    for verb, i in verbs
      help = results[publishes.length + i]
      eq help.code, 0, help.err
      ok help.out.includes 'rip sites run'
      ok help.out.includes 'rip sites publish'
      ok not help.out.includes 'rip site '
  finally
    janus.stop true
    rmSync site.root, { recursive: true, force: true }

test! 'concurrent catalog changes have one writer and preserve every successful add', ->
  site = fixture 'rip-catalog-concurrency-'
  # A fast sweep bounds the idle exit waited on at the end. The grace
  # stays production's: 24 clients spawning at once take longer than a
  # short grace to reach the agent, and one that probed a live socket
  # just before an idle exit fails its request (seen: 'Was there a typo
  # in the url or port?' from a remove).
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: join(site.root, 'absent.sock'), RIP_AGENT_TICK_MS: '250' }
  try
    projects = (join(site.root, "project-#{i}") for i in [0...24])
    for project in projects
      mkdirSync project
      writeFileSync join(project, 'index.rip'), '# project\n'
    results = Promise.all! projects.map (project) -> cli! APP, ['add', project, '--json'], env
    for result in results
      eq result.code, 0, result.err
    state = JSON.parse readFileSync(join(site.state, 'sites.json'), 'utf8')
    eq state.apps.length, projects.length
    eq Set.new(state.apps.map((app) -> app.root)).size, projects.length
    eq Set.new(state.apps.map((app) -> app.id)).size, projects.length
    removed = Promise.all! state.apps.map (app) -> cli! APP, ['remove', app.id, '--json'], env
    for result in removed
      eq result.code, 0, result.err
    eq JSON.parse(readFileSync(join(site.state, 'sites.json'), 'utf8')).apps, []
    waitFor! 'idle catalog writer exit', (-> not existsSync(join(site.runtime, 'agent.json'))), 15000
  finally
    stopAgent! site.runtime
    rmSync site.root, { recursive: true, force: true }
