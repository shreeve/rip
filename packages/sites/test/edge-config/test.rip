import { test, eq, ok } from 'rip/testing'
import { existsSync, mkdtempSync, mkdirSync, rmSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import { tmpdir } from 'node:os'
import * as seam from 'rip/sites/edge'

test 'public package surface exposes the documented edge seam', ->
  expected = [
    'JANUS_MISSING', 'JANUS_STOPPED', 'configureEdge',
    'dashboardUrl', 'edgeControl', 'edgeFetch', 'edgeScope',
    'externalEdge', 'janusBinary', 'janusStatus', 'requireExposureJanus',
    'snapshotEdgeState', 'snapshotEnvironment',
  ]
  eq Object.keys(seam).sort(), expected

test! 'foreground publish checks the edge and registers, bringing it no file', ->
  dir = mkdtempSync join(tmpdir(), 'rip-foreground-edge-')
  socket = join dir, 'control.sock'
  requests = []
  server = Bun.serve
    unix: socket
    fetch: (request) ->
      requests.push URL.new(request.url).pathname
      return Response.json({ type: 'janus' }) if request.method is 'GET'
      Response.json { id: 'fixture' }, { status: 201 }
  try
    bin = join dir, 'bin'
    mkdirSync bin
    writeFileSync join(bin, 'janus'), '''
    #!/bin/sh
    case "$1" in
      status) printf '%s\n' "$RIP_TEST_JANUS_STATUS" ;;
      reload) printf x >> "$RIP_TEST_RELOAD_CALLS" ;;
      *) exit 1 ;;
    esac
    ''', { mode: 0o755 }
    preload = process.execArgv.find (arg) -> arg.startsWith '--preload='
    env = { ...process.env, PATH: bin + ':' + process.env.PATH, RIP_TEST_RELOAD_CALLS: join(dir, 'calls'), RIP_TEST_JANUS_STATUS: JSON.stringify({ sites: join(dir, 'sites'), socket, running: true, scope: 'localhost', bind: ['127.0.0.1'] }) }
    delete env.JANUS_CONTROL
    cli = join(import.meta.dir, '..', '..', 'sites.rip')
    for argv in [['run', '--help'], ['publish', dir, '--host', 'fixture.localhost', '--until-restart']]
      child = Bun.spawn [process.execPath, preload, cli, ...argv], { env, stdout: 'pipe', stderr: 'pipe' }
      stdout = Response.new(child.stdout).text()
      stderr = Response.new(child.stderr).text()
      eq await child.exited, 0, (await stdout) + (await stderr)
    eq requests, ['/1.0', '/1.0/apps']
    ok not existsSync(join(dir, 'calls')), 'the edge is never reloaded'
    ok not existsSync(join(dir, 'sites')), "nothing is written into Janus's sites directory"
  finally
    server.stop true
    rmSync dir, { recursive: true, force: true }
