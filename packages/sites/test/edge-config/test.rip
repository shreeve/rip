import { test, eq, ok } from 'rip/testing'
import { existsSync, mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import { tmpdir } from 'node:os'
import { SITE, SITE_NAME } from '../../edge.rip'

test! 'failed edge reload restores the file and the next attempt retries', ->
  dir = mkdtempSync join(tmpdir(), 'rip-edge-retry-')
  try
    bin = join dir, 'bin'
    mkdirSync bin
    writeFileSync join(bin, 'janus'), '''
    #!/bin/sh
    if [ ! -e "$RIP_TEST_RELOAD_CALLS" ]; then
      printf x > "$RIP_TEST_RELOAD_CALLS"
      echo 'fixture rejection' >&2
      exit 1
    fi
    printf x >> "$RIP_TEST_RELOAD_CALLS"
    exit 0
    ''', { mode: 0o755 }
    source = join dir, 'probe.rip'
    edge = join(import.meta.dir, '..', '..', 'edge.rip')
    writeFileSync source, """
    import { ensureEdgeSite, SITE, SITE_NAME } from #{JSON.stringify(edge)}
    import { existsSync, mkdirSync, readFileSync, unlinkSync, writeFileSync } from 'node:fs'
    import { join } from 'node:path'
    import { eq, ok } from 'rip/testing'
    sites = join(import.meta.dir, 'sites')
    mkdirSync sites
    target = join(sites, SITE_NAME)
    for previous in [null, '# previous config\\n']
      unlinkSync process.env.RIP_TEST_RELOAD_CALLS if existsSync process.env.RIP_TEST_RELOAD_CALLS
      if previous? then writeFileSync(target, previous) else if existsSync(target) then unlinkSync(target)
      janus = { sites, running: true }
      failures = []
      eq ensureEdgeSite(janus, (message) -> failures.push(message); null), null
      eq failures.length, 1
      ok failures[0].includes 'fixture rejection'
      eq (if existsSync(target) then readFileSync(target, 'utf8') else null), previous
      eq ensureEdgeSite(janus), janus
      eq readFileSync(target, 'utf8'), readFileSync(SITE, 'utf8')
      eq readFileSync(process.env.RIP_TEST_RELOAD_CALLS, 'utf8'), 'xx'
    """
    preload = process.execArgv.find (arg) -> arg.startsWith '--preload='
    child = Bun.spawn [process.execPath, preload, source],
      stdout: 'pipe'
      stderr: 'pipe'
      env: { ...process.env, PATH: bin + ':' + process.env.PATH, RIP_TEST_RELOAD_CALLS: join(dir, 'calls') }
    stdout = Response.new(child.stdout).text()
    stderr = Response.new(child.stderr).text()
    eq await child.exited, 0, (await stdout) + (await stderr)
  finally
    rmSync dir, { recursive: true, force: true }

test! 'foreground publish installs the service site before registering', ->
  dir = mkdtempSync join(tmpdir(), 'rip-foreground-edge-')
  socket = join dir, 'control.sock'
  target = join(dir, 'sites', SITE_NAME)
  requests = []
  server = Bun.serve
    unix: socket
    fetch: (request) ->
      requests.push URL.new(request.url).pathname
      return Response.json({ type: 'janus' }) if request.method is 'GET'
      eq readFileSync(target, 'utf8'), readFileSync(SITE, 'utf8')
      Response.json { id: 'fixture' }, { status: 201 }
  try
    bin = join dir, 'bin'
    mkdirSync bin
    writeFileSync join(bin, 'janus'), '''
    #!/bin/sh
    case "$1" in
      status) printf '%s\n' "$RIP_TEST_JANUS_STATUS" ;;
      reload) printf x >> "$RIP_TEST_RELOAD_CALLS" ;;
      *) exit 1 ;;
    esac
    ''', { mode: 0o755 }
    preload = process.execArgv.find (arg) -> arg.startsWith '--preload='
    env = { ...process.env, PATH: bin + ':' + process.env.PATH, RIP_TEST_RELOAD_CALLS: join(dir, 'calls'), RIP_TEST_JANUS_STATUS: JSON.stringify({ sites: join(dir, 'sites'), socket, running: true, scope: 'localhost', bind: ['127.0.0.1'] }) }
    delete env.JANUS_CONTROL
    cli = join(import.meta.dir, '..', '..', 'sites.rip')
    for argv in [['run', '--help'], ['publish', dir, '--host', 'fixture.via.rip', '--until-restart']]
      child = Bun.spawn [process.execPath, preload, cli, ...argv], { env, stdout: 'pipe', stderr: 'pipe' }
      stdout = Response.new(child.stdout).text()
      stderr = Response.new(child.stderr).text()
      eq await child.exited, 0, (await stdout) + (await stderr)
      ok not existsSync(target) if argv[0] is 'run'
    eq requests, ['/1.0', '/1.0/apps']
    eq readFileSync(join(dir, 'calls'), 'utf8'), 'x'
  finally
    server.stop true
    rmSync dir, { recursive: true, force: true }
