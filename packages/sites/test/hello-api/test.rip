import { test, eq, ok } from '@rip-lang/testing'
import { copyFileSync, existsSync, mkdirSync, readFileSync, mkdtempSync, rmSync } from 'node:fs'
import { join } from 'node:path'
import { tmpdir } from 'node:os'

PRELOAD = process.execArgv.find (arg) -> arg.startsWith '--preload='
GENERATOR = join(import.meta.dir, '..', '..', 'generate.rip')
WORKER = join(import.meta.dir, '..', '..', 'worker.rip')
SERVER = join(import.meta.dir, '..', '..', 'site.rip')

generate = (entry, artifact, result, task) ->
  proc = Bun.spawn [process.execPath, PRELOAD, GENERATOR, entry, artifact, result, task, '0'],
    stdin: 'ignore'
    stdout: 'ignore'
    stderr: 'pipe'
  stderrText = Response.new(proc.stderr).text()
  code = await proc.exited
  diagnostic = await stderrText
  eq code, 0, diagnostic
  JSON.parse readFileSync(result, 'utf8')

waitFor = (fn, timeout = 5000) ->
  deadline = Date.now() + timeout
  loop
    value = fn!
    return value if value
    throw Error.new('hello API test timed out') if Date.now() >= deadline
    Promise.new! (resolve) -> setTimeout resolve, 10

unixFetch = (url, socket) ->
  options = { unix: socket }
  fetch url, options

test! 'generation builds and reports one stable loader-free artifact', ->
  dir = mkdtempSync join(tmpdir(), 'rip-hello-api-')
  entry = join(import.meta.dir, 'entry.rip')
  artifact = join(dir, 'app.js')
  result = join(dir, 'result.json')
  ok PRELOAD?, 'hello API test requires the Rip loader'
  try
    report = generate! entry, artifact, result, 'g1'
    eq report.taskId, 'g1'
    eq report.sourceEpoch, 0
    eq report.artifact, artifact
    ok report.inputs.includes(entry)
    ok not ('inputDigest' of report)
    built = import!(artifact)
    eq built.answer, 42
    eq built.directory, import.meta.dir
  finally
    rmSync dir, { recursive: true, force: true }

test! 'artifact-only worker becomes ready, serves, and drains', ->
  dir = mkdtempSync join(tmpdir(), 'rip-hello-worker-')
  appArtifact = join dir, 'app.js'
  workerArtifact = join dir, 'worker.js'
  socket = join dir, 'worker.sock'
  proc = null
  try
    generate! join(import.meta.dir, 'index.rip'), appArtifact, join(dir, 'app-result.json'), 'app'
    generate! WORKER, workerArtifact, join(dir, 'worker-result.json'), 'worker'
    proc = Bun.spawn [process.execPath, workerArtifact],
      stdin: 'ignore'
      stdout: 'ignore'
      stderr: 'inherit'
      env: { ...process.env, APP_ARTIFACT: appArtifact, SOCKET_PATH: socket, WORKER_ID: 'hello' }
    ready = waitFor! ->
      try
        response = unixFetch! 'http://worker/ready', socket
        response.status is 200
      catch then false
    ok ready
    response = unixFetch! 'http://worker/hello', socket
    eq response.status, 200
    eq (response.json!), { message: 'hello' }
    proc.kill 'SIGTERM'
    eq (await proc.exited), 0
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    rmSync dir, { recursive: true, force: true }

test! 'foreground manager registers one ready worker and deregisters before exit', ->
  dir = mkdtempSync join(import.meta.dir, '.rip-hello-manager-')
  project = join dir, 'project'
  mkdirSync project
  entry = join project, 'app.rip'
  copyFileSync join(import.meta.dir, 'index.rip'), entry
  controlSocket = join dir, 'janus.sock'
  registration = null
  deleted = false
  accessConnected = false
  accessSource = null
  accessRecord = (record) -> "#{JSON.stringify(record)}\n"
  control = Bun.serve
    unix: controlSocket
    fetch: (request) ->
      url = URL.new request.url
      if request.method is 'POST' and url.pathname is '/1.0/apps'
        registration = request.json!
        return Response.json({ id: 'hello-abc123' }, { status: 201 })
      if request.method is 'GET' and url.pathname is '/1.0/apps/hello-abc123/access'
        accessConnected = true
        body = ReadableStream.new
          start: (controller) ->
            accessSource = controller
            controller.enqueue TextEncoder.new().encode accessRecord {
              v: 1, type: 'hello', app_id: 'hello-abc123', app_name: 'hello',
              after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192
            }
            controller.enqueue TextEncoder.new().encode accessRecord {
              v: 1, type: 'access', sequence: '1', timestamp: '2026-08-01T12:00:00Z',
              request_id: '12345678-1234-1234-1234-123456789abc',
              app_id: 'hello-abc123', app_name: 'hello', tenant_site: null,
              request_host: 'hello.test', client_ip: '127.0.0.1', method: 'GET',
              path: '/hello', status: 200, duration_seconds: 0.001,
              response_bytes: '19', mime_type: 'application/json',
              response_class: 'proxy', cache_verdict: 'bypass',
              selected_upstream: null, retry_count: 0, outcome: 'complete', mark: null
            }
        return Response.new body
      if request.method is 'POST' and url.pathname is '/1.0/apps/hello-abc123/heartbeat'
        return Response.new(null, { status: 204 })
      if request.method is 'DELETE' and url.pathname is '/1.0/apps/hello-abc123'
        deleted = true
        try accessSource?.close()
        return Response.new(null, { status: 204 })
      Response.new('Not Found', { status: 404 })
  edge = Bun.serve
    port: 0
    fetch: (request) ->
      return Response.new('unregistered', { status: 503 }) unless registration?
      url = URL.new request.url
      unixFetch "http://worker#{url.pathname}", registration.upstreams[0].path
  proc = null
  try
    proc = Bun.spawn [process.execPath, PRELOAD, SERVER, entry, '--name', 'hello', '--host', 'hello.test', '--control', controlSocket, '--workers', '1', '--no-watch'],
      stdin: 'ignore'
      stdout: 'pipe'
      stderr: 'pipe'
    output = Response.new(proc.stdout).text()
    diagnostic = Response.new(proc.stderr).text()
    sleep! 100
    throw Error.new(await diagnostic) if proc.exitCode?
    try
      waitFor! -> registration?
    catch error
      throw Error.new "registration: #{error.message}"
    try
      waitFor! -> accessConnected
    catch error
      throw Error.new "access: #{error.message}"
    eq registration.name, 'hello'
    eq registration.hosts, ['hello.test']
    eq registration.upstreams.length, 1
    ok not ('files' of registration), 'API-only registration must leave Janus file routing disabled'
    ok not existsSync(join(project, 'dist')), 'API-only startup must not manufacture a dist root'
    response = fetch! "http://127.0.0.1:#{edge.port}/hello"
    eq response.status, 200
    eq (response.json!), { message: 'hello' }
    proc.kill 'SIGTERM'
    eq (await proc.exited), 143, await diagnostic
    ok (await output).includes('GET /hello'), 'foreground manager must print pretty access output'
    ok deleted, 'manager must deregister before foreground exit'
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    edge.stop true
    control.stop true
    rmSync dir, { recursive: true, force: true }
