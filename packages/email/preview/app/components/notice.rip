export Notice = component
  @title: string
  @body: string
  @dark: boolean
  render
    section class: "flex min-h-0 min-w-0 p-8 #{if dark then 'bg-neutral-400' else 'bg-neutral-200'}"
      div class: "m-auto flex w-200 max-w-full flex-col gap-y-1 rounded-lg px-4.5 py-4 shadow-lg #{if dark then 'bg-neutral-900' else 'bg-white'}"
        div class: "text-sm-plus font-semibold #{if dark then 'text-neutral-100' else 'text-neutral-900'}", title
        div class: "text-sm #{if dark then 'text-neutral-400' else 'text-neutral-600'}", body

export NoTemplates = component
  @dark: boolean
  render
    Notice
      title: 'No templates found'
      body: 'Save a .rip file that exports a component into the templates directory and it appears here.'
      dark: dark
