#!/usr/bin/env rip
# ==============================================================================
# rip/db — DuckDB over duckdb-harbor: client tier, boot probe,
# MCP stdio server, and the rip-db operational CLI in one file.
#
# Library: connect (global default), module-level sql/find*/transaction,
# harborAdapter, createClient, assertReachable, …
# CLI (import.meta.main): rip-db dump | load | checkpoint | mcp
# ==============================================================================

{ readFileSync } = import!('node:fs')
VERSION = JSON.parse(readFileSync("#{import.meta.dir}/package.json", 'utf-8')).version

# Soft doorbell to the schema ORM — never hard-import the runtime so
# this package can load outside the monorepo. `connect` publishes the
# adapter on `globalThis.__ripDbAdapter` and calls
# `__ripSchema.__schemaSetAdapter` when orm is already loaded;
# orm picks up `__ripDbAdapter` if models load later.
wireSchemaAdapter = (adapter) ->
  return unless typeof globalThis isnt 'undefined'
  globalThis.__ripDbAdapter = adapter
  set = globalThis.__ripSchema?.__schemaSetAdapter
  set adapter if typeof set is 'function'

# ==[ Adapter ]===============================================================

# The duckdb-harbor client lives in the core runtime, because BOTH tiers
# need it: this package and `schema :model`. It used to live here, and
# the ORM carried a hand-made copy — which drifted until it dialled the
# wrong port, discarded DuckDB's error text, could not read NDJSON, and
# knew nothing of timeouts or cancellation. One implementation now, and
# this is where it is imported rather than where it is written.
#
# The error classes are re-exported rather than redefined: a caller's
# `instanceof QueryError` and the ORM's must name the same class.
#
# Imported under their own names — most are used below — then re-exported
# as a block. `export {…} from` would be shorter but binds nothing locally,
# and five of these are thrown or called in this file.
import {
  harborAdapter
  resolveUrl
  envToken
  DbError
  ConnectionError
  QueryError
  CancelledError
  isDbError
} from '../../src/runtime/duckdb.js'

# `encodeParams` is deliberately not among them: it is harbor's wire
# encoder, internal to the transport, and not part of this package's
# surface. ROOT_EXPORTS in test.rip pins that. `envToken` is imported
# for the MCP entry's missing-credential warning and stays private for
# the same reason.
export {
  harborAdapter
  resolveUrl
  DbError
  ConnectionError
  QueryError
  CancelledError
  isDbError
}

# ==[ Client ]================================================================

# The query client — parameterized execution, result materialization,
# the transaction runner, and cancellation, layered over any adapter.
# The adapter owns the wire (query/begin); the client owns result
# ownership: it materializes the adapter's `{ columns, data }` into row
# objects, projects them (rows/one/value), and runs a callback inside a
# transaction that commits on return and rolls back on throw.
#
# Cancellation is a race PLUS a real abort: an AbortSignal that fires
# before or during a query rejects the caller's promise with a
# CancelledError at once, and the same signal is threaded down to the
# adapter so an in-flight harbor request is actually aborted rather
# than left to finish on its own.

fail = (message) ->
  throw Error.new(if String(message).startsWith('db:') then message else "db: #{message}")

# snake_case → camelCase for one column name — the package's single
# camelizer, behind the opt-in `camel` projection below. A faithful
# local twin of the runtime's `camelCase` (src/runtime/vocab.js) —
# the same one-line transform, kept byte-identical so the two tiers can
# never disagree on a spelling; local because this package imports only
# the substrate, never the schema runtime. Deliberately not total: only
# `_` followed by a lowercase letter folds, so
#   nickname_2      → nickname_2       (digit after `_`: unchanged)
#   _internal       → Internal         (a leading `_` folds too)
#   legacy_ISO_CODE → legacy_ISO_CODE  (ALL-CAPS segments: unchanged)
camelName = (name) ->
  String(name).replace /_([a-z])/g, (m, c) -> c.toUpperCase()

# The adapter's `{ columns, data }` → row objects. Each adapter column
# is a `{ name, type }` object (harbor's shape), so a row array keys by
# `column.name`; the materialized result reports the column names. A
# duplicate name keeps the last value, matching the engine's projection.
# `camel` — opt-in, never automatic; the default result is untouched —
# runs the names through `camelName` before keying, so row keys and the
# reported `columns` cannot disagree.
materialize = (result, camel = false) ->
  names = (result?.columns ?? []).map (column) -> column.name
  names = names.map((name) -> camelName name) if camel
  data = result?.data ?? []
  rows = for row in data
    obj = {}
    obj[names[i]] = value for value, i in row
    obj
  { rows, columns: names, rowCount: result?.rowCount ?? rows.length }

# Race a query against an abort signal. An already-aborted signal
# rejects before dispatch; an abort mid-flight rejects the caller with
# a CancelledError immediately — the adapter, handed the same signal,
# aborts the wire request in parallel (its own typed rejection loses
# the race and is absorbed here).
raceAbort = (signal, run) ->
  return run() unless signal?
  if signal.aborted
    return Promise.reject(CancelledError.new 'db: query cancelled before dispatch')
  Promise.new (resolve, reject) ->
    onAbort = -> reject(CancelledError.new 'db: query cancelled')
    signal.addEventListener 'abort', onAbort, { once: true }
    settle = (fn) ->
      (value) ->
        signal.removeEventListener 'abort', onAbort
        fn value
    run().then settle(resolve), settle(reject)
    return

# Positional params are always an array (or absent), so a plain object
# in the params slot is unambiguously the two-argument call and shifts
# into opts. Objects in BOTH slots are one malformed call — loud, never
# merged. Anything else in the params slot passes through untouched.
isPlainObject = (v) ->
  return false unless v? and typeof v is 'object'
  proto = Object.getPrototypeOf v
  proto is Object.prototype or proto is null

# One executor over a `run(sql, params, signal) → Promise<rawResult>` —
# the top-level client binds it to adapter.query, a transaction binds it
# to the session's query, and both get identical materialization and
# projection. The caller's signal rides along so the adapter can abort
# the underlying request. `opts.camel` opts the result into the
# snake_case → camelCase key projection (see `camelName`); `defaults`
# carries the client-level opts a `connect`/`createClient` established,
# and a per-call opt always wins over its default.
makeSurface = (run, beginTx, defaults = {}) ->
  sql = (text, params = null, opts = {}) ->
    if isPlainObject params
      fail 'db: options were given in both the params slot and the opts slot — params must be an array of positional values' if Object.keys(opts).length
      opts = params
      params = null
    raw = raceAbort! opts.signal, -> run(text, params, opts.signal)
    materialize raw, opts.camel ?? defaults.camel ?? false
  rows = (text, params = null, opts = {}) ->
    (sql!(text, params, opts)).rows
  one = (text, params = null, opts = {}) ->
    (sql!(text, params, opts)).rows[0] ?? null
  value = (text, params = null, opts = {}) ->
    row = (sql!(text, params, opts)).rows[0]
    if row? then (Object.values(row)[0] ?? null) else null
  values = (text, params = null, opts = {}) ->
    row = (sql!(text, params, opts)).rows[0]
    if row? then Object.values(row) else null
  { sql, rows, one, value, values, transaction: beginTx }

# ── Retrying a transaction ───────────────────────────────────────────
#
# DuckDB resolves write conflicts optimistically: two transactions
# touching the same row do not queue, the second is refused the moment
# it writes. Postgres would have made it wait, so code carrying those
# instincts meets an error where it expected a pause — and the correct
# response is almost always the same one, which is to run the whole
# thing again on a fresh snapshot. That is the standard answer for
# optimistic concurrency, and it is what this does.
#
# The contract it asks for is real and worth stating: **the callback may
# run more than once**, so it must be safe to repeat. Database work
# qualifies by construction — the failed attempt rolled back. Anything
# with an effect outside the database does not: a callback that charges
# a card or sends mail between two writes must pass `{ retries: 0 }` and
# handle conflicts itself. Retrying is the default because the common
# case is pure DB work and silently failing it is worse; visible in the
# options because the exception is real.
#
# Also retried: a transaction refused for want of a connection, and one
# whose lease expired mid-flight. Both mean "this never happened, try
# again", which is exactly what a conflict means.
# Contention costs rounds, not milliseconds: DuckDB lets exactly one
# writer win a contested row per round, so N transactions racing for it
# need about N attempts before the last one lands. Five retries covers
# the six-way case, which is well past what an application usually does
# to a single row; heavier contention should raise `retries` rather than
# discover this by losing writes. The backoff doubles from 40ms so the
# losers of one round do not re-collide on the next.
DEFAULT_TX_RETRIES =! 5
TX_RETRY_BASE_MS =! 40
TX_RETRY_CAP_MS =! 2_000

RETRYABLE_CODES =! ['no_lease_available', 'no_such_session']
CONFLICT_SHAPE = /\bconflict\b/i

sleep = (ms) ->
  Promise.new (resolve) ->
    setTimeout resolve, ms
    return

# Would running this again plausibly succeed? Only for failures that left
# nothing behind — never for a bad statement, which will fail identically
# however many times it is sent.
export def isRetryable(error)
  return false unless error?
  return true if RETRYABLE_CODES.includes error.code
  error instanceof QueryError and CONFLICT_SHAPE.test(String(error.message ?? ''))

export def createClient(adapter, defaults = {})
  fail 'createClient requires an adapter with a query() method' unless typeof adapter?.query is 'function'

  # A transaction: begin a session, hand the callback a surface bound
  # to that session — whose own transaction() JOINS this one (no
  # savepoints), so a nested call reuses the session rather than
  # opening a second — commit on return, roll back on any throw.
  # Run the callback against an open session, committing on return and
  # rolling back on a throw. `settle` reports the landed outcome to
  # whoever else is enrolled in this transaction (the schema ORM), so
  # its commit-time hooks never fire ahead of the COMMIT they describe.
  runTx = (fn, tx, settle) ->
    joined = null
    join = (inner) -> inner joined
    joined = makeSurface(((sql, params, signal) -> tx.query sql, params, { signal }), join, defaults)
    result = null
    try
      result = fn! joined
    catch error
      # Roll back for the callback's failure, and never let a rollback
      # error mask the real one the caller needs to see.
      try
        tx.rollback!
      catch
        null
      settle! 'afterRollback'
      throw error
    # Commit runs OUTSIDE the try: a failed COMMIT propagates on its
    # own — it must not trigger a rollback against a session the
    # adapter already dropped.
    tx.commit!
    settle! 'afterCommit'
    result

  # A schema-model statement routes through the ORM's own ambient
  # transaction store, which knows nothing about a session opened here.
  # Left alone, a model write inside this block would run autocommit on
  # another connection and survive this transaction's rollback — so
  # hand the ORM our open handle for the duration.
  noSettle = -> undefined

  attempt = (fn) ->
    tx = adapter.begin!
    adopt = globalThis.__ripSchema?.adoptTransaction
    if typeof adopt is 'function'
      adopt! adapter, tx, (settle) -> runTx fn, tx, settle
    else
      runTx fn, tx, noSettle

  transaction = (fn, opts = {}) ->
    fail 'this adapter does not support transactions' unless typeof adapter.begin is 'function'
    retries = opts.retries ?? DEFAULT_TX_RETRIES
    for attemptNo in [0..retries]
      try
        return attempt! fn
      catch error
        throw error unless attemptNo < retries and isRetryable error
        # Full jitter. Two callbacks that collided will otherwise collide
        # again on the same schedule, which is the one thing a retry must
        # not reproduce.
        # The server's number when it gave one, our own backoff otherwise.
        # Full jitter on ours: two callbacks that collided will otherwise
        # collide again on the same schedule, which is the one thing a retry
        # must not reproduce.
        wait = if error.retryAfterMs?
          error.retryAfterMs
        else
          Math.floor(Math.random() * Math.min(TX_RETRY_CAP_MS, TX_RETRY_BASE_MS * 2 ** attemptNo))
        sleep! wait
    return

  # A statement issued outside any transaction of ours still belongs
  # inside one the schema ORM opened: its handle is ambient for this
  # adapter, and going straight to the adapter would run autocommit on
  # a different connection and survive that transaction's rollback.
  run = (sql, params, signal) ->
    handle = globalThis.__ripSchema?.txHandle?(adapter)
    if handle? then handle.query sql, params, { signal }
    else adapter.query sql, params, { signal }

  makeSurface(run, transaction, defaults)

# ==[ Module default — connect / sql ]======================================
#
# One process-wide default adapter+client. `connect(...)` installs (and
# rewires) it; module-level `sql` / `findOne` / `findAll` /
# `transaction` read it on every call. Omit `connect` and the first
# module-level call lazy-installs from RIP_DB_URL / RIP_DB_TOKEN. Power
# users still build `harborAdapter` + `createClient` by hand; schema
# `:model` shares the default via the soft doorbell above.

_default = null

installDefault = (adapter, client) ->
  client.adapter = adapter
  _default = { adapter, client }
  wireSchemaAdapter adapter
  client

defaultPair = ->
  return _default if _default?
  connect()
  _default

# Install (or rewire) the process default. Accepts `connect()`,
# `connect(url)`, or `connect({ url, token, fetch, timeoutMs, adapter,
# camel })`. Pass `adapter` to skip harbor (tests / custom wires);
# `camel: true` makes the camelCase key projection this client's
# default (a per-call `camel:` still wins). Returns the client;
# `.adapter` is the same handle the schema ORM uses.
#
#   import { connect, sql, findOne, ensureRunning } from 'rip/db'
#   ensureRunning!
#   connect! camel: true                  # or connect! 'http://…'
#   findOne! 'SELECT * FROM users WHERE id = ?', [1]
export def connect(urlOrOpts = null, opts = {})
  o = if urlOrOpts? and typeof urlOrOpts is 'object' and not Array.isArray(urlOrOpts)
    urlOrOpts
  else
    { ...opts, url: (if urlOrOpts isnt undefined then urlOrOpts else opts.url) }
  adapter = if o.adapter?
    o.adapter
  else
    harborAdapter
      url: o.url
      token: o.token
      fetch: o.fetch
      timeoutMs: o.timeoutMs
  installDefault adapter, createClient(adapter, { camel: o.camel ?? false })

# Module-level surface over the process default. (The client object still
# exposes rows/one/value/values; those names are too common as locals to
# also export at module scope.) `sql` runs any statement and returns the
# full envelope — rows, columns, rowCount — for callers who want to deal
# with the result themselves; findAll/findOne project it.
export def sql(text, params = null, opts = {})
  defaultPair!.client.sql! text, params, opts

export def findAll(text, params = null, opts = {})
  defaultPair!.client.rows! text, params, opts

export def findOne(text, params = null, opts = {})
  defaultPair!.client.one! text, params, opts

export def transaction(fn)
  defaultPair!.client.transaction! fn

# Raw adapter begin (session + BEGIN) — what schema.transaction uses under
# the hood. App code usually wants `transaction(fn)` instead.
export def begin(opts = {})
  adapter = defaultPair!.adapter
  fail 'this adapter does not support transactions' unless typeof adapter.begin is 'function'
  adapter.begin! opts

# Quote a SQL identifier; doubles embedded `"`.
export ident = (name) ->
  '"' + String(name).replace(/"/g, '""') + '"'

# Adapter envelope `{ columns, data }` → row objects. `{ camel: true }`
# opts into the snake_case → camelCase key projection (see `camelName`).
export def materializeAll(result, opts = {})
  (materialize result, opts.camel ?? false).rows

# Print a result as an aligned text table and return it unchanged, so
# it wraps any read without disturbing the value: `show findAll! text`.
# Accepts the envelope `sql` returns (column order preserved), the
# plain rows array `findAll` returns (order from the first row's
# keys), or a lone row — a `findOne` result or a model instance —
# which prints as a vertical key/value card. Model instances flatten
# through their own toJSON, so columns are fields, not internals.
# Numeric columns right-align; NULL prints as empty, not the string
# "null" — a table full of nulls should look sparse, not noisy. Two
# REPL guardrails, both overridable: `maxRows` (default 50) prints the
# head and says how many were left unshown; `maxWidth` (default 40)
# clips runaway cells with an ellipsis.
export def show(result, opts = {})
  # Print what the caller MEANT, never the plumbing object they
  # happened to hold: a promise awaits, and a query builder (anything
  # non-array with an .all() method — a SchemaQuery chain, or a model
  # itself: `show User` prints the table) executes first. Those paths
  # return a promise — chain them with `show!`. Plain values stay
  # synchronous, so `(show rows).map -> it.id` remains a pipeline.
  if result? and typeof result.then is 'function'
    return result.then (settled) -> show settled, opts
  if result? and not Array.isArray(result) and typeof result.all is 'function'
    return show result.all(), opts
  maxRows = opts.maxRows ?? 50
  maxWidth = opts.maxWidth ?? 40
  clip = (s) -> if s.length > maxWidth then s.slice(0, maxWidth - 1) + '…' else s
  # Dates print as ISO — compact, unambiguous, and column-sortable by
  # eye, unlike the paragraph Date#toString produces.
  cell = (v) ->
    return '' unless v?
    clip (if v instanceof Date then v.toISOString() else String(v))
  asRow = (row) -> if typeof row?.toJSON is 'function' then row.toJSON() else row

  # A lone row prints as a card: field names down the left, values
  # down the right, no header and no row count — it is one record.
  isEnvelope = result? and Array.isArray(result.rows)
  if not isEnvelope and not Array.isArray(result) and result? and typeof result is 'object'
    obj = asRow result
    keys = Object.keys obj
    vals = keys.map (k) -> cell obj[k]
    kw = Math.max 0, ...keys.map((k) -> k.length)
    vw = Math.max 0, ...vals.map((v) -> v.length)
    line = '+' + '-'.repeat(kw + 2) + '+' + '-'.repeat(vw + 2) + '+'
    console.log line
    console.log "| #{k.padEnd(kw)} | #{vals[i].padEnd(vw)} |" for k, i in keys
    console.log line
    return result

  rows = if isEnvelope then result.rows else (result ?? []).map asRow
  names = if isEnvelope and result.columns?.length
    result.columns
  else if rows.length
    Object.keys rows[0]
  else
    []
  # No rows, no table: a bordered husk with nothing in it says less
  # than the words do.
  if rows.length is 0
    console.log '0 rows'
    return result
  total = rows.length
  shown = if total > maxRows then rows.slice(0, maxRows) else rows
  numeric = names.map (n) ->
    shown.length > 0 and shown.every (row) -> not row[n]? or typeof row[n] is 'number' or typeof row[n] is 'bigint'
  cells = shown.map (row) -> names.map (n) -> cell row[n]
  head = names.map (n) -> String(n)
  widths = head.map (h, i) -> Math.max h.length, ...cells.map((r) -> r[i].length)
  pad = (c, i) -> if numeric[i] then c.padStart(widths[i]) else c.padEnd(widths[i])
  line = '+' + widths.map((w) -> '-'.repeat(w + 2)).join('+') + '+'
  fmt = (cols) -> '| ' + cols.map(pad).join(' | ') + ' |'
  console.log line
  console.log fmt(head)
  console.log line
  console.log fmt(r) for r in cells
  console.log line
  footer = "#{total} #{if total is 1 then 'row' else 'rows'}"
  footer += " (first #{maxRows} shown)" if total > maxRows
  console.log footer
  result

# ==[ Boot probe ]============================================================

PROBE_TIMEOUT_MS =! 5000

# GET /ready, which harbor leaves unauthenticated on purpose, so a probe
# needs no credential. It runs `SELECT 1` and answers `{"status":"ready"}`
# — an answer worth having, unlike the `/health` it replaced, which was a
# hardcoded 200 that stayed cheerful while the executor thread was gone.
#
# `/health` is still tried, but only on a 404: harbors predating the swap
# are still out there, and a boot probe that fails against a database
# that is up and serving is worse than one extra round trip on the older
# server. Both spellings of "yes" are accepted for the same reason.
#
# Anything else -- a 503, a body that says neither, a transport failure,
# or a timeout -- reads as not reachable. The timeout keeps a half-open
# TCP from hanging boot forever, and it covers both probes together, so
# the fallback cannot double it.
reachable = (url, fetchFn) ->
  ctrl = AbortController.new()
  timer = setTimeout (-> ctrl.abort()), PROBE_TIMEOUT_MS
  affirmative = (data) ->
    data?.status is 'ready' or data?.status is 'ok' or data?.ok is true
  try
    res = fetchFn! "#{url}/ready", { signal: ctrl.signal }
    if res?.status is 404
      res = fetchFn! "#{url}/health", { signal: ctrl.signal }
    return false unless res?.ok
    affirmative res.json!
  catch
    false
  finally
    clearTimeout timer

# Boot probe: GET /ready, falling back to /health on an older harbor.
# Returns 'running' or throws. Prefer this name; `ensureRunning` is the
# same check (apps still import that spelling).
export def assertReachable(url = null, opts = {})
  fetchFn = opts.fetch ?? fetch
  resolved = resolveUrl url
  return 'running' if reachable!(resolved, fetchFn)
  throw Error.new "harbor not reachable at #{resolved} — start your duckdb-harbor instance and try again"

export def ensureRunning(url = null, opts = {})
  assertReachable url, opts

# Health check: `/ready` then `current_database()`. Returns
# `{ ok: true, url, database }` or throws ConnectionError.
# CLI also accepts `rip-db status` as an alias (not exported — `status`
# is too common as a local / HTTP field name).
export def ping(opts = {})
  o = if opts? and typeof opts is 'object' and not Array.isArray(opts) then opts else {}
  url = resolveUrl o.url
  fetchFn = o.fetch ?? fetch
  unless reachable!(url, fetchFn)
    throw ConnectionError.new "db: harbor not reachable at #{url}"
  sql = makeSql
    url: url
    token: o.token
    fetch: fetchFn
    timeoutMs: o.timeoutMs
  database = currentDatabase! sql
  { ok: true, url, database }

# ==[ CLI logic ]=============================================================

# ── pure helpers ──────────────────────────────────────────────────────

# A SQL single-quoted string literal, doubling embedded quotes. A NUL
# byte is rejected — it does not survive HTTP-as-text transport.
export sqlString = (s) ->
  throw Error.new 'db: path contains NUL byte' if s.includes '\0'
  "'" + s.replaceAll("'", "''") + "'"

# A filesystem-safe stem for an auto-named archive.
export safeFileStem = (s) ->
  String(s).replace(/[^A-Za-z0-9._-]+/g, '_').replace(/^_+|_+$/g, '') or 'rip-db'

# A `YYYYMMDD-HHMMSS` stamp from a Date (injected, never a bare `new
# Date()` — the caller owns the clock).
export stamp = (d) ->
  p = (n) -> String(n).padStart(2, '0')
  "#{d.getFullYear()}#{p(d.getMonth() + 1)}#{p(d.getDate())}-#{p(d.getHours())}#{p(d.getMinutes())}#{p(d.getSeconds())}"

export humanSize = (bytes) ->
  if bytes < 1024 then "#{bytes} B"
  else if bytes < 1024 * 1024 then "#{(bytes / 1024).toFixed(1)} KB"
  else if bytes < 1024 * 1024 * 1024 then "#{(bytes / 1024 / 1024).toFixed(1)} MB"
  else "#{(bytes / 1024 / 1024 / 1024).toFixed(2)} GB"

# A tar entry name is unsafe if it escapes the extraction root: absolute,
# a bare `..`, or a `..` path segment. (This blocks the obvious traversal
# patterns; it does not defend against crafted symlink/hardlink archives,
# so `load` is for archives you trust — see the CLI help.)
export unsafeTarPath = (raw) ->
  name = raw.replaceAll('\\', '/')
  name.startsWith('/') or name is '..' or name.startsWith('../') or name.includes('/../')

# ── SQL over harbor's /sql ────────────────────────────────────────────

# One wire with the adapter: temporal encode/decode, timeout/abort, and
# typed DbError. CLI and MCP both call this — there is no second /sql
# client. `makeMcpSql` is the same function under the historical name.
export makeSql = (opts = {}) ->
  adapter = harborAdapter
    url: opts.url
    token: opts.token
    fetch: opts.fetch
    timeoutMs: opts.timeoutMs
  (query, params = null) ->
    adapter.query! query, params

export makeMcpSql = makeSql

# The database name, for auto-naming an archive.
export currentDatabase = (sql) ->
  r = sql! 'SELECT current_database()'
  r?.data?[0]?[0] ?? 'rip-db'

# Refuse to IMPORT into a populated DB — across every user schema, not
# just `main` — so a load never crashes half-way with "already exists".
export assertEmptyDatabase = (sql) ->
  r = sql! '''
    SELECT count(*) FROM (
      SELECT 1 FROM duckdb_tables() WHERE internal = false
      UNION ALL
      SELECT 1 FROM duckdb_views()  WHERE internal = false
    )
  '''
  n = Number(r?.data?[0]?[0] ?? 0)
  if n isnt 0
    throw Error.new "target database is not empty (#{n} user table/view(s) across all schemas). Drop them first or load into a fresh harbor instance."

# ── commands ──────────────────────────────────────────────────────────
#
# Each returns a human message; each host effect goes through `deps`:
#   { sql, fs, tar, tmp, now, join }
#   fs:  { exists, isDir, statSize, rm }
#   tar: { create(archive, dir), extract(archive, dir), list(archive) }

# dump: EXPORT DATABASE to a staging dir, verify harbor wrote it here,
# tidy the SQL for readability, tar it up. Fails closed on overwrite.
export dump = (arg, deps) ->
  { sql, fs, tar, now } = deps
  staging = deps.tmp()
  try
    archive = arg
    isDir = archive? and fs.exists(archive) and fs.isDir(archive)
    if not archive or isDir
      name = "#{safeFileStem currentDatabase! sql}-#{stamp now()}.tar.gz"
      archive = if isDir then deps.join(archive, name) else name
    else if not /\.(tar\.gz|tgz)$/i.test archive
      throw Error.new "archive path must end in .tar.gz or .tgz (got '#{archive}'). Pass an existing directory to drop an auto-named archive into it, or omit the path to write into the current directory."
    throw Error.new "refusing to overwrite existing file: #{archive} (use a different name or rm it first)" if fs.exists archive
    sql! "EXPORT DATABASE #{sqlString staging} (FORMAT CSV)"
    assertExportDir fs, staging
    tar.create archive, staging
    "wrote #{archive} (#{humanSize fs.statSize archive})"
  finally
    fs.rm staging

# load: verify the target is empty, screen the archive for traversal,
# extract, IMPORT DATABASE.
export load = (arg, deps) ->
  { sql, fs, tar } = deps
  throw Error.new 'usage: rip-db load ARCHIVE.tar.gz' unless arg
  throw Error.new "no such file: #{arg}" unless fs.exists arg
  staging = deps.tmp()
  try
    assertEmptyDatabase! sql
    for entry in tar.list arg when unsafeTarPath entry
      throw Error.new "unsafe path in archive: #{entry}"
    tar.extract arg, staging
    assertExportDir fs, staging
    sql! "IMPORT DATABASE #{sqlString staging}"
    "loaded #{arg}"
  finally
    fs.rm staging

# checkpoint: flush the WAL. Plain CHECKPOINT fails while other writers
# are active; --force preempts them (and can lose their uncommitted
# writes), so the plain-mode failure escalates to a --force hint.
export checkpoint = (force, deps) ->
  { sql, now } = deps
  stmt = if force then 'FORCE CHECKPOINT' else 'CHECKPOINT'
  t0 = now().getTime()
  try
    sql! stmt
  catch e
    msg = e?.message or String(e)
    if not force and /transaction/i.test msg
      # Expected, not exceptional: harbor's own `harbor_wait()` holds a read
      # transaction older than every write for as long as the server runs, so
      # an explicit CHECKPOINT refuses once anything has been written. DuckDB
      # still checkpoints automatically at its threshold, and harbor folds the
      # WAL on a clean stop, so the database is not accumulating risk while
      # this fails.
      #
      # --force is offered last and hedged on purpose. FORCE CHECKPOINT aborts
      # other transactions to get its lock, and since harbor grew sessions
      # those include real application transactions mid-flight — not just
      # harbor's own bookkeeping. It can also abort `harbor_wait()` itself,
      # which stops the server.
      throw Error.new """
        #{msg}

        This is normal while harbor is serving: its own wait holds a
        transaction older than every write. DuckDB checkpoints on its own at
        the threshold, and harbor folds the WAL when it stops, so there is
        usually nothing to do here.

        To fold it now, stop harbor — that checkpoints on the way out. Only
        reach for --force if you know no transaction is in flight: it aborts
        the ones that are, including other clients', and can stop the server.
        """
    throw e
  "#{stmt.toLowerCase()} complete (#{now().getTime() - t0} ms)"

# The staging dir must hold harbor's own EXPORT output; if it's empty,
# harbor wrote to ITS filesystem, not ours (a remote/containerized
# harbor) — fail loudly instead of tarring an empty archive.
assertExportDir = (fs, dir) ->
  unless fs.exists("#{dir}/schema.sql") and fs.exists("#{dir}/load.sql")
    throw Error.new "expected DuckDB export files (schema.sql + load.sql) not present in #{dir}. If harbor runs on a different host or container, the EXPORT/IMPORT staging directory must be visible to both the script and the server."

# ==[ MCP ]===================================================================

MAX_ROWS = 1024
MAX_CHARS = 50000

INSTRUCTIONS = '''
  DuckDB SQL over duckdb-harbor. Use DuckDB's dialect: standard SQL plus
  list/struct/map types, QUALIFY, GROUP BY ALL, SELECT * EXCLUDE/REPLACE,
  and functions like list_aggregate, strftime, and epoch_ms. Explore with
  list_tables and list_columns before querying; execute_query runs any
  statement. Results are truncated past 1024 rows or 50KB.
'''

TOOLS = [
  {
    name: 'execute_query'
    description: 'Execute a SQL query on the DuckDB database. Use DuckDB SQL dialect.'
    inputSchema: { type: 'object', properties: { sql: { type: 'string', description: 'SQL query to execute' } }, required: ['sql'] }
    annotations: { readOnlyHint: false, destructiveHint: true }
  }
  {
    name: 'list_tables'
    description: 'List all tables and views in the database with their types and comments.'
    inputSchema: { type: 'object', properties: {} }
    annotations: { readOnlyHint: true, destructiveHint: false }
  }
  {
    name: 'list_columns'
    description: 'List all columns of a table with their types, nullability, and comments.'
    inputSchema: { type: 'object', properties: { table: { type: 'string', description: 'Table or view name' } }, required: ['table'] }
    annotations: { readOnlyHint: true, destructiveHint: false }
  }
]

# columns[i].name → row[i], one object per row — the client's one
# materializer, applied to a bare envelope.
rowsToObjects = (columns, data) ->
  (materialize { columns, data }).rows

# ── the protocol core ─────────────────────────────────────────────────

export def createMcpServer(deps)
  { sql } = deps

  # execute_query: run arbitrary SQL, shape the result, and truncate to
  # stay within the row and byte budgets an assistant can consume.
  executeQuery = (params) ->
    query = params?.sql
    return { success: false, error: 'Missing sql parameter' } unless query
    try
      result = sql! query
      return { success: false, error: result.error, errorCode: result.errorCode } if result?.ok is false
      columns = (result.columns ?? []).map (c) -> c.name
      columnTypes = (result.columns ?? []).map (c) -> c.duckdbType ?? c.type
      rows = result.data ?? []
      truncated = false
      warning = null
      if rows.length > MAX_ROWS
        rows = rows.slice 0, MAX_ROWS
        truncated = true
        warning = "Results limited to #{MAX_ROWS} rows."
      output = { success: true, columns, columnTypes, rows, rowCount: rows.length }
      # Shrink by ~10% per pass until the serialized result fits the byte
      # budget (or one row remains).
      while JSON.stringify(output).length > MAX_CHARS and output.rows.length > 1
        cut = Math.max 1, Math.floor(output.rows.length / 10)
        output.rows = output.rows.slice 0, output.rows.length - cut
        output.rowCount = output.rows.length
        truncated = true
        warning = "Results limited to #{output.rows.length} rows due to 50KB output size limit."
      # A single row that alone blows the budget can't be shrunk further —
      # return it, but say so rather than silently exceeding the cap.
      if JSON.stringify(output).length > MAX_CHARS
        truncated = true
        warning = "A single row exceeds the 50KB output budget; returned in full."
      output.truncated = truncated if truncated
      output.warning = warning if warning
      output
    catch err
      { success: false, error: err.message or String(err), errorType: err.constructor?.name or 'Error' }

  listTables = ->
    try
      result = sql! '''
        SELECT schema_name AS schema, table_name AS name, 'table' AS type, comment
        FROM duckdb_tables() WHERE database_name = current_database() AND NOT internal
        UNION ALL
        SELECT schema_name AS schema, view_name AS name, 'view' AS type, comment
        FROM duckdb_views() WHERE database_name = current_database() AND NOT internal
        ORDER BY schema, type, name
      '''
      return { success: false, error: result.error, errorCode: result.errorCode } if result?.ok is false
      tables = rowsToObjects result.columns, result.data
      { success: true, tables, tableCount: (tables.filter (t) -> t.type is 'table').length, viewCount: (tables.filter (t) -> t.type is 'view').length }
    catch err
      { success: false, error: err.message or String(err), errorType: err.constructor?.name or 'Error' }

  listColumns = (params) ->
    table = params?.table
    return { success: false, error: 'Missing table parameter' } unless table
    try
      [stmt, bindings] = if table.includes '.'
        parts = table.split '.'
        schemaName = parts[0]
        tableName = parts.slice(1).join '.'
        [
          '''
            SELECT column_name AS name, data_type AS type, is_nullable AS nullable, comment
            FROM duckdb_columns() WHERE database_name = current_database() AND schema_name = ? AND table_name = ? ORDER BY column_index
          '''
          [schemaName, tableName]
        ]
      else
        [
          '''
            SELECT column_name AS name, data_type AS type, is_nullable AS nullable, comment
            FROM duckdb_columns() WHERE database_name = current_database() AND table_name = ? ORDER BY column_index
          '''
          [table]
        ]
      result = sql! stmt, bindings
      return { success: false, error: result.error, errorCode: result.errorCode } if result?.ok is false
      columns = rowsToObjects result.columns, result.data
      { success: true, table, columns, columnCount: columns.length }
    catch err
      { success: false, error: err.message or String(err), errorType: err.constructor?.name or 'Error' }

  respond = (id, result) -> JSON.stringify { jsonrpc: '2.0', id, result }
  respondError = (id, code, message) -> JSON.stringify { jsonrpc: '2.0', id, error: { code, message } }

  callTool = (params) ->
    name = params?.name
    args = params?.arguments or {}
    result = switch name
      when 'execute_query' then executeQuery! args
      when 'list_tables' then listTables!
      when 'list_columns' then listColumns! args
      else { success: false, error: "Unknown tool: #{name}" }
    { content: [{ type: 'text', text: JSON.stringify result }], isError: not result.success }

  # One JSON-RPC message → the string to write (or null for a
  # notification that produces no reply).
  dispatch = (msg) ->
    { id, method, params } = msg
    switch method
      when 'initialize'
        respond id,
          protocolVersion: '2024-11-05'
          capabilities: { tools: {} }
          serverInfo: { name: 'rip-db-mcp', version: VERSION }
          instructions: INSTRUCTIONS
      when 'notifications/initialized' then null
      when 'tools/list' then respond id, { tools: TOOLS }
      when 'tools/call' then respond id, callTool!(params)
      else
        if id? then respondError id, -32601, "Unknown method: #{method}" else null

  { dispatch }

# ── stdio entry ───────────────────────────────────────────────────────

# options (library) > --url argv (CLI) > RIP_DB_* env > defaults.
# Inject `sql` or `fetch` for hermetic tests.
export def startStdio(options = {})
  { createInterface } = import!('node:readline')
  argv = process.argv.slice 2
  flagIdx = argv.indexOf '--url'
  fromArgv = if flagIdx >= 0 then argv[flagIdx + 1] else null
  url = resolveUrl(options.url ?? fromArgv)
  token = options.token ?? envToken()
  sql = options.sql ?? makeSql({ url, token, fetch: options.fetch, timeoutMs: options.timeoutMs })
  log = (...args) -> console.warn '[rip-db]', ...args
  log "harbor requests will be rejected with MISSING_CREDENTIAL — set RIP_DB_TOKEN" unless token
  { dispatch } = createMcpServer { sql }
  rl = createInterface input: process.stdin
  log "Starting (harbor at #{url})"
  rl.on 'line', (line) ->
    return unless line.trim()
    try
      reply = dispatch! JSON.parse(line)
      process.stdout.write reply + '\n' if reply?
    catch err
      log 'dispatch error:', err?.message or err
    return

# ==============================================================================
# CLI host seam (rip-db)
# ==============================================================================

USAGE =! '''
rip-db — CLI for rip/db (talks to a running duckdb-harbor).

Usage:
  rip-db ping                                Is harbor up? Print url + database name.
  rip-db status                              Same as ping.
  rip-db dump [ARCHIVE.tar.gz | DIRECTORY]   Snapshot the running database.
  rip-db load ARCHIVE.tar.gz                 Restore from a snapshot (empty DB).
  rip-db checkpoint [--force]                Flush the WAL into the DB file.
  rip-db mcp [--url URL]                     MCP stdio server for AI assistants.
  rip-db <subcommand> --help                 Subcommand-specific help.
  rip-db --help / -h                         This message.
  rip-db --version / -v                      Print version.

This CLI does not start or stop a database server. Run your
duckdb-harbor instance separately and point RIP_DB_URL at it.

Environment:
  RIP_DB_URL    Harbor base URL (default http://127.0.0.1:9495)
  RIP_DB_TOKEN  Harbor bearer token (only when harbor requires one)
'''

HELP =! {
  ping: '''
Usage: rip-db ping
       rip-db status

Probe harbor GET /ready, then SELECT current_database().
Prints: ok  <url>  database=<name>
Exits 1 when harbor is unreachable.
'''
  dump: '''
Usage: rip-db dump [ARCHIVE.tar.gz | DIRECTORY]

Export the running harbor database to a single .tar.gz archive.
  (omitted)            write <db>-YYYYMMDD-HHMMSS.tar.gz in the cwd
  existing directory   write the auto-named archive INSIDE that directory
  *.tar.gz / *.tgz     use the literal filename
Refuses to overwrite an existing archive.
'''
  load: '''
Usage: rip-db load ARCHIVE.tar.gz

Restore a tar.gz produced by `rip-db dump` into the harbor database.
Refuses to load unless the target database is empty. Screens the archive
for traversal paths — load only archives you trust.
'''
  checkpoint: '''
Usage: rip-db checkpoint [--force]

Issue CHECKPOINT to flush the WAL into the main DB file. Plain CHECKPOINT
fails if other writers are active; --force preempts them (and can lose
their uncommitted writes).
'''
  mcp: '''
Usage: rip-db mcp [--url URL]

Start the MCP stdio server (line-delimited JSON-RPC over stdin/stdout).
Default harbor URL is RIP_DB_URL or http://127.0.0.1:9495.
'''
}

if import.meta.main
  { existsSync, statSync, mkdtempSync, rmSync } = import!('node:fs')
  { tmpdir } = import!('node:os')
  { join } = import!('node:path')
  { spawnSync } = import!('node:child_process')

  die = (msg) ->
    process.stderr.write "rip-db: #{msg}\n"
    process.exit 1

  runTar = (args, opts = {}) ->
    r = spawnSync 'tar', args, { encoding: 'utf8', ...opts }
    throw r.error if r.error
    if r.status isnt 0
      throw Error.new "tar #{args.join(' ')} exited #{r.status}: #{(r.stderr or '').trim()}"
    r.stdout or ''

  makeDeps = ->
    staged = []
    cleanup = ->
      for d in staged.splice(0)
        try rmSync(d, { recursive: true, force: true })
    process.on 'exit', cleanup
    process.on 'SIGINT', -> cleanup(); process.exit 130
    process.on 'SIGTERM', -> cleanup(); process.exit 143
    {
      sql: makeSql({ url: process.env.RIP_DB_URL, token: process.env.RIP_DB_TOKEN or null })
      fs:
        exists: (p) -> existsSync(p)
        isDir: (p) -> try statSync(p).isDirectory() catch then false
        statSize: (p) -> statSync(p).size
        rm: (p) -> try rmSync(p, { recursive: true, force: true })
      tar:
        create: (archive, dir) -> runTar(['-czf', archive, '-C', dir, '.'], { stdio: ['ignore', 'inherit', 'inherit'] })
        extract: (archive, dir) -> runTar(['-xzf', archive, '-C', dir], { stdio: ['ignore', 'inherit', 'inherit'] })
        list: (archive) -> runTar(['-tzf', archive]).split(/\r?\n/).filter(Boolean)
      tmp: ->
        d = mkdtempSync join(tmpdir(), 'ripdb-')
        staged.push d
        d
      now: -> Date.new()
      join: join
    }

  args = process.argv.slice(2)
  cmd = args[0]

  try
    if cmd is undefined or cmd is '--help' or cmd is '-h'
      process.stdout.write USAGE
    else if cmd is '--version' or cmd is '-v'
      process.stdout.write "rip-db v#{VERSION}\n"
    else if cmd is 'ping' or cmd is 'status'
      if args.includes('--help') or args.includes('-h') then process.stdout.write HELP.ping
      else if args.length > 1 then die "usage: rip-db #{cmd}"
      else
        info = ping!
        console.log "ok  #{info.url}  database=#{info.database}"
    else if cmd is 'dump'
      if args.includes('--help') or args.includes('-h') then process.stdout.write HELP.dump
      else if args.length > 2 then die 'usage: rip-db dump [ARCHIVE.tar.gz | DIRECTORY]'
      else console.log dump!(args[1] ?? null, makeDeps())
    else if cmd is 'load'
      if args.includes('--help') or args.includes('-h') then process.stdout.write HELP.load
      else if args.length isnt 2 then die 'usage: rip-db load ARCHIVE.tar.gz'
      else console.log load!(args[1], makeDeps())
    else if cmd is 'checkpoint'
      extra = args.slice(1)
      if extra.includes('--help') or extra.includes('-h') then process.stdout.write HELP.checkpoint
      else
        force = extra.includes('--force')
        for a in extra
          die "unknown argument: #{a}" unless a is '--force'
        console.log checkpoint!(force, makeDeps())
    else if cmd is 'mcp'
      if args.includes('--help') or args.includes('-h') then process.stdout.write HELP.mcp
      else startStdio!
    else
      process.stderr.write "rip-db: unknown subcommand '#{cmd}'\n\n"
      process.stdout.write USAGE
      process.exit 1
  catch e
    die e?.message or String(e)
