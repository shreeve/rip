#!/usr/bin/env rip
# Minimal rip/db smoke — requires a running duckdb-harbor.
#
#   # Terminal A
#   duckdb -init ~/.duckdb-harbor.rc my.duckdb
#   # or: INSTALL/LOAD harbor; CALL harbor_serve(...)
#
#   # Terminal B
#   export RIP_DB_URL=http://127.0.0.1:9495
#   export RIP_DB_TOKEN=rip-token   # match harbor_serve
#   rip example.rip

import { connect, ensureRunning, sql, findOne } from 'rip/db'

ensureRunning!
connect!

row = findOne! 'SELECT 1 AS n, current_database() AS db'
p row

result = sql! 'SELECT 40 + 2 AS answer'
p result.rows
