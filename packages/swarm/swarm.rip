#!/usr/bin/env rip

# ==============================================================================
# rip/swarm - Parallel job runner with worker threads
#
# Author: Steve Shreeve (steve.shreeve@gmail.com)
#   Date: January 18, 2026
#
# Usage:
#   import { swarm, init, retry, todo } from 'rip/swarm'
#
#   setup = ->
#     unless retry()
#       init()
#       for i in [1..100] then todo(i)
#     { startedAt: Date.now() }
#
#   perform = (task, ctx) ->
#     Bun.sleep!(Math.random() * 1000)
#
#   swarm { setup, perform }
# ==============================================================================

import { Worker, isMainThread, parentPort, workerData } from 'worker_threads'
import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, writeFileSync, rmSync } from 'fs'
import { join, resolve } from 'path'
import { pathToFileURL } from 'url'
import { cpus } from 'os'

# ==============================================================================
# Module state
# ==============================================================================

# The queue lives under .swarm in the working directory — one queue per
# directory, shared by every swarm script run there, unless the script
# names its own with a tag: `swarm { tag: 'reports' }` or `-t reports`
# keeps it under .swarm/reports, so two scripts in one directory never
# replay each other's days.
_name = null
_dir  = null
_todo = null
_done = null
_died = null

useDir = (name) ->
  _name = name
  _dir  = resolve(name)
  _todo = join(_dir, 'todo')
  _done = join(_dir, 'done')
  _died = join(_dir, 'died')

useDir '.swarm'

# ==============================================================================
# Task queue (file-based)
# ==============================================================================

export init! = ->
  rmSync(_dir, { recursive: true, force: true })
  mkdirSync(dir, { recursive: true }) for dir in [_todo, _done, _died]

export retry = ->
  return false unless existsSync(_died) and existsSync(_todo)
  died = readdirSync(_died)
  todo = readdirSync(_todo)
  return todo.length > 0 if died.length is 0
  renameSync(join(_died, file), join(_todo, file)) for file in died
  true

export todo! = (name, data) ->
  data ?= ''
  data = JSON.stringify(data) unless kind(data) is 'string'
  writeFileSync(join(_todo, String(name)), data)

base = (path) -> path.split('/').pop()

move! = (path, dest) ->
  try renameSync(path, join(dest, base(path)))

logError! = (msg) ->
  writeFileSync(join(_dir, 'errors.log'), "#{msg}\n", { flag: 'a' }) if existsSync(_dir)

# ==============================================================================
# ANSI terminal
# ==============================================================================

STDOUT = process.stdout

write!  = (s) -> STDOUT.write(s)
clear   = (line) -> "\x1b[K" if line else "\x1b[2J"
cursor! = (show) -> write("\x1b[?25h" if show else "\x1b[?25l")
go     = (r = 1, c = 1) -> "\x1b[#{r};#{c}H"

_hex = {}

hex = (str) ->
  return _hex[str] if _hex[str]?
  s = str.replace(/^#/, '')
  m = s.match(/^([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i) or s.match(/^([0-9a-f])([0-9a-f])([0-9a-f])$/i)
  return '' unless m
  _hex[str] = m.slice(1).map((c) -> parseInt((c + c if c.length is 1 else c), 16)).join(';')

fg  = (rgb) -> "\x1b[38;2;#{hex(rgb)}m" if rgb else "\x1b[39m"
bg  = (rgb) -> "\x1b[48;2;#{hex(rgb)}m" if rgb else "\x1b[49m"
fgw =! fg("fff")

# ==============================================================================
# Progress display
# ==============================================================================

char = wide = len = hold = null
high = {}   # slot -> the widest bar drawn for it this run

# A worker's bar, in whole cells: the run's progress times the worker's
# count against the busiest worker's. The busiest bar is the run's
# progress, and every other bar its share of that, so the chart reads
# "how far done" and "who did it" at once. Integer arithmetic rounded
# down: a finished run's busiest bar is jobs of jobs and most of most,
# exactly full, and no one short of the most rounds up to look full.
cells = (finished, jobs, count, most) -> Math.floor(finished * count * wide / (jobs * most))

drawFrame! = (workers) ->
  len = String(workers).length
  write clear()
  write go(1,           len + 3) + "╭" + "─".repeat(wide + 2) + "╮"
  for i in [0...workers]
    write go(i + 2, 1)
    label = String(i + 1).padStart(len)
    write " #{label} │ " + " ".repeat(wide) + " │"
  write go(workers + 2, len + 3) + "├"  + "─".repeat(wide  + 2) + "┤"
  write go(workers + 3, len + 3) + "│ " + " ".repeat(wide) +     " │"
  write go(workers + 4, len + 3) + "╰"  + "─".repeat(wide  + 2) + "╯"

# A percentage to one decimal, rounded down: 4044 of 4045 is 99.9, and
# only a finished run reads 100.0. Integer arithmetic, so 57 of 100 is
# 57.0 and not the 56.9 a float product would floor to.
tenths = (part, whole) -> (Math.floor(part * 1000 / whole) / 10).toFixed(1)

draw! = (state) ->
  { live, done, died, jobs, workers, info, inflight } = state

  most = Math.max(...Object.values(info), 1)

  # worker bars, then the task each worker is on beside its row. `most`
  # in the denominator means the leader's every job pulls the other bars
  # back a fraction, and a bar losing ground reads as a drawing error; so
  # with `hold` (the default) a bar holds its widest until its own count
  # carries it past, and the rows only move forward while the run is
  # live. `hold: false` draws every bar at its true value in every frame
  write fgw
  for slot, count of info
    cols = cells done + died, jobs, count, most
    cols = Math.max(high[slot] ?? 0, cols) if hold
    high[slot] = cols
    write go(parseInt(slot) + 1, len + 5) + bg("5383ec") + char.repeat(cols) + bg() + " ".repeat(wide - cols)
  write fg()
  for slot, task of inflight when task
    write go(parseInt(slot) + 1, len + 5 + wide + 3) + " " + base(task) + clear(true)

  # summary bar: one atomic write — round the green and yellow segment
  # BOUNDARIES and take differences, so the three segments always sum
  # to wide exactly; flooring green and yellow independently leaked
  # their rounding crumbs into red, showing phantom "pending" cells
  # even when every job was done or in flight
  gcol = Math.round(done / jobs * wide)
  ycol = Math.round((done + live) / jobs * wide) - gcol
  # in-flight work always shows: sub-half-cell live rounds to nothing
  if live > 0 and ycol is 0
    ycol = 1
    gcol-- if gcol + ycol > wide
  rcol = wide - gcol - ycol
  row  = workers + 3

  out = [
    go(row, len + 5)
    bg("58a65c") + char.repeat(gcol)                          #  green (done)
    bg("f1bf42") + char.repeat(ycol)                          # yellow (live)
    bg("d85140") + " ".repeat(rcol)                           #    red (rest)
    go(row, len + 5 + wide + 3)
    bg("5383ec") + " #{tenths(done + died, jobs)}% "          #   blue (pct)
    if done > 0 then bg() + " " + bg("58a65c") + " #{done}/#{jobs} done "
    if died > 0 then bg() + " " + bg("d85140") + " #{died} died "
  ].filter(Boolean).join('') + fg() + bg()
  write out

# ==============================================================================
# Worker orchestration
# ==============================================================================

# Worker mode: a worker loads the job script, and its swarm() call starts
# the worker serving tasks then and there, in this same module instance.
# It then waits on a promise that never settles, so a script that awaits it
# (`swarm! {…}`) stops there in every worker: code after it runs once, in
# the main thread, and a worker never waits on it to take its first task.
_serving = false

serve = (perform) ->
  _serving = true
  parentPort.postMessage { type: 'ready' }
  parentPort.on 'message', (msg) ->
    switch msg.type
      when 'task'
        try
          perform!(msg.taskPath, workerData.context)
          parentPort.postMessage { type: 'done', taskPath: msg.taskPath }
        catch err
          parentPort.postMessage { type: 'failed', taskPath: msg.taskPath, error: err.message }
      when 'shutdown'
        exit(0)

export swarm! = (opts = {}) ->
  unless isMainThread
    return unless typeof opts.perform is 'function' and not _serving
    serve opts.perform
    await Promise.new(-> null)

  # parse CLI options
  args    = process.argv.slice(2)
  workers = parseInt(findArg(args, '-w', '--workers')) or opts.workers or cpus().length
  wide    = parseInt(findArg(args, '-b', '--bar'))     or opts.bar    or 20
  char    = (findArg(args, '-c', '--char')             or opts.char   or '•')[0]
  doreset = args.includes('-r') or args.includes('--reset')
  dosafe  = args.includes('-s') or args.includes('--safe')
  quiet   = args.includes('-q') or args.includes('--quiet')
  tag     = findArg(args, '-t', '--tag') or opts.tag
  hold    = opts.hold ?? true

  abort 'error: workers must be at least 1' if workers < 1
  abort 'error: hold must be true or false' if opts.hold? and typeof opts.hold isnt 'boolean'
  abort 'error: tag must be a plain name (letters, digits, - _ .)' if tag? and not /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(String(tag))
  useDir join('.swarm', String(tag)) if tag?

  if doreset
    rmSync(_dir, { recursive: true, force: true })
    p "removed #{_name} directory"
    exit(0)

  # run setup
  abort 'error: perform() function is required' unless typeof opts.perform is 'function'

  context = {}
  if typeof opts.setup is 'function'
    result = opts.setup!
    context = result if result? and typeof result is 'object'
  context.safe = dosafe

  # read task list
  abort "error: no #{_name}/todo directory found (did setup run?)" unless existsSync(_todo)

  tasks = readdirSync(_todo).sort().map (f) -> join(_todo, f)

  unless tasks.length
    p 'no tasks to process'
    exit(0)

  jobs = tasks.length

  # resolve paths: each worker thread runs THIS file as its entry (the
  # worker block at the bottom), so there is no separate bootstrap file
  workerPath = URL.new(import.meta.url).pathname
  scriptPath = resolve(process.argv[1] or '')

  # Workers must compile .rip imports themselves: a worker thread gets
  # neither the parent's preloads nor bunfig's (verified: the inherited
  # execArgv even SHOWS the flag, inert). The main thread already knows
  # the exact loader compiling THIS process: its own --preload flag. No
  # loader means the user script's workers cannot load at all, so its
  # absence rejects here, named, instead of as per-worker startup noise.
  loaderPath = process.execArgv.find((a) -> a.startsWith('--preload='))?.slice('--preload='.length)
  abort 'error: swarm needs the rip loader for its workers: run via `swarm <script.rip>` or `rip <script.rip>`' unless loaderPath

  # state
  live     = 0
  done     = 0
  died     = 0
  info     = {}
  taskIdx  = 0
  fatal    = false
  inflight = {}  # slot -> taskPath (track in-flight tasks for crash recovery)
  lastTask = {}  # slot -> last completed task name (for display)

  high = {}

  # A job's event only marks the frame stale, and a resize marks the
  # whole frame for redrawing; a timer draws ten times a second, and only
  # when something changed. Drawing on every event made the terminal the
  # work: a run of 2,001 instant jobs wrote a megabyte of frames in a
  # seventh of a second, and a dragged window redrew once per event.
  stale = false
  reframe = false
  paint! = -> draw({ live, done, died, jobs, workers, info, inflight })
  redraw! = -> stale = true
  ticker = null
  unless quiet
    ticker = setInterval (->
      if reframe
        reframe = false
        drawFrame(workers)
        stale = true
      if stale
        stale = false
        paint()
    ), 100

  # signal handlers, for the run alone: swarm() returns to its script,
  # and a resize or interrupt after that is the script's own
  interrupted = ->
    unless quiet
      cursor(true)
      write go(workers + 6, 1) + "\n"
    exit(1)
  resized = -> reframe = true
  process.on 'SIGINT', interrupted
  process.on 'SIGWINCH', resized unless quiet

  # draw initial frame
  startTime = Date.now()
  unless quiet
    cursor(false)
    drawFrame(workers)
    paint()

  # create workers and dispatch tasks
  allWorkers = []

  Promise.new! (resolveAll) ->

    finished = false
    checkDone! = ->
      if not finished and done + died >= jobs
        finished = true
        for wk in allWorkers
          try wk.unref()
        resolveAll()

    dispatchNext! = (worker, slot) ->
      if taskIdx < tasks.length
        taskPath = tasks[taskIdx++]
        inflight[slot] = taskPath
        live++
        redraw()
        worker.postMessage { type: 'task', taskPath }
      else
        inflight[slot] = null
        checkDone()

    spawnWorker! = (slot) ->
      info[slot] ?= 0

      w = Worker.new(workerPath, { workerData: { scriptPath, context }, preload: [loaderPath] })
      allWorkers.push(w)

      w.on 'message', (msg) ->
        switch msg.type
          when 'error'
            logError "worker #{slot} startup: #{msg.error}"
            unless fatal
              fatal = true
              unless quiet
                cursor(true)
                write go(workers + 6, 1)
              abort "\nswarm: #{msg.error}"
          when 'ready'
            dispatchNext(w, slot)
          when 'done'
            move(msg.taskPath, _done)
            lastTask[slot] = base(msg.taskPath)
            inflight[slot] = null
            live--
            done++
            info[slot]++
            redraw()
            dispatchNext(w, slot)
          when 'failed'
            move(msg.taskPath, _died)
            lastTask[slot] = base(msg.taskPath)
            logError "#{base(msg.taskPath)}: #{msg.error or 'unknown'}"
            inflight[slot] = null
            live--
            died++
            info[slot]++
            redraw()
            dispatchNext(w, slot)

      w.on 'error', (err) ->
        logError "worker #{slot} error: #{err.message}"

      w.on 'exit', (code) ->
        logError "worker #{slot} exited with code #{code}, inflight: #{inflight[slot]}"
        # if worker crashed mid-task, count the in-flight task as died
        if inflight[slot]
          move(inflight[slot], _died)
          inflight[slot] = null
          live--
          died++
          info[slot]++
          redraw()
        # respawn if there's still work to do
        if done + died < jobs
          spawnWorker(slot)
        else
          checkDone()

    # spawn worker pool
    spawnWorker(slot) for slot in [1..Math.min(workers, jobs)]

  clearInterval ticker if ticker
  process.off 'SIGINT', interrupted
  process.off 'SIGWINCH', resized

  # summary
  secs = (Date.now() - startTime) / 1000
  if quiet
    p "#{secs.toFixed(2)} secs for #{jobs} jobs by #{workers} workers" + (" @ #{(jobs / secs).toFixed(2)} jobs/sec" if secs > 0 else "")
  else
    # the last frame, then each worker's stats beside its bar at its true
    # share of the busiest worker's jobs: the busiest exactly full, every
    # other bar where the run brought it, and a bar the hold kept above its
    # share settles to it, so the chart ends on who did the work
    paint()
    most = Math.max(...Object.values(info), 1)
    for slot, n of info
      rate = (n / secs).toFixed(1) if secs > 0 else '-'
      cols = cells jobs, jobs, n, most
      write go(parseInt(slot) + 1, len + 5) + fgw + bg("5383ec") + char.repeat(cols) + bg() + " ".repeat(wide - cols) + fg() + " │ #{n} jobs @ #{rate}/sec" + clear(true)
    cursor(true)
    write go(workers + 6, 1)
    write "#{secs.toFixed(2)} secs"
    write " for #{jobs} jobs"
    write " by #{workers} workers"
    write " @ #{(jobs / secs).toFixed(2)} jobs/sec" if secs > 0
    write "\n\n"

# ==============================================================================
# CLI helpers
# ==============================================================================

# flags that swarm consumes (with value)
_flagsWithValue = %w[-w --workers -b --bar -c --char -t --tag]
# flags that swarm consumes (standalone)
_flagsAlone     = %w[-r --reset -s --safe -q --quiet -h --help -v --version]

findArg = (args, short, long) ->
  for arg, i in args
    return args[i + 1] if arg in [short, long] and args[i + 1]?
    return arg.split('=')[1] if arg.startsWith("#{short}=") or arg.startsWith("#{long}=")
  null

# return process.argv with swarm's flags stripped: only your args remain
export args = ->
  result = []
  skip = false
  for arg in process.argv.slice(2)
    if skip
      skip = false
      continue
    if arg in _flagsWithValue
      skip = true
      continue
    continue if arg in _flagsAlone
    continue if _flagsWithValue.some (f) -> arg.startsWith("#{f}=")
    result.push(arg)
  result

# ==============================================================================
# The `swarm` command
# ==============================================================================
#
# swarm.rip is itself the bin: `swarm <script.rip> [options]` runs the
# job script exactly as `rip <script.rip> [options]` would. The argv is
# rewritten first so the script observes itself as the program: swarm()
# and args() read the script path and flags from there, and both entries
# see the identical shape. (In a worker thread this file is the ENTRY,
# so import.meta.main is true there too; hence the isMainThread guard.)

if import.meta.main and isMainThread
  VERSION = JSON.parse(readFileSync("#{import.meta.dir}/package.json", 'utf-8')).version

  script = process.argv[2]

  if script in ['-v', '--version']
    p "swarm #{VERSION}"
    exit(0)

  if script in ['-h', '--help']
    p """
      swarm #{VERSION} - parallel job runner with worker threads

      usage: swarm <script.rip> [options]

      Options:
        -w, --workers <n>     Number of workers (default: CPU count)
        -b, --bar <width>     Progress bar width (default: 20)
        -c, --char <ch>       Bar character (default: •)
        -t, --tag <name>      Keep the queue under .swarm/<name> (default: .swarm)
        -r, --reset           Remove the queue directory and quit
        -s, --safe            Set safe: true on the worker context
        -q, --quiet           No progress display, one summary line
        -h, --help            Show this help
        -v, --version         Show version

      The script runs exactly as `rip <script.rip>` would; remaining
      arguments after swarm's flags are yours (read them via args()).
      """
    exit(0)

  abort 'usage: swarm <script.rip> [options]' unless script

  path = resolve(script)
  abort "error: no such script: #{script}" unless existsSync(path)

  process.argv = [process.argv[0], path, ...process.argv.slice(3)]
  import!(pathToFileURL(path).href)

# ==============================================================================
# Worker entry
# ==============================================================================
#
# Each worker thread runs THIS file as its entry: it imports the user's
# job script, whose swarm() call starts the worker serving (above). A
# script that awaits swarm() never finishes loading in a worker; one that
# finishes without having started it named no perform function.

if not isMainThread and workerData?.scriptPath?
  try
    import!(pathToFileURL(workerData.scriptPath).href)
    raise 'No perform() function provided to swarm()' unless _serving
  catch err
    parentPort.postMessage { type: 'error', error: err.message }
