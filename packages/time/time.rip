# ==============================================================================
# rip/time — Rip Time: tiny, immutable, US-English date/time library
#
# Author: Steve Shreeve (steve.shreeve@gmail.com)
#   Date: April 19, 2026
#
# A pure-Rip date/time toolkit, inspired by time and scoped to US English:
#   - immutable wrapper over the native `Date` object
#   - parse / format / add / subtract / startOf / endOf / diff
#   - flexible auto-detect parsing (ISO, US m/d/yyyy, `Feb 9, 2024`,
#     `9-Feb-2024`, RFC 2822, ...) that never rolls over: Feb 30 is invalid
#   - get / set with either symbol units (`:year`) or strings (`'year'`)
#   - isBefore / isAfter / isSame / isSameOrBefore / isSameOrAfter /
#     isBetween / isValid / isLeapYear / isToday / isYesterday / isTomorrow
#   - fromNow / from / to / toNow / calendar (English)
#   - utc() / local() / isUTC() / utcOffset() / weekday()
#   - tz('HT' | 'Pacific/Honolulu' | ...) — all US zones + any IANA name,
#     DST-aware via the runtime's built-in Intl data
#   - dayOfYear / weekOfYear / quarter / daysInMonth
#   - customParseFormat built in — parse `MM/DD/YYYY`, `h:mm A`, etc.
#   - Duration — ISO-8601 parse/format, component getters, as*()/humanize()
#
# No locale registry, no plugin system — one file, zero deps, batteries in.
# ==============================================================================

# ==[ Types ]==

type Unit = symbol | string

type TimeInput = Time | Date | string | number | null | undefined

type DurationComponents =
  years?: number
  months?: number
  weeks?: number
  days?: number
  hours?: number
  minutes?: number
  seconds?: number
  milliseconds?: number

type DurationInput = number | string | DurationComponents

# What `time.parts(input)` returns: the components exactly as written, in
# calendar numbering (month 1..12, hour 0..23 with am/pm applied), the zone
# as written (minutes east of UTC) or null, and whether a clock was written.
type DateParts =
  year:   number
  month:  number
  day:    number
  hour:   number
  minute: number
  second: number
  ms:     number
  clock:  boolean
  zone:   number | null

# ==[ US Timezone Aliases ]==

# Short US zone names → IANA zone names. Accept both common abbreviations and
# unambiguous shorthand. `MT` means "Mountain Time (observes DST)"; Arizona
# users should pass `'AZ'` or `'America/Phoenix'` explicitly since it never
# observes DST. Anything containing a `/` is treated as a raw IANA name.
US_TIMEZONES =!
  ET:   'America/New_York'
  EST:  'America/New_York'
  EDT:  'America/New_York'
  CT:   'America/Chicago'
  CST:  'America/Chicago'
  CDT:  'America/Chicago'
  MT:   'America/Denver'
  MST:  'America/Denver'
  MDT:  'America/Denver'
  PT:   'America/Los_Angeles'
  PST:  'America/Los_Angeles'
  PDT:  'America/Los_Angeles'
  AKT:  'America/Anchorage'
  AKST: 'America/Anchorage'
  AKDT: 'America/Anchorage'
  HT:   'Pacific/Honolulu'
  HST:  'Pacific/Honolulu'
  HAST: 'Pacific/Honolulu'
  HADT: 'America/Adak'          # Hawaii-Aleutian DST zone (western AK)
  AZ:   'America/Phoenix'       # Arizona, no DST
  AST:  'America/Puerto_Rico'   # Atlantic (PR, USVI)
  ChST: 'Pacific/Guam'          # Chamorro (Guam, CNMI)
  SST:  'Pacific/Pago_Pago'     # Samoa

def resolveZone(zone)
  return zone unless zone
  return zone if typeof zone is 'string' and zone.includes('/')
  US_TIMEZONES[zone] ?? zone

# ==[ Time Constants ]==

MS_SECOND =! 1000
MS_MINUTE =! 60 * MS_SECOND
MS_HOUR   =! 60 * MS_MINUTE
MS_DAY    =! 24 * MS_HOUR
MS_WEEK   =! 7  * MS_DAY

INVALID_DATE =! 'Invalid Date'
ISO_FORMAT   =! 'YYYY-MM-DDTHH:mm:ssZ'
UTC_FORMAT   =! 'YYYY-MM-DDTHH:mm:ss[Z]'

# ==[ English Locale (baked in) ]==

WEEKDAYS       =! 'Sunday Monday Tuesday Wednesday Thursday Friday Saturday'.split(' ')
WEEKDAYS_SHORT =! 'Sun Mon Tue Wed Thu Fri Sat'.split(' ')
WEEKDAYS_MIN   =! 'Su Mo Tu We Th Fr Sa'.split(' ')
MONTHS         =! 'January February March April May June July August September October November December'.split(' ')
MONTHS_SHORT   =! 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split(' ')

RELATIVE_TIME =!
  future: 'in %s'
  past:   '%s ago'
  s:      'a few seconds'
  m:      'a minute'
  mm:     '%d minutes'
  h:      'an hour'
  hh:     '%d hours'
  d:      'a day'
  dd:     '%d days'
  M:      'a month'
  MM:     '%d months'
  y:      'a year'
  yy:     '%d years'

CALENDAR_FORMAT =!
  sameDay:  '[Today at] h:mm A'
  nextDay:  '[Tomorrow at] h:mm A'
  nextWeek: 'dddd [at] h:mm A'
  lastDay:  '[Yesterday at] h:mm A'
  lastWeek: '[Last] dddd [at] h:mm A'
  sameElse: 'MM/DD/YYYY'

RELATIVE_THRESHOLDS =! [
  { l: 's',  r: 44, d: :second  }
  { l: 'm',  r: 89               }
  { l: 'mm', r: 44, d: :minute   }
  { l: 'h',  r: 89               }
  { l: 'hh', r: 21, d: :hour     }
  { l: 'd',  r: 35               }
  { l: 'dd', r: 25, d: :day      }
  { l: 'M',  r: 45               }
  { l: 'MM', r: 10, d: :month    }
  { l: 'y',  r: 17               }
  { l: 'yy',        d: :year     }
]

# ==[ Regex ]==

REGEX_FORMAT   =! /\[([^\]]+)\]|YYYY|YY|MMMM|MMM|MM|M|Do|DD|D|dddd|ddd|dd|d|HH|H|hh|h|mm|m|ss|s|SSS|a|A|Q|ZZ|Z|zzz|z/g
REGEX_PARSE    =! /(\[[^\[]*\])|([\-_:\/.,()\s]+)|(YYYY|YY|MMMM|MMM|MM|M|DD|D|HH|H|hh|h|mm|m|ss|s|SSS|SS|S|a|A|Q|ZZ|Z)/g

# ---- Auto-detect grammar (see parseDate) ----
#
# Flexible about spelling, strict about the calendar. The grammar reads the
# components as written; `assemble` then refuses anything that is not a real
# calendar date or clock, so Feb 30 never becomes Mar 1. The date is one
# alternation, after the `parse_str` regex in zones.rb: the compact form and
# three orderings. THE RULE: day-first is recognized only when the month is
# spelled with letters (`9 Feb 2024`, `09-FEB-2024`, `9Feb2024`); a purely
# numeric small form is ALWAYS month-first (US), so `1/2/2024` is January 2
# and `25/12/2024` is simply invalid (month 25). There is deliberately no
# "swap when the first number is > 12" guess — guessing is how Feb 30
# becomes Mar 1.
#
# Input is trimmed and whitespace-collapsed first, and the noise dropped;
# the date is matched only up to its end, and whatever follows is the time.
# Separators are `-`, `/`, `.` or a space, and need not agree: `2024-02/29`
# is as readable as `2024-02-29`.

# Noise the grammar ignores: a leading weekday (`Mon`, `Monday`, `Mon.`,
# `Mon,`) and an ordinal suffix on a day (`1st`, `22nd`).
REGEX_NOISE =! /^(?:sun|mon|tue|wed|thu|fri|sat)[a-z]*\.?,?\s|(?<=\d)(?:st|nd|rd|th)\b/gi

# The date, in the orders people write one. Every branch names its parts
# `y`, `m`, `d` (and `t`, digits glued on after a compact date), so the
# match says what was written without asking which branch matched.
REGEX_DATE =! ///
  ^(?:
      (?<y>(?:19|20)\d\d)(?<m>\d\d)(?<d>\d\d)(?<t>\d*)           # compact: 20240229, 202402291430[00]
  | # or...
      (?<d>0[1-9]|[12]\d|3[01]|[1-9](?!\d))[-/.\s]?               # day
      (?<m>[a-z]{3,9}\.?)[-/.\s]?                                 # month, by name only (day-first is never numeric)
      (?<y>(?:19|20)\d\d)                                         # year:  9 Feb 2024, 09-FEB-2024, 9Feb2024
  | # or...
      (?<y>(?:19|20)\d\d)                                         # year
      (?:[-/.\s]?(?<m>0[1-9]|1[012]|[1-9](?!\d)|[a-z]{3,9}\.?)    # month
      (?:[-/.\s]?(?<d>0[1-9]|[12]\d|3[01]|[1-9](?!\d)))?)?        # day:   2024-02-29, 2024/2/9, 2024 Feb 9, 2024Feb9, 2024-02, 2024
  | # or...
      (?<m>0[1-9]|1[012]|[1-9](?!\d)|[a-z]{3,9}\.?)[-/.\s]?       # month
      (?<d>0[1-9]|[12]\d|3[01]|[1-9](?!\d)),?[-/.\s]?             # day
      (?<y>(?:19|20)\d\d|(?<=[-/.])\d\d)                          # year, 2 digits only after a separator: 2/9/2024, Feb 9 2024, Feb. 9, 2024, 2.9.24
  )
///i

# The time after a date. A bare hour needs am/pm (`3 PM`, never `3`); the
# fraction is a decimal fraction of a second (`.25` = 250 ms). A zone is read
# only here, after a time, so `2024-02-29+05:00` is invalid.
REGEX_TIME =! ///
  ^(?:T|,?\sat\s|\s|,\s)                                 # after the date: T, a space, ", " or " at "
  (?: (?<h>\d\d?)                                        # hour
      (?::(?<m>\d\d))?                                   # :minute
      (?::(?<s>\d\d)(?:[.,](?<f>\d+))?)?                 # :second[.fraction]
  | # or, without colons (so a 2-digit hour: `930` is ambiguous)...
      (?<h>\d\d)(?<m>\d\d)                               # hour minute
      (?:(?<s>\d\d)(?:[.,](?<f>\d+))?)?                  # second[.fraction]
  )
  (?:\s?(?<ap>[ap])\.?m\.?)?                             # am, pm, a.m., p.m.
  (?:\s?(?<z>z|utc|gmt                                  # zone: Z, UTC, GMT
        |(?:utc|gmt)?[+-]\d\d(?::?\d\d)?))?              #   or an offset: +05:30, +0530, GMT-0700
  (?:\s?\([^)]*\))?$                                     # (Mountain Standard Time), then nothing
///i

# ==[ Unit Normalization ]==

# Accept any of: `:year`, `'year'`, `'years'`, `'y'`, `'Y'`, `'yr'` → `:year`
# Returns a canonical symbol. Unknown units pass through as the string.
UNIT_ALIASES =!
  y:    :year
  yr:   :year
  yrs:  :year
  year: :year
  M:    :month
  mo:   :month
  mon:  :month
  w:    :week
  wk:   :week
  d:    :day
  D:    :date
  dt:   :date
  date: :date
  h:    :hour
  hr:   :hour
  m:    :minute
  min:  :minute
  s:    :second
  sec:  :second
  ms:   :millisecond
  msec: :millisecond
  Q:    :quarter
  q:    :quarter

def prettyUnit(u)
  return :millisecond unless u?
  return u if typeof u is 'symbol'
  key = String(u).replace(/s$/, '')
  UNIT_ALIASES[key] ?? Symbol.for(key.toLowerCase())

# ==[ Small Helpers ]==

def pad(n, len = 2)
  s = String(n)
  return s if s.length >= len
  '0'.repeat(len - s.length) + s

def absFloor(n)
  n < 0 ? Math.ceil(n) or 0 : Math.floor(n)

def ordinalSuffix(n)
  v = n % 100
  return 'th' if v >= 11 and v <= 13
  switch n % 10
    when 1 then 'st'
    when 2 then 'nd'
    when 3 then 'rd'
    else 'th'

def meridiem(hour, lowercase)
  m = hour < 12 ? 'AM' : 'PM'
  lowercase ? m.toLowerCase() : m

def tzOffsetString(instance)
  mins  = -instance.utcOffset()
  abs   = Math.abs(mins)
  hours = Math.floor(abs / 60)
  rest  = abs % 60
  sign  = mins <= 0 ? '+' : '-'
  "#{sign}#{pad(hours, 2)}:#{pad(rest, 2)}"

# Extract wall-clock parts for `date` as they appear in `zone`. Uses the
# runtime's built-in Intl data (IANA) so DST transitions are handled for free.
# Cache the formatter per-zone — construction is the expensive part.
_zoneFormatters =! {}

def zoneFormatter(zone)
  _zoneFormatters[zone] ?? do ->
    _zoneFormatters[zone] = Intl.DateTimeFormat.new 'en-US',
      hour12:   false
      timeZone: zone
      year:   'numeric'
      month:  '2-digit'
      day:    '2-digit'
      hour:   '2-digit'
      minute: '2-digit'
      second: '2-digit'

def zonedParts(date, zone)
  out: Record<string, string> = {}
  for { type, value } in zoneFormatter(zone).formatToParts(date)
    out[type] = value
  # Some platforms report midnight as 24:00:00 in en-US; normalize.
  out.hour = '00' if out.hour is '24'
  out

# Returns the zone's offset from UTC, in minutes EAST of UTC (time convention).
# Honolulu => -600, New York winter => -300, New York summer => -240, UTC => 0.
def zoneOffsetMinutes(date, zone)
  p = zonedParts(date, zone)
  asUTC = Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute, +p.second)
  Math.round((asUTC - date.getTime()) / 60000)

# Zone name abbreviation (e.g., "HST", "EDT") or long name ("Eastern Daylight Time").
# Cached per (zone, long) pair for hot-path use.
_zoneNameFormatters =! {}

def zoneAbbreviation(date, zone, long = false)
  key = "#{zone ?? 'local'}|#{long ? 'L' : 'S'}"
  dtf = _zoneNameFormatters[key] ?? do ->
    _zoneNameFormatters[key] = Intl.DateTimeFormat.new 'en-US',
      timeZone: zone ?? undefined
      timeZoneName: long ? 'long' : 'short'
  for { type, value } in dtf.formatToParts(date)
    return value if type is 'timeZoneName'
  ''

# time's month-diff algorithm, kept bit-for-bit so diff(:month) and
# diff(:year) results match the reference implementation.
def monthDiff(a, b)
  return -monthDiff(b, a) if a.date() < b.date()
  whole   = ((b.year() - a.year()) * 12) + (b.month() - a.month())
  anchor  = a.clone().add(whole, :month)
  c       = b - anchor < 0
  anchor2 = a.clone().add(whole + (c ? -1 : 1), :month)
  +(-(whole + ((b - anchor) / (c ? (anchor - anchor2) : (anchor2 - anchor)))) or 0)

# ==[ Parsing ]==

# Parsing is flexible about spelling and strict about the calendar and clock:
# every component is range-checked (leap-aware) and an out-of-range value
# yields an invalid Date instead of rolling over — Feb 30 never becomes Mar 1,
# 24:00 never becomes tomorrow. This applies to auto-detect (`parseDate`) and
# explicit formats (`parseWithFormat`) alike; both end in `assemble`.

DAYS_IN_MONTH =! [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

def isLeap(y)
  (y % 4 is 0 and y % 100 isnt 0) or y % 400 is 0

# month is 1..12 here (calendar numbering, not the Date object's 0..11)
def daysInMonth(y, m)
  return 29 if m is 2 and isLeap(y)
  DAYS_IN_MONTH[m] ?? 0

# Zone designator → signed offset in minutes east of UTC (`+05:30` → 330),
# or null if unrecognized. Accepts `Z`, `UTC`, `GMT`, `±HH`, `±HHMM`,
# `±HH:MM` and `GMT±HH:MM` (case-insensitive).
def parseOffset(s)
  return null unless s
  return 0 if /^(?:z|utc|gmt)$/i.test(s)
  m = s.match(/^(?:utc|gmt)?([+-])(\d{2}):?(\d{2})?$/i)
  return null unless m
  hh = +m[2]
  mm = +(m[3] ?? 0)
  return null if hh > 23 or mm > 59
  (m[1] is '-' ? -1 : 1) * (hh * 60 + mm)

# `24` → 2024, `69` → 1969 (n > 68 is 19nn, else 20nn)
def parseTwoDigitYear(n)
  n = +n
  n + (n > 68 ? 1900 : 2000)

# Month name → 1..12, or 0 if it isn't one. Accepts the full name or any
# unambiguous prefix of 3+ letters (`Feb`, `Sept`, `Febr`), any case, with an
# optional trailing period (`Feb.`). Every 3-letter prefix is unambiguous, so
# the standard abbreviations all work.
def parseMonthName(w)
  w = w.toLowerCase().replace(/\.$/, '')
  return 0 if w.length < 3
  hits = MONTHS.filter (x) -> x.toLowerCase().startsWith(w)
  if hits.length is 1 then MONTHS.indexOf(hits[0]) + 1 else 0

# Hour as written (+ am/pm) → 0..23, or null when out of range for the form
# (1..12 with am/pm, 0..23 without).
def toHour24(hour, meridiem)
  return (if hour >= 0 and hour <= 23 then hour else null) unless meridiem?
  return null unless hour >= 1 and hour <= 12
  return 0 if meridiem is 'am' and hour is 12
  if meridiem is 'pm' and hour < 12 then hour + 12 else hour

# Range-check every component and build the Date. `parts` uses calendar
# numbering (month 1..12); `meridiem` is 'am' | 'pm' | null; `zone` is the
# signed offset in minutes east of UTC, or null when the string had none.
# Returns an invalid Date when anything is out of range — no rollover, ever.
#
# With a zone (either mode) the instant is the wall clock minus the offset,
# via `Date.UTC`; with `utc` and no zone the components are UTC; otherwise
# they are the local wall clock.
def assemble(parts, utc)
  { year, month, day, hour, minute, second, ms, meridiem, zone } = parts
  return Date.new(NaN) unless year >= 0 and year <= 9999
  return Date.new(NaN) unless month >= 1 and month <= 12
  return Date.new(NaN) unless day >= 1 and day <= daysInMonth(year, month)
  h = toHour24(hour, meridiem)
  return Date.new(NaN) unless h?
  return Date.new(NaN) unless minute >= 0 and minute <= 59
  return Date.new(NaN) unless second >= 0 and second <= 59
  return Date.new(NaN) unless ms >= 0 and ms <= 999
  # Date.UTC / new Date map years 0..99 to 1900..1999; set the year explicitly.
  if zone? or utc
    d = Date.new(Date.UTC(year, month - 1, day, h, minute, second, ms))
    d.setUTCFullYear(year, month - 1, day) if year < 100
    d = Date.new(d.getTime() - zone * MS_MINUTE) if zone
  else
    d = Date.new(year, month - 1, day, h, minute, second, ms)
    d.setFullYear(year, month - 1, day) if year < 100
  d

# Parse a string against an explicit format like `'MM/DD/YYYY h:mm A'`.
# Returns a Date (invalid if a component is out of range) or null if the
# format doesn't match. Uses an internal bail exception so each branch can
# just `bail()` on mismatch.
class ParseMismatch extends Error then noop

bail =! -> throw ParseMismatch.new()

def parseWithFormat(input, fmt, utc = false)
  parts  = { year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0, ms: 0, meridiem: null, zone: null }
  cursor = 0

  readNum = (len) ->
    slice = input.slice(cursor).match(/^\d+/)
    bail() unless slice
    n = slice[0].slice(0, len)
    cursor += n.length
    +n

  readWord = ->
    slice = input.slice(cursor).match(/^\d*[^-_:\/.,()\s\d]+/)
    bail() unless slice
    cursor += slice[0].length
    slice[0]

  readStr = (s) ->
    bail() unless input.slice(cursor, cursor + s.length) is s
    cursor += s.length

  try
    for token in fmt.match(REGEX_PARSE) ?? []
      if token[0] is '[' and token[token.length - 1] is ']'
        readStr(token.slice(1, -1))
        continue
      if /^[\-_:\/.,()\s]+$/.test(token)
        while cursor < input.length and /[\-_:\/.,()\s]/.test(input[cursor])
          cursor++
        continue

      switch token
        when 'YYYY'        then parts.year   = readNum(4)
        when 'YY'          then parts.year   = parseTwoDigitYear(readNum(2))
        when 'M', 'MM'     then parts.month  = readNum(2)
        when 'MMM', 'MMMM'
          parts.month = parseMonthName(readWord())
          bail() if parts.month is 0
        when 'D', 'DD'     then parts.day    = readNum(2)
        when 'H', 'HH', 'h', 'hh' then parts.hour = readNum(2)
        when 'm', 'mm'     then parts.minute = readNum(2)
        when 's', 'ss'     then parts.second = readNum(2)
        when 'SSS'         then parts.ms     = readNum(3)
        when 'SS'          then parts.ms     = readNum(2) * 10
        when 'S'           then parts.ms     = readNum(1) * 100
        when 'A', 'a'      then parts.meridiem = /^p/i.test(readWord()) ? 'pm' : 'am'
        when 'Z', 'ZZ'
          slice = input.slice(cursor).match(/^(Z|[+-]\d\d:?\d{0,2})/)
          bail() unless slice
          cursor += slice[0].length
          parts.zone = parseOffset(slice[0])
          bail() unless parts.zone?
        when 'Q'           then parts.month = (readNum(1) - 1) * 3 + 1
        else readStr(token)
  catch e
    return null if e instanceof ParseMismatch
    throw e

  assemble(parts, utc)

# ---- Reading a string ----

# The time part, or null when `rest` is not one. Empty means midnight.
def parseTime(rest)
  return { hour: 0, minute: 0, second: 0, ms: 0, meridiem: null, zone: null } if rest is ''
  g = rest.match(REGEX_TIME)?.groups
  return null unless g
  return null unless g.m? or g.ap?                          # a bare hour needs am/pm
  zone = if g.z? then parseOffset(g.z) else null
  return null if g.z? and not zone?
  hour:     +g.h
  minute:   +(g.m ?? 0)
  second:   +(g.s ?? 0)
  ms:       +((g.f ?? '') + '000').slice(0, 3)
  meridiem: if g.ap? then (if /a/i.test(g.ap) then 'am' else 'pm') else null
  zone:     zone

# Run the grammar over a string: { parts, date } when the string is a shape
# we know — `parts` as written (plus `clock`, whether a time was written) and
# `date` assemble's verdict, invalid when a component is out of range — or
# null when it is not. There is no engine fallback: a string the grammar does
# not read is not a date, as the Ruby raised "can't parse".
def readParts(input, utc)
  s = input.trim().replace(/\s+/g, ' ').replace(REGEX_NOISE, '')
  m = s.match(REGEX_DATE)
  return null unless m
  { y, m: mo, d, t } = m.groups
  rest = (if t then "T#{t}" else '') + s.slice(m[0].length)   # a glued compact clock reads as `T1430`
  time = parseTime(rest)
  return null unless time
  parts = Object.assign time,
    year:  if y.length is 2 then parseTwoDigitYear(y) else +y
    month: if not mo? then 1 else if /^\d/.test(mo) then +mo else parseMonthName(mo)
    day:   +(d ?? 1)
    clock: rest isnt ''
  { parts, date: assemble(parts, utc) }

# `time.parts(input)`: the components exactly as written, for a string the
# grammar recognizes that passes every range check; null otherwise. No engine
# fallback — only the grammar counts. The zone is reported, not applied.
def dateParts(input)
  return null unless typeof input is 'string'
  r = readParts(input, true)
  return null unless r and not isNaN(r.date.getTime())
  { year, month, day, hour, minute, second, ms, meridiem, zone, clock } = r.parts
  { year, month, day, hour: toHour24(hour, meridiem), minute, second, ms, clock, zone }

# Auto-detect parsing. Never throws; a string the grammar does not read, or
# reads as an impossible date, is an invalid Date.
def parseDate(input, utc = false)
  return Date.new(NaN) if input is null
  return Date.new()    unless input?
  return Date.new(input.getTime()) if input instanceof Date
  return Date.new(input) if typeof input is 'number'
  return readParts(input, utc)?.date ?? Date.new(NaN) if typeof input is 'string'
  Date.new(input)

# ==[ Time class ]==

IS_TIME_TAG =! '$isTimeObject'

export def isTime(x: unknown): boolean
  x instanceof Time or !!(x and x[IS_TIME_TAG])

# `$d` is the backing native Date; `$y…$ms` are the cached wall-clock
# components in the instance's mode/zone.
export class Time
  constructor: (cfg: { input?: TimeInput, fromInstance?: Date, utc?: boolean, zone?: string | null, format?: string } = {}) ->
    @$u     = !!cfg.utc
    @$z     = cfg.zone ?? null          # IANA zone name, or null for local/UTC
    @$d     = if cfg.fromInstance then cfg.fromInstance else parseDate(cfg.input, @$u)
    @$fmt   = cfg.format                # only set when coming from parseWithFormat
    @[IS_TIME_TAG] = true
    @_refresh()

  _refresh: (): Time ->
    d = @$d
    if @$z
      p = zonedParts(d, @$z)
      @$y:  number = +p.year
      @$M:  number = +p.month - 1
      @$D:  number = +p.day
      @$H:  number = +p.hour
      @$m:  number = +p.minute
      @$s:  number = +p.second
      @$ms: number = d.getUTCMilliseconds()    # Intl doesn't give milliseconds
      # Derive weekday from reconstructed wall-clock date (zone-independent).
      @$W:  number = Date.new(Date.UTC(@$y, @$M, @$D)).getUTCDay()
    else if @$u
      @$y  = d.getUTCFullYear()
      @$M  = d.getUTCMonth()
      @$D  = d.getUTCDate()
      @$W  = d.getUTCDay()
      @$H  = d.getUTCHours()
      @$m  = d.getUTCMinutes()
      @$s  = d.getUTCSeconds()
      @$ms = d.getUTCMilliseconds()
    else
      @$y  = d.getFullYear()
      @$M  = d.getMonth()
      @$D  = d.getDate()
      @$W  = d.getDay()
      @$H  = d.getHours()
      @$m  = d.getMinutes()
      @$s  = d.getSeconds()
      @$ms = d.getMilliseconds()
    this

  # ---- Validity & identity ----
  isValid: (): boolean -> @$d.toString() isnt INVALID_DATE
  clone: (): Time ->
    Time.new({ fromInstance: Date.new(@$d.getTime()), utc: @$u, zone: @$z })

  # ---- Getters (symbol or method form) ----
  year:        (): number -> @$y
  month:       (): number -> @$M          # 0..11
  date:        (): number -> @$D          # 1..31
  day:         (): number -> @$W          # 0..6 (Sun=0)
  hour:        (): number -> @$H
  minute:      (): number -> @$m
  second:      (): number -> @$s
  millisecond: (): number -> @$ms
  quarter:     (): number -> Math.floor(@$M / 3) + 1

  daysInMonth: (): number -> @endOf(:month).$D
  isLeapYear:  (): boolean -> (@$y % 4 is 0 and @$y % 100 isnt 0) or (@$y % 400 is 0)

  dayOfYear: (): number ->
    start = Date.new(Date.UTC(@$y, 0, 1))
    here  = Date.new(Date.UTC(@$y, @$M, @$D))
    Math.floor((here.getTime() - start.getTime()) / MS_DAY) + 1

  # ISO-ish week-of-year with configurable Sunday start (US default).
  weekOfYear: (startDow: number = 0): number ->
    # move to the first day of this week
    gap    = (@$W - startDow + 7) % 7
    start  = @subtract(gap, :day).startOf(:day)
    yrStart= time(Date.new(start.year(), 0, 1))
    yrGap  = (yrStart.day() - startDow + 7) % 7
    anchor = yrStart.subtract(yrGap, :day)
    Math.round((start.valueOf() - anchor.valueOf()) / MS_WEEK) + 1

  # ---- Generic get / set ----
  get: (u: Unit): number | undefined ->
    switch prettyUnit(u)
      when :year        then @$y
      when :month       then @$M
      when :date        then @$D
      when :day         then @$W
      when :hour        then @$H
      when :minute      then @$m
      when :second      then @$s
      when :millisecond then @$ms
      when :quarter     then @quarter()
      else undefined

  set: (u: Unit, v: number): Time ->
    @clone()._mutSet(prettyUnit(u), v)

  # In-place setter used after clone(). Never call on an instance you don't own.
  _mutSet: (unit: symbol, int: number): Time ->
    utcPad = @$u ? 'setUTC' : 'set'
    methodName = switch unit
      when :year        then "#{utcPad}FullYear"
      when :month       then "#{utcPad}Month"
      when :date, :day  then "#{utcPad}Date"
      when :hour        then "#{utcPad}Hours"
      when :minute      then "#{utcPad}Minutes"
      when :second      then "#{utcPad}Seconds"
      when :millisecond then "#{utcPad}Milliseconds"
      else null
    return this unless methodName
    arg = unit is :day ? @$D + (int - @$W) : int

    if unit is :month or unit is :year
      tmp = Date.new(@$d.getTime())
      if @$u
        tmp.setUTCDate(1)
      else
        tmp.setDate(1)
      tmp[methodName](arg)
      # clamp date to month length
      mDays = daysInGivenMonth(tmp, @$u)
      origDay = @$D
      if @$u
        tmp.setUTCDate(Math.min(origDay, mDays))
      else
        tmp.setDate(Math.min(origDay, mDays))
      @$d = tmp
    else
      @$d[methodName](arg)

    @_refresh()
    this

  # ---- Arithmetic ----
  add: (amount: number | Duration, u?: Unit): Time ->
    # Accept a Duration as a single argument: d.add(dur)
    if amount instanceof Duration
      return applyDuration(this, amount, 1)

    number = Number(amount)
    unit = prettyUnit(u)

    if unit is :year
      return @set(:year, @$y + number)
    if unit is :month
      return @set(:month, @$M + number)
    if unit is :day
      return @_addDays(number)
    if unit is :week
      return @_addDays(number * 7)

    step = switch unit
      when :hour        then MS_HOUR
      when :minute      then MS_MINUTE
      when :second      then MS_SECOND
      when :millisecond then 1
      else 1
    ms = @$d.getTime() + (number * step)
    Time.new({ fromInstance: Date.new(ms), utc: @$u })

  _addDays: (n: number): Time ->
    d = @clone()
    if @$u
      d.$d.setUTCDate(d.$D + Math.round(n))
    else
      d.$d.setDate(d.$D + Math.round(n))
    d._refresh()

  subtract: (n: number | Duration, u?: Unit): Time ->
    return applyDuration(this, n, -1) if n instanceof Duration
    @add(-n, u)

  # ---- startOf / endOf ----
  startOf: (u: Unit, isStartOf: boolean = true): Time -> @_bound(prettyUnit(u), isStartOf)
  endOf:   (u: Unit): Time -> @_bound(prettyUnit(u), false)

  _bound: (unit: symbol, isStart: boolean): Time ->
    make = (y, m, d) =>
      stamp = @$u ? Date.UTC(y, m, d) : Date.new(y, m, d).getTime()
      ins = Time.new({ fromInstance: Date.new(stamp), utc: @$u })
      isStart ? ins : ins._endOfDay()

    switch unit
      when :year
        isStart ? make(@$y, 0, 1) : make(@$y, 11, 31)
      when :quarter
        q = @quarter() - 1
        isStart ? make(@$y, q * 3, 1) : make(@$y, (q * 3) + 3, 0)
      when :month
        isStart ? make(@$y, @$M, 1) : make(@$y, @$M + 1, 0)
      when :week
        gap = @$W   # Sunday-start
        isStart ? make(@$y, @$M, @$D - gap) : make(@$y, @$M, @$D + (6 - gap))
      when :day, :date
        @_setClock(isStart ? [0, 0, 0, 0] : [23, 59, 59, 999])
      when :hour
        @_setClock(isStart ? [@$H, 0, 0, 0] : [@$H, 59, 59, 999])
      when :minute
        @_setClock(isStart ? [@$H, @$m, 0, 0] : [@$H, @$m, 59, 999])
      when :second
        @_setClock(isStart ? [@$H, @$m, @$s, 0] : [@$H, @$m, @$s, 999])
      else
        @clone()

  _endOfDay: (): Time -> @_setClock([23, 59, 59, 999])

  _setClock: (hms: [number, number, number, number]): Time ->
    d = @clone()
    if @$u
      d.$d.setUTCHours(...hms)
    else
      d.$d.setHours(...hms)
    d._refresh()

  # ---- Comparison ----
  isSame: (that: TimeInput, u?: Unit): boolean ->
    other = time(that)
    unit  = u ?? :millisecond
    @startOf(unit) <= other and other <= @endOf(unit)

  isBefore: (that: TimeInput, u?: Unit): boolean ->
    unit = u ?? :millisecond
    time(that) > @endOf(unit)

  isAfter: (that: TimeInput, u?: Unit): boolean ->
    unit = u ?? :millisecond
    time(that) < @startOf(unit)

  isSameOrBefore: (that: TimeInput, u?: Unit): boolean -> @isSame(that, u) or @isBefore(that, u)
  isSameOrAfter:  (that: TimeInput, u?: Unit): boolean -> @isSame(that, u) or @isAfter(that, u)

  isToday:     (): boolean -> @format('YYYY-MM-DD') is time().format('YYYY-MM-DD')
  isYesterday: (): boolean -> @format('YYYY-MM-DD') is time().subtract(1, :day).format('YYYY-MM-DD')
  isTomorrow:  (): boolean -> @format('YYYY-MM-DD') is time().add(1, :day).format('YYYY-MM-DD')

  # Day of week relative to Sunday (US week start). As a getter this is a
  # direct alias for `.day()`; as a setter it moves to day-of-week `input`
  # within the current week (0=Sun, 1=Mon, ..., 6=Sat).
  weekday: (input?: number): number | Time ->
    return @$W unless input?
    @subtract(@$W, :day).add(input, :day)

  # Humanize a datetime relative to a reference (default: now).
  # Uses the same buckets as moment.js calendar(): yesterday, today, tomorrow,
  # last/next week, or a plain MM/DD/YYYY fallback.
  calendar: (reference?: TimeInput, formats: Record<string, string | ((this: Time, now: Time) => string)> = {}): string ->
    ref  = (if reference? then time(reference) else time()).startOf(:day)
    diff = @diff(ref, :day, true)
    bucket = switch
      when diff < -6 then 'sameElse'
      when diff < -1 then 'lastWeek'
      when diff <  0 then 'lastDay'
      when diff <  1 then 'sameDay'
      when diff <  2 then 'nextDay'
      when diff <  7 then 'nextWeek'
      else 'sameElse'
    fmt = formats[bucket] ?? CALENDAR_FORMAT[bucket]
    return fmt.call(this, time()) if typeof fmt is 'function'
    @format(fmt)

  # inclusivity: '()' exclusive, '[]' inclusive, '[)' / '(]' mixed
  isBetween: (from: TimeInput, to: TimeInput, u?: Unit, inc?: '()' | '[]' | '[)' | '(]'): boolean ->
    unit  = u ?? :millisecond
    range = inc ?? '()'
    a = time(from)
    b = time(to)
    [a, b] = [b, a] if a > b
    leftOk  = range[0] is '[' ? not @isBefore(a, unit) : @isAfter(a, unit)
    rightOk = range[1] is ']' ? not @isAfter(b, unit)  : @isBefore(b, unit)
    leftOk and rightOk

  # ---- Diff ----
  diff: (input: TimeInput, u?: Unit, float: boolean = false): number ->
    unit  = prettyUnit(u)
    that  = time(input)
    zDelt = (that.utcOffset() - @utcOffset()) * MS_MINUTE
    raw   = @valueOf() - that.valueOf()

    result = switch unit
      when :year    then monthDiff(this, that) / 12
      when :quarter then monthDiff(this, that) / 3
      when :month   then monthDiff(this, that)
      when :week    then (raw - zDelt) / MS_WEEK
      when :day     then (raw - zDelt) / MS_DAY
      when :hour    then raw / MS_HOUR
      when :minute  then raw / MS_MINUTE
      when :second  then raw / MS_SECOND
      else raw   # milliseconds

    if float then result else absFloor(result)

  # ---- UTC / timezone mode ----
  utc: (keepLocalTime: boolean = false): Time ->
    ins = Time.new({ fromInstance: Date.new(@$d.getTime()), utc: true })
    keepLocalTime ? ins.add(@utcOffset(), :minute) : ins

  local: (): Time ->
    Time.new({ fromInstance: Date.new(@$d.getTime()), utc: false })

  isUTC: (): boolean -> @$u

  # Convert this instant into `zone` for display purposes. The underlying UTC
  # timestamp is preserved unless `keepLocalTime` is true, in which case the
  # wall-clock numbers are preserved and the instant shifts.
  tz: (zone: string, keepLocalTime: boolean = false): Time ->
    iana = resolveZone(zone)
    ins  = Time.new({ fromInstance: Date.new(@$d.getTime()), zone: iana })
    return ins unless keepLocalTime
    # Recompute the Date so the wall-clock in `iana` matches this instance's.
    target = Date.UTC(@$y, @$M, @$D, @$H, @$m, @$s, @$ms)
    offset = zoneOffsetMinutes(Date.new(target), iana)
    shifted = Date.new(target - offset * 60000)
    # DST boundary: re-check offset at the resulting instant and re-apply if
    # the zone's offset has changed between the two moments.
    offset2 = zoneOffsetMinutes(shifted, iana)
    if offset2 isnt offset
      shifted = Date.new(target - offset2 * 60000)
    Time.new({ fromInstance: shifted, zone: iana })

  # Legible names for the two zone operations (otherwise hidden behind tz()'s
  # keepLocalTime flag), mirroring the `zones` gem's to/as distinction:
  #   toZone — CONVERT: same instant, shown in `zone` (the wall-clock changes)
  #   asZone — REINTERPRET: same wall-clock numbers, now in `zone` (the instant changes)
  toZone: (zone: string): Time -> @tz(zone)
  asZone: (zone: string): Time -> @tz(zone, true)

  # Reinterpret this instance's wall-clock as UTC — keep the numbers, label them
  # UTC (the instant shifts). The inverse — show this instant in UTC — is utc().
  # This is the primitive for a naive (zoneless) timestamp that is really UTC.
  asUTC: (): Time -> @utc(true)

  # The IANA zone name this instance is anchored to, or null for local/UTC.
  timezone: (): string | null -> @$z

  # Rounded to the nearest 15 minutes per the FF24 workaround in upstream.
  utcOffset: (): number ->
    return zoneOffsetMinutes(@$d, @$z) if @$z
    return 0 if @$u
    -Math.round(@$d.getTimezoneOffset() / 15) * 15

  # ---- Output ----
  valueOf:     (): number -> @$d.getTime()
  unix:        (): number -> Math.floor(@valueOf() / 1000)
  toDate:      (): Date -> Date.new(@valueOf())
  toJSON:      (): string | null -> @isValid() ? @toISOString() : null
  toISOString: (): string -> @$d.toISOString()
  toString:    (): string -> @$d.toUTCString()

  # ---- Relative time (English, fixed thresholds) ----
  fromNow: (withoutSuffix?: boolean): string -> @from(time(), withoutSuffix)
  toNow:   (withoutSuffix?: boolean): string -> @to(time(), withoutSuffix)
  from:    (input: TimeInput, withoutSuffix?: boolean): string -> fromToBase(input, withoutSuffix, this, false)
  to:      (input: TimeInput, withoutSuffix?: boolean): string -> fromToBase(input, withoutSuffix, this, true)

  # ---- Format ----
  format: (fmtStr?: string): string ->
    return INVALID_DATE unless @isValid()
    str  = fmtStr ?? (@$u ? UTC_FORMAT : ISO_FORMAT)
    zone = tzOffsetString(this)

    str.replace REGEX_FORMAT, (match, literal) =>
      return literal if literal?
      switch match
        when 'YY'   then String(@$y).slice(-2)
        when 'YYYY' then pad(@$y, 4)
        when 'M'    then String(@$M + 1)
        when 'MM'   then pad(@$M + 1, 2)
        when 'MMM'  then MONTHS_SHORT[@$M]
        when 'MMMM' then MONTHS[@$M]
        when 'D'    then String(@$D)
        when 'Do'   then "#{@$D}#{ordinalSuffix(@$D)}"
        when 'DD'   then pad(@$D, 2)
        when 'd'    then String(@$W)
        when 'dd'   then WEEKDAYS_MIN[@$W]
        when 'ddd'  then WEEKDAYS_SHORT[@$W]
        when 'dddd' then WEEKDAYS[@$W]
        when 'H'    then String(@$H)
        when 'HH'   then pad(@$H, 2)
        when 'h'    then String(@$H % 12 or 12)
        when 'hh'   then pad(@$H % 12 or 12, 2)
        when 'a'    then meridiem(@$H, true)
        when 'A'    then meridiem(@$H, false)
        when 'm'    then String(@$m)
        when 'mm'   then pad(@$m, 2)
        when 's'    then String(@$s)
        when 'ss'   then pad(@$s, 2)
        when 'SSS'  then pad(@$ms, 3)
        when 'Q'    then String(@quarter())
        when 'Z'    then zone
        when 'ZZ'   then zone.replace(':', '')
        when 'z'    then zoneAbbreviation(@$d, @$z, false)
        when 'zzz'  then zoneAbbreviation(@$d, @$z, true)
        else match

# ==[ Inner helpers that need the class defined ]==

def daysInGivenMonth(date, utc)
  y = utc ? date.getUTCFullYear() : date.getFullYear()
  m = utc ? date.getUTCMonth()    : date.getMonth()
  Date.new(Date.UTC(y, m + 1, 0)).getUTCDate()

def fromToBase(input, withoutSuffix, instance, isFrom)
  result   = null
  isFuture = false
  chosen   = null

  i = 0
  while i < RELATIVE_THRESHOLDS.length
    step = RELATIVE_THRESHOLDS[i]
    if step.d
      result = if isFrom
        time(input).diff(instance, step.d, true)
      else
        instance.diff(input, step.d, true)
    abs = Math.round(Math.abs(result))
    isFuture = result > 0
    if not step.r or abs <= step.r
      step = RELATIVE_THRESHOLDS[i - 1] if abs <= 1 and i > 0
      tpl = RELATIVE_TIME[step.l]
      chosen = if typeof tpl is 'string' then tpl.replace('%d', String(abs)) else String(abs)
      break
    i++

  return chosen if withoutSuffix
  wrap = if isFuture then RELATIVE_TIME.future else RELATIVE_TIME.past
  wrap.replace('%s', chosen)

# ==[ Duration ]==

MS_YEAR  =! MS_DAY * 365
MS_MONTH =! MS_YEAR / 12

UNIT_TO_MS =!
  years:        MS_YEAR
  months:       MS_MONTH
  weeks:        MS_WEEK
  days:         MS_DAY
  hours:        MS_HOUR
  minutes:      MS_MINUTE
  seconds:      MS_SECOND
  milliseconds: 1

# Canonicalize any unit input ('y', :year, 'years', ...) to the plural string
# key used by UNIT_TO_MS / the Duration component map.
def durationUnit(u)
  key = prettyUnit(u).description
  "#{key}s"

DURATION_REGEX_PARSE  =! /^(-|\+)?P(?:([-+]?[0-9,.]*)Y)?(?:([-+]?[0-9,.]*)M)?(?:([-+]?[0-9,.]*)W)?(?:([-+]?[0-9,.]*)D)?(?:T(?:([-+]?[0-9,.]*)H)?(?:([-+]?[0-9,.]*)M)?(?:([-+]?[0-9,.]*)S)?)?$/
DURATION_REGEX_FORMAT =! /\[([^\]]+)\]|YYYY|YY|Y|MM|M|DD|D|HH|H|mm|m|ss|s|SSS/g

export def isDuration(x: unknown): boolean
  x instanceof Duration

# `$ms` is the total signed magnitude in milliseconds; `$d` is the normalized
# component map (years…milliseconds).
export class Duration
  constructor: (input?: DurationInput, unit?: Unit) ->
    @$d: Record<string, number> = {}

    # Undefined input → zero duration
    if input is undefined
      @$ms = 0
      @_parseFromMs()
      return

    # Unit-qualified: time.duration(90, 'minutes')
    if unit?
      @$ms = Number(input) * UNIT_TO_MS[durationUnit(unit)]
      @_parseFromMs()
      return

    # Number: plain milliseconds
    if typeof input is 'number'
      @$ms = input
      @_parseFromMs()
      return

    # Object: { hours: 1, minutes: 30 } — normalize components via ms round-trip
    if typeof input is 'object' and not (input instanceof String)
      for own k, v of input
        @$d[durationUnit(k)] = v
      @_calcMs()
      @_parseFromMs()
      return

    # String: ISO-8601 duration, 'PT30M', 'P1Y2M3D', '-P1D'
    if typeof input is 'string'
      m = input.match(DURATION_REGEX_PARSE)
      if m
        sign = m[1] is '-' ? -1 : 1
        parts = m.slice(2).map (v) -> if v? then sign * Number(v) else 0
        [@$d.years, @$d.months, @$d.weeks, @$d.days, @$d.hours, @$d.minutes, @$d.seconds] = parts
        @_calcMs()
        @_parseFromMs()
        return

    # Fallback: zero duration for anything unrecognized
    @$ms = 0
    @_parseFromMs()

  _calcMs: (): number[] ->
    @$ms = 0
    for own k, ms of UNIT_TO_MS
      @$ms += (@$d[k] ?? 0) * ms

  _parseFromMs: (): Duration ->
    ms = @$ms
    round = (n) -> if n < 0 then Math.ceil(n) else Math.floor(n)
    @$d.years = round(ms / MS_YEAR); ms %= MS_YEAR
    @$d.months = round(ms / MS_MONTH); ms %= MS_MONTH
    @$d.days = round(ms / MS_DAY); ms %= MS_DAY
    @$d.hours = round(ms / MS_HOUR); ms %= MS_HOUR
    @$d.minutes = round(ms / MS_MINUTE); ms %= MS_MINUTE
    @$d.seconds = round(ms / MS_SECOND); ms %= MS_SECOND
    @$d.milliseconds = ms
    this

  clone: (): Duration -> Duration.new(@$ms)

  # Component getter — e.g., `.hours()` returns the hour component (0..23)
  # after normalization. Use `.asHours()` for the total duration in hours.
  get: (unit: Unit): number ->
    key = durationUnit(unit)
    if key is 'milliseconds'
      @$ms % 1000
    else if key is 'weeks'
      n = @$ms / UNIT_TO_MS[key]
      if n < 0 then Math.ceil(n) else Math.floor(n)
    else
      @$d[key] ?? 0

  # Total duration expressed in `unit`
  as: (unit: Unit): number -> @$ms / UNIT_TO_MS[durationUnit(unit)]

  add: (input: Duration | DurationInput, unit?: Unit): Duration ->
    other = switch
      when input instanceof Duration then input.$ms
      when unit?                     then Number(input) * UNIT_TO_MS[durationUnit(unit)]
      else Duration.new(input).$ms
    Duration.new(@$ms + other)

  subtract: (input: Duration | DurationInput, unit?: Unit): Duration ->
    other = switch
      when input instanceof Duration then input.$ms
      when unit?                     then Number(input) * UNIT_TO_MS[durationUnit(unit)]
      else Duration.new(input).$ms
    Duration.new(@$ms - other)

  negated: (): Duration -> Duration.new(-@$ms)
  abs:     (): Duration -> Duration.new(Math.abs(@$ms))

  valueOf: (): number -> @$ms

  milliseconds:   (): number -> @get(:millisecond)
  seconds:        (): number -> @get(:second)
  minutes:        (): number -> @get(:minute)
  hours:          (): number -> @get(:hour)
  days:           (): number -> @get(:day)
  weeks:          (): number -> @get(:week)
  months:         (): number -> @get(:month)
  years:          (): number -> @get(:year)

  asMilliseconds: (): number -> @as(:millisecond)
  asSeconds:      (): number -> @as(:second)
  asMinutes:      (): number -> @as(:minute)
  asHours:        (): number -> @as(:hour)
  asDays:         (): number -> @as(:day)
  asWeeks:        (): number -> @as(:week)
  asMonths:       (): number -> @as(:month)
  asYears:        (): number -> @as(:year)

  # ISO-8601 duration string: 'P1Y2M3DT4H5M6S' or 'PT30M' etc.
  toISOString: (): string ->
    part = (n, sym) ->
      return '' unless n
      "#{Math.abs(n)}#{sym}"
    negative = @$ms < 0
    # Always extract from absolute value's components, track sign separately.
    src = if negative then @abs() else this
    Y = part(src.$d.years,   'Y')
    M = part(src.$d.months,  'M')
    days = (src.$d.days ?? 0) + ((src.$d.weeks ?? 0) * 7)
    D = part(days, 'D')
    H = part(src.$d.hours,   'H')
    mm = part(src.$d.minutes, 'M')
    secs = (src.$d.seconds ?? 0) + ((src.$d.milliseconds ?? 0) / 1000)
    secs = Math.round(secs * 1000) / 1000
    S = part(secs, 'S')
    T = if H or mm or S then 'T' else ''
    sign = if negative then '-' else ''
    out = "#{sign}P#{Y}#{M}#{D}#{T}#{H}#{mm}#{S}"
    if out is 'P' or out is '-P' then 'P0D' else out

  toJSON: (): string -> @toISOString()

  format: (fmtStr: string = 'YYYY-MM-DDTHH:mm:ss'): string ->
    parts =
      Y:    String(@$d.years ?? 0)
      YY:   pad(@$d.years ?? 0, 2)
      YYYY: pad(@$d.years ?? 0, 4)
      M:    String(@$d.months ?? 0)
      MM:   pad(@$d.months ?? 0, 2)
      D:    String(@$d.days ?? 0)
      DD:   pad(@$d.days ?? 0, 2)
      H:    String(@$d.hours ?? 0)
      HH:   pad(@$d.hours ?? 0, 2)
      m:    String(@$d.minutes ?? 0)
      mm:   pad(@$d.minutes ?? 0, 2)
      s:    String(@$d.seconds ?? 0)
      ss:   pad(@$d.seconds ?? 0, 2)
      SSS:  pad(@$d.milliseconds ?? 0, 3)
    fmtStr.replace DURATION_REGEX_FORMAT, (match, literal) ->
      literal ?? parts[match] ?? match

  # English humanize: '2 hours', 'a day', 'a few seconds'. With `withSuffix`:
  # 'in 2 hours' or '2 hours ago' depending on sign.
  humanize: (withSuffix: boolean = false): string ->
    now = time()
    other = now.add(@$ms, :millisecond)
    other.from(now, not withSuffix)

# Apply a Duration to a Time instance (used by Time#add/subtract).
def applyDuration(date, dur, sign)
  date
    .add(sign * (dur.$d.years ?? 0),        :year)
    .add(sign * (dur.$d.months ?? 0),       :month)
    .add(sign * ((dur.$d.weeks ?? 0) * 7),  :day)
    .add(sign * (dur.$d.days ?? 0),         :day)
    .add(sign * (dur.$d.hours ?? 0),        :hour)
    .add(sign * (dur.$d.minutes ?? 0),      :minute)
    .add(sign * (dur.$d.seconds ?? 0),      :second)
    .add(sign * (dur.$d.milliseconds ?? 0), :millisecond)

# ==[ Factory ]==

# The `time` factory is a callable (parse/construct a Time) that also carries
# static helpers (`time.utc`, `time.parse`, `time.tz`, …).

# Narrow a value already known (via isTime) to be a Time.
def asTime(x)
  x

# Normalize min()/max() args — a Time list or a single array of them — to Time[].
def toTimeList(args): Time[]
  if Array.isArray(args[0]) then args[0] else args

# The callable, exported by name as `time`. `makeTime()` augments it with the
# static members and is exported as the package default (the full factory).
export def time(input?: TimeInput, opts: { utc?: boolean, format?: string } = {}): Time
  return asTime(input).clone() if isTime(input)
  Time.new({ input, utc: !!opts.utc, format: opts.format })

def makeTime()
  Object.assign time,
    utc: (input: TimeInput) ->
      Time.new({ input, utc: true })

    # Parse with an explicit format — `time.parse('04/19/2026 3:45 PM', 'MM/DD/YYYY h:mm A')`
    parse: (input: string, fmt: string, utc: boolean = false): Time ->
      d = parseWithFormat(input, fmt, utc)
      return time(NaN) unless d?
      Time.new({ fromInstance: d, utc })

    # The recognized components as written — `time.parts('2024-03-01T02:00+05:30')`
    # → `{ year: 2024, month: 3, day: 1, hour: 2, ..., clock: true, zone: 330 }`,
    # or null when the string is not a real date. Grammar only, no fallback.
    parts: (input: TimeInput): DateParts | null -> dateParts(input)

    # Parse an input and anchor it to an IANA zone. If the input is a string
    # without timezone info, the wall-clock is interpreted AS IF IN `zone`.
    # Otherwise the instant is preserved and just reinterpreted for display.
    tz: Object.assign(
      (input: TimeInput, zone: string) ->
        iana = resolveZone(zone)
        if typeof input is 'string' and not /Z$|[+-]\d\d:?\d\d$/.test(input)
          # Parse as UTC to get the wall-clock numbers, then shift by zone offset.
          asUTC   = parseDate(input, true)
          offset  = zoneOffsetMinutes(asUTC, iana)
          shifted = Date.new(asUTC.getTime() - offset * 60000)
          offset2 = zoneOffsetMinutes(shifted, iana)
          if offset2 isnt offset
            shifted = Date.new(asUTC.getTime() - offset2 * 60000)
          Time.new({ fromInstance: shifted, zone: iana })
        else
          time(input).tz(iana)
      ,
      guess:   ((): string -> Intl.DateTimeFormat().resolvedOptions().timeZone)
      aliases: US_TIMEZONES
    )

    unix:       (secs: number) -> time(secs * 1000)
    isTime:     isTime
    isDuration: isDuration

    # Duration factory — accepts a number+unit, a number (ms), an object, or an
    # ISO-8601 duration string.
    duration:   (input?: DurationInput, unit?: Unit) -> Duration.new(input, unit)
    Duration:   Duration
    Time:       Time

    min: (...args: (Time | Time[])[]) ->
      toTimeList(args).reduce (a, b) -> if a.valueOf() < b.valueOf() then a else b

    max: (...args: (Time | Time[])[]) ->
      toTimeList(args).reduce (a, b) -> if a.valueOf() > b.valueOf() then a else b

    # Version exposed for callers.
    version: '4.0.0'

# age(dob, asOf = now) — completed years from dob to asOf, birthday-aware
# (subtract a year if asOf falls before this year's birthday). Accepts anything
# time() accepts (ISO string, Date, Time); returns null for a blank/invalid dob
# or asOf. Compares wall-clock calendar dates in the instances' zone.
export def age(dob: TimeInput, asOf?: TimeInput): number | null
  return null unless dob?
  born = time(dob)
  ref  = if asOf? then time(asOf) else time()
  return null unless born.isValid() and ref.isValid()
  years = ref.year() - born.year()
  years -= 1 if ref.month() < born.month() or (ref.month() is born.month() and ref.date() < born.date())
  years

export default makeTime()
