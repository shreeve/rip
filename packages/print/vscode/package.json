{
  "name": "print",
  "displayName": "Rip Print",
  "description": "Syntax-highlighted source code printing — beautifully formatted with themes and line numbers",
  "version": "4.0.0",
  "publisher": "rip-lang",
  "license": "MIT",
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreeve/rip.git",
    "directory": "packages/print/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "print",
    "syntax",
    "highlighting",
    "source",
    "code",
    "rip"
  ],
  "icon": "icon.png",
  "contributes": {
    "commands": [
      {
        "command": "rip-print.printFile",
        "title": "Rip Print: Print Current File"
      },
      {
        "command": "rip-print.printFolder",
        "title": "Rip Print: Print Folder"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rip-print.printFolder",
          "when": "explorerResourceIsFolder",
          "group": "5_cutcopypaste@100"
        },
        {
          "command": "rip-print.printFile",
          "when": "!explorerResourceIsFolder",
          "group": "5_cutcopypaste@100"
        }
      ],
      "editor/context": [
        {
          "command": "rip-print.printFile",
          "group": "1_modification@100"
        }
      ]
    }
  },
  "scripts": {
    "sync": "rip sync.rip",
    "test": "rip test.rip",
    "package": "bun run build && npx @vscode/vsce package --skip-license",
    "install-vscode": "bun ../../../scripts/install-ext.mjs print vscode",
    "install-cursor": "bun ../../../scripts/install-ext.mjs print cursor",
    "build": "bun build src/extension.js --target=node --format=cjs --external vscode --outfile=dist/extension.js"
  },
  "dependencies": {
    "highlight.js": "11.11.1"
  }
}
