# ==============================================================================
# rip/vista tests — the broker's bytes, pinned to OpenVista's RPC-HTTPS.md §3
#
# Requests and replies are compared byte for byte against the contract's
# examples (measured on em). Sessions run against a recording fetch that
# answers with those replies, so the suite needs no Janus and no network.
# ==============================================================================

import { test, eq, ok, throws } from 'rip/testing'
import vista, { Session, VistaError, decode, encode, encodeCommand, fromBytes, lines, toBytes, wrap } from 'rip/vista'
import * as mod from 'rip/vista'
import { readFileSync } from 'fs'

# Bytes as the contract writes them: printable ASCII as is, the rest \xNN.
show = (b) -> Array.from(b).map((c) -> if c >= 32 and c < 127 then String.fromCharCode(c) else '\\x' + c.toString(16).padStart(2, '0')).join('')

# A reply as Janus returns it, from the contract's spelling of its bytes.
bytes = (s) -> Uint8Array.from(Array.from(s).map((ch) -> ch.charCodeAt(0)))

def rejects(fn, kind, text = null)
  caught = null
  try
    fn!
  catch e
    caught = e
  ok caught?, "expected a rejection (#{kind})"
  ok caught instanceof VistaError, "expected a VistaError, got #{caught?.name}: #{caught?.message}"
  eq caught.kind, kind, "kind of: #{caught.message}"
  ok caught.message.includes(text), "expected #{JSON.stringify(text)} in: #{caught.message}" if text?
  caught

# A recording fetch: each call takes the next scripted reply (a byte string,
# or { status, headers, body }) and records the request it answered.
fakeFetch = (replies) ->
  calls = []
  fn = (url, init) ->
    calls.push { url, init, body: show(init.body) }
    r = replies.shift()
    throw Error.new("no reply scripted for #{show(init.body)}") unless r?
    r = { body: r } if typeof r is 'string'
    headers = { 'Content-Type': 'application/x-xwb', ...(r.headers ?? {}) }
    Response.new(bytes(r.body ?? ''), { status: r.status ?? 200, headers })
  fn.calls = calls
  fn

REPLY =!
  accept:  "\x00\x00accept\x04"
  imHere:  "\x00\x001\x04"
  broker:  "\x00\x00180\r\n\x04"
  setup:   "\x00\x00pop\r\nENV\r\nENV\r\n/dev/null\r\n5\r\n0\r\nFOIA.DOMAIN.EXT\r\n0\r\n\x04"
  avCode:  "\x00\x00100\r\n0\r\n0\r\n\r\n0\r\n0\r\n\r\nGood evening MANAGER,SITE\r\n\x04"
  context: "\x00\x001\x04"
  refused: "\x3ARemote Procedure 'ORWU USERINFO' cannot run before sign-on\x00\x04"
  mError:  "\x00\x00\x18M  ERROR=CAPI+16^XWBPRS,4 actual parameters for IMHERE^XWBLIB,M58,-M58\r\nLAST REF=...\x04\x04"
  bye:     "\x00\x00#BYE#\x04"

session = (replies, opts = {}) ->
  f = fakeFetch(replies)
  [Session.new({ url: 'https://vista.test', fetch: f, ...opts }), f]

# ==[ Package surface ]==

console.log "\nPackage"

test "named exports + the default session", ->
  eq Object.keys(mod).sort(), ['Session', 'VistaError', 'decode', 'default', 'encode', 'encodeCommand', 'fromBytes', 'lines', 'session', 'toBytes', 'wrap']
  ok vista instanceof Session
  for name in ['session', 'encode', 'encodeCommand', 'decode', 'wrap']
    eq typeof vista[name], 'function'
  eq vista.Session, Session
  eq vista.VistaError, VistaError

test "no runtime deps", ->
  pkg = JSON.parse(readFileSync("#{import.meta.dir}/package.json", 'utf8'))
  for field in ['dependencies', 'peerDependencies', 'optionalDependencies', 'devDependencies']
    eq pkg[field], undefined

test "declares browser safety and earns it", ->
  pkg = JSON.parse(readFileSync("#{import.meta.dir}/package.json", 'utf8'))
  eq pkg.rip, { browser: true }
  source = readFileSync("#{import.meta.dir}/vista.rip", 'utf8')
  eq /^\s*import\b/m.test(source), false
  eq /\bBun\.|node:|process\.|globalThis/.test(source), false

# ==[ Requests ]==

console.log "\nRequests"

test "the contract's four messages, byte for byte", ->
  eq show(encodeCommand('TCPConnect', ['127.0.0.1', 0, 'localhost'])), '[XWB]10304\\x0aTCPConnect50009127.0.0.1f00010f0009localhostf\\x04'
  eq show(encode('XUS INTRO MSG')), '[XWB]11302\\x010\\x0dXUS INTRO MSG5\\x04'
  eq show(encode('XUS AV CODE', [wrap('ACCESS;VERIFY')])), '[XWB]11302\\x010\\x0bXUS AV CODE50015 ACCESS;VERIFY f\\x04'
  eq show(encodeCommand('#BYE#')), '[XWB]10304\\x05#BYE#\\x04'

test "the RPC version is 0 unless one is asked for", ->
  eq show(encode('X', [], { version: '1.108' })), '[XWB]11302\\x051.108\\x01X5\\x04'

test "text is Windows-1252, and lengths count its bytes", ->
  eq show(encode('X', ['30º'])), '[XWB]11302\\x010\\x01X5000330\\xbaf\\x04'
  eq show(toBytes('€‚ƒ™Ÿ')), '\\x80\\x82\\x83\\x99\\x9f'
  eq show(toBytes('é ñ ÿ')), '\\xe9 \\xf1 \\xff'

test "every byte decodes and encodes back to itself", ->
  all = Uint8Array.from([0...256])
  eq show(toBytes(fromBytes(all))), show(all)
  eq fromBytes(Uint8Array.of(0x80, 0xBA)), '€º'

test "a character Windows-1252 cannot hold rejects, never a guess", ->
  throws (-> encode('X', ['ok 漢'])), VistaError, 'parameter 1 holds "漢" (U+6F22) at character 4'
  throws (-> encode('X', ['🙂'])), VistaError, 'U+1F642'
  throws (-> encode('ORWU☃')), VistaError, 'the RPC name holds'

test "the width is 3 until a value passes 999 bytes, then 9", ->
  eq show(encode('X', ['a'.repeat(999)])).slice(0, 9), '[XWB]1130'
  big = show(encode('X', ['a'.repeat(1000)]))
  eq big.slice(0, 9), '[XWB]1190'
  ok big.includes('50000001000aaa')

test "an empty value is an empty literal, so later parameters keep their places", ->
  eq show(encode('X', [null, 'a'])), '[XWB]11302\\x010\\x01X50000f0001af\\x04'
  eq show(encode('X', [undefined, ''])), '[XWB]11302\\x010\\x01X50000f0000f\\x04'

# A list is ONE `2`, then each entry's subscript and value with `t` between
# them and `f` after the last: XWBPRS reads a type only after an `f`, CPRS
# writes lists so, and the relay's own vector is `2 sub x t sub y f`.
test "a list: one `2`, then entries joined by `t`; numbers bare, text quoted with quotes doubled", ->
  eq show(encode('X', [{ 1: 'a', TEXT: 'b', 'say "hi"': 'c' }])),
    '[XWB]11302\\x010\\x01X520011001at006"TEXT"001bt012"say ""hi"""001cf\\x04'
  eq show(encode('ORWDX SAVE', [{ 1: 'a', 2: 'b' }, 'z'])),
    '[XWB]11302\\x010\\x0aORWDX SAVE520011001at0012001bf0001zf\\x04'

test "a list's empty value is \\x01; levels join by commas", ->
  eq show(encode('X', [[[['TEXT', 1, 0], 'line one'], [['TEXT', 2, 0], '']]])),
    '[XWB]11302\\x010\\x01X52010"TEXT",1,0008line onet010"TEXT",2,0001\\x01f\\x04'

test "a subscript goes bare only as an M canonical number; anything else is text", ->
  sub = (k) -> show(encode('X', [[[k, 'v']]])).slice(22, -9)
  eq sub(0.5), '002.5'
  eq sub(-0.25), '004-.25'
  eq sub('12'), '00212'
  eq sub('0.5'), '005"0.5"'
  eq sub('-0'), '004"-0"'
  eq sub('007'), '005"007"'
  eq sub('1.50'), '006"1.50"'
  eq sub('1234567890123456'), '018"1234567890123456"'
  throws (-> encode('X', [[[12345678901234567, 'v']]])), VistaError, 'no exact M form'

test "an empty list is one empty subscript", ->
  eq show(encode('X', [{}])), '[XWB]11302\\x010\\x01X52000f\\x04'
  eq show(encode('X', [[], 'z'])), '[XWB]11302\\x010\\x01X52000f0001zf\\x04'

test "numbers go in their plain decimal form", ->
  eq show(encode('X', [1.5, -3, 0])), '[XWB]11302\\x010\\x01X500031.5f0002-3f00010f\\x04'
  throws (-> encode('X', [1e21])), VistaError, 'no plain decimal form'
  throws (-> encode('X', [NaN])), VistaError, 'a finite number'
  throws (-> encode('X', [[[1e-7, 'a']]])), VistaError, 'no exact M form'

test "an object that is not a plain object or an array rejects", ->
  throws (-> encode('X', [Date.new()])), VistaError, 'parameter 1 must be a string, a number, a list or null, not Date'
  throws (-> encode('X', [Map.new([['a', 'b']])])), VistaError, 'not Map'
  throws (-> encode('X', [Set.new(['a'])])), VistaError, 'not Set'
  throws (-> encode('X', [Uint8Array.of(65)])), VistaError, 'not Uint8Array'
  throws (-> encode('X', [String.new('ab')])), VistaError, 'not String'
  throws (-> encode('X', 'abc')), VistaError, 'the parameters are an array, not string'
  throws (-> encode('X', { a: 1 })), VistaError, 'the parameters are an array, not Object'
  throws (-> encode('X', [], { version: null })), VistaError, 'the RPC version must be a string or a finite number, not null'
  throws (-> encode('X', [], { version: {} })), VistaError, 'not Object'
  throws (-> encode('X', [], { vers: '1' })), VistaError, "unknown encode option 'vers'"
  throws (-> Session.new({ url: 'https://x', version: {} })), VistaError, 'the RPC version must be'
  throws (-> toBytes(5)), VistaError, 'must be a string, not number'
  throws (-> fromBytes('x')), VistaError, 'takes a Uint8Array'

test "anything else rejects, naming the parameter", ->
  throws (-> encode('X', ['a', true])), VistaError, 'parameter 2 must be a string, a number, a list or null, not boolean'
  throws (-> encode('X', [[['k']]])), VistaError, 'a [subscript, value] pair'
  throws (-> encode('X', [{ a: {} }])), VistaError, 'a list value must be a string or a finite number'
  throws (-> encode('')), VistaError, 'an RPC name is a non-empty string'
  throws (-> encode('X'.repeat(256))), VistaError, 'the RPC name is 256 bytes'
  throws (-> encode('X', ['a'.repeat(1024 * 1024)])), VistaError, 'Janus accepts at most 1048576'

# ==[ Replies ]==

console.log "\nReplies"

test "the contract's replies decode", ->
  eq decode(bytes(REPLY.accept)), { security: '', error: '', data: 'accept', mError: false }
  eq decode(bytes(REPLY.broker)).data, '180\r\n'
  eq lines(decode(bytes(REPLY.setup)).data), ['pop', 'ENV', 'ENV', '/dev/null', '5', '0', 'FOIA.DOMAIN.EXT', '0']
  eq lines(decode(bytes(REPLY.avCode)).data)[7], 'Good evening MANAGER,SITE'
  eq decode(bytes(REPLY.bye)).data, '#BYE#'

test "a refusal is the security message", ->
  r = decode(bytes(REPLY.refused))
  eq r.security, "Remote Procedure 'ORWU USERINFO' cannot run before sign-on"
  eq r.data, ''

test "an M error ends with two \\x04 and loses its \\x18", ->
  r = decode(bytes(REPLY.mError))
  eq r.mError, true
  ok r.data.startsWith('M  ERROR=CAPI+16^XWBPRS')

test "replies decode as Windows-1252", ->
  eq decode(Uint8Array.of(0, 0, 0x33, 0x30, 0xBA, 0x04)).data, '30º'

test "bytes that are not one reply reject", ->
  throws (-> decode(bytes("\x00\x00accept"))), VistaError, 'no end'
  throws (-> decode(bytes("\x00\x00accept\x04extra"))), VistaError, '5 bytes follow'
  throws (-> decode(bytes("\x00\x00\x18M  ERROR=X\x04"))), VistaError, 'two \\x04'
  throws (-> decode(bytes("\x05ab"))), VistaError, 'inside its security message'
  throws (-> decode('accept')), VistaError, 'a Uint8Array'

test "lines splits on \\r\\n and drops the last empty piece", ->
  eq lines(''), []
  eq lines('a\r\nb\r\n'), ['a', 'b']
  eq lines('one'), ['one']
  eq lines('a\r\n\r\nb\r\n'), ['a', '', 'b']

# ==[ Sessions ]==

console.log "\nSessions"

test! "connect: TCPConnect, then XUS SIGNON SETUP, answering the intro text", ->
  [s, f] = session([{ body: REPLY.accept, headers: { 'Set-Cookie': '__Host-ov=TOK123; Secure; HttpOnly; SameSite=Strict; Path=/' } }, REPLY.setup, "\x00\x00Welcome\r\nto VistA\r\n\x04"])
  eq s.connect!, ['Welcome', 'to VistA']
  eq f.calls.map((c) -> c.body), ['[XWB]10304\\x0aTCPConnect50009127.0.0.1f00010f0009localhostf\\x04', '[XWB]11302\\x010\\x10XUS SIGNON SETUP5\\x04', '[XWB]11302\\x010\\x0dXUS INTRO MSG5\\x04']
  eq f.calls[0].url, 'https://vista.test/rpc'
  eq f.calls[0].init.method, 'POST'
  eq f.calls[0].init.headers['Content-Type'], 'application/x-xwb'
  eq f.calls[0].init.headers['X-OV'], '1'
  eq f.calls[0].init.headers.Authorization, undefined
  eq f.calls[1].init.headers.Authorization, 'Bearer TOK123'

test! "a site URL's trailing slash does not double", ->
  [s, f] = session([REPLY.imHere], { url: 'https://vista.test/' })
  s.rpc! 'XWB IM HERE'
  eq f.calls[0].url, 'https://vista.test/rpc'

test! "connect: a rejected TCPConnect throws", ->
  [s] = session(["\x00\x00reject\x04"])
  rejects! (-> s.connect()), 'signon', 'sign-ons inhibited'

test! "signOn sends the codes wrapped in one space and answers the DUZ", ->
  [s, f] = session([REPLY.avCode])
  r = s.signOn! 'ACCESS', 'VERIFY'
  eq r.duz, 100
  eq r.mustChangeVerify, false
  eq f.calls[0].body, '[XWB]11302\\x010\\x0bXUS AV CODE50015 ACCESS;VERIFY f\\x04'

test! "signOn: codes that are not accepted throw with VistA's message", ->
  [s] = session(["\x00\x000\r\n0\r\n0\r\nNot a valid ACCESS CODE/VERIFY CODE pair.\r\n0\r\n0\r\n\x04"])
  e = rejects! (-> s.signOn('A', 'V')), 'signon', 'Not a valid ACCESS CODE/VERIFY CODE pair.'
  eq e.lines[0], '0'

test! "signOn: an expired verify code answers mustChangeVerify, then changeVerify", ->
  [s, f] = session(["\x00\x000\r\n0\r\n1\r\nVERIFY CODE must be changed before continued use.\r\n0\r\n0\r\n\x04", "\x00\x000\r\n\r\n\x04"])
  r = s.signOn! 'A', 'OLD'
  eq [r.duz, r.mustChangeVerify], [0, true]
  eq s.changeVerify!('OLD', 'NEW1', 'NEW1'), true
  eq f.calls[1].body, '[XWB]11302\\x010\\x07XUS CVC50019 OLD ^ NEW1 ^ NEW1 f\\x04'

test! "changeVerify: a refused code throws", ->
  [s] = session(["\x00\x001\r\nThis code has been used previously.\r\n\x04"])
  rejects! (-> s.changeVerify('O', 'N', 'N')), 'signon', 'used previously'

test! "signOn rejects a `;` in the access code before sending", ->
  [s, f] = session([])
  rejects! (-> s.signOn('A;B', 'V')), 'request', 'holds no `;`'
  eq f.calls.length, 0

test! "context wraps the option and wants 1", ->
  [s, f] = session([REPLY.context, "\x00\x00The context 'BAD' does not exist on server.\x04"])
  eq s.context!('OR CPRS GUI CHART'), true
  eq f.calls[0].body, '[XWB]11302\\x010\\x12XWB CREATE CONTEXT50019 OR CPRS GUI CHART f\\x04'
  rejects! (-> s.context('BAD')), 'signon', 'does not exist'

test! "rpc answers the data; lines answers it split", ->
  [s] = session(["\x00\x00100^MANAGER,SITE\x04", "\x00\x00a\r\nb\r\n\x04"])
  eq s.rpc!('ORWU USERINFO'), '100^MANAGER,SITE'
  eq s.lines!('ORWU X'), ['a', 'b']

test! "a security message, an error message and an M error each throw their kind", ->
  [s] = session([REPLY.refused, "\x00\x0FNo such patient\x04", REPLY.mError])
  e = rejects! (-> s.rpc('ORWU USERINFO')), 'security', 'cannot run before sign-on'
  eq e.rpc, 'ORWU USERINFO'
  rejects! (-> s.rpc('ORWPT SELECT', 1)), 'error', 'No such patient'
  e = rejects! (-> s.rpc('XWB IM HERE', 1)), 'm', 'M  ERROR=CAPI+16^XWBPRS'
  ok e.detail.includes('LAST REF=')

test! "401 is the session's end, with Janus's reason; later calls fail without a request until connect", ->
  [s, f] = session([{ body: REPLY.accept, headers: { 'Set-Cookie': '__Host-ov=T1; Path=/' } }, REPLY.setup, REPLY.imHere, { status: 401, headers: { 'OV-Session-Ended': 'idle' } }, { body: REPLY.accept, headers: { 'Set-Cookie': '__Host-ov=T2; Path=/' } }, REPLY.setup, REPLY.imHere])
  s.connect!
  e = rejects! (-> s.rpc('X')), 'ended', 'the session has ended (idle)'
  eq e.sessionEnded, 'idle'
  rejects! (-> s.rpc('X')), 'ended', 'connect to start another'
  eq f.calls.length, 4
  s.connect!
  eq f.calls[4].init.headers.Authorization, undefined
  eq f.calls[5].init.headers.Authorization, 'Bearer T2'

test! "502 and 504 end the session", ->
  for status in [502, 504]
    [s] = session([{ status }])
    e = rejects! (-> s.rpc('X')), 'ended', "Janus answered #{status}"
    eq e.status, status
    rejects! (-> s.rpc('X')), 'ended'

test! "a request that never reached Janus is a transport error; the session stays", ->
  calls = 0
  f = (url, init) ->
    calls += 1
    throw TypeError.new('fetch failed') if calls is 1
    Response.new(bytes(REPLY.imHere), { headers: { 'Content-Type': 'application/x-xwb' } })
  s = Session.new({ url: 'https://vista.test', fetch: f })
  e = rejects! (-> s.rpc('X')), 'transport', 'did not reach Janus (fetch failed)'
  ok e.cause instanceof TypeError
  eq s.rpc!('XWB IM HERE'), '1'

test! "a reply cut short or malformed ends the session", ->
  broken = ReadableStream.new({ start: (c) -> c.enqueue(Uint8Array.of(0, 0)); c.error(Error.new('stream reset')) })
  f = (url, init) -> Response.new(broken, { headers: { 'Content-Type': 'application/x-xwb' } })
  s = Session.new({ url: 'https://vista.test', fetch: f })
  rejects! (-> s.rpc('X')), 'ended', 'the reply was cut short'
  rejects! (-> s.rpc('X')), 'ended'
  [t] = session(["\x00\x00accept"])
  rejects! (-> t.rpc('X')), 'reply', 'no end'
  rejects! (-> t.rpc('X')), 'ended', 'a malformed reply'

test! "no redirect is followed; the token and codes go only where the session points", ->
  [s, f] = session([REPLY.imHere])
  s.rpc! 'XWB IM HERE'
  eq f.calls[0].init.redirect, 'error'

test "the site url: https, or http on loopback only; no query or fragment; its path is kept", ->
  eq Session.new({ url: 'https://vista.example.org' }).endpoint(), 'https://vista.example.org/rpc'
  eq Session.new({ url: 'https://example.org/vista/' }).endpoint(), 'https://example.org/vista/rpc'
  eq Session.new({ url: 'http://127.0.0.1:19300' }).endpoint(), 'http://127.0.0.1:19300/rpc'
  eq Session.new({ url: 'http://localhost:19300' }).endpoint(), 'http://localhost:19300/rpc'
  throws (-> Session.new({ url: 'http://vista.example.org' })), VistaError, 'must be https:'
  throws (-> Session.new({ url: 'vista.example.org' })), VistaError, 'not an absolute URL'
  throws (-> Session.new({ url: 'https://x/?site=1' })), VistaError, 'no query or fragment'
  throws (-> Session.new({ url: 5 })), VistaError, 'the site url is a string'
  throws (-> Session.new({ url: 'https://x', fetch: 'no' })), VistaError, 'the fetch option is a function'

test! "Janus's rotated token replaces the old one", ->
  [s, f] = session([{ body: REPLY.accept, headers: { 'Set-Cookie': '__Host-ov=T1; Path=/' } }, REPLY.setup, REPLY.imHere, { body: REPLY.avCode, headers: { 'Set-Cookie': '__Host-ov=T2; Path=/' } }, REPLY.imHere])
  s.connect!
  s.signOn! 'A', 'V'
  s.rpc! 'XWB IM HERE'
  eq f.calls[3].init.headers.Authorization, 'Bearer T1'
  eq f.calls[4].init.headers.Authorization, 'Bearer T2'

test! "the token is never on the session object", ->
  [s] = session([{ body: REPLY.accept, headers: { 'Set-Cookie': '__Host-ov=SECRETTOKEN; Path=/' } }, REPLY.setup, REPLY.imHere])
  s.connect!
  ok not JSON.stringify(s).includes('SECRETTOKEN')
  ok not Object.values(s).some((v) -> String(v).includes('SECRETTOKEN'))

test! "a rejected code never appears in the error, not one character", ->
  [s, f] = session([])
  e = rejects! (-> s.signOn('ACCESS', 'p\u0101ssword')), 'request', 'the verify code holds a character Windows-1252 cannot hold'
  ok not e.message.includes('\u0101')
  ok not e.message.includes('character 1')
  throws (-> wrap('sig\u2603')), VistaError, 'the value holds a character Windows-1252 cannot hold'
  eq f.calls.length, 0

test! "other statuses and a foreign content type are transport errors", ->
  [s] = session([{ status: 503, headers: { 'Retry-After': '5' } }, { status: 200, headers: { 'Content-Type': 'text/html' }, body: '<html>' }])
  e = rejects! (-> s.rpc('X')), 'transport', 'Janus answered 503'
  eq e.retryAfter, '5'
  rejects! (-> s.rpc('X')), 'transport', 'text/html, not application/x-xwb'

test! "requests run one at a time, in order", ->
  order = []
  release = null
  gate = Promise.new((r) -> release = r)
  f = (url, init) ->
    name = fromBytes(init.body).match(/XWB IM HERE|ORWU A|ORWU B/)[0]
    order.push "start #{name}"
    await gate if name is 'ORWU A'
    order.push "end #{name}"
    Response.new(bytes(REPLY.imHere), { headers: { 'Content-Type': 'application/x-xwb' } })
  s = Session.new({ url: 'https://vista.test', fetch: f })
  a = s.rpc('ORWU A')
  b = s.rpc('ORWU B')
  Promise.resolve().then(-> release())
  Promise.all! [a, b]
  eq order, ['start ORWU A', 'end ORWU A', 'start ORWU B', 'end ORWU B']

test! "a failed request does not stop the ones after it", ->
  [s] = session([{ status: 503 }, REPLY.imHere])
  a = s.rpc('X')
  b = s.rpc('XWB IM HERE')
  rejects! (-> a), 'transport'
  eq (await b), '1'

test! "keepalive cannot outlive its session", ->
  live = []
  timers = { set: ((f, ms) -> live.push(f); f), clear: (h) -> live.splice(live.indexOf(h), 1) }
  [s] = session([REPLY.broker, REPLY.bye], { timers })
  k = s.keepalive()
  b = s.bye()
  rejects! (-> k), 'ended', 'before its keepalive began'
  eq (await b), true
  eq live.length, 0
  [t] = session([REPLY.broker, { status: 401, headers: { 'OV-Session-Ended': 'idle' } }], { timers })
  t.keepalive!
  eq live.length, 1
  rejects! (-> t.rpc('X')), 'ended'
  eq live.length, 0

test! "a keepalive tick that fails goes to onError, and a transient failure keeps the timer", ->
  seen = []
  ticks = []
  timers = { set: ((f, ms) -> ticks.push(f); f), clear: (h) -> ticks.push('cleared') }
  [s] = session([REPLY.broker, { status: 503 }, REPLY.imHere], { timers })
  s.keepalive! onError: (e) -> seen.push e.kind
  tick = ticks[0]
  tick!
  eq seen, ['transport']
  eq s.keeping?, true
  tick!
  eq seen, ['transport']
  [t] = session([REPLY.broker, { status: 503 }], { timers })
  t.keepalive!
  rejects! (-> ticks[ticks.length - 1]()), 'transport'
  rejects! (-> t.keepalive({ every: 5 })), 'request', "unknown keepalive option 'every'"

test! "after bye, a call fails at once with the session's end", ->
  [s, f] = session([REPLY.bye])
  s.bye!
  rejects! (-> s.rpc('X')), 'ended', 'the session has ended (bye)'
  eq f.calls.length, 1

test! "keepalive: XWB IM HERE at half the broker's idle timeout, until bye", ->
  ticks = []
  timers = { set: ((f, ms) -> ticks.push(ms); f), clear: (h) -> ticks.push('cleared') }
  [s, f] = session([REPLY.broker, REPLY.imHere, REPLY.bye], { timers })
  eq s.keepalive!, 90000
  tick = s.keeping
  tick!
  eq f.calls[1].body, '[XWB]11302\\x010\\x0bXWB IM HERE5\\x04'
  eq s.bye!, true
  eq ticks, [90000, 'cleared']
  eq f.calls[2].body, '[XWB]10304\\x05#BYE#\\x04'

test! "bye wants #BYE# back", ->
  [s] = session(["\x00\x00no\x04"])
  rejects! (-> s.bye()), 'reply', '#BYE# was answered "no"'

test "a session outside a browser needs a url; options are checked", ->
  throws (-> Session.new().endpoint()), VistaError, 'needs `url:`'
  throws (-> Session.new({ uri: 'x' })), VistaError, "unknown session option 'uri'"
  ok vista.session({ url: 'https://x' }) instanceof Session

test "wrap puts one space on each side and wants text", ->
  eq wrap('OR CPRS GUI CHART'), ' OR CPRS GUI CHART '
  throws (-> wrap('')), VistaError, 'a non-empty string'
  throws (-> wrap(5, 'the signature code')), VistaError, 'the signature code is a non-empty string'
