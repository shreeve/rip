test! "a managed shell-less browse policy rejects API upstreams before registration", ->
  dir = tmpFixture('tmp-browse-managed-api-')
  mkdirSync join(dir, 'files')
  writeFileSync join(dir, 'app.rip'), appSource('api')
  writeFileSync join(dir, 'serve.rip'), """
