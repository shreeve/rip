    ok not got.err.includes('control endpoint unreachable'), "registration was never attempted: #{got.err}"
  finally
    rmSync dir, { recursive: true, force: true }

writeTenantServe = (dir) ->
  mkdirSync join(dir, 'sites', 'common', 'public'), { recursive: true }
  mkdirSync join(dir, 'app'), { recursive: true }
  writeFileSync join(dir, 'app', 'index.html'), '<main>shell</main>'
  writeFileSync join(dir, 'serve.rip'), """
  export default
    name: 'medlabs'
    sites:
      host: '{site}.medlabs.health'
      dir: 'sites'
      aliases:
        localhost: 'ola'
    files:
      roots: ['sites/{site}/public', 'sites/common/public']
      proxyFirst: ['/api']
      shell: 'app/index.html'
  """

test! "manager registers normalized tenant sites from app-local serve.rip", ->
  ctlSock = join(tmpdir(), "rip-janus-sites-#{Date.now()}-#{rand(1e6)}.sock")
