    eq posts, 2
    ok calls.some((call) -> call.method is 'DELETE' and call.path is '/1.0/apps/browse-bbbbbb'), 'the in-flight replacement becomes shutdown cleanup authority'
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "first SIGINT/SIGTERM performs orderly cleanup for direct and bin/rip launches", ->
  runOrderlyCase = (wrapped, signal) ->
    ctlSock = join(tmpdir(), "rip-janus-orderly-#{if wrapped then 'wrapper' else 'direct'}-#{signal}-#{Date.now()}-#{rand(1e6)}.sock")
    dir = tmpFixture('tmp-browse-orderly-')
    calls = []
    stub = stubJanus ctlSock, calls, (call) ->
      if call.method is 'POST' and call.path is '/1.0/apps'
        return Response.json({ id: 'browse-aaaaaa' }, { status: 201 })
      null
    command =
      if wrapped
        [process.execPath, RIP_BIN, 'server', 'browse', dir, '--control', ctlSock, '--host', 'orderly.example', '--access-log=off']
      else
        [process.execPath, PRELOAD, SERVER_BIN, 'browse', dir, '--control', ctlSock, '--host', 'orderly.example', '--access-log=off']
    proc = Bun.spawn command,
      cwd: dir
      stdin: 'ignore'
      stdout: 'ignore'
      stderr: 'ignore'
      env: { ...process.env, ...TEST_KNOBS }
    try
      waitFor! -> calls.some((call) -> call.method is 'POST' and call.path.endsWith('/heartbeat'))
      proc.kill signal
      eq (await proc.exited), if signal is 'SIGINT' then 130 else 143
      ok calls.some((call) -> call.method is 'DELETE' and call.path is '/1.0/apps/browse-aaaaaa')
    finally
      try proc.kill('SIGKILL')
      await proc.exited
      stub.stop(true)
      rmSync dir, { recursive: true, force: true }
  for signal in ['SIGINT', 'SIGTERM']
    runOrderlyCase! false, signal
    runOrderlyCase! true, signal

test! "second SIGINT/SIGTERM forwards that signal and exits immediately for direct and bin/rip launches", ->
  runSignalCase = (wrapped, signal) ->
    ctlSock = join(tmpdir(), "rip-janus-signal-#{if wrapped then 'wrapper' else 'direct'}-#{signal}-#{Date.now()}-#{rand(1e6)}.sock")
    dir = tmpFixture('tmp-manager-signal-')
    marker = join(dir, 'worker-signals')
    writeFileSync join(dir, 'app.rip'), """
import { appendFileSync } from 'fs'
import { start } from '@rip-lang/server'
process.on '#{signal}', -> appendFileSync #{JSON.stringify(marker)}, '#{signal}\\n'
start()
"""
    calls = []
    stub = stubJanus ctlSock, calls
    command =
      if wrapped
        [process.execPath, RIP_BIN, 'server', '--control', ctlSock, '--name', 'signal', '-w', '2', '--no-watch', '--access-log=off']
      else
        [process.execPath, PRELOAD, SERVER_BIN, '--control', ctlSock, '--name', 'signal', '-w', '2', '--no-watch', '--access-log=off']
    proc = Bun.spawn command,
      cwd: dir
      stdin: 'ignore'
      stdout: 'ignore'
      stderr: 'ignore'
      env: { ...process.env, ...TEST_KNOBS, RIP_DRAIN_MS: '5000', RIP_KILL_MS: '5000' }
    managerPid = null
    workerPids = []
    try
      publication = waitFor! -> managerSockPuts(calls).find((call) -> call.body.upstreams.length is 2)
      managerPid = if wrapped then waitFor!(-> processChildren(proc.pid)[0]) else proc.pid
      workerPids = waitFor! ->
        children = processChildren(managerPid)
        if children.length >= 2 then children else null
      proc.kill signal
      waitFor! -> managerShutdownCut(calls)
      proc.kill signal
      code = await proc.exited
      eq code, if signal is 'SIGINT' then 130 else 143
      waitFor! -> existsSync(marker) and readFileSync(marker, 'utf8').trim().split('\n').length is 2
      eq readFileSync(marker, 'utf8').trim().split('\n'), [signal, signal]
    finally
      try proc.kill('SIGKILL')
      try process.kill(managerPid, 'SIGKILL') if managerPid?
      for pid in workerPids
        try process.kill pid, 'SIGKILL'
      await proc.exited
      stub.stop(true)
      rmSync dir, { recursive: true, force: true }
  for signal in ['SIGINT', 'SIGTERM']
    runSignalCase! false, signal
    runSignalCase! true, signal

test! "second signal exits immediately while workers are still booting", ->
  ctlSock = join(tmpdir(), "rip-janus-booting-signal-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-booting-signal-')
  writeFileSync join(dir, 'app.rip'), '''
import { start } from '@rip-lang/server'
process.on 'SIGINT', -> null
process.on 'SIGTERM', -> null
sleep! 30000
start()
'''
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'booting', '-w', '2', '--no-watch', '--access-log=off'], { RIP_BOOT_DEADLINE_MS: '30000', RIP_DRAIN_MS: '5000', RIP_KILL_MS: '5000' }, 'ignore'
  children = []
  stage = (name, fn) ->
    try
      return waitFor! fn, 10000
    catch e
      throw new Error("#{name}: #{e.message}; children=#{JSON.stringify(processChildren(proc.pid))}; shutdownCut=#{managerShutdownCut(calls)}")
  try
    stage! 'waiting for two booting children', ->
      found = processChildren(proc.pid)
      if found.length >= 2
        children = found
        true
      else
        false
    proc.kill 'SIGTERM'
    stage! 'waiting for first-shutdown admission cut', -> managerShutdownCut(calls)
    forcedAt = Date.now()
    proc.kill 'SIGTERM'
    eq (await proc.exited), 143
    ok Date.now() - forcedAt < 500, 'the second signal skips cleanup waits'
  finally
    try proc.kill('SIGKILL')
    for pid in children
      try process.kill pid, 'SIGKILL'
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "browse retries generated host conflicts but never changes an explicit host", ->
  ctlSock = join(tmpdir(), "rip-janus-browse-conflict-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-browse-conflict-')
  calls = []
  conflicts = { n: 0 }
  stub = stubJanus ctlSock, calls, (call) ->
    if call.method is 'POST' and call.path is '/1.0/apps' and conflicts.n < 2
      conflicts.n += 1
      return new Response('claimed', { status: 409 })
    null
  proc = spawnBrowse dir, ctlSock, ['--until-restart']
  try
    code = await proc.exited
    eq code, 0
    registrations = calls.filter (call) -> call.path is '/1.0/apps'
    eq registrations.length, 3
    hosts = registrations.map (call) -> call.body.hosts[0]
    ok hosts.every((host) -> /^browse-[a-f0-9]{12}\.localhost$/.test(host)), "all generated hosts have the contracted shape: #{hosts}"
    eq new Set(hosts).size, 3
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)

  explicitSock = join(tmpdir(), "rip-janus-browse-explicit-#{Date.now()}-#{rand(1e6)}.sock")
  explicitCalls = []
  explicitStub = stubJanus explicitSock, explicitCalls, (call) ->
    return new Response('claimed', { status: 409 }) if call.method is 'POST' and call.path is '/1.0/apps'
    null
  explicit = spawnBrowse dir, explicitSock, ['--host', 'fixed.example', '--until-restart']
  try
    err = new Response(explicit.stderr).text()
    code = await explicit.exited
    ok code isnt 0, 'explicit conflict exits nonzero'
    ok (await err).includes('fixed.example'), 'the conflict names the fixed host'
    eq explicitCalls.filter((call) -> call.path is '/1.0/apps').length, 1
  finally
    try explicit.kill('SIGKILL')
    await explicit.exited
    explicitStub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "browse rejects a missing directory before touching the control plane", ->
  dir = tmpFixture('tmp-browse-invalid-')
