  try
    reg = waitFor! -> calls.find (c) -> c.method is 'POST' and c.path is '/1.0/apps'
    root = realpathSync(dir)
    eq reg.body,
      name: 'medlabs'
      site:
        host: '{site}.medlabs.health'
        dir: join(root, 'sites')
        aliases:
          localhost: 'ola'
      files:
        roots: [
          { path: join(root, 'static/generated'), cache: 'revalidate', browse: false }
          { path: join(root, 'sites/{site}/public'), cache: 'revalidate', browse: false }
          { path: join(root, 'sites/common/public'), cache: 'revalidate', browse: false }
        ]
        proxy_first: ['/api']
        shell: join(root, 'app/index.html')
      upstreams: []
  finally
