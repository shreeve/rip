    return Response.json({ id: 'manager-aaaaaa' }, { status: 201 }) if call.method is 'POST' and call.path is '/1.0/apps'
    return never if call.method is 'GET' and call.path.endsWith('/access')
    null
  proc = spawnManager dir, ctlSock, ['--name', 'manager', '--host', 'manager.example', '-w', '1', '--no-watch', '--access-log=raw'], {}, 'pipe', 'pipe'
  try
