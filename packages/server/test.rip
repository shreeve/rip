test! "watch off publishes a plain edge App and keeps workers API-only", ->
  ctlSock = join(tmpdir(), "rip-janus-wsprod-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), wsAppSource('hi')
  writeClientDir dir
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'wsprod', '-w', '1', '--no-watch']
  try
    sock = waitFor! ->
      managerSockPuts(calls).find((c) -> c.body.upstreams.length is 1)?.body.upstreams[0].path
    eq (uds!(sock, '/')).status, 404
    generated = join(dir, 'static', 'generated')
    ok existsSync(join(generated, 'bundle.json'))
    eq (uds!(sock, '/manifest.json')).status, 404
    eq (uds!(sock, '/app/routes/index.rip')).status, 404
    eq (uds!(sock, '/hub', { method: 'POST' })).status, 404
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "an API edit cuts only after preparation and sends no App epoch ding", ->
  ctlSock = join(tmpdir(), "rip-janus-wsfull-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), wsAppSource('v1')
  writeClientDir dir
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'wsfull', '-w', '1']
  bells = -> calls.filter (c) -> c.method is 'PUT' and c.body?.upstreams?.some (u) -> u.doorbell
  try
    sock1 = waitFor! ->
      managerSockPuts(calls).find((c) -> c.body.upstreams.length is 1)?.body.upstreams[0].path
    eq ((uds!(sock1, '/hi')).text!), 'v1'
    bellsAt = bells().length
    writeFileSync join(dir, 'app.rip'), wsAppSource('v2')
    waitFor! -> bells().length > bellsAt          # the save cut admission — a full epoch, not a file feed
    ok not calls.some((c) -> c.path.endsWith('/hub/publish')), 'no ding at admission cut — the epoch is not live yet'
    bell = bells()[0].body.upstreams[0].path
    res = uds!(bell, '/ring')
    eq res.status, 204
    sock2 = waitFor! ->
      fresh = managerSockPuts(calls).filter((c) -> c.body.upstreams.length is 1)
      last = fresh[fresh.length - 1]?.body.upstreams[0].path
      if last? and last isnt sock1 then last else null
    eq ((uds!(sock2, '/hi')).text!), 'v2'
    sleep! 100
    epochDings = calls.filter (c) -> c.path.endsWith('/hub/publish') and c.body?.some?((d) -> d.ding?.kind is 'epoch')
    eq epochDings, []
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

# ==[ Manager: the startup report ]==

console.log "\nStartup report"

test "scale humanizes base-unit values: SI prefixes, fixed width, honest ???", ->
  eq scale(0, 's'),       '  0 s'
  eq scale(1.23e-7, 's'), '123ns'
  eq scale(0.0567, 's'),  ' 57ms'
  eq scale(0.789, 's'),   '789ms'
  eq scale(1.5, 's'),     '1.5 s'
  eq scale(12.34, 's'),   ' 12 s'
  eq scale(9.97, 's'),    ' 10 s'    # rounding promotes across the 10 boundary
  eq scale(48211, 'B'),   ' 48kB'
  eq scale(NaN, 's'),     '??? s'
  eq scale(-1, 's'),      '??? s'
  eq scale(1e15, 's'),    '??? s'    # beyond T
  eq scale(1e-13, 's'),   '??? s'    # beneath p
  eq scale(0.15, 's', false), '150ms'
  eq scale(5, 's', false),    '5.0s'

# Captured once by the success test below; the mono pin asserts over the
# same bytes.
report = { out: null }

test! "the startup report states the registration as janus holds it (read-backs)", ->
  ctlSock = join(tmpdir(), "rip-janus-rep-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), appSource('hi')
  calls = []
  seen = { reg: false }
  stub = stubJanus ctlSock, calls, (call) ->
    return null unless call.method is 'GET'
    return null if call.path.endsWith('/access')
    if call.path is '/1.0'
      return Response.json { api_version: '1.0', type: 'janus' }
    if call.path.startsWith('/1.0/apps/')
      # Echo what this stub actually holds: the last upstreams PUT it took.
      puts = calls.filter (c) -> c.method is 'PUT'
      held = if puts.length then puts[puts.length - 1].body.upstreams else []
      seen.reg = true
      return Response.json { id: call.path.split('/').pop(), name: 'repapp', hosts: ['repapp'], upstreams: held }
    null
  proc = spawnManager dir, ctlSock, ['--name', 'repapp', '-w', '2', '--no-watch'], {}, 'inherit', 'pipe'
  try
    waitFor! -> seen.reg              # the report's app read-back arrived
    sleep! 300                        # the report prints right after it
    proc.kill('SIGTERM')
    code = await proc.exited
    eq code, 143
    out = new Response(proc.stdout).text!
    report.out = out
    version = JSON.parse(readFileSync("#{import.meta.dir}/package.json", 'utf8')).version
    ok out.includes("rip server v#{version}"), "names the server and version: #{JSON.stringify(out)}"
    ok out.includes('app      repapp (app-x)'), "app line carries name and registered id: #{JSON.stringify(out)}"
    ok out.includes("control  unix:#{ctlSock} — janus 1.0"), "control line carries the GET /1.0 read-back: #{JSON.stringify(out)}"
    ok out.includes('workers  2'), 'workers line'
    ok out.includes('watch    off'), 'watch line reflects --no-watch'
    ok /✓ worker 1   \S+p1w1\.sock   .{4}s\n/.test(out), "worker 1 row with socket and scaled boot time: #{JSON.stringify(out)}"
    ok /✓ worker 2   \S+p1w2\.sock/.test(out), 'worker 2 row'
    ok out.includes('registered  2 upstreams published, heartbeating every 150ms'),
      "registration facts come from the read-back: #{JSON.stringify(out)}"
    ok out.includes('→ repapp registered with janus, 2 workers ready'), "the arrow line: #{JSON.stringify(out)}"
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test "piped manager stdout is mono — no ANSI escape bytes", ->
  ok report.out?, 'the report test above captured stdout'
  ok not /\x1b/.test(report.out), "no escape bytes in piped output: #{JSON.stringify(report.out)}"

test! "a failed read-back is reported as a failure, never as success", ->
  ctlSock = join(tmpdir(), "rip-janus-repfail-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), appSource('hi')
  calls = []
  reads = []
  # No GET behavior: every read-back gets the stub's stock 404
  stub = stubJanus ctlSock, calls, (call) ->
    reads.push call.path if call.method is 'GET' and call.path.startsWith('/1.0/apps/')
    null
  proc = spawnManager dir, ctlSock, ['--name', 'darkapp', '-w', '1', '--no-watch'], {}, 'inherit', 'pipe'
  try
    waitFor! -> reads.length >= 1
    sleep! 300
    proc.kill('SIGTERM')
    await proc.exited
    out = new Response(proc.stdout).text!
    ok out.includes('control  unix:'), 'the control line still names the endpoint'
    ok out.includes('read-back failed (GET /1.0 → 404)'), "the control read-back failure is named: #{JSON.stringify(out)}"
    ok out.includes('registered  read-back failed (GET /1.0/apps/app-x → 404)'),
      "the registration read-back failure is named: #{JSON.stringify(out)}"
    ok out.includes('→ darkapp up, 1 worker ready — registration read-back failed'),
      "the arrow line does not claim janus-held registration: #{JSON.stringify(out)}"
    ok not out.includes('registered with janus'), 'no faked success'
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

# ==[ Manager: the publish client ]==
#
# publish() rides the manager's own control-plane client (cfetch), so these
# tests drive the imported module in-process: configure its exported state
# (control target + app id) exactly as a completed registration would.

console.log "\nManager publish client"

test! "publish() rejects loudly before registration — no app id, no POST", ->
  eq managerState.appId, null
  err = null
  try
    publish! [{ '@': ['#lobby'] }]
  catch e
    err = e
  ok err?, 'publish without an app id must throw'
  ok err.message.includes('publish before registration'), "names the precondition: #{err.message}"

test! "publish() POSTs the directives to the app's hub publish plane and returns the envelope", ->
  pubSock = join(tmpdir(), "rip-janus-pub-#{Date.now()}-#{rand(1e6)}.sock")
  calls = []
  stub = stubJanus pubSock, calls
  managerState.controlUnix = pubSock
  managerState.appId = 'app-pub'
  try
    directives = [{ '@': ['#lobby'], morph: '<b>hi</b>' }, { '@': ['#lobby'], title: 'x' }]
    env = publish! directives
    call = calls[calls.length - 1]
    eq call.method, 'POST'
    eq call.path, '/1.0/apps/app-pub/hub/publish'
    eq call.body, directives
    eq env, { objects: 2, deliveries: 2, unknown_targets: 0 }
    one = { '@': ['#lobby'], morph: '<i>solo</i>' }
    env = publish! one                # a single directive object ships unwrapped
    eq calls[calls.length - 1].body, one
    eq env, { objects: 1, deliveries: 1, unknown_targets: 0 }
  finally
    managerState.controlUnix = null
    managerState.appId = null
    stub.stop(true)

test! "publish() surfaces a non-2xx answer as an error carrying status and body", ->
  pubSock = join(tmpdir(), "rip-janus-pub409-#{Date.now()}-#{rand(1e6)}.sock")
  calls = []
  stub = stubJanus pubSock, calls, (call) ->
    if call.method is 'POST' and call.path.endsWith('/hub/publish')
      return new Response('hub is enabled on no host', { status: 409 })
    null
  managerState.controlUnix = pubSock
  managerState.appId = 'app-pub'
  try
    err = null
    try
      publish! [{ '@': ['#lobby'] }]
    catch e
      err = e
    ok err?, 'a non-2xx answer must throw'
    ok err.message.includes('publish failed (409)'), "carries the status: #{err.message}"
    ok err.message.includes('hub is enabled on no host'), "carries the body: #{err.message}"
  finally
    managerState.controlUnix = null
    managerState.appId = null
    stub.stop(true)

# ==[ Manager: generated publication correlation invariant ]==
#
# The manifest is the LAST durable coordination document: written only after
# the stable bundle carrying the same hashes. A bundle rewrite failure HOLDS
# THE MANIFEST BACK — a manifest naming hashes the bundle does not carry would
# silently strand fresh boots. Driven
# in-process through the exported singleton (cfg/state/onFileChange).
#
# One App walk feeds the bundle and manifest. A second
# walk can observe a save mid-run and invent the reverse pairing.

console.log "\nManager generated publication"

# Rip entries pair with bundle bytes; CSS/HTML entries pair with their
# authored files (they never enter assembleBundle).
assertManifestMatchesBundle = (manifestPath, bundlePath, appDir = null) ->
  m = JSON.parse readFileSync(manifestPath, 'utf8')
  b = JSON.parse readFileSync(bundlePath, 'utf8')
  modules = b.modules or {}
  for entry in m.files
    if entry.id.endsWith('.css') or entry.id.endsWith('.html')
      ok appDir?, "non-Rip manifest entry #{entry.id} needs appDir"
      file = join(appDir, entry.id)
      ok existsSync(file), "App source must carry #{entry.id}"
      eq entry.hash, ripHash(readFileSync(file, 'utf8')), "#{entry.id}: manifest hash must match file bytes"
      eq modules[entry.id], undefined, "bundle must not carry #{entry.id}"
    else
      source = modules[entry.id]
      ok source?, "bundle must carry #{entry.id}"
      eq entry.hash, ripHash(source), "#{entry.id}: manifest hash must match bundle bytes"

test! "generated publication: a save after the snapshot cannot invent a manifest/bundle reverse pairing", ->
  appDir = tmpFixture('tmp-file-corr-')
  runDir = tmpFixture('tmp-file-corr-run-')
  mkdirSync join(appDir, 'app'), { recursive: true }
  writeFileSync join(appDir, 'app', 'x.rip'), 'export A = 1'
  saved =
    appDir: managerCfg.appDir
    runDir: managerState.runDir
    manifestPath: managerState.manifestPath
    files: managerState.files
    currentPool: managerState.currentPool
    liveBundle: managerState.liveBundle
    afterAppSnapshot: managerState.afterAppSnapshot
  try
    managerCfg.appDir = appDir
    managerState.runDir = runDir
    managerState.manifestPath = null
    managerState.files = {}
    managerState.currentPool = {}
    managerState.liveBundle = join(runDir, 'bundle.json')
    managerState.afterAppSnapshot = ->
      writeFileSync join(appDir, 'app', 'x.rip'), 'export A = 2'
    onFileChange!()
    assertManifestMatchesBundle join(runDir, 'manifest.json'), join(runDir, 'bundle.json'), appDir
    m = JSON.parse readFileSync(join(runDir, 'manifest.json'), 'utf8')
    eq m.files, [{ id: 'app/x.rip', hash: ripHash('export A = 1') }]
  finally
    managerCfg.appDir = saved.appDir
    managerState.runDir = saved.runDir
    managerState.manifestPath = saved.manifestPath
    managerState.files = saved.files
    managerState.currentPool = saved.currentPool
    managerState.liveBundle = saved.liveBundle
    managerState.afterAppSnapshot = saved.afterAppSnapshot
    rmSync appDir, { recursive: true, force: true }
    rmSync runDir, { recursive: true, force: true }

# ==[ Capability 10 access client ]==

console.log "\nAccess client"

accessEvent = (overrides = {}) ->
  {
    v: 1
    type: 'access'
    sequence: '9007199254740993'
    timestamp: '2026-08-01T14:16:01.100Z'
    request_id: '10d21165-2701-4c37-b948-c93d891da3b1'
    app_id: 'cart-a1b2c3'
    app_name: 'cart'
    tenant_site: null
    request_host: 'cart.ripdev.io'
    client_ip: '127.0.0.1'
    method: 'GET'
    path: '/products/blue%20cup'
    status: 200
    duration_seconds: 0.0021
    response_bytes: '918'
    mime_type: 'text/html; charset=utf-8'
    response_class: 'file'
    cache_verdict: 'off'
    selected_upstream: null
    retry_count: 0
    outcome: 'complete'
    mark: null
    ...overrides
  }

accessBytes = (record) -> new TextEncoder().encode(JSON.stringify(record) + '\n')
ACCESS_APP_ID =! 'cart-a1b2c3'

memorySink = (writes, opts = {}) ->
  count = 0
  {
    isTTY: opts.isTTY is true
    write: (bytes, callback) ->
      count += 1
      value = if typeof bytes is 'string' then Buffer.from(bytes) else Buffer.from(bytes)
      writes.push value
      writeError = opts.errorAt?(count, value)
      callback?(writeError)
      not writeError?
    once: -> null
  }

test "the default access picture is legal and carries the contracted fields", ->
  parts = parseAccessPicture(DEFAULT_ACCESS_PICTURE)
  fields = parts.filter((part) -> part.kind is 'field').map((part) -> part.field)
  eq fields, ['local_time', 'local_timezone', 'duration_seconds', 'status', 'mime_abbrev', 'response_bytes', 'method', 'path', 'mark']

test "pictures parse exact width, alignment, overflow, scale composition, and positioned errors", ->
  formats = [
    ['{method:8}', '<', 8, 'edge']
    ['{method:<8}', '<', 8, 'edge']
    ['{method:>8}', '>', 8, 'edge']
    ['{method:^8}', '^', 8, 'edge']
    ['{method:8^}', '<', 8, 'middle']
    ['{method:<8^}', '<', 8, 'middle']
    ['{method:>8^}', '>', 8, 'middle']
  ]
  for [picture, direction, width, overflow] in formats
    part = parseAccessPicture(picture)[0]
    eq [part.align.direction, part.align.width, part.align.overflow], [direction, width, overflow]
  scaled = parseAccessPicture('{response_bytes:>8@B}')[0]
  eq [scaled.align.direction, scaled.align.width, scaled.align.overflow, scaled.scaleUnit], ['>', 8, 'edge', 'B']
  middleScaled = parseAccessPicture('{response_bytes:20^@Hz}')[0]
  eq [middleScaled.align.direction, middleScaled.align.width, middleScaled.align.overflow, middleScaled.scaleUnit], ['<', 20, 'middle', 'Hz']
  eq parseAccessPicture('{duration_seconds:@s}')[0].align, null
  eq renderAccess(accessEvent(), '{{{method}}}'), '{GET}'
  throws (-> parseAccessPicture('{unknown}')), 'offset 1'
  throws (-> parseAccessPicture('🙂{method:0}')), 'offset 10'
  throws (-> parseAccessPicture('{method:@s}')), 'cannot be scaled'
  throws (-> parseAccessPicture('{response_bytes:@}')), 'must not be empty'
  throws (-> parseAccessPicture('{response_bytes:@\n}')), 'unsafe scalar'
  throws (-> parseAccessPicture('{response_bytes:<1025}')), '1 through 1024'
  throws (-> parseAccessPicture('{method:^1}')), 'center width must be 3 through 1024'
  throws (-> parseAccessPicture('{method:^2}')), 'center width must be 3 through 1024'
  throws (-> parseAccessPicture('{method:^3^}')), 'center alignment cannot use trailing middle ellipsis'
  throws (-> parseAccessPicture('🙂{method:^3^}')), 'offset 10'
  throws (-> parseAccessPicture('{method:>2^^}')), "expected '}'"

test "exact widths pad short values and apply every overflow placement", ->
  event = accessEvent({ method: 'ABCDEFG' })
  cases = [
    ['{method:5}', 'ABCD…']
    ['{method:<5}', 'ABCD…']
    ['{method:>5}', '…DEFG']
    ['{method:^5}', '…CDE…']
    ['{method:5^}', 'AB…FG']
    ['{method:<5^}', 'AB…FG']
    ['{method:>5^}', 'AB…FG']
  ]
  for [picture, expected] in cases
    actual = renderAccess event, picture
    eq actual, expected
    eq Bun.stringWidth(actual), 5
  short = accessEvent({ method: 'ABC' })
  eq renderAccess(short, '{method:6}'), 'ABC   '
  eq renderAccess(short, '{method:<6}'), 'ABC   '
  eq renderAccess(short, '{method:>6}'), '   ABC'
  eq renderAccess(short, '{method:^6}'), ' ABC  '
  eq renderAccess(short, '{method:6^}'), 'ABC   '
  eq renderAccess(short, '{method:>6^}'), '   ABC'
  eq renderAccess(accessEvent({ method: 'ABCDE' }), '{method:5}'), 'ABCDE'
  eq renderAccess(accessEvent({ method: 'ABCDEF' }), '{method:5}'), 'ABCD…'

test "middle ellipsis follows the exact S=1 through 6 split", ->
  event = accessEvent({ method: 'ABCDEFG' })
  expected = ['…', 'A…', 'A…G', 'AB…G', 'AB…FG', 'ABC…FG']
  for slot in [1..6]
    actual = renderAccess event, "{method:#{slot}^}"
    eq actual, expected[slot - 1]
    eq Bun.stringWidth(actual), slot

test "exact widths preserve graphemes and fill wide allocation gaps deterministically", ->
  cases = [
    ['購物', '{mark:6}', '購物  ', 6]
    ['界A', '{mark:3}', '界A', 3]
    ['界A', '{mark:2}', ' …', 2]
    ['界A', '{mark:>2}', '…A', 2]
    ["e\u0301x", '{mark:2}', "e\u0301x", 2]
    ["e\u0301x", '{mark:1}', '…', 1]
    ['👩‍💻A', '{mark:3}', '👩‍💻A', 3]
    ['👩‍💻A', '{mark:2}', ' …', 2]
    ['A界BC', '{mark:4^}', 'A …C', 4]
    ['A界BC', '{mark:^4}', '…界…', 4]
  ]
  for [value, picture, expected, width] in cases
    actual = renderAccess accessEvent({ mark: value }), picture
    eq actual, expected
    eq Bun.stringWidth(actual), width
  ok not renderAccess(accessEvent({ mark: '👩‍💻A' }), '{mark:2}').includes('👩'), 'a ZWJ grapheme is never split'

test "every bounded Unicode mode reports its requested Bun.stringWidth", ->
  values = ['界界ABC', "e\u0301e\u0301ABC", '👩‍💻👨‍👩‍👧‍👦ABC', "\u0301ABCDEF", "A\nB界C"]
  for value in values
    event = accessEvent({ mark: value })
    for slot in [1..8]
      pictures = ["{mark:#{slot}}", "{mark:<#{slot}}", "{mark:>#{slot}}", "{mark:#{slot}^}"]
      pictures.push "{mark:^#{slot}}" if slot >= 3
      for picture in pictures
        rendered = renderAccess event, picture
        eq Bun.stringWidth(rendered), slot, "#{JSON.stringify(value)} with #{picture}"
        ok not rendered.includes('……'), "#{picture} never emits adjacent ellipses"

test "escaped controls are atomic under exact-width truncation", ->
  escaped = renderAccess accessEvent({ mark: "A\nB" }), '{mark}'
  eq escaped, 'A\\u{000A}B'
  eq Bun.stringWidth(escaped), 10
  end = renderAccess accessEvent({ mark: "A\nB" }), '{mark:7}'
  middle = renderAccess accessEvent({ mark: "A\nB" }), '{mark:9^}'
  eq end, 'A     …'
  eq middle, 'A   …   B'
  eq Bun.stringWidth(end), 7
  eq Bun.stringWidth(middle), 9
  ok not end.includes('\\u{'), 'an escaped control is omitted whole'
  ok not middle.includes('\\u{'), 'middle truncation never cuts an escaped control'

test "scale runs before exact-width formatting while scale-only stays unbounded", ->
  event = accessEvent({ response_bytes: '918' })
  eq renderAccess(event, '{response_bytes:@B}'), '918 B'
  eq renderAccess(event, '{response_bytes:>8@B}'), '   918 B'
  eq renderAccess(event, '{response_bytes:>4@B}'), '…8 B'
  eq renderAccess(event, '{response_bytes:4^@B}'), '91…B'
  for picture in ['{response_bytes:>8@B}', '{response_bytes:>4@B}', '{response_bytes:4^@B}']
    width = parseAccessPicture(picture)[0].align.width
    eq Bun.stringWidth(renderAccess(event, picture)), width

test "scale follows the v3 significand and SI-prefix oracle with arbitrary units", ->
  eq scaleAccess(0, 'B'), '  0 B'
  eq scaleAccess(0.000999, 's'), '1.0ms'
  eq scaleAccess(0.000000000001, 'Hz'), '1.0pHz'
  eq scaleAccess(999.49, 'B'), '999 B'
  eq scaleAccess(999.5, 'B'), '1.0kB'
  eq scaleAccess(Infinity, 'B'), '??? B'
  eq scaleAccess(1, ' '), '1.0  '

test "pretty rendering derives time/MIME, aligns by terminal width, and escapes controls", ->
  event = accessEvent({ path: '/x', mark: "wide界\n\u202E" })
  line = renderAccess event, '{mime_abbrev:<4}|{path}|{mark:>8}'
  eq line, 'html|/x|…       '
  eq Bun.stringWidth(line.split('|').pop()), 8
  eq renderAccess(accessEvent({ mime_type: 'application/vnd.microsoft.icon' }), '{mime_abbrev}'), 'icon'
  eq renderAccess(accessEvent({ mime_type: 'application/vnd.example' }), '{mime_abbrev}'), 'vnd.example'
  eq renderAccess(accessEvent({ mark: '👩‍💻' }), '{mark}'), '👩‍💻'
  eq renderAccess(accessEvent({ mark: null }), '{mark}'), '-'
  throws (-> renderAccess(accessEvent({ status: '200' }), '{status}')), 'status must be'
  throws (-> renderAccess(accessEvent({ path: "\ud800" }), '{path}')), 'lone surrogate'

test "LF framing validates exact ordered envelopes and preserves source bytes", ->
  bytes = accessBytes(accessEvent())
  accepted = validateAccessLine(bytes)
  eq accepted.record.sequence, '9007199254740993'
  eq Buffer.from(accepted.bytes), Buffer.from(bytes)
  throws (-> validateAccessLine(new TextEncoder().encode('{}\r\n'))), 'CRLF'
  throws (-> validateAccessLine(new TextEncoder().encode('\n'))), 'empty'
  duplicate = new TextEncoder().encode('{"v":1,"v":1,"type":"heartbeat","app_id":"x","head":"0","timestamp":"2026-08-01T14:16:15Z"}\n')
  throws (-> validateAccessLine(duplicate)), 'duplicated'
  reordered = new TextEncoder().encode('{"type":"heartbeat","v":1,"app_id":"x","head":"0","timestamp":"2026-08-01T14:16:15Z"}\n')
  throws (-> validateAccessLine(reordered)), 'out of order'
  throws (-> validateAccessLine(accessBytes(accessEvent({ timestamp: '2026-02-30T00:00:00Z' })))), 'timestamp is malformed'

test "access validation enforces every bounded protocol field", ->
  bad = [
    [{ sequence: '01' }, 'sequence']
    [{ sequence: '18446744073709551616' }, 'sequence']
    [{ timestamp: '2026-02-29T00:00:00Z' }, 'timestamp']
    [{ request_id: 'not-a-uuid' }, 'request_id']
    [{ request_id: '10D21165-2701-4c37-b948-c93d891da3b1' }, 'request_id']
    [{ app_name: 'Bad', app_id: 'Bad-a1b2c3' }, 'app_name']
    [{ app_id: 'cart-short' }, 'app_id']
    [{ app_name: 'a'.repeat(64), app_id: "#{'a'.repeat(64)}-a1b2c3" }, 'app_name']
    [{ tenant_site: 'Bad_Site' }, 'tenant_site']
    [{ tenant_site: 'a'.repeat(64) }, 'tenant_site']
    [{ request_host: 'Bad Host' }, 'request_host']
    [{ request_host: 'UPPER.example' }, 'request_host']
    [{ client_ip: '999.1.1.1' }, 'client_ip']
    [{ method: 'GET QUERY' }, 'method']
    [{ method: '' }, 'method']
    [{ method: 'G'.repeat(33) }, 'method']
    [{ path: '/private?token=secret' }, 'path']
    [{ path: '/bad%2' }, 'path']
    [{ path: '/'.repeat(4097) }, 'path']
    [{ status: 99 }, 'status']
    [{ status: 600 }, 'status']
    [{ duration_seconds: -1 }, 'duration_seconds']
    [{ duration_seconds: Infinity }, 'duration_seconds']
    [{ response_bytes: '18446744073709551616' }, 'response_bytes']
    [{ mime_type: '' }, 'mime_type']
    [{ mime_type: ' text/html ' }, 'mime_type']
    [{ mime_type: 'x'.repeat(257) }, 'mime_type']
    [{ selected_upstream: 'worker-NOT-OPAQUE' }, 'selected_upstream']
    [{ retry_count: 1.5 }, 'retry_count']
    [{ retry_count: 4294967296 }, 'retry_count']
    [{ mark: '' }, 'mark']
    [{ mark: '界'.repeat(86) }, 'mark']
    [{ response_class: 'worker' }, 'response_class']
    [{ cache_verdict: 'warm' }, 'cache_verdict']
    [{ outcome: 'failed' }, 'outcome']
  ]
  for [change, field] in bad
    throws (-> validateAccessLine(accessBytes(accessEvent(change)))), field
  omittedWrong = { ...accessEvent({ mark: 'present' }), omitted_fields: ['mark'] }
  throws (-> validateAccessLine(accessBytes(omittedWrong))), 'must name null fields'
  validAdjusted = { ...accessEvent({ mime_type: null }), truncated_fields: ['method', 'path'], omitted_fields: ['mark', 'mime_type'] }
  validateAccessLine accessBytes(validAdjusted)
  name = 'a'.repeat(63)
  host = "#{'a'.repeat(63)}.#{'b'.repeat(63)}.#{'c'.repeat(63)}.#{'d'.repeat(61)}"
  validateAccessLine accessBytes(accessEvent({
    app_name: name
    app_id: "#{name}-a1b2c3"
    tenant_site: 's'.repeat(63)
    request_host: host
    client_ip: '2001:db8::1'
    method: 'M'.repeat(32)
    path: '/' + 'p'.repeat(4095)
    mime_type: 'm'.repeat(256)
    mark: 'k'.repeat(256)
    retry_count: 4294967295
  }))

test "the incremental framer spans chunks, rejects oversize lines, and diagnoses incomplete EOF", ->
  lines = []
  errors = []
  hello = accessBytes({ v: 1, type: 'hello', app_id: ACCESS_APP_ID, app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
  frame = new AccessFramer ((line) -> lines.push(line.record.type)), ((e) -> errors.push(e.message))
  frame.feed hello.slice(0, 7)
  frame.feed hello.slice(7)
  frame.finish()
  eq lines, ['hello']
  eq errors, []
  partial = new AccessFramer (-> null), ((e) -> errors.push(e.message))
  partial.feed new TextEncoder().encode('{"v":1')
  partial.finish()
  ok errors.some((message) -> message.includes('incomplete record'))
  tooBig = new AccessFramer (-> null), ((e) -> errors.push(e.message))
  tooBig.feed new Uint8Array(8193).fill(120)
  ok errors.some((message) -> message.includes('before LF'))

test "the framer bounds retained and copied bytes for one attacker-sized chunk", ->
  lines = []
  errors = []
  hello = accessBytes({ v: 1, type: 'hello', app_id: ACCESS_APP_ID, app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
  attackBytes = 16 * 1024 * 1024
  chunk = new Uint8Array(hello.length + attackBytes)
  chunk.set hello
  chunk.fill 120, hello.length
  Bun.gc true
  memoryBefore = process.memoryUsage().arrayBuffers
  peakGrowth = 0
  frame = new AccessFramer ((line) -> lines.push(line.record.type)), ((e) ->
    peakGrowth = process.memoryUsage().arrayBuffers - memoryBefore
    errors.push e.message
  )
  frame.feed chunk
  Bun.gc true
  retainedGrowth = process.memoryUsage().arrayBuffers - memoryBefore
  eq lines, ['hello']
  ok errors.some((message) -> message.includes('before LF'))
  ok frame.buffer.length <= MAX_ACCESS_LINE_BYTES, "retained bytes stay bounded: #{frame.buffer.length}"
  ok peakGrowth < attackBytes / 2, "framing does not copy the complete attacker chunk: peak growth=#{peakGrowth}"
  ok retainedGrowth < attackBytes / 2, "framing does not retain the complete attacker chunk: growth=#{retainedGrowth}"

test! "registration generations abort and move exactly one live subscription", ->
  seen = []
  sink =
    write: (bytes, callback) ->
      callback?(null)
      true
    once: -> null
  fetcher = (url, opts) ->
    appId = decodeURIComponent(new URL(url).pathname.split('/')[3])
    seen.push appId
    appName = appId.slice(0, appId.lastIndexOf('-'))
    body = new ReadableStream
      start: (controller) ->
        controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: appId, app_name: appName, after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
        opts.signal.addEventListener 'abort', (-> controller.close()), { once: true }
    new Response(body, { status: 200 })
  client = new AccessClient { mode: 'pretty', control: { base: 'http://janus' }, stdout: sink, stderr: sink, fetch: fetcher, sample: -> 0 }
  client.move('generation-aaaaaa')
  waitFor! -> seen.includes('generation-aaaaaa')
  client.move('generation-bbbbbb')
  waitFor! -> seen.includes('generation-bbbbbb')
  client.stop!()
  eq seen.filter((id) -> id is 'generation-aaaaaa').length, 1
  eq seen.filter((id) -> id is 'generation-bbbbbb').length, 1

test! "a blocked old output completes before a replacement generation starts", ->
  writes = []
  callbacks = []
  active = 0
  maxActive = 0
  sink =
    write: (bytes, callback) ->
      active += 1
      maxActive = Math.max(maxActive, active)
      writes.push JSON.parse(Buffer.from(bytes).toString()).app_id
      callbacks.push (error = null) ->
        active -= 1
        callback error
      true
    once: -> null
  calls = []
  fetcher = (url, opts) ->
    appId = decodeURIComponent(new URL(url).pathname.split('/')[3])
    calls.push appId
    appName = appId.slice(0, appId.lastIndexOf('-'))
    new Response(new ReadableStream
      start: (controller) ->
        controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: appId, app_name: appName, after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
        opts.signal.addEventListener 'abort', (-> controller.close()), { once: true }
    )
  client = new AccessClient { mode: 'raw', control: { base: 'http://janus' }, stdout: sink, stderr: memorySink([]), fetch: fetcher }
  client.move 'old-aaaaaa'
  waitFor! -> writes.length is 1
  replacement = client.move 'new-bbbbbb'
  sleep! 20
  eq calls, ['old-aaaaaa']
  eq writes, ['old-aaaaaa']
  callbacks.shift()()
  waitFor! -> writes.length is 2
  eq calls, ['old-aaaaaa', 'new-bbbbbb']
  eq maxActive, 1
  callbacks.shift()()
  client.stop!()
  await replacement

test! "an aborted old generation keeps its blocked terminal output failure", ->
  callback = null
  sink =
    write: (bytes, done) ->
      callback = done
      true
    once: -> null
  calls = []
  fetcher = (url, opts) ->
    appId = decodeURIComponent(new URL(url).pathname.split('/')[3])
    calls.push appId
    appName = appId.slice(0, appId.lastIndexOf('-'))
    new Response(new ReadableStream
      start: (controller) ->
        controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: appId, app_name: appName, after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
        opts.signal.addEventListener 'abort', (-> controller.close()), { once: true }
    )
  client = new AccessClient { mode: 'raw', control: { base: 'http://janus' }, stdout: sink, stderr: memorySink([]), fetch: fetcher }
  client.move 'old-aaaaaa'
  waitFor! -> callback?
  replacement = client.move 'new-bbbbbb'
  failure = Object.assign(new Error('old output failed'), { code: 'EPIPE' })
  callback failure
  caught = null
  try
    await replacement
  catch e
    caught = e
  ok caught?.accessOutput, 'the old terminal output failure propagates through the generation cut'
  eq calls, ['old-aaaaaa']

test! "a stale generation resolving after move cannot write or reconnect", ->
  output = []
  oldGate: any = {}
  oldGate.promise = new Promise (resolve) -> oldGate.open = resolve
  calls = []
  fetcher = (url, opts) ->
    appId = decodeURIComponent(new URL(url).pathname.split('/')[3])
    calls.push appId
    return oldGate.promise if appId is 'old-aaaaaa'
    body = new ReadableStream
      start: (controller) ->
        controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: 'new-bbbbbb', app_name: 'new', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
        opts.signal.addEventListener 'abort', (-> controller.close()), { once: true }
    new Response(body)
  client = new AccessClient { mode: 'raw', control: { base: 'http://janus' }, stdout: memorySink(output), stderr: memorySink([]), fetch: fetcher, sample: -> 0 }
  client.move 'old-aaaaaa'
  waitFor! -> calls.includes('old-aaaaaa')
  client.move 'new-bbbbbb'
  sleep! 20
  eq calls, ['old-aaaaaa']
  oldGate.open new Response(new ReadableStream({ start: (controller) ->
    controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: 'old-aaaaaa', app_name: 'old', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
    controller.enqueue accessBytes(accessEvent({ app_id: 'old-aaaaaa', app_name: 'old', sequence: '1' }))
    controller.close()
  }))
  waitFor! -> calls.includes('new-bbbbbb') and output.length is 1
  client.stop!()
  text = Buffer.concat(output).toString()
  ok text.includes('new-bbbbbb')
  ok not text.includes('old-aaaaaa')
  eq calls.filter((id) -> id is 'old-aaaaaa').length, 1

test! "raw mode writes accepted source records byte-for-byte", ->
  output = []
  sink =
    write: (bytes, callback) ->
      output.push Buffer.from(bytes)
      callback?(null)
      true
    once: -> null
  errors =
    write: (bytes, callback) ->
      callback?(null)
      true
    once: -> null
  calls = 0
  fetcher = (url, opts) ->
    calls += 1
    appId = 'raw-aaaaaa'
    body = new ReadableStream
      start: (controller) ->
        if calls is 1
          controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: appId, app_name: 'raw', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
          controller.enqueue accessBytes(accessEvent({ app_id: appId, app_name: 'raw', sequence: '1' }))
          controller.close()
        else
          opts.signal.addEventListener 'abort', (-> controller.close()), { once: true }
    new Response(body, { status: 200 })
  client = new AccessClient { mode: 'raw', control: { base: 'http://janus' }, stdout: sink, stderr: errors, fetch: fetcher, sample: -> 0 }
  client.move('raw-aaaaaa')
  waitFor! -> output.length is 2
  client.stop!()
  expected = Buffer.concat [
    Buffer.from(accessBytes({ v: 1, type: 'hello', app_id: 'raw-aaaaaa', app_name: 'raw', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 }))
    Buffer.from(accessBytes(accessEvent({ app_id: 'raw-aaaaaa', app_name: 'raw', sequence: '1' })))
  ]
  eq Buffer.concat(output), expected

test! "valid records preceding a malformed record in one chunk are consumed first", ->
  stdout = []
  stderr = []
  calls = 0
  hello = accessBytes({ v: 1, type: 'hello', app_id: ACCESS_APP_ID, app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
  event = accessBytes(accessEvent({ sequence: '1' }))
  malformed = new TextEncoder().encode('{}\n')
  fetcher = (url, opts) ->
    calls += 1
    if calls is 1
      bytes = new Uint8Array(hello.length + event.length + malformed.length)
      bytes.set hello
      bytes.set event, hello.length
      bytes.set malformed, hello.length + event.length
      return new Response(new ReadableStream({ start: (controller) -> controller.enqueue(bytes); controller.close() }))
    new Promise (resolve, reject) ->
      opts.signal.addEventListener 'abort', (-> reject(opts.signal.reason)), { once: true }
  client = new AccessClient
    mode: 'raw'
    control: { base: 'http://janus' }
    stdout: memorySink(stdout)
    stderr: memorySink(stderr)
    fetch: fetcher
    sample: -> 0
  client.move ACCESS_APP_ID
  waitFor! -> calls >= 2
  client.stop!()
  eq Buffer.concat(stdout), Buffer.concat([Buffer.from(hello), Buffer.from(event)])
  ok Buffer.concat(stderr).toString().includes('reconnecting'), 'the later malformed record is diagnosed after both valid writes'

test! "no_replay is exactly one immediate required post-hello transition", ->
  runCase = (records) ->
    stdout = []
    stderr = []
    calls = 0
    fetcher = (url, opts) ->
      calls += 1
      if calls is 1
        return new Response(new ReadableStream({ start: (controller) ->
          controller.enqueue accessBytes(record) for record in records
          controller.close()
        }))
      new Promise (resolve, reject) ->
        opts.signal.addEventListener 'abort', (-> reject(opts.signal.reason)), { once: true }
    client = new AccessClient { mode: 'raw', control: { base: 'http://janus' }, stdout: memorySink(stdout), stderr: memorySink(stderr), fetch: fetcher, sample: -> 0 }
    client.move ACCESS_APP_ID
    waitFor! -> calls >= 2
    client.stop!()
    { stdout: Buffer.concat(stdout).toString(), stderr: Buffer.concat(stderr).toString() }
  hello0 = { v: 1, type: 'hello', app_id: ACCESS_APP_ID, app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 }
  heartbeat0 = { v: 1, type: 'heartbeat', app_id: ACCESS_APP_ID, head: '0', timestamp: '2026-08-01T14:16:15Z' }
  lateGap = { v: 1, type: 'gap', app_id: ACCESS_APP_ID, from: '1', through: '1', head: '1', reason: 'no_replay' }
  late = runCase! [hello0, heartbeat0, lateGap]
  ok late.stderr.includes('only legal immediately after hello')
  ok not late.stdout.includes('"type":"gap"'), 'the illegal late gap is never emitted'
  hello2 = { ...hello0, head: '2' }
  initial = { v: 1, type: 'gap', app_id: ACCESS_APP_ID, from: '1', through: '2', head: '2', reason: 'no_replay' }
  second = { v: 1, type: 'gap', app_id: ACCESS_APP_ID, from: '3', through: '3', head: '3', reason: 'no_replay' }
  duplicate = runCase! [hello2, initial, second]
  ok duplicate.stderr.includes('only legal immediately after hello')
  eq duplicate.stdout.match(/"reason":"no_replay"/g)?.length, 1

test! "overflow gaps advance the cursor with diagnostic-before-raw ordering", ->
  events = []
  calls = 0
  sink = (kind) ->
    write: (bytes, callback) ->
      events.push "#{kind}:#{Buffer.from(bytes).toString()}"
      callback()
      true
    once: -> null
  records = [
    { v: 1, type: 'hello', app_id: ACCESS_APP_ID, app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 }
    accessEvent({ sequence: '1' })
    { v: 1, type: 'gap', app_id: ACCESS_APP_ID, from: '2', through: '4', head: '5', reason: 'overflow' }
    accessEvent({ sequence: '5' })
    accessEvent({ sequence: '7' })
  ]
  fetcher = (url, opts) ->
    calls += 1
    if calls is 1
      return new Response(new ReadableStream({ start: (controller) ->
        controller.enqueue accessBytes(record) for record in records
        controller.close()
      }))
    new Promise (resolve, reject) ->
      opts.signal.addEventListener 'abort', (-> reject(opts.signal.reason)), { once: true }
  client = new AccessClient { mode: 'raw', control: { base: 'http://janus' }, stdout: sink('out'), stderr: sink('err'), fetch: fetcher, sample: -> 0 }
  client.move ACCESS_APP_ID
  waitFor! -> calls >= 2
  client.stop!()
  gapDiagnostic = events.findIndex((event) -> event.includes('access gap 2..4'))
  gapRaw = events.findIndex((event) -> event.startsWith('out:') and event.includes('"type":"gap"'))
  ok 0 <= gapDiagnostic < gapRaw, 'gap diagnostic completes before exact raw gap output'
  ok events.some((event) -> event.startsWith('out:') and event.includes('"sequence":"5"')), 'the post-gap next sequence is accepted'
  ok not events.some((event) -> event.startsWith('out:') and event.includes('"sequence":"7"')), 'a skipped sequence is rejected before output'

test! "closed is consumed and reconnects without waiting for peer EOF", ->
  stdout = []
  calls = 0
  canceled = false
  fetcher = (url, opts) ->
    calls += 1
    if calls is 1
      return new Response(new ReadableStream
        start: (controller) ->
          controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: ACCESS_APP_ID, app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
          controller.enqueue accessBytes({ v: 1, type: 'closed', app_id: ACCESS_APP_ID, head: '0', timestamp: '2026-08-01T14:16:20Z', reason: 'generation_stop' })
        cancel: -> canceled = true
      )
    new Promise (resolve, reject) ->
      opts.signal.addEventListener 'abort', (-> reject(opts.signal.reason)), { once: true }
  client = new AccessClient { mode: 'raw', control: { base: 'http://janus' }, stdout: memorySink(stdout), stderr: memorySink([]), fetch: fetcher, sample: -> 0 }
  client.move ACCESS_APP_ID
  waitFor! -> calls >= 2
  client.stop!()
  ok canceled, 'the still-open first body was canceled'
  ok Buffer.concat(stdout).toString().includes('"type":"closed"'), 'closed was written before reconnect'

test! "backoff doubles with full jitter and resets only after a valid hello", ->
  delays = []
  calls = 0
  fetcher = (url, opts) ->
    calls += 1
    if calls is 2
      body = new ReadableStream({ start: (controller) ->
        controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: 'other-aaaaaa', app_name: 'other', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
        controller.close()
      })
      return new Response(body)
    return new Response('no', { status: 500 }) if calls <= 8
    if calls is 9
      body = new ReadableStream({ start: (controller) ->
        controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: ACCESS_APP_ID, app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
        controller.close()
      })
      return new Response(body)
    new Promise (resolve, reject) ->
      opts.signal.addEventListener 'abort', (-> reject(opts.signal.reason)), { once: true }
  sleep = (ms, signal) -> delays.push(ms)
  client = new AccessClient { mode: 'pretty', control: { base: 'http://janus' }, stdout: memorySink([]), stderr: memorySink([]), fetch: fetcher, sample: -> 0.5, sleep }
  client.move ACCESS_APP_ID
  waitFor! -> delays.length is 9
  client.stop!()
  eq delays, [50, 100, 200, 400, 800, 1600, 2500, 2500, 50]

test! "raw partial EPIPE is terminal and never reconnects", ->
  calls = 0
  writes = []
  broken = memorySink writes,
    errorAt: (count, bytes) ->
      return null unless count is 2
      writes[writes.length - 1] = bytes.subarray(0, Math.floor(bytes.length / 2))
      writeError = new Error('broken pipe')
      writeError.code = 'EPIPE'
      writeError
  fetcher = ->
    calls += 1
    new Response(new ReadableStream({ start: (controller) ->
      controller.enqueue accessBytes({ v: 1, type: 'hello', app_id: ACCESS_APP_ID, app_name: 'cart', after: '0', head: '0', heartbeat_seconds: 15, max_line_bytes: 8192 })
      controller.enqueue accessBytes(accessEvent({ sequence: '1' }))
      controller.close()
    }))
  client = new AccessClient { mode: 'raw', control: { base: 'http://janus' }, stdout: broken, stderr: memorySink([]), fetch: fetcher, sample: -> 0 }
  caught = null
  try
    client.move! ACCESS_APP_ID
  catch e
    caught = e
  ok caught?.accessOutput, 'partial stdout failure is classified as terminal output'
  eq calls, 1

test! "pretty ANSI wraps the complete rendered picture only on color TTYs", ->
  event = accessEvent({ sequence: '1' })
  line = { record: event, bytes: accessBytes(event) }
  prior = process.env.NO_COLOR
  try
    delete process.env.NO_COLOR
    color = []
    client = new AccessClient { mode: 'pretty', picture: '{method:>5}', stdout: memorySink(color, { isTTY: true }), stderr: memorySink([]), control: {} }
    client.consume! line
    eq Buffer.concat(color).toString(), '\x1b[36m  GET\x1b[0m\n'
    mono = []
    client = new AccessClient { mode: 'pretty', picture: '{method:>5}', stdout: memorySink(mono), stderr: memorySink([]), control: {} }
    client.consume! line
    eq Buffer.concat(mono).toString(), '  GET\n'
    process.env.NO_COLOR = '1'
    noColor = []
    client = new AccessClient { mode: 'pretty', picture: '{method}', stdout: memorySink(noColor, { isTTY: true }), stderr: memorySink([]), control: {} }
    client.consume! line
    eq Buffer.concat(noColor).toString(), 'GET\n'
  finally
    if prior? then process.env.NO_COLOR = prior else delete process.env.NO_COLOR

test! "worker output pump drains high volume under destination backpressure", ->
  chunks = 256
  bytes = 8192
  readable = new ReadableStream
    start: (controller) ->
      controller.enqueue new Uint8Array(bytes).fill(i % 251) for i in [0...chunks]
      controller.close()
  total = 0
  destination =
    write: (chunk, callback) ->
      setTimeout (->
        total += chunk.length
        callback()
      ), 0
      false
    once: -> null
  pumpAccessOutput! readable, destination
  eq total, chunks * bytes

test! "backpressured output removes every temporary error listener", ->
  sink = new EventEmitter()
  sink.write = (chunk, callback) ->
    queueMicrotask -> callback()
    false
  for i in [0...1000]
    writeAccessOutput! sink, 'x'
    eq sink.listenerCount('error'), 0

test! "access CLI rejects contract conflicts before touching Janus", ->
  dir = tmpFixture('tmp-access-cli-')
  try
    result = await managerCommand(dir, ['browse', dir, '--until-restart', '--access-log=raw'])
    ok result.code isnt 0
    ok result.err.includes('explicit access flags conflict')
    result = await managerCommand(dir, ['browse', dir, '--access-log=raw', '--access-format', '{method}'])
    ok result.code isnt 0
    ok result.err.includes('only applies with --access-log=pretty')
    result = await managerCommand(dir, ['browse', dir, '--access-format', '{response_bytes:@}'])
    ok result.code isnt 0
    ok result.err.includes('scale unit must not be empty')
  finally
    rmSync dir, { recursive: true, force: true }

test! "a generated publication with no live bundle holds the manifest back", ->
  appDir = tmpFixture('tmp-nopool-')
  runDir = tmpFixture('tmp-nopool-run-')
  mkdirSync join(appDir, 'app'), { recursive: true }
  writeFileSync join(appDir, 'app', 'x.rip'), 'export A = 1'
  saved =
    appDir: managerCfg.appDir
    runDir: managerState.runDir
    manifestPath: managerState.manifestPath
    files: managerState.files
    currentPool: managerState.currentPool
    liveBundle: managerState.liveBundle
  try
    managerCfg.appDir = appDir
    managerState.runDir = runDir
    managerState.manifestPath = null
    managerState.files = {}
    managerState.currentPool = null          # no live pool — must not write a manifest
    managerState.liveBundle = null
    onFileChange!()
    ok not existsSync(join(runDir, 'manifest.json')), 'no pool bundle ⇒ manifest held back'
  finally
    managerCfg.appDir = saved.appDir
    managerState.runDir = saved.runDir
    managerState.manifestPath = saved.manifestPath
    managerState.files = saved.files
    managerState.currentPool = saved.currentPool
    managerState.liveBundle = saved.liveBundle
    rmSync appDir, { recursive: true, force: true }
    rmSync runDir, { recursive: true, force: true }


test! "concurrent generated publications serialize without interleaving a parked publish", ->
  # The pin parks run 1 inside its ding publish (a stub Janus that answers
  # /hub/publish slowly) and fires run 2 meanwhile. Serialized, run 2's
  # syncFiles/manifest writes start only after run 1 completes — so the
  # manifest observed DURING run 1's publish still names v1's hash.
  appDir = tmpFixture('tmp-fileq-')
  runDir = tmpFixture('tmp-fileq-run-')
  mkdirSync join(appDir, 'app'), { recursive: true }
  writeFileSync join(appDir, 'app', 'x.rip'), 'export A = 1'
  qSock = join(tmpdir(), "rip-janus-fileq-#{Date.now()}-#{rand(1e6)}.sock")
  qCalls = []
  manifestDuringPublish = []
  manifestPath = join(runDir, 'manifest.json')
  stub = stubJanus qSock, qCalls, (call) ->
    if call.method is 'POST' and call.path.endsWith('/hub/publish')
      return do ->
        await new Promise (resolve) -> setTimeout resolve, 60
        seen = try JSON.parse(readFileSync(manifestPath, 'utf8')) catch then null
        manifestDuringPublish.push seen
        Response.json { objects: 1, deliveries: 0, unknown_targets: 0 }
    null
  saved =
    appDir: managerCfg.appDir
    runDir: managerState.runDir
    manifestPath: managerState.manifestPath
    files: managerState.files
    currentPool: managerState.currentPool
    liveBundle: managerState.liveBundle
    controlUnix: managerState.controlUnix
    appId: managerState.appId
  try
    managerCfg.appDir = appDir
    managerState.runDir = runDir
    managerState.manifestPath = null
    managerState.files = {}
    managerState.currentPool = {}
    managerState.liveBundle = join(runDir, 'bundle.json')
    managerState.controlUnix = qSock
    managerState.appId = 'app-q'
    p1 = onFileChange()
    # Let run 1 reach its parked publish (the stub holds it 60ms) before
    # the second save lands.
    await new Promise (resolve) -> setTimeout resolve, 20
    writeFileSync join(appDir, 'app', 'x.rip'), 'export A = 2'
    p2 = onFileChange()                       # must WAIT for run 1
    await p1
    await p2
    eq manifestDuringPublish.length, 2
    eq manifestDuringPublish[0].files, [{ id: 'app/x.rip', hash: ripHash('export A = 1') }]
    eq manifestDuringPublish[1].files, [{ id: 'app/x.rip', hash: ripHash('export A = 2') }]
    m = JSON.parse readFileSync(manifestPath, 'utf8')
    eq m.files, [{ id: 'app/x.rip', hash: ripHash('export A = 2') }]
  finally
    managerCfg.appDir = saved.appDir
    managerState.runDir = saved.runDir
    managerState.manifestPath = saved.manifestPath
    managerState.files = saved.files
    managerState.currentPool = saved.currentPool
    managerState.liveBundle = saved.liveBundle
    managerState.controlUnix = saved.controlUnix
    managerState.appId = saved.appId
    stub.stop(true)
    rmSync appDir, { recursive: true, force: true }
    rmSync runDir, { recursive: true, force: true }

test! "a bundle rewrite failure holds the manifest back; the next clean save writes both", ->
  appDir = tmpFixture('tmp-filepath-')
  runDir = tmpFixture('tmp-filepath-run-')
  mkdirSync join(appDir, 'app'), { recursive: true }
  writeFileSync join(appDir, 'app', 'x.rip'), 'export A = 1'
  saved =
    appDir: managerCfg.appDir
    runDir: managerState.runDir
    manifestPath: managerState.manifestPath
    files: managerState.files
    currentPool: managerState.currentPool
    liveBundle: managerState.liveBundle
  try
    managerCfg.appDir = appDir
    managerState.runDir = runDir
    managerState.manifestPath = null
    managerState.files = {}
    # A DIRECTORY at the bundle path makes the tmp+rename rewrite fail.
    brokenBundle = join(runDir, 'bundle-as-dir')
    mkdirSync brokenBundle, { recursive: true }
    managerState.currentPool = {}
    managerState.liveBundle = brokenBundle
    onFileChange!()          # publish warns (no app id) and never blocks
    manifestPath = join(runDir, 'manifest.json')
    ok not existsSync(manifestPath), 'the manifest must be held back when the bundle rewrite fails'
    # The next save against a writable bundle path writes bundle THEN manifest.
    goodBundle = join(runDir, 'bundle.json')
    managerState.liveBundle = goodBundle
    writeFileSync join(appDir, 'app', 'x.rip'), 'export A = 2'
    onFileChange!()
    ok existsSync(goodBundle), 'the pool bundle is rewritten'
    m = JSON.parse readFileSync(manifestPath, 'utf8')
    eq m.files, [{ id: 'app/x.rip', hash: ripHash('export A = 2') }]
  finally
    managerCfg.appDir = saved.appDir
    managerState.runDir = saved.runDir
    managerState.manifestPath = saved.manifestPath
    managerState.files = saved.files
    managerState.currentPool = saved.currentPool
    managerState.liveBundle = saved.liveBundle
    rmSync appDir, { recursive: true, force: true }
    rmSync runDir, { recursive: true, force: true }
