test! "a hung handler recycles its worker; the manager republishes a fresh socket", ->
  ctlSock = join(tmpdir(), "rip-janus-hang-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), appSource('hi')
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'hangapp', '-w', '1', '--no-watch'], { RIP_HANDLER_DEADLINE_MS: '200' }
  try
    sock1 = waitFor! ->
      managerSockPuts(calls).find((c) -> c.body.upstreams.length is 1)?.body.upstreams[0].path
    hang = uds(sock1, '/hang')      # never returns; the watchdog must act unprompted
    hang.catch -> null
    # The recycle shows at the control plane as a socket drop (empty PUT)...
    waitFor! -> managerSockPuts(calls).some (c) -> c.body.upstreams.length is 0
    # ...then the respawned worker re-publishes on a fresh socket path
    sock2 = waitFor! ->
      puts = managerSockPuts(calls).filter (c) -> c.body.upstreams.length is 1
      fresh = puts[puts.length - 1]?.body.upstreams[0].path
      if fresh? and fresh isnt sock1 then fresh else null
    res = uds!(sock2, '/hi')
    eq (res.text!), 'hi'
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

# A slow-boot app: module-level top-level await holds /ready 503 for `ms`,
# so rings arriving mid-boot are genuinely held — no bare-sleep guessing.
slowBootSource = (ms) -> """
import { get, start } from '@rip-lang/server'
sleep! #{ms}
get '/hi' -> 'slowboot'
start()
"""

test! "rings past WAITER_CAP answer an immediate 503; held rings still complete", ->
  ctlSock = join(tmpdir(), "rip-janus-cap-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), slowBootSource(1500)
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'capapp', '-w', '1'], { RIP_WAITER_CAP: '2' }
  try
    bell = waitFor! ->
      calls.find((c) -> c.method is 'PUT' and c.body?.upstreams?.some((u) -> u.doorbell))?.body.upstreams[0].path
    r1 = uds(bell, '/ring')         # both hold slots fill while the slow boot runs...
    r2 = uds(bell, '/ring')
    r1.catch -> null
    r2.catch -> null
    sleep! 150
    r3 = uds!(bell, '/ring')        # ...so the cap answers the third at once
    eq r3.status, 503
    eq (r3.text!), 'too many held requests'
    eq r3.headers.get('retry-after'), '1'
    a = await r1
    b = await r2
    eq a.status, 204
    eq b.status, 204
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "a ring outliving RIP_HOLD_MS answers 503 with Retry-After while boot continues", ->
  ctlSock = join(tmpdir(), "rip-janus-hold-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), slowBootSource(2500)
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'holdapp', '-w', '1'], { RIP_HOLD_MS: '250' }
  try
    bell = waitFor! ->
      calls.find((c) -> c.method is 'PUT' and c.body?.upstreams?.some((u) -> u.doorbell))?.body.upstreams[0].path
    res = uds!(bell, '/ring')
    eq res.status, 503
    eq (res.text!), 'boot still in progress'
    eq res.headers.get('retry-after'), '2'
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "a heartbeat 404 re-registers the app and re-publishes the same upstreams", ->
  ctlSock = join(tmpdir(), "rip-janus-hb404-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), appSource('hi')
  calls = []
  tripped = { fired: false }
  stub = stubJanus ctlSock, calls, (call) ->
    # One 404 on the first heartbeat that arrives after socks are published —
    # the control plane "restarted and lost us"
    if call.path.endsWith('/heartbeat') and not tripped.fired and managerSockPuts(calls).some((c) -> c.body.upstreams.length > 0)
      tripped.fired = true
      return new Response(null, { status: 404 })
    null
  proc = spawnManager dir, ctlSock, ['--name', 'hbapp', '-w', '1', '--no-watch']
  try
    sock = waitFor! ->
      managerSockPuts(calls).find((c) -> c.body.upstreams.length is 1)?.body.upstreams[0].path
    waitFor! -> tripped.fired
    registers = -> calls.filter (c) -> c.method is 'POST' and c.path is '/1.0/apps'
    waitFor! -> registers().length >= 2
    waitFor! ->
      puts = managerSockPuts(calls)
      last = puts[puts.length - 1]
      puts.length >= 2 and last.body.upstreams.length is 1 and last.body.upstreams[0].path is sock
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "--eager boots the fresh pool at settle — new socks publish with no ring", ->
  ctlSock = join(tmpdir(), "rip-janus-eager-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), appSource('v1')
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'eagerapp', '-w', '1', '--eager']
  try
    sock1 = waitFor! ->
      managerSockPuts(calls).find((c) -> c.body.upstreams.length is 1)?.body.upstreams[0].path
    writeFileSync join(dir, 'app.rip'), appSource('v2')
    # No ring is ever sent: the settle alone must cut admission AND boot
    sock2 = waitFor! ->
      puts = managerSockPuts(calls).filter (c) -> c.body.upstreams.length is 1
      fresh = puts[puts.length - 1]?.body.upstreams[0].path
      if fresh? and fresh isnt sock1 then fresh else null
    res = uds!(sock2, '/hi')
    eq (res.text!), 'v2'
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "canonical manager control reports status and fences hold/release", ->
  ctlSock = join(tmpdir(), "rip-janus-control-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-control-')
  child = join(dir, 'nested')
  mkdirSync child, { recursive: true }
  writeFileSync join(dir, 'app.rip'), appSource('held-v1')
  writeClientDir dir
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'controlled', '-w', '1']
  try
    sock1 = waitFor! ->
      managerSockPuts(calls).find((c) -> c.body.upstreams.length is 1)?.body.upstreams[0].path

    second = managerCommand! child, []
    eq second.code, 0
    ok second.out.includes('Running / Active / workers'), "bare second launch reports status: #{second.out}"
    explicit = managerCommand! child, ['status']
    eq explicit.code, 0
    ok explicit.out.includes('controlled'), "status names the App: #{explicit.out}"
    rejected = managerCommand! child, ['--workers', '3']
    ok rejected.code isnt 0
    ok rejected.err.includes('startup options cannot be applied'), rejected.err

    held = managerCommand! child, ['hold']
    eq held.code, 0
    ok held.out.includes('/ Held / workers'), held.out
    putsAt = calls.filter((c) -> c.method is 'PUT').length
    pubsAt = calls.filter((c) -> c.path.endsWith('/hub/publish')).length
    writeFileSync join(dir, 'app.rip'), appSource('held-v2')
    writeFileSync join(dir, 'app', 'routes', 'index.rip'), CLIENT_ROUTE.replace('"home"', '"released"')
    sleep! 400
    eq calls.filter((c) -> c.method is 'PUT').length, putsAt
    eq calls.filter((c) -> c.path.endsWith('/hub/publish')).length, pubsAt
    eq (uds!(sock1, '/hi').text!), 'held-v1'

    released = managerCommand! child, ['release']
    ok released.code is 0, released.err
    ok released.out.includes('/ Active / workers'), released.out
    sock2 = waitFor! ->
      fresh = managerSockPuts(calls).filter((c) -> c.body.upstreams.length is 1)
      last = fresh[fresh.length - 1]?.body.upstreams[0].path
      if last? and last isnt sock1 then last else null
    eq (uds!(sock2, '/hi').text!), 'held-v2'
    epochs = calls.filter (c) -> c.path.endsWith('/hub/publish') and c.body?.some?((d) -> d.ding?.kind is 'epoch')
    eq epochs.length, 1
  finally
    try proc.kill('SIGTERM')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "an unresolved durable operation restarts in Maintenance with empty admission", ->
  ctlSock = join(tmpdir(), "rip-janus-maint-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-maint-')
  writeFileSync join(dir, 'app.rip'), appSource('must-not-boot')
  mkdirSync join(dir, '.rip'), { recursive: true }
  operationId = '0123456789abcdef0123456789abcdef'
  writeFileSync join(dir, '.rip', 'server-operation.json'), JSON.stringify({
    version: 1
    id: operationId
    phase: 'migration-running'
    outcome: 'unknown'
    targetArtifact: join(dir, '.rip', 'generations', "#{operationId}.js")
  })
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'maintenance', '-w', '1', '--no-watch']
  try
    reg = waitFor! -> calls.find (c) -> c.method is 'POST' and c.path is '/1.0/apps'
    eq reg.body.upstreams, []
    sleep! 100
    eq managerSockPuts(calls), []
    status = managerCommand! dir, ['status']
    eq status.code, 0
    ok status.out.includes('Maintenance / empty'), status.out
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

