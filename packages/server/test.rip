  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "browse shutdown wins a heartbeat-404 race without re-registering", ->
  ctlSock = join(tmpdir(), "rip-janus-browse-race-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-browse-race-')
  calls = []
  heartbeat: any = {}
  heartbeat.promise = new Promise (resolve) -> heartbeat.open = resolve
  heartbeatStarted = false
  stub = stubJanus ctlSock, calls, (call) ->
    if call.method is 'POST' and call.path is '/1.0/apps'
      return Response.json({ id: 'browse-aaaaaa' }, { status: 201 })
    if call.method is 'POST' and call.path.endsWith('/heartbeat')
      heartbeatStarted = true
      return heartbeat.promise
    null
  proc = spawnBrowse dir, ctlSock, ['--host', 'race.example', '--access-log=off']
  try
    waitFor! -> heartbeatStarted
    proc.kill 'SIGTERM'
    heartbeat.open new Response(null, { status: 404 })
    code = await proc.exited
    eq code, 143
    eq calls.filter((call) -> call.method is 'POST' and call.path is '/1.0/apps').length, 1
    ok calls.some((call) -> call.method is 'DELETE' and call.path is '/1.0/apps/browse-aaaaaa'), 'the original registration is deleted'
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "browse shutdown deletes a replacement already in flight", ->
  ctlSock = join(tmpdir(), "rip-janus-browse-replace-race-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-browse-replace-race-')
  calls = []
  replacement: any = {}
  replacement.promise = new Promise (resolve) -> replacement.open = resolve
  posts = 0
  replacementStarted = false
  stub = stubJanus ctlSock, calls, (call) ->
    if call.method is 'POST' and call.path is '/1.0/apps'
      posts += 1
      return Response.json({ id: 'browse-aaaaaa' }, { status: 201 }) if posts is 1
      replacementStarted = true
      return replacement.promise
    if call.method is 'POST' and call.path.endsWith('/heartbeat')
      return new Response(null, { status: 404 })
    null
  proc = spawnBrowse dir, ctlSock, ['--host', 'replace-race.example', '--access-log=off']
  try
