test! "watch in production requires --allow-watch, loudly", ->
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), appSource('hi')
  proc = spawnManager dir, '/nonexistent.sock', ['--name', 'prodwatch', '--watch'], { RIP_ENV: 'production' }, 'pipe'
  try
    errText = new Response(proc.stderr).text!
    code = await proc.exited
    ok code isnt 0, 'refusal exits nonzero'
    ok errText.includes('watch in production requires --allow-watch'), "names the gate: #{errText}"
  finally
    rmSync dir, { recursive: true, force: true }

test! "manager -c 2 --no-watch plumbs the cap to workers: two in flight over one sock", ->
  cSock = join(tmpdir(), "rip-janus-c-#{Date.now()}-#{rand(1e6)}.sock")
  cDir = tmpFixture('tmp-manager-')
  writeFileSync join(cDir, 'app.rip'), appSource('hi')
  calls = []
  stub = Bun.serve
    unix: cSock
    fetch: (rq) ->
      url = new URL(rq.url)
      return new Response('janus', { status: 404 }) if rq.method is 'GET'
      body = null
      if rq.method is 'POST' or rq.method is 'PUT'
        body = try rq.json! catch then null
      calls.push { method: rq.method, path: url.pathname, body }
      if rq.method is 'POST' and url.pathname is '/1.0/apps'
        return Response.json { id: 'app-c' }, { status: 201 }
      if rq.method is 'PUT' and url.pathname.endsWith('/upstreams')
        return Response.json { ok: true }
      if rq.method is 'POST' and url.pathname.endsWith('/heartbeat')
        return new Response(null, { status: 204 })
      if rq.method is 'DELETE'
        return new Response(null, { status: 204 })
      new Response('nope', { status: 404 })
  proc = Bun.spawn [process.execPath, PRELOAD, SERVER_BIN, '--control', cSock, '--name', 'capp', '-w', '1', '-c', '2', '--no-watch'],
    cwd: cDir
    stdin: 'ignore'
    stdout: 'ignore'
    stderr: 'inherit'
    env: { ...process.env, ...TEST_KNOBS }
  try
    sock = waitFor! ->
      sockPut = calls.find (c) -> c.method is 'PUT' and c.body?.upstreams?.length and not c.body.upstreams.some (u) -> u.doorbell
      sockPut?.body.upstreams[0].path
    a = uds(sock, '/slow')          # the single worker holds both...
    b = uds(sock, '/slow')
    sleep! 80
    third = uds!(sock, '/hi')       # ...and the third bounces, marked
    eq third.status, 503
    eq third.headers.get('rip-worker-busy'), '1'
    ra = await a
    rb = await b
    eq (ra.text!), 'done'
    eq (rb.text!), 'done'
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync cDir, { recursive: true, force: true }

# ==[ Manager: edge publication — workers stay API-only ]==

console.log "\nManager edge publication"

test! "an App-only project registers files with no API admission or worker runtime", ->
  ctlSock = join(tmpdir(), "rip-janus-apponly-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-apponly-')
  writeClientDir dir
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'apponly']
  try
    reg = waitFor! -> calls.find (c) -> c.method is 'POST' and c.path is '/1.0/apps'
    eq reg.body.upstreams, []
    eq reg.body.files.proxy_first, []
    ok existsSync(join(realpathSync(dir), 'static', 'generated', 'bundle.json'))
    sleep! 80
    eq managerSockPuts(calls), []
    status = managerCommand! dir, ['status']
    eq status.code, 0
    ok status.out.includes('none'), "App-only status names admission none: #{status.out}"
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "an app/ dir publishes stable edge files while workers remain API-only", ->
  ctlSock = join(tmpdir(), "rip-janus-client-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), """
  import { get, start } from '@rip-lang/server'
  get '/hi' -> 'hi'
  start()
  """
  writeClientDir dir
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'clientapp', '-w', '1']
  try
    sock1 = waitFor! ->
      managerSockPuts(calls).find((c) -> c.body.upstreams.length is 1)?.body.upstreams[0].path
    eq (uds!(sock1, '/')).status, 404
    eq ((uds!(sock1, '/hi')).text!), 'hi'
    generated = join(realpathSync(dir), 'static', 'generated')
    bundlePath = join(generated, 'bundle.json')
    bundleText1 = readFileSync(bundlePath, 'utf8')
    bundle = JSON.parse(bundleText1)
    ok bundle.modules['app/routes/index.rip']?, 'the manager-assembled bundle ships the client module'
    pageText = readFileSync(join(generated, 'index.html'), 'utf8')
    ok pageText.includes('<title>clientapp</title>')
    registration = calls.find (c) -> c.method is 'POST' and c.path is '/1.0/apps'
    eq registration.body.files.roots[0], { path: generated, cache: 'revalidate', browse: false }
    eq registration.body.files.shell, join(generated, 'index.html')
    bell = calls.find((c) -> c.method is 'PUT' and c.body?.upstreams?.some((u) -> u.doorbell)).body.upstreams[0].path
    writeFileSync join(dir, 'app.rip'), """
    import { get, start } from '@rip-lang/server'
    get '/hi' -> 'hi v2'
    start()
    """
    writeFileSync join(dir, 'app', 'routes', 'index.rip'), CLIENT_ROUTE.replace('"home"', '"home v2"')
    waitFor! -> calls.filter((c) -> c.method is 'PUT' and c.body?.upstreams?.some((u) -> u.doorbell)).length >= 2
    res = uds!(bell, '/ring')
    eq res.status, 204
    sock2 = waitFor! ->
      puts = managerSockPuts(calls).filter (c) -> c.body.upstreams.length is 1
      fresh = puts[puts.length - 1]?.body.upstreams[0].path
      if fresh? and fresh isnt sock1 then fresh else null
    eq ((uds!(sock2, '/hi')).text!), 'hi v2'
    bundleText2 = readFileSync(bundlePath, 'utf8')
    ok bundleText2 isnt bundleText1, 'the stable bundle path carries the new bytes'
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

# ==[ Manager: the workspace dev feed through a live pool ]==

console.log "\nManager workspace dev feed"

wsAppSource = (msg) -> """
import { get, start } from '@rip-lang/server'
get '/hi' -> '#{msg}'
start()
"""

test! "a client-only edit updates stable edge files and dings without API reload", ->
  ctlSock = join(tmpdir(), "rip-janus-ws-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-')
  writeFileSync join(dir, 'app.rip'), wsAppSource('hi')
  writeClientDir dir
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'wsapp', '-w', '1']
  puts = -> calls.filter (c) -> c.method is 'PUT'
  try
    sock = waitFor! ->
      managerSockPuts(calls).find((c) -> c.body.upstreams.length is 1)?.body.upstreams[0].path
    eq (uds!(sock, '/manifest.json')).status, 404
    generated = join(dir, 'static', 'generated')
    manifestPath = join(generated, 'manifest.json')
    bundlePath = join(generated, 'bundle.json')
    eq JSON.parse(readFileSync(manifestPath, 'utf8')), { files: [
      { id: 'app/routes/index.rip', hash: ripHash(CLIENT_ROUTE) }
      { id: 'app/stash.rip',        hash: ripHash(CLIENT_STASH) }
    ] }
    bundle1 = readFileSync(bundlePath, 'utf8')
    putsAt = puts().length
    v2 = CLIENT_ROUTE.replace('"home"', '"home v2"')
    writeFileSync join(dir, 'app', 'routes', 'index.rip'), v2
    pub = waitForNamed! 'update ding', -> calls.find (c) -> c.method is 'POST' and c.path.endsWith('/hub/publish')
    eq pub.path, '/1.0/apps/app-x/hub/publish'
    eq pub.body, [{ '@': ['/hub'], ding: { id: 'app/routes/index.rip', hash: ripHash(v2) } }]
    m2 = JSON.parse readFileSync(manifestPath, 'utf8')
    eq m2.files.find((e) -> e.id is 'app/routes/index.rip').hash, ripHash(v2)
    eq readFileSync(join(dir, 'app', 'routes', 'index.rip'), 'utf8'), v2
    eq (uds!(sock, '/hub', { method: 'POST' })).status, 404
    eq puts().length, putsAt
    bundle2 = readFileSync(bundlePath, 'utf8')
    ok bundle2 isnt bundle1, 'the stable bundle path carries the latest App'
    unlinkSync join(dir, 'app', 'stash.rip')
    pubs = -> calls.filter (c) -> c.method is 'POST' and c.path.endsWith('/hub/publish')
    retirement = waitForNamed! 'delete ding', -> pubs()[1]
    eq retirement.body, [{ '@': ['/hub'], ding: { id: 'app/stash.rip', hash: ripHash(CLIENT_STASH), kind: 'delete' } }]
    m3 = JSON.parse readFileSync(manifestPath, 'utf8')
    eq m3.files.map((e) -> e.id), ['app/routes/index.rip']
    ok not existsSync(join(dir, 'app', 'stash.rip'))
    eq puts().length, putsAt
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

test! "a CSS-only edit publishes a hash ding, no bundle key, and no API reload", ->
  ctlSock = join(tmpdir(), "rip-janus-css-#{Date.now()}-#{rand(1e6)}.sock")
  dir = tmpFixture('tmp-manager-css-')
  writeFileSync join(dir, 'app.rip'), wsAppSource('hi')
  writeClientDir dir
  css1 = ":root { --rip-s12: 1; }\n"
  writeFileSync join(dir, 'app', 'styles.css'), css1
  calls = []
  stub = stubJanus ctlSock, calls
  proc = spawnManager dir, ctlSock, ['--name', 'cssapp', '-w', '1']
  puts = -> calls.filter (c) -> c.method is 'PUT'
  try
    sock = waitFor! ->
      managerSockPuts(calls).find((c) -> c.body.upstreams.length is 1)?.body.upstreams[0].path
    generated = join(dir, 'static', 'generated')
    manifestPath = join(generated, 'manifest.json')
    bundlePath = join(generated, 'bundle.json')
    m1 = JSON.parse readFileSync(manifestPath, 'utf8')
    eq m1.files.find((e) -> e.id is 'app/styles.css')?.hash, ripHash(css1)
    eq m1.files.find((e) -> e.id is 'app/routes/index.rip')?.hash, ripHash(CLIENT_ROUTE)
    bundle1 = JSON.parse readFileSync(bundlePath, 'utf8')
    eq bundle1.modules['app/styles.css'], undefined, 'CSS never enters the compile bundle'
    ok bundle1.modules['app/routes/index.rip']?, 'Rip modules still ship'
    eq readFileSync(join(dir, 'app', 'styles.css'), 'utf8'), css1
    putsAt = puts().length
    css2 = ":root { --rip-s12: 2; }\n"
    writeFileSync join(dir, 'app', 'styles.css'), css2
    pub = waitFor! -> calls.find (c) -> c.method is 'POST' and c.path.endsWith('/hub/publish')
    eq pub.body, [{ '@': ['/hub'], ding: { id: 'app/styles.css', hash: ripHash(css2) } }]
    eq pub.body[0].ding.kind, undefined, 'no kind:style — extension branches the apply'
    m2 = JSON.parse readFileSync(manifestPath, 'utf8')
    eq m2.files.find((e) -> e.id is 'app/styles.css').hash, ripHash(css2)
    eq readFileSync(join(dir, 'app', 'styles.css'), 'utf8'), css2
    eq puts().length, putsAt, 'CSS-only save must not cut admission'
    bundle2 = JSON.parse readFileSync(bundlePath, 'utf8')
    eq bundle2.modules['app/styles.css'], undefined
  finally
    try proc.kill('SIGKILL')
    await proc.exited
    stub.stop(true)
    rmSync dir, { recursive: true, force: true }

