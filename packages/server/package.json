{
  "name": "@rip-lang/server",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Sinatra-style API framework — routes, smart responses, read() validation, and AsyncLocalStorage-powered request context for managed workers behind Janus",
  "exports": {
    ".": "./server.rip",
    "./middleware": "./middleware.rip"
  },
  "bin": {
    "rip-server": "./server.rip",
    "rip-app": "./app.rip",
    "rip-edge": "./edge.rip"
  },
  "scripts": {
    "test": "rip test/test.rip",
    "test:framework": "rip test/framework/test.rip",
    "test:hello-api": "rip test/hello-api/test.rip",
    "test:hello-app": "rip test/hello-app/test.rip",
    "test:appliance": "rip test/appliance/test.rip",
    "test:janus": "rip test/janus/test.rip",
    "test:manager-boundary": "rip test/manager-boundary/test.rip",
    "test:middleware": "rip test/middleware/test.rip",
    "test:monitor": "rip test/monitor/test.rip",
    "test:operations": "rip test/operations/test.rip",
    "test:reloads": "rip test/reloads/test.rip",
    "test:workers": "rip test/workers/test.rip"
  },
  "files": [
    "server.rip",
    "middleware.rip",
    "worker.rip",
    "generate.rip",
    "manager.rip",
    "control.rip",
    "appliance.rip",
    "agent.rip",
    "launchd-listener.js",
    "app.rip",
    "edge.rip",
    "Caddyfile",
    "ripdev.io.crt",
    "ripdev.io.key",
    "monitor.rip",
    "README.md"
  ],
  "dependencies": {
    "@rip-lang/app": "workspace:*",
    "@rip-lang/validate": "workspace:*"
  },
  "devDependencies": {
    "@rip-lang/testing": "workspace:*"
  }
}
