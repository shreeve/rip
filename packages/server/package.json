{
  "name": "@rip-lang/server",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Sinatra-style API framework — routes, smart responses, read() validation, and AsyncLocalStorage-powered request context for managed workers behind Janus",
  "exports": {
    ".": "./server.rip",
    "./middleware": "./middleware.rip",
    "./monitor": "./monitor.rip"
  },
  "bin": {
    "rip-server": "./server.rip"
  },
  "scripts": {
    "test": "rip test.rip",
    "verify:hello-api": "rip verify/hello-api/test.rip",
    "verify:hello-app": "rip verify/hello-app/test.rip",
    "verify:janus": "rip verify/janus/test.rip",
    "verify:middleware": "rip verify/middleware/test.rip",
    "verify:monitor": "rip verify/monitor/test.rip",
    "verify:operations": "rip verify/operations/test.rip",
    "verify:reloads": "rip verify/reloads/test.rip",
    "verify:workers": "rip verify/workers/test.rip"
  },
  "files": [
    "server.rip",
    "middleware.rip",
    "worker.rip",
    "generate.rip",
    "manager.rip",
    "monitor.rip",
    "README.md"
  ],
  "dependencies": {
    "@rip-lang/app": "workspace:*",
    "@rip-lang/validate": "workspace:*"
  },
  "devDependencies": {
    "@rip-lang/testing": "workspace:*"
  }
}
