# ==============================================================================
# @rip-lang/server — manager runtime (the `rip server` process)
#
# Implements the Rip Server half of the Janus pool coordination protocol
# (janus: docs/20260719-002000-pool-protocol.md): register the app on /1.0,
# heartbeat every 5s starting immediately, own the doorbell socket, spawn
# worker pools on unique unix socket paths, and drive the dirty epoch —
# saves settle, hash-gate, cut admission with a doorbell PUT, and boot on
# demand when a ring arrives. The manager is the single writer of its
# app's upstream list: every control call is awaited in order, and a
# sockets PUT is acknowledged (200) before any held ring is answered 204.
#
# Never on the data path: client traffic flows Janus → worker socket.
# ==============================================================================

import { watch, readdirSync, readFileSync, writeFileSync, openSync, closeSync, fsyncSync, existsSync, statSync, realpathSync, chmodSync, unlinkSync, mkdtempSync, mkdirSync, renameSync, rmSync } from 'node:fs'
import { join, resolve, dirname, basename } from 'node:path'
import { tmpdir } from 'node:os'
import { randomBytes } from 'node:crypto'
import { rash } from '@rip-lang/app/rash'
import { AccessClient, parseAccessPicture, pumpAccessOutput, writeAccessOutput } from './monitor.rip'

# The compiler compiling THIS process is the one that builds artifacts —
# resolved from the loader's --preload path, loaded once, on first build.
_srcDir = null
loaderSrcDir = ->
  return _srcDir if _srcDir?
  preload = process.execArgv.find((a) -> a.startsWith('--preload='))?.slice('--preload='.length)
  abort "rip-server: the rip loader is missing from execArgv — run via `rip server`" unless preload?
  _srcDir = dirname(resolve(preload))

# Bundle assembly requires the compiler, so it runs here in the manager —
# never in a prebuilt worker.
_assemble = null
loadAssembler = ->
  return _assemble if _assemble?
  mod = import!(join(loaderSrcDir(), 'bundle.js'))
  _assemble = mod.assembleBundle

# --- Tunables — env-overridable, defaults per the pool protocol ----------------

envNum = (name, fallback) ->
  n = parseInt(process.env[name] or '')
  if Number.isFinite(n) and n > 0 then n else fallback

SETTLE_MS        =! envNum 'RIP_SETTLE_MS', 150         # trailing settle after fs events
WATCH_POLL_MS    =! envNum 'RIP_WATCH_POLL_MS', 1000    # reconcile events a host watcher misses
DRAIN_MS         =! envNum 'RIP_DRAIN_MS', 2500         # flat grace before SIGTERM on retire
KILL_MS          =! envNum 'RIP_KILL_MS', 5000          # SIGTERM → SIGKILL escalation
HEARTBEAT_MS     =! envNum 'RIP_HEARTBEAT_MS', 5000     # heartbeat cadence
HOLD_MS          =! envNum 'RIP_HOLD_MS', 15000         # ring hold cap, then 503
BOOT_DEADLINE_MS =! envNum 'RIP_BOOT_DEADLINE_MS', 30000  # per-worker /ready deadline
WAITER_CAP       =! envNum 'RIP_WAITER_CAP', 64         # held rings per app, then 503

# The 409 retry window must outlive a genuinely stale claim: the control
# plane holds a dead predecessor's claim for its heartbeat TTL (janus
# defaultHeartbeatTTL, 15s), its reap sweep ticks at TTL/3 (the host frees
# up to 5s after expiry), and registerApp's backoff spaces retries up to
# 5s apart — so the first retry that can succeed lands by 25s. 30s clears
# that worst case with margin.
export REGISTER_409_MS =! envNum 'RIP_REGISTER_409_MS', 30000

# The worker's in-flight drain wait after SIGTERM must finish under THIS
# manager's SIGTERM → SIGKILL ceiling (KILL_MS — see retirePool), with margin
# for exit housekeeping. Passed to every worker via RIP_DRAIN_DEADLINE_MS.
WORKER_DRAIN_MS  =! Math.max(KILL_MS - 500, Math.floor(KILL_MS / 2))

IGNORED_DIRS =! new Set ['node_modules', '.git', 'dist', 'coverage', 'tmp', '.rip-cache', '.cache']

USAGE =! """
rip server — run an API and/or browser App behind a Janus control plane

Usage:
  rip server [project] [options]       discovers app.rip, index.rip, or app/ here or above
  rip server browse <directory>        publish exactly one browsable directory
                    [--host <host>] [--control <target>] [--until-restart]
  rip server status [app-entry]        report the canonical project's manager
  rip server hold [app-entry]          fence activation, publication, and dings
  rip server release [app-entry]       activate one coherent API/App snapshot
  rip server migrate [models] [--dir migrations] [--id 32-hex]
                                       migrate only from Held, then activate coherently
  rip server recover <operation-id>    fix-forward an unresolved Maintenance operation

Options:
  --name <n>          App name for registration (default: the app directory's name)
  --host <h>          Public host to claim; repeatable (default: the app name)
  -w, --workers <n>   Worker processes (default: 2)
  -c, --concurrency <n>  Concurrent requests per worker (default: 1; c > 1 requires watch off)
  --watch             Watch app files and hot-reload (default ON unless RIP_ENV=production)
  --no-watch          Disable the watcher
  --allow-watch       Required to enable --watch when RIP_ENV=production
  --eager             Boot the fresh pool at settle instead of waiting for a ring
  --control <target>  Janus control endpoint: a unix socket path or an http(s) URL
                      (or env JANUS_CONTROL); required, verified at startup
  --until-restart     Give a browse registration a process lease, then exit
  --access-log=<mode> Access output: pretty, raw, or off (default: pretty)
  --access-format <picture>
                      Pretty access-log picture (pretty mode only)
                      Exact width: {field:[<|>|^]width[^][@unit]}
                      Full grammar and Unicode rules: @rip-lang/server README

Env knobs: RIP_SETTLE_MS, RIP_DRAIN_MS, RIP_KILL_MS, RIP_HEARTBEAT_MS,
RIP_HOLD_MS, RIP_BOOT_DEADLINE_MS, RIP_WAITER_CAP, RIP_REGISTER_409_MS,
RIP_HANDLER_DEADLINE_MS
"""

# --- Module state ---------------------------------------------------------------

# Exported for the same reason state is (below): the manager is a process
# singleton, and in-process tests configure it directly.
export cfg: any =
  entry: null          # absolute path to the app entry
  appDir: null         # directory the watcher covers
  name: null
  hosts: []
  site: null           # normalized Janus tenant-site registration
  files: null          # normalized Janus static-file registration
  workers: 2
  concurrency: 1
  watch: false
  eager: false
  control: null
  accessMode: 'pretty'
  accessPicture: null

# Exported: the manager is a process singleton, and its module state IS the
# process state — in-process tests (the publish client) configure it directly.
export state =
  lifecycle: 'Starting'
  operation: 'Active'
  operationOwner: 0
  projectRoot: null
  managerPath: null
  managerMetaPath: null
  managerNonce: null
  managerServer: null
  operationPath: null
  migrationPromise: null
  migration: null
  migrationResults: {}
  appId: null
  controlUnix: null    # unix socket path to the control plane, or
  controlBase: null    # http(s) base URL
  workerJs: null       # the worker runtime, prebuilt to plain JS at startup
  browserRuntime: null # dist/browser/rip.js, copied into generated edge root
  buildCounter: 0      # one app artifact per boot epoch, uniquely named
  runDir: null         # tmpdir holding the doorbell, worker sockets, artifacts
  generatedDir: null   # stable manager-owned coordination root
  manifestPath: null   # the atomically rewritten file manifest
  files: {}            # id (birth store path, 'app/…') → { id, hash, retired }
  bellPath: null
  bell: null
  watcher: null
  watchPoll: null
  settleTimer: null
  hbTimer: null
  lastHash: null       # content hash of the watched *.rip files
  lastFiles: null      # per-file content hashes from the same walk (change classification)
  apiInputs: []        # exact API dependency inventory from the accepted generation
  sourceEpoch: 0       # every non-ignored watcher event invalidates older async work
  prepareCounter: 0
  preparation: null    # { taskId, sourceEpoch, proc, promise }
  prepared: null       # latest compile-only candidate accepted for this source epoch
  prepareError: null   # failed candidate while the previous pool remains live
  needsPreparation: false
  liveBundle: null     # manager-owned App bundle reused across API generations
  lastUpstreams: []    # last remotely acknowledged statement (diagnostic only)
  desiredVersion: 0
  acknowledgedVersion: 0
  cutToken: 0
  dirty: false         # admission is cut or booting; not merely preparing
  doorbellPublished: false
  bootFailure: null    # cached boot error; cleared only by a content-changing save
  bootPromise: null    # the single in-flight boot, joined by concurrent rings
  bootingPool: null
  currentPool: null
  managedChildren: new Set
  poolCounter: 0
  ringWaiters: 0
  readyWhen: 1
  shuttingDown: false
  restartWarned: false
  accessClient: null
  outputFailure: null
  signalStatus: null
  # Test seam: invoked after the one app/ snapshot is taken and before any
  # durable document is written from it. Pins mutate the disk here to prove
  # a second walk cannot affect the producing run.
  afterAppSnapshot: null

# ==============================================================================
# Control-plane client — single writer, every call awaited in order
# ==============================================================================

_chain = Promise.resolve()

# Serialize control-plane work: no later control message is sent until the
# previous one (including its retries) resolves.
enqueue = (fn) ->
  run = _chain.then -> fn()
  _chain = run.catch -> null
  run

cfetch = (method, path, body = null) ->
  opts = { method }
  if body?
    opts.body = JSON.stringify(body)
    opts.headers = { 'content-type': 'application/json' }
  if state.controlUnix?
    fetch "http://janus#{path}", { ...opts, unix: state.controlUnix }
  else
    fetch "#{state.controlBase}#{path}", opts

accessControl = ->
  if state.controlUnix? then { unix: state.controlUnix } else { base: state.controlBase }

trackChild = (proc) ->
  state.managedChildren.add proc
  proc.exited.finally(-> state.managedChildren.delete(proc)).catch(-> null)
  proc

moveAccess = ->
  return unless state.accessClient? and state.appId?
  state.accessClient.control = accessControl()
  state.accessClient.move(state.appId).catch (e) ->
    return if state.shuttingDown
    state.outputFailure = e
    warn "rip-server: terminal access output failure: #{e?.message or e}"
    shutdown! 'access output failure', 1

registerApp = ->
  backoff = 200
  deadline409 = null
  reg: any = { name: cfg.name }
  if cfg.site?
    reg.site = cfg.site
    reg.files = cfg.files
  else
    reg.hosts = cfg.hosts
    reg.files = cfg.files if cfg.files?
  reg.upstreams = desiredUpstreams()
  loop
    res = null
    try
      res = cfetch! 'POST', '/1.0/apps', reg
    if res?
      if res.status is 201            # per the pool protocol: created, only
        body = res.json!
        abort "rip-server: control returned no app id" unless body?.id?
        state.appId = body.id
        state.lastUpstreams = reg.upstreams
        state.acknowledgedVersion = state.desiredVersion
        moveAccess()
        return
      if res.status is 409
        # A restart under a supervisor lands inside the heartbeat TTL while
        # the dead manager's claim is still live — retry for REGISTER_409_MS
        # (sized to the claim's worst-case lifetime, see the knob) before
        # treating the claim as genuinely foreign.
        deadline409 ?= Date.now() + REGISTER_409_MS
        if Date.now() >= deadline409
          claim = if cfg.site? then cfg.site.host else cfg.hosts.join(', ')
          abort "rip-server: host already claimed at the control plane (409): #{claim}"
        warn "rip-server: host claim still held (409); retrying until the stale claim expires"
      else
        warn "rip-server: register failed (#{res.status}); retrying"
    else
      warn "rip-server: control unreachable during register; retrying"
    sleep! backoff
    backoff = Math.min(backoff * 2, 5000)

# The desired statement is derived from current state. `lastUpstreams` is only
# an acknowledgement/reporting fact; it is never recovery authority.
export desiredUpstreams = ->
  return [] if state.shuttingDown
  return [{ path: state.bellPath, doorbell: true }] if state.doorbellPublished
  return readySocks(state.currentPool) if state.currentPool?
  []

bumpDesired = ->
  state.desiredVersion += 1
  state.desiredVersion

# Runs inside the writer chain. Retries with backoff; a 404 means the control
# plane restarted and lost us — re-register, then publish CURRENT state.
putUpstreams = (list, version = null) ->
  backoff = 200
  attempts = 0
  loop
    return false if version? and version isnt state.desiredVersion
    attempts += 1
    res = null
    try
      res = cfetch! 'PUT', "/1.0/apps/#{state.appId}/upstreams", { upstreams: list }
    return false if version? and version isnt state.desiredVersion
    if res?
      if res.status is 200
        state.lastUpstreams = list
        state.acknowledgedVersion = version if version?
        return true
      if res.status is 404
        warn "rip-server: control lost the app; re-registering"
        registerApp!()
        version = state.desiredVersion
        list = desiredUpstreams()
        continue
      warn "rip-server: upstreams PUT failed (#{res.status}); retrying"
    return if state.shuttingDown and attempts >= 3
    sleep! backoff
    backoff = Math.min(backoff * 2, 5000)

putDesired = (version = state.desiredVersion) ->
  return false if version isnt state.desiredVersion
  putUpstreams! desiredUpstreams(), version

queueDesired = ->
  version = state.desiredVersion
  enqueue -> putDesired! version

# Runs enqueued in the writer chain, one closure per tick. A failed beat has
# no local retry loop — the next tick's enqueued heartbeat IS the retry, and
# during a control outage those closures queue behind putUpstreams' backoff,
# so the effective retry cadence follows that backoff, not the flat interval.
heartbeatOnce = ->
  return unless state.appId?
  res = null
  try
    res = cfetch! 'POST', "/1.0/apps/#{state.appId}/heartbeat"
  unless res?
    warn "rip-server: heartbeat unreachable; the next tick retries"
    return
  if res.status is 404
    warn "rip-server: heartbeat 404 — re-registering and re-publishing upstreams"
    registerApp!()
    putDesired! state.desiredVersion

deleteApp = ->
  try cfetch! 'DELETE', "/1.0/apps/#{state.appId}"

# POST a directive object/list to the app's hub publish plane. Hot-plane by
# contract (janus: publish touches hub state only — never upstreams, never
# the doorbell), so it never rides the writer chain: a broadcast must not
# queue behind an upstreams retry. Returns the parsed delivery envelope
# ({objects, deliveries, unknown_targets}); a non-2xx answer throws carrying
# status and body, never a silent swallow.
export publish = (directives) ->
  throw new Error("rip-server: publish before registration — no app id") unless state.appId?
  res = cfetch! 'POST', "/1.0/apps/#{state.appId}/hub/publish", directives
  unless res.ok
    detail = res.text!
    throw new Error("rip-server: publish failed (#{res.status}): #{detail}")
  res.json!

# Default client bag under <appDir>/app: app/**/*.{rip,css,html}, keyed by
# disk path ('app/routes/index.rip', 'app/styles.css', 'app/index.html' —
# the disk path IS the store id). Doctrine: the bag is membership; the hub
# only dings {id,hash}; the client chooses the reaction. The compile bundle
# takes .rip only (see ripWalk); CSS soft-applies (S12); HTML reloads.
# Project-root app.rip / index.rip is the main server entry — outside this
# walk — and takes the epoch path when it changes. No app/ dir means no
# bundle (null). An assembly failure throws — it rides the same
# boot-failure caching as a compile failure, so rings answer 503 with the
# diagnostic.
isBagFile = (name) ->
  name.endsWith('.rip') or name.endsWith('.css') or name.endsWith('.html')

clientModules = (dir) ->
  modules = {}
  moduleFiles = {}
  moduleBytes = {}
  walk = (at, prefix) ->
    for e in readdirSync(at, { withFileTypes: true })
      continue if e.name.startsWith('.')
      full = join(at, e.name)
      if e.isDirectory()
        walk full, "#{prefix}#{e.name}/"
      else if isBagFile(e.name)
        key = "#{prefix}#{e.name}"
        bytes = readFileSync(full)
        modules[key] = bytes.toString('utf8')
        moduleBytes[key] = bytes
        moduleFiles[key] = full
  walk dir, 'app/'
  { modules, moduleFiles, moduleBytes, appDir: dirname(dir) }

# One app/ walk feeds every document in a producing run. A second walk can
# observe a save mid-run and write a manifest naming hashes the bundle does
# not carry.
readAppModules = ->
  appRoot = join(cfg.appDir, 'app')
  return null unless existsSync(appRoot)
  clientModules(appRoot)

# assembleBundle compiles every module — CSS/HTML must never enter it.
ripWalk = (walk) ->
  return null unless walk?
  modules = {}
  moduleFiles = {}
  for path, source of walk.modules
    continue unless path.endsWith('.rip')
    modules[path] = source
    moduleFiles[path] = walk.moduleFiles[path] if walk.moduleFiles?[path]?
  { modules, moduleFiles, appDir: walk.appDir }

assembleBundleText = (walk) ->
  rip = ripWalk(walk)
  assemble = loadAssembler!()
  JSON.stringify assemble {
    modules: rip.modules
    moduleFiles: rip.moduleFiles
    appDir: rip.appDir
    packagesDir: join(loaderSrcDir(), '..', 'packages')
  }

# Generated commits stage changes against a cloned registry so a failed
# release or migration can restore the previously published snapshot.
snapshotFiles = ->
  out = {}
  for path, entry of state.files
    out[path] = { id: entry.id, hash: entry.hash, retired: entry.retired }
  out

# App publication is manager-owned and independent from API generation. The
# resulting bundle path is stable across API pool swaps and is rewritten in
# place by generated publication.
buildClientPublication = ->
  modules = readAppModules!()
  return null unless modules?
  bundle = join(state.generatedDir, 'bundle.json')
  text = assembleBundleText!(modules)
  current = if existsSync(bundle) then readFileSync(bundle, 'utf8') else null
  if current isnt text
    tmp = "#{bundle}.tmp"
    writeFileSync tmp, text
    renameSync tmp, bundle
  if cfg.watch
    syncFiles!(modules)
    writeManifest!()
  state.liveBundle = bundle
  bundle

escapeHtml = (value) -> String(value).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;')

configureEdgeFiles = ->
  appRoot = join(cfg.appDir, 'app')
  return unless existsSync(appRoot) or cfg.files?
  if cfg.files? and not cfg.files.shell?
    cfg.files = { roots: cfg.files.roots, proxy_first: cfg.files.proxy_first }
    return
  roots = [{ path: state.generatedDir, cache: 'revalidate', browse: false }]
  publicRoot = join(cfg.appDir, 'public')
  roots.push { path: publicRoot, cache: 'revalidate', browse: false } if existsSync(publicRoot)
  if cfg.files?
    roots.push ...cfg.files.roots
  else
    roots.push { path: appRoot, cache: 'never', browse: false } if existsSync(appRoot)
    roots.push { path: cfg.appDir, cache: 'never', browse: false }
  roots = roots.filter (root, i) -> roots.findIndex((seen) -> seen.path is root.path) is i

  authoredShell = join(appRoot, 'index.html')
  shell = cfg.files?.shell
  unless shell?
    if existsSync(authoredShell)
      shell = authoredShell
    else
      shell = join(state.generatedDir, 'index.html')
      workspace = if cfg.watch then ', workspace: true' else ''
      writeFileSync shell, """
      <!doctype html>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>#{escapeHtml(cfg.name)}</title>
      <div id="app"></div>
      <script type="module">
        import { bootApp } from '/@rip/rip.js'
        const debug = new URLSearchParams(location.search).has('debug')
        bootApp({ url: '/bundle.json', debug#{workspace} })
      </script>
      """
  cfg.files = { roots, proxy_first: cfg.files?.proxy_first ?? (if cfg.entry? then ['/api'] else []), shell }

# ==============================================================================
# Compile-only API generation subprocess
# ==============================================================================

generatorPath =! join(import.meta.dir, 'generate.rip')

startPreparation = (sourceEpoch) ->
  state.prepareCounter += 1
  taskId = "g#{state.prepareCounter}"
  artifact = join(state.runDir, "#{taskId}-app.js")
  resultPath = join(state.runDir, "#{taskId}-result.json")
  preload = process.execArgv.find((a) -> a.startsWith('--preload='))
  abort 'rip-server: the rip loader is missing from execArgv — cannot spawn generation' unless preload?
  proc = trackChild Bun.spawn [process.execPath, preload, generatorPath, cfg.entry, artifact, resultPath, taskId, "#{sourceEpoch}"],
    stdin: 'ignore'
    stdout: 'ignore'
    stderr: 'pipe'
    env: process.env
  stderrText = new Response(proc.stderr).text()
  promise = do ->
    code = await proc.exited
    diagnostic = (await stderrText).trim()
    unless code is 0
      throw new Error(diagnostic or "generation #{taskId} exited #{code}")
    result = JSON.parse readFileSync(resultPath, 'utf8')
    try unlinkSync resultPath
    unless result.taskId is taskId and result.sourceEpoch is sourceEpoch
      try unlinkSync artifact
      throw new Error("generation result identity mismatch for #{taskId}")
    if state.shuttingDown or sourceEpoch isnt state.sourceEpoch
      try unlinkSync artifact
      return null
    result
  prep = { taskId, sourceEpoch, proc, promise }
  state.preparation = prep
  cleanup = promise.finally ->
    if state.preparation is prep
      state.preparation = null
      if sourceEpoch isnt state.sourceEpoch and state.needsPreparation and state.operation is 'Active' and not state.shuttingDown
        queueMicrotask -> prepareLatest().catch(-> null)
  cleanup.catch -> null
  prep

kickPrepare = ->
  epoch = state.sourceEpoch
  if state.preparation?
    return state.preparation.promise if state.preparation.sourceEpoch is epoch
    try state.preparation.proc.kill('SIGTERM')
  startPreparation(epoch).promise

acceptPrepared = (candidate) ->
  return null unless candidate?
  return null if candidate.sourceEpoch isnt state.sourceEpoch or state.shuttingDown
  prior = state.prepared
  if prior?.artifact? and prior.artifact isnt candidate.artifact
    try unlinkSync prior.artifact
  state.prepared = candidate
  state.apiInputs = candidate.inputs.map (input) -> input.path
  if state.watcher?
    snap = hashApp()
    state.lastHash = snap.hash
    state.lastFiles = snap.files
  state.prepareError = null
  state.needsPreparation = false
  candidate

prepareLatest = (cutOnSuccess = true) ->
  epoch = state.sourceEpoch
  try
    candidate = acceptPrepared! kickPrepare!()
    return null unless candidate?
    if cutOnSuccess and state.operation is 'Active'
      state.dirty = true
      cutAdmission()
      kickBoot().catch(-> null) if cfg.eager
    candidate
  catch err
    return null if epoch isnt state.sourceEpoch or state.shuttingDown
    message = err?.message or String(err)
    if state.currentPool? and not state.doorbellPublished
      state.prepareError = message
      warn "rip-server: API candidate rejected; keeping current workers: #{message}"
    else
      state.bootFailure = message
      warn "rip-server: API generation failed: #{message}"
    throw err

# ==============================================================================
# The workspace dev feed (docs/WORKSPACE.md)
# ==============================================================================
#
# An App-only save rewrites the manager-owned bundle and manifest, then dings
# /hub with {id,hash}. API admission and workers remain untouched.

export DEV_CHANNEL =! '/hub'

# Sync the registry against a modules snapshot and write what changed. A new
# path mints its id — the birth path, Q3/B′. A changed path updates its
# content hash. A deleted path retires: dropped from the manifest, its
# latest file removed; the delete ding carries the retired generation's
# hash so the bag ignores a stale delete after a recreate. A rename is
# retire + mint (id persistence across renames is open research). The
# caller supplies the snapshot — a second disk walk here would re-open
# the silent-stale class. Returns the changed { id, hash, deleted? } entries.
syncFiles = (walk) ->
  modules = walk.modules
  changed = []
  for path, source of modules
    h = rash(walk.moduleBytes[path] or new TextEncoder().encode(source))
    entry = state.files[path]
    if not entry?
      entry = { id: path, hash: h, retired: false }
      state.files[path] = entry
      changed.push entry
    else if entry.retired
      entry.retired = false
      entry.hash = h
      changed.push entry
    else if entry.hash isnt h
      entry.hash = h
      changed.push entry
  for path, entry of state.files
    if not modules[path]? and not entry.retired
      entry.retired = true
      changed.push { id: entry.id, hash: entry.hash, deleted: true }
  changed

# The manifest is the LAST durable document on every file path — written
# only after the bundle carrying the same hashes is.
# A boot can heal forward from it via resync. tmp + rename prevents clients
# from observing a torn document.
writeManifest = ->
  live = []
  for path, entry of state.files
    # The id IS the store path (B′ — the birth path is the id, a rename
    # retires and mints), so the entry carries one spelling of that fact.
    live.push { id: entry.id, hash: entry.hash } unless entry.retired
  live.sort (a, b) -> if a.id < b.id then -1 else 1
  text = JSON.stringify({ files: live })
  current = if existsSync(state.manifestPath) then readFileSync(state.manifestPath, 'utf8') else null
  return if current is text
  tmp = "#{state.manifestPath}.tmp"
  Bun.write! tmp, text
  renameSync tmp, state.manifestPath
  return

# Rewrite the stable manager-owned bundle before the manifest names its bytes.
refreshLiveBundle = (walk) ->
  bundle = state.liveBundle
  unless bundle?
    throw new Error('rip-server: no live App bundle to rewrite — manifest held back')
  tmp = "#{bundle}.tmp"
  Bun.write! tmp, assembleBundleText!(walk)
  renameSync tmp, bundle

# The generated publication path writes the bundle, then the manifest — every
# document durable BEFORE the ding names the new hashes, and the manifest
# last. A reassembly failure holds the manifest back while dings still
# publish: live feeds fetch modules directly. A publish failure warns and
# never blocks publication or crashes the manager — authored module bytes are
# already servable.
# Exported as an in-process
# test seam (the manifest-holdback and serialization pins drive it directly).
#
# Runs SERIALIZE on one promise chain: overlapping runs would race on the
# shared tmp paths (manifest.json.tmp and bundle.json.tmp), and
# interleaved writes can land a torn document through the rename. A run's
# failure surfaces to its own caller and never blocks the next run.
fileChain = Promise.resolve()

export onFileChange = ->
  next = fileChain.then -> runFileChange()
  fileChain = next.catch -> null
  next

runFileChange = ->
  modules = readAppModules!()
  return unless modules?
  state.afterAppSnapshot?()
  changed = syncFiles!(modules)
  try
    refreshLiveBundle!(modules)
    writeManifest!()
  catch e
    warn "rip-server: generated publication failed — manifest held back: #{e?.message or e}"
  dings = changed.map (c) ->
    ding = { id: c.id, hash: c.hash }
    ding.kind = 'delete' if c.deleted is true
    { '@': [DEV_CHANNEL], ding }
  i = 0
  while i < dings.length                 # the publish plane caps 16 objects per frame
    try
      publish! dings.slice(i, i + 16)
    catch e
      warn "rip-server: dev ding publish failed: #{e?.message or e}"
    i += 16
  return

# ==============================================================================
# Workers and pools
# ==============================================================================

workerPath =! join(import.meta.dir, 'worker.rip')

spawnWorker = (pool) ->
  pool.serial += 1
  sock = join(state.runDir, "p#{pool.n}w#{pool.serial}.sock")
  env = { ...process.env, APP_ARTIFACT: pool.artifact, SOCKET_PATH: sock, WORKER_ID: "#{pool.n}.#{pool.serial}", WORKER_CONCURRENCY: "#{cfg.concurrency}", RIP_DRAIN_DEADLINE_MS: "#{WORKER_DRAIN_MS}" }
  proc = trackChild Bun.spawn ['bun', state.workerJs],
    stdout: if cfg.accessMode is 'raw' then 'pipe' else 'inherit'
    stderr: if cfg.accessMode is 'raw' then 'pipe' else 'inherit'
    stdin: 'ignore'
    env: env
  w = { sock, proc, ready: false, spawnedAt: Date.now(), readyAt: null }
  if cfg.accessMode is 'raw'
    w.stdoutPump = pumpAccessOutput(proc.stdout, process.stderr)
    w.stderrPump = pumpAccessOutput(proc.stderr, process.stderr)
    for pump in [w.stdoutPump, w.stderrPump]
      pump.catch (e) ->
        return if state.shuttingDown
        state.outputFailure = e
        shutdown! 'worker output failure', 1
  monitorWorker pool, w
  w

# Crash respawn — outside reloads only: a retired or superseded pool's exits
# are expected, and a pool that never published is the boot path's problem.
monitorWorker = (pool, w) ->
  do ->
    code = await w.proc.exited
    return if state.shuttingDown or pool.retired or pool isnt state.currentPool
    if state.operation is 'Held'
      pool.workers = pool.workers.filter (candidate) -> candidate isnt w
      publishSocks pool
      return
    return unless state.operation is 'Active'
    warn "rip-server: worker exited (code #{code}); respawning"
    w.ready = false
    try unlinkSync w.sock
    publishSocks pool             # crashed sock leaves the registry while down
    sleep! 250
    return if state.shuttingDown or pool.retired or pool isnt state.currentPool or state.dirty
    fresh = spawnWorker(pool)
    idx = pool.workers.indexOf(w)
    pool.workers[idx] = fresh if idx >= 0
    outcome = pollWorker! fresh
    publishSocks pool if outcome.ok
  null

pollWorker = (w) ->
  deadline = Date.now() + BOOT_DEADLINE_MS
  lastBody = null
  loop
    if w.proc.exitCode?
      return { ok: false, w, error: lastBody or "worker exited with code #{w.proc.exitCode} before ready" }
    try
      res = fetch! 'http://worker/ready', { unix: w.sock }
      if res.status is 200
        w.ready = true
        w.readyAt = Date.now()
        return { ok: true, w }
      lastBody = res.text!
      # The worker marks a failed boot on /ready — no point waiting out
      # the deadline for an import that already threw.
      if res.headers.get('rip-boot-failed')?
        return { ok: false, w, error: lastBody }
    if Date.now() > deadline
      return { ok: false, w, error: lastBody or 'worker boot deadline expired' }
    sleep! 25

spawnPool = (artifact, durable = false) ->
  state.poolCounter += 1
  pool = { n: state.poolCounter, serial: 0, workers: [], polls: [], retired: false, artifact, durable }
  for i in [0...cfg.workers]
    pool.workers.push spawnWorker(pool)
  pool.polls = pool.workers.map (w) -> pollWorker(w)
  pool

# Resolves when `need` workers are ready; throws when readiness is impossible.
awaitReady = (pool, need) ->
  if need >= pool.polls.length
    outcomes = Promise.all! pool.polls
    bad = outcomes.find (o) -> not o.ok
    throw new Error(bad.error) if bad?
    return
  firstReady = new Promise (resolveReady, rejectReady) ->
    remaining = pool.polls.length
    firstError = null
    settleOne = (o) ->
      if o.ok
        resolveReady(o)
      else
        firstError ?= o.error
        remaining -= 1
        rejectReady(new Error(firstError or 'no worker became ready')) if remaining is 0
    for pr in pool.polls
      pr.then settleOne
  await firstReady
  return

readySocks = (pool) ->
  out = []
  for w in pool.workers
    out.push({ path: w.sock }) if w.ready
  out

sameList = (a, b) -> JSON.stringify(a) is JSON.stringify(b)

# Awaited full-list PUT for the current pool: late-ready workers join, crashed
# workers leave. The dirty check applies to every publish.
publishSocks = (pool) ->
  return if state.shuttingDown or pool.retired or pool isnt state.currentPool
  return if state.dirty or state.doorbellPublished
  list = readySocks(pool)
  return if sameList(list, state.lastUpstreams)
  bumpDesired()
  queueDesired()

# With readyWhen 1, workers still booting after the first publish each trigger
# one more awaited full-list PUT as they come ready. A worker whose readiness
# poll gave up gets killed so the crash monitor can respawn it.
attachLateJoins = (pool) ->
  return unless state.readyWhen < pool.workers.length
  for pr in pool.polls
    pr.then (o) ->
      if o.ok
        publishSocks pool
      else unless o.w.proc.exitCode?
        try o.w.proc.kill('SIGTERM')
  return

# Retire a pool: flat drain grace, SIGTERM, SIGKILL if needed, unlink after
# exit. Returns the completion promise; callers that must not wait ignore it.
retirePool = (pool, graceMs = DRAIN_MS) ->
  return null unless pool? and not pool.retired
  pool.retired = true
  do ->
    sleep! graceMs if graceMs > 0
    for w in pool.workers
      try w.proc.kill('SIGTERM')
    hardKill = setTimeout ->
      for w in pool.workers
        try w.proc.kill('SIGKILL') unless w.proc.exitCode?
    , KILL_MS
    Promise.all! pool.workers.map (w) -> w.proc.exited
    if cfg.accessMode is 'raw'
      await Promise.allSettled(pool.workers.flatMap((w) -> [w.stdoutPump, w.stderrPump]))
    clearTimeout hardKill
    for w in pool.workers
      try unlinkSync w.sock
    try unlinkSync pool.artifact if pool.artifact? and not pool.durable
    return

scrapPool = (pool) -> retirePool pool, 0

# ==============================================================================
# The dirty epoch
# ==============================================================================

# Admission cut: publish the doorbell as the only upstream, then retire the
# old pool in the background. Idempotent — one doorbell PUT per epoch.
cutAdmission = ->
  return if state.doorbellPublished
  state.doorbellPublished = true
  state.dirty = true
  state.cutToken += 1
  token = state.cutToken
  oldPool = state.currentPool
  version = bumpDesired()
  enqueue ->
    return unless token is state.cutToken and state.doorbellPublished and not state.shuttingDown
    published = putDesired! version
    return unless published
    state.currentPool = null if state.currentPool is oldPool
    retirePool oldPool if oldPool?
    null

onContentChange = ->
  state.bootFailure = null
  state.prepareError = null
  state.needsPreparation = true
  prepareLatest().catch -> null

# Single-flight: one boot per app at a time; concurrent demand joins it.
kickBoot = ->
  return state.bootPromise if state.bootPromise?
  pr = bootLoop()
  state.bootPromise = pr
  # The cleanup chain must swallow the failure itself — `finally` passes a
  # rejection through, and an unhandled one kills the process.
  cleanup = pr.finally ->
    state.bootPromise = null if state.bootPromise is pr
  cleanup.catch -> null       # the failure is cached; rings read it as 503
  pr

# Boot only from a compile-only candidate accepted for the current source
# epoch. Rings never compile; they wait for preparation if it is still running.
bootLoop = ->
  loop
    throw new Error("manager is #{state.operation.toLowerCase()}") unless state.operation is 'Active'
    candidate = state.prepared
    unless candidate? and candidate.sourceEpoch is state.sourceEpoch
      candidate = acceptPrepared! kickPrepare!()
      state.prepared = candidate if candidate?
    continue unless candidate?
    if candidate.sourceEpoch isnt state.sourceEpoch
      try unlinkSync candidate.artifact
      state.prepared = null if state.prepared is candidate
      continue
    pool = spawnPool(candidate.artifact)
    state.bootingPool = pool
    try
      awaitReady! pool, state.readyWhen
    catch err
      scrapPool pool
      state.bootingPool = null if state.bootingPool is pool
      state.prepared = null if state.prepared is candidate
      continue if candidate.sourceEpoch isnt state.sourceEpoch
      state.bootFailure = err?.message or String(err)
      warn "rip-server: pool boot failed: #{state.bootFailure}"
      throw err
    if candidate.sourceEpoch isnt state.sourceEpoch
      scrapPool pool
      state.bootingPool = null if state.bootingPool is pool
      state.prepared = null if state.prepared is candidate
      continue
    epoch = candidate.sourceEpoch
    published = enqueue! ->
      return false if epoch isnt state.sourceEpoch or state.shuttingDown or pool.retired
      state.currentPool = pool
      state.doorbellPublished = false
      state.dirty = false
      version = bumpDesired()
      ok = putDesired! version
      # A save can land while the sockets PUT is in flight. Correct the remote
      # state back to the doorbell before allowing this boot to complete.
      if epoch isnt state.sourceEpoch or state.shuttingDown
        state.currentPool = null if state.currentPool is pool
        state.doorbellPublished = true unless state.shuttingDown
        state.dirty = true unless state.shuttingDown
        correction = bumpDesired()
        putDesired! correction
        return false
      ok
    unless published
      scrapPool pool
      state.bootingPool = null if state.bootingPool is pool
      state.prepared = null if state.prepared is candidate
      continue
    state.prepared = null if state.prepared is candidate
    state.bootingPool = null if state.bootingPool is pool
    state.bootFailure = null
    attachLateJoins pool
    return

# A release or migration activation is an epoch: connected pages may hold
# pre-activation code, and no file ding describes the coordinated change.
# Fire-and-forget: a publish failure warns and never blocks activation.
dingEpoch = (n) ->
  pr = do -> publish! [{ '@': [DEV_CHANNEL], ding: { kind: 'epoch', epoch: n } }]
  pr.catch (e) -> warn "rip-server: epoch ding publish failed: #{e?.message or e}"

# ==============================================================================
# The doorbell
# ==============================================================================

handleRing = ->
  if state.shuttingDown                              # never spawn during shutdown
    return new Response('shutting down', { status: 503 })
  unless state.operation is 'Active'
    return new Response(state.operation.toLowerCase(), { status: 503 })
  if state.bootFailure?
    return new Response(state.bootFailure, { status: 503 })
  if not state.dirty and not state.doorbellPublished and state.currentPool?
    return new Response(null, { status: 204 })      # stray ring; pool already live
  if state.ringWaiters >= WAITER_CAP
    return new Response('too many held requests', { status: 503, headers: { 'Retry-After': '1' } })
  state.ringWaiters += 1
  try
    outcome = holdBoot! kickBoot()
    if outcome is 'ok'
      new Response(null, { status: 204 })            # the sockets PUT's 200 already landed
    else if outcome is 'timeout'
      new Response('boot still in progress', { status: 503, headers: { 'Retry-After': '2' } })
    else
      new Response(state.bootFailure or outcome.error or 'boot failed', { status: 503 })
  finally
    state.ringWaiters -= 1

holdBoot = (bootPr) ->
  timer = null
  hold = new Promise (resolveHold) ->
    timer = setTimeout (-> resolveHold 'timeout'), HOLD_MS
  outcome = Promise.race! [
    bootPr.then((-> 'ok'), ((e) -> { error: e?.message or String(e) }))
    hold
  ]
  clearTimeout timer
  outcome

startDoorbell = ->
  state.bellPath = join(state.runDir, 'bell.sock')
  state.bell = Bun.serve
    unix: state.bellPath
    fetch: (req) ->
      url = new URL(req.url)
      if req.method is 'GET' and url.pathname is '/ring'
        return handleRing!()
      new Response('Not Found', { status: 404 })

# ==============================================================================
# The watcher — bag allowlist *.rip / *.css / *.html, rename-safe via hash gate
# ==============================================================================

# Editors save temp-then-rename, so event basenames are untrusted. Any
# non-ignored event just arms the settle timer; the decision comes from
# hashing the real bag files on disk — identical bytes cost nothing.
# Project-root main entry (app.rip / index.rip) is included when present;
# a change there (or anywhere outside app/) takes the epoch path.
ignoredPath = (rel) ->
  return false unless rel?
  rel = String(rel)
  return true if rel is 'static/generated' or rel.startsWith('static/generated/')
  for seg in rel.split('/')
    return true if seg.startsWith('.') or IGNORED_DIRS.has(seg)
  false

hashApp = ->
  files = []
  walk = (dir) ->
    entries = []
    try entries = readdirSync(dir, { withFileTypes: true })
    for e in entries
      continue if e.name.startsWith('.') or IGNORED_DIRS.has(e.name)
      full = join(dir, e.name)
      if e.isDirectory()
        walk(full)
      else if isBagFile(e.name)
        files.push(full)
  appRoot = join(cfg.appDir, 'app')
  walk appRoot if existsSync(appRoot)
  files.push(cfg.entry) if cfg.entry?
  files.push(path) for path in state.apiInputs when not files.includes(path)
  files.sort()
  # Per-file hashes feed both the whole-tree gate and (flag on) the
  # client-only (app/-only) change classification in settle.
  map = {}
  hasher = new Bun.CryptoHasher('sha256')
  for f in files
    bytes = try readFileSync(f) catch then null
    map[f] = if bytes? then new Bun.CryptoHasher('sha256').update(bytes).digest('hex') else 'missing'
    hasher.update f
    hasher.update map[f]
  { hash: hasher.digest('hex'), files: map }

# Every changed, added, or removed path lies under app/ (the default
# client bag) — then the save is a file feed, not a reload. The main
# server entry lives next to app/ and therefore takes the epoch path.
changeKinds = (prev, cur) ->
  boundary = join(cfg.appDir, 'app') + '/'
  app = false
  api = false
  for path, h of cur
    if prev[path] isnt h
      if path.startsWith(boundary) then app = true else api = true
  for path of prev
    unless cur[path]?
      if path.startsWith(boundary) then app = true else api = true
  { app, api }

settle = ->
  state.settleTimer = null
  return unless state.operation is 'Active'
  snap = hashApp()
  if snap.hash is state.lastHash
    onContentChange() if state.needsPreparation and not state.preparation?
    return
  prev = state.lastFiles
  state.lastHash = snap.hash
  state.lastFiles = snap.files
  kinds = if prev? then changeKinds(prev, snap.files) else { app: false, api: true }
  if kinds.app
    onFileChange().catch (e) -> warn "rip-server: generated publication failed: #{e?.message or e}"
  onContentChange() if kinds.api

startWatcher = ->
  snap = hashApp()
  state.lastHash = snap.hash
  state.lastFiles = snap.files
  state.watcher = watch cfg.appDir, { recursive: true }, (event, filename) ->
    return if state.shuttingDown or ignoredPath(filename)
    rel = String(filename or '')
    if rel is 'serve.rip' or rel.endsWith('/serve.rip')
      unless state.restartWarned
        state.restartWarned = true
        warn 'rip-server: serve.rip changed — restart required; the running declaration is unchanged'
      return
    state.sourceEpoch += 1
    clearTimeout state.settleTimer if state.settleTimer?
    state.settleTimer = setTimeout settle, SETTLE_MS
  state.watchPoll = setInterval (->
    return if state.shuttingDown or state.operation isnt 'Active' or state.settleTimer?
    snap = hashApp()
    if snap.hash isnt state.lastHash
      state.sourceEpoch += 1
      state.settleTimer = setTimeout settle, SETTLE_MS
  ), WATCH_POLL_MS

# ==============================================================================
# The startup report
# ==============================================================================

# Humanize a value in base units (seconds or bytes) with SI prefixes spanning
# T G M k (space) m µ n p — fixed width: 3 chars of digits, 1 char of prefix,
# then the unit. One decimal below 10 (`1.5`), integers from 10 up (` 57`);
# the no-prefix slot pads with a space so `1.5 s` aligns with `1.5ms`.
# Scale-down below 0.995, scale-up at 999.5 — rounding promotes across the
# boundary (9.97 → ` 10`). Zero prints `  0 s`; NaN, negatives, and
# out-of-range magnitudes print `???` + unit.
export scale = (value, unit, pad = true) ->
  if value > 0 and Number.isFinite(value)
    span = ['T', 'G', 'M', 'k', (if pad then ' ' else ''), 'm', 'µ', 'n', 'p']
    minSlot = 0
    maxSlot = span.length - 1
    slot = 4                      # the no-prefix slot
    while value < 0.995 and slot <= maxSlot
      value *= 1000
      slot++
    while value >= 999.5 and slot >= minSlot
      value /= 1000
      slot--
    if slot >= minSlot and slot <= maxSlot
      tens = Math.round(value * 10) / 10
      nums = if tens >= 10 then Math.round(value).toString() else tens.toFixed(1)
      nums = nums.padStart(3, ' ') if pad
      return "#{nums}#{span[slot]}#{unit}"
  return (if pad then '  0 ' else '0') + unit if value is 0
  '???' + (if pad then ' ' else '') + unit

serverVersion =! JSON.parse(readFileSync(join(import.meta.dir, 'package.json'), 'utf8')).version

# The report's ONE color decision: mono (empty codes) when NO_COLOR is set or
# stdout is not a TTY; ANSI otherwise.
reportTheme = ->
  output = if cfg.accessMode is 'raw' then process.stderr else process.stdout
  if process.env.NO_COLOR? or not output.isTTY
    { d: '', r: '', b: '', c: '', g: '', y: '' }
  else
    { d: '\x1b[2m', r: '\x1b[0m', b: '\x1b[1m', c: '\x1b[36m', g: '\x1b[32m', y: '\x1b[33m' }

managerPrint = (text) ->
  stream = if cfg.accessMode is 'raw' then process.stderr else process.stdout
  writeAccessOutput! stream, "#{text}\n"

managerPrintOwned = (text) ->
  try
    managerPrint! text
  catch e
    if cfg.accessMode is 'raw' and state.appId? and not state.shuttingDown
      state.outputFailure = e
      shutdown! 'manager output failure', 1
      return
    throw e

# Printed once, after the startup boot fully completes: every worker poll has
# settled, the registration is confirmed, and the upstreams PUT has landed.
# The registration facts are READ BACK from the control plane (GET /1.0 and
# GET /1.0/apps/{id}) so the report states what JANUS holds, not what this
# manager sent; a failed read-back is reported as a failure, never as success.
startupReport = ->
  pool = state.currentPool
  outcomes = if pool? then Promise.all! pool.polls else []

  plane = null
  planeErr = null
  reg = null
  regErr = null
  # Read-backs ride the writer chain so they observe every PUT already sent
  # (late-join publishes included), never a half-published pool.
  enqueue! ->
    try
      res = cfetch! 'GET', '/1.0'
      if res.status is 200
        plane = res.json!
      else
        planeErr = "GET /1.0 → #{res.status}"
    catch e
      planeErr = e?.message or String(e)
    try
      res = cfetch! 'GET', "/1.0/apps/#{state.appId}"
      if res.status is 200
        reg = res.json!
      else
        regErr = "GET /1.0/apps/#{state.appId} → #{res.status}"
    catch e
      regErr = e?.message or String(e)

  { d, r, b, c, g, y } = reportTheme()
  label = (name) -> "#{d}#{name}#{r}" + ' '.repeat(9 - name.length)
  target = if state.controlUnix? then "unix:#{state.controlUnix}" else state.controlBase

  lines = []
  lines.push ''
  lines.push "  #{b}rip server#{r} #{d}v#{serverVersion}#{r}"
  lines.push ''
  lines.push "  #{label('app')}#{cfg.name} #{d}(#{state.appId})#{r}"
  if plane?
    lines.push "  #{label('control')}#{c}#{target}#{r} #{d}— #{plane.type} #{plane.api_version}#{r}"
  else
    lines.push "  #{label('control')}#{c}#{target}#{r} #{d}—#{r} #{y}read-back failed (#{planeErr})#{r}"
  lines.push "  #{label('workers')}#{cfg.workers}"
  lines.push "  #{label('watch')}#{if cfg.watch then "*.rip#{if cfg.eager then ', eager' else ''}" else "#{y}off#{r}"}"

  if outcomes.length > 0
    lines.push ''
    width = 0
    width = Math.max(width, o.w.sock.length) for o in outcomes
    for o, i in outcomes
      sock = o.w.sock.padEnd(width)
      if o.ok
        lines.push "  #{g}✓#{r} worker #{i + 1}   #{sock}   #{d}#{scale((o.w.readyAt - o.w.spawnedAt) / 1000, 's')}#{r}"
      else
        lines.push "  #{y}✗#{r} worker #{i + 1}   #{sock}   #{y}#{o.error}#{r}"

  lines.push ''
  if reg?
    held = reg.upstreams?.length or 0
    lines.push "  #{d}registered#{r}  #{held} upstream#{if held is 1 then '' else 's'} published, heartbeating every #{scale(HEARTBEAT_MS / 1000, 's', false)}"
  else
    lines.push "  #{d}registered#{r}  #{y}read-back failed (#{regErr})#{r}"

  ready = outcomes.filter((o) -> o.ok).length
  lines.push ''
  if reg?
    lines.push "  #{g}#{b}→#{r} #{g}#{cfg.name} registered with janus, #{ready} worker#{if ready is 1 then '' else 's'} ready#{r}"
  else
    lines.push "  #{y}#{b}→#{r} #{y}#{cfg.name} up, #{ready} worker#{if ready is 1 then '' else 's'} ready — registration read-back failed#{r}"
  lines.push ''
  managerPrintOwned lines.join('\n')

# ==============================================================================
# Startup and shutdown
# ==============================================================================

# An app-local serve.rip owns Janus routing/static configuration. Process
# controls (workers, concurrency, watch, eager, control) remain CLI/env knobs.
# Paths are made absolute against the app directory before they cross /1.0.
isRecord = (value) ->
  value? and typeof value is 'object' and not Array.isArray(value)

invalidServe = (message) ->
  throw new Error("rip-server: #{message}")

rejectUnknown = (value, allowed, at) ->
  invalidServe "#{at} must be an object" unless isRecord(value)
  for key of value
    invalidServe "unknown #{at} key #{JSON.stringify(key)}" unless allowed.includes(key)

needString = (value, at) ->
  invalidServe "#{at} must be a non-empty string" unless typeof value is 'string' and value.length > 0 and value.trim() is value
  value

validHost = (host) ->
  return false if host.length > 253 or host.includes(':') or host.includes('/') or host.includes(' ')
  labels = host.split('.')
  return false if labels.some((label) -> label.length is 0 or label.length > 63)
  labels.every (label) -> /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/i.test(label)

siteTemplate = (value, at) ->
  value = needString(value, at)
  invalidServe "#{at} must contain exactly one {site}" unless value.split('{site}').length is 2
  invalidServe "#{at} contains a malformed template" if /[{}]/.test(value.replace('{site}', ''))
  invalidServe "#{at} must have the form {site}.<hostname>" unless value.startsWith('{site}.')
  value

pathTemplate = (value, at) ->
  value = needString(value, at)
  invalidServe "#{at} must be relative to the app" if value.startsWith('/')
  invalidServe "#{at} must use / path separators" if value.includes('\\')
  segments = value.split('/')
  invalidServe "#{at} must be a clean relative path" if segments.some((part) -> part is '' or part is '.' or part is '..')
  clean = value
  invalidServe "#{at} contains a malformed template" if /[{}]/.test(clean.replace('{site}', ''))
  count = clean.split('{site}').length - 1
  invalidServe "#{at} may contain {site} at most once" if count > 1
  if count is 1
    invalidServe "#{at} must use {site} as a complete path segment" unless clean.split('/').includes('{site}')
  { value, clean, dynamic: count is 1 }

requireDir = (path, at) ->
  invalidServe "#{at} directory not found: #{path}" unless existsSync(path)
  invalidServe "#{at} is not a directory: #{path}" unless statSync(path).isDirectory()

requireFile = (path, at) ->
  invalidServe "#{at} file not found: #{path}" unless existsSync(path)
  invalidServe "#{at} is not a file: #{path}" unless statSync(path).isFile()

export normalizeServeConfig = (raw, appDir) ->
  rejectUnknown raw, ['name', 'hosts', 'sites', 'files'], 'serve.rip'
  out: any = {}
  out.name = needString(raw.name, 'serve.rip name') if raw.name?

  if raw.hosts?
    invalidServe "serve.rip hosts must be a non-empty array" unless Array.isArray(raw.hosts) and raw.hosts.length > 0
    out.hosts = raw.hosts.map (host, i) ->
      host = needString(host, "serve.rip hosts[#{i}]")
      invalidServe "serve.rip hosts[#{i}] is not a valid host: #{host}" unless validHost(host)
      host

  if raw.sites?
    invalidServe "serve.rip cannot define both hosts and sites" if raw.hosts?
    rejectUnknown raw.sites, ['host', 'dir', 'aliases'], 'serve.rip sites'
    host = siteTemplate(raw.sites.host, 'serve.rip sites.host')
    invalidServe "serve.rip sites.host is not a valid host template: #{host}" unless validHost(host.replace('{site}', 'tenant'))
    dirValue = pathTemplate(raw.sites.dir, 'serve.rip sites.dir')
    invalidServe "serve.rip sites.dir cannot contain a template" if dirValue.dynamic
    siteDir = resolve(appDir, dirValue.value)
    requireDir siteDir, 'serve.rip sites.dir'
    aliases = raw.sites.aliases ?? {}
    invalidServe "serve.rip sites.aliases must be an object" unless isRecord(aliases)
    normalizedAliases = {}
    for alias, site of aliases
      invalidServe "serve.rip sites.aliases has an invalid host: #{alias}" unless validHost(alias)
      site = needString(site, "serve.rip sites.aliases.#{alias}")
      invalidServe "serve.rip sites.aliases.#{alias} is not a valid site name: #{site}" unless /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/.test(site) and site isnt 'common'
      normalizedAliases[alias] = site
    out.site = { host, dir: siteDir, aliases: normalizedAliases }

  if raw.files?
    rejectUnknown raw.files, ['roots', 'proxyFirst', 'shell'], 'serve.rip files'
    roots = raw.files.roots
    invalidServe "serve.rip files.roots must be a non-empty array" unless Array.isArray(roots) and roots.length > 0
    normalizedRoots = roots.map (root, i) ->
      cache = 'revalidate'
      browse = false
      if isRecord(root)
        rejectUnknown root, ['path', 'cache', 'browse'], "serve.rip files.roots[#{i}]"
        if 'cache' of root
          cache = needString(root.cache, "serve.rip files.roots[#{i}].cache")
          invalidServe "serve.rip files.roots[#{i}].cache must be never, revalidate, or forever" unless ['never', 'revalidate', 'forever'].includes(cache)
        if 'browse' of root
          invalidServe "serve.rip files.roots[#{i}].browse must be a Boolean" unless typeof root.browse is 'boolean'
          browse = root.browse
        root = root.path
      parsed = pathTemplate(root, "serve.rip files.roots[#{i}]")
      full = resolve(appDir, parsed.value)
      if parsed.dynamic
        prefix = parsed.clean.split('/').slice(0, parsed.clean.split('/').indexOf('{site}')).join('/')
        requireDir resolve(appDir, prefix or '.'), "serve.rip files.roots[#{i}] static prefix"
      else
        requireDir full, "serve.rip files.roots[#{i}]"
      { path: full, cache, browse }
    proxyFirst = raw.files.proxyFirst ?? []
    invalidServe "serve.rip files.proxyFirst must be an array" unless Array.isArray(proxyFirst)
    normalizedProxy = proxyFirst.map (path, i) ->
      path = needString(path, "serve.rip files.proxyFirst[#{i}]")
      invalidServe "serve.rip files.proxyFirst[#{i}] must be a clean /-prefixed path" unless path.startsWith('/') and not path.includes('?') and not path.includes('#') and not path.includes('\\') and (path is '/' or not path.endsWith('/')) and not path.split('/').some((part) -> part is '.' or part is '..')
      path
    for prefix, i in normalizedProxy
      for prior in normalizedProxy.slice(0, i)
        overlaps = prefix is '/' or prior is '/' or prefix is prior or prefix.startsWith("#{prior}/") or prior.startsWith("#{prefix}/")
        invalidServe "serve.rip files.proxyFirst entries overlap: #{prior} and #{prefix}" if overlaps
    shell = null
    if 'shell' of raw.files
      shellValue = pathTemplate(raw.files.shell, 'serve.rip files.shell')
      invalidServe "serve.rip files.shell cannot contain a template" if shellValue.dynamic
      shell = resolve(appDir, shellValue.value)
      requireFile shell, 'serve.rip files.shell'
    else
      allBrowsable = normalizedRoots.every (root) -> root.browse is true
      invalidServe "serve.rip files.shell is required unless every root is browsable and proxyFirst is empty" unless allBrowsable and normalizedProxy.length is 0
    out.files = { roots: normalizedRoots, proxy_first: normalizedProxy }
    out.files.shell = shell if shell?

  invalidServe "serve.rip sites requires files" if out.site? and not out.files?
  out

export loadServeConfig = (appDir) ->
  configPath = join(appDir, 'serve.rip')
  return null unless existsSync(configPath)
  requireFile configPath, 'serve.rip config'
  mod = null
  try
    mod = import!(configPath)
  catch e
    invalidServe "cannot load #{configPath}: #{e?.message or e}"
  invalidServe "#{configPath} must export default an object" unless isRecord(mod?.default)
  normalizeServeConfig mod.default, appDir

# ==============================================================================
# Local manager control — one canonical project, one private Unix socket
# ==============================================================================

managerStatus = ->
  admission =
    if not cfg.entry? then 'none'
    else if state.doorbellPublished then 'doorbell'
    else if state.currentPool? then 'workers'
    else 'empty'
  {
    root: state.projectRoot
    name: cfg.name
    lifecycle: state.lifecycle
    operation: state.operation
    admission
    workers:
      desired: cfg.workers
      ready: if state.currentPool? then readySocks(state.currentPool).length else 0
    sourceEpoch: state.sourceEpoch
    preparation: if state.preparation? then 'running' else if state.prepared? then 'prepared' else 'none'
    migration: if state.migration? then { id: state.migration.id, phase: state.migration.phase, outcome: state.migration.outcome } else null
    error: state.prepareError or state.bootFailure
    pid: process.pid
  }

managerRuntime = (root) ->
  uid = if typeof process.getuid is 'function' then process.getuid() else 'user'
  dir = join(process.env.XDG_RUNTIME_DIR or '/tmp', "rip-#{uid}")
  mkdirSync dir, { recursive: true, mode: 0o700 }
  chmodSync dir, 0o700
  key = new Bun.CryptoHasher('sha256').update(root).digest('hex').slice(0, 16)
  { path: join(dir, "#{key}.sock"), meta: join(dir, "#{key}.json") }

writeOperation = (record) ->
  dir = dirname(state.operationPath)
  mkdirSync dir, { recursive: true, mode: 0o700 }
  tmp = "#{state.operationPath}.tmp"
  fd = openSync tmp, 'w', 0o600
  try
    writeFileSync fd, JSON.stringify(record)
    fsyncSync fd
  finally
    closeSync fd
  renameSync tmp, state.operationPath
  dfd = openSync dir, 'r'
  try
    fsyncSync dfd
  finally
    closeSync dfd
  state.migration = record

clearOperation = ->
  try unlinkSync state.operationPath
  if state.operationPath? and existsSync(dirname(state.operationPath))
    dfd = openSync dirname(state.operationPath), 'r'
    try
      fsyncSync dfd
    finally
      closeSync dfd
  state.migration = null

readOperation = ->
  return null unless existsSync(state.operationPath)
  try
    JSON.parse readFileSync(state.operationPath, 'utf8')
  catch e
    throw new Error("rip-server: operation journal is unreadable at #{state.operationPath}: #{e?.message or e}")

durableCandidate = (candidate, operationId) ->
  dir = join(state.projectRoot, '.rip', 'generations')
  mkdirSync dir, { recursive: true, mode: 0o700 }
  target = join(dir, "#{operationId}.js")
  bytes = readFileSync candidate.artifact
  writeFileSync target, bytes
  fd = openSync target, 'r'
  try
    fsyncSync fd
  finally
    closeSync fd
  { ...candidate, artifact: target }

durableWrite = (bytes, target) ->
  writeFileSync target, bytes
  fd = openSync target, 'r'
  try
    fsyncSync fd
  finally
    closeSync fd
  target

durableCopy = (source, target) -> durableWrite readFileSync(source), target

writeAppCandidate = (walk, operationId) ->
  return null unless walk?
  dir = join(state.projectRoot, '.rip', 'generations')
  path = join(dir, "#{operationId}-app.json")
  durableWrite Buffer.from(JSON.stringify({ modules: walk.modules, appDir: walk.appDir })), path
  path

readAppCandidate = (path) ->
  return null unless path?
  { modules, appDir } = JSON.parse readFileSync(path, 'utf8')
  moduleBytes = {}
  moduleBytes[id] = new TextEncoder().encode(source) for id, source of modules
  { modules, moduleBytes, moduleFiles: {}, appDir }

migrationOutcome = (text) ->
  lines = String(text).split('\n').filter (line) -> line.startsWith('RIP_MIGRATION_OUTCOME=')
  return { outcome: 'unknown', error: 'migration child produced no durable outcome report' } unless lines.length
  try return JSON.parse(lines[lines.length - 1].slice('RIP_MIGRATION_OUTCOME='.length)) catch then return { outcome: 'unknown', error: 'migration child produced a malformed outcome report' }

runMigrationChild = (body) ->
  bin = join(loaderSrcDir(), '..', 'bin', 'rip')
  args = [process.execPath, bin, 'schema', 'migrate']
  args.push body.entry if body?.entry?
  args.push '--dir', (body?.dir or 'migrations')
  args.push '--coordinated', '--operation-id', body.id
  proc = trackChild Bun.spawn args,
    cwd: state.projectRoot
    stdin: 'ignore'
    stdout: 'pipe'
    stderr: 'pipe'
    env: process.env
  [out, err, code] = await Promise.all [
    new Response(proc.stdout).text()
    new Response(proc.stderr).text()
    proc.exited
  ]
  report = migrationOutcome "#{out}\n#{err}"
  report.code = code
  report.output = if code is 0 then out.trim() else err.trim()
  report

managerRequest = (path, method = 'GET', body = null) ->
  opts = { method, unix: state.managerPath }
  if body?
    opts.headers = { 'Content-Type': 'application/json' }
    opts.body = JSON.stringify(body)
  fetch! "http://manager#{path}", opts

probeManager = ->
  try
    res = managerRequest! '/status'
    return null unless res.status is 200
    res.json!()
  catch
    null

cleanupManagerIdentity = ->
  return unless state.managerNonce? and state.managerMetaPath?
  owned = false
  try
    meta = JSON.parse readFileSync(state.managerMetaPath, 'utf8')
    owned = meta.nonce is state.managerNonce
  return unless owned
  try state.managerServer?.stop(true)
  try unlinkSync state.managerPath
  try unlinkSync state.managerMetaPath

enterHold = ->
  return managerStatus() if state.operation is 'Held'
  throw new Error("cannot hold while #{state.operation}") unless state.operation is 'Active'
  state.operation = 'Held'
  state.operationOwner += 1
  state.sourceEpoch += 1
  state.needsPreparation = true
  state.cutToken += 1
  preparing = state.preparation?.proc
  try preparing?.kill('SIGTERM')
  try unlinkSync state.prepared.artifact if state.prepared?.artifact?
  state.prepared = null
  if state.bootingPool?
    scrapPool state.bootingPool
    state.bootingPool = null
  state.doorbellPublished = false
  state.dirty = false
  await preparing.exited if preparing?
  await fileChain
  version = bumpDesired()
  await enqueue! -> putDesired! version
  managerStatus()

commitReleaseApp = (walk, text) ->
  return unless walk?
  oldFiles = snapshotFiles()
  oldBundle = state.liveBundle
  oldText = if oldBundle? and existsSync(oldBundle) then readFileSync(oldBundle) else null
  try
    unless state.liveBundle?
      state.buildCounter += 1
      state.liveBundle = join(state.runDir, "b#{state.buildCounter}-bundle.json")
    tmp = "#{state.liveBundle}.release.tmp"
    writeFileSync tmp, text
    renameSync tmp, state.liveBundle
    syncFiles!(walk)
    writeManifest!()
  catch e
    state.files = oldFiles
    if oldBundle?
      state.liveBundle = oldBundle
      if oldText?
        tmp = "#{oldBundle}.rollback.tmp"
        writeFileSync tmp, oldText
        renameSync tmp, oldBundle
    else
      try unlinkSync state.liveBundle if state.liveBundle?
      state.liveBundle = null
    writeManifest!() if state.manifestPath?
    throw e

releaseHold = ->
  return managerStatus() if state.operation is 'Active'
  throw new Error("cannot release while #{state.operation}") unless state.operation is 'Held'
  state.operation = 'Releasing'
  state.operationOwner += 1
  owner = state.operationOwner
  epoch = state.sourceEpoch
  oldPool = state.currentPool
  candidate = null
  pool = null
  filesBefore = snapshotFiles()
  try
    walk = readAppModules!()
    appText = if walk? then assembleBundleText!(walk) else null
    unless cfg.entry?
      commitReleaseApp walk, appText
      dingEpoch! state.sourceEpoch if cfg.watch
      state.operation = 'Active'
      snap = hashApp()
      state.lastHash = snap.hash
      state.lastFiles = snap.files
      return managerStatus()
    state.needsPreparation = true
    candidate = acceptPrepared! kickPrepare!()
    throw new Error('release was superseded') unless candidate? and owner is state.operationOwner and epoch is state.sourceEpoch
    pool = spawnPool(candidate.artifact)
    state.bootingPool = pool
    awaitReady! pool, cfg.workers
    throw new Error('release was superseded') unless owner is state.operationOwner and epoch is state.sourceEpoch

    state.currentPool = pool
    state.doorbellPublished = false
    state.dirty = false
    version = bumpDesired()
    published = enqueue! -> putDesired! version
    throw new Error('release sockets were superseded') unless published and owner is state.operationOwner and epoch is state.sourceEpoch

    commitReleaseApp walk, appText
    state.prepared = null if state.prepared is candidate
    state.bootingPool = null if state.bootingPool is pool
    state.bootFailure = null
    state.prepareError = null
    dingEpoch! pool.n if cfg.watch
    state.operation = 'Active'
    snap = hashApp()
    state.lastHash = snap.hash
    state.lastFiles = snap.files
    retirePool oldPool if oldPool? and oldPool isnt pool
    managerStatus()
  catch e
    state.currentPool = oldPool
    state.doorbellPublished = false
    state.dirty = false
    state.files = filesBefore
    state.operation = 'Held'
    state.bootingPool = null if state.bootingPool is pool
    scrapPool pool if pool? and pool isnt oldPool
    state.prepared = null if state.prepared is candidate
    version = bumpDesired()
    enqueue! -> putDesired! version
    throw e

activateMigration = (record) ->
  state.operation = 'Maintenance'
  pool = null
  try
    pool = spawnPool(record.targetArtifact, true)
    state.bootingPool = pool
    awaitReady! pool, cfg.workers
    state.currentPool = pool
    state.doorbellPublished = false
    version = bumpDesired()
    writeOperation { ...record, phase: 'activating', outcome: record.outcome }
    published = await enqueue! -> putDesired! version
    throw new Error('migration activation sockets were superseded') unless published
    app = readAppCandidate record.appCandidate
    commitReleaseApp app, assembleBundleText!(app) if app?
    state.bootingPool = null
    state.bootFailure = null
    state.prepareError = null
    dingEpoch! state.sourceEpoch if cfg.watch
    state.operation = 'Active'
    clearOperation()
    snap = hashApp()
    changedDuring = snap.hash isnt record.sourceHash
    state.lastHash = snap.hash
    state.lastFiles = snap.files
    if changedDuring
      onFileChange().catch (e) -> warn "rip-server: post-migration App refresh failed: #{e?.message or e}"
      onContentChange()
    managerStatus()
  catch e
    state.currentPool = null
    state.bootingPool = null
    scrapPool pool if pool?
    state.operation = 'Maintenance'
    state.bootFailure = e?.message or String(e)
    version = bumpDesired()
    await enqueue! -> putDesired! version
    writeOperation { ...record, phase: 'maintenance', outcome: record.outcome, error: state.bootFailure }
    throw e

runCoordinatedMigration = (body = {}) ->
  throw new Error("cannot migrate while #{state.operation}") unless state.operation is 'Held'
  throw new Error('App-only projects have no API migration activation') unless cfg.entry?
  state.operation = 'Migrating'
  state.operationOwner += 1
  operationId = body.id or randomBytes(16).toString('hex')
  candidate = null
  record = null
  oldPool = state.currentPool
  try
    walk = readAppModules!()
    sourceHash = hashApp().hash
    candidate = acceptPrepared! kickPrepare!()
    throw new Error('migration preparation was superseded') unless candidate?
    target = durableCandidate candidate, operationId
    state.prepared = null if state.prepared is candidate
    try unlinkSync candidate.artifact
    apiDir = dirname(target.artifact)
    oldArtifact = if oldPool?.artifact? then durableCopy(oldPool.artifact, join(apiDir, "#{operationId}-old.js")) else null
    appCandidate = writeAppCandidate walk, operationId
    record =
      version: 1
      id: operationId
      phase: 'prepared'
      outcome: null
      sourceEpoch: state.sourceEpoch
      sourceHash: sourceHash
      oldArtifact: oldArtifact
      targetArtifact: target.artifact
      appCandidate: appCandidate
      migrationDir: body.dir or 'migrations'
      migrationEntry: body.entry or null
    writeOperation record

    state.operation = 'Maintenance'
    state.currentPool = null
    state.doorbellPublished = false
    version = bumpDesired()
    await enqueue! -> putDesired! version
    await retirePool(oldPool) if oldPool?
    record = { ...record, phase: 'migration-running', outcome: 'unknown' }
    writeOperation record
    report = runMigrationChild! body
    record = { ...record, phase: 'migration-finished', outcome: report.outcome, migration: report }
    writeOperation record

    if report.code isnt 0
      if report.outcome is 'confirmed-none' and oldArtifact?
        restored = spawnPool(oldArtifact, true)
        awaitReady! restored, cfg.workers
        state.currentPool = restored
        state.operation = 'Held'
        version = bumpDesired()
        await enqueue! -> putDesired! version
        clearOperation()
        return managerStatus()
      state.operation = 'Maintenance'
      state.bootFailure = report.error or report.output or 'migration failed'
      throw new Error(state.bootFailure)

    activateMigration! record
  catch e
    if state.operation is 'Migrating'
      state.operation = 'Held'
      clearOperation() if record? and record.phase is 'prepared'
    throw e

recoverMigration = (id) ->
  throw new Error("cannot recover while #{state.operation}") unless state.operation is 'Maintenance'
  record = readOperation!()
  throw new Error('no migration operation requires recovery') unless record?
  throw new Error("operation id mismatch: want #{record.id}") unless id is record.id
  record = { ...record, outcome: record.outcome or 'unknown', phase: 'fix-forward' }
  writeOperation record
  activateMigration! record

startManagerControl = ->
  runtime = managerRuntime(state.projectRoot)
  state.managerPath = runtime.path
  state.managerMetaPath = runtime.meta
  existing = probeManager!()
  return { existing } if existing?
  state.managerNonce = randomBytes(16).toString('hex')
  metadata = JSON.stringify({ nonce: state.managerNonce, pid: process.pid, root: state.projectRoot })
  acquired = false
  loop
    try
      fd = openSync state.managerMetaPath, 'wx', 0o600
      writeFileSync fd, metadata
      closeSync fd
      acquired = true
      break
    catch e
      throw e unless e?.code is 'EEXIST'
      # The owner writes metadata before binding. A racing second invocation
      # waits for Starting to become reachable instead of unlinking its claim.
      owner = try JSON.parse(readFileSync(state.managerMetaPath, 'utf8')) catch then null
      alive = false
      try
        process.kill owner.pid, 0
        alive = true
      if alive
        deadline = Date.now() + 2000
        while Date.now() < deadline
          existing = probeManager!()
          return { existing } if existing?
          sleep! 25
        throw new Error("rip-server: manager owner #{owner.pid} holds #{state.managerMetaPath} but its control socket is unreachable")
      try unlinkSync state.managerMetaPath
  try
    # A dead process can leave only the socket inode after its claim is gone.
    try unlinkSync state.managerPath
    state.managerServer = Bun.serve
      unix: state.managerPath
      fetch: (req) ->
        url = new URL(req.url)
        if req.method is 'GET' and url.pathname is '/status'
          return Response.json managerStatus()
        if req.method is 'POST' and url.pathname is '/hold'
          try return Response.json(enterHold!()) catch e then return Response.json({ error: e?.message or String(e) }, { status: 409 })
        if req.method is 'POST' and url.pathname is '/release'
          try return Response.json(releaseHold!()) catch e then return Response.json({ error: e?.message or String(e) }, { status: 409 })
        if req.method is 'POST' and url.pathname is '/migrate'
          body = try req.json! catch then {}
          id = body.id
          unless typeof id is 'string' and /^[a-f0-9]{32}$/.test(id)
            return Response.json({ error: 'migrate requires a 32-hex mutation id' }, { status: 400 })
          return Response.json(state.migrationResults[id]) if state.migrationResults[id]?
          unless state.migrationPromise?
            state.migrationPromise = do ->
              try
                result = runCoordinatedMigration! body
                state.migrationResults[id] = result
                result
              finally
                state.migrationPromise = null
          try return Response.json(await state.migrationPromise) catch e then return Response.json({ error: e?.message or String(e), status: managerStatus() }, { status: 409 })
        if req.method is 'POST' and url.pathname is '/recover'
          body = try req.json! catch then {}
          try return Response.json(recoverMigration!(body.id)) catch e then return Response.json({ error: e?.message or String(e), status: managerStatus() }, { status: 409 })
        new Response('Not Found', { status: 404 })
  catch e
    try unlinkSync state.managerMetaPath if acquired
    throw e
  process.on 'exit', cleanupManagerIdentity
  { existing: null }

printManagerStatus = (status) ->
  managerPrint! "#{status.name or basename(status.root)}: #{status.lifecycle} / #{status.operation} / #{status.admission} (#{status.workers?.ready or 0} ready)"

# Signal listeners receive the signal name as the first argument; a direct
# call carries none and logs as a plain shutdown.
shutdown = (reason, status = null) ->
  return if state.shuttingDown
  state.shuttingDown = true
  state.signalStatus ?= status
  state.lifecycle = 'Stopping'
  state.cutToken += 1
  try managerPrint! "rip-server: #{reason or 'shutdown'} — deregistering #{cfg.name} (#{state.appId}), draining workers"
  try state.watcher?.close()
  clearTimeout state.settleTimer if state.settleTimer?
  clearInterval state.watchPoll if state.watchPoll?
  clearInterval state.hbTimer if state.hbTimer?
  try await state.accessClient?.stop()
  try state.preparation?.proc.kill('SIGTERM')
  try unlinkSync state.prepared.artifact if state.prepared?.artifact?
  pools = [state.currentPool, state.bootingPool].filter((pool, i, all) -> pool? and all.indexOf(pool) is i)
  state.currentPool = null
  state.bootingPool = null
  version = bumpDesired()
  enqueue! -> putDesired! version    # bare empty list: down on purpose
  await Promise.all pools.map((pool) -> retirePool(pool))
  enqueue! -> deleteApp!()
  try state.bell?.stop(true)
  try rmSync state.runDir, { recursive: true, force: true }
  cleanupManagerIdentity()
  exit state.signalStatus ?? 0

installSignals = ->
  count = 0
  forcing = false
  force = (signal, status) ->
    return if forcing
    forcing = true
    for child in state.managedChildren
      proc: any = child
      try proc.kill(signal)
    exit status
  handle = (signal) ->
    count += 1
    number = if signal is 'SIGINT' then 2 else 15
    if count > 1
      force signal, 128 + number
      return
    shutdown! signal, 128 + number
  process.on 'SIGINT', handle
  process.on 'SIGTERM', handle

setControlTarget = (target) ->
  state.controlUnix = null
  state.controlBase = null
  if target.startsWith('http://') or target.startsWith('https://')
    state.controlBase = target.replace(/\/+$/, '')
  else
    state.controlUnix = resolve(target)

probeControl = (target) ->
  try
    cfetch! 'GET', '/1.0'
  catch e
    abort "rip-server: control endpoint unreachable at #{target}: #{e?.message or e}"

defaultBrowseHost = ->
  "browse-#{randomBytes(6).toString('hex')}.localhost"

runBrowse = (args) ->
  abort 'rip-server: browse requires exactly one directory' unless args.entry?
  directory = resolve(args.entry)
  abort "rip-server: browse directory not found: #{args.entry}" unless existsSync(directory)
  abort "rip-server: browse path is not a directory: #{args.entry}" unless statSync(directory).isDirectory()
  directory = realpathSync(directory)
  abort "rip-server: browse accepts at most one --host" if args.hosts.length > 1
  explicitHost = args.hosts[0] ?? null
  abort "rip-server: browse host is not valid: #{explicitHost}" if explicitHost? and not validHost(explicitHost)
  abort "rip-server: no control endpoint — pass --control <unix-path-or-url> or set JANUS_CONTROL" unless args.control?

  setControlTarget args.control
  probeControl! args.control

  attempts = 0
  host = explicitHost or defaultBrowseHost()
  earlySignalStatus = null
  earlySignalCount = 0
  earlyStop = (signal) ->
    earlySignalCount += 1
    number = if signal is 'SIGINT' then 2 else 15
    exit(128 + number) if earlySignalCount > 1
    earlySignalStatus = 128 + number
  process.on 'SIGINT', earlyStop
  process.on 'SIGTERM', earlyStop
  bodyFor = (selectedHost) ->
    name: 'browse'
    hosts: [selectedHost]
    upstreams: []
    lease: if args.untilRestart then 'process' else 'heartbeat'
    files:
      roots: [{ path: directory, cache: 'revalidate', browse: true }]
      proxy_first: []

  registration = null
  loop
    attempts += 1
    res = cfetch! 'POST', '/1.0/apps', bodyFor(host)
    if res.status is 201
      registration = res.json!()
      abort 'rip-server: control returned no app id' unless registration?.id?
      break
    if earlySignalStatus?
      process.off 'SIGINT', earlyStop
      process.off 'SIGTERM', earlyStop
      exit earlySignalStatus
    if res.status is 409 and not explicitHost? and attempts <= 5
      host = defaultBrowseHost()
      continue
    detail = try res.text! catch then ''
    if res.status is 409
      abort "rip-server: browse host already claimed at the control plane (409): #{host}"
    abort "rip-server: browse registration failed (#{res.status})#{if detail then ": #{detail}" else ''}"

  url = "https://#{host}/"
  access = null
  timer = null
  stopping = false
  signalStatus = null
  signalCount = 0
  browseGeneration = 1
  operation = Promise.resolve()
  finishTask = null
  queueBrowse = (fn) ->
    next = operation.then fn
    operation = next.catch(-> null)
    next
  finish = (status) ->
    return finishTask if finishTask?
    stopping = true
    browseGeneration += 1
    clearInterval timer if timer?
    finishTask = do ->
      try await access?.stop()
      try await operation
      try await cfetch 'DELETE', "/1.0/apps/#{registration.id}"
      exit signalStatus ?? status
    finishTask
  stop = (signal) ->
    signalCount += 1
    number = if signal is 'SIGINT' then 2 else 15
    exit(128 + number) if signalCount > 1
    signalStatus = 128 + number
    finish signalStatus
  process.on 'SIGINT', stop
  process.on 'SIGTERM', stop
  process.off 'SIGINT', earlyStop
  process.off 'SIGTERM', earlyStop
  if earlySignalStatus?
    signalStatus = earlySignalStatus
    finish! signalStatus
    return
  printBrowse = (text) ->
    return if stopping
    managerPrint! text
  try
    if args.untilRestart
      printBrowse! "id: #{registration.id}"
      printBrowse! "url: #{url}"
      printBrowse! "delete: DELETE /1.0/apps/#{registration.id} on #{args.control}"
    else
      printBrowse! url
  catch e
    try warn "rip-server: browse output failure: #{e?.message or e}"
    finish! 1
    return
  if stopping
    await finishTask
    return
  if args.untilRestart
    process.off 'SIGINT', stop
    process.off 'SIGTERM', stop
    return
  terminalAccess = (e) ->
    try warn "rip-server: terminal access output failure: #{e?.message or e}"
    finish! 1
  startAccess = (appId) ->
    access.move(appId).catch terminalAccess
  unless args.accessMode is 'off'
    access = new AccessClient
      mode: args.accessMode
      picture: args.accessPicture
      control: accessControl()
    startAccess registration.id
  beat = (generation) ->
    return if stopping or generation isnt browseGeneration
    try
      res = cfetch! 'POST', "/1.0/apps/#{registration.id}/heartbeat"
      return if stopping or generation isnt browseGeneration
      if res.status is 404
        warn 'rip-server: browse heartbeat 404 — re-registering'
        fresh = cfetch! 'POST', '/1.0/apps', bodyFor(host)
        if fresh.status isnt 201
          return if stopping or generation isnt browseGeneration
          warn "rip-server: browse re-registration failed (#{fresh.status})"
          return
        replacement = fresh.json!()
        abort 'rip-server: control returned no app id' unless replacement?.id?
        registration = replacement
        return if stopping or generation isnt browseGeneration
        startAccess(registration.id) if access?
      else
        warn "rip-server: browse heartbeat failed (#{res.status})" unless res.status is 204
    catch e
      warn "rip-server: browse heartbeat unreachable: #{e?.message or e}"
  timer = setInterval (-> queueBrowse -> beat! browseGeneration), HEARTBEAT_MS
  await new Promise(->)

parseArgs = (argv) ->
  command = if ['browse', 'status', 'hold', 'release', 'migrate', 'recover'].includes(argv[0]) then argv[0] else 'start'
  args = { command, entry: null, migrationEntry: null, migrationDir: 'migrations', operationId: null, mutationId: null, name: null, hosts: [], workers: 2, concurrency: 1, watch: null, allowWatch: false, eager: false, control: process.env.JANUS_CONTROL or null, untilRestart: false, accessMode: 'pretty', accessPicture: null, accessExplicit: false, startupFlags: [] }
  i = if command is 'start' then 0 else 1
  while i < argv.length
    a = argv[i]
    nextValue = ->
      i += 1
      abort "rip-server: #{a} requires a value" if i >= argv.length
      argv[i]
    switch a
      when '--name'
        abort 'rip-server: --name does not apply to browse' if command is 'browse'
        args.startupFlags.push a
        args.name = nextValue()
      when '--host'
        args.startupFlags.push a
        args.hosts.push nextValue()
      when '--workers', '-w'
        abort "rip-server: #{a} does not apply to browse" if command is 'browse'
        args.startupFlags.push a
        args.workers = parseInt(nextValue())
        abort "rip-server: --workers takes a positive integer" unless Number.isFinite(args.workers) and args.workers >= 1
      when '--concurrency', '-c'
        abort "rip-server: #{a} does not apply to browse" if command is 'browse'
        args.startupFlags.push a
        raw = nextValue()
        args.concurrency = parseInt(raw)
        abort "rip-server: --concurrency takes an integer >= 1, got #{raw}" unless Number.isFinite(args.concurrency) and args.concurrency >= 1 and String(args.concurrency) is raw
      when '--watch'
        abort 'rip-server: --watch does not apply to browse' if command is 'browse'
        args.startupFlags.push a
        args.watch = true
      when '--no-watch'
        abort 'rip-server: --no-watch does not apply to browse' if command is 'browse'
        args.startupFlags.push a
        args.watch = false
      when '--allow-watch'
        abort 'rip-server: --allow-watch does not apply to browse' if command is 'browse'
        args.startupFlags.push a
        args.allowWatch = true
      when '--eager'
        abort 'rip-server: --eager does not apply to browse' if command is 'browse'
        args.startupFlags.push a
        args.eager = true
      when '--control'
        args.startupFlags.push a
        args.control = nextValue()
      when '--until-restart'
        abort 'rip-server: --until-restart only applies to browse' unless command is 'browse'
        args.untilRestart = true
      when '--access-format'
        abort 'rip-server: --access-format requires a picture' if i + 1 >= argv.length
        args.accessExplicit = true
        args.accessPicture = nextValue()
      when '--dir'
        abort 'rip-server: --dir only applies to migrate' unless command is 'migrate'
        args.migrationDir = nextValue()
      when '--id'
        abort 'rip-server: --id only applies to migrate' unless command is 'migrate'
        args.mutationId = nextValue()
        abort 'rip-server: --id requires 32 lowercase hex characters' unless /^[a-f0-9]{32}$/.test(args.mutationId)
      when '--help', '-h'
        p USAGE
        exit 0
      else
        if a.startsWith('--access-log=')
          args.accessExplicit = true
          args.accessMode = a.slice('--access-log='.length)
          abort "rip-server: --access-log must be pretty, raw, or off" unless args.accessMode in ['pretty', 'raw', 'off']
        else
          abort "rip-server: unknown option #{a}\n\n#{USAGE}" if a.startsWith('-')
        if not a.startsWith('-') and command is 'migrate'
          abort "rip-server: multiple migration entries (#{args.migrationEntry} and #{a})" if args.migrationEntry?
          args.migrationEntry = a
        else if not a.startsWith('-') and command is 'recover'
          abort "rip-server: recover takes one operation id" if args.operationId?
          args.operationId = a
        else if not a.startsWith('-') and command is 'browse'
          abort "rip-server: browse takes one directory" if args.entry?
          args.entry = a
        else if not a.startsWith('-')
          abort "rip-server: multiple app entries (#{args.entry} and #{a})" if args.entry?
          args.entry = a
    i += 1
  abort 'rip-server: --access-format only applies with --access-log=pretty' if args.accessPicture? and args.accessMode isnt 'pretty'
  abort 'rip-server: explicit access flags conflict with browse --until-restart' if args.untilRestart and args.accessExplicit
  abort "rip-server: access flags do not apply to #{command}" if args.accessExplicit and command not in ['start', 'browse']
  try
    parseAccessPicture(args.accessPicture) if args.accessPicture?
  catch e
    abort "rip-server: #{e?.message or e}"
  args

resolveProject = (given) ->
  if given?
    full = resolve(given)
    abort "rip-server: app entry not found: #{given}" unless existsSync(full)
    if statSync(full).isDirectory()
      for cand in ['app.rip', 'index.rip']
        inner = join(full, cand)
        return { root: realpathSync(full), entry: realpathSync(inner) } if existsSync(inner)
      return { root: realpathSync(full), entry: null } if existsSync(join(full, 'app'))
      abort "rip-server: #{given} has no app.rip, index.rip, or app/ directory"
    entry = realpathSync(full)
    return { root: realpathSync(dirname(entry)), entry }
  at = realpathSync(process.cwd())
  loop
    for cand in ['app.rip', 'index.rip']
      full = join(at, cand)
      return { root: at, entry: realpathSync(full) } if existsSync(full)
    return { root: at, entry: null } if existsSync(join(at, 'app'))
    parent = dirname(at)
    break if parent is at
    at = parent
  abort "rip-server: no App — pass a project, or create app.rip, index.rip, or app/ here or above"

export main = (argv) ->
  args = parseArgs(argv)
  cfg.accessMode = args.accessMode
  cfg.accessPicture = args.accessPicture

  if args.command is 'browse'
    runBrowse! args
    return

  project = resolveProject(if args.command is 'migrate' or args.command is 'recover' then null else args.entry)
  cfg.entry = project.entry
  cfg.appDir = project.root
  state.projectRoot = project.root
  state.operationPath = join(state.projectRoot, '.rip', 'server-operation.json')
  pendingOperation = readOperation!()
  if pendingOperation?
    state.migration = pendingOperation
    state.operation = 'Maintenance'
  if args.command isnt 'start'
    abort "rip-server: #{args.command} does not accept startup options: #{args.startupFlags.join(', ')}" if args.startupFlags.length
    runtime = managerRuntime(state.projectRoot)
    state.managerPath = runtime.path
    state.managerMetaPath = runtime.meta
    status = probeManager!()
    abort "rip-server: no manager is running for #{state.projectRoot}" unless status?
    if args.command isnt 'status'
      body = null
      if args.command is 'migrate'
        entry = if args.migrationEntry? then realpathSync(resolve(args.migrationEntry)) else null
        body = { id: args.mutationId or randomBytes(16).toString('hex'), entry, dir: resolve(args.migrationDir) }
      else if args.command is 'recover'
        abort 'rip-server: recover requires an operation id' unless args.operationId?
        body = { id: args.operationId }
      res = managerRequest! "/#{args.command}", 'POST', body
      body = res.json!()
      abort "rip-server: #{args.command} failed: #{body?.error or "HTTP #{res.status}"}" unless res.ok
      status = body
    printManagerStatus status
    return

  ownership = startManagerControl!()
  if ownership.existing?
    abort "rip-server: manager already running; startup options cannot be applied: #{args.startupFlags.join(', ')}" if args.startupFlags.length
    printManagerStatus ownership.existing
    return

  serve: any = null
  try
    serve = loadServeConfig! cfg.appDir
  catch e
    abort e?.message or String(e)
  cfg.name = args.name or serve?.name or basename(cfg.appDir)
  cfg.site = serve?.site ?? null
  cfg.files = serve?.files ?? null
  if cfg.files? and not cfg.files.shell? and cfg.entry?
    abort 'rip-server: shell-less browse policy cannot publish API upstreams'
  cfg.workers = args.workers
  cfg.concurrency = args.concurrency
  cfg.eager = args.eager
  cfg.control = args.control
  if cfg.site? and args.hosts.length > 0
    abort "rip-server: --host conflicts with serve.rip sites"
  if cfg.site?
    cfg.hosts = []
  else if args.hosts.length > 0
    cfg.hosts = args.hosts
  else if serve?.hosts?
    cfg.hosts = serve.hosts
  else
    cfg.hosts = [cfg.name]
    managerPrint! "rip-server: no --host given; claiming #{cfg.hosts[0]}"

  prod = process.env.RIP_ENV is 'production'
  cfg.watch = args.watch ?? (not prod)
  if cfg.watch and prod
    abort "rip-server: watch in production requires --allow-watch" unless args.allowWatch
    warn "rip-server: WATCH ENABLED IN PRODUCTION — saves cut admission and retire live pools"
  # c > 1 and hot reload do not mix: retiring a pool must drain up to c
  # in-flight requests per worker, and the protocol pins "raise only with
  # watch off". Eager rides the watcher, so it counts as watch here.
  if cfg.entry? and cfg.concurrency > 1 and (cfg.watch or cfg.eager)
    abort "rip-server: -c #{cfg.concurrency} requires watch off — raise c only with watch off (use --no-watch, or RIP_ENV=production)"
  state.readyWhen = if prod then cfg.workers else 1

  abort "rip-server: no control endpoint — pass --control <unix-path-or-url> or set JANUS_CONTROL" unless args.control?
  setControlTarget args.control
  probeControl! args.control        # any HTTP answer proves reachability
  unless cfg.accessMode is 'off'
    state.accessClient = new AccessClient
      mode: cfg.accessMode
      picture: cfg.accessPicture
      control: accessControl()

  state.runDir = mkdtempSync(join(tmpdir(), 'rip-srv-'))
  state.generatedDir = join(cfg.appDir, 'static', 'generated')
  state.manifestPath = join(state.generatedDir, 'manifest.json')
  try
    mkdirSync state.generatedDir, { recursive: true, mode: 0o755 }
    invalidServe "generated root is not a directory: #{state.generatedDir}" unless statSync(state.generatedDir).isDirectory()
  catch e
    abort "rip-server: generated root is not writable at #{state.generatedDir}: #{e?.message or e}"

  # The worker runtime is fixed code — prebuild it to plain JS once, here,
  # so workers spawn with no loader and no compiler. Failing to build our
  # own runtime is a toolchain defect, not an app error: abort.
  if cfg.entry?
    try
      state.workerJs = buildArtifact! workerPath, join(state.runDir, 'worker.js')
    catch e
      abort "rip-server: cannot build the worker runtime: #{e?.message or e}"

  # An app with an app/ dir serves the browser runtime from the run
  # tmpdir — copied once per manager start. A missing runtime file is a
  # toolchain defect, not an app error: abort.
  if existsSync(join(cfg.appDir, 'app')) and state.operation isnt 'Maintenance'
    runtimeSrc = join(loaderSrcDir(), '..', 'dist', 'browser', 'rip.js')
    abort "rip-server: browser runtime missing at #{runtimeSrc} — an app/ dir requires dist/browser/rip.js" unless existsSync(runtimeSrc)
    state.browserRuntime = join(state.generatedDir, '@rip', 'rip.js')
    mkdirSync dirname(state.browserRuntime), { recursive: true }
    Bun.write! state.browserRuntime, Bun.file(runtimeSrc)

  configureEdgeFiles()

  if state.operation isnt 'Maintenance'
    try
      buildClientPublication!()
    catch e
      abort "rip-server: cannot publish the client App: #{e?.message or e}"

  startDoorbell() if cfg.entry? and state.operation is 'Active'
  if cfg.watch and cfg.entry? and state.operation is 'Active'
    state.doorbellPublished = true
    state.dirty = true
    bumpDesired()

  registerApp!()
  # Registration is already atomic with the desired doorbell. Republish the
  # same desired state through the serialized updater so a recovered or
  # older control plane converges through the ordinary update path too.
  state.doorbellPublished = false if cfg.watch and cfg.entry?
  enqueue heartbeatOnce            # heartbeats start immediately, before any worker
  state.hbTimer = setInterval (-> enqueue heartbeatOnce), HEARTBEAT_MS

  installSignals()

  if state.operation is 'Maintenance'
    startWatcher() if cfg.watch
    state.lifecycle = 'Running'
    state.bootFailure = state.migration?.error or 'migration recovery required'
    warn "rip-server: unresolved migration #{state.migration?.id or 'unknown'} — Maintenance, API admission is empty; use `rip server recover #{state.migration?.id or '<operation-id>'}` after fixing forward"
    return

  unless cfg.entry?
    cfg.workers = 0
    startWatcher() if cfg.watch
    state.lifecycle = 'Running'
    managerPrintOwned! "rip-server: #{cfg.name} registered (#{state.appId}) — App-only, watch #{if cfg.watch then 'on' else 'off'}"
    startupReport!()
    return

  if cfg.watch
    startWatcher()
    # Doorbell first: requests arriving mid-boot ring and hold, as in reload.
    state.needsPreparation = true
    cutAdmission()
    managerPrintOwned! "rip-server: #{cfg.name} registered (#{state.appId}) — #{cfg.workers} worker(s), watch on#{if cfg.eager then ', eager' else ''}"
    booted = do ->
      prepareLatest! false
      kickBoot!()
    # A startup boot failure is cached and already warned; the doorbell stays.
    reported = booted.then((->
      state.lifecycle = 'Running'
      startupReport!()
    ), (-> null))
    reported.catch (e) -> warn "rip-server: startup report failed: #{e?.message or e}"
  else
    state.needsPreparation = true
    state.dirty = true
    managerPrintOwned! "rip-server: #{cfg.name} registered (#{state.appId}) — #{cfg.workers} worker(s), watch off"
    try
      prepareLatest! false
      kickBoot!()
    catch e
      return if state.shuttingDown
      warn "rip-server: startup boot failed: #{state.bootFailure or e?.message or e}"
      exit 1
    state.lifecycle = 'Running'
    startupReport!()
