import { readFileSync, writeFileSync, renameSync, unlinkSync } from 'node:fs'
import { basename, dirname, join, resolve } from 'node:path'

preload = process.execArgv.find((arg) -> arg.startsWith('--preload='))?.slice('--preload='.length)
abort 'rip-server generate: the Rip loader is missing' unless preload?
compiler = import!(join(dirname(resolve(preload)), 'compile.js')).compile

rewriteMeta = (code, path) ->
  return code unless code.includes 'import.meta'
  dir = dirname path
  transpiler = new Bun.Transpiler
    loader: 'js'
    define:
      'import.meta.url': JSON.stringify(Bun.pathToFileURL(path).href)
      'import.meta.path': JSON.stringify(path)
      'import.meta.filename': JSON.stringify(path)
      'import.meta.dir': JSON.stringify(dir)
      'import.meta.dirname': JSON.stringify(dir)
      'import.meta.file': JSON.stringify(basename(path))
  transpiler.transformSync code

inventory = {}
record = (path, bytes) ->
  inventory[path] = new Bun.CryptoHasher('sha256').update(bytes).digest('hex')

plugin =
  name: 'rip'
  setup: (build) ->
    build.onLoad { filter: /\.rip$/ }, (args) ->
      bytes = readFileSync args.path
      record args.path, bytes
      { code } = compiler(bytes.toString('utf8'), { path: args.path, runtimeDelivery: 'import' })
      { contents: rewriteMeta(code, args.path), loader: 'js' }
    build.onLoad { filter: /\.[mc]?js$/ }, (args) ->
      bytes = readFileSync args.path
      record args.path, bytes
      source = bytes.toString 'utf8'
      { contents: (if source.includes('import.meta') then rewriteMeta(source, args.path) else source), loader: 'js' }
    build.onLoad { filter: /.*/, namespace: 'file' }, (args) ->
      record args.path, readFileSync(args.path)
      return
    return

buildArtifact = (entry, artifact) ->
  result = Bun.build!
    entrypoints: [entry]
    target: 'bun'
    format: 'esm'
    sourcemap: 'none'
    throw: false
    plugins: [plugin]
  unless result.success
    throw new Error result.logs.map((log) -> log?.message or String(log)).join('\n')
  Bun.write! artifact, result.outputs[0].text!

[entry, artifact, resultPath, taskId, epochText] = process.argv.slice 2
unless entry? and artifact? and resultPath? and taskId? and epochText?
  abort 'rip-server generate: want <entry> <artifact> <result> <task-id> <source-epoch>'

sourceEpoch = parseInt epochText
abort "rip-server generate: invalid source epoch #{epochText}" unless Number.isFinite(sourceEpoch) and sourceEpoch >= 0

try
  buildArtifact! entry, artifact

  inputs = []
  for path, expected of inventory
    actual = new Bun.CryptoHasher('sha256').update(readFileSync(path)).digest('hex')
    throw new Error("input changed during generation: #{path}") unless actual is expected
    inputs.push path
  inputs.sort()

  tmp = "#{resultPath}.tmp"
  writeFileSync tmp, JSON.stringify({ taskId, sourceEpoch, artifact, inputs })
  renameSync tmp, resultPath
catch error
  try unlinkSync artifact
  warn error?.message or String(error)
  exit 1
