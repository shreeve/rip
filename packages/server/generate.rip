# ==============================================================================
# @rip-lang/server — short-lived compile-only API generation
#
# Builds one loader-free artifact without importing it. The result file is the
# sole success signal consumed by the manager; stderr carries diagnostics.
# ==============================================================================

import { readFileSync, writeFileSync, renameSync, unlinkSync } from 'node:fs'
import { buildArtifact } from './manager.rip'

[entry, artifact, resultPath, taskId, epochText] = process.argv.slice(2)
unless entry? and artifact? and resultPath? and taskId? and epochText?
  abort 'rip-server generate: want <entry> <artifact> <result> <task-id> <source-epoch>'

sourceEpoch = parseInt(epochText)
abort "rip-server generate: invalid source epoch #{epochText}" unless Number.isFinite(sourceEpoch) and sourceEpoch >= 0

digestBytes = (bytes) -> new Bun.CryptoHasher('sha256').update(bytes).digest('hex')

inventory = {}
try
  buildArtifact! entry, artifact, { inventory }

  # The build plugin records the exact bytes it consumed. Re-read before
  # success so a save during Bun.build rejects this candidate instead of
  # blessing a hybrid generation.
  inputs = []
  for path of inventory
    actual = digestBytes readFileSync(path)
    expected = inventory[path]
    throw new Error("input changed during generation: #{path}") unless actual is expected
    inputs.push { path, hash: expected }
  inputs.sort (a, b) -> if a.path < b.path then -1 else if a.path > b.path then 1 else 0

  whole = new Bun.CryptoHasher('sha256')
  for input in inputs
    whole.update input.path
    whole.update '\0'
    whole.update input.hash
    whole.update '\0'
  inputDigest = whole.digest('hex')

  tmp = "#{resultPath}.tmp"
  writeFileSync tmp, JSON.stringify({ taskId, sourceEpoch, artifact, inputDigest, inputs })
  renameSync tmp, resultPath
catch e
  try unlinkSync artifact
  warn e?.message or String(e)
  exit 1
