import { closeSync, copyFileSync, existsSync, fsyncSync, mkdirSync, mkdtempSync, openSync, readFileSync, realpathSync, readdirSync, renameSync, rmSync, statSync, unlinkSync, watch, writeFileSync } from 'node:fs'
import { basename, dirname, join, resolve } from 'node:path'
import { tmpdir } from 'node:os'
import { randomBytes } from 'node:crypto'
import { rash } from '@rip-lang/app/rash'

HEARTBEAT_MS = 5000
readyText = process.env.RIP_BOOT_DEADLINE_MS or '30000'
READY_MS = parseInt readyText
abort 'rip-server: RIP_BOOT_DEADLINE_MS must be an integer greater than zero' unless Number.isFinite(READY_MS) and READY_MS > 0 and String(READY_MS) is readyText

parseArgs = (argv) ->
  command = if ['status', 'hold', 'release', 'migrate', 'recover'].includes(argv[0]) then argv[0] else 'start'
  args = { command, entry: null, migrationEntry: null, migrationDir: 'migrations', operationId: null, name: null, host: null, control: process.env.JANUS_CONTROL or null, workers: 1, concurrency: 1, watch: false }
  i = if command is 'start' then 0 else 1
  while i < argv.length
    value = argv[i]
    take = ->
      i++
      abort "rip-server: #{value} requires a value" if i >= argv.length
      argv[i]
    switch value
      when '--name' then args.name = take()
      when '--host' then args.host = take()
      when '--control' then args.control = take()
      when '--watch' then args.watch = true
      when '--no-watch' then args.watch = false
      when '--dir'
        abort 'rip-server: --dir only applies to migrate' unless command is 'migrate'
        args.migrationDir = take()
      when '--id'
        abort 'rip-server: --id only applies to migrate' unless command is 'migrate'
        args.operationId = take()
        abort 'rip-server: --id requires exactly 32 lowercase hex characters' unless /^[a-f0-9]{32}$/.test(args.operationId)
      when '--workers', '-w'
        text = take()
        args.workers = parseInt text
        abort 'rip-server: --workers must be an integer greater than zero' unless Number.isFinite(args.workers) and args.workers > 0 and String(args.workers) is text
      when '--concurrency', '-c'
        text = take()
        args.concurrency = parseInt text
        abort 'rip-server: --concurrency must be an integer greater than zero' unless Number.isFinite(args.concurrency) and args.concurrency > 0 and String(args.concurrency) is text
      when '--help', '-h'
        p 'usage: rip server <entry> [options] | rip server migrate [migration-entry] [--dir DIR] [--id 32hex] | rip server recover <operation-id>'
        exit 0
      else
        abort "rip-server: unknown option #{value}" if value.startsWith '-'
        if command is 'migrate'
          abort "rip-server: multiple migration entries (#{args.migrationEntry} and #{value})" if args.migrationEntry?
          args.migrationEntry = value
        else if command is 'recover'
          abort 'rip-server: recover takes exactly one operation id' if args.operationId?
          args.operationId = value
        else
          abort "rip-server: multiple app entries (#{args.entry} and #{value})" if args.entry?
          args.entry = value
    i++
  abort 'rip-server: recover requires an operation id' if command is 'recover' and not args.operationId?
  abort 'rip-server: recover operation id must be exactly 32 lowercase hex characters' if command is 'recover' and not /^[a-f0-9]{32}$/.test(args.operationId)
  args.entry ?= '.' unless command is 'migrate' or command is 'recover'
  abort 'rip-server: --control or JANUS_CONTROL is required' if command is 'start' and not args.control?
  args.entry = resolve args.entry if args.entry?
  args.name ?= basename(args.entry or process.cwd()).replace(/\.[^.]+$/, '')
  args.host ?= args.name
  args

controlFetch = (target, method, path, body = null) ->
  options = { method }
  if body?
    options.body = JSON.stringify body
    options.headers = { 'content-type': 'application/json' }
  if target.startsWith('http://') or target.startsWith('https://')
    fetch "#{target}#{path}", options
  else
    options.unix = target
    fetch "http://janus#{path}", options

loaderDir = ->
  preload = process.execArgv.find (arg) -> arg.startsWith '--preload='
  abort 'rip-server: the Rip loader is missing' unless preload?
  dirname resolve(preload.slice('--preload='.length))

generate = (entry, artifact, reportPath, taskId) ->
  preload = "--preload=#{join(loaderDir(), 'loader.js')}"
  proc = Bun.spawn [process.execPath, preload, join(import.meta.dir, 'generate.rip'), entry, artifact, reportPath, taskId, '0'],
    stdin: 'ignore'
    stdout: 'ignore'
    stderr: 'pipe'
  stderrText = new Response(proc.stderr).text()
  code = await proc.exited
  diagnostic = await stderrText
  throw new Error(diagnostic.trim() or "generation #{taskId} exited #{code}") unless code is 0
  JSON.parse readFileSync(reportPath, 'utf8')

resolveProject = (input) ->
  given = resolve input
  abort "rip-server: project not found: #{input}" unless existsSync given
  path = realpathSync given
  if statSync(path).isDirectory()
    entry = null
    for name in ['app.rip', 'index.rip']
      candidate = join path, name
      if existsSync candidate
        entry = candidate
        break
    appRoot = join path, 'app'
    abort "rip-server: #{input} has no API entry or app/ directory" unless entry? or existsSync(appRoot)
    return { root: path, entry, appRoot: (if existsSync(appRoot) then appRoot else null) }
  { root: dirname(path), entry: path, appRoot: (if existsSync(join(dirname(path), 'app')) then join(dirname(path), 'app') else null) }

fsyncDirectory = (path) ->
  fd = openSync path, 'r'
  try
    fsyncSync fd
  finally
    closeSync fd

durableWrite = (path, bytes) ->
  fd = openSync path, 'w', 0o600
  try
    writeFileSync fd, bytes
    fsyncSync fd
  finally
    closeSync fd

writeOperation = (path, record) ->
  directory = dirname path
  existed = existsSync directory
  mkdirSync directory, { recursive: true, mode: 0o700 }
  temporary = "#{path}.tmp"
  durableWrite temporary, JSON.stringify(record)
  renameSync temporary, path
  fsyncDirectory directory
  fsyncDirectory dirname(directory) unless existed
  record

clearOperation = (path) ->
  unlinkSync path
  fsyncDirectory dirname(path)

readOperation = (path) ->
  return null unless existsSync path
  record = null
  try
    record = JSON.parse readFileSync(path, 'utf8')
  catch error
    abort "rip-server: malformed operation journal at #{path}: #{String(error)}"
  valid = record? and typeof record is 'object' and not Array.isArray(record) and record.version is 1 and /^[a-f0-9]{32}$/.test(record.id or '') and typeof record.phase is 'string' and typeof record.targetArtifact is 'string'
  abort "rip-server: malformed operation journal at #{path}" unless valid
  record

writeAtomic = (path, text) ->
  current = if existsSync(path) then readFileSync(path, 'utf8') else null
  return false if current is text
  tmp = "#{path}.tmp"
  writeFileSync tmp, text
  renameSync tmp, path
  true

escapeHtml = (value) ->
  String(value).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;')

appModules = (appRoot) ->
  modules = {}
  moduleFiles = {}
  entries = []
  walk = (directory, prefix) ->
    for entry in readdirSync(directory, { withFileTypes: true })
      continue if entry.name.startsWith '.'
      path = join directory, entry.name
      if entry.isDirectory()
        walk path, "#{prefix}#{entry.name}/"
      else if entry.name.endsWith('.rip') or entry.name.endsWith('.css') or entry.name.endsWith('.html')
        id = "#{prefix}#{entry.name}"
        bytes = readFileSync path
        entries.push { id, hash: rash(bytes) }
        if entry.name.endsWith '.rip'
          modules[id] = bytes.toString 'utf8'
          moduleFiles[id] = path
  walk appRoot, 'app/'
  entries.sort (a, b) -> if a.id < b.id then -1 else if a.id > b.id then 1 else 0
  inventory = JSON.stringify entries.map (entry) -> [entry.id, entry.hash]
  { modules, moduleFiles, entries, rash: rash(new TextEncoder().encode(inventory)) }

sourceRashes = (paths) ->
  paths.map (path) -> { path, hash: (if existsSync(path) then rash(readFileSync(path)) else null) }

buildAppDocuments = (project, includeManifest) ->
  { assembleBundle } = import!(join(loaderDir(), 'bundle.js'))
  graph = appModules project.appRoot
  bundle = assembleBundle
    modules: graph.modules
    moduleFiles: graph.moduleFiles
    appDir: project.root
    packagesDir: join(loaderDir(), '..', 'packages')
  bundle.files = graph.entries
  bundle.rash = graph.rash
  {
    graph
    bundle: JSON.stringify(bundle)
    manifest: (if includeManifest then JSON.stringify({ rash: graph.rash, files: graph.entries }) else null)
  }

commitAppDocuments = (project, documents) ->
  generated = join project.root, 'static', 'generated'
  mkdirSync generated, { recursive: true }
  writeAtomic join(generated, 'bundle.json'), documents.bundle
  writeAtomic join(generated, 'manifest.json'), documents.manifest if documents.manifest?

writeAppDocuments = (project, includeManifest) ->
  documents = buildAppDocuments! project, includeManifest
  commitAppDocuments project, documents
  documents.graph

publishApp = (project, name, includeManifest, documents = undefined) ->
  return null unless project.appRoot?
  generated = join project.root, 'static', 'generated'
  mkdirSync join(generated, '@rip'), { recursive: true }
  graph = null
  if documents is undefined
    graph = writeAppDocuments! project, includeManifest
  else if documents?
    commitAppDocuments project, documents
    graph = documents.graph
  runtime = join(loaderDir(), '..', 'dist', 'browser', 'rip.js')
  abort "rip-server: browser runtime missing at #{runtime}" unless existsSync runtime
  copyFileSync runtime, join(generated, '@rip', 'rip.js')

  authoredShell = join project.appRoot, 'index.html'
  shell = authoredShell
  unless existsSync authoredShell
    shell = join generated, 'index.html'
    writeAtomic shell, """
    <!doctype html>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#{escapeHtml(name)}</title>
    <div id="app"></div>
    <script type="module">
      import { bootApp } from '/@rip/rip.js'
      bootApp({ url: '/bundle.json'#{if includeManifest then ', workspace: true' else ''} })
    </script>
    """

  roots = [
    { path: generated, cache: 'revalidate', browse: false }
    { path: project.appRoot, cache: 'never', browse: false }
  ]
  { files: { roots, proxy_first: (if project.entry? then ['/api'] else []), shell }, graph }

waitReady = (proc, socket) ->
  deadline = Date.now() + READY_MS
  loop
    throw new Error("worker exited with code #{proc.exitCode} before readiness") if proc.exitCode?
    response = null
    try
      options = { unix: socket }
      response = await fetch 'http://worker/ready', options
    if response?
      return if response.status is 200
      if response.headers.has 'rip-boot-failed'
        throw new Error(await response.text())
    throw new Error('worker readiness deadline expired') if Date.now() >= deadline
    await new Promise (done) -> setTimeout done, 25

stopWorker = (proc) ->
  return unless proc?
  proc.kill 'SIGTERM' unless proc.exitCode?
  deadline = Date.now() + 5000
  while not proc.exitCode? and Date.now() < deadline
    await new Promise (done) -> setTimeout done, 10
  proc.kill 'SIGKILL' unless proc.exitCode?
  await proc.exited

killWorker = (proc) ->
  proc.kill 'SIGKILL' unless proc.exitCode?
  await proc.exited

managerRuntime = (root) ->
  key = new Bun.CryptoHasher('sha256').update(root).digest('hex').slice 0, 16
  directory = join tmpdir(), 'rip-managers'
  mkdirSync directory, { recursive: true, mode: 0o700 }
  { socket: join(directory, "#{key}.sock"), owner: join(directory, "#{key}.json") }

managerRequest = (socket, method, path) ->
  options = { method, unix: socket }
  fetch "http://manager#{path}", options

export main = (argv) ->
  args = parseArgs argv
  project = resolveProject(args.entry or process.cwd())
  managerRuntimePaths = managerRuntime project.root
  managerPath = managerRuntimePaths.socket
  managerOwner = managerRuntimePaths.owner
  if args.command isnt 'start'
    body = null
    if args.command is 'migrate'
      migrationEntry = resolve args.migrationEntry if args.migrationEntry?
      abort "rip-server: migration entry not found: #{args.migrationEntry}" if migrationEntry? and not existsSync(migrationEntry)
      body = { id: args.operationId or randomBytes(16).toString('hex'), entry: migrationEntry, dir: resolve(args.migrationDir) }
    else if args.command is 'recover'
      body = { id: args.operationId }
    options = { method: (if args.command is 'status' then 'GET' else 'POST'), unix: managerPath }
    if body?
      options.body = JSON.stringify body
      options.headers = { 'content-type': 'application/json' }
    response = fetch! "http://manager/#{args.command}", options
    body = response.text!
    abort "rip-server: #{args.command} failed (#{response.status}): #{body}" unless response.ok
    p body
    return
  runDir = mkdtempSync join(tmpdir(), 'rip-srv-')
  workers = []
  bootingWorkers = []
  workerSerial = 0
  appArtifact = null
  workerArtifact = null
  files = null
  appGraph = null
  appWatcher = null
  appTimer = null
  appChain = Promise.resolve()
  apiWatcher = null
  apiTimer = null
  apiChain = Promise.resolve()
  apiInputs = new Set
  generation = 0
  apiEpoch = 0
  prepared = null
  doorbell = null
  doorbellPath = join runDir, 'doorbell.sock'
  doorbellPublished = false
  bootPromise = null
  operation = 'Active'
  operationPromise = null
  operationKey = null
  operationResults = new Map
  migrationChild = null
  migration = null
  operationPath = join project.root, '.rip', 'server-operation.json'
  migration = readOperation operationPath
  operation = 'Maintenance' if migration?
  managerControl = null
  managerOwned = false
  releaseHold = null
  appId = null
  heartbeat = null
  finish = null
  stopping = false
  finished = new Promise (done) -> finish = done
  updateChain = Promise.resolve()

  registration = ->
    upstreams =
      if operation is 'Maintenance' then []
      else if doorbellPublished then [{ path: doorbellPath, doorbell: true }]
      else workers.map (worker) -> { path: worker.socket }
    body =
      name: args.name
      hosts: [args.host]
      upstreams: upstreams
    body.files = files if files?
    body

  status = ->
    { name: args.name, root: project.root, operation, workers: workers.length, watch: args.watch, migration: (if migration? then { id: migration.id, phase: migration.phase, outcome: migration.outcome } else null) }

  operationResponse = (key, run) ->
    return Response.json({ error: 'manager is stopping' }, { status: 409 }) if stopping
    cached = operationResults.get key
    return Response.json(cached.body, { status: cached.status }) if cached?
    if operationPromise?
      return Response.json({ error: 'another migration or recovery is running' }, { status: 409 }) unless operationKey is key
    else
      operationKey = key
      operationPromise = do ->
        result = null
        try
          result = { status: 200, body: await run() }
        catch error
          result = { status: 409, body: { error: String(error), status: status() } }
        operationResults.set key, result
        result
      operationPromise.finally(->
        operationPromise = null
        operationKey = null
      ).catch(-> null)
    result = await operationPromise
    Response.json result.body, { status: result.status }

  startManagerControl = ->
    acquire = ->
      try
        fd = openSync managerOwner, 'wx', 0o600
        try
          writeFileSync fd, JSON.stringify({ pid: process.pid, root: project.root })
        finally
          closeSync fd
        managerOwned = true
        return
      catch error
        throw error unless error?.code is 'EEXIST'
      owner = try JSON.parse(readFileSync(managerOwner, 'utf8')) catch then null
      alive = false
      try
        process.kill owner?.pid, 0
        alive = true
      abort "rip-server: manager already running for #{project.root}" if alive
      unlinkSync managerOwner
      acquire()
    acquire()
    try unlinkSync managerPath
    managerControl = Bun.serve
      unix: managerPath
      fetch: (request) ->
        path = new URL(request.url).pathname
        return Response.json(status()) if request.method is 'GET' and path is '/status'
        if request.method is 'POST' and path is '/hold'
          return Response.json({ error: "cannot hold while #{operation}" }, { status: 409 }) unless operation is 'Active'
          operation = 'Held'
          clearTimeout appTimer if appTimer?
          clearTimeout apiTimer if apiTimer?
          return Response.json status()
        if request.method is 'POST' and path is '/release'
          try return Response.json(await releaseHold())
          catch error then return Response.json({ error: String(error) }, { status: 409 })
        if request.method is 'POST' and path is '/migrate'
          body = try await request.json() catch then null
          return Response.json({ error: 'migrate requires a JSON body' }, { status: 400 }) unless body?
          return Response.json({ error: 'migrate requires exactly 32 lowercase hex characters' }, { status: 400 }) unless typeof body.id is 'string' and /^[a-f0-9]{32}$/.test(body.id)
          return operationResponse! "migrate:#{body.id}", -> runCoordinatedMigration body
        if request.method is 'POST' and path is '/recover'
          body = try await request.json() catch then null
          return Response.json({ error: 'recover requires a valid operation id' }, { status: 400 }) unless typeof body?.id is 'string' and /^[a-f0-9]{32}$/.test(body.id)
          return operationResponse! "recover:#{body.id}", -> recoverMigration body.id
        new Response('Not Found', { status: 404 })

  createRegistration = ->
    response = controlFetch! args.control, 'POST', '/1.0/apps', registration()
    detail = response.text!
    throw new Error("Janus registration failed (#{response.status}): #{detail}") unless response.status is 201
    body = JSON.parse detail
    throw new Error('Janus registration returned no app id') unless body?.id?
    appId = body.id

  publishUpstreams = (upstreams) ->
    throw new Error('manager is stopping') if stopping
    return unless appId?
    response = controlFetch! args.control, 'PUT', "/1.0/apps/#{appId}/upstreams", { upstreams }
    throw new Error("Janus upstream update failed (#{response.status})") unless response.ok

  publishWorkers = -> publishUpstreams! registration().upstreams

  queuePublish = ->
    run = updateChain.then -> publishWorkers!()
    updateChain = run.catch -> null
    run

  spawnReadyWorker = (target = workers) ->
    workerSerial++
    socket = join runDir, "worker-#{workerSerial}.sock"
    proc = Bun.spawn [process.execPath, workerArtifact],
      stdin: 'ignore'
      stdout: 'inherit'
      stderr: 'inherit'
      env: { ...process.env, APP_ARTIFACT: appArtifact, SOCKET_PATH: socket, WORKER_ID: "#{workerSerial}", WORKER_CONCURRENCY: "#{args.concurrency}" }
    worker = { proc, socket }
    try
      waitReady! proc, socket
    catch error
      await killWorker proc
      throw error
    target.push worker
    worker

  bootSlot = (target = workers) ->
    firstError = null
    for attempt in [1..2]
      try return await spawnReadyWorker(target)
      catch error
        firstError ?= error
    throw firstError

  monitorWorker = (worker) ->
    do ->
      code = await worker.proc.exited
      return if stopping
      return unless workers.includes(worker) and not doorbellPublished
      workers = workers.filter (candidate) -> candidate isnt worker
      try await queuePublish()
      catch error
        warn "rip-server: cannot remove crashed worker from Janus: #{String(error)}"
      warn "rip-server: worker exited (#{code}); replacing"
      loop
        return if stopping
        try
          replacement = await spawnReadyWorker()
          monitorWorker replacement
          await queuePublish()
          return
        catch error
          warn "rip-server: replacement worker failed: #{String(error)}"
          await new Promise (done) -> setTimeout done, 250
    return

  publishDings = (dings) ->
    return unless dings.length > 0
    directives = dings.map (ding) -> { '@': ['/hub'], ding }
    for i in [0...directives.length] by 16
      response = controlFetch! args.control, 'POST', "/1.0/apps/#{appId}/hub/publish", directives.slice(i, i + 16)
      throw new Error("Janus ding publish failed (#{response.status})") unless response.ok

  refreshApp = ->
    next = writeAppDocuments! project, true
    prior = new Map((appGraph?.entries or []).map((entry) -> [entry.id, entry.hash]))
    current = new Map(next.entries.map((entry) -> [entry.id, entry.hash]))
    dings = []
    for entry in next.entries
      dings.push { id: entry.id, hash: entry.hash } unless prior.get(entry.id) is entry.hash
    for entry in appGraph?.entries or []
      dings.push { id: entry.id, hash: entry.hash, kind: 'delete' } unless current.has entry.id
    appGraph = next
    publishDings! dings

  startAppWatcher = ->
    return unless args.watch and project.appRoot?
    appWatcher = watch project.appRoot, { recursive: true }, ->
      return unless operation is 'Active'
      clearTimeout appTimer if appTimer?
      appTimer = setTimeout ->
        next = appChain.then -> refreshApp!()
        appChain = next.catch (error) -> warn "rip-server: App publication failed: #{String(error)}"
      , 50

  bootPrepared = ->
    return bootPromise if bootPromise?
    bootPromise = do ->
      loop
        throw new Error('no prepared API generation') unless prepared?
        candidate = prepared
        appArtifact = candidate.artifact
        candidateWorkers = []
        bootingWorkers = candidateWorkers
        try
          for slot in [0...args.workers]
            await bootSlot candidateWorkers
        catch error
          await Promise.all candidateWorkers.map (worker) -> killWorker worker.proc
          bootingWorkers = []
          continue if candidate isnt prepared
          throw error
        if candidate isnt prepared
          await Promise.all candidateWorkers.map (worker) -> killWorker worker.proc
          bootingWorkers = []
          continue
        workers = candidateWorkers
        bootingWorkers = []
        for worker in workers
          monitorWorker worker
        doorbellPublished = false
        await queuePublish()
        continue if candidate isnt prepared
        prepared = null
        return
    bootPromise.finally(-> bootPromise = null).catch(-> null)
    bootPromise

  cutForCandidate = (candidate) ->
    return if stopping or candidate isnt prepared
    doorbellPublished = true
    await queuePublish()
    old = workers
    workers = []
    await Promise.all old.map (worker) -> stopWorker worker.proc

  prepareApi = (epoch) ->
    generation++
    artifact = join runDir, "app-#{generation}.js"
    reportPath = join runDir, "app-#{generation}.json"
    try
      report = generate! project.entry, artifact, reportPath, "api-#{generation}"
    catch error
      warn "rip-server: API candidate rejected; keeping current workers: #{String(error)}"
      return
    return if epoch isnt apiEpoch or stopping
    candidate = { artifact, inputs: report.inputs, epoch }
    prepared = candidate
    apiInputs = new Set report.inputs
    cutForCandidate! candidate

  startApiWatcher = ->
    return unless args.watch and project.entry?
    apiWatcher = watch project.root, { recursive: true }, (event, filename) ->
      return unless operation is 'Active'
      rel = String(filename or '')
      return if rel.startsWith('app/') or rel.startsWith('static/') or rel.startsWith('.rip/') or rel.startsWith('node_modules/')
      path = resolve project.root, rel
      return unless path is project.entry or apiInputs.has path
      apiEpoch++
      epoch = apiEpoch
      clearTimeout apiTimer if apiTimer?
      apiTimer = setTimeout ->
        next = apiChain.then -> prepareApi! epoch
        apiChain = next.catch (error) -> warn "rip-server: API reload failed: #{String(error)}"
      , 50

  startDoorbell = ->
    return unless project.entry?
    doorbell = Bun.serve
      unix: doorbellPath
      fetch: (request) ->
        return new Response('Not Found', { status: 404 }) unless request.method is 'GET' and new URL(request.url).pathname is '/ring'
        try
          await bootPrepared()
          new Response(null, { status: 204 })
        catch error
          new Response(String(error), { status: 503 })

  releaseHold = ->
    throw new Error("cannot release while #{operation}") unless operation is 'Held'
    operation = 'Releasing'
    oldWorkers = workers
    oldArtifact = appArtifact
    candidateWorkers = []
    documents = null
    swapped = false
    try
      documents = buildAppDocuments!(project, args.watch) if project.appRoot?
      if project.entry?
        generation++
        candidateArtifact = join runDir, "release-#{generation}.js"
        report = generate! project.entry, candidateArtifact, join(runDir, "release-#{generation}.json"), "release-#{generation}"
        appArtifact = candidateArtifact
        for slot in [0...args.workers]
          await bootSlot candidateWorkers
        apiInputs = new Set report.inputs

      workers = candidateWorkers
      await queuePublish()
      swapped = true
      commitAppDocuments project, documents if documents?
      appGraph = documents.graph if documents?
      for worker in workers
        monitorWorker worker
      try
        response = await controlFetch args.control, 'POST', "/1.0/apps/#{appId}/hub/publish", [{ '@': ['/hub'], ding: { kind: 'epoch', epoch: generation } }]
        warn "rip-server: release reload ding failed (#{response.status})" unless response.ok
      catch error
        warn "rip-server: release reload ding failed: #{String(error)}"
      operation = 'Active'
      await Promise.all oldWorkers.map (worker) -> stopWorker worker.proc
      status()
    catch error
      await Promise.all candidateWorkers.map (worker) -> killWorker worker.proc
      workers = oldWorkers
      appArtifact = oldArtifact
      try await queuePublish() if swapped
      operation = 'Held'
      throw error

  persistMigration = (record) ->
    migration = writeOperation operationPath, record
    migration

  clearMigration = (record = migration) ->
    clearOperation operationPath
    migration = null
    for path in [record?.targetArtifact, record?.oldArtifact, record?.appCandidate]
      try unlinkSync path if path?
    try fsyncDirectory join(project.root, '.rip', 'generations')

  readAppCandidate = (path) ->
    return null unless path?
    JSON.parse readFileSync(path, 'utf8')

  migrationOutcome = (text) ->
    lines = String(text).split('\n').filter (line) -> line.startsWith('RIP_MIGRATION_OUTCOME=')
    return { outcome: 'unknown', error: 'migration child produced no outcome report' } unless lines.length
    return { outcome: 'unknown', error: 'migration child produced multiple outcome reports' } unless lines.length is 1
    try
      JSON.parse lines.at(-1).slice('RIP_MIGRATION_OUTCOME='.length)
    catch
      { outcome: 'unknown', error: 'migration child produced a malformed outcome report' }

  runMigrationChild = (body) ->
    bin = join loaderDir(), '..', 'bin', 'rip'
    childArgs = [process.execPath, bin, 'schema', 'migrate']
    childArgs.push body.entry if body.entry?
    childArgs.push '--dir', body.dir, '--coordinated', '--operation-id', body.id
    migrationChild = Bun.spawn childArgs,
      cwd: project.root
      stdin: 'ignore'
      stdout: 'pipe'
      stderr: 'pipe'
    [stdout, stderr, code] = await Promise.all [
      new Response(migrationChild.stdout).text()
      new Response(migrationChild.stderr).text()
      migrationChild.exited
    ]
    migrationChild = null
    report = migrationOutcome "#{stdout}\n#{stderr}"
    { ...report, code, output: (if code is 0 then stdout.trim() else stderr.trim()) }

  epochDing = ->
    return unless args.watch
    response = controlFetch! args.control, 'POST', "/1.0/apps/#{appId}/hub/publish", [{ '@': ['/hub'], ding: { kind: 'epoch', epoch: generation } }]
    throw new Error("Janus epoch ding failed (#{response.status})") unless response.ok

  bootArtifact = (artifact) ->
    appArtifact = artifact
    pool = []
    bootingWorkers = pool
    try
      for slot in [0...args.workers]
        await bootSlot pool
      pool
    catch error
      bootingWorkers = []
      await Promise.all pool.map (worker) -> killWorker worker.proc
      throw error

  activateMigration = (record) ->
    operation = 'Maintenance'
    candidateWorkers = []
    admissionAttempted = false
    try
      record = persistMigration { ...record, phase: 'activating' }
      activeArtifact = join runDir, "active-#{record.id}.js"
      copyFileSync record.targetArtifact, activeArtifact
      candidateWorkers = bootArtifact! activeArtifact
      startDoorbell() unless doorbell?
      documents = readAppCandidate record.appCandidate
      commitAppDocuments project, documents if documents?
      appGraph = documents.graph if documents?
      apiInputs = new Set record.inputs
      appChanged = documents? and appModules(project.appRoot).rash isnt documents.graph.rash
      apiChanged = JSON.stringify(sourceRashes(record.inputs)) isnt JSON.stringify(record.inputRashes)
      operation = 'Activating'
      admissionAttempted = true
      await publishUpstreams candidateWorkers.map (worker) -> { path: worker.socket }
      workers = candidateWorkers
      bootingWorkers = []
      for worker in workers
        monitorWorker worker
      epochDing!()
      operation = 'Active'
      clearMigration record
      if appChanged
        next = appChain.then -> refreshApp!()
        appChain = next.catch (error) -> warn "rip-server: post-migration App refresh failed: #{String(error)}"
      if apiChanged
        apiEpoch++
        epoch = apiEpoch
        next = apiChain.then -> prepareApi! epoch
        apiChain = next.catch (error) -> warn "rip-server: post-migration API refresh failed: #{String(error)}"
      status()
    catch error
      try await publishUpstreams [] if admissionAttempted
      operation = 'Maintenance'
      workers = []
      bootingWorkers = []
      await Promise.all candidateWorkers.map (worker) -> killWorker worker.proc
      record = persistMigration { ...record, phase: 'maintenance', error: String(error) }
      throw error

  restoreHeld = (record) ->
    restored = []
    admissionAttempted = false
    try
      activeArtifact = join runDir, "restored-#{record.id}.js"
      copyFileSync record.oldArtifact, activeArtifact
      restored = bootArtifact! activeArtifact
      operation = 'Restoring'
      admissionAttempted = true
      await publishUpstreams restored.map (worker) -> { path: worker.socket }
      workers = restored
      bootingWorkers = []
      for worker in workers
        monitorWorker worker
      operation = 'Held'
      clearMigration()
      status()
    catch error
      try await publishUpstreams [] if admissionAttempted
      operation = 'Maintenance'
      workers = []
      bootingWorkers = []
      await Promise.all restored.map (worker) -> killWorker worker.proc
      persistMigration { ...record, phase: 'maintenance', error: String(error) }
      throw error

  runCoordinatedMigration = (body) ->
    throw new Error("cannot migrate while #{operation}") unless operation is 'Held'
    throw new Error('cannot migrate an App-only project') unless project.entry?
    operation = 'Migrating'
    oldWorkers = workers
    record = null
    cut = false
    try
      documents = buildAppDocuments!(project, args.watch) if project.appRoot?
      generation++
      candidateArtifact = join runDir, "migration-#{generation}.js"
      reportPath = join runDir, "migration-#{generation}.json"
      report = generate! project.entry, candidateArtifact, reportPath, "migration-#{generation}"
      generations = join project.root, '.rip', 'generations'
      mkdirSync generations, { recursive: true, mode: 0o700 }
      fsyncDirectory join(project.root, '.rip')
      fsyncDirectory project.root
      targetArtifact = join generations, "#{body.id}.js"
      oldArtifact = join generations, "#{body.id}-old.js"
      appCandidate = if documents? then join(generations, "#{body.id}-app.json") else null
      durableWrite targetArtifact, readFileSync(candidateArtifact)
      durableWrite oldArtifact, readFileSync(appArtifact)
      durableWrite appCandidate, JSON.stringify(documents) if appCandidate?
      fsyncDirectory generations
      record =
        version: 1
        id: body.id
        phase: 'prepared'
        outcome: null
        targetArtifact: targetArtifact
        oldArtifact: oldArtifact
        appCandidate: appCandidate
        inputs: report.inputs
        inputRashes: sourceRashes(report.inputs)
        migrationEntry: body.entry or null
        migrationDir: body.dir
      persistMigration record

      operation = 'Maintenance'
      workers = []
      doorbellPublished = false
      cut = true
      await publishUpstreams []
      await Promise.all oldWorkers.map (worker) -> stopWorker worker.proc
      record = persistMigration { ...record, phase: 'migration-running', outcome: 'unknown' }
      migrationReport = runMigrationChild! body
      record = persistMigration { ...record, phase: 'migration-finished', outcome: migrationReport.outcome, migration: migrationReport }
      if migrationReport.code is 0 and ['committed', 'confirmed-none'].includes(migrationReport.outcome)
        apiInputs = new Set record.inputs
        return activateMigration! record
      if migrationReport.code isnt 0 and migrationReport.outcome is 'confirmed-none'
        return restoreHeld! record
      throw new Error(migrationReport.error or migrationReport.output or 'migration outcome is unresolved')
    catch error
      if not cut
        operation = 'Held'
        clearMigration() if record?
      else
        operation = 'Maintenance'
        await Promise.all oldWorkers.map (worker) -> stopWorker worker.proc
        persistMigration { ...record, phase: 'maintenance', error: String(error) } if record?
        try await publishUpstreams []
      throw error

  recoverMigration = (id) ->
    throw new Error("cannot recover while #{operation}") unless operation is 'Maintenance'
    record = readOperation operationPath
    throw new Error('no migration operation requires recovery') unless record?
    throw new Error("operation id mismatch: want #{record.id}") unless id is record.id
    activateMigration! persistMigration({ ...record, phase: 'fix-forward', outcome: record.outcome or 'unknown' })

  beat = ->
    return if stopping or not appId?
    try
      response = controlFetch! args.control, 'POST', "/1.0/apps/#{appId}/heartbeat"
      if response.status is 404
        createRegistration!()
      else unless response.ok
        warn "rip-server: Janus heartbeat failed (#{response.status})"
    catch error
      warn "rip-server: Janus heartbeat failed: #{String(error)}"

  stop = (status = 0) ->
    return if stopping
    stopping = true
    clearInterval heartbeat if heartbeat?
    clearTimeout appTimer if appTimer?
    clearTimeout apiTimer if apiTimer?
    appWatcher?.close()
    apiWatcher?.close()
    try managerControl?.stop true
    try unlinkSync managerPath if managerOwned
    try migrationChild?.kill('SIGTERM')
    try await operationPromise if operationPromise?
    await appChain
    await apiChain
    try doorbell?.stop true
    try managerControl?.stop true
    try unlinkSync managerPath if managerOwned
    try unlinkSync managerOwner if managerOwned
    try
      if appId?
        response = await controlFetch args.control, 'DELETE', "/1.0/apps/#{appId}"
        warn "rip-server: Janus deregistration failed (#{response.status})" unless response.ok
    catch error
      warn "rip-server: Janus deregistration failed: #{String(error)}"
    allWorkers = [...workers, ...bootingWorkers]
    await Promise.all allWorkers.map (worker) -> stopWorker worker.proc
    finish! status

  try
    startManagerControl()
    publication = publishApp! project, args.name, args.watch, (if operation is 'Maintenance' then null else undefined)
    if publication?
      files = publication.files
      appGraph = publication.graph
    if project.entry?
      workerArtifact = join runDir, 'worker.js'
      generate! join(import.meta.dir, 'worker.rip'), workerArtifact, join(runDir, 'worker-result.json'), 'worker'
      unless operation is 'Maintenance'
        appArtifact = join runDir, 'app.js'
        report = generate! project.entry, appArtifact, join(runDir, 'app-result.json'), 'app'
        apiInputs = new Set report.inputs
        for slot in [0...args.workers]
          await bootSlot()
        startDoorbell()
    process.once 'SIGINT', -> stop! 0
    process.once 'SIGTERM', -> stop! 0
    createRegistration!()
    for worker in workers
      monitorWorker worker
    startAppWatcher()
    startApiWatcher()
    heartbeat = setInterval beat, HEARTBEAT_MS
    if operation is 'Maintenance'
      warn "rip-server: unresolved migration #{migration.id}; Maintenance has empty admission"
    else
      p "rip-server: https://#{args.host}/"
    await finished
  catch error
    warn "rip-server: #{String(error)}"
    try await controlFetch(args.control, 'DELETE', "/1.0/apps/#{appId}") if appId?
    stopping = true
    await Promise.all workers.map (worker) -> stopWorker worker.proc
    process.exitCode = 1
  finally
    try managerControl?.stop true
    try unlinkSync managerPath if managerOwned
    try unlinkSync managerOwner if managerOwned
    rmSync runDir, { recursive: true, force: true }
