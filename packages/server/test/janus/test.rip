import { test, eq, ok } from '@rip-lang/testing'
import { cpSync, existsSync, mkdirSync, mkdtempSync, renameSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import { tmpdir } from 'node:os'
import { AccessFramer } from '../../monitor.rip'

PRELOAD = process.execArgv.find (arg) -> arg.startsWith('--preload=')
SERVER = join(import.meta.dir, '..', '..', 'server.rip')
PROJECT = join(import.meta.dir, '..', 'reloads', 'project')

releasedCaddy = ->
  return process.env.JANUS_CADDY if process.env.JANUS_CADDY?
  xcaddy = Bun.which 'xcaddy'
  throw new Error('test:janus requires xcaddy or JANUS_CADDY') unless xcaddy?
  cache = join tmpdir(), 'rip-janus-release'
  binary = join cache, 'caddy-v1.5.0-access'
  return binary if existsSync binary
  mkdirSync cache, { recursive: true }
  buildDir = mkdtempSync join(cache, 'build-')
  candidate = join buildDir, 'caddy'
  try
    result = Bun.spawnSync [xcaddy, 'build', '--with', 'github.com/shreeve/janus@v1.5.0', '--output', candidate],
      cwd: buildDir
      stdout: 'pipe'
      stderr: 'pipe'
    throw new Error("cannot build published Janus v1.5.0:\n#{result.stderr.toString()}") unless result.exitCode is 0
    renameSync candidate, binary
  finally
    rmSync buildDir, { recursive: true, force: true }
  binary

waitFor = (name, fn, timeout = 8000) ->
  deadline = Date.now() + timeout
  loop
    value = await fn()
    return value if value
    throw new Error("released Janus test timed out waiting for #{name}") if Date.now() >= deadline
    sleep! 20

edgeFetch = (port, path, headers = {}) ->
  fetch "http://127.0.0.1:#{port}#{path}", { headers: { host: 'integration.test', ...headers } }

test! 'released Janus carries registration, files, sendfile, reload, and deregistration', ->
  CADDY = releasedCaddy!
  info = Bun.spawnSync [CADDY, 'build-info']
  build = info.stdout.toString()
  eq info.exitCode, 0, info.stderr.toString()
  ok build.includes("github.com/shreeve/janus\tv1.5.0"), build
  ok not build.includes("github.com/shreeve/janus\tv1.5.0 =>"), 'integration requires the published module, not a local replacement'

  dir = mkdtempSync join(tmpdir(), 'rip-janus-release-')
  project = join dir, 'project'
  cpSync PROJECT, project, { recursive: true }
  mkdirSync join(project, 'node_modules', '@rip-lang'), { recursive: true }
  symlinkSync join(import.meta.dir, '..', '..'), join(project, 'node_modules', '@rip-lang', 'server'), 'dir'
  privateFile = join project, 'private.txt'
  writeFileSync privateFile, 'authorized bytes'
  writeFileSync join(project, 'app', 'styles.css'), "body { color: navy; }\n"
  writeFileSync join(project, 'index.rip'), """
  import { get, start } from '@rip-lang/server'

  get '/api/version' -> { version: 'one' }
  get '/api/send' -> new Response null, { headers: { 'X-Sendfile': #{JSON.stringify(privateFile)} } }
  start!
  """

  reservation = Bun.serve { port: 0, fetch: -> new Response(null) }
  port = reservation.port
  reservation.stop true
  control = join dir, 'janus.sock'
  config = join dir, 'Caddyfile'
  writeFileSync config, """
  {
    admin off
    auto_https off
    janus {
      control internal #{control}
      cache off
      hub
      files
    }
  }

  http://:#{port} {
    janus {
      auth off
    }
    log {
      output stderr
      format janus
    }
  }
  """

  caddy = null
  manager = null
  try
    caddy = Bun.spawn [CADDY, 'run', '--config', config, '--adapter', 'caddyfile'],
      cwd: dir
      stdin: 'ignore'
      stdout: 'pipe'
      stderr: 'pipe'
      env: { ...process.env, JANUS_HEARTBEAT_TTL: '6s', XDG_DATA_HOME: join(dir, 'data'), XDG_CONFIG_HOME: join(dir, 'config') }
    caddyOut = new Response(caddy.stdout).text()
    caddyErr = new Response(caddy.stderr).text()
    await waitFor 'control socket', ->
      throw new Error("released Caddy exited #{caddy.exitCode}: #{await caddyErr}") if caddy.exitCode?
      existsSync control
    accessStatus = await fetch 'http://janus/1.0/access', { unix: control }
    eq accessStatus.status, 200
    accessState = await accessStatus.json()
    ok accessState.provisioned_encoders > 0, JSON.stringify(accessState)

    manager = Bun.spawn [process.execPath, PRELOAD, SERVER, project, '--watch', '--host', 'integration.test', '--control', control],
      stdin: 'ignore'
      stdout: 'pipe'
      stderr: 'pipe'
    managerOut = new Response(manager.stdout).text()
    managerErr = new Response(manager.stderr).text()

    edgeDiagnostic = 'no response'
    try
      first = await waitFor 'initial API response', ->
        throw new Error("manager exited #{manager.exitCode}: #{await managerErr}") if manager.exitCode?
        try
          response = await edgeFetch port, '/api/version'
          text = await response.text()
          edgeDiagnostic = "#{response.status}: #{text}"
          JSON.parse(text) if response.status is 200
        catch error
          edgeDiagnostic = String(error)
          null
    catch error
      throw new Error("#{error}; last edge result #{edgeDiagnostic}")
    eq first, { version: 'one' }
    activeAccess = await fetch 'http://janus/1.0/access', { unix: control }
    eq (await activeAccess.json()).registrations, 1
    apps = await (await fetch('http://janus/1.0/apps', { unix: control })).json()
    directAccess = await fetch "http://janus/1.0/apps/#{apps[0].id}/access?after=0", { unix: control }
    unless directAccess.status is 200
      eq directAccess.status, 200, await directAccess.text()
    accessRecords = []
    accessError = null
    framer = new AccessFramer ((line) -> accessRecords.push line), ((error) -> accessError = error)
    reader = directAccess.body.getReader()
    await waitFor 'released Janus access hello', ->
      { done, value } = reader.read!()
      framer.feed value unless done
      throw accessError if accessError?
      accessRecords.length > 0
    eq accessRecords[0].record.type, 'hello'
    await reader.cancel()

    shell = await edgeFetch port, '/'
    eq shell.status, 200
    ok (await shell.text()).includes('<div id="app"></div>')
    bundle = await edgeFetch port, '/bundle.json'
    eq bundle.status, 200
    etag = bundle.headers.get 'etag'
    ok etag?.startsWith('W/"')
    eq (await edgeFetch(port, '/bundle.json', { 'if-none-match': etag })).status, 304
    css = await edgeFetch port, '/styles.css'
    eq css.status, 200
    eq (await css.text()).trim(), 'body { color: navy; }'

    sent = await edgeFetch port, '/api/send'
    eq sent.status, 200
    eq sent.headers.get('x-sendfile'), null
    eq await sent.text(), 'authorized bytes'
    partial = await edgeFetch port, '/api/send', { range: 'bytes=0-9' }
    eq partial.status, 206
    eq await partial.text(), 'authorized'

    sleep! 6200
    alive = await edgeFetch port, '/api/version'
    eq alive.status, 200
    eq await alive.json(), { version: 'one' }

    writeFileSync join(project, 'index.rip'), """
    import { get, start } from '@rip-lang/server'

    get '/api/version' -> { version: 'two' }
    get '/api/send' -> new Response null, { headers: { 'X-Sendfile': #{JSON.stringify(privateFile)} } }
    start!
    """
    second = await waitFor 'reloaded API response', ->
      try
        response = await edgeFetch port, '/api/version'
        body = await response.json()
        body if body.version is 'two'
      catch then null
    eq second, { version: 'two' }

    manager.kill 'SIGTERM'
    eq (await manager.exited), 143, await managerErr
    ok (await managerOut).includes('/api/version'), 'released Janus access events must reach foreground output'
    manager = null
    await waitFor 'deregistration', ->
      response = await edgeFetch port, '/api/version'
      response.status is 404
  finally
    try manager?.kill('SIGKILL')
    await manager.exited if manager?
    try caddy?.kill('SIGTERM')
    await caddy.exited if caddy?
    rmSync dir, { recursive: true, force: true }
