import { test, eq, ok } from '@rip-lang/testing'
import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
import { X509Certificate, createPrivateKey, createPublicKey } from 'node:crypto'
import { join } from 'node:path'
import { tmpdir } from 'node:os'

PRELOAD = process.execArgv.find (arg) -> arg.startsWith '--preload='
APP = join(import.meta.dir, '..', '..', 'app.rip')
EDGE = join(import.meta.dir, '..', '..', 'edge.rip')
FAKE_CADDY = join(import.meta.dir, 'fake-caddy.rip')

run = (file, args, env) ->
  proc = Bun.spawn [process.execPath, PRELOAD, file, ...args],
    stdin: 'ignore'
    stdout: 'pipe'
    stderr: 'pipe'
    env: { ...process.env, ...env }
  out = Response.new(proc.stdout).text()
  err = Response.new(proc.stderr).text()
  { proc, out, err }

cli = (file, args, env) ->
  result = run file, args, env
  code = await result.proc.exited
  { code, out: await result.out, err: await result.err }

waitFor = (name, fn, timeout = 5000) ->
  deadline = Date.now() + timeout
  loop
    value = fn!
    return value if value
    throw Error.new("timed out waiting for #{name}") if Date.now() >= deadline
    sleep! 10

fixture = (prefix) ->
  root = mkdtempSync join(tmpdir(), prefix)
  state = join root, 'state'
  runtime = join root, 'runtime'
  mkdirSync state, { mode: 0o700 }
  mkdirSync runtime, { mode: 0o700 }
  { root, state, runtime }

stopAgent = (runtime) ->
  owner = join runtime, 'agent.json'
  return unless existsSync owner
  pid = JSON.parse(readFileSync(owner, 'utf8')).pid
  try process.kill pid, 'SIGTERM'
  waitFor! 'agent shutdown', -> not existsSync(owner)

test! 'the packaged ripdev.io pair is publicly trusted, current, matching, and development-only', ->
  certificate = X509Certificate.new readFileSync(join(import.meta.dir, '..', '..', 'ripdev.io.crt'))
  privateKey = createPrivateKey readFileSync(join(import.meta.dir, '..', '..', 'ripdev.io.key'))
  eq certificate.subject, 'CN=*.ripdev.io'
  ok certificate.issuer.includes 'GlobalSign'
  ok certificate.subjectAltName.includes 'DNS:*.ripdev.io'
  ok certificate.subjectAltName.includes 'DNS:ripdev.io'
  ok Date.parse(certificate.validTo) > Date.now()
  eq createPublicKey(privateKey).export({ type: 'spki', format: 'pem' }), certificate.publicKey.export({ type: 'spki', format: 'pem' })

test! 'the packaged macOS edge activates one loopback HTTPS socket for Caddy', ->
  caddyfile = readFileSync join(import.meta.dir, '..', '..', 'Caddyfile'), 'utf8'
  launcher = readFileSync join(import.meta.dir, '..', '..', 'launchd-listener.js'), 'utf8'
  ok caddyfile.includes 'default_bind {$RIP_EDGE_BIND:127.0.0.1}'
  ok caddyfile.includes 'protocols h1 h2'
  ok launcher.includes "launch_activate_socket(ptr(name), ptr(descriptorsAddress), ptr(count))"
  ok launcher.includes "stdio: ['ignore', 'inherit', 'inherit', listener]"

startJanus = (socket, calls) ->
  serial = 0
  Bun.serve
    unix: socket
    fetch: (request) ->
      url = URL.new request.url
      calls.push { method: request.method, path: url.pathname }
      return Response.json({ type: 'janus', api_version: '1.0' }) if request.method is 'GET' and url.pathname is '/1.0'
      if request.method is 'POST' and url.pathname is '/1.0/apps'
        serial++
        return Response.json({ id: "app-#{serial}" }, { status: 201 })
      Response.new null, { status: 204 }

test! 'rip app remembers, supervises, observes, and removes one project', ->
  site = fixture 'rip-agent-app-'
  project = join site.root, 'project'
  mkdirSync join(project, 'app'), { recursive: true }
  writeFileSync join(project, 'app', 'index.rip'), "export default -> 'ok'\n"
  janusSocket = join site.root, 'janus.sock'
  calls = []
  janus = startJanus janusSocket, calls
  env = { RIP_AGENT_HOME: site.state, RIP_AGENT_RUNTIME: site.runtime, JANUS_CONTROL: janusSocket }
  try
    empty = cli! APP, ['list', '--json'], env
    eq empty.code, 0
    eq JSON.parse(empty.out), []

    added = cli! APP, ['add', project, '--name', 'fixture', '--host', 'fixture.ripdev.io', '--json'], env
    eq added.code, 0
    app = JSON.parse added.out
    eq app.name, 'fixture'
    eq app.state, 'stopped'
    eq app.url, 'https://fixture.ripdev.io/'

    duplicate = cli! APP, ['add', project], env
    eq duplicate.code, 1
    ok duplicate.err.includes 'project is already registered'

    wrongSurface = cli! APP, ['status', 'fixture', '--workers', '9'], env
    eq wrongSurface.code, 1
    ok wrongSurface.err.includes 'status does not accept add options: --workers'
    conflictingLogs = cli! APP, ['logs', 'fixture', '--follow', '--json'], env
    eq conflictingLogs.code, 1
    ok conflictingLogs.err.includes '--follow conflicts with --json'

    started = cli! APP, ['start', 'fixture', '--json'], env
    eq started.code, 0
    live = JSON.parse started.out
    eq live.state, 'running'
    eq live.desired, 'running'
    ok Number.isInteger live.pid

    listed = JSON.parse((cli!(APP, ['status', '--json'], env)).out)
    eq listed.length, 1
    eq listed[0].pid, live.pid

    # The manager outlives the UI/control client. A replacement agent adopts
    # the same canonical manager socket and preserves the desired state.
    stopAgent! site.runtime
    adopted = JSON.parse((cli!(APP, ['status', 'fixture', '--json'], env)).out)
    eq adopted.state, 'running'
    eq adopted.desired, 'running'
    eq adopted.pid, live.pid

    logs = cli! APP, ['logs', 'fixture', '--json'], env
    eq logs.code, 0
    log = JSON.parse logs.out
    ok log.path.endsWith("#{app.id}.log")
    ok Number.isInteger log.next
    eq log.truncated, false

    blocked = cli! APP, ['remove', 'fixture'], env
    eq blocked.code, 1
    ok blocked.err.includes 'is running — stop it before removal'

    stopped = cli! APP, ['stop', 'fixture', '--json'], env
    eq stopped.code, 0
    eq JSON.parse(stopped.out).state, 'stopped'
    ok calls.some((call) -> call.method is 'DELETE' and call.path is '/1.0/apps/app-1')

    removed = cli! APP, ['remove', 'fixture', '--json'], env
    eq removed.code, 0
    eq JSON.parse(removed.out).name, 'fixture'
    eq JSON.parse((cli!(APP, ['list', '--json'], env)).out), []
  finally
    try
      stopped = cli! APP, ['stop', 'fixture'], env
    stopAgent! site.runtime
    janus.stop true
    rmSync site.root, { recursive: true, force: true }

test! 'rip edge distinguishes an external edge from one owned by Rip', ->
  external = fixture 'rip-agent-external-edge-'
  externalSocket = join external.root, 'janus.sock'
  janus = startJanus externalSocket, []
  externalEnv = { RIP_AGENT_HOME: external.state, RIP_AGENT_RUNTIME: external.runtime, JANUS_CONTROL: externalSocket }
  try
    status = JSON.parse((cli!(EDGE, ['status', '--json'], externalEnv)).out)
    eq status.state, 'running'
    eq status.managed, false
    stopped = cli! EDGE, ['stop'], externalEnv
    eq stopped.code, 1
    ok stopped.err.includes 'edge is not owned by Rip'
    wrongSurface = cli! EDGE, ['status', '--caddy', FAKE_CADDY], externalEnv
    eq wrongSurface.code, 1
    ok wrongSurface.err.includes 'status does not accept start options'
  finally
    stopAgent! external.runtime
    janus.stop true
    rmSync external.root, { recursive: true, force: true }

  owned = fixture 'rip-agent-owned-edge-'
  ownedEnv = { RIP_AGENT_HOME: owned.state, RIP_AGENT_RUNTIME: owned.runtime, JANUS_CONTROL: join(owned.root, 'absent.sock') }
  ownedConfig = join owned.root, 'Caddyfile'
  writeFileSync ownedConfig, ''
  chmodSync FAKE_CADDY, 0o755
  try
    started = cli! EDGE, ['start', '--caddy', FAKE_CADDY, '--config', ownedConfig, '--json'], ownedEnv
    eq started.code, 0
    edge = JSON.parse started.out
    eq edge.state, 'running'
    eq edge.managed, true
    eq edge.launcher, 'direct'
    ok Number.isInteger edge.pid

    stopAgent! owned.runtime
    adopted = JSON.parse((cli!(EDGE, ['status', '--json'], ownedEnv)).out)
    eq adopted.state, 'running'
    eq adopted.managed, true
    eq adopted.pid, edge.pid

    caddyPid = parseInt readFileSync(join(owned.runtime, 'caddy.pid'), 'utf8')
    process.kill caddyPid, 'SIGKILL'
    replacement = null
    deadline = Date.now() + 8000
    loop
      probe = JSON.parse((cli!(EDGE, ['status', '--json'], ownedEnv)).out)
      if probe.state is 'running' and probe.pid? and probe.pid isnt edge.pid
        replacement = probe
        break
      if Date.now() >= deadline
        diagnostic = readFileSync join(owned.state, 'agent.json'), 'utf8'
        agentLog = readFileSync join(owned.state, 'agent.log'), 'utf8'
        edgeLog = readFileSync join(owned.state, 'edge.log'), 'utf8'
        throw Error.new("timed out waiting for owned edge restart: #{JSON.stringify(probe)}\n#{diagnostic}\nAGENT:\n#{agentLog}\nEDGE:\n#{edgeLog}")
      sleep! 50
    eq replacement.desired, 'running'
    eq replacement.managed, true

    reloaded = cli! EDGE, ['reload', '--json'], ownedEnv
    eq reloaded.code, 0
    eq JSON.parse(reloaded.out).state, 'running'

    stopped = cli! EDGE, ['stop', '--json'], ownedEnv
    eq stopped.code, 0
    waitFor! 'fake edge shutdown', -> not existsSync(join(owned.runtime, 'janus.sock'))
    final = JSON.parse((cli!(EDGE, ['status', '--json'], ownedEnv)).out)
    eq final.state, 'stopped'
    eq final.managed, false
  finally
    try cli! EDGE, ['stop'], ownedEnv
    stopAgent! owned.runtime
    rmSync owned.root, { recursive: true, force: true }
