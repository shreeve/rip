import { existsSync, readdirSync } from 'node:fs'
import { join, relative } from 'node:path'

root = join(import.meta.dir, '..')
rip = Bun.which 'rip'
throw new Error('server tests require the rip executable') unless rip?

tests = readdirSync(import.meta.dir, { withFileTypes: true })
  .filter((entry) -> entry.isDirectory())
  .map((entry) -> join(import.meta.dir, entry.name, 'test.rip'))
  .filter(existsSync)
  .sort()

throw new Error('server tests found no test/*/test.rip files') unless tests.length

for test in tests
  name = relative root, test
  p "$ rip #{name}"
  child = Bun.spawn [rip, test],
    cwd: root
    stdin: 'inherit'
    stdout: 'inherit'
    stderr: 'inherit'
  code = await child.exited
  exit code unless code is 0
