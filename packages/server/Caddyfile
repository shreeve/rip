# Rip's development edge baseline. ripdev.io and *.ripdev.io resolve only to
# loopback. The publicly trusted development-only certificate and key beside
# this file give each app clean HTTPS. The edge exposes no public control
# listener and names no application.
# `rip app` registers projects through the private Janus socket at runtime.
# On macOS, `rip edge` supplies a launchd-owned loopback socket as fd/3.
{
	admin unix/{$RIP_EDGE_ADMIN}
	persist_config off
	auto_https disable_redirects
	default_bind {$RIP_EDGE_BIND:127.0.0.1}
	skip_install_trust
	servers {
		# fd/3 is the packaged macOS edge's TCP socket; HTTP/3 requires UDP.
		protocols h1 h2
	}

	janus {
		control internal {$RIP_EDGE_CONTROL}
		ping
		cache {
			ttl 1s
			ttl_max 10s
			max_body 256kb
			max_bytes 64mb
			max_app_share 50
		}
		hub {
			mode bridge
			origin same
		}
		files {
			precompressed
		}
		browse
	}
}

ripdev.io, *.ripdev.io {
	tls {$RIP_EDGE_CERT} {$RIP_EDGE_KEY}
	janus
}
