import { unwrapStash } from './stash.rip'
import { _isSourceCell, _isSourceFamily } from './source.rip'
import {
  __claimGateConstructor
  __hmrClassify
  __hmrEmit
  __hmrEntries
  __hmrPatch
  __hmrPreserveState
  __hmrRegisterDefinition
  __hmrRestoreUi
  __hmrSnapshotUi
} from '../../src/runtime/components.js'

constructGateComponent = __claimGateConstructor()

export type GateFailure =
  name: string
  message: string
  status: number
  path: string
  file: string
  error: unknown

export type Renderer =
  mount: (info: Record<string, any>) => Promise<any>
  preload: (info: Record<string, any>) => void
  # Patch or remount the current route chain from the first dirty module
  # down, keeping ancestor layouts and the live stash.
  # Returns 'narrow' when it patched or remounted, 'noop' when nothing is
  # mounted or the dirty modules have no living instance, 'escape' when
  # the caller should fall back to whole-launch remount, 'reload' when
  # the committed tree is no longer coherent.
  remountDirty: (paths: string[], candidate?: Record<string, any>) => Promise<'narrow' | 'noop' | 'escape' | 'reload'>
  start: () => Renderer
  stop: () => void
  readonly current: any

export type RendererOpts =
  router: Record<string, any>
  app: Record<string, any>
  components: Record<string, any>
  target: Record<string, any>
  onError?: (failure: GateFailure) => void

failureFor = (path: string, file: string, error: any, message: string | null = null): GateFailure ->
  text = message ?? error?.message ?? String(error)
  failure: any = Error.new text
  failure.name = 'GateFailure'
  failure.status = error?.status ?? error?.response?.status ?? 500
  failure.path = path
  failure.file = file
  failure.error = error
  failure

componentFrom = (components, file) ->
  module = components.getCompiled file
  unless module? and typeof module is 'object'
    throw Error.new "Rip App: no precompiled component module for '#{file}'"
  isComponent = (value) ->
    typeof value is 'function' and typeof value.prototype?.mount is 'function'
  return module.default if isComponent module.default
  found = []
  for key, value of module
    continue if key is 'default'
    if isComponent value
      found.push value
  unless found.length is 1
    throw Error.new "Rip App: precompiled module '#{file}' must export exactly one component class"
  found[0]

export def createRenderer(opts: RendererOpts): Renderer
  unless opts? and typeof opts is 'object'
    throw TypeError.new 'Rip App: createRenderer expects an options object'
  { router, app, components, target, onError } = opts
  unless router? and typeof router is 'object'
    throw TypeError.new 'Rip App: createRenderer requires a router object'
  unless app?.data?
    throw TypeError.new 'Rip App: createRenderer requires app.data'
  unless components? and typeof components.getCompiled is 'function'
    throw TypeError.new 'Rip App: createRenderer requires a component registry'
  unless target? and typeof target.appendChild is 'function'
    throw TypeError.new 'Rip App: createRenderer requires a target with appendChild()'
  if onError? and typeof onError isnt 'function'
    throw TypeError.new 'Rip App: createRenderer onError must be a function'

  instances = []
  current = null
  generation = 0
  disposeRoute = null
  mountedEntries: any[] = []
  pageMountPoint: any = null
  lastRoute: any = null
  forceFrom = null
  lastCommitTeardownFailed = false

  shallowEqual = (a, b) ->
    keysA = Object.keys a
    keysA.length is Object.keys(b).length and keysA.every (key) -> a[key] is b[key]

  sameChain = (a, b) ->
    a.length is b.length and a.every (file, index) -> b[index] is file

  resolveGateCell = (path) ->
    value = unwrapStash app.data
    segments = path.split '.'
    for segment, index in segments
      return null unless value? and (typeof value is 'object' or typeof value is 'function')
      value = value[segment]
      if _isSourceCell value
        return { cell: value, tail: segments.slice(index + 1) }
    null

  gateFailure = (path: string, file: string, message: string, error: any = null): GateFailure ->
    cause = error ?? Error.new(message)
    failureFor path, file, cause, message

  # A staying navigation may keep its mounted page only while every
  # query-keyed gate still addresses the cell it was constructed with;
  # a retargeted key means new data ownership and a fresh instance.
  queryKeyedRetargets = (entriesToCheck, params, query) ->
    for entry in entriesToCheck
      gates = entry.cls.__gates
      continue unless Array.isArray gates
      for gate, index in gates
        keyFn = if typeof gate is 'string' then null else gate?.key
        continue unless typeof keyFn is 'function'
        binding = entry.bindings?[index]
        return true unless binding
        resolved = resolveGateCell binding.path
        return true unless resolved and _isSourceFamily resolved.cell
        try
          cell = resolved.cell.cellFor keyFn(params, query)
        catch error
          return true
        return true unless cell is binding.cell
    false

  gateJobs = (entries, params, query) ->
    jobs = Map.new()
    for entry, entryIndex in entries
      gates = entry.cls.__gates
      entry.bindings = []
      continue unless gates?
      unless Array.isArray gates
        throw gateFailure '<static>', entry.file, "Rip App: #{entry.file} static __gates must be an array"
      for gate, gateIndex in gates
        path = if typeof gate is 'string' then gate else gate?.path
        keyFn = if typeof gate is 'string' then null else gate?.key
        unless typeof path is 'string' and path.length > 0
          throw gateFailure String(path), entry.file, "Rip App: #{entry.file} has a malformed render gate path"
        if keyFn? and typeof keyFn isnt 'function'
          throw gateFailure path, entry.file, "Rip App: gate '#{path}' has a non-function key"

        resolved = resolveGateCell path
        unless resolved
          throw gateFailure path, entry.file, "Rip App: gate '#{path}' does not resolve to a source"
        cell = resolved.cell

        if _isSourceFamily cell
          unless keyFn
            throw gateFailure path, entry.file, "Rip App: gate '#{path}' is keyed and requires a key function"
          try
            key = keyFn params, query
            cell = cell.cellFor key
          catch caught
            error = caught as any
            throw failureFor path, entry.file, error, "Rip App: gate '#{path}' key failed: #{error.message}"
        else if keyFn
          throw gateFailure path, entry.file, "Rip App: gate '#{path}' is a singleton and does not accept a key function"

        entry.bindings[gateIndex] = { cell, tail: resolved.tail, path, file: entry.file }
        unless jobs.has cell
          jobs.set cell, { cell, path, file: entry.file, entryIndex }
    Array.from jobs.values()

  ensureGates = (entries, params, query, mine) ->
    jobs = gateJobs entries, params, query
    results = Promise.allSettled! (job.cell.ensure() for job in jobs)
    return false if mine isnt generation
    # Failures are collected, not thrown mid-scan: the SHALLOWEST failing
    # entry decides the boundary, and every entry below it still gets its
    # binding values populated so a boundary chain constructs against the
    # full render-gate contract.
    failing: any = null
    consider = (failure: any, entryIndex) ->
      failure.entryIndex = entryIndex
      failing = failure if not failing? or entryIndex < failing.entryIndex
      return
    for result, index in results
      job = jobs[index]
      if result.status is 'rejected'
        consider failureFor(job.path, job.file, result.reason), job.entryIndex
      else unless result.value?
        consider gateFailure(job.path, job.file,
          "Rip App: gate '#{job.path}' resolved to #{result.value}; gated sources must resolve to a non-null value"), job.entryIndex
    for entry, entryIndex in entries
      break if failing? and entryIndex >= failing.entryIndex
      for binding in entry.bindings
        value = binding.cell.peek()
        for segment in binding.tail
          break unless value?
          value = value[segment]
        unless value?
          consider gateFailure(binding.path, binding.file,
            "Rip App: gate '#{binding.path}' resolved to #{value}; every gated subpath must exist and be non-null"), entryIndex
          break
        binding.value = value
    throw failing if failing?
    true

  # Route/layout instances read `@app`, `@router`, `@params`, and
  # `@query` as instance fields (the emitter lowers them to `this.app`
  # etc.). They are not props — the gate constructor injects them
  # before `_init` so member initializers can read them. Params and
  # query delegate to the router's reactive getters so `~=` / computed
  # members track navigations.
  construct = (entry, parent) ->
    constructGateComponent entry.cls, { gates: entry.bindings, parent, app, router }

  cleanup = (list) ->
    errors = []
    for instance in list by -1
      try
        instance.unmount?()
      catch error
        errors.push error
        try
          instance._teardown? { state: 'unmounted', hooks: false, removeDOM: true }
        catch fallbackError
          errors.push fallbackError
    errors

  unmount = ->
    oldInstances = instances
    instances = []
    current = null
    mountedEntries = []
    pageMountPoint = null
    lastRoute = null
    errors = cleanup oldInstances
    throw errors[0] if errors.length
    return

  # A mid-session unhandled failure retains the previous screen (see
  # mount), but the very first mount has no screen to retain — an
  # unhandled boot failure renders a self-contained error card into the
  # target instead of leaving a blank page. Inline styles only: the card
  # is the fallback for when the app itself is broken, so it depends on
  # no app CSS. It shows the failure's stack or message, and the next
  # successful commit clears it.
  fatalCard: any = null

  clearFatalCard = ->
    fatalCard?.remove?.()
    fatalCard = null
    return

  showFatalCard = (failure) ->
    clearFatalCard()
    text = failure.error?.stack ?? failure.stack ?? failure.message ?? String(failure)
    fatalCard = if typeof document isnt 'undefined' and typeof document.createElement is 'function'
      card = document.createElement 'pre'
      card.style.cssText = 'margin:2rem;padding:1rem 1.25rem;color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;font:13px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap;overflow-wrap:anywhere'
      card.textContent = text
      card
    else
      card: any = { nodeName: 'PRE', textContent: text }
      card.remove = ->
        siblings = card.parentNode?.children
        index = siblings?.indexOf(card) ?? -1
        siblings.splice index, 1 if index >= 0
        card.parentNode = null
        return
      card
    target.appendChild fatalCard
    return

  stagingTarget = ->
    if typeof document isnt 'undefined' and typeof document.createDocumentFragment is 'function'
      return document.createDocumentFragment()
    children = []
    {
      children
      appendChild: (node) ->
        children.push node
        node
    }

  commitStaging = (staging, into = target) ->
    clearFatalCard()
    if staging.nodeType is 11
      into.appendChild staging
    else
      into.appendChild node for node in staging.children
    return

  layoutMountPoint = (instance, fallback) ->
    roots = instance._nodes ?? [instance._root]
    for root in roots
      continue unless root
      return root if root.matches? '#content'
      slot = root.querySelector? '#content'
      return slot if slot
    roots.find((root) -> root?) ?? fallback

  # The child list of a slot on any host the renderer runs against: DOM
  # nodes expose childNodes, the renderer's own non-DOM targets children.
  childList = (node) -> node?.childNodes ?? node?.children ?? []

  # What a chain entry owns inside its slot is everything past the
  # children the slot already held when the entry mounted: mount appends
  # the entry last, and its blocks insert at anchors inside that range
  # (a top-level `for` puts its rows BEFORE its anchor, so the entry's
  # own create-phase nodes do not bound the range — the slot does). The
  # slot and that count are recorded at mount and re-recorded whenever
  # the entry is reseated.
  claimSlot = (entry, slot) ->
    entry.slot = slot
    entry.slotOwned = childList(slot).length
    return

  # A patched layout rebuilt its view, so its page slot is a new element
  # while the entries below it still hang from the old, detached one.
  # Re-resolve every slot from the chain root and move each descendant's
  # owned range into the live slot: the descendants keep their
  # instances, DOM, and state, and the page slot the next navigation
  # commits into is the live one.
  reseatChain = ->
    slot = target
    for entry, index in mountedEntries
      instance = entry.instance
      break unless instance?
      if index > 0 and entry.slot? and entry.slot isnt slot
        owned = Array.from(childList(entry.slot)).slice(entry.slotOwned ?? 0)
        claimSlot entry, slot
        slot.appendChild node for node in owned
        instance._target = slot
      break if index is mountedEntries.length - 1
      slot = layoutMountPoint instance, slot
    pageMountPoint = slot if mountedEntries.length > 1
    return

  # A gate failure below the chain root routes to the nearest already
  # gated ancestor that defines onError — the boundary chain mounts and
  # the failure becomes control flow. Without a boundary the previous
  # screen is retained and the failure propagates.
  mountBoundary = (prefixEntries, failure, mine) ->
    return false unless prefixEntries.some (entry) -> typeof entry.cls.prototype?.onError is 'function'
    staging = stagingTarget()
    mountPoint = staging
    built = []
    try
      for entry, index in prefixEntries
        parent = built[built.length - 1] ?? null
        instance = construct entry, parent
        built.push instance
        entry.instance = instance
        claimSlot entry, mountPoint if index > 0
        instance.mount? mountPoint
        if instance._state is 'failed'
          cleanup built
          return false
        mountPoint = layoutMountPoint instance, mountPoint
      if mine isnt generation
        cleanup built
        return false
      handler = null
      for instance in built by -1
        if typeof instance.onError is 'function'
          handler = instance
          break
      commitStaging staging
    catch error
      console.error '[Rip] boundary chain failed to mount:', error
      cleanup built
      return false
    old = instances
    instances = built
    current = built[built.length - 1] ?? null
    mountedEntries = prefixEntries
    pageMountPoint = mountPoint
    lastRoute = null
    try
      handler.onError failure
    catch error
      console.error '[Rip] boundary onError error:', error
    for error in cleanup old
      console.error '[Rip] boundary teardown error:', error
    true

  # The reused-chain variant: the boundary ancestors are already mounted
  # and gated, so the failure routes to the nearest living onError and
  # only the outgoing page tears down.
  boundaryOnMounted = (prefixEntries, failure) ->
    handler = null
    for entry in prefixEntries by -1
      if typeof entry.instance?.onError is 'function'
        handler = entry.instance
        break
    return false unless handler
    oldPage = instances.slice prefixEntries.length
    instances = prefixEntries.map (entry) -> entry.instance
    current = instances[instances.length - 1] ?? null
    mountedEntries = prefixEntries
    lastRoute = null
    try
      handler.onError failure
    catch error
      console.error '[Rip] boundary onError error:', error
    for error in cleanup oldPage
      console.error '[Rip] boundary teardown error:', error
    true

  performMount = (info, mine, componentRegistry = components) ->
    route = info?.route
    unless route?.file
      throw Error.new 'Rip App: renderer route state requires route.file'
    params = info.params ?? {}
    query = info.query ?? {}
    layoutFiles = info.layouts ?? []
    unless Array.isArray layoutFiles
      throw Error.new 'Rip App: renderer route state layouts must be an array'

    # Staying navigation: same page, same params, same layout chain,
    # only the query moved — the mounted instance keeps its identity and
    # receives load(params, query), unless a query-keyed gate now
    # addresses a different cell. Identical remount() calls still rebuild
    # (explicit refresh); publication rebuild must not churn route
    # identity — that soft path lives in router.rebuild.
    mountedFiles = mountedEntries.map (entry) -> entry.file
    forcedFrom = forceFrom
    forceFrom = null
    if not forcedFrom? and current? and lastRoute? and route.file is lastRoute.file
      if sameChain([...layoutFiles, route.file], mountedFiles) and shallowEqual(params, lastRoute.params)
        unless shallowEqual(query, lastRoute.query) or queryKeyedRetargets(mountedEntries, params, query)
          current.load! params, query if typeof current.load is 'function'
          return null if mine isnt generation
          lastRoute = { file: route.file, params, query }
          return current

    # Reuse demands a completed page mount behind it (lastRoute survives
    # only those), an identical layout chain, and kept layouts whose
    # keyed gates still address their constructed cells. A forced dirty
    # remount keeps ancestors above forceFrom and rebuilds from there.
    chainFiles = [...layoutFiles, route.file]
    reusableLayouts = lastRoute? and layoutFiles.length > 0 and
      mountedEntries.length is layoutFiles.length + 1 and
      sameChain(layoutFiles, mountedFiles.slice(0, -1)) and
      not queryKeyedRetargets(mountedEntries.slice(0, -1), params, query)

    firstNew = if forcedFrom?
      Math.max(0, Math.min(forcedFrom, chainFiles.length - 1))
    else if reusableLayouts
      layoutFiles.length
    else
      0
    # Forced remount of only the page (or a suffix) still requires the
    # kept prefix to match the live chain.
    if forcedFrom? and firstNew > 0
      unless mountedEntries.length is chainFiles.length and sameChain(chainFiles.slice(0, firstNew), mountedFiles.slice(0, firstNew))
        firstNew = 0

    entries = []
    for file, index in chainFiles
      if index < firstNew
        entries.push mountedEntries[index]
      else
        entries.push { file, cls: componentFrom(componentRegistry, file) }
    fresh = entries.slice firstNew

    try
      ready = ensureGates! fresh, params, query, mine
      return null unless ready
    catch caught
      failure: any = caught
      return null if mine isnt generation
      if failure?.name is 'GateFailure' and typeof failure.entryIndex is 'number'
        boundaryIndex = failure.entryIndex + firstNew
        if boundaryIndex > 0
          handled = if reusableLayouts
            boundaryOnMounted entries.slice(0, boundaryIndex), failure
          else
            mountBoundary entries.slice(0, boundaryIndex), failure, mine
          return null if handled
      throw failure

    staging = stagingTarget()
    mountPoint = staging
    built = []
    keptParent = if firstNew > 0 then entries[firstNew - 1].instance else null
    keepPrefix = firstNew > 0
    # A forced dirty remount (apply) keeps the same prefix rule as layout
    # reuse: the rebuilt suffix commits into the KEPT parent's slot — the
    # innermost living layout's outlet when only the page rebuilds, an
    # outer layout's outlet when a layout rebuilds too. (The previous
    # page slot belongs to the subtree being replaced.)
    into = if keepPrefix then layoutMountPoint(keptParent, target) else target
    try
      for entry, index in entries.slice(firstNew)
        parent = built[built.length - 1] ?? keptParent
        instance = construct entry, parent
        built.push instance
        entry.instance = instance
        # The first rebuilt entry mounts into staging and claims its real
        # slot at commit; the ones below mount straight into live slots.
        claimSlot entry, mountPoint if index > 0
        instance.mount? mountPoint
        if instance._state is 'failed'
          throw Error.new "Rip App: component '#{entry.file}' failed during mount"
        if firstNew + index < entries.length - 1
          mountPoint = layoutMountPoint instance, mountPoint
      if mine isnt generation
        cleanup built
        return null
      claimSlot entries[firstNew], into if keepPrefix
      commitStaging staging, into
      # Staging fragments are empty after commit — drop them as `_target`
      # so HMR patch reinserts into the live parent, not the husk.
      for instance in built
        instance._target = null if instance._target?.nodeType is 11
    catch error
      cleanup built
      throw error

    oldInstances = if keepPrefix then instances.slice(firstNew) else instances
    keptInstances = if keepPrefix then instances.slice(0, firstNew) else []
    instances = [...keptInstances, ...built]
    current = built[built.length - 1] ?? null
    # The page slot is the innermost layout's outlet: the last rebuilt
    # layout's when one was rebuilt, else the kept parent's.
    pageMountPoint = if entries.length is 1 then null else if built.length > 1 then mountPoint else into
    mountedEntries = entries
    lastRoute = { file: route.file, params, query }
    teardownErrors = cleanup oldInstances
    lastCommitTeardownFailed = teardownErrors.length > 0
    if teardownErrors.length
      # The replacement DOM and renderer state are already committed. Report
      # teardown as a diagnostic; throwing here would falsely invite callers
      # to roll back source state that can no longer match the live renderer.
      for error in teardownErrors
        failure = failureFor '<teardown>', '<renderer>', error
        if onError?
          try onError(failure) catch reportError then console.error '[Rip] renderer teardown reporter failed:', reportError
        else
          console.error '[Rip] renderer teardown error:', failure
    current

  # Link-intent preloading: warm the gate cells that navigating to
  # `info` would construct, through cell.preload() — its freshness
  # floor bridges the hover into the navigation's own ensure() without
  # a double fetch. Warm only what a navigation would actually
  # (re)construct: a layout chain that stays mounted keeps its live
  # gate bindings, so only the page warms then; a destination already
  # fully mounted warms nothing. A preload never surfaces a failure —
  # the cell records it and the navigation's gate retries and reports.
  preload = (info) ->
    route = info?.route
    return unless route?.file
    params = info.params ?? {}
    query = info.query ?? {}
    layoutFiles = info.layouts ?? route.layouts ?? []
    mountedFiles = mountedEntries.map (entry) -> entry.file
    layoutsStay = lastRoute? and sameChain(layoutFiles, mountedFiles.slice(0, -1))
    return if layoutsStay and route.file is lastRoute.file and shallowEqual(params, lastRoute.params)
    files = if layoutsStay then [route.file] else [...layoutFiles, route.file]
    try
      entries = ({ file, cls: componentFrom(components, file) } for file in files)
      jobs = gateJobs entries, params, query
    catch error
      return
    job.cell.preload().catch(-> null) for job in jobs
    return

  # Resolve the replacement constructor for a living HMR id from a
  # staged module. Returns null when the module does not export it.
  hmrCtorFor = (module, hmrId) ->
    return null unless module? and typeof module is 'object' and typeof hmrId is 'string'
    isComponent = (value) -> typeof value is 'function' and value.__hmrId is hmrId
    return module.default if isComponent module.default
    for key, value of module
      return value if isComponent value
    null

  # Every living instance a dirty module must account for: its entries in
  # the mounted chain and every registered instance under its id prefix.
  # Each instance is paired with its chain entry when it has one — found
  # by identity, so a layout whose route file re-exports a component
  # defined elsewhere still reseats its descendants after a patch.
  # Snapshotted before any patch runs — patching mutates the registry.
  livingFor = (path) ->
    prefix = path + '#'
    found = []
    for entry in mountedEntries when entry.file is path and entry.instance?
      found.push entry.instance
    for [id, reg] in __hmrEntries() when typeof id is 'string' and id.startsWith(prefix)
      for instance in reg.instances
        found.push instance unless found.includes instance
    for instance in found
      { instance, entry: mountedEntries.find((entry) -> entry.instance is instance) ?? null }

  # Signature-aware refresh: patch living instances when the compiler
  # signatures allow. The verdict names what the dirty set contained:
  #   'done'     — living instances were patched (layouts reseat their
  #                descendants; see reseatChain)
  #   'fallback' — a living instance exists that no patch can carry
  #                (incompatible signature, vanished or deleted
  #                definition, an instance that is not mounted): the
  #                remount floor below takes over
  #   'idle'     — every dirty module is accounted for and none has a
  #                living instance: a module that exports no
  #                HMR-identified component reaches the page only
  #                through importers, which the dirty set carries
  #   'unknown'  — a dirty module the candidate cannot account for (a
  #                path it still holds but did not compile): the floor
  #                is the honest tier
  tryHmrPatch = (paths, candidate) ->
    dirty = (path for path in paths when typeof path is 'string' and path.endsWith('.rip'))
    return 'unknown' unless dirty.length > 0
    patched = 0
    unknown = false
    seen = Set.new()
    for path in dirty
      module = candidate.getCompiled path
      living = livingFor path
      unless module?
        # A deleted path has no view to patch into: its living instances
        # fall to the floor, and none at all is nothing to do. A path the
        # candidate still holds but did not compile is unaccounted for.
        if typeof candidate.exists is 'function' and not candidate.exists(path)
          return 'fallback' if living.some (item) -> item.instance._state isnt 'unmounted'
        else
          unknown = true
        continue
      for { instance, entry } in living
        continue if seen.has instance
        # Torn down earlier in this round (a parent and its child exported
        # by one module): nothing left to patch. Any other state that is
        # not mounted — failed, or constructed and never mounted — is a
        # living instance no patch can carry.
        continue if instance._state is 'unmounted'
        return 'fallback' unless instance._state is 'mounted'
        id = instance.constructor?.__hmrId
        NewCtor = if typeof id is 'string' then hmrCtorFor(module, id) else null
        return 'fallback' unless NewCtor?
        __hmrRegisterDefinition NewCtor
        return 'fallback' unless __hmrClassify(instance.constructor, NewCtor) is 'patch'
        __hmrPatch instance, NewCtor
        seen.add instance
        patched += 1
        if entry?
          entry.cls = NewCtor
          reseatChain() unless entry is mountedEntries[mountedEntries.length - 1]
    return 'done' if patched > 0
    if unknown then 'unknown' else 'idle'

  # Publication apply seam: signature patch when possible, otherwise
  # remount living route/layout instances from the first dirty module
  # down, keeping ancestor layouts and the live stash. Stash-module
  # edits escape to document reload (rare definition change). A dirty
  # set with no living instance is a noop while the current route is the
  # mounted one: the Workspace commit carries the new source to the next
  # navigation that mounts it.
  remountDirty = (paths, candidate = components) ->
    return 'noop' unless Array.isArray(paths) and paths.length > 0
    for path in paths
      return 'escape' if path is 'stash.rip' or path.startsWith('stash/') or path is 'data.rip'
    info = router.current
    return 'noop' unless info?.route?.file and lastRoute?
    layoutFiles = info.layouts ?? info.route.layouts ?? []
    chain = [...layoutFiles, info.route.file]
    # After a navigation whose mount failed, the previous screen is still
    # up and the current route's modules have no living instance: that is
    # not idle — the floor mounts the route once its modules are fixed.
    routeMounted = sameChain chain, mountedEntries.map((entry) -> entry.file)
    snap = __hmrSnapshotUi()
    try
      verdict = tryHmrPatch paths, candidate
      if verdict is 'done'
        __hmrRestoreUi snap
        return 'narrow'
      if verdict is 'idle' and routeMounted
        __hmrEmit 'noop', paths: [...paths]
        return 'noop'
    catch error
      # A failed patch falls through to remount — never leave a half-patched tree.
      console.error '[Rip] HMR patch failed; falling back to remount:', error
      __hmrEmit 'reject',
        reason: 'patch-failed'
        paths: [...paths]
        message: error?.message ? String(error.message) : String(error)
    dirty = Set.new paths
    firstDirty = -1
    for file, index in chain
      if dirty.has file
        firstDirty = index
        break
    # A dirty module not in the chain (a shared App child) still
    # remounts the page — migrate/remount floor for that leaf.
    firstDirty = chain.length - 1 if firstDirty < 0
    # Snapshot migrate-tier state before the remount floor replaces instances.
    migrateKeep = []
    for index in [firstDirty...chain.length]
      entry = mountedEntries[index]
      continue unless entry?.instance? and entry.file?
      id = entry.instance.constructor?.__hmrId
      continue unless typeof id is 'string'
      NewCtor = hmrCtorFor candidate.getCompiled(entry.file), id
      continue unless NewCtor?
      continue unless __hmrClassify(entry.instance.constructor, NewCtor) is 'migrate'
      migrateKeep.push { file: entry.file, instance: entry.instance, id }
    forceFrom = firstDirty
    lastCommitTeardownFailed = false
    expectedGeneration = generation + 1
    try
      mount! info, candidate
      for keep in migrateKeep
        next = mountedEntries.find (entry) -> entry.file is keep.file and entry.instance?
        continue unless next?.instance?
        continue unless next.instance.constructor?.__hmrId is keep.id
        __hmrPreserveState keep.instance, next.instance
      __hmrEmit 'remount',
        paths: [...dirty]
        from: firstDirty
        migrate: migrateKeep.length
    catch error
      forceFrom = null
      throw error
    finally
      __hmrRestoreUi snap
    if generation isnt expectedGeneration or lastCommitTeardownFailed then 'reload' else 'narrow'

  mount = (info, componentRegistry = components) ->
    mine = ++generation
    router.navigating = true if 'navigating' in router
    try
      performMount! info, mine, componentRegistry
    catch caught
      error = caught as any
      return null if mine isnt generation
      failure: GateFailure = if error?.name is 'GateFailure'
        error
      else
        file = info?.route?.file ?? '<route>'
        failureFor (error?.path ?? file), file, error
      onError? failure
      showFatalCard failure unless current?
      throw failure
    finally
      router.navigating = false if mine is generation and 'navigating' in router

  renderer = null
  renderer =
    current: null
    mount: mount
    preload: preload
    remountDirty: remountDirty
    start: ->
      return renderer if disposeRoute
      router.init?()
      disposeRoute = __effect ->
        info = router.current
        mount(info).catch(-> null) if info?.route
        return
      renderer
    stop: ->
      # Bump first so every in-flight mount becomes stale; stop owns the
      # navigating reset, while each stale mount's finally leaves it alone.
      generation++
      disposeRoute?()
      disposeRoute = null
      router.navigating = false if 'navigating' in router
      try
        unmount()
      catch caught
        error = caught as any
        failure = failureFor '<teardown>', '<renderer>', error
        onError? failure
        throw failure
      return

  Object.defineProperty renderer, 'current', get: -> current
  renderer
