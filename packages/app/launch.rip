# Launch — the one supported application boot path.
#
# launch() receives a bundle OBJECT and assembles the app: the stash
# from its declaration, seeded; component registry, route manifest,
# router, and renderer,
# wired together and started. Fetching bundles, compiling sources, and
# watch transports belong to browser delivery; launch stays
# Node-testable by taking every host concern as an option with the
# browser default applied only when omitted.
#
# The bundle shape:
#
#   modules    route/app sources keyed by store path (registry text)
#   compiled   precompiled module objects keyed by store path
#   seed       values overlaid onto the stash at boot — a seed never
#              overwrites a source cell
#
# The application declares its stash in the bundle module
# `stash.rip` through its `stash` export; the `declaration` option
# overrides it for tests and embedding hosts. The declaration is the
# baseline (cells by reference, plain values as defaults); the bundle's
# `seed` is overlaid on top of it.
#
# The `components` option injects the component store (Workspace implements
# the same interface); omitted,
# launch creates its own store and behavior is unchanged.
#
# A second launch while one is live rejects loudly, as does a malformed
# bundle. destroy() tears down in reverse and restores every global it
# installed.

import { createStash, _cloneDeclaration, _stampDefaults, _mergePlain } from './stash.rip'
import { createComponents, ComponentsStore } from './components.rip'
import { buildRoutes } from './routes.rip'
import { createRouter, browserAdapter, RouterAdapter, Router } from './router.rip'
import { createRenderer, Renderer, GateFailure } from './renderer.rip'
import { interceptClicks, preloadLinks, LinkHost } from './links.rip'
import { ariaCurrent } from './aria.rip'
import { persistStash, StashStorage } from './persist.rip'

export type LaunchOpts =
  bundle: Record<string, any>
  target?: Record<string, any>
  adapter?: RouterAdapter
  base?: string
  hash?: boolean
  declaration?: Record<string, any>
  components?: ComponentsStore
  links?: LinkHost
  persist?: boolean | 'local' | 'session'
  storage?: StashStorage
  onError?: (failure: GateFailure | { status: number, path: string }) => void

export type LaunchResult =
  stash: Record<string, any>
  components: ComponentsStore
  router: Router
  renderer: Renderer
  destroy: () => void

ROUTE_ROOT = 'routes'

fail = (message) -> throw Error.new "Rip App: #{message}"

validBundle = (bundle) ->
  fail 'launch requires a bundle object' unless bundle? and typeof bundle is 'object' and not Array.isArray(bundle)
  for key in ['modules', 'compiled']
    section = bundle[key]
    continue unless section?
    unless typeof section is 'object' and not Array.isArray(section)
      fail "launch bundle #{key} must be an object of store paths"
  if bundle.seed? and (typeof bundle.seed isnt 'object' or Array.isArray(bundle.seed))
    fail 'launch bundle seed must be an object'
  bundle

STORE_METHODS = ['read', 'write', 'del', 'exists', 'size', 'list', 'listAll', 'load', 'watch', 'getCompiled', 'setCompiled']

validComponents = (store) ->
  fail 'launch components must be an object' unless typeof store is 'object' and not Array.isArray(store)
  for method in STORE_METHODS
    unless typeof store[method] is 'function'
      fail "launch components store is missing '#{method}'"
  store

export validatePrepared = (value, declaration = null) ->
  bundle = validBundle value
  paths = Set.new [
    ...Object.keys(bundle.modules ?? {})
    ...Object.keys(bundle.compiled ?? {})
  ]
  routePaths = [...paths].filter (path) -> path.startsWith ROUTE_ROOT + '/'
  buildRoutes routePaths, ROUTE_ROOT
  stashModule = bundle.compiled?['stash.rip']
  declared = declaration ?? stashModule?.stash
  if not declared? and stashModule?
    fail "the bundle's 'stash.rip' module must export 'stash'"
  if declared? and (typeof declared isnt 'object' or Array.isArray(declared))
    fail 'the application stash must be a plain object'
  { bundle, declaration: declared }

defaultTarget = ->
  unless typeof document isnt 'undefined' and typeof document.querySelector is 'function'
    fail 'launch requires a target outside the browser'
  found = document.querySelector '#app'
  unless found
    found = document.createElement 'div'
    found.id = 'app'
    document.body.appendChild found
  found

export def launch(opts: LaunchOpts): LaunchResult
  fail 'launch requires an options object' unless opts? and typeof opts is 'object'
  fail 'an application is already launched; destroy it first' if globalThis.__ripStash?
  prepared = validatePrepared opts.bundle, opts.declaration
  bundle = prepared.bundle
  target = opts.target ?? defaultTarget()
  adapter = opts.adapter ?? browserAdapter()

  # The declaration: an explicit option wins; otherwise the bundle's
  # `stash.rip` module provides it through its `stash` export.
  # A stash module without the export is a named mistake, never a
  # silently empty application.
  declaration = prepared.declaration
  # The declaration clones on the way in (cells by reference): the
  # object outlives this launch, and its next launch must start from
  # the declared baseline, not this session's writes.
  stash = createStash _cloneDeclaration(declaration ?? {})

  # Seed overlay: the bundle seed merges onto plain keys at every depth; a
  # live source — singleton or keyed family, top-level or nested — is
  # never touched by a JSON seed.
  _mergePlain stash, bundle.seed ?? {}
  _stampDefaults stash

  components = if opts.components? then validComponents(opts.components) else createComponents()
  components.load bundle.modules if bundle.modules?
  if bundle.compiled?
    for own path, module of bundle.compiled
      components.write path, '' unless components.exists path
      components.setCompiled path, module

  router = createRouter
    routes: -> buildRoutes components.listAll(ROUTE_ROOT), ROUTE_ROOT
    adapter: adapter
    base: opts.base
    hash: opts.hash
    onError: opts.onError

  renderer = createRenderer
    router: router
    stash: stash
    components: components
    target: target
    onError: opts.onError

  unwatch = components.watch (_event, path) ->
    router.rebuild() if path.startsWith(ROUTE_ROOT + '/')

  # Same-origin `<a>` clicks navigate the router and hovered or focused
  # owned links preload their render gates — both delegate ownership to
  # `ownsAnchor` and both delegate on the document. Under Node there is
  # no document to delegate on, so without an injected `links` host the
  # listeners simply do not install.
  disposeLinks = null
  if opts.links? or (typeof document isnt 'undefined' and typeof document.addEventListener is 'function')
    removeClicks = interceptClicks router, opts.links
    removePreload = preloadLinks router, renderer, opts.links
    disposeLinks = ->
      removeClicks()
      removePreload()
      return

  # `aria-current` stays truthful by default: the walker installs
  # whenever a usable document exists (its own browser-host
  # precondition) and disposes with the launch. Marks the application
  # manages itself are never set over and never removed — the walker's
  # own contract (aria.rip).
  disposeAria = null
  if typeof document isnt 'undefined' and typeof document.querySelectorAll is 'function'
    disposeAria = ariaCurrent router

  disposePersist = null
  if opts.persist
    disposePersist = persistStash stash,
      local: opts.persist is 'local'
      key: '__rip_app'
      storage: opts.storage

  destroyed = false
  destroy = ->
    return if destroyed
    destroyed = true
    # Every disposer runs; errors aggregate. Globals ALWAYS clear — a
    # stuck __ripStash bricks every future launch. Destroy latches
    # `destroyed` before work so a mid-teardown throw cannot leave the
    # sentinel set with no recovery path.
    errors = []
    run = (fn) ->
      try
        fn()
      catch e
        errors.push e
      return
    run -> disposeAria?()
    run -> disposeLinks?()
    run -> renderer.stop()
    run -> router.destroy()
    run -> unwatch()
    run -> disposePersist?()
    delete globalThis.__ripStash if globalThis.__ripStash is stash
    delete globalThis.__ripRouter if globalThis.__ripRouter is router
    if errors.length is 1
      throw errors[0]
    if errors.length > 1
      throw AggregateError.new errors, 'Rip App: launch.destroy failed'
    return

  # A failing start must not wedge the process: destroy clears the
  # globals even when a disposer throws, then the failure propagates.
  globalThis.__ripStash = stash
  globalThis.__ripRouter = router
  try
    # #app may hold a static loader; from here the mount point is the
    # renderer's. Drop placeholders so the first commit is not stacked
    # under a full-viewport spinner (append-only commit).
    if typeof target.replaceChildren is 'function'
      target.replaceChildren()
    else if Array.isArray(target.children)
      target.children.length = 0
    renderer.start()
  catch error
    destroy()
    throw error

  { stash, components, router, renderer, destroy }
