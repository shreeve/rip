# ==============================================================================
# Publication feed — ordered watch changes plus latest.json reconnect recovery
#
# The feed owns transport ordering only. Browser boot owns bundle syntax,
# compilation, activation, and apply policy through the three client callbacks.
# ==============================================================================

export type Feed =
  close: () => void
  connected: () => boolean
  resync: () => Promise<void>

export type PublicationClient =
  hash: () => string
  apply: (change: Record<string, unknown>) => Promise<boolean | 'rejected' | 'reload'>
  reload: (reason?: string) => void

export type ConnectFeedOpts =
  hub?: string
  latestUrl?: string
  makeSocket?: (url: string) => any
  fetch?: (url: string, opts?: Record<string, unknown>) => Promise<any>
  report?: (...args: any[]) => void
  backoff?: { min?: number, max?: number }
  ackTimeout?: number

FEED_BACKOFF_MIN = 250
FEED_BACKOFF_MAX = 8000
FEED_ACK_TIMEOUT = 5000
serial = 0

validHash = (hash) -> typeof hash is 'string' and /^[A-Za-z0-9_]{6}$/.test(hash)

defaultHubUrl = ->
  if typeof location is 'undefined'
    throw Error.new 'Rip App: connectFeed needs a hub URL (no location to derive one from)'
  scheme = if location.protocol is 'https:' then 'wss' else 'ws'
  "#{scheme}://#{location.host}/hub"

defaultSocketFactory = ->
  if typeof WebSocket is 'undefined'
    throw Error.new 'Rip App: connectFeed needs a socket factory (no global WebSocket)'
  (url) -> WebSocket.new(url)

defaultFetch = ->
  if typeof fetch is 'undefined'
    throw Error.new 'Rip App: connectFeed needs a fetch (no global fetch)'
  (url, opts) -> fetch(url, opts)

export def connectFeed(client: PublicationClient, opts: ConnectFeedOpts = {}): Feed
  unless client? and typeof client.hash is 'function' and typeof client.apply is 'function' and typeof client.reload is 'function'
    throw TypeError.new 'Rip App: connectFeed expects hash, apply, and reload callbacks'
  unless validHash client.hash()
    throw TypeError.new 'Rip App: connectFeed client hash must be six Base64URL-folded characters'

  hubUrl = opts.hub ?? defaultHubUrl()
  latestUrl = opts.latestUrl ?? '/latest.json'
  makeSocket = opts.makeSocket ?? defaultSocketFactory()
  fetchLatest = opts.fetch ?? defaultFetch()
  report = opts.report ?? (...args) -> console.error ...args
  backoffMin = opts.backoff?.min ?? FEED_BACKOFF_MIN
  backoffMax = opts.backoff?.max ?? FEED_BACKOFF_MAX
  ackTimeout = opts.ackTimeout ?? FEED_ACK_TIMEOUT

  closed = false
  failed = false
  isOpen = false
  ready = false
  socket = null
  attempts = 0
  reconnectTimer = null
  ackTimer = null
  connection = 0
  token = null
  buffer = []
  tail = Promise.resolve()
  probes = Map.new()
  rejectedHash = null

  reload = (reason) ->
    return if failed or closed
    failed = true
    client.reload reason
    return

  applyOne = (change) ->
    return false if failed or closed
    try
      verdict = client.apply! change
      if verdict is 'rejected'
        rejectedHash = change?.hash if validHash(change?.hash)
        return false
      if verdict is 'reload' or not verdict
        reload 'change could not be applied'
        return false
      rejectedHash = null
      true
    catch error
      report '[Rip] publication change failed:', error
      reload 'change failed'
      false

  enqueue = (change, owner) ->
    tail = tail.then ->
      return true if owner isnt connection
      applyOne! change
    tail = tail.catch (error) ->
      report '[Rip] publication queue failed:', error
      reload 'change queue failed'
      false
    return

  probe = (owner) ->
    return if closed or failed or owner isnt connection
    startHash = client.hash()
    response = fetchLatest! latestUrl, { cache: 'no-store' }
    unless response?.ok
      throw Error.new "latest.json fetch failed (#{response?.status})"
    latest = response.json!
    unless latest? and typeof latest is 'object' and not Array.isArray(latest) and validHash(latest.hash)
      throw Error.new 'latest.json is malformed'
    return if closed or failed or owner isnt connection

    if rejectedHash?
      if latest.hash isnt rejectedHash
        reload "a newer App generation followed rejected #{rejectedHash}"
        return
      buffer = []
      ready = true
      attempts = 0
      return

    # The probe may overlap changes received after subscription. A latest hash
    # equal to the starting state or any state reached by the buffered chain is
    # coherent; any other hash proves that a transition was missed.
    visited = Set.new [startHash]
    index = 0
    while index < buffer.length
      ok = applyOne! buffer[index]
      unless ok
        beyondRejected = rejectedHash? and (
          latest.hash isnt rejectedHash or
          buffer.slice(index + 1).some((change) -> change?.hash isnt rejectedHash)
        )
        buffer = []
        if beyondRejected
          reload "a newer App generation followed rejected #{rejectedHash}"
          return
        ready = true
        attempts = 0
        return
      return if closed or failed or owner isnt connection
      visited.add client.hash()
      index++
    return if closed or failed or owner isnt connection
    unless visited.has latest.hash
      reload "latest App hash #{latest.hash} is not in the received change chain"
      return
    buffer = []
    ready = true
    attempts = 0
    return

  beginProbe = (owner = connection, repeat = false) ->
    return probes.get(owner) if probes.has(owner) and not repeat
    # A closing connection may still have one asynchronous apply in flight.
    # Put the reconnect probe behind that same queue so every connection
    # observes one total publication order.
    task = tail.then -> probe owner
    task = task.catch (error) ->
      return if closed or failed or owner isnt connection
      report '[Rip] publication reconnect check failed:', error
      ready = false
      try socket?.close()
    tail = task.then (-> true), (-> false)
    probes.set owner, task
    task.finally -> probes.delete owner if probes.get(owner) is task
    task

  handleFrame = (text, owner) ->
    return if owner isnt connection
    frame = null
    try
      frame = JSON.parse text
    catch
      report '[Rip] publication feed received invalid JSON:', text
      reload 'malformed publication frame'
      return
    objects = if Array.isArray(frame) then frame else [frame]
    for object in objects
      continue unless object? and typeof object is 'object'
      if object['!'] is token
        if ackTimer?
          clearTimeout ackTimer
          ackTimer = null
        beginProbe connection
      # Janus stamps every client-originated event with `<`. Publication
      # changes enter through the server control plane and carry no sender
      # provenance; accepting a stamped frame would let an App client inject
      # source into every other subscriber on the shared Hub.
      else if object.change isnt undefined and not Object.hasOwn(object, '<')
        if rejectedHash?
          if object.change?.hash is rejectedHash
            continue
          reload "a newer App generation followed rejected #{rejectedHash}"
        else if ready then enqueue object.change, owner else buffer.push object.change
      else if object.reload isnt undefined and not Object.hasOwn(object, '<')
        if rejectedHash? then beginProbe(owner, true) else reload 'server generation changed'
    return

  schedule = ->
    return if closed or failed or reconnectTimer?
    delay = Math.min backoffMin * 2 ** attempts, backoffMax
    attempts += 1
    reconnectTimer = setTimeout (->
      reconnectTimer = null
      connect()
    ), delay
    return

  connect = ->
    return if closed or failed
    connection += 1
    owner = connection
    ready = false
    buffer = []
    token = "rip-#{++serial}"
    try
      socket = makeSocket hubUrl
    catch error
      report '[Rip] publication socket open failed:', error
      schedule()
      return
    socket.onmessage = (event) ->
      handleFrame String(event.data), owner
      return
    socket.onopen = ->
      return if owner isnt connection or closed
      isOpen = true
      try
        socket.send JSON.stringify({ '+': ['/hub'], '?': token })
      catch error
        report '[Rip] publication subscription failed:', error
        try socket.close()
        return
      ackTimer = setTimeout (->
        return if closed or failed or owner isnt connection or ready
        report '[Rip] publication subscription acknowledgement timed out'
        try socket.close()
      ), ackTimeout
      return
    socket.onclose = ->
      return if owner isnt connection
      isOpen = false
      ready = false
      if ackTimer?
        clearTimeout ackTimer
        ackTimer = null
      schedule()
      return
    socket.onerror = -> return
    return

  resync = ->
    return if closed or failed
    if socket?
      try socket.close()
    else
      schedule()
    return

  listeners = []
  listen = (target, name, fn) ->
    return unless typeof target?.addEventListener is 'function'
    target.addEventListener name, fn
    listeners.push -> target.removeEventListener name, fn
    return
  listen globalThis, 'online', -> resync()
  listen globalThis, 'pageshow', (event) -> resync() if event.persisted is true
  if typeof document isnt 'undefined'
    listen document, 'visibilitychange', -> resync() if document.visibilityState is 'visible'

  connect()

  {
    close: ->
      return if closed
      closed = true
      connection += 1
      clearTimeout reconnectTimer if reconnectTimer?
      clearTimeout ackTimer if ackTimer?
      dispose() for dispose in listeners
      try socket?.close()
      return
    connected: -> isOpen and ready and not closed and not failed
    resync: -> resync()
  }
