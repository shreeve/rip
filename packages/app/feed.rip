# ==============================================================================
# Workspace feed — hash hints over Hub, latest bytes over HTTP
# ==============================================================================

import { rash } from './rash.rip'

export type Feed =
  close: () => void
  connected: () => boolean
  resync: () => Promise<void>

export type ConnectFeedOpts =
  hub?: string
  makeSocket?: (url: string) => any
  fetch?: (url: string, opts?: Record<string, unknown>) => Promise<any>
  moduleUrl?: (id: string) => string
  manifestUrl?: string
  report?: (...args: any[]) => void
  onEpoch?: (ding: Record<string, unknown>) => void
  backoff?: { min?: number, max?: number }

FEED_BACKOFF_MIN = 250
FEED_BACKOFF_MAX = 8000

defaultHubUrl = ->
  if typeof location is 'undefined'
    throw new Error 'Rip Workspace: connectFeed needs a hub URL (no location to derive one from)'
  scheme = if location.protocol is 'https:' then 'wss' else 'ws'
  "#{scheme}://#{location.host}/hub"

defaultSocketFactory = ->
  if typeof WebSocket is 'undefined'
    throw new Error 'Rip Workspace: connectFeed needs a socket factory (no global WebSocket)'
  (url) -> new WebSocket(url)

defaultFetch = ->
  if typeof fetch is 'undefined'
    throw new Error 'Rip Workspace: connectFeed needs a fetch (no global fetch)'
  (url, opts) -> fetch(url, opts)

defaultModuleUrl = (id) ->
  path = if id.startsWith('app/') then id.slice('app/'.length) else id
  '/' + path.split('/').map(encodeURIComponent).join('/')
validWireHash = (hash) -> typeof hash is 'string' and /^[A-Za-z0-9_]{6}$/.test(hash)

export def connectFeed(workspace, opts: ConnectFeedOpts = {}): Feed
  unless workspace? and typeof workspace.set is 'function' and typeof workspace.passport is 'function' and typeof workspace.sealed is 'function'
    throw new TypeError 'Rip Workspace: connectFeed expects a workspace'
  if workspace.sealed()
    throw new Error 'Rip Workspace: connectFeed on a sealed workspace — production has no hub'

  hubUrl = opts.hub ?? defaultHubUrl()
  makeSocket = opts.makeSocket ?? defaultSocketFactory()
  fetchBytes = opts.fetch ?? defaultFetch()
  moduleUrl = opts.moduleUrl ?? defaultModuleUrl
  manifestUrl = opts.manifestUrl ?? '/manifest.json'
  report = opts.report ?? (...args) -> console.error(...args)
  backoffMin = opts.backoff?.min ?? FEED_BACKOFF_MIN
  backoffMax = opts.backoff?.max ?? FEED_BACKOFF_MAX
  onEpoch = opts.onEpoch ?? (ding) ->
    report "[Rip] workspace feed: a new epoch is live (#{ding.epoch}) — reloading"
    location.reload() if typeof location isnt 'undefined'
    return

  closed = false
  isOpen = false
  socket = null
  attempts = 0
  timer = null
  resyncTimer = null
  resyncAttempts = 0
  wants = {}       # id → { hash, sig }: hint not yet healed
  owners = {}      # id → request/apply owner token

  claim = (id) ->
    owners[id] = (owners[id] or 0) + 1
    workspace.claim?(id, owners[id])
    owners[id]

  owns = (id, owner) -> owners[id] is owner and not closed

  fetchLatest = (id, owner) ->
    res = fetchBytes! moduleUrl(id), { cache: 'no-store' }
    return { res } unless res.ok
    bytes = new Uint8Array(res.arrayBuffer!)
    return null unless owns(id, owner)
    { res, hash: rash(bytes), source: new TextDecoder().decode(bytes) }

  applyLatest = (id, owner) ->
    result = fetchLatest! id, owner
    return { stale: true } unless result? and owns(id, owner)
    return { status: result?.res?.status, ok: false } unless result.res.ok
    current = workspace.passport id
    passport: any = { id, hash: result.hash, source: result.source, owner }
    passport.path = id unless current?
    applied = workspace.set! passport
    delete wants[id] if owns(id, owner)
    { ok: true, hash: result.hash, applied }

  wantsSatisfied = ->
    for id, want of wants
      current = workspace.passport id
      delete wants[id] if current? and current.hash is want.hash
    Object.keys(wants).length is 0

  scheduleResync = ->
    return if closed or resyncTimer?
    delay = Math.min backoffMin * 2 ** resyncAttempts, backoffMax
    resyncAttempts += 1
    resyncTimer = setTimeout (->
      resyncTimer = null
      resync().catch (error) -> report '[Rip] workspace feed: resync failed:', error
    ), delay
    return

  # Additive-and-forward: manifests never delete local/editor passports.
  resync = ->
    clean = true
    res = fetchBytes! manifestUrl, { cache: 'no-cache' }
    unless res.ok
      report "[Rip] workspace feed: manifest fetch failed (#{res.status})"
      scheduleResync()
      return
    manifest = res.json!
    files = manifest?.files
    unless Array.isArray files
      report '[Rip] workspace feed: malformed manifest:', manifest
      return
    named = new Set()
    for entry in files
      unless entry? and typeof entry.id is 'string' and validWireHash(entry.hash)
        report '[Rip] workspace feed: malformed manifest entry:', entry
        clean = false
        continue
      named.add entry.id
      current = workspace.passport entry.id
      continue if current? and current.hash is entry.hash
      owner = claim entry.id
      result = applyLatest! entry.id, owner
      unless result?.ok or result?.stale
        report "[Rip] workspace feed: module fetch missed (#{result?.status}) for '#{entry.id}' during resync"
        wants[entry.id] = { hash: entry.hash, sig: null }
        clean = false

    sig = JSON.stringify files
    for id of { ...wants }
      want = wants[id]
      current = workspace.passport id
      if current? and current.hash is want.hash
        delete wants[id]
        continue
      # A successful latest fetch satisfies the want even when the hint was
      # already superseded. Missing paths need two distinct manifest views
      # before retirement is inferred.
      owner = claim id
      result = applyLatest! id, owner
      if result?.ok
        delete wants[id]
      else if not result?.stale and not named.has(id)
        if want.sig? and want.sig isnt sig
          delete wants[id] if wants[id] is want
        else
          want.sig = sig
      else unless result?.stale
        clean = false
    if clean and wantsSatisfied()
      resyncAttempts = 0
    else
      scheduleResync()
    return

  applyDing = (ding) ->
    if ding? and typeof ding is 'object' and ding.kind is 'epoch'
      onEpoch ding
      return
    unless ding? and typeof ding is 'object' and typeof ding.id is 'string'
      report '[Rip] workspace feed: malformed ding:', ding
      return
    { id, kind, hash } = ding
    unless validWireHash(hash)
      report "[Rip] workspace feed: malformed #{if kind is 'delete' then 'delete ' else ''}ding:", ding
      return
    if kind is 'delete'
      claim id
      delete wants[id]
      workspace.set { id, hash, deleted: true, owner: owners[id] }
      return
    current = workspace.passport id
    return if current? and current.hash is hash
    owner = claim id
    result = applyLatest! id, owner
    return if result?.stale or result?.ok
    report "[Rip] workspace feed: module fetch missed (#{result?.status}) for '#{id}' — resyncing from the manifest"
    wants[id] = { hash, sig: null }
    resync!
    return

  handleFrame = (text) ->
    frame = null
    try
      frame = JSON.parse text
    catch
      report '[Rip] workspace feed: unparseable hub frame:', text
      return
    objects = if Array.isArray(frame) then frame else [frame]
    for obj in objects
      continue unless obj? and typeof obj is 'object' and obj.ding isnt undefined
      applyDing(obj.ding).catch (error) -> report '[Rip] workspace feed: ding apply failed:', error
    return

  schedule = ->
    return if closed or timer?
    delay = Math.min backoffMin * 2 ** attempts, backoffMax
    attempts += 1
    timer = setTimeout (->
      timer = null
      connect()
    ), delay
    return

  connect = ->
    return if closed
    try
      socket = makeSocket hubUrl
    catch error
      report '[Rip] workspace feed: socket open failed:', error
      schedule()
      return
    socket.onopen = ->
      isOpen = true
      attempts = 0
      try socket.send(JSON.stringify({ '+': ['/hub'] })) catch error then report '[Rip] workspace feed: self-join failed:', error
      resync().catch (error) -> report '[Rip] workspace feed: resync failed:', error
      return
    socket.onmessage = (event) ->
      handleFrame String(event.data)
      return
    socket.onclose = ->
      isOpen = false
      schedule()
      return
    socket.onerror = -> return
    return

  connect()

  {
    close: ->
      return if closed
      closed = true
      owners[id] += 1 for id of owners
      if timer?
        clearTimeout timer
        timer = null
      if resyncTimer?
        clearTimeout resyncTimer
        resyncTimer = null
      try socket?.close()
      return
    connected: -> isOpen and not closed
    resync: -> resync()
  }
