# ==============================================================================
# The workspace feed — the hub subscriber half of the door (@rip-lang/app)
#
# connectFeed(workspace, opts) opens the app's Janus hub socket and turns
# ding events into passport mutations: a ding carries { id, etag }
# (Q2/Q8′ — never bodies over the hub; never a rev), file bytes ride
# HTTP at /app/…?etag=E (latest representation, 200 or 409), and
# workspace.set applies them. Staleness is etag equality: already holding
# that generation skips the network. A superseded etag answers 409 with
# the current ETag (never a silent stale body); the feed refetches once
# at the current generation. A module fetch that misses resyncs from the
# manifest. Dev/watch only by constitution: production has no hub, and a
# sealed workspace rejects the feed at the door.
# ==============================================================================

export type Feed =
  close: () => void
  connected: () => boolean
  resync: () => Promise<void>

FEED_BACKOFF_MIN = 250
FEED_BACKOFF_MAX = 8000

defaultHubUrl = ->
  if typeof location is 'undefined'
    throw new Error 'Rip Workspace: connectFeed needs a hub URL (no location to derive one from)'
  scheme = if location.protocol is 'https:' then 'wss' else 'ws'
  "#{scheme}://#{location.host}/hub"

defaultSocketFactory = ->
  if typeof WebSocket is 'undefined'
    throw new Error 'Rip Workspace: connectFeed needs a socket factory (no global WebSocket)'
  (url) -> new WebSocket(url)

defaultFetch = ->
  if typeof fetch is 'undefined'
    throw new Error 'Rip Workspace: connectFeed needs a fetch (no global fetch)'
  (url) -> fetch(url)

# Store id `app/mood.rip` → `/app/mood.rip?etag=…` (path segments encoded).
defaultModuleUrl = (id, etag) ->
  path = '/' + id.split('/').map(encodeURIComponent).join('/')
  if typeof etag is 'string' and etag isnt '' then "#{path}?etag=#{etag}" else path

# Strip optional quotes from an ETag header value.
etagToken = (raw) ->
  return null unless typeof raw is 'string' and raw isnt ''
  m = raw.match(/^"([0-9a-f]{16})"$/)
  if m? then m[1] else if /^[0-9a-f]{16}$/.test(raw) then raw else null

validWireEtag = (etag) -> typeof etag is 'string' and /^[0-9a-f]{16}$/.test(etag)

export def connectFeed(workspace, opts = {}): Feed
  unless workspace? and typeof workspace.set is 'function' and typeof workspace.passport is 'function' and typeof workspace.sealed is 'function'
    throw new TypeError 'Rip Workspace: connectFeed expects a workspace'
  if workspace.sealed()
    throw new Error 'Rip Workspace: connectFeed on a sealed workspace — production has no hub'

  hubUrl = opts.hub ?? defaultHubUrl()
  makeSocket = opts.makeSocket ?? defaultSocketFactory()
  fetchBytes = opts.fetch ?? defaultFetch()
  moduleUrl = opts.moduleUrl ?? opts.cellUrl ?? defaultModuleUrl
  manifestUrl = opts.manifestUrl ?? '/manifest.json'
  report = opts.report ?? (...args) -> console.error(...args)
  backoffMin = opts.backoff?.min ?? FEED_BACKOFF_MIN
  backoffMax = opts.backoff?.max ?? FEED_BACKOFF_MAX
  # An epoch ding names a pool swap: the page's code AND its server are
  # both pre-swap, so the apply policy is the full reload — never the
  # file path.
  onEpoch = opts.onEpoch ?? (ding) ->
    report "[Rip] workspace feed: a new epoch is live (#{ding.epoch}) — reloading"
    location.reload() if typeof location isnt 'undefined'
    return

  # Fetch file bytes for a wanted etag. A 409 means the generation was
  # superseded — refetch once at the current ETag from the response.
  fetchModule = (id, etag) ->
    res = fetchBytes! moduleUrl(id, etag)
    if res.status is 409
      next = etagToken(res.headers?.get?('etag') or res.headers?.get?('ETag'))
      return res unless next? and next isnt etag
      return fetchBytes! moduleUrl(id, next)
    res

  closed = false
  isOpen = false
  socket = null
  attempts = 0
  timer = null
  resyncTimer = null
  resyncAttempts = 0
  wants = {}       # id → { etag, sig }: dinged generation not yet applied

  wantsSatisfied = ->
    for id, want of wants
      current = workspace.passport id
      delete wants[id] if current? and current.etag is want.etag
    Object.keys(wants).length is 0

  scheduleResync = ->
    return if closed or resyncTimer?
    delay = Math.min backoffMin * 2 ** resyncAttempts, backoffMax
    resyncAttempts += 1
    resyncTimer = setTimeout (->
      resyncTimer = null
      resync().catch (error) -> report '[Rip] workspace feed: resync failed:', error
    ), delay
    return

  # Reconciliation is additive-and-forward only: the manifest advances
  # what it names and never deletes — the bag legally holds passports the
  # server feed does not own (an editor's local mints). Deletions ride
  # dings alone. A resync that could not fully reconcile schedules its
  # own retry with backoff; a clean one clears the cursor. A structurally
  # malformed manifest is a server bug, reported and never retried into.
  resync = ->
    clean = true
    res = fetchBytes! manifestUrl
    unless res.ok
      report "[Rip] workspace feed: manifest fetch failed (#{res.status})"
      scheduleResync()
      return
    manifest = res.json!()
    files = manifest?.files ?? manifest?.cells
    unless Array.isArray files
      report '[Rip] workspace feed: malformed manifest:', manifest
      return
    named = new Set()
    for entry in files
      etag = entry?.etag ?? entry?.hash
      unless entry? and typeof entry.id is 'string' and validWireEtag(etag)
        report '[Rip] workspace feed: malformed manifest entry:', entry
        continue
      named.add entry.id
      current = workspace.passport entry.id
      if current? and current.etag is etag
        continue
      cres = fetchModule! entry.id, etag
      unless cres.ok
        report "[Rip] workspace feed: module fetch missed (#{cres.status}) for '#{entry.id}' during resync"
        clean = false
        continue
      source = cres.text!()
      applied = etagToken(cres.headers?.get?('etag') or cres.headers?.get?('ETag')) or etag
      cell = { id: entry.id, etag: applied, source }
      cell.path = entry.id unless current?
      workspace.set! cell
    # A want the manifest walk left unsatisfied retries the ding's OWN
    # etag URL. Retirement needs EVIDENCE: a want that a moved manifest
    # still does not name was retired upstream — nothing will ever
    # satisfy it. An unchanged manifest proves nothing either way.
    sig = JSON.stringify files
    for id of { ...wants }
      want = wants[id]
      current = workspace.passport id
      continue if current? and current.etag is want.etag
      cres = fetchModule! id, want.etag
      if cres.ok
        source = cres.text!()
        applied = etagToken(cres.headers?.get?('etag') or cres.headers?.get?('ETag')) or want.etag
        cell = { id, etag: applied, source }
        cell.path = id unless current?
        workspace.set! cell
      else if not named.has(id)
        if want.sig? and want.sig isnt sig
          delete wants[id] if wants[id] is want
        else
          want.sig = sig
    if clean and wantsSatisfied()
      resyncAttempts = 0
    else
      scheduleResync()
    return

  applyDing = (ding) ->
    if ding? and typeof ding is 'object' and ding.kind is 'epoch'
      onEpoch ding
      return
    unless ding? and typeof ding is 'object' and typeof ding.id is 'string'
      report '[Rip] workspace feed: malformed ding:', ding
      return
    { id, kind } = ding
    etag = ding.etag ?? ding.hash
    if kind is 'delete'
      unless validWireEtag(etag)
        report '[Rip] workspace feed: malformed delete ding:', ding
        return
      delete wants[id]
      workspace.set { id, etag, deleted: true }
      return
    unless validWireEtag(etag)
      report '[Rip] workspace feed: malformed ding:', ding
      return
    current = workspace.passport id
    if current? and current.etag is etag
      return
    res = fetchModule! id, etag
    unless res.ok
      report "[Rip] workspace feed: module fetch missed (#{res.status}) for '#{id}' — resyncing from the manifest"
      wants[id] = { etag, sig: null }
      resync!()
      return
    source = res.text!()
    applied = etagToken(res.headers?.get?('etag') or res.headers?.get?('ETag')) or etag
    cell = { id, etag: applied, source }
    cell.path = id unless workspace.passport(id)?
    workspace.set cell
    return

  handleFrame = (text) ->
    frame = null
    try
      frame = JSON.parse text
    catch
      report '[Rip] workspace feed: unparseable hub frame:', text
      return
    objects = if Array.isArray(frame) then frame else [frame]
    for obj in objects
      continue unless obj? and typeof obj is 'object' and obj.ding isnt undefined
      applyDing(obj.ding).catch (error) ->
        report '[Rip] workspace feed: ding apply failed:', error
    return

  schedule = ->
    return if closed or timer?
    delay = Math.min backoffMin * 2 ** attempts, backoffMax
    attempts += 1
    timer = setTimeout (->
      timer = null
      connect()
    ), delay
    return

  connect = ->
    return if closed
    try
      socket = makeSocket hubUrl
    catch error
      report '[Rip] workspace feed: socket open failed:', error
      schedule()
      return
    socket.onopen = ->
      isOpen = true
      attempts = 0
      resync().catch (error) ->
        report '[Rip] workspace feed: resync failed:', error
      return
    socket.onmessage = (event) ->
      handleFrame String(event.data)
      return
    socket.onclose = ->
      isOpen = false
      schedule()
      return
    socket.onerror = -> return
    return

  connect()

  feed =
    close: ->
      return if closed
      closed = true
      if timer?
        clearTimeout timer
        timer = null
      if resyncTimer?
        clearTimeout resyncTimer
        resyncTimer = null
      try socket?.close()
      return
    connected: -> isOpen and not closed
    resync: -> resync()

  feed
