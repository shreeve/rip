# ==============================================================================
# The workspace feed — the hub subscriber half of the door (@rip-lang/app)
#
# connectFeed(workspace, opts) opens the app's Janus hub socket and turns
# ding events into passport mutations: a ding carries only { id, rev,
# hash } (Q2 — never bodies over the hub), the cell bytes ride HTTP at a
# rev-and-hash-keyed URL (Q8), and workspace.set applies them — the bag's
# rev cursor owns staleness, so out-of-order fetches are harmless. The
# hash in the URL is what makes the browser's immutable cache sound:
# revs restart when a manager restarts, so a bare (id, rev) URL can name
# DIFFERENT bytes across runs and a year-long cache hit would serve the
# old run's cell silently; with the content hash in the URL, a cache hit
# is byte-correct by construction. A cell fetch that misses resyncs from
# the manifest; a covered rev whose bytes DIFFER from the page's copy
# names a manager restart — arbitrated through the no-store manifest,
# where the verdict is the full reload (onRestart). Dev/watch only by
# constitution: production has no hub, and a sealed workspace rejects
# the feed at the door.
# ==============================================================================

export type Feed =
  close: () => void
  connected: () => boolean
  resync: () => Promise<void>

FEED_BACKOFF_MIN = 250
FEED_BACKOFF_MAX = 8000

defaultHubUrl = ->
  if typeof location is 'undefined'
    throw new Error 'Rip Workspace: connectFeed needs a hub URL (no location to derive one from)'
  scheme = if location.protocol is 'https:' then 'wss' else 'ws'
  "#{scheme}://#{location.host}/hub"

defaultSocketFactory = ->
  if typeof WebSocket is 'undefined'
    throw new Error 'Rip Workspace: connectFeed needs a socket factory (no global WebSocket)'
  (url) -> new WebSocket(url)

defaultFetch = ->
  if typeof fetch is 'undefined'
    throw new Error 'Rip Workspace: connectFeed needs a fetch (no global fetch)'
  (url) -> fetch(url)

# The page-side half of the cross-run verdict: hash a passport's source
# the same way the manager hashes cell bytes (16 hex chars of sha256), so
# a ding or manifest entry whose rev the cursor already covers can still
# be checked byte-for-byte. Null where the platform offers no subtle
# crypto — the caller treats that as "cannot judge" and keeps the plain
# rev verdict.
sourceHash = (text) ->
  return null unless typeof text is 'string' and typeof crypto isnt 'undefined' and crypto.subtle?
  digest = crypto.subtle.digest! 'SHA-256', new TextEncoder().encode(text)
  Array.from(new Uint8Array(digest), (b) -> b.toString(16).padStart(2, '0')).join('').slice(0, 16)

export def connectFeed(workspace, opts = {}): Feed
  unless workspace? and typeof workspace.set is 'function' and typeof workspace.passport is 'function' and typeof workspace.sealed is 'function'
    throw new TypeError 'Rip Workspace: connectFeed expects a workspace'
  if workspace.sealed()
    throw new Error 'Rip Workspace: connectFeed on a sealed workspace — production has no hub'

  hubUrl = opts.hub ?? defaultHubUrl()
  makeSocket = opts.makeSocket ?? defaultSocketFactory()
  fetchBytes = opts.fetch ?? defaultFetch()
  # The default cell URL percent-encodes each path segment: a legal
  # filename containing '%', '#', or '?' must build a URL the server can
  # decode, and the slashes stay visible (the cell route matches a splat
  # and canonicalizes by decode → re-encode). The content hash rides as
  # `h` so the URL varies iff the bytes do — the cross-run cache soundness
  # above.
  cellUrl = opts.cellUrl ?? (id, rev, hash) ->
    base = "/@rip/cells/#{id.split('/').map(encodeURIComponent).join('/')}?rev=#{rev}"
    if typeof hash is 'string' and hash isnt '' then "#{base}&h=#{hash}" else base
  manifestUrl = opts.manifestUrl ?? '/@rip/manifest'
  report = opts.report ?? (...args) -> console.error(...args)
  backoffMin = opts.backoff?.min ?? FEED_BACKOFF_MIN
  backoffMax = opts.backoff?.max ?? FEED_BACKOFF_MAX
  # An epoch ding names a pool swap: the page's code AND its server are
  # both pre-swap, so the apply policy is the full reload — never the
  # cell path.
  onEpoch = opts.onEpoch ?? (ding) ->
    report "[Rip] workspace feed: a new epoch is live (#{ding.epoch}) — reloading"
    location.reload() if typeof location isnt 'undefined'
    return
  # A manager restart is an epoch the manager cannot announce: revs
  # restart with it, so the surviving page's rev cursor sits ABOVE the
  # new run's revs and every plain rev verdict says "stale" — the page
  # would silently pin to the old run's bytes forever. The hash is the
  # tiebreak: a rev the cursor covers whose bytes DIFFER from the page's
  # copy can only be another run (within a run, one rev has one hash and
  # hub frames arrive in order on one socket), and the policy is the
  # same as an epoch — the full reload.
  onRestart = opts.onRestart ?? (about) ->
    report "[Rip] workspace feed: cell '#{about.id}' rev #{about.rev} names different bytes than this page holds — the manager restarted; reloading"
    location.reload() if typeof location isnt 'undefined'
    return
  # "This rev is covered but the bytes differ" — the cross-run verdict
  # above. False only where it cannot judge (no hash offered, no subtle
  # crypto): the plain rev verdict then stands.
  crossRun = (current, hash) ->
    return false unless typeof hash is 'string' and hash isnt ''
    mine = sourceHash! current.source
    mine? and mine isnt hash

  closed = false
  isOpen = false
  socket = null
  attempts = 0
  timer = null
  resyncTimer = null
  resyncAttempts = 0
  wants = {}       # id → highest dinged rev not yet applied (a miss under retry)

  # A dinged rev the workspace has not reached yet is a WANT: a resync
  # only counts as clean once every want is satisfied (or its id was
  # deleted), so a miss retries instead of leaving the feed silently
  # behind until the next ding or reconnect.
  wantsSatisfied = ->
    for id, rev of wants
      current = workspace.passport id
      delete wants[id] if current? and current.rev >= rev
    Object.keys(wants).length is 0

  scheduleResync = ->
    return if closed or resyncTimer?
    delay = Math.min backoffMin * 2 ** resyncAttempts, backoffMax
    resyncAttempts += 1
    resyncTimer = setTimeout (->
      resyncTimer = null
      resync().catch (error) -> report '[Rip] workspace feed: resync failed:', error
    ), delay
    return

  # Reconciliation is additive-and-forward only: the manifest advances
  # what it names and never deletes — the bag legally holds passports the
  # server feed does not own (an editor's local mints). Deletions ride
  # dings alone. A resync that could not fully reconcile (a manifest or
  # cell fetch failing, an unsatisfied want) schedules its own retry with
  # backoff; a clean one clears the cursor. A structurally malformed
  # manifest is a server bug, reported and never retried into.
  resync = ->
    clean = true
    res = fetchBytes! manifestUrl
    unless res.ok
      report "[Rip] workspace feed: manifest fetch failed (#{res.status})"
      scheduleResync()
      return
    manifest = res.json!()
    cells = manifest?.cells
    unless Array.isArray cells
      report '[Rip] workspace feed: malformed manifest:', manifest
      return
    named = new Set()
    for entry in cells
      unless entry? and typeof entry.id is 'string' and Number.isInteger(entry.rev)
        report '[Rip] workspace feed: malformed manifest entry:', entry
        continue
      named.add entry.id
      current = workspace.passport entry.id
      if current? and current.rev >= entry.rev
        if crossRun! current, entry.hash
          onRestart { id: entry.id, rev: entry.rev, hash: entry.hash }
          return
        continue
      cres = fetchBytes! cellUrl(entry.id, entry.rev, entry.hash)
      unless cres.ok
        report "[Rip] workspace feed: cell fetch missed (#{cres.status}) for '#{entry.id}' rev #{entry.rev} during resync"
        clean = false
        continue
      source = cres.text!()
      cell = { id: entry.id, rev: entry.rev, source }
      # A birth needs a path, and the id IS the path (B′).
      cell.path = entry.id unless current?
      workspace.set! cell
    # Wants come only from dings, and dings only name server-owned ids —
    # so a wanted id the manifest no longer names was RETIRED upstream
    # and its delete ding was lost in a reconnect window. Drop the want:
    # nothing will ever satisfy it, and re-polling the manifest forever
    # is the alternative.
    for id of { ...wants }
      delete wants[id] unless named.has id
    if clean and wantsSatisfied()
      resyncAttempts = 0
    else
      scheduleResync()
    return

  applyDing = (ding) ->
    if ding? and typeof ding is 'object' and ding.kind is 'epoch'
      onEpoch ding
      return
    unless ding? and typeof ding is 'object' and typeof ding.id is 'string' and Number.isInteger(ding.rev)
      report '[Rip] workspace feed: malformed ding:', ding
      return
    { id, rev, kind, hash } = ding
    if kind is 'delete'
      delete wants[id]         # a retirement supersedes any pending want
      workspace.set { id, rev, deleted: true }
      return
    current = workspace.passport id
    if current? and rev <= current.rev
      # Covered — skip the network. Unless the bytes differ: that is
      # EITHER a manager restart or this frame's own staleness (the
      # HTTP resync is unordered relative to hub frames, so a resync
      # can advance the cursor past a frame still in flight). The ding
      # alone cannot tell the two apart, so the no-store manifest
      # arbitrates: a genuine restart shows the same mismatch there and
      # the resync-path verdict reloads; an overtaken frame resolves as
      # a clean no-op.
      resync!() if crossRun! current, hash
      return
    res = fetchBytes! cellUrl(id, rev, hash)
    unless res.ok
      report "[Rip] workspace feed: cell fetch missed (#{res.status}) for '#{id}' rev #{rev} — resyncing from the manifest"
      wants[id] = Math.max rev, wants[id] ?? 0
      resync!()
      return
    source = res.text!()
    cell = { id, rev, source }
    # An unknown id is a component born upstream: set needs the full
    # record, and the birth path IS the id (B′).
    cell.path = id unless workspace.passport(id)?
    workspace.set cell
    return

  handleFrame = (text) ->
    frame = null
    try
      frame = JSON.parse text
    catch
      report '[Rip] workspace feed: unparseable hub frame:', text
      return
    objects = if Array.isArray(frame) then frame else [frame]
    for obj in objects
      continue unless obj? and typeof obj is 'object' and obj.ding isnt undefined
      applyDing(obj.ding).catch (error) ->
        report '[Rip] workspace feed: ding apply failed:', error
    return

  schedule = ->
    return if closed or timer?
    delay = Math.min backoffMin * 2 ** attempts, backoffMax
    attempts += 1
    timer = setTimeout (->
      timer = null
      connect()
    ), delay
    return

  connect = ->
    return if closed
    try
      socket = makeSocket hubUrl
    catch error
      report '[Rip] workspace feed: socket open failed:', error
      schedule()
      return
    socket.onopen = ->
      isOpen = true
      attempts = 0
      # Catch up on dings missed while disconnected (and on the gap
      # between the page's populate and this connection).
      resync().catch (error) ->
        report '[Rip] workspace feed: resync failed:', error
      return
    socket.onmessage = (event) ->
      handleFrame String(event.data)
      return
    socket.onclose = ->
      isOpen = false
      schedule()
      return
    socket.onerror = -> return     # onclose follows; never double-schedule
    return

  connect()

  feed =
    close: ->
      return if closed
      closed = true
      if timer?
        clearTimeout timer
        timer = null
      if resyncTimer?
        clearTimeout resyncTimer
        resyncTimer = null
      try socket?.close()
      return
    connected: -> isOpen and not closed
    resync: -> resync()

  feed
