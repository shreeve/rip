# ==============================================================================
# Rip Workspace — one active browser publication
#
# The Workspace is the App-facing component store plus one complete App hash.
# Browser delivery stages source and compilation outside it, then activates or
# commits one prepared state. It never calculates hashes and never stores
# ordinary HTTP assets.
# ==============================================================================

export type WorkspaceEvent = 'create' | 'change' | 'delete'

export type PreparedWorkspace =
  hash: string
  sources: Record<string, string>
  compiled: Record<string, Record<string, unknown>>

export type Workspace =
  read: (path: string) => string | undefined
  write: (path: string, content: string) => void
  del: (path: string) => void
  exists: (path: string) => boolean
  size: () => number
  list: (dir?: string) => string[]
  listAll: (dir?: string) => string[]
  load: (sources: Record<string, string>) => void
  watch: (fn: (event: WorkspaceEvent, path: string) => void) => () => void
  getCompiled: (path: string) => Record<string, unknown> | undefined
  setCompiled: (path: string, module: Record<string, unknown>) => void
  hash: () => string | null
  activate: (state: PreparedWorkspace) => void
  stage: (from: string, state: PreparedWorkspace, changed: string[]) => { components: { getCompiled: (path: string) => Record<string, unknown> | undefined, exists: (path: string) => boolean }, commit: () => void, rollback: () => void }
  commit: (from: string, state: PreparedWorkspace, changed: string[]) => void

validPath = (path) ->
  unless typeof path is 'string' and path.length > 0
    throw TypeError.new 'Rip Workspace: component path must be a non-empty string'
  segments = path.split '/'
  invalidSegment = segments.some (segment) -> not segment or segment is '.' or segment is '..' or segment.startsWith '.'
  filename = segments[-1]
  fileAsDirectory = segments.slice(0, -1).some (segment) -> segment.endsWith '.rip'
  if path.includes('\\') or path.startsWith('/') or invalidSegment or fileAsDirectory or filename is '.rip' or not filename.endsWith('.rip')
    throw TypeError.new "Rip Workspace: invalid component path '#{path}'"
  path

validContent = (content) ->
  unless typeof content is 'string'
    throw TypeError.new 'Rip Workspace: component source must be a string'
  content

validDirectory = (dir) ->
  return '' if dir is '' or not dir?
  unless typeof dir is 'string'
    throw TypeError.new 'Rip Workspace: component directory must be a string'
  segments = dir.split '/'
  if dir.includes('\\') or dir.startsWith('/') or segments.some((segment) -> not segment or segment is '.' or segment is '..' or segment.startsWith '.')
    throw TypeError.new "Rip Workspace: invalid component directory '#{dir}'"
  dir

validHash = (hash) ->
  unless typeof hash is 'string' and /^[A-Za-z0-9_]{6}$/.test(hash)
    throw TypeError.new 'Rip Workspace: publication hash must be six Base64URL-folded characters'
  hash

validModule = (module) ->
  unless module? and typeof module is 'object' and not Array.isArray(module)
    throw TypeError.new 'Rip Workspace: compiled component module must be an object'
  module

prepared = (state) ->
  unless state? and typeof state is 'object' and not Array.isArray(state)
    throw TypeError.new 'Rip Workspace: prepared state must be an object'
  hash = validHash state.hash
  unless state.sources? and typeof state.sources is 'object' and not Array.isArray(state.sources)
    throw TypeError.new 'Rip Workspace: prepared sources must be an object'
  unless state.compiled? and typeof state.compiled is 'object' and not Array.isArray(state.compiled)
    throw TypeError.new 'Rip Workspace: prepared compiled modules must be an object'
  sources = Map.new()
  compiled = Map.new()
  for own path, source of state.sources
    sources.set validPath(path), validContent(source)
  for own path, module of state.compiled
    path = validPath path
    throw Error.new "Rip Workspace: compiled module '#{path}' has no source" unless sources.has path
    compiled.set path, validModule(module)
  { hash, sources, compiled }

export def createWorkspace(): Workspace
  sources = Map.new()
  compiled = Map.new()
  watchers: Set<(event: WorkspaceEvent, path: string) => void> = Set.new()
  activeHash = null
  staging = false

  notify = (event, path) ->
    for watcher in Array.from(watchers)
      try
        watcher event, path
      catch error
        console.error '[Rip] workspace watcher error:', error
    return

  replace = (next) ->
    sources = next.sources
    compiled = next.compiled
    activeHash = next.hash
    return

  workspace =
    read: (path) -> sources.get validPath(path)

    write: (path, content) ->
      throw Error.new 'Rip Workspace: cannot write during a publication transition' if staging
      path = validPath path
      content = validContent content
      event = if sources.has(path) then 'change' else 'create'
      sources.set path, content
      compiled.delete path
      notify event, path
      return

    del: (path) ->
      throw Error.new 'Rip Workspace: cannot delete during a publication transition' if staging
      path = validPath path
      sources.delete path
      compiled.delete path
      notify 'delete', path
      return

    exists: (path) -> sources.has validPath(path)

    size: -> sources.size

    list: (dir = '') ->
      dir = validDirectory dir
      prefix = if dir then dir + '/' else ''
      result = []
      for [path] in sources
        if path.startsWith prefix
          rest = path.slice prefix.length
          result.push path unless rest.includes '/'
      result

    listAll: (dir = '') ->
      dir = validDirectory dir
      prefix = if dir then dir + '/' else ''
      result = []
      result.push path for [path] in sources when path.startsWith(prefix)
      result

    load: (values) ->
      throw Error.new 'Rip Workspace: cannot load during a publication transition' if staging
      unless values? and typeof values is 'object' and not Array.isArray(values)
        throw TypeError.new 'Rip Workspace: component load expects a source object'
      next = []
      for own path, content of values
        next.push [validPath(path), validContent(content)]
      for [path, content] in next
        sources.set path, content
        compiled.delete path
      return

    watch: (fn) ->
      unless typeof fn is 'function'
        throw TypeError.new 'Rip Workspace: component watch expects a function'
      watchers.add fn
      disposed = false
      ->
        return if disposed
        disposed = true
        watchers.delete fn
        return

    getCompiled: (path) -> compiled.get validPath(path)

    setCompiled: (path, module) ->
      throw Error.new 'Rip Workspace: cannot compile during a publication transition' if staging
      path = validPath path
      throw Error.new "Rip Workspace: setCompiled for unknown component path '#{path}'" unless sources.has path
      compiled.set path, validModule(module)
      return

    hash: -> activeHash

    activate: (state) ->
      throw Error.new 'Rip Workspace: a publication is already active' if activeHash?
      throw Error.new 'Rip Workspace: a publication transition is already staged' if staging
      replace prepared(state)
      return

    stage: (from, state, changed) ->
      throw Error.new 'Rip Workspace: a publication transition is already staged' if staging
      from = validHash from
      throw Error.new "Rip Workspace: change starts at #{from}, not #{activeHash}" unless activeHash is from
      unless Array.isArray changed
        throw TypeError.new 'Rip Workspace: changed paths must be an array'
      paths = changed.map (path) -> validPath path
      throw Error.new 'Rip Workspace: changed paths must be unique' unless Set.new(paths).size is paths.length
      next = prepared state
      before = { sources, compiled, hash: activeHash }
      staging = true
      done = false
      finish = (keep) ->
        throw Error.new 'Rip Workspace: publication transition is already finished' if done
        done = true
        staging = false
        return unless keep
        replace next
        for path in paths
          event = if not next.sources.has(path) then 'delete' else if before.sources.has(path) then 'change' else 'create'
          notify event, path
        return
      {
        # The staged registry the apply seam reads: a path the candidate
        # no longer holds reads as absent, so a deleted module is told
        # apart from one the candidate did not compile.
        components:
          getCompiled: (path) -> next.compiled.get validPath(path)
          exists: (path) -> next.sources.has validPath(path)
        commit: -> finish true
        rollback: -> finish false
      }

    commit: (from, state, changed) ->
      transaction = workspace.stage from, state, changed
      transaction.commit()
      return

  workspace
