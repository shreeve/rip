# ==============================================================================
# Rip Workspace — the reactive passport bag (@rip-lang/app)
#
# One bag of component records ("passports") in the browser. Producers
# mutate the bag through the door (populate / set / seal); the app reads
# it through a path-keyed view that implements the exact ComponentsStore
# interface from @rip-lang/app, so launch() can take it as an injected
# store. Records + door + view — nothing more.
#
# Freshness is the six-character Rip hash over exact UTF-8 source bytes.
# ==============================================================================

import { rash } from './rash.rip'

export type WorkspaceEvent = 'create' | 'change' | 'delete'

export type Passport =
  id: string
  path: string
  hash: string
  source: string
  compiled: Record<string, unknown> | undefined

export type Workspace =
  read: (path: string) => string | undefined
  write: (path: string, content: string) => void
  del: (path: string) => void
  exists: (path: string) => boolean
  size: () => number
  list: (dir?: string) => string[]
  listAll: (dir?: string) => string[]
  load: (sources: Record<string, string>) => void
  watch: (fn: (event: WorkspaceEvent, path: string) => void) => () => void
  getCompiled: (path: string) => Record<string, unknown> | undefined
  setCompiled: (path: string, module: Record<string, unknown>) => void
  populate: (records: Passport[]) => void
  set: (record: Record<string, unknown>) => boolean
  seal: () => void
  sealed: () => boolean
  passport: (pathOrId: string) => Passport | undefined
  ids: () => string[]
  paths: () => string[]

# Bag paths: Rip modules, CSS sheets (S12), HTML shells (reload).
# Route/component stores stay .rip-only in components.rip.
isBagPath = (name) ->
  name.endsWith('.rip') or name.endsWith('.css') or name.endsWith('.html')

validPath = (path) ->
  unless typeof path is 'string' and path.length > 0
    throw TypeError.new 'Rip Workspace: component path must be a non-empty string'
  segments = path.split '/'
  invalidSegment = segments.some (segment) -> not segment or segment is '.' or segment is '..'
  filename = segments[-1]
  fileAsDirectory = segments.slice(0, -1).some (segment) -> isBagPath segment
  if path.includes('\\') or invalidSegment or fileAsDirectory or filename is '.rip' or filename is '.css' or filename is '.html' or not isBagPath(filename)
    throw TypeError.new "Rip Workspace: invalid component path '#{path}'"
  path

validContent = (content) ->
  unless typeof content is 'string'
    throw TypeError.new 'Rip Workspace: component source must be a string'
  content

validDirectory = (dir) ->
  return '' if dir is '' or not dir?
  unless typeof dir is 'string'
    throw TypeError.new 'Rip Workspace: component directory must be a string'
  segments = dir.split '/'
  if dir.includes('\\') or segments.some((segment) -> not segment or segment is '.' or segment is '..')
    throw TypeError.new "Rip Workspace: invalid component directory '#{dir}'"
  dir

validId = (id) ->
  unless typeof id is 'string' and id.length > 0
    throw TypeError.new 'Rip Workspace: passport id must be a non-empty string'
  id

validHash = (hash) ->
  unless typeof hash is 'string' and /^[A-Za-z0-9_]{6}$/.test(hash)
    throw TypeError.new 'Rip Workspace: passport hash must be six Base64URL-folded characters'
  hash

validModule = (module) ->
  unless module? and typeof module is 'object' and not Array.isArray(module)
    throw TypeError.new 'Rip Workspace: compiled component module must be an object'
  module

hashOf = (text) -> rash TextEncoder.new().encode(text)

export def createWorkspace(): Workspace
  passports = Map.new()
  pathToId = Map.new()
  watchers = Set.new()
  locked = false

  guard = (operation) ->
    if locked
      throw Error.new "Rip Workspace: #{operation} on a sealed workspace"
    return

  notify = (event, path) ->
    for watcher in Array.from(watchers)
      try
        watcher event, path
      catch error
        console.error '[Rip] workspace watcher error:', error
    return

  byPath = (path) ->
    id = pathToId.get path
    if id? then passports.get(id) else undefined

  # B′: the id is path-derived at birth. A locally minted passport (an
  # editor write, not a server file) uses its birth path as its id.
  mintId = (path) ->
    if passports.has path
      throw Error.new "Rip Workspace: cannot mint id '#{path}'; a passport already holds that id"
    path

  claimPath = (path, id) ->
    holder = pathToId.get path
    if holder? and holder isnt id
      throw Error.new "Rip Workspace: path '#{path}' already labels passport '#{holder}'"
    return

  applySource = (record, content) ->
    passports.set record.id, { ...record, hash: hashOf(content), source: content, compiled: undefined }
    return

  birthPassport = (path, content) ->
    id = mintId path
    passports.set id, { id, path, hash: hashOf(content), source: content, compiled: undefined }
    pathToId.set path, id
    return

  workspace =
    # --- ComponentsStore view (path-keyed) ---

    read: (path) ->
      byPath(validPath(path))?.source

    write: (path, content) ->
      guard 'write'
      path = validPath path
      content = validContent content
      record = byPath path
      if record
        applySource record, content
        notify 'change', path
      else
        birthPassport path, content
        notify 'create', path
      return

    del: (path) ->
      guard 'del'
      path = validPath path
      record = byPath path
      if record
        passports.delete record.id
        pathToId.delete path
      notify 'delete', path
      return

    exists: (path) ->
      pathToId.has validPath(path)

    size: -> passports.size

    list: (dir = '') ->
      dir = validDirectory dir
      prefix = if dir then dir + '/' else ''
      result = []
      for [path] in pathToId
        if path.startsWith prefix
          rest = path.slice prefix.length
          result.push path unless rest.includes '/'
      result

    listAll: (dir = '') ->
      dir = validDirectory dir
      prefix = if dir then dir + '/' else ''
      result = []
      result.push path for [path] in pathToId when path.startsWith(prefix)
      result

    load: (sources) ->
      guard 'load'
      unless sources? and typeof sources is 'object' and not Array.isArray(sources)
        throw TypeError.new 'Rip Workspace: component load expects a source object'
      for own path, content of sources
        path = validPath path
        content = validContent content
        record = byPath path
        if record
          applySource record, content
        else
          birthPassport path, content
      return

    watch: (fn) ->
      unless typeof fn is 'function'
        throw TypeError.new 'Rip Workspace: component watch expects a function'
      watchers.add fn
      disposed = false
      ->
        return if disposed
        disposed = true
        watchers.delete fn
        return

    getCompiled: (path) ->
      byPath(validPath(path))?.compiled

    setCompiled: (path, module) ->
      guard 'setCompiled'
      path = validPath path
      module = validModule module
      record = byPath path
      unless record
        throw Error.new "Rip Workspace: setCompiled for unknown component path '#{path}'"
      passports.set record.id, { ...record, compiled: module }
      return

    # --- Door ---

    populate: (records) ->
      guard 'populate'
      unless Array.isArray records
        throw TypeError.new 'Rip Workspace: populate expects an array of passport records'
      if passports.size > 0
        throw Error.new 'Rip Workspace: populate requires an empty workspace; mutate with set'
      seenIds = Set.new()
      seenPaths = Set.new()
      next = []
      for record in records
        unless record? and typeof record is 'object' and not Array.isArray(record)
          throw TypeError.new 'Rip Workspace: populate expects passport records'
        id = validId record.id
        path = validPath record.path
        hash = validHash record.hash
        source = validContent record.source
        compiled = if record.compiled? then validModule record.compiled else undefined
        if seenIds.has id
          throw Error.new "Rip Workspace: duplicate passport id '#{id}' in populate"
        if seenPaths.has path
          throw Error.new "Rip Workspace: duplicate passport path '#{path}' in populate"
        seenIds.add id
        seenPaths.add path
        next.push { id, path, hash, source, compiled }
      for row in next
        passports.set row.id, row
        pathToId.set row.path, row.id
      return

    set: (record) ->
      guard 'set'
      unless record? and typeof record is 'object' and not Array.isArray(record)
        throw TypeError.new 'Rip Workspace: set expects a passport record'
      id = validId record.id
      hash = validHash record.hash
      current = passports.get id

      unless current
        # A delete for an id the bag no longer holds is a replayed
        # ding — not an error.
        return false if record.deleted is true
        unless record.path? and record.source?
          throw Error.new "Rip Workspace: set of unknown passport '#{id}' requires a full record (id, path, hash, source)"
        path = validPath record.path
        source = validContent record.source
        compiled = if record.compiled? then validModule record.compiled else undefined
        claimPath path, id
        passports.set id, { id, path, hash, source, compiled }
        pathToId.set path, id
        notify 'create', path
        return true

      if record.deleted is true
        # Delete names the generation being retired; a newer passport wins.
        return false unless hash is current.hash
        passports.delete id
        pathToId.delete current.path
        notify 'delete', current.path
        return true

      return false if hash is current.hash

      newPath = if record.path? then validPath record.path else current.path
      renamed = newPath isnt current.path
      hasSource = record.source isnt undefined and record.source isnt null
      hasCompiled = record.compiled isnt undefined and record.compiled isnt null
      unless hasSource or hasCompiled or renamed
        throw Error.new "Rip Workspace: set for passport '#{id}' carries nothing to apply (source, compiled, path, or deleted)"
      claimPath newPath, id if renamed
      source = if hasSource then validContent record.source else current.source
      compiled = if hasCompiled
        validModule record.compiled
      else if hasSource
        undefined   # new source invalidates the old projection
      else
        current.compiled

      oldPath = current.path
      pathToId.delete oldPath if renamed
      passports.set id, { id, path: newPath, hash, source, compiled }
      pathToId.set newPath, id
      if renamed
        notify 'delete', oldPath
        notify 'create', newPath
      else
        notify 'change', newPath
      true

    seal: ->
      if locked
        throw Error.new 'Rip Workspace: workspace is already sealed'
      locked = true
      return

    sealed: -> locked

    # --- Inspection ---

    passport: (pathOrId) ->
      unless typeof pathOrId is 'string' and pathOrId.length > 0
        throw TypeError.new 'Rip Workspace: passport lookup expects a passport id or component path'
      record = passports.get pathOrId
      unless record
        id = pathToId.get pathOrId
        record = if id? then passports.get(id) else undefined
      return undefined unless record
      { ...record }

    ids: -> Array.from passports.keys()

    paths: -> Array.from pathToId.keys()

  workspace
