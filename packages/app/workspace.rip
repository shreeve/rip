# ==============================================================================
# Rip Workspace — the reactive passport bag (@rip-lang/app)
#
# One bag of component records ("passports") in the browser. Producers
# mutate the bag through the door (populate / set / seal); the app reads
# it through a path-keyed view that implements the exact ComponentsStore
# interface from @rip-lang/app, so launch() can take it as an injected
# store. Records + door + view — nothing more.
#
# Freshness is the content etag (16 hex of sha256), matching the Q8′
# door wire — never a monotonic rev counter.
# ==============================================================================

export type WorkspaceEvent = 'create' | 'change' | 'delete'

export type Passport =
  id: string
  path: string
  etag: string
  source: string
  compiled: Record<string, unknown> | undefined

export type Workspace =
  read: (path: string) => string | undefined
  write: (path: string, content: string) => void
  del: (path: string) => void
  exists: (path: string) => boolean
  size: () => number
  list: (dir?: string) => string[]
  listAll: (dir?: string) => string[]
  load: (sources: Record<string, string>) => void
  watch: (fn: (event: WorkspaceEvent, path: string) => void) => () => void
  getCompiled: (path: string) => Record<string, unknown> | undefined
  setCompiled: (path: string, module: Record<string, unknown>) => void
  populate: (records: Passport[]) => void
  set: (record: Record<string, unknown>) => boolean
  seal: () => void
  sealed: () => boolean
  passport: (pathOrId: string) => Passport | undefined
  ids: () => string[]
  paths: () => string[]

validPath = (path) ->
  unless typeof path is 'string' and path.length > 0
    throw new TypeError 'Rip Workspace: component path must be a non-empty string'
  segments = path.split '/'
  invalidSegment = segments.some (segment) -> not segment or segment is '.' or segment is '..'
  filename = segments[-1]
  fileAsDirectory = segments.slice(0, -1).some (segment) -> segment.endsWith '.rip'
  if path.includes('\\') or invalidSegment or fileAsDirectory or filename is '.rip' or not filename.endsWith('.rip')
    throw new TypeError "Rip Workspace: invalid component path '#{path}'"
  path

validContent = (content) ->
  unless typeof content is 'string'
    throw new TypeError 'Rip Workspace: component source must be a string'
  content

validDirectory = (dir) ->
  return '' if dir is '' or not dir?
  unless typeof dir is 'string'
    throw new TypeError 'Rip Workspace: component directory must be a string'
  segments = dir.split '/'
  if dir.includes('\\') or segments.some((segment) -> not segment or segment is '.' or segment is '..')
    throw new TypeError "Rip Workspace: invalid component directory '#{dir}'"
  dir

validId = (id) ->
  unless typeof id is 'string' and id.length > 0
    throw new TypeError 'Rip Workspace: passport id must be a non-empty string'
  id

validEtag = (etag) ->
  unless typeof etag is 'string' and /^[0-9a-f]{16}$/.test(etag)
    throw new TypeError 'Rip Workspace: passport etag must be 16 lowercase hex characters'
  etag

validModule = (module) ->
  unless module? and typeof module is 'object' and not Array.isArray(module)
    throw new TypeError 'Rip Workspace: compiled component module must be an object'
  module

# Same domain as the manager's shortHash / feed sourceHash (16 hex of sha256).
# Bun on the server/tests; a sync SHA-256 for the browser shell (SubtleCrypto
# is async and launch may mint a local passport before any door etag arrives).
etagOf = (text) ->
  if typeof Bun isnt 'undefined' and Bun.CryptoHasher?
    return new Bun.CryptoHasher('sha256').update(text).digest('hex').slice(0, 16)
  syncSha256Hex(text).slice(0, 16)

# Compact sync SHA-256 (FIPS 180-4) — browser fallback only.
syncSha256Hex = (message) ->
  K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
  ]
  bytes = new TextEncoder().encode(message)
  bitLen = bytes.length * 8
  withPad = new Uint8Array(((bytes.length + 9 + 63) & ~63))
  withPad.set bytes
  withPad[bytes.length] = 0x80
  view = new DataView(withPad.buffer)
  view.setUint32 withPad.length - 4, bitLen >>> 0, false
  view.setUint32 withPad.length - 8, Math.floor(bitLen / 0x100000000) >>> 0, false
  H = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
  rotr = (x, n) -> (x >>> n) | (x << (32 - n))
  w = new Uint32Array(64)
  i = 0
  while i < withPad.length
    for j in [0...16]
      w[j] = view.getUint32(i + j * 4, false)
    for j in [16...64]
      s0 = rotr(w[j - 15], 7) ^ rotr(w[j - 15], 18) ^ (w[j - 15] >>> 3)
      s1 = rotr(w[j - 2], 17) ^ rotr(w[j - 2], 19) ^ (w[j - 2] >>> 10)
      w[j] = (w[j - 16] + s0 + w[j - 7] + s1) >>> 0
    [a, b, c, d, e, f, g, h] = H
    for j in [0...64]
      S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
      ch = (e & f) ^ (~e & g)
      temp1 = (h + S1 + ch + K[j] + w[j]) >>> 0
      S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
      maj = (a & b) ^ (a & c) ^ (b & c)
      temp2 = (S0 + maj) >>> 0
      h = g
      g = f
      f = e
      e = (d + temp1) >>> 0
      d = c
      c = b
      b = a
      a = (temp1 + temp2) >>> 0
    H[0] = (H[0] + a) >>> 0
    H[1] = (H[1] + b) >>> 0
    H[2] = (H[2] + c) >>> 0
    H[3] = (H[3] + d) >>> 0
    H[4] = (H[4] + e) >>> 0
    H[5] = (H[5] + f) >>> 0
    H[6] = (H[6] + g) >>> 0
    H[7] = (H[7] + h) >>> 0
    i += 64
  H.map((x) -> x.toString(16).padStart(8, '0')).join('')

export def createWorkspace(): Workspace
  passports = new Map()
  pathToId = new Map()
  watchers = new Set()
  locked = false

  guard = (operation) ->
    if locked
      throw new Error "Rip Workspace: #{operation} on a sealed workspace"
    return

  notify = (event, path) ->
    for watcher in Array.from(watchers)
      try
        watcher event, path
      catch error
        console.error '[Rip] workspace watcher error:', error
    return

  byPath = (path) ->
    id = pathToId.get path
    if id? then passports.get(id) else undefined

  # B′: the id is path-derived at birth. A locally minted passport (an
  # editor write, not a server file) uses its birth path as its id.
  mintId = (path) ->
    if passports.has path
      throw new Error "Rip Workspace: cannot mint id '#{path}'; a passport already holds that id"
    path

  claimPath = (path, id) ->
    holder = pathToId.get path
    if holder? and holder isnt id
      throw new Error "Rip Workspace: path '#{path}' already labels passport '#{holder}'"
    return

  applySource = (record, content) ->
    passports.set record.id, { ...record, etag: etagOf(content), source: content, compiled: undefined }
    return

  birthPassport = (path, content) ->
    id = mintId path
    passports.set id, { id, path, etag: etagOf(content), source: content, compiled: undefined }
    pathToId.set path, id
    return

  workspace =
    # --- ComponentsStore view (path-keyed) ---

    read: (path) ->
      byPath(validPath(path))?.source

    write: (path, content) ->
      guard 'write'
      path = validPath path
      content = validContent content
      record = byPath path
      if record
        applySource record, content
        notify 'change', path
      else
        birthPassport path, content
        notify 'create', path
      return

    del: (path) ->
      guard 'del'
      path = validPath path
      record = byPath path
      if record
        passports.delete record.id
        pathToId.delete path
      notify 'delete', path
      return

    exists: (path) ->
      pathToId.has validPath(path)

    size: -> passports.size

    list: (dir = '') ->
      dir = validDirectory dir
      prefix = if dir then dir + '/' else ''
      result = []
      for [path] in pathToId
        if path.startsWith prefix
          rest = path.slice prefix.length
          result.push path unless rest.includes '/'
      result

    listAll: (dir = '') ->
      dir = validDirectory dir
      prefix = if dir then dir + '/' else ''
      result = []
      result.push path for [path] in pathToId when path.startsWith(prefix)
      result

    load: (sources) ->
      guard 'load'
      unless sources? and typeof sources is 'object' and not Array.isArray(sources)
        throw new TypeError 'Rip Workspace: component load expects a source object'
      for own path, content of sources
        path = validPath path
        content = validContent content
        record = byPath path
        if record
          applySource record, content
        else
          birthPassport path, content
      return

    watch: (fn) ->
      unless typeof fn is 'function'
        throw new TypeError 'Rip Workspace: component watch expects a function'
      watchers.add fn
      disposed = false
      ->
        return if disposed
        disposed = true
        watchers.delete fn
        return

    getCompiled: (path) ->
      byPath(validPath(path))?.compiled

    setCompiled: (path, module) ->
      guard 'setCompiled'
      path = validPath path
      module = validModule module
      record = byPath path
      unless record
        throw new Error "Rip Workspace: setCompiled for unknown component path '#{path}'"
      passports.set record.id, { ...record, compiled: module }
      return

    # --- Door ---

    populate: (records) ->
      guard 'populate'
      unless Array.isArray records
        throw new TypeError 'Rip Workspace: populate expects an array of passport records'
      if passports.size > 0
        throw new Error 'Rip Workspace: populate requires an empty workspace; mutate with set'
      seenIds = new Set()
      seenPaths = new Set()
      next = []
      for record in records
        unless record? and typeof record is 'object' and not Array.isArray(record)
          throw new TypeError 'Rip Workspace: populate expects passport records'
        id = validId record.id
        path = validPath record.path
        etag = validEtag record.etag
        source = validContent record.source
        compiled = if record.compiled? then validModule record.compiled else undefined
        if seenIds.has id
          throw new Error "Rip Workspace: duplicate passport id '#{id}' in populate"
        if seenPaths.has path
          throw new Error "Rip Workspace: duplicate passport path '#{path}' in populate"
        seenIds.add id
        seenPaths.add path
        next.push { id, path, etag, source, compiled }
      for row in next
        passports.set row.id, row
        pathToId.set row.path, row.id
      return

    set: (record) ->
      guard 'set'
      unless record? and typeof record is 'object' and not Array.isArray(record)
        throw new TypeError 'Rip Workspace: set expects a passport record'
      id = validId record.id
      etag = validEtag record.etag
      current = passports.get id

      unless current
        # A delete for an id the bag no longer holds is a replayed
        # ding — not an error.
        return false if record.deleted is true
        unless record.path? and record.source?
          throw new Error "Rip Workspace: set of unknown passport '#{id}' requires a full record (id, path, etag, source)"
        path = validPath record.path
        source = validContent record.source
        compiled = if record.compiled? then validModule record.compiled else undefined
        claimPath path, id
        passports.set id, { id, path, etag, source, compiled }
        pathToId.set path, id
        notify 'create', path
        return true

      if record.deleted is true
        # Delete names the generation being retired; a newer passport wins.
        return false unless etag is current.etag
        passports.delete id
        pathToId.delete current.path
        notify 'delete', current.path
        return true

      # Q8′: already holding this generation — ignore (no mutation, no event).
      return false if etag is current.etag

      newPath = if record.path? then validPath record.path else current.path
      renamed = newPath isnt current.path
      hasSource = record.source isnt undefined and record.source isnt null
      hasCompiled = record.compiled isnt undefined and record.compiled isnt null
      unless hasSource or hasCompiled or renamed
        throw new Error "Rip Workspace: set for passport '#{id}' carries nothing to apply (source, compiled, path, or deleted)"
      claimPath newPath, id if renamed
      source = if hasSource then validContent record.source else current.source
      compiled = if hasCompiled
        validModule record.compiled
      else if hasSource
        undefined   # new source invalidates the old projection
      else
        current.compiled

      oldPath = current.path
      pathToId.delete oldPath if renamed
      passports.set id, { id, path: newPath, etag, source, compiled }
      pathToId.set newPath, id
      if renamed
        notify 'delete', oldPath
        notify 'create', newPath
      else
        notify 'change', newPath
      true

    seal: ->
      if locked
        throw new Error 'Rip Workspace: workspace is already sealed'
      locked = true
      return

    sealed: -> locked

    # --- Inspection ---

    passport: (pathOrId) ->
      unless typeof pathOrId is 'string' and pathOrId.length > 0
        throw new TypeError 'Rip Workspace: passport lookup expects a passport id or component path'
      record = passports.get pathOrId
      unless record
        id = pathToId.get pathOrId
        record = if id? then passports.get(id) else undefined
      return undefined unless record
      { ...record }

    ids: -> Array.from passports.keys()

    paths: -> Array.from pathToId.keys()

  workspace
