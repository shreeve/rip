# ==============================================================================
# Apply — discardable hot-absorb policy for Workspace module commits
#
# Browser delivery commits prepared state; apply chooses a verdict:
#   reload | css | update | ignore
#
# CSS refresh and document reload happen in browser delivery; absorb reports
# their verdicts when asked and runs Rip updates through the renderer.
# `update` is the product verb — narrow remount vs whole-launch remount
# is an implementation detail underneath.
#
# ==============================================================================

export type ApplyVerdict = 'reload' | 'css' | 'update' | 'ignore'

export type Apply =
  absorb: (paths: string[]) => Promise<ApplyVerdict>

export type ApplyOpts =
  # Renderer seam still speaks narrow/escape/noop; absorb maps to update/ignore.
  renderer: { remountDirty: (paths: string[]) => Promise<'narrow' | 'noop' | 'escape'> }
  escape: (paths: string[]) => Promise<void>
  report?: (...args: any[]) => void

export def createApply(opts: ApplyOpts): Apply
  unless opts? and typeof opts is 'object'
    throw TypeError.new 'Rip App: createApply expects an options object'
  unless typeof opts.renderer?.remountDirty is 'function'
    throw TypeError.new 'Rip App: createApply requires renderer.remountDirty'
  unless typeof opts.escape is 'function'
    throw TypeError.new 'Rip App: createApply requires an escape remount'
  report = opts.report ?? (...args) -> console.log ...args

  absorb = (paths) ->
    unless Array.isArray(paths) and paths.length > 0
      return 'ignore'
    css = (p for p in paths when typeof p is 'string' and p.endsWith '.css')
    rip = (p for p in paths when typeof p is 'string' and p.endsWith '.rip')
    ordinary = (p for p in paths when typeof p is 'string' and not p.endsWith('.rip') and not p.endsWith('.css'))

    # *.css is always css; every other ordinary managed asset reloads.
    if rip.length is 0
      return 'reload' if ordinary.length > 0
      return 'css' if css.length > 0
      return 'ignore'

    verdict = 'escape'
    try
      verdict = opts.renderer.remountDirty! rip
    catch error
      report '[Rip] update failed — falling back to full in-page remount', error
      verdict = 'escape'

    if verdict is 'narrow'
      report "[Rip] applied #{rip.join ', '} — update"
      return 'update'
    return 'ignore' if verdict is 'noop'

    opts.escape! rip
    report "[Rip] applied #{rip.join ', '} — update"
    'update'

  { absorb }
