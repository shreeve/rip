# Rip hash: six characters from SHA-256 over exact bytes. Base64URL's `-`
# folds into `_` so a rash remains one double-clickable word.

asBytes = (value) ->
  return value if value instanceof Uint8Array
  return new Uint8Array(value) if value instanceof ArrayBuffer
  if ArrayBuffer.isView(value)
    return new Uint8Array(value.buffer, value.byteOffset, value.byteLength)
  throw new TypeError 'Rip App: rash expects bytes'

sha256 = (input) ->
  bytes = asBytes input
  if typeof Bun isnt 'undefined' and Bun.CryptoHasher?
    return new Uint8Array(new Bun.CryptoHasher('sha256').update(bytes).digest())

  K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
  ]
  bitLen = bytes.length * 8
  padded = new Uint8Array(((bytes.length + 9 + 63) & ~63))
  padded.set bytes
  padded[bytes.length] = 0x80
  view = new DataView(padded.buffer)
  view.setUint32 padded.length - 4, bitLen >>> 0, false
  view.setUint32 padded.length - 8, Math.floor(bitLen / 0x100000000) >>> 0, false
  H = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
  rotr = (x, n) -> (x >>> n) | (x << (32 - n))
  w = new Uint32Array(64)
  i = 0
  while i < padded.length
    w[j] = view.getUint32(i + j * 4, false) for j in [0...16]
    for j in [16...64]
      s0 = rotr(w[j - 15], 7) ^ rotr(w[j - 15], 18) ^ (w[j - 15] >>> 3)
      s1 = rotr(w[j - 2], 17) ^ rotr(w[j - 2], 19) ^ (w[j - 2] >>> 10)
      w[j] = (w[j - 16] + s0 + w[j - 7] + s1) >>> 0
    [a, b, c, d, e, f, g, h] = H
    for j in [0...64]
      S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
      ch = (e & f) ^ (~e & g)
      temp1 = (h + S1 + ch + K[j] + w[j]) >>> 0
      S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
      maj = (a & b) ^ (a & c) ^ (b & c)
      temp2 = (S0 + maj) >>> 0
      h = g
      g = f
      f = e
      e = (d + temp1) >>> 0
      d = c
      c = b
      b = a
      a = (temp1 + temp2) >>> 0
    H[0] = (H[0] + a) >>> 0
    H[1] = (H[1] + b) >>> 0
    H[2] = (H[2] + c) >>> 0
    H[3] = (H[3] + d) >>> 0
    H[4] = (H[4] + e) >>> 0
    H[5] = (H[5] + f) >>> 0
    H[6] = (H[6] + g) >>> 0
    H[7] = (H[7] + h) >>> 0
    i += 64
  digest = new Uint8Array(32)
  out = new DataView(digest.buffer)
  out.setUint32(i * 4, H[i], false) for i in [0...8]
  digest

export rash = (value) ->
  d = sha256 value
  alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_'
  text = alphabet[d[0] >> 2] +
    alphabet[((d[0] & 3) << 4) | (d[1] >> 4)] +
    alphabet[((d[1] & 15) << 2) | (d[2] >> 6)] +
    alphabet[d[2] & 63] +
    alphabet[d[3] >> 2] +
    alphabet[((d[3] & 3) << 4) | (d[4] >> 4)]
  text.replaceAll '-', '_'
