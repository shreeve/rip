# ==============================================================================
# Workspace and publication-feed contract
# ==============================================================================

import { test, eq, ok, throws } from '@rip-lang/testing'
import { createWorkspace } from '../workspace.rip'
import * as workspaceMod from '../workspace.rip'
import { connectFeed } from '../feed.rip'
import * as feedMod from '../feed.rip'
import { readFileSync } from 'fs'

HASH_1 = 'AAAAAA'
HASH_2 = 'BBBBBB'
HASH_3 = 'CCCCCC'

state = (hash = HASH_1, source = 'export App = component') ->
  hash: hash
  sources: { 'app.rip': source }
  compiled: { 'app.rip': { App: { source } } }

console.log "\nPackage"

test "named exports", ->
  eq Object.keys(workspaceMod).sort(), ['createWorkspace']
  eq Object.keys(feedMod).sort(), ['connectFeed']

test "workspace and feed use no Node or Bun host dependency", ->
  for file in ['workspace.rip', 'feed.rip']
    source = readFileSync "#{import.meta.dir}/../#{file}", 'utf8'
    eq /\bnode:|process\.|\bBun\./.test(source), false

test "workspace performs no hashing", ->
  source = readFileSync "#{import.meta.dir}/../workspace.rip", 'utf8'
  eq source.includes("./rash.rip"), false
  eq /TextEncoder|crypto\./.test(source), false

console.log "\nWorkspace"

test "activate commits prepared source, compiled modules, and one declared hash", ->
  ws = createWorkspace()
  prepared = state()
  ws.activate prepared
  eq ws.hash(), HASH_1
  eq ws.read('app.rip'), prepared.sources['app.rip']
  ok ws.getCompiled('app.rip') is prepared.compiled['app.rip']

test "activate is one-time and validates before changing state", ->
  ws = createWorkspace()
  throws (-> ws.activate({ hash: HASH_1, sources: { broken: 'x' }, compiled: {} })), 'invalid component path'
  eq ws.hash(), null
  ws.activate state()
  throws (-> ws.activate(state())), 'already active'

test "only Rip module paths belong to Workspace", ->
  ws = createWorkspace()
  for path in ['styles.css', 'index.html', 'images/rip.png', '/app.rip', '.hidden/app.rip', 'routes/../app.rip', 'routes/app.rip/child.rip']
    throws (-> ws.write(path, 'x')), 'invalid component path'

test "component-store writes, lists, compilation, and watches remain available", ->
  ws = createWorkspace()
  events = []
  stop = ws.watch (event, path) -> events.push [event, path]
  ws.write 'app.rip', 'one'
  ws.write 'routes/index.rip', 'two'
  ws.setCompiled 'app.rip', { App: {} }
  eq ws.list(), ['app.rip']
  eq ws.listAll('routes'), ['routes/index.rip']
  ok ws.getCompiled('app.rip')?
  ws.write 'app.rip', 'three'
  eq ws.getCompiled('app.rip'), undefined
  ws.del 'routes/index.rip'
  stop()
  ws.write 'other.rip', 'four'
  eq events, [['create', 'app.rip'], ['create', 'routes/index.rip'], ['change', 'app.rip'], ['delete', 'routes/index.rip']]

test "commit replaces the complete state before notifying changed paths", ->
  ws = createWorkspace()
  ws.activate state()
  seen = []
  ws.watch (event, path) -> seen.push [event, path, ws.hash(), ws.read('app.rip')]
  ws.commit HASH_1, state(HASH_2, 'replacement'), ['app.rip']
  eq ws.hash(), HASH_2
  eq seen, [['change', 'app.rip', HASH_2, 'replacement']]

test "commit supports Rip creation and deletion as one transaction", ->
  ws = createWorkspace()
  ws.activate
    hash: HASH_1
    sources: { 'app.rip': 'a', 'routes/old.rip': 'old' }
    compiled: { 'app.rip': {}, 'routes/old.rip': {} }
  events = []
  ws.watch (event, path) -> events.push [event, path]
  ws.commit HASH_1,
    hash: HASH_2
    sources: { 'app.rip': 'a', 'routes/new.rip': 'new' }
    compiled: { 'app.rip': {}, 'routes/new.rip': {} }
  , ['routes/old.rip', 'routes/new.rip']
  eq ws.exists('routes/old.rip'), false
  eq ws.exists('routes/new.rip'), true
  eq events, [['delete', 'routes/old.rip'], ['create', 'routes/new.rip']]

test "a from mismatch and malformed prepared state leave the active publication untouched", ->
  ws = createWorkspace()
  ws.activate state()
  throws (-> ws.commit(HASH_2, state(HASH_3), [])), 'not AAAAAA'
  throws (-> ws.commit(HASH_1, { hash: HASH_2, sources: { 'app.rip': 4 }, compiled: {} }, [])), 'must be a string'
  eq ws.hash(), HASH_1
  eq ws.read('app.rip'), 'export App = component'

test "compiled modules must name source in the same prepared state", ->
  ws = createWorkspace()
  throws (-> ws.activate({ hash: HASH_1, sources: {}, compiled: { 'ghost.rip': {} } })), 'has no source'

console.log "\nFeed"

settle = ->
  Promise.new! (resolve) -> setTimeout resolve, 0
  Promise.new! (resolve) -> setTimeout resolve, 0
  return

fakeHub = ->
  sockets = []
  factory = (url) ->
    socket =
      url: url
      sent: []
      onopen: null
      onmessage: null
      onclose: null
      onerror: null
    socket.send = (text) -> socket.sent.push text
    socket.close = -> socket.onclose?()
    sockets.push socket
    socket
  { factory, sockets }

fakeFetch = (routes) ->
  calls = []
  fn = (url, opts = {}) ->
    calls.push { url, opts }
    value = routes[url]
    value = value! if typeof value is 'function'
    if value?
      { ok: true, status: 200, json: -> JSON.parse(value) }
    else
      { ok: false, status: 404, json: -> null }
  { fn, calls }

openFeed = (initial = HASH_1, routes = { '/latest.json': JSON.stringify({ hash: HASH_1 }) }, extra = {}) ->
  active = initial
  applied = []
  reloads = []
  reports = []
  { factory, sockets } = fakeHub()
  { fn, calls } = fakeFetch routes
  client =
    hash: -> active
    apply: (change) ->
      applied.push change
      return false unless change.from is active
      active = change.hash
      true
    reload: (reason) -> reloads.push reason
  options = Object.assign {},
    hub: 'ws://test/hub'
    makeSocket: factory
    fetch: fn
    report: (...args) -> reports.push args
    backoff: { min: 1, max: 2 }
    ackTimeout: 100
  , extra
  feed = connectFeed client, options
  { feed, sockets, calls, applied, reloads, reports, active: -> active }

ack = (socket) ->
  join = JSON.parse socket.sent[0]
  socket.onmessage { data: JSON.stringify({ '!': join['?'] }) }
  return

test "connectFeed validates the callback boundary", ->
  throws (-> connectFeed(null)), 'expects hash, apply, and reload callbacks'
  throws (-> connectFeed({ hash: (-> 'bad'), apply: (-> true), reload: (->) }, { hub: 'x', makeSocket: (-> {}) })), 'client hash'

test! "open subscribes with an acknowledgement token before probing latest.json", ->
  { feed, sockets, calls } = openFeed()
  socket = sockets[0]
  socket.onopen()
  join = JSON.parse socket.sent[0]
  eq join['+'], ['/hub']
  ok typeof join['?'] is 'string'
  eq calls.length, 0
  ack socket
  settle!
  eq calls.length, 1
  eq calls[0].url, '/latest.json'
  eq calls[0].opts.cache, 'no-store'
  ok feed.connected()
  feed.close()

test! "a change received before acknowledgement is buffered and may explain latest", ->
  routes = { '/latest.json': JSON.stringify({ hash: HASH_2 }) }
  { feed, sockets, applied, reloads, active } = openFeed HASH_1, routes
  socket = sockets[0]
  socket.onopen()
  change = { from: HASH_1, hash: HASH_2, list: [['app.rip', 'v2']] }
  socket.onmessage { data: JSON.stringify({ change }) }
  eq applied, []
  ack socket
  settle!
  eq applied, [change]
  eq active(), HASH_2
  eq reloads, []
  feed.close()

test! "a latest hash outside the subscribed change chain reloads", ->
  routes = { '/latest.json': JSON.stringify({ hash: HASH_2 }) }
  { feed, sockets, reloads } = openFeed HASH_1, routes
  sockets[0].onopen()
  ack sockets[0]
  settle!
  eq reloads.length, 1
  eq feed.connected(), false
  feed.close()

test! "live changes apply serially in WSS arrival order", ->
  { feed, sockets, applied, active } = openFeed()
  socket = sockets[0]
  socket.onopen()
  ack socket
  settle!
  first = { from: HASH_1, hash: HASH_2, list: [] }
  second = { from: HASH_2, hash: HASH_3, list: [] }
  socket.onmessage { data: JSON.stringify([{ change: first }, { chat: 'foreign' }, { change: second }]) }
  settle!
  eq applied, [first, second]
  eq active(), HASH_3
  feed.close()

test! "malformed publication JSON reloads instead of guessing", ->
  { feed, sockets, reloads, reports } = openFeed()
  sockets[0].onopen()
  sockets[0].onmessage { data: '{bad' }
  settle!
  eq reloads.length, 1
  ok reports.some((args) -> String(args[0]).includes('invalid JSON'))
  feed.close()

test! "a dropped connection resubscribes with a fresh token and probes again", ->
  { feed, sockets, calls } = openFeed()
  sockets[0].onopen()
  ack sockets[0]
  settle!
  firstToken = JSON.parse(sockets[0].sent[0])['?']
  sockets[0].onclose()
  Promise.new! (resolve) -> setTimeout resolve, 10
  eq sockets.length, 2
  sockets[1].onopen()
  secondToken = JSON.parse(sockets[1].sent[0])['?']
  ok secondToken isnt firstToken
  ack sockets[1]
  settle!
  eq calls.length, 2
  feed.close()
