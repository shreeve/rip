# Route-aware accessibility — the app-owned helpers navigation needs.
#
# `ariaCurrent` keeps `aria-current` truthful across every anchor the
# router owns: the exact route gets `"page"`, an ancestor path gets
# `"true"`, and a mark this walker set is removed the moment its anchor
# stops earning it — including an href rewritten to somewhere the
# router no longer claims. A mark the application manages itself is
# never set over and never removed — WHENEVER it appears: the walker
# remembers the value it wrote per anchor, and an anchor whose mark is
# not that value has been taken over by the application, so the walker
# disowns it on sight (clearing the walker's mark releases the anchor
# to be re-earned instead). The DOM arrives through an injectable
# host, so the walker tests under Node; the browser default walks
# `document` and — when MutationObserver exists — re-runs on childList
# and link-attribute mutations; without it, marks refresh on every
# navigation.
#
# `ownsAnchor` is the one shared predicate for anchor ownership —
# `aria-current`, link preloading, and click interception must never
# disagree about which links belong to the router. It resolves the
# anchor's EXTERNAL href through `router.claims`, so base paths and
# hash mode follow the router's own reading.

excluded = (anchor) ->
  return true if anchor.hasAttribute?('data-router-ignore')
  return true if anchor.hasAttribute?('download')
  targetAttr = anchor.getAttribute?('target')
  return true if targetAttr and targetAttr.toLowerCase() isnt '_self'
  false

# Package-internal: the one reading of an anchor's EXTERNAL href —
# `links.rip` resolves the same spelling `ownsAnchor` judged, so the
# href a click navigates is the href ownership approved.
export def _anchorHref(anchor): string | null
  href = anchor.getAttribute?('href') ?? anchor.href
  return null unless typeof href is 'string' and href.length > 0
  if /^[a-z][a-z0-9+.-]*:/i.test href
    origin = if typeof location isnt 'undefined' then location.origin else null
    return null unless origin? and href.startsWith(origin)
    href = href.slice origin.length
  # A protocol-relative or backslashed spelling reads as cross-origin
  # in a browser; it is never ours.
  return null if href.startsWith('//') or href.includes('\\')
  href

export def ownsAnchor(router, anchor): boolean
  return false unless anchor?
  return false if excluded anchor
  href = _anchorHref anchor
  return false unless href?
  router.claims(href)?

browserHost = ->
  unless typeof document isnt 'undefined' and typeof document.querySelectorAll is 'function'
    throw Error.new 'Rip App: ariaCurrent requires a browser or an injected host'
  anchors: -> Array.from document.querySelectorAll('a[href]')
  observe: (fn) ->
    # A partial DOM (an SSR or test shim with querySelectorAll but no
    # MutationObserver) still hosts the walker: marks refresh on every
    # navigation, they just do not chase DOM mutations between them.
    return null if typeof MutationObserver is 'undefined'
    scheduled = false
    observer = MutationObserver.new ->
      return if scheduled
      scheduled = true
      requestAnimationFrame ->
        scheduled = false
        fn()
    observer.observe (document.documentElement ?? document.body),
      childList: true
      subtree: true
      attributes: true
      attributeFilter: ['href', 'target', 'download', 'data-router-ignore']
    -> observer.disconnect()

export def ariaCurrent(router, host: { anchors: () => any[], observe?: (fn: () => void) => () => void } = null): () => void
  unless router? and typeof router.claims is 'function'
    throw TypeError.new 'Rip App: ariaCurrent requires a router'
  host = host ?? browserHost()
  # Anchor → the exact value this walker last wrote there. Ownership is
  # conditional on that value surviving: a different mark means the
  # application took the anchor over, and the walker backs off.
  owned = WeakMap.new()

  markCurrent = ->
    current = router.path
    for anchor in host.anchors()
      hit = if excluded(anchor) then null else router.claims(_anchorHref(anchor) ?? '')
      state = if not hit? or not current? then null
      else if hit.path is current then 'page'
      else if hit.path isnt '/' and current.startsWith(hit.path + '/') then 'true'
      else null
      mark = anchor.getAttribute?('aria-current') ?? null
      wrote = owned.get anchor
      # A claimed anchor whose mark is no longer the walker's own has
      # been taken over by the application: disown it, and touch it
      # again only if the app CLEARED the mark (nothing to protect —
      # the anchor is free to be re-earned this same walk).
      if wrote isnt undefined and mark isnt wrote
        owned.delete anchor
        continue if mark?
        wrote = undefined
      if state?
        # Never set over a mark the application manages itself.
        continue if wrote is undefined and mark?
        anchor.setAttribute 'aria-current', state unless mark is state
        owned.set anchor, state
      else if wrote isnt undefined
        anchor.removeAttribute 'aria-current'
        owned.delete anchor
    return

  # A host failure must never abort the navigation that triggered the
  # walk — the router's dispatch owns that moment.
  walk = ->
    try
      markCurrent()
    catch error
      console.error '[Rip] aria-current walk failed:', error
    return

  disposeEffect = __effect ->
    router.path
    walk()
  unobserve = host.observe?(walk) ?? null
  disposed = false
  ->
    return if disposed
    disposed = true
    disposeEffect()
    unobserve?()
    # Marks must not outlive their walker — but only the walker's own:
    # a mark the application overwrote since is theirs to keep.
    try
      for anchor in host.anchors()
        if owned.has anchor
          anchor.removeAttribute 'aria-current' if (anchor.getAttribute?('aria-current') ?? null) is owned.get(anchor)
          owned.delete anchor
    catch error
      null
    return
