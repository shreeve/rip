# Inline lucide icons (https://lucide.dev/icons/) — all share viewBox "0 0 24 24" + 2px stroke.
# To add one: paste its path/shape data into the switch and add its name to IconName.

export type IconName =
  | 'menu'
  | 'moon'
  | 'sun'

export Icon = component extends svg
  @name: IconName
  @strokeWidth?: number := 2
  render
    svg
      viewBox: '0 0 24 24'
      fill: 'none'
      stroke: 'currentColor'
      stroke-width: strokeWidth
      stroke-linecap: 'round'
      stroke-linejoin: 'round'
      aria-hidden: 'true'
      switch name
        when 'menu'
          path d: 'M4 5h16'
          path d: 'M4 12h16'
          path d: 'M4 19h16'
        when 'moon'
          path d: 'M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'
        when 'sun'
          circle cx: 12, cy: 12, r: 4
          path d: 'M12 2v2'
          path d: 'M12 20v2'
          path d: 'm4.93 4.93 1.41 1.41'
          path d: 'm17.66 17.66 1.41 1.41'
          path d: 'M2 12h2'
          path d: 'M20 12h2'
          path d: 'm6.34 17.66-1.41 1.41'
          path d: 'm19.07 4.93-1.41 1.41'
