import { Drawer } from 'rip/ui'
import { COMPONENTS } from '../components.rip'
import { Button } from '../components/button.rip'
import { Controls, Page, Stage } from '../components/page.rip'

# Each slide also sets the other axis to zero: WebKit does not substitute
# an unset registered property's initial value inside @starting-style.
# Each panel bleeds 3rem past its edge, padded to match, so a pull into
# the screen reveals panel rather than the page behind it.
PANEL: Record<Drawer.Side, string> = {
  left:   'mr-auto -ml-12 h-dvh max-h-none w-[calc(20rem+3rem)] max-w-[calc(100vw-3rem+3rem)] pl-[calc(1.5rem+3rem)] -translate-x-full translate-y-0 data-open:translate-x-0 starting:data-open:-translate-x-full'
  right:  '-mr-12 ml-auto h-dvh max-h-none w-[calc(20rem+3rem)] max-w-[calc(100vw-3rem+3rem)] pr-[calc(1.5rem+3rem)] translate-x-full translate-y-0 data-open:translate-x-0 starting:data-open:translate-x-full'
  top:    '-mt-12 mb-auto w-dvw max-w-none h-[calc(20rem+3rem)] max-h-[calc(100dvh-3rem+3rem)] pt-[calc(1.5rem+3rem)] -translate-y-full translate-x-0 data-open:translate-y-0 starting:data-open:-translate-y-full'
  bottom: 'mt-auto -mb-12 w-dvw max-w-none h-[calc(20rem+3rem)] max-h-[calc(100dvh-3rem+3rem)] pb-[calc(1.5rem+3rem)] translate-y-full translate-x-0 data-open:translate-y-0 starting:data-open:translate-y-full'
}

export DrawerPage = component
  open := false
  side: Drawer.Side := 'right'
  closedby: Drawer.ClosedBy | undefined := undefined
  render
    Page title: COMPONENTS.drawer.name, description: COMPONENTS.drawer.description
      Stage
        Drawer.Root open <=> open
          Drawer.Trigger asChild
            Button 'Open Drawer'
          Drawer.Popup
            side: side
            closedby: closedby
            class: [
              PANEL[side]
              'bg-surface p-6 shadow-xl transition-[translate] duration-[calc(var(--swipe-strength,1)*400ms)] ease-out-slow data-open:duration-450'
              'backdrop:bg-backdrop backdrop:opacity-0 backdrop:duration-[calc(var(--swipe-strength,1)*400ms)] backdrop:ease-out-slow data-open:backdrop:duration-450 data-open:backdrop:opacity-[calc(1-var(--swipe-progress,0))] starting:data-open:backdrop:opacity-0 data-swiping:backdrop:duration-0'
            ]
            Drawer.Title class: 'text-lg font-semibold', 'Settings'
            Drawer.Description class: 'mt-2 text-secondary', 'Swipe the panel toward its side to dismiss it, or use the button.'
            div class: 'mt-6 flex justify-end'
              Drawer.Close asChild
                Button 'Close'

      Controls.Panel title: 'Drawer.Popup'
        Controls.Row name: 'side'
          for option in ['left', 'right', 'top', 'bottom'] satisfies Drawer.Side[]
            Controls.Choice pressed: side is option, @click: (-> side = option), option
        Controls.Row name: 'closedby'
          for option in [undefined, 'any', 'closerequest', 'none'] satisfies (Drawer.ClosedBy | undefined)[]
            Controls.Choice pressed: closedby is option, @click: (-> closedby = option), option ?? 'not passed'
