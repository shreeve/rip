import { Dialog, DialogClose, DialogPopup, DialogTitle, DialogTrigger, Menu, MenuItem, MenuLink, MenuPopup, MenuTrigger } from 'rip/ui'
import { COMPONENTS } from '../components.rip'

export MenuPage = component
  open := false
  selected := ''
  render
    div class: 'mx-auto max-w-2xl px-5 py-8 md:px-8 md:py-10'
      h1 class: 'text-2xl font-semibold', COMPONENTS.menu.name
      p class: 'mt-2 text-secondary', COMPONENTS.menu.description

      div class: 'mt-8 flex items-center justify-center rounded-xl border border-surface bg-surface py-16'
        Menu open <=> open
          MenuTrigger
            class: 'rounded-lg border border-transparent bg-accent px-3 py-2 text-sm font-medium text-on-accent hover:bg-accent-hover active:bg-accent-active'
            'Open Menu'
          MenuPopup
            class: [
              'mt-1.5 w-56 scale-95 rounded-xl border border-surface bg-surface p-1 opacity-0 shadow-xl outline-none transition transition-discrete duration-150 ease-dialog'
              'data-open:duration-250 data-open:scale-100 data-open:opacity-100 starting:data-open:scale-95 starting:data-open:opacity-0'
            ]
            MenuLink href: '/dialog', class: 'flex w-full items-center rounded-lg px-3 py-2 text-sm font-medium text-secondary outline-none focus:bg-surface-hover focus:text-primary', 'Dialog'
            MenuItem class: 'flex w-full items-center rounded-lg px-3 py-2 text-sm font-medium text-secondary outline-none focus:bg-surface-hover focus:text-primary', @click: (-> selected = 'Settings'), 'Settings'
            MenuItem class: 'flex w-full items-center rounded-lg px-3 py-2 text-sm font-medium text-secondary outline-none focus:bg-surface-hover focus:text-primary', @click: (-> selected = 'Sign Out'), 'Sign Out'

      section class: 'mt-8 rounded-xl border border-surface bg-surface p-5'
        h2 class: 'text-xs-plus font-medium text-tertiary', 'Parent'
        p class: 'mt-2 text-sm text-secondary', 'The page binds the root with open <=> open, and an item reports its click.'
        div class: 'mt-4 flex items-center gap-4'
          code class: 'rounded bg-muted px-2 py-1 font-mono text-sm', "open: #{open}"
          code class: 'rounded bg-muted px-2 py-1 font-mono text-sm', "selected: #{selected or 'none'}"
          button
            type: 'button'
            class: 'rounded-lg border border-input bg-input px-3 py-2 text-sm font-medium text-secondary hover:bg-input-hover active:bg-input-active'
            @click: (-> open = true)
            'Open from the Parent'

      section class: 'mt-8 rounded-xl border border-surface bg-surface p-5'
        h2 class: 'text-xs-plus font-medium text-tertiary', 'Inside a dialog'
        p class: 'mt-2 text-sm text-secondary', 'A menu rendered inside a modal dialog opens in the top layer above it, and Escape closes the menu before the dialog.'
        div class: 'mt-4'
          Dialog
            DialogTrigger
              class: 'rounded-lg border border-input bg-input px-3 py-2 text-sm font-medium text-secondary hover:bg-input-hover active:bg-input-active'
              'Open Dialog'
            DialogPopup
              class: [
                'm-auto w-96 scale-95 rounded-xl bg-surface p-6 opacity-0 shadow-xl transition-[opacity,scale] duration-150 ease-dialog'
                'data-open:duration-250 data-open:scale-100 data-open:opacity-100 starting:data-open:scale-95 starting:data-open:opacity-0'
                'backdrop:bg-backdrop backdrop:opacity-0 backdrop:duration-150 backdrop:ease-dialog data-open:backdrop:duration-250 data-open:backdrop:opacity-100 starting:data-open:backdrop:opacity-0'
              ]
              DialogTitle class: 'text-lg font-semibold', 'Account'
              div class: 'mt-6 flex items-center justify-between'
                Menu
                  MenuTrigger
                    class: 'rounded-lg border border-input bg-input px-3 py-2 text-sm font-medium text-secondary hover:bg-input-hover active:bg-input-active'
                    'Open Inner Menu'
                  MenuPopup
                    class: [
                      'mt-1.5 w-56 scale-95 rounded-xl border border-surface bg-surface p-1 opacity-0 shadow-xl outline-none transition transition-discrete duration-150 ease-dialog'
                      'data-open:duration-250 data-open:scale-100 data-open:opacity-100 starting:data-open:scale-95 starting:data-open:opacity-0'
                    ]
                    MenuItem class: 'flex w-full items-center rounded-lg px-3 py-2 text-sm font-medium text-secondary outline-none focus:bg-surface-hover focus:text-primary', @click: (-> selected = 'Inner Settings'), 'Inner Settings'
                    MenuItem class: 'flex w-full items-center rounded-lg px-3 py-2 text-sm font-medium text-secondary outline-none focus:bg-surface-hover focus:text-primary', @click: (-> selected = 'Inner Sign Out'), 'Inner Sign Out'
                DialogClose
                  class: 'rounded-lg border border-transparent bg-accent px-3 py-2 text-sm font-medium text-on-accent hover:bg-accent-hover active:bg-accent-active'
                  'Close'
