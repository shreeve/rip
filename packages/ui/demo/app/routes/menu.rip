import { Dialog, Menu } from 'rip/ui'
import { COMPONENTS } from '../components.rip'
import { Button } from '../components/button.rip'
import { Choice, Controls, Page, Row, Stage } from '../components/page.rip'

ITEM = 'flex w-full items-center rounded-lg px-3 py-2 text-sm font-medium text-secondary outline-none focus:bg-surface-hover focus:text-primary'

export MenuPage = component
  open := false
  selected := ''
  side: Menu.Side := 'bottom'
  align: Menu.Align := 'start'
  sideOffset := 6
  render
    Page title: COMPONENTS.menu.name, description: COMPONENTS.menu.description
      Stage
        Menu.Root open <=> open
          Menu.Trigger asChild
            Button 'Open Menu'
          Menu.Popup
            side: side
            align: align
            sideOffset: sideOffset
            class: [
              'w-56 origin-(--transform-origin) scale-95 rounded-xl border border-surface bg-surface p-1 opacity-0 shadow-lg/6 transition transition-discrete duration-150 ease-dialog outline-none'
              'data-open:scale-100 data-open:opacity-100 data-open:duration-250 starting:data-open:scale-95 starting:data-open:opacity-0'
            ]
            Menu.Link href: '/dialog', class: ITEM, 'Dialog'
            Menu.Item class: ITEM, @click: (-> selected = 'Settings'), 'Settings'
            Menu.Item class: ITEM, @click: (-> selected = 'Sign Out'), 'Sign Out'

      Controls
        Row name: 'side'
          for option in ['bottom', 'top', 'left', 'right'] satisfies Menu.Side[]
            Choice pressed: side is option, @click: (-> side = option), option
        Row name: 'align'
          for option in ['start', 'center', 'end'] satisfies Menu.Align[]
            Choice pressed: align is option, @click: (-> align = option), option
        Row name: 'sideOffset'
          for option in [0, 6, 12]
            Choice pressed: sideOffset is option, @click: (-> sideOffset = option), "#{option}"
        Row name: 'selected'
          span class: 'text-sm font-medium text-secondary', selected or 'none'

      Stage
        Dialog.Root
          Dialog.Trigger asChild
            Button variant: 'secondary', 'Open Dialog'
          Dialog.Popup
            class: [
              'm-auto w-96 scale-95 rounded-xl bg-surface p-6 opacity-0 shadow-xl transition-[opacity,scale] duration-150 ease-dialog'
              'data-open:duration-250 data-open:scale-100 data-open:opacity-100 starting:data-open:scale-95 starting:data-open:opacity-0'
              'backdrop:bg-backdrop backdrop:opacity-0 backdrop:duration-150 backdrop:ease-dialog data-open:backdrop:duration-250 data-open:backdrop:opacity-100 starting:data-open:backdrop:opacity-0'
            ]
            Dialog.Title class: 'text-lg font-semibold', 'Account'
            div class: 'mt-6 flex items-center justify-between'
              Menu.Root
                Menu.Trigger asChild
                  Button variant: 'secondary', 'Open Inner Menu'
                Menu.Popup
                  sideOffset: 6
                  class: [
                    'w-56 origin-(--transform-origin) scale-95 rounded-xl border border-surface bg-surface p-1 opacity-0 shadow-lg/6 transition transition-discrete duration-150 ease-dialog outline-none'
                    'data-open:scale-100 data-open:opacity-100 data-open:duration-250 starting:data-open:scale-95 starting:data-open:opacity-0'
                  ]
                  Menu.Item class: ITEM, @click: (-> selected = 'Inner Settings'), 'Inner Settings'
                  Menu.Item class: ITEM, @click: (-> selected = 'Inner Sign Out'), 'Inner Sign Out'
              Dialog.Close asChild
                Button 'Close'
