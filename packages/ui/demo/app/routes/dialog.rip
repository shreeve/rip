import { Dialog } from 'rip/ui'
import { COMPONENTS } from '../components.rip'
import { Button } from '../components/button.rip'
import { Controls, Page, Stage } from '../components/page.rip'

export DialogPage = component
  open := false
  closedby: Dialog.ClosedBy | undefined := undefined
  render
    Page title: COMPONENTS.dialog.name, description: COMPONENTS.dialog.description
      Stage
        Dialog.Root open <=> open
          Dialog.Trigger asChild
            Button 'Open Dialog'
          Dialog.Popup
            closedby: closedby
            class: [
              'm-auto w-96 scale-95 rounded-xl bg-surface p-6 opacity-0 shadow-xl transition-[opacity,scale] duration-150 ease-dialog'
              'data-open:duration-250 data-open:scale-100 data-open:opacity-100 starting:data-open:scale-95 starting:data-open:opacity-0'
              'backdrop:bg-backdrop backdrop:opacity-0 backdrop:duration-150 backdrop:ease-dialog data-open:backdrop:duration-250 data-open:backdrop:opacity-100 starting:data-open:backdrop:opacity-0'
            ]
            Dialog.Title class: 'text-lg font-semibold', 'Notifications'
            Dialog.Description class: 'mt-2 text-secondary', 'You are all caught up. Good job!'
            div class: 'mt-6 flex justify-end'
              Dialog.Close asChild
                Button 'Close'

      Controls.Panel title: 'Dialog.Popup'
        Controls.Row name: 'closedby'
          for option in [undefined, 'any', 'closerequest', 'none'] satisfies (Dialog.ClosedBy | undefined)[]
            Controls.Choice pressed: closedby is option, @click: (-> closedby = option), option ?? 'not passed'
