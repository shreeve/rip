counter = 0
mint = (part: string): string -> "rip-dialog-#{part}-#{counter += 1}"

export Dialog = component
  offer @open := false
  offer labelledBy := ''
  offer describedBy := ''
  render
    slot

export DialogTrigger = component extends button
  accept open
  render
    button
      type: 'button'
      data-popup-open: open or undefined
      aria-haspopup: 'dialog'
      aria-expanded: if open then 'true' else 'false'
      @click: (-> open = true)
      slot

# The effect's first run happens before the mounted tree reaches the
# document, and showModal throws on a disconnected element, so a dialog
# that starts open would fail its mount. Opening waits a microtask.
export DialogPopup = component extends dialog
  accept open
  accept labelledBy
  accept describedBy
  el: HTMLDialogElement | null := null
  ~>
    dialog = el
    return unless dialog
    if open
      queueMicrotask -> dialog.showModal() if open and not dialog.open and dialog.isConnected
    else
      dialog.close() if dialog.open
  render
    dialog
      ref: el
      closedby: @rest.closedby ?? 'any'
      data-open: open or undefined
      data-closed: not open or undefined
      aria-labelledby: labelledBy or undefined
      aria-describedby: describedBy or undefined
      @close: (-> open = false)
      slot

export DialogTitle = component extends h2
  accept labelledBy
  id =! @rest.id ?? mint('title')
  ~>
    labelledBy = id
    -> labelledBy = ''
  render
    h2 id: id
      slot

export DialogDescription = component extends p
  accept describedBy
  id =! @rest.id ?? mint('description')
  ~>
    describedBy = id
    -> describedBy = ''
  render
    p id: id
      slot

export DialogClose = component extends button
  accept open
  render
    button
      type: 'button'
      @click: (-> open = false)
      slot
