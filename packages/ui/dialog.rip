counter = 0
mint = (part: string): string -> "rip-dialog-#{part}-#{counter += 1}"

export Dialog = component
  offer @open := false
  offer labelledBy := ''
  offer describedBy := ''
  render
    slot

export DialogTrigger = component extends button
  accept open
  render
    button
      type: 'button'
      data-popup-open: open or undefined
      aria-haspopup: 'dialog'
      aria-expanded: if open then 'true' else 'false'
      @click: (-> open = true)
      slot

# The effect's first run happens before the mounted tree reaches the
# document, and showModal throws on a disconnected element, so a dialog
# that starts open would fail its mount. Opening waits a microtask.
#
# Firefox and WebKit render a closed dialog as display: none at once,
# whatever its transition says, so closing flips data-open first and
# calls close() only once the popup's own animations settle; styles key
# on data-open, never on [open]. Escape is canceled and routed through
# the cell for the same reason. A cancel the browser marks uncancelable
# still closes natively, without the exit.
export DialogPopup = component extends dialog
  accept open
  accept labelledBy
  accept describedBy
  el: HTMLDialogElement | null := null
  closedBy ~= @rest.closedby ?? 'any'

  # Stable Safari and every iOS browser ignore closedby, so a press that
  # starts and ends on the backdrop closes here and Escape is refused
  # under none; where the attribute works the browser does both. Goes
  # when Safari ships it.
  pressed = false
  onBackdrop = (e: PointerEvent): boolean ->
    return false unless e.target is e.currentTarget
    r = (e.currentTarget as HTMLDialogElement).getBoundingClientRect()
    e.clientX < r.left or e.clientX > r.right or e.clientY < r.top or e.clientY > r.bottom
  press = (e: PointerEvent) -> pressed = onBackdrop(e)
  release = (e: PointerEvent) -> open = false if pressed and onBackdrop(e) and closedBy is 'any'

  cancel = (e: Event) ->
    e.preventDefault()
    open = false unless closedBy is 'none'

  ~>
    dialog = el
    return unless dialog
    if open
      queueMicrotask -> dialog.showModal() if open and not dialog.open and dialog.isConnected
    else if dialog.open
      queueMicrotask ->
        exits = dialog.getAnimations().map (a) -> a.finished
        Promise.allSettled(exits).then -> dialog.close() if not open and dialog.open

  render
    dialog
      ref: el
      closedby: closedBy
      data-open: open or undefined
      data-closed: not open or undefined
      aria-labelledby: labelledBy or undefined
      aria-describedby: describedBy or undefined
      @pointerdown: press
      @pointerup: release
      @cancel: cancel
      @close: (-> open = false)
      slot

export DialogTitle = component extends h2
  accept labelledBy
  id =! @rest.id ?? mint('title')
  ~>
    labelledBy = id
    -> labelledBy = ''
  render
    h2 id: id
      slot

export DialogDescription = component extends p
  accept describedBy
  id =! @rest.id ?? mint('description')
  ~>
    describedBy = id
    -> describedBy = ''
  render
    p id: id
      slot

export DialogClose = component extends button
  accept open
  render
    button
      type: 'button'
      @click: (-> open = false)
      slot
