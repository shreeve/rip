export type DialogClosedBy = 'any' | 'closerequest' | 'none'

export Dialog = component
  offer @open := false
  offer labelledBy := ''
  offer describedBy := ''
  render
    slot

export DialogTrigger = component extends button
  accept open from Dialog
  render
    button
      type: 'button'
      data-popup-open: open or undefined
      aria-haspopup: 'dialog'
      aria-expanded: if open then 'true' else 'false'
      @click: (-> open = true)
      slot

# showModal throws until the mounted tree reaches the document, so opening
# waits a microtask. Firefox hides a closed dialog at once, so close()
# waits for the exit animations, and Escape closes through the cell.
#
# TODO: let the app see a close's reason and cancel it, for close confirmation.
# TODO: tell the app when a close has finished, after the exit animations.
export DialogPopup = component extends dialog
  accept open from Dialog
  accept labelledBy from Dialog
  accept describedBy from Dialog
  @closedby?: DialogClosedBy | undefined := 'any'
  el: HTMLDialogElement | null := null

  dismiss ~= closedby ?? 'any'

  # Safari ignores closedby, so backdrop presses and Escape under none are
  # handled here until it ships.
  pressed = false
  onBackdrop = (e: PointerEvent): boolean ->
    return false unless e.target is e.currentTarget
    r = (e.currentTarget as HTMLDialogElement).getBoundingClientRect()
    e.clientX < r.left or e.clientX > r.right or e.clientY < r.top or e.clientY > r.bottom
  press = (e: PointerEvent) -> pressed = onBackdrop(e)
  release = (e: PointerEvent) -> open = false if pressed and onBackdrop(e) and dismiss is 'any'

  cancel = (e: Event) ->
    e.preventDefault()
    open = false unless dismiss is 'none'

  # A sentinel at each end catches the browser's own move past the last
  # stop or before the first, so a Tab the popup never sees, one inside a
  # frame, wraps too. showModal focuses the leading sentinel, being the
  # first focusable descendant, so opening moves focus on to the first stop.
  before: HTMLElement | null := null
  after: HTMLElement | null := null
  opening = false
  stops = (dialog: HTMLDialogElement): HTMLElement[] ->
    nodes: NodeListOf<HTMLElement> = dialog.querySelectorAll('a[href], button, input, select, textarea, summary, details, iframe, object, embed, audio[controls], video[controls], [tabindex], [contenteditable]:not([contenteditable="false"])')
    Array.from(nodes).filter (node) ->
      node isnt before and node isnt after and node.tabIndex >= 0 and not node.matches(':disabled') and not node.closest('[inert]') and node.checkVisibility({ visibilityProperty: true })
  toFirst = ->
    return if opening or not el
    stops(el)[0]?.focus()
  toLast = ->
    return if opening or not el
    list = stops(el)
    list[list.length - 1]?.focus()

  ~>
    dialog = el
    return unless dialog
    if open
      queueMicrotask ->
        return unless open and not dialog.open and dialog.isConnected
        # Safari rings the element showModal focuses even after a click, and
        # only refocusing it with focusVisible: false clears that.
        visible = document.activeElement?.matches(':focus-visible')
        opening = true
        dialog.showModal()
        opening = false
        focused = document.activeElement as HTMLElement | null
        if focused is before
          stops(dialog)[0]?.focus({ focusVisible: visible })
        else if focused and not visible and focused.matches(':focus-visible')
          focused.blur()
          focused.focus({ focusVisible: false })
    else if dialog.open
      queueMicrotask ->
        exits = dialog.getAnimations().map (a) -> a.finished
        Promise.allSettled(exits).then -> dialog.close() if not open and dialog.open

  render
    dialog
      ref: el
      closedby: dismiss
      data-open: open or undefined
      data-closed: not open or undefined
      aria-labelledby: labelledBy or undefined
      aria-describedby: describedBy or undefined
      @pointerdown: press
      @pointerup: release
      @cancel: cancel
      @close: (-> open = false)
      span ref: before, tabindex: 0, aria-hidden: 'true', data-focus-guard: 'true', @focus: toLast
      slot
      span ref: after, tabindex: 0, aria-hidden: 'true', data-focus-guard: 'true', @focus: toFirst

export DialogTitle = component extends h2
  accept labelledBy from Dialog
  id =! @rest.id ?? mint('title')
  ~>
    labelledBy = id
    -> labelledBy = ''
  render
    h2 id: id
      slot

export DialogDescription = component extends p
  accept describedBy from Dialog
  id =! @rest.id ?? mint('description')
  ~>
    describedBy = id
    -> describedBy = ''
  render
    p id: id
      slot

export DialogClose = component extends button
  accept open from Dialog
  render
    button
      type: 'button'
      @click: (-> open = false)
      slot

counter = 0
mint = (part: string): string -> "rip-dialog-#{part}-#{counter += 1}"

# A modal doesn't stop the document's own scroll or overscroll bounce.
styles = CSSStyleSheet.new()
styles.replaceSync '''
  :root:has(dialog:modal) { overflow: hidden; }
  dialog > [data-focus-guard] { position: fixed; top: 0; left: 0; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
'''
document.adoptedStyleSheets.push(styles)
