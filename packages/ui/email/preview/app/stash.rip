import { source } from 'rip/app'
import { http, HTTPError } from 'rip/http'

export type Entry =
  path: string
  file: string
  component: string

export type Message =
  subject: string | null
  preview: string | null
  html: string
  text: string

export type Missing =
  missing: true

export type Ui =
  view: 'html' | 'text' | 'source'
  width: 'desktop' | 'mobile'
  dark: boolean
  current: string
  live: boolean

api = http.create({ retry: 0 })

get = (url: string) ->
  try
    api.get!(url).json!
  catch error
    throw Error.new(error.response.text!) if error instanceof HTTPError
    throw error

ui: Ui =
  view: 'html'
  width: 'desktop'
  dark: false
  current: ''
  live: true

export stash =
  ui: ui
  catalog: source
    fetch: (): Promise<Entry[]> -> get('/api/catalog')
  message: source
    fetch: (key: string): Promise<Message | Missing> ->
      try
        api.get!("/api/preview/#{key}").json!
      catch error
        throw error unless error instanceof HTTPError
        return { missing: true } if error.response.status is 404
        throw Error.new(error.response.text!)
