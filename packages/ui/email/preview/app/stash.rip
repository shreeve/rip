import { source } from 'rip/app'
import { http, HTTPError } from 'rip/http'

export Template = schema :shape
  path!      string
  file!      string
  component! string

export Message = schema :shape
  html!     string
  text!     string
  subject?  string
  preview?  string

export type Missing =
  missing: true

export type Ui =
  view: 'html' | 'text' | 'source'
  width: 'desktop' | 'mobile'
  dark: boolean
  current: string
  live: boolean

api = http.create({ prefixUrl: '/api', retry: 0 })

get = (url: string) ->
  try
    api.get!(url).json!
  catch error
    throw error unless error instanceof HTTPError
    throw Object.assign(Error.new(error.response.text!), { status: error.response.status })

ui: Ui =
  view: 'html'
  width: 'desktop'
  dark: false
  current: ''
  live: true

export stash =
  ui: ui
  templates: source
    fetch: -> Template.array.parse(get!('templates'))
  message: source
    fetch: (key: string): Promise<Message | Missing> ->
      try
        Message.parse(get!("preview/#{key}"))
      catch error
        if error.status is 404 then { missing: true } else throw error
