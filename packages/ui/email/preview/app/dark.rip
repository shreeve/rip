# Gmail's dark mode: every color's lightness is inverted on one line,
# white landing at 12 percent and black at 95, whether it paints a
# background, a border, or text, with chroma cut by a fifth. Applied to
# inline styles and bgcolor attributes, which is where an email's colors
# live.

canvas = document.createElement('canvas').getContext('2d')
SENTINEL = '#010203'
KEYWORDS = Set.new ['transparent', 'currentcolor', 'inherit', 'initial', 'unset', 'none', 'solid', 'dashed', 'dotted', 'double', 'auto']
TOKEN = /#[0-9a-f]{3,8}\b|(?:rgba?|hsla?|hwb|lab|lch|oklab|oklch|color)\([^)]*\)|\b[a-z]+\b/gi

# Any color the browser can read, as [r, g, b, a] on 0..1, or null.
rgba = (text: string) ->
  return null if KEYWORDS.has text.toLowerCase()
  canvas.fillStyle = SENTINEL
  canvas.fillStyle = text
  value = canvas.fillStyle
  return null if value is SENTINEL
  if value.startsWith('#')
    return [parseInt(value.slice(1, 3), 16) / 255, parseInt(value.slice(3, 5), 16) / 255, parseInt(value.slice(5, 7), 16) / 255, 1]
  m = value.match /rgba?\((\d+), (\d+), (\d+)(?:, ([\d.]+))?\)/
  return null unless m
  [Number(m[1]) / 255, Number(m[2]) / 255, Number(m[3]) / 255, (if m[4]? then Number(m[4]) else 1)]

WHITE = [0.95047, 1.0, 1.08883]
linear = (c) -> if c <= 0.04045 then c / 12.92 else ((c + 0.055) / 1.055) ** 2.4
gamma  = (c) -> if c <= 0.0031308 then 12.92 * c else 1.055 * (c ** (1 / 2.4)) - 0.055
f      = (t) -> if t > 216 / 24389 then Math.cbrt(t) else (841 / 108) * t + 4 / 29
finv   = (t) -> if t > 6 / 29 then t * t * t else (108 / 841) * (t - 4 / 29)

toLch = (rgb) ->
  r = linear rgb[0]
  g = linear rgb[1]
  b = linear rgb[2]
  x = 0.4124564 * r + 0.3575761 * g + 0.1804375 * b
  y = 0.2126729 * r + 0.7151522 * g + 0.0721750 * b
  z = 0.0193339 * r + 0.1191920 * g + 0.9503041 * b
  fx = f x / WHITE[0]
  fy = f y / WHITE[1]
  fz = f z / WHITE[2]
  a = 500 * (fx - fy)
  bb = 200 * (fy - fz)
  { l: 116 * fy - 16, c: Math.hypot(a, bb), h: Math.atan2(bb, a) }

fromLch = (lch) ->
  a = lch.c * Math.cos(lch.h)
  bb = lch.c * Math.sin(lch.h)
  fy = (lch.l + 16) / 116
  fx = fy + a / 500
  fz = fy - bb / 200
  x = WHITE[0] * finv(fx)
  y = WHITE[1] * finv(fy)
  z = WHITE[2] * finv(fz)
  r = 3.2404542 * x - 1.5371385 * y - 0.4985314 * z
  g = -0.9692660 * x + 1.8760108 * y + 0.0415560 * z
  b = 0.0556434 * x - 0.2040259 * y + 1.0572252 * z
  [r, g, b].map (v) -> Math.round(Math.min(1, Math.max(0, gamma(v))) * 255)

invert = (text: string) ->
  parsed = rgba text
  return text unless parsed
  lch = toLch parsed
  lch.l = 95 - 0.83 * lch.l
  lch.c *= 0.8
  out = fromLch lch
  if parsed[3] < 1 then "rgba(#{out[0]}, #{out[1]}, #{out[2]}, #{parsed[3]})" else "rgb(#{out[0]}, #{out[1]}, #{out[2]})"

# Longhands only: a shorthand and its longhand are one value, and an
# inversion applied twice is no inversion.
PROPS = ['backgroundColor', 'borderColor', 'color']

doctypeOf = (doc) ->
  dt = doc.doctype
  return '' unless dt
  publicId = if dt.publicId then " PUBLIC \"#{dt.publicId}\"" else ''
  systemId = if dt.systemId then " \"#{dt.systemId}\"" else ''
  "<!DOCTYPE #{dt.name}#{publicId}#{systemId}>"

export darken = (html: string): string ->
  doc = DOMParser.new().parseFromString html, 'text/html'
  body = doc.body
  body.style.color = 'rgb(0, 0, 0)' unless body.style.color
  body.style.background = 'rgb(255, 255, 255)' unless body.style.background or body.style.backgroundColor
  styled: NodeListOf<HTMLElement> = doc.querySelectorAll('[style]')
  for el in styled
    for prop in PROPS
      value = el.style[prop]
      el.style[prop] = value.replace(TOKEN, invert) if value
  for el in doc.querySelectorAll('[bgcolor]')
    el.setAttribute 'bgcolor', invert(el.getAttribute('bgcolor'))
  "#{doctypeOf doc}#{doc.documentElement.outerHTML}"
