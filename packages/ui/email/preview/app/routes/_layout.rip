export Layout = component
  catalog <~ @stash.catalog
  ui ~= @stash.ui
  problem?: string := undefined

  mounted: ->
    connect = ->
      socket = WebSocket.new "wss://#{location.host}/hub"
      socket.onopen = ->
        socket.send JSON.stringify({ '+': ['/templates'] })
        ui.live = true
      socket.onmessage = (event) ->
        frames = JSON.parse event.data
        frames = [frames] unless Array.isArray frames
        if frames.some((frame) -> frame?.stamp?)
          @stash.source('catalog').refetch()
          @stash.source('message', ui.current).refetch() if ui.current
      socket.onclose = ->
        ui.live = false
        setTimeout connect, 1000
    connect()
    @router.onNavigate -> problem = undefined

  onError: (err) -> problem = err.message

  render
    div class: 'grid h-screen grid-cols-[260px_1fr]'
      aside class: 'flex min-h-0 flex-col border-r border-surface'
        h1 class: 'flex h-15 shrink-0 items-center px-5 text-sm-plus font-semibold', 'Rip Email'
        div class: 'flex flex-col overflow-y-auto p-2.5'
          div class: 'flex items-center px-2.5 py-2 text-xs-plus font-medium text-tertiary', 'Templates'
          if catalog.length is 0
            p class: 'p-2.5 text-sm text-secondary', 'No templates found'
          nav class: 'flex flex-col'
            for entry in catalog
              a
                href: "/#{entry.path}"
                class: 'flex items-center rounded-md px-2.5 py-2 text-sm font-medium text-secondary hover:bg-surface-hover hover:text-primary aria-[current=page]:bg-surface-active aria-[current=page]:text-primary'
                entry.path
      main class: 'grid grid-rows-[auto_1fr] overflow-hidden'
        if problem
          pre class: 'wrap-break-word m-6 font-mono text-xs whitespace-pre-wrap text-error', problem
        div id: 'content', class: 'contents'
