export Layout = component
  catalog <~ @stash.catalog
  ui ~= @stash.ui
  problem?: string := undefined

  mounted: ->
    connect = ->
      socket = WebSocket.new "wss://#{location.host}/hub"
      socket.onopen = ->
        socket.send JSON.stringify({ '+': ['/templates'] })
        ui.live = true
      socket.onmessage = (event) ->
        frames = JSON.parse event.data
        frames = [frames] unless Array.isArray frames
        if frames.some((frame) -> frame?.stamp?)
          @stash.source('catalog').refetch()
          @stash.source('message', ui.current).refetch() if ui.current
      socket.onclose = ->
        ui.live = false
        setTimeout connect, 1000
    connect()
    @router.onNavigate -> problem = undefined

  onError: (err) -> problem = err.message

  render
    div class: 'grid h-screen grid-cols-[250px_1fr]'
      aside class: 'flex flex-col border-r border-surface'
        h1 class: 'flex h-15 shrink-0 items-center px-4 text-sm font-semibold', 'Rip Email'
        div class: 'flex min-h-0 flex-col overflow-auto p-2'
          div class: 'flex h-8 shrink-0 items-center px-2 text-xs font-medium text-tertiary', 'Templates'
          if catalog.length is 0
            p class: 'p-2 text-sm text-secondary', 'No templates found.'
          nav class: 'flex flex-col gap-1'
            for entry in catalog
              a href: "/#{entry.path}", class: 'flex h-8 items-center rounded-md p-2 text-sm hover:bg-surface-active aria-[current=page]:bg-surface-active aria-[current=page]:font-medium', entry.path
      main class: 'grid min-w-0 grid-rows-[auto_1fr] overflow-hidden'
        if problem
          pre class: 'wrap-break-word m-6 font-mono text-xs whitespace-pre-wrap text-error', problem
        div id: 'content', class: 'contents'
