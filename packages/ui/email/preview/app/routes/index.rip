import { NoTemplates } from '../components/notice.rip'

export Home = component
  ui ~= @stash.ui
  templates <~ @stash.templates

  ~>
    first = templates[0]
    @router.replace "/#{first.path}" if first

  render
    div class: 'contents'
      if templates.length is 0
        header class: 'h-15 border-b border-surface'
        NoTemplates dark: ui.dark
