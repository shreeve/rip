import { EmptyCatalog } from '../notice.rip'

export Home = component
  catalog <~ @stash.catalog
  ui ~= @stash.ui

  ~>
    first = catalog[0]
    @router.replace "/#{first.path}" if first

  render
    div class: 'contents'
      if catalog.length is 0
        header class: 'h-15 border-b border-surface'
        EmptyCatalog dark: ui.dark
