import type { Message } from '../stash.rip'
import { darken } from '../dark.rip'
import { indent } from '../source.rip'
import { EmptyCatalog, Notice } from '../notice.rip'

export TemplatePage = component
  message <~ @stash.message(params.rest)
  catalog <~ @stash.catalog
  ui ~= @stash.ui
  found ~= if 'missing' of message then null else message

  mounted: -> ui.current = @params.rest

  render
    div class: 'contents'
      header class: 'flex h-15 min-w-0 items-center gap-5 border-b border-surface px-5'
        span class: 'flex-1 truncate text-sm font-semibold', "#{@params.rest}.rip"
        if found
          Group
            Choice label: 'HTML',   active: ui.view is 'html',   pick: (-> ui.view = 'html')
            Choice label: 'Text',   active: ui.view is 'text',   pick: (-> ui.view = 'text')
            Choice label: 'Source', active: ui.view is 'source', pick: (-> ui.view = 'source')
          Group
            Choice label: 'Desktop', active: ui.width is 'desktop', pick: (-> ui.width = 'desktop')
            Choice label: 'Mobile',  active: ui.width is 'mobile',  pick: (-> ui.width = 'mobile')
          Group
            Choice label: 'Dark', active: ui.dark, pick: (-> ui.dark = not ui.dark)
        if not ui.live
          span class: 'text-sm font-medium text-error', 'Disconnected'
      if found
        Stage message: found, view: ui.view, width: ui.width, dark: ui.dark
      else if catalog.length is 0
        EmptyCatalog dark: ui.dark
      else
        Notice title: "No template at #{@params.rest}.rip", body: 'Pick one from the sidebar, or save the file into the templates directory.', dark: ui.dark

Group = component
  render
    span class: 'flex items-center gap-0.5 rounded-lg border border-input p-0.5'
      slot

Choice = component
  @label: string
  @active: boolean
  @pick: (() => void)
  render
    button
      type: 'button'
      class: "h-7 rounded-md px-2.5 text-sm font-medium #{if active then 'bg-surface-active' else 'text-secondary hover:text-primary'}"
      @click: (-> pick())
      label

Stage = component
  @message: Message
  @view: 'html' | 'text' | 'source'
  @width: 'desktop' | 'mobile'
  @dark: boolean
  doc ~= if dark then darken(message.html) else message.html
  fit: (event) ->
    frame = event.target
    root = frame.contentDocument.documentElement
    ResizeObserver.new(-> frame.style.height = "#{root.scrollHeight}px").observe root
  render
    section class: "flex min-h-0 min-w-0 p-8 #{if dark then 'bg-neutral-400' else 'bg-neutral-200'}"
      div class: "m-auto flex max-h-full max-w-full flex-col gap-5 #{if width is 'mobile' then 'w-[390px]' else 'w-[800px]'}"
        InboxRow subject: message.subject, preview: message.preview, dark: dark
        div class: 'flex min-h-0 flex-col overflow-hidden rounded-lg shadow-lg'
          if view is 'html'
            iframe title: 'Rendered email', srcdoc: doc, @load: ((e) -> fit(e)), class: 'block min-h-0 w-full bg-white'
          else
            pre class: "min-h-0 overflow-auto p-4 font-mono text-xs wrap-break-word whitespace-pre-wrap #{if dark then 'bg-neutral-900 text-neutral-200' else 'bg-white text-neutral-800'}", (if view is 'text' then message.text else indent(message.html))

InboxRow = component
  @subject: string | null
  @preview: string | null
  @dark: boolean
  render
    div class: "flex flex-col gap-y-1 rounded-lg px-4.5 py-4 shadow-lg #{if dark then 'bg-neutral-900' else 'bg-white'}"
      div class: "truncate text-sm-plus font-semibold #{if subject? then (if dark then 'text-neutral-100' else 'text-neutral-900') else 'text-red-500'}", (if subject? then subject else 'no subject: the template declares no subject static')
      div class: "truncate text-sm #{if dark then 'text-neutral-400' else 'text-neutral-600'}", (if preview? then preview else 'no preview: the template renders no Preview block')
