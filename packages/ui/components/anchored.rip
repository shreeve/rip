import type { CSSProperties } from 'rip/app'

# The placement a popup takes beside its anchor, shared by every popup
# the package positions by CSS anchor positioning.

export type Side = 'bottom' | 'top' | 'left' | 'right'
export type Align = 'start' | 'center' | 'end'

# How an alignment reads along a vertical side, along a horizontal one,
# and as the two words of a transform origin.
ACROSS = {
  start: { vertical: 'span-right', horizontal: 'span-bottom', x: 'left', y: 'top' }
  center: { vertical: '', horizontal: '', x: 'center', y: 'center' }
  end: { vertical: 'span-left', horizontal: 'span-top', x: 'right', y: 'bottom' }
} as const

# The margin that faces the anchor from each side, and the origin that
# faces it.
FACING = {
  bottom: { margin: 'marginTop', origin: (a: Across) -> "#{a.x} top" }
  top: { margin: 'marginBottom', origin: (a: Across) -> "#{a.x} bottom" }
  left: { margin: 'marginRight', origin: (a: Across) -> "right #{a.y}" }
  right: { margin: 'marginLeft', origin: (a: Across) -> "left #{a.y}" }
} as const
type Across = (typeof ACROSS)[Align]

# A popover's own inset centers it; inset auto also zeroes the auto
# margins, so the margin on the anchor's side is the offset, which a flip
# mirrors. A horizontal side with no room on either side falls through to
# below, then above, by the two named try rules, which read the offset
# and the alignment off the popup.
export anchored = (anchor: string, side: Side, align: Align, sideOffset: number, origin: string): CSSProperties ->
  vertical = side is 'bottom' or side is 'top'
  across = ACROSS[align]
  style = {
    inset: 'auto'
    positionAnchor: anchor
    positionArea: "#{side} #{if vertical then across.vertical else across.horizontal}"
    positionTryFallbacks: (if vertical then 'flip-block' else 'flip-inline, --rip-anchor-below, --rip-anchor-above')
    '--rip-anchor-offset': "#{sideOffset}px"
    '--rip-anchor-across': across.vertical
    '--transform-origin': origin
  } as CSSProperties
  style[FACING[side].margin] = "#{sideOffset}px"
  style

# Nothing in CSS says which side a flip landed the popup on, so it is read
# from the computed area of a shown popup.
export landed = (popup: HTMLElement, side: Side): Side ->
  word = getComputedStyle(popup).positionArea.split(' ').find((w) -> w in FACING)
  (word as Side | undefined) ?? side

export facing = (side: Side, align: Align): string -> FACING[side].origin(ACROSS[align])

# A try tactic cannot cross the axes without transposing the size, so the
# cross-axis fallbacks are rules, with the offset and alignment as the
# popup's own custom properties.
styles = CSSStyleSheet.new()
styles.replaceSync('''
  @position-try --rip-anchor-below { position-area: bottom var(--rip-anchor-across,); margin: var(--rip-anchor-offset) 0 0 0; }
  @position-try --rip-anchor-above { position-area: top var(--rip-anchor-across,); margin: 0 0 var(--rip-anchor-offset) 0; }
''')
document.adoptedStyleSheets.push(styles)
