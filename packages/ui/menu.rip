import type { CSSProperties } from 'rip/app'

type Landing = 'popup' | 'first' | 'last'
export type Side = 'bottom' | 'top' | 'left' | 'right'
export type Align = 'start' | 'center' | 'end'

export Root = component
  offer @open := false
  offer triggerId := ''
  offer popupId := ''
  offer anchor := "--#{mint('anchor')}"
  offer landing: Landing := 'popup'
  render
    slot

# A click toggles through popovertarget, which makes the trigger the
# popover's invoker: a click on it while open closes instead of
# light-dismissing and reopening.
export Trigger = component extends button
  accept open from Root
  accept triggerId from Root
  accept popupId from Root
  accept anchor from Root
  accept landing from Root
  id =! @rest.id ?? mint('trigger')
  ~>
    triggerId = id
    -> triggerId = ''

  keydown = (e: KeyboardEvent) ->
    return if open
    switch e.key
      when 'ArrowDown', 'Enter', ' ' then landing = 'first'
      when 'ArrowUp' then landing = 'last'
      else return
    e.preventDefault()
    open = true

  render
    button
      type: 'button'
      id: id
      popovertarget: popupId or undefined
      style: { anchorName: anchor }
      aria-haspopup: 'menu'
      aria-expanded: if open then 'true' else 'false'
      data-popup-open: open or undefined
      @keydown: keydown
      slot

# The popup is anchored by name, since popovertarget anchors it only when
# a click opened it. A popover's own inset centers it; inset auto also
# zeroes the auto margins, so the margin on the trigger's side is the
# offset, which a flip mirrors. A horizontal side with no room on either
# side falls through to below, then above, by the package's two named
# try rules, which read the offset and the alignment off the popup.
# Firefox hides a light-dismissed popover at once and the hide is not
# cancelable, so only a close through the cell waits for the exit.
export Popup = component extends div
  accept open from Root
  accept triggerId from Root
  accept popupId from Root
  accept anchor from Root
  accept landing from Root
  @side: Side := 'bottom'
  @align: Align := 'start'
  @sideOffset: number := 0
  id =! @rest.id ?? mint('popup')
  el: HTMLDivElement | null := null
  ~>
    popupId = id
    -> popupId = ''

  vertical ~= side is 'bottom' or side is 'top'
  placement ~=
    across = ACROSS[align]
    style = {
      inset: 'auto'
      positionAnchor: anchor
      positionArea: "#{side} #{if vertical then across.vertical else across.horizontal}"
      positionTryFallbacks: (if vertical then 'flip-block' else 'flip-inline, --rip-menu-below, --rip-menu-above')
      '--rip-menu-offset': "#{sideOffset}px"
      '--rip-menu-across': across.vertical
      '--transform-origin': origin
    } as CSSProperties
    style[FACING[side].margin] = "#{sideOffset}px"
    style

  # Nothing in CSS says which side a flip landed the popup on, and a
  # fallback cannot set transform-origin, so the side is read from the
  # computed area once shown, and again after resize and scroll while
  # open. The browser settles a fallback in the rendering step after the
  # frame that dispatches those events, so the read waits two frames.
  # data-open waits for the side too, so an entry transition keyed on it
  # starts with the origin in place, and the side outlives a close until
  # the exit animations end, so the exit keeps it.
  placed: Side | '' := ''
  place =! =>
    popup = el
    return unless popup and popup.matches(':popover-open')
    word = getComputedStyle(popup).positionArea.split(' ').find (w) -> w in FACING
    placed = (word as Side | undefined) ?? side

  moved =! => requestAnimationFrame -> requestAnimationFrame place
  origin ~= FACING[placed or side].origin(ACROSS[align])

  items = (popup: HTMLElement): HTMLElement[] ->
    nodes: NodeListOf<HTMLElement> = popup.querySelectorAll('[role="menuitem"]')
    Array.from(nodes).filter (node) -> not node.matches(':disabled')

  # The cell follows a native hide from beforetoggle, since toggle is a
  # task behind the state and a key in between would read the cell wrong,
  # and a native show from toggle, since a showPopover() from a microtask
  # lands inside the show and throws. A close waiting on its animations
  # therefore cannot read the cell to learn of a show begun meanwhile.
  shows = 0
  onBeforeToggle = (e: ToggleEvent) ->
    if e.newState is 'open'
      shows += 1
      queueMicrotask place
      addEventListener('resize', moved)
      document.addEventListener('scroll', moved, true)
    else
      open = false
      removeEventListener('resize', moved)
      document.removeEventListener('scroll', moved, true)

  onToggle = (e: ToggleEvent) ->
    popup = el
    return unless popup
    if e.newState is 'closed'
      since = shows
      exits = popup.getAnimations().map (a) -> a.finished
      Promise.allSettled(exits).then -> placed = '' if shows is since
      return
    open = true
    place()
    list = items(popup)
    switch landing
      when 'first' then (list[0] ?? popup).focus()
      when 'last' then (list[list.length - 1] ?? popup).focus()
      else popup.focus()
    landing = 'popup'

  keydown = (e: KeyboardEvent) ->
    if e.key is 'Tab'
      open = false
      return
    popup = el
    return unless popup
    list = items(popup)
    at = list.indexOf(document.activeElement as HTMLElement)
    to = switch e.key
      when 'ArrowDown' then (if at < 0 then 0 else at + 1)
      when 'ArrowUp' then (if at < 0 then list.length - 1 else at - 1)
      when 'Home' then 0
      when 'End' then list.length - 1
      else null
    return if to is null
    e.preventDefault()
    list[to %% list.length]?.focus()

  ~>
    popup = el
    return unless popup
    if open
      queueMicrotask ->
        return unless open and popup.isConnected and not popup.matches(':popover-open')
        popup.showPopover()
    else if popup.matches(':popover-open')
      since = shows
      queueMicrotask ->
        exits = popup.getAnimations().map (a) -> a.finished
        Promise.allSettled(exits).then -> popup.hidePopover() if shows is since and not open and popup.matches(':popover-open')

  render
    div
      ref: el
      id: id
      popover: 'auto'
      role: 'menu'
      tabindex: -1
      style: placement
      aria-labelledby: triggerId or undefined
      data-side: placed or undefined
      data-open: if open and placed then true else undefined
      data-closed: not open or undefined
      @beforetoggle: onBeforeToggle
      @toggle: onToggle
      @keydown: keydown
      slot

export Item = component extends button
  accept open from Root
  render
    button
      type: 'button'
      role: 'menuitem'
      tabindex: -1
      @click: (-> open = false)
      @pointermove: hover
      @pointerleave: leave
      slot

# A link activates on Enter and not on Space, so Space clicks it.
export Link = component extends a
  accept open from Root

  space = (e: KeyboardEvent) ->
    return unless e.key is ' '
    e.preventDefault()
    (e.currentTarget as HTMLAnchorElement).click()

  render
    a
      role: 'menuitem'
      tabindex: -1
      @click: (-> open = false)
      @keydown: space
      @pointermove: hover
      @pointerleave: leave
      slot

# The pointer and the keys share one highlight: the focused item.
hover = (e: PointerEvent) ->
  item = e.currentTarget as HTMLElement
  item.focus() unless document.activeElement is item
leave = (e: PointerEvent) ->
  popup = (e.currentTarget as HTMLElement).closest('[role="menu"]') as HTMLElement | null
  popup?.focus()

# How an alignment reads along a vertical side, along a horizontal one,
# and as the two words of a transform origin.
ACROSS = {
  start: { vertical: 'span-right', horizontal: 'span-bottom', x: 'left', y: 'top' }
  center: { vertical: '', horizontal: '', x: 'center', y: 'center' }
  end: { vertical: 'span-left', horizontal: 'span-top', x: 'right', y: 'bottom' }
} as const

# The margin that faces the trigger from each side, and the origin that
# faces it.
FACING = {
  bottom: { margin: 'marginTop', origin: (a: Across) -> "#{a.x} top" }
  top: { margin: 'marginBottom', origin: (a: Across) -> "#{a.x} bottom" }
  left: { margin: 'marginRight', origin: (a: Across) -> "right #{a.y}" }
  right: { margin: 'marginLeft', origin: (a: Across) -> "left #{a.y}" }
} as const
type Across = (typeof ACROSS)[Align]

counter = 0
mint = (part: string): string -> "rip-menu-#{part}-#{counter += 1}"

# A try tactic cannot cross the axes without transposing the size, so the
# cross-axis fallbacks are rules, with the offset and alignment as the
# popup's own custom properties.
styles = CSSStyleSheet.new()
styles.replaceSync '''
  @position-try --rip-menu-below { position-area: bottom var(--rip-menu-across,); margin: var(--rip-menu-offset) 0 0 0; }
  @position-try --rip-menu-above { position-area: top var(--rip-menu-across,); margin: 0 0 var(--rip-menu-offset) 0; }
'''
document.adoptedStyleSheets.push(styles)
