import type { CSSProperties } from 'rip/app'
import type { ClosedBy } from './dialog.rip'
import * as Dialog from './dialog.rip'

export type Side = 'left' | 'right' | 'top' | 'bottom'

# A drawer is a dialog whose popup has a side, so every part but the popup
# is the Dialog's own.
export * from './dialog.rip'

export Popup = component extends Dialog.Popup
  accept open from Dialog.Root
  @side: Side := 'left'
  @closedby?: ClosedBy | undefined := 'any'

  onBackdrop = (e: PointerEvent): boolean ->
    return false unless e.target is e.currentTarget
    r = (e.currentTarget as HTMLDialogElement).getBoundingClientRect()
    e.clientX < r.left or e.clientX > r.right or e.clientY < r.top or e.clientY > r.bottom

  # Capture past the slop so a swipe from a link doesn't follow it; the
  # browser's own link or image drag would cancel the pointer sequence.
  horizontal ~= side is 'left' or side is 'right'
  toward ~= if side is 'left' or side is 'top' then -1 else 1
  along = (e: PointerEvent): number -> if horizontal then e.clientX else e.clientY
  drag: { id: number, start: number, at: number } | null = null
  offset := 0
  swiping := false
  # Both custom properties ride on the dialog because ::backdrop inherits
  # them from it. Strength is the time the remaining travel would take at
  # the release speed, 80ms to 360ms as 0.1 to 1.
  progress := 0
  strength := 1
  last = { offset: 0, at: 0 }
  before = { offset: 0, at: 0 }
  ~>
    strength = 1 if open
    return
  swipeStyle ~=
    s = { touchAction: (if horizontal then 'pan-y' else 'pan-x'), '--swipe-strength': strength } as CSSProperties
    s.translate = (if horizontal then "#{offset * toward}px 0" else "0 #{offset * toward}px") if offset
    s.transition = 'none' if swiping
    s['--swipe-progress'] = progress if swiping
    s
  # With a mouse, a press on text selects it, as it would anywhere.
  ignores = (e: PointerEvent): boolean ->
    return true if (e.target as Element).closest('input, textarea, select, [contenteditable]:not([contenteditable="false"]), [data-swipe-ignore]')
    e.pointerType is 'mouse' and overText(e.target as Element, e.clientX, e.clientY)
  overText = (el: Element, x: number, y: number): boolean ->
    range = document.createRange()
    for node in el.childNodes when node.nodeType is Node.TEXT_NODE
      range.selectNodeContents(node)
      for r in range.getClientRects()
        return true if x >= r.left and x <= r.right and y >= r.top and y <= r.bottom
    false
  down = (e: PointerEvent) ->
    drag = if onBackdrop(e) or (closedby ?? 'any') isnt 'any' or ignores(e) then null else { id: e.pointerId, start: along(e), at: performance.now() }
    last = before = { offset: 0, at: performance.now() } if drag
  move = (e: PointerEvent) ->
    return unless drag and e.pointerId is drag.id
    travel = (along(e) - drag.start) * toward
    unless swiping
      return if Math.abs(travel) < 8
      swiping = true
      (e.currentTarget as HTMLElement).setPointerCapture(e.pointerId)
    size = extent(e.currentTarget as HTMLDialogElement)
    offset = if travel >= 0 then travel else -resist(-travel)
    progress = Math.min(1, Math.max(0, offset) / size)
    before = last
    last = { offset, at: performance.now() }
  extent = (dialog: HTMLDialogElement): number -> if horizontal then dialog.offsetWidth else dialog.offsetHeight
  # Square-root resistance keeps a long pull within the bleed below.
  resist = (x: number): number -> Math.sqrt(x)
  up = (e: PointerEvent) ->
    return unless drag
    size = extent(e.currentTarget as HTMLDialogElement)
    now = performance.now()
    # A flick is the gesture's average speed, so one sample's jitter is never one.
    average = offset / Math.max(50, now - drag.at)
    if swiping and (average >= 0.5 or offset > Math.max(size / 2, 10))
      release = if now - last.at > 80 then 0 else (last.offset - before.offset) / Math.max(16, last.at - before.at)
      speed = Math.min(4, if release > 0 then release else average)
      strength = if speed <= 0.2 then 1 else 0.1 + 0.9 * (Math.min(360, Math.max(80, (size - offset) / speed)) - 80) / 280
      open = false
    settle()
  settle = ->
    drag = null
    swiping = false
    offset = 0
    progress = 0
  refuseDrag = (e: DragEvent) -> e.preventDefault() if drag

  render
    Dialog.Popup
      closedby: closedby
      style: swipeStyle
      data-side: side
      data-swiping: swiping or undefined
      @pointerdown: down
      @pointermove: move
      @pointerup: up
      @pointercancel: settle
      @dragstart: refuseDrag
      slot

# A pull into the screen moves the panel off its edge, so each side bleeds
# 3rem past it in the panel's own background, further than the resistance
# lets a pull travel. A modal dialog's own overflow would clip the bleed,
# so the popup is overflow visible; a taller body scrolls in a container
# of its own. The bleed starts a pixel inside the panel: a pull lands the
# edge on a fraction of a pixel, and two edges meeting there would each
# cover it in part and let the backdrop through as a seam.
styles = CSSStyleSheet.new()
styles.replaceSync '''
  dialog[data-side] { overflow: visible; }
  dialog[data-side]::after { content: ''; position: absolute; background: inherit; }
  dialog[data-side="left"]::after { inset: 0 calc(100% - 1px) 0 auto; width: calc(3rem + 1px); }
  dialog[data-side="right"]::after { inset: 0 auto 0 calc(100% - 1px); width: calc(3rem + 1px); }
  dialog[data-side="top"]::after { inset: auto 0 calc(100% - 1px) 0; height: calc(3rem + 1px); }
  dialog[data-side="bottom"]::after { inset: calc(100% - 1px) 0 auto 0; height: calc(3rem + 1px); }
'''
document.adoptedStyleSheets.push(styles)
