import { test, eq, ok } from '@rip-lang/testing'
import { copyFileSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync } from 'node:fs'
import { join } from 'node:path'
import { tmpdir } from 'node:os'

PRELOAD = process.execArgv.find (arg) -> arg.startsWith '--preload='
GENERATOR = join(import.meta.dir, '..', '..', 'generate.rip')
WORKER = join(import.meta.dir, '..', '..', 'worker.rip')
SERVER = join(import.meta.dir, '..', '..', 'site.rip')

generate = (entry, artifact, result, task) ->
  proc = Bun.spawn [process.execPath, PRELOAD, GENERATOR, entry, artifact, result, task, '0'],
    stdin: 'ignore'
    stdout: 'ignore'
    stderr: 'pipe'
  diagnostic = Response.new(proc.stderr).text()
  code = await proc.exited
  throw Error.new(await diagnostic) unless code is 0

unixFetch = (path, socket) ->
  options = { unix: socket }
  fetch "http://worker#{path}", options

waitFor = (fn, timeout = 5000) ->
  deadline = Date.now() + timeout
  loop
    value = fn!
    return value if value
    throw Error.new('worker test timed out') if Date.now() >= deadline
    sleep! 10

buildWorker = (dir, appEntry) ->
  app = join dir, 'app.js'
  worker = join dir, 'worker.js'
  generate! appEntry, app, join(dir, 'app-result.json'), 'app'
  generate! WORKER, worker, join(dir, 'worker-result.json'), 'worker'
  { app, worker }

temporaryProject = (dir, fixture) ->
  project = join dir, 'project'
  mkdirSync join(project, 'node_modules', '@rip-lang'), { recursive: true }
  copyFileSync join(import.meta.dir, fixture), join(project, 'index.rip')
  symlinkSync join(import.meta.dir, '..', '..'), join(project, 'node_modules', '@rip-lang', 'site'), 'dir'
  project

spawnWorker = (built, socket, env = {}) ->
  Bun.spawn [process.execPath, built.worker],
    stdin: 'ignore'
    stdout: 'ignore'
    stderr: 'ignore'
    env: { ...process.env, APP_ARTIFACT: built.app, SOCKET_PATH: socket, WORKER_ID: 'test', ...env }

test! 'capacity bounces, shutdown marks, and admitted work completes', ->
  dir = mkdtempSync join(tmpdir(), 'rip-workers-capacity-')
  proc = null
  try
    built = buildWorker! dir, join(import.meta.dir, 'index.rip')
    socket = join dir, 'worker.sock'
    proc = spawnWorker built, socket, { WORKER_CONCURRENCY: '1' }
    waitFor! ->
      try (unixFetch!('/ready', socket)).status is 200
      catch then false

    slow = unixFetch '/slow', socket
    busy = waitFor! ->
      try
        response = unixFetch! '/hello', socket
        if response.headers.get('rip-worker-busy') is '1' then response else null
      catch then null
    eq busy.status, 503
    eq busy.headers.get('retry-after'), '0'

    proc.kill 'SIGTERM'
    draining = waitFor! ->
      try
        response = unixFetch! '/hello', socket
        if response.headers.get('rip-worker-draining') is '1' then response else null
      catch then null
    eq draining.status, 503
    eq (await slow).status, 200
    eq (await proc.exited), 0
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    rmSync dir, { recursive: true, force: true }

test! 'boot failure is reported before bounded nonzero exit', ->
  dir = mkdtempSync join(tmpdir(), 'rip-workers-boot-')
  proc = null
  try
    built = buildWorker! dir, join(import.meta.dir, 'failed.rip')
    socket = join dir, 'worker.sock'
    proc = spawnWorker built, socket
    failed = waitFor! ->
      try
        response = unixFetch! '/ready', socket
        if response.headers.get('rip-boot-failed') is '1' then response else null
      catch then null
    eq failed.status, 503
    ok (failed.text!).includes('no start! handoff')
    eq (await proc.exited), 1
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    rmSync dir, { recursive: true, force: true }

test! 'invalid worker concurrency rejects before binding', ->
  dir = mkdtempSync join(tmpdir(), 'rip-workers-invalid-')
  proc = null
  try
    built = buildWorker! dir, join(import.meta.dir, 'index.rip')
    proc = spawnWorker built, join(dir, 'worker.sock'), { WORKER_CONCURRENCY: '0' }
    eq (await proc.exited), 1
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    rmSync dir, { recursive: true, force: true }

test! 'manager configures a pool and replaces a crashed worker', ->
  dir = mkdtempSync join(tmpdir(), 'rip-workers-manager-')
  project = temporaryProject dir, 'index.rip'
  controlSocket = join dir, 'janus.sock'
  registration = null
  updates = []
  deleted = false
  control = Bun.serve
    unix: controlSocket
    fetch: (request) ->
      url = URL.new request.url
      if request.method is 'POST' and url.pathname is '/1.0/apps'
        registration = request.json!
        return Response.json({ id: 'workers-registration' }, { status: 201 })
      if request.method is 'PUT' and url.pathname is '/1.0/apps/workers-registration/upstreams'
        body = request.json!
        updates.push body.upstreams
        return Response.new(null, { status: 204 })
      if request.method is 'POST' and url.pathname is '/1.0/apps/workers-registration/heartbeat'
        return Response.new(null, { status: 204 })
      if request.method is 'DELETE' and url.pathname is '/1.0/apps/workers-registration'
        deleted = true
        return Response.new(null, { status: 204 })
      Response.new('Not Found', { status: 404 })
  proc = null
  try
    proc = Bun.spawn [process.execPath, PRELOAD, SERVER, project, '--name', 'workers', '--host', 'workers.test', '--workers', '2', '--concurrency', '3', '--no-watch', '--control', controlSocket, '--access-log=off'],
      stdin: 'ignore'
      stdout: 'ignore'
      stderr: 'ignore'
    waitFor! -> registration?
    eq registration.upstreams.length, 2

    first = registration.upstreams[0].path
    slow = [unixFetch('/slow', first), unixFetch('/slow', first), unixFetch('/slow', first)]
    busy = waitFor! ->
      try
        response = unixFetch! '/hello', first
        if response.headers.get('rip-worker-busy') is '1' then response else null
      catch then null
    eq busy.status, 503
    Promise.all! slow

    try unixFetch! '/crash', first
    replacement = waitFor! ->
      updates.find (list) -> list.length is 2 and list.every((item) -> item.path isnt first)
    eq replacement.length, 2
    response = unixFetch! '/hello', replacement[0].path
    eq response.status, 200

    proc.kill 'SIGTERM'
    eq (await proc.exited), 143
    ok deleted
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    control.stop true
    rmSync dir, { recursive: true, force: true }

test! 'manager replaces one startup crash before publishing readiness', ->
  dir = mkdtempSync join(tmpdir(), 'rip-workers-startup-crash-')
  project = temporaryProject dir, 'crash.rip'
  controlSocket = join dir, 'janus.sock'
  registration = null
  control = Bun.serve
    unix: controlSocket
    fetch: (request) ->
      url = URL.new request.url
      if request.method is 'POST' and url.pathname is '/1.0/apps'
        registration = request.json!
        return Response.json({ id: 'startup-registration' }, { status: 201 })
      if request.method is 'DELETE' and url.pathname is '/1.0/apps/startup-registration'
        return Response.new(null, { status: 204 })
      Response.new(null, { status: 204 })
  proc = null
  try
    proc = Bun.spawn [process.execPath, PRELOAD, SERVER, project, '--host', 'startup.test', '--workers', '1', '--no-watch', '--control', controlSocket, '--access-log=off'],
      stdin: 'ignore'
      stdout: 'ignore'
      stderr: 'ignore'
      env: { ...process.env, RIP_TEST_CRASH_ONCE: join(dir, 'crashed') }
    waitFor! -> registration?
    eq registration.upstreams.length, 1
    ok registration.upstreams[0].path.endsWith('worker-2.sock')
    response = unixFetch! '/hello', registration.upstreams[0].path
    eq (response.json!), { message: 'recovered' }
    proc.kill 'SIGTERM'
    eq (await proc.exited), 143
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    control.stop true
    rmSync dir, { recursive: true, force: true }

test! 'manager kills workers that miss the readiness deadline', ->
  dir = mkdtempSync join(tmpdir(), 'rip-workers-timeout-')
  project = temporaryProject dir, 'hanging.rip'
  controlSocket = join dir, 'janus.sock'
  registered = false
  control = Bun.serve
    unix: controlSocket
    fetch: (request) ->
      registered = true if request.method is 'POST' and URL.new(request.url).pathname is '/1.0/apps'
      Response.new('unexpected', { status: 500 })
  proc = null
  try
    proc = Bun.spawn [process.execPath, PRELOAD, SERVER, project, '--host', 'hanging.test', '--workers', '1', '--no-watch', '--control', controlSocket, '--access-log=off'],
      stdin: 'ignore'
      stdout: 'ignore'
      stderr: 'ignore'
      env: { ...process.env, RIP_BOOT_DEADLINE_MS: '100' }
    eq (await proc.exited), 1
    eq registered, false
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    control.stop true
    rmSync dir, { recursive: true, force: true }

test! 'hung handler recycles the worker after its drain bound', ->
  dir = mkdtempSync join(tmpdir(), 'rip-workers-hung-')
  proc = null
  try
    built = buildWorker! dir, join(import.meta.dir, 'index.rip')
    socket = join dir, 'worker.sock'
    proc = spawnWorker built, socket, { RIP_HANDLER_DEADLINE_MS: '50', RIP_DRAIN_DEADLINE_MS: '100' }
    waitFor! ->
      try (unixFetch!('/ready', socket)).status is 200
      catch then false
    hung = unixFetch('/hang', socket).catch(-> null)
    waitFor! ->
      try (unixFetch!('/hello', socket)).headers.get('rip-worker-busy') is '1'
      catch then false
    eq (await proc.exited), 0
    await hung
  finally
    try proc?.kill('SIGKILL')
    await proc.exited if proc?
    rmSync dir, { recursive: true, force: true }

test! 'worker exits when its manager process disappears', ->
  dir = mkdtempSync join(tmpdir(), 'rip-workers-orphan-')
  childPid = null
  parent = null
  try
    built = buildWorker! dir, join(import.meta.dir, 'index.rip')
    socket = join dir, 'worker.sock'
    report = join dir, 'child.json'
    parent = Bun.spawn [process.execPath, join(import.meta.dir, 'parent.mjs'), built.worker, built.app, socket, report],
      stdin: 'ignore'
      stdout: 'ignore'
      stderr: 'inherit'
    eq (await parent.exited), 0
    childPid = JSON.parse(readFileSync(report, 'utf8')).pid
    gone = waitFor! ->
      try
        unixFetch! '/ready', socket
        false
      catch then true
    ok gone
  finally
    try process.kill(childPid, 'SIGKILL') if childPid?
    try parent?.kill('SIGKILL')
    await parent.exited if parent?
    rmSync dir, { recursive: true, force: true }
