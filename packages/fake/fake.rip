# ==[ Generators ]==

firstName = (sex) ->
  switch sex
    when 'M' then sample FIRST_M
    when 'F' then sample FIRST_F
    else sample(if chance() then FIRST_M else FIRST_F)

lastName = -> sample LAST
fullName = (sex) -> "#{firstName sex} #{lastName()}"

nickname = (sex) ->
  switch sex
    when 'M' then sample NICK_M
    when 'F' then sample NICK_F
    else sample(if chance() then NICK_M else NICK_F)

domain = -> "#{sample WORDS}#{sample ['mail', 'box', 'net', 'hub']}.example.com"

email = (first, last) ->
  f = (first ?? firstName()).toLowerCase().replace /[^a-z]/g, ''
  l = (last ?? lastName()).toLowerCase().replace /[^a-z]/g, ''
  sample(["#{f}.#{l}", "#{f}#{l}", "#{f[0]}#{l}", "#{f}#{integer 1, 99}"]) + '@' + domain()

username = (first, last) ->
  "#{(first ?? firstName()).toLowerCase()}#{(last ?? lastName()).toLowerCase()}#{integer 1, 999}"

# NANP-legal: area and exchange codes start 2-9, area code never N11.
areaCode = ->
  loop
    n = integer 201, 999
    return String(n) unless n % 100 is 11

exchangeCode = -> String(integer 2, 9) + digits(2)

phone = ({ ext } = {}) ->
  s = "(#{areaCode()}) #{exchangeCode()}-#{digits 4}"
  s += ", ext. #{integer 50, 3000}" if ext is true or (typeof ext is 'number' and chance(ext))
  s

fax = -> phone()
phoneType = -> sample ['cell', 'home', 'work']

sex = -> sample ['M', 'F']
age = (min = 18, max = 90) -> integer min, max

# Base name, with a street type appended most of the time — so you get
# 'Elm', 'Elm St', 'Elm Peak', … from a small combinatorial pool.
street = ->
  s = sample STREETS
  s += " #{sample STREET_TYPES}" if chance 0.8
  s

streetAddress = -> "#{integer 10, 9950} #{street()}"
city = -> sample CITIES
state = -> sample STATES
zip = -> digits 5
company = -> "#{sample COMPANIES} #{sample COMPANY_SUFFIX}"
profession = -> sample PROFESSIONS
jobTitle = -> "#{sample JOB_LEVELS} #{sample JOB_ROLES}"

word = -> sample WORDS
words = (n = 3) -> (word() for i in [0...n]).join ' '
sentence = (n = 8) ->
  s = words n
  s[0].toUpperCase() + s.slice(1) + '.'

# date(years: [21, 55]) -> an ISO date for someone 21-55 years old;
# date(days: 30) -> within the last 30 days; date() -> last year.
MS_DAY = 86400000

date = (opts = {}) ->
  ms = if opts.years
    [a, b] = opts.years
    Date.now() - integer(a * 365.25 * MS_DAY, b * 365.25 * MS_DAY)
  else
    Date.now() - integer(0, (opts.days ?? 365) * MS_DAY)
  Date.new(ms).toISOString().slice 0, 10

datetime = (opts = {}) -> Date.new(Date.parse(date opts) + integer(0, MS_DAY - 1))

# unique(fn) — retry fn until unseen, then error.
__seen = Map.new()

unique = (fn, max = 1000) ->
  set = __seen.get fn
  unless set
    set = Set.new()
    __seen.set fn, set
  i = 0
  while i < max
    v = fn()
    unless set.has v
      set.add v
      return v
    i++
  throw Error.new "fake.unique: exhausted after #{max} retries — pool too small"

export fake = {
  seed, random, integer, sample, chance, maybe,
  numerify, letterify, pattern, digits, token, uuid,
  firstName, lastName, fullName, nickname, sex, age,
  email, username, domain, phone, fax, phoneType, areaCode,
  street, streetAddress, city, state, zip, company, profession, jobTitle,
  word, words, sentence, date, datetime, unique,
}

# ==[ Schema-driven derivation (used by Model.factory) ]==
#
# Given a field descriptor from the schema runtime, produce a plausible
# value. The schema carries the semantics — enum literals, email/phone/
# zip/uuid types, optionality — so most models need no per-field recipe
# at all. Name heuristics cover the string fields the type system can't
# distinguish.

NAME_HINTS = [
  [/^first_?name$/i,      (ctx) -> ctx.firstName ?? firstName(ctx.sex)]
  [/^last_?name$/i,       (ctx) -> ctx.lastName ?? lastName()]
  [/^(full_?)?name$/i,    -> if chance(0.5) then fullName() else company()]
  [/fax/i,                -> fax()]
  [/phone_?type/i,        -> phoneType()]
  [/phone/i,              -> phone()]
  [/email/i,              (ctx) -> email ctx.firstName, ctx.lastName]
  [/profession|occupation/i, -> profession()]
  [/job_?title/i,         -> jobTitle()]
  [/(street|address)/i,   -> streetAddress()]
  [/city/i,               -> city()]
  [/state/i,              -> state()]
  [/zip/i,                -> zip()]
  [/^(sex|gender)$/i,     (ctx) -> ctx.sex ?? sex()]
  [/^dob|birth/i,         -> date years: [18, 90]]
  [/description|notes?$/i, -> sentence()]
  [/^(slug|username)$/i,  -> word() + integer(10, 99)]
  [/^(token|secret|key)$/i, -> token 20]
  [/^(code|number|mrn)$/i, -> digits 6]
  [/^title$/i,            -> words 2]
  [/company|organization/i, -> company()]
]

export __fakeFieldValue = (f, ctx = {}) ->
  return sample f.literals if f.literals
  switch f.typeName
    when 'email' then email ctx.firstName, ctx.lastName
    when 'phone' then phone()
    when 'zip' then zip()
    when 'uuid' then uuid()
    when 'url' then 'https://' + domain() + '/' + word()
    when 'boolean' then chance()
    when 'integer' then integer 1, 100
    when 'number' then Math.round(random() * 10000) / 100
    when 'date' then date days: 365
    when 'datetime' then datetime days: 365
    when 'string', 'text'
      snake = f.name.replace /([a-z0-9])([A-Z])/g, '$1_$2'
      for [re, gen] in NAME_HINTS
        return gen(ctx) if re.test(f.name) or re.test(snake)
      if f.typeName is 'text' then sentence() else words 2
    else undefined

# ==[ Model.factory — schema-driven fabrication ]==
#
# One polymorphic verb, sign says persisted (trust/sinatra heritage):
#
#   Model.factory(5)      five created (persisted) instances
#   Model.factory(1)      one created instance
#   Model.factory(0)      one built (unsaved) instance   — the default
#   Model.factory(-1)     one built (unsaved) instance
#   Model.factory(-3)     three built (unsaved) instances
#   Model.factory("…|…")  pipe-table literal: exact rows, all created
#
# Attribute derivation, lowest to highest precedence: schema-derived
# fakes -> the model's own `seed` method (a recipe returning an
# attribute object, receiving factory's extra args) -> a plain-object
# argument as direct overrides. Fields with declared defaults are left
# to the save pipeline; foreign keys are NEVER invented — pass them
# explicitly.

__camel = (s) -> String(s).replace /_([a-z])/g, (_, c) -> c.toUpperCase()

__factoryDerive = (norm, overrides) ->
  attrs = {}
  fkCols = Set.new()
  norm.relations.forEach (rel) ->
    fkCols.add __camel(rel.foreignKey) if rel.kind is 'belongsTo'
  skip = Set.new [norm.primaryKey, 'createdAt', 'updatedAt', 'deletedAt']

  # Names first, so emails and correlated fields can agree with them.
  ctx = {}
  norm.fields.forEach (f, n) ->
    if /^(sex|gender)$/i.test n
      picks = f.literals?.filter((l) -> l is 'M' or l is 'F')
      ctx.sex = overrides[n] ?? (if picks?.length then sample picks else sex())
  norm.fields.forEach (f, n) ->
    snake = n.replace /([a-z0-9])([A-Z])/g, '$1_$2'
    ctx.firstName = overrides[n] ?? firstName(ctx.sex) if /^first_?name$/i.test snake
    ctx.lastName  = overrides[n] ?? lastName()         if /^last_?name$/i.test snake

  norm.fields.forEach (f, n) ->
    return if skip.has(n) or fkCols.has(n)
    return if f.constraints?.default isnt undefined
    return if f.optional and not chance(0.8)
    if n is 'firstName' and ctx.firstName then attrs[n] = ctx.firstName; return
    if n is 'lastName' and ctx.lastName then attrs[n] = ctx.lastName; return
    if ctx.sex isnt undefined and /^(sex|gender)$/i.test(n) then attrs[n] = ctx.sex; return
    v = __fakeFieldValue f, ctx
    return if v is undefined
    attrs[n] = if f.unique and typeof v is 'string' then "#{v}-#{token 4}" else v
  attrs

__factoryTableRows = (norm, text) ->
  lines = text.split(/\r?\n/).map((l) -> l.trim()).filter (l) -> l and not /^[|\s:-]+$/.test(l)
  throw Error.new 'fake: factory(table) needs a header line and at least one row' if lines.length < 2
  cells = (l) -> l.replace(/^\||\|$/g, '').split('|').map (c) -> c.trim()
  header = cells(lines[0]).map __camel
  for line in lines[1...]
    row = {}
    cells(line).forEach (v, i) ->
      name = header[i]
      return if name is undefined or v is ''
      t = norm.fields.get(name)?.typeName
      row[name] = switch t
        when 'integer', 'number' then Number v
        when 'boolean' then v is 'true' or v is '1'
        else v
    row

SchemaDef.prototype.factory = (num = 0, ...args) ->
  @_assertModel 'factory'
  norm = @_normalize()

  if typeof num is 'string'
    out = []
    out.push @create!(row) for row in __factoryTableRows(norm, num)
    return out
  throw Error.new 'fake: factory(n) expects an integer count or a pipe-table string' unless Number.isInteger num

  persist = num >= 1
  many = num >= 2 or num <= -2
  count = if many then Math.abs(num) else 1
  seedFn = norm.methods.get('seed') or null
  overrides = if not seedFn and args.length is 1 and args[0] and typeof args[0] is 'object' then args[0] else null

  make = =>
    derived = __factoryDerive norm, overrides ?? {}
    custom = if seedFn then seedFn.apply!(this, args) else overrides
    data = { ...derived, ...(custom or {}) }
    norm.relations.forEach (rel) =>
      return unless rel.kind is 'belongsTo' and not rel.optional
      fk = __camel rel.foreignKey
      if persist and not data[fk]?
        throw Error.new "fake: #{@name}.factory() — required foreign key #{fk} is not invented; pass it explicitly (e.g. factory(n, {#{fk}: parent.id}))"
    return @create!(data) if persist
    canonical = normalizePersistenceInput!(this, data, { skipEnsures: true, api: 'factory()' })
    constructInputInstance this, canonical

  return make() unless many
  out = []
  for i in [0...count]
    out.push make!
  out
