# ==============================================================================
# rip/fake — Rip's own fake data
#
# The distillation of Ruby's faker (102 generator classes + YAML locale
# machinery) and ffaker (203 modules + 1.7MB of data files) down to the
# screenful a business app actually seeds: curated inline data, zero
# dependencies, and values that are VALID-looking (NANP-legal phones,
# well-formed emails, real state codes) so fakes survive real validators.
#
# Deterministic when you want it: fake.seed(n) switches the module to a
# seeded PRNG (mulberry32) so tests reproduce byte-for-byte; fake.seed()
# returns to Math.random.
#
# Importing this package also installs Model.factory() on every :model
# schema — one polymorphic verb for fabricating records, deriving
# plausible values straight from the schema declarations.
# ==============================================================================

import { SchemaDef } from '../../src/runtime/schema.js'
import { normalizePersistenceInput, constructInputInstance } from '../../src/runtime/orm.js'

# ==[ Randomness ]==

__rand = Math.random

mulberry32 = (a) ->
  ->
    a |= 0
    a = (a + 0x6D2B79F5) | 0
    t = Math.imul a ^ (a >>> 15), 1 | a
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    ((t ^ (t >>> 14)) >>> 0) / 4294967296

seed = (n) ->
  __rand = if n? then mulberry32(n >>> 0) else Math.random
  return

random  = -> __rand()
integer = (min = 0, max = 100) -> min + Math.floor __rand() * (max - min + 1)
# sample ary — uniform pick. sample ary, weights — weighted pick from a
# parallel array; entries past the end of weights count 1, so
# sample(['a','b','c'], [10]) draws 10/1/1. Zero weight = never picked.
sample = (ary, weights) ->
  return ary[Math.floor __rand() * ary.length] unless weights?
  throw Error.new "fake.sample: #{weights.length} weights for #{ary.length} values" if weights.length > ary.length
  total = ary.length - weights.length
  for w in weights
    throw Error.new "fake.sample: bad weight #{w}" unless typeof w is 'number' and Number.isFinite(w) and w >= 0
    total += w
  throw Error.new 'fake.sample: total weight is zero' unless total > 0
  r = __rand() * total
  last = null
  for v, i in ary
    w = weights[i] ?? 1
    continue unless w > 0
    last = v
    r -= w
    return v if r < 0
  last
chance  = (prob = 0.5) -> __rand() < prob
maybe   = (prob, fn) ->
  return null unless __rand() < prob
  if typeof fn is 'function' then fn() else fn

# ==[ Pattern templating (faker's numerify/letterify, kept) ]==

LETTERS = 'abcdefghijklmnopqrstuvwxyz'

numerify  = (s) -> s.replace /#/g, -> String integer(0, 9)
letterify = (s) -> s.replace /\?/g, -> sample LETTERS
pattern   = (s) -> letterify numerify(s)
digits    = (n = 6) -> numerify '#'.repeat(n)
token     = (n = 8) -> (sample('0123456789abcdef') for i in [0...n]).join ''
uuid      = ->
  'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace /[xy]/g, (c) ->
    r = integer 0, 15
    v = if c is 'x' then r else (r & 0x3) | 0x8
    v.toString 16

