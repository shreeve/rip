# ==============================================================================
# rip/testing: shared helpers for package test.rip files
#
#   import { test, eq, ok, throws, plainEnv } from 'rip/testing'
#
#   test "does the thing", ->
#     eq CSV.read("a,b\n"), [['a','b']]
#
# The tally prints at exit; a failed case sets process.exitCode for CI.
# Keep this file tiny: package tests read like Rip, not a framework. The
# language battery has its own harness (test/support/testing.js).
# ==============================================================================

RESET =! "\x1b[0m"
BOLD  =! "\x1b[1m"
GREEN =! "\x1b[32m"
RED   =! "\x1b[31m"
DIM   =! "\x1b[2m"

# Chrome paint only, never values under test. Bun.enableANSIColors is the
# one gate (TTY/NO_COLOR/FORCE_COLOR/CI); test:all lanes get a PTY.
useColor =! !!Bun.enableANSIColors

paint = (code, text) ->
  if useColor then "#{code}#{text}#{RESET}" else text

pass = 0
fail = 0
_reported = false

report = ->
  return if _reported
  _reported = true
  total = pass + fail
  passed = paint(GREEN, "#{pass} passed")
  failed = paint((if fail > 0 then RED else DIM), "#{fail} failed")
  console.log "\n#{paint(BOLD, "#{total} tests")}: #{passed}, #{failed}\n"

process.on 'exit', report

# An async body works too: invoke as `test! "name", -> ...` so the
# file awaits it in place and output stays ordered.
export def test(name, fn)
  try
    r = fn()
    await r if r?.then?
    pass++
    console.log "  #{paint(GREEN, '✓')} #{name}"
  catch e
    fail++
    process.exitCode = 1
    console.log "  #{paint(RED, '✗')} #{name}: #{e.message}"

# Structural deep equality: arrays ordered, object keys unordered, NaN is
# NaN; Date, Map, Set (content off own keys) by content. No cycles.
deepEq = (a, b) ->
  return true if a is b or (Number.isNaN(a) and Number.isNaN(b))
  return false unless a? and b? and typeof a is typeof b
  for T in [Date, Map, Set] when a instanceof T or b instanceof T
    return false unless a instanceof T and b instanceof T
    return Object.is(a.getTime(), b.getTime()) if T is Date
    return false unless a.size is b.size
    return [...a].every(([k, v]) -> b.has(k) and deepEq(v, b.get(k))) if T is Map
    rest = [...b]
    return [...a].every (v) -> (i = rest.findIndex (w) -> deepEq(v, w)) >= 0 and rest.splice(i, 1)
  if Array.isArray(a)
    return false unless Array.isArray(b) and a.length is b.length
    for v, i in a
      return false unless deepEq(v, b[i])
    return true
  if typeof a is 'object'
    return false if Array.isArray(b)   # {} never equals []
    ka = Object.keys(a)
    return false unless ka.length is Object.keys(b).length
    for k in ka
      return false unless Object.hasOwn(b, k) and deepEq(a[k], b[k])
    return true
  false

# The message is CONTEXT beside expected/got, never a replacement — most
# often a failed subprocess's stderr, which is the whole diagnosis.
export def eq(a, b, message = null)
  unless deepEq(a, b)
    [want, got] = [JSON.stringify(b), JSON.stringify(a)]
    # JSON hides undefined, NaN and Map/Set content; say what differs
    [want, got] = [Bun.inspect(b, compact: true), Bun.inspect(a, compact: true)] if want is got
    detail = "expected #{want}, got #{got}"
    throw Error.new(if message? then "#{detail}: #{message}" else detail)

export def ok(cond, message = 'assertion failed')
  throw Error.new(message) unless cond

# `expected` refines the assertion: an Error class checks instanceof,
# a string checks message containment, and both can be given in order.
export def throws(fn, ...expected)
  throw TypeError.new("throws expects a function, got #{typeof fn}") unless typeof fn is 'function'
  caught = null
  threw  = false
  try
    fn()
  catch e
    caught = e
    threw  = true
  throw Error.new('expected throw') unless threw
  for want in expected
    if typeof want is 'string'
      unless String(caught?.message).includes(want)
        throw Error.new "expected message containing #{JSON.stringify(want)}, got #{JSON.stringify(caught?.message)}"
    else
      unless caught instanceof want
        throw Error.new "expected #{want?.name ?? 'error class'}, got #{caught?.constructor?.name}"

# Env for subprocesses whose stdout is byte-pinned. FORCE_COLOR wins over
# NO_COLOR for Bun's inspect paint, so a parent that set FORCE_COLOR for
# its own reporter must not leak it into children under test.
export def plainEnv(extra = {})
  env = { ...process.env, ...extra }
  delete env.FORCE_COLOR unless Object.hasOwn(extra, 'FORCE_COLOR')
  env
